# Aether language files — always LF (no CRLF) so the lexer sees consistent input
*.ae linguist-language=Aether text eol=lf

# Shell scripts that run under MSYS on Windows must stay LF; CRLF
# triggers `\r: command not found` style failures from /bin/sh.
*.sh text eol=lf

# Integration-test fixtures that get byte-compared against program
# output need committed LF to survive an autocrlf=true checkout on
# Windows. Without eol=lf, expected_output.txt would land on disk
# with CRLF and fail every comparison even when the program output
# is byte-identical.
tests/**/expected_output.txt text eol=lf
tests/**/*.txt text eol=lf
std/posix/regex/tests/** text eol=lf

# Documentation
*.md linguist-documentation

# Generated files
*.c linguist-generated=true
*.h linguist-generated=false

# Vendored dependencies (if any)
# vendor/* linguist-vendored


# docs/api is tools/docgen output, written LF on every platform and compared
# byte for byte with a fresh run by `make check-api-docs`; a CRLF checkout
# would fail that check on Windows.
docs/api/** text eol=lf

# A text an example reads and counts the bytes of: the same bytes on every
# checkout, so the output it prints is the one its Output block holds.
examples/07-applications/01-word-count/sample.md text eol=lf

# Fuzz seeds are raw CBOR: a seed of one 0x0a byte reads as text to git and
# would become 0d 0a under autocrlf.
tests/fuzz/cbor/corpus/** binary

# Fuzz seeds are bytes, CR LF and all (tests/fuzz/*/corpus): a line ending
# converted on commit or checkout is another input, an HTTP head with bare
# LFs where the generator wrote CR LF.
tests/fuzz/**/corpus/** binary

# FreeBSD's sed regression suite (std.sed's parity test and test_sed read these
# byte for byte): keep them LF on a Windows autocrlf checkout, or every line
# gains a CR and sed's output no longer matches the expected files.
tests/integration/sed_parity/freebsd/** text eol=lf
