# Build outputs
/build/*
/target/
benchmarks/cross-language/build/
# Generated by benchmarks/http/run_baseline.sh / run_comparison.sh.
# Machine-specific measurements: regenerate locally, never commit.
benchmarks/http/baseline_results.txt
benchmarks/http/comparison_results.txt
*.exe
*.o
*.obj
*.a
*.d
*.so
*.dll
*.dylib
*.log
.claude/
a.out

# Generated C code (from .ae compilation)
output.c
generated_*.c
/tmp/ping_pong_aether.c*

# Package lock files
aether.lock
package-lock.json

# Benchmark build artifacts (compiled binaries for each pattern)
benchmarks/cross-language/*/ping_pong
benchmarks/cross-language/*/counting
benchmarks/cross-language/*/thread_ring
benchmarks/cross-language/*/fork_join
benchmarks/cross-language/*/skynet
benchmarks/cross-language/*/skynet_asan
benchmarks/cross-language/*/skynet_noinline

# Pony compiles a directory, not a file, so its benchmarks are pony/<name>/ and
# the patterns above match those SOURCE DIRECTORIES: a new Pony benchmark is
# invisible to git status and never gets committed. Re-include the directories,
# then ignore their contents except the sources.
!benchmarks/cross-language/pony/*/
benchmarks/cross-language/pony/*/*
!benchmarks/cross-language/pony/*/*.pony
benchmarks/cross-language/*/*.exe
benchmarks/cross-language/*/*.beam
benchmarks/cross-language/*/*.class
erl_crash.dump
benchmarks/cross-language/*/erl_crash.dump
benchmarks/cross-language/**/*.dSYM/

# Images the contrib/vulkan examples render into the working directory when
# they run (contrib-check runs them, so CI produces these too).
*.ppm

# Zig build artifacts
benchmarks/cross-language/zig/.zig-cache/
benchmarks/cross-language/zig/zig-out/

# Go build artifacts
benchmarks/cross-language/go/go.sum

# Rust build artifacts
benchmarks/cross-language/rust/target/
benchmarks/cross-language/rust/Cargo.lock

# Scala build artifacts
benchmarks/cross-language/scala/target/
benchmarks/cross-language/scala/project/target/
benchmarks/cross-language/scala/project/project/

# Pony build artifacts
benchmarks/cross-language/pony/pony
benchmarks/cross-language/pony/*/ping_pong
benchmarks/cross-language/pony/*/counting
benchmarks/cross-language/pony/*/thread_ring
benchmarks/cross-language/pony/*/fork_join

# Aether codegen intermediates
benchmarks/cross-language/aether/*.c
!benchmarks/cross-language/aether/Makefile

# Zig cache (alternate location)
benchmarks/cross-language/zig/zig-cache/

# Visualization server
benchmarks/cross-language/visualize/server
benchmarks/cross-language/visualize/server.exe
benchmarks/cross-language/visualize/server_generated.c
benchmarks/cross-language/visualize/results_*.json
zig_minimal

# Editor
.vscode/
.cursor/
*.swp
*.swo
*~
.idea/

# VS Code extension build artefacts (ship the bundled out/extension.js,
# but keep node_modules and the source-map debug bundle out of the repo)
editor/vscode/node_modules/
editor/vscode/out/extension.js.map
editor/vscode/*.vsix

# OS
.DS_Store
Thumbs.db
desktop.ini
.ci-cache/
runtime/aether_version.h

# #1366 generated stdlib symbol table
compiler/codegen/aether_stdlib_symbols.h

# gcov output. These are per-run binaries: two of them were committed by
# accident and every test run that produced coverage data rewrote them, so
# each unrelated PR picked up a spurious binary diff.
*.gcda
*.gcno
*.gcov

# Python bytecode from the doc/index checkers in tests/scripts
__pycache__/
*.pyc
