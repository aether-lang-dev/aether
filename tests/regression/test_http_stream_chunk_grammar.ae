// Regression (#3520): the client's stream reader read a chunked body by
// rules of its own after each chunk size. It took a bare LF or a bare CR for
// the CRLF that ends a chunk's data, and after the last chunk it took one
// CRLF and ignored the rest, so a trailer section read as malformed framing.
// The buffered reader refuses the first two and reads the trailers, so the
// two readers framed one body two ways. Before the fix the stream reader
// read "hello" from the bare LF and bare CR bodies below, and gave an error
// for the body with trailers.
//
// The stream reader now keeps to the buffered walk's rules: a CRLF after each
// chunk's data, and trailer lines to the empty line, each ending in CRLF and
// at most 1024 bytes. Each body below is read both ways, and both readers
// must give the answer it names.

import std.string
import std.tcp
import std.http.client

extern exit(code: int)

message Listen { srv: ptr }
message Serve { resp: string }
message Served {}
message Count { n: int }

// Answers one connection with the response it is given, then closes it.
actor Upstream {
    state served = 0
    state srv: ptr = null

    receive {
        Listen(srv: s) -> {
            srv = s
        }
        Serve(resp: resp) -> {
            sock, aerr = tcp.accept(srv)
            if aerr == "" {
                seen = ""
                going = 1
                while going == 1 {
                    got, rerr = tcp.read(sock, 4096)
                    if rerr != "" {
                        going = 0
                    } else {
                        seen = string.concat(seen, got)
                        if string.contains(seen, "\r\n\r\n") == 1 { going = 0 }
                    }
                }
                _n, _werr = tcp.write(sock, resp)
                tcp.close(sock)
                served = served + 1
            }
        }
        Served() -> {
            reply Count { n: served }
        }
    }
}

// The body `resp` gives the stream reader, or "error".
fn streamed(up: actor_ref[Upstream], url: string, resp: string) -> string {
    up ! Serve { resp: resp }
    req = client.request("GET", url)
    client.set_timeout(req, 5s)
    r, err = client.send_stream(req)
    client.request_free(req)
    out = "error"
    if err == "" {
        acc = ""
        done = 0
        while done == 0 {
            ch = client.response_read(r, 4096)
            if string.length(ch) == 0 { done = 1 } else { acc = string.concat(acc, ch) }
        }
        if client.response_error(r) == "" { out = acc }
        client.response_free(r)
    }
    int _s = up ? Served {}
    return out
}

// The body `resp` gives the buffered reader, or "error".
fn buffered(up: actor_ref[Upstream], url: string, resp: string) -> string {
    up ! Serve { resp: resp }
    req = client.request("GET", url)
    client.set_timeout(req, 5s)
    r, err = client.send_request(req)
    client.request_free(req)
    out = "error"
    if err == "" {
        out = string.concat(client.response_body(r), "")
        client.response_free(r)
    }
    int _s = up ? Served {}
    return out
}

fn expect(up: actor_ref[Upstream], url: string, what: string, chunks: string, want: string) -> int {
    resp = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n${chunks}"
    fails = 0
    s = streamed(up, url, resp)
    if s != want {
        println("FAIL: ${what}: the stream reader gave '${s}', want '${want}'")
        fails = fails + 1
    }
    b = buffered(up, url, resp)
    if b != want {
        println("FAIL: ${what}: the buffered reader gave '${b}', want '${want}'")
        fails = fails + 1
    }
    return fails
}

main() {
    srv, lerr = tcp.listen_on("127.0.0.1", 0)
    if lerr != "" {
        println("FAIL listen: ${lerr}")
        exit(1)
    }
    url = "http://127.0.0.1:${tcp.server_port(srv)}/"
    up = spawn(Upstream())
    up ! Listen { srv: srv }

    big = string.pad_end("a", 1100, 97)
    fails = 0
    fails = fails + expect(up, url, "two chunks", "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n", "hello world")
    fails = fails + expect(up, url, "trailer lines", "5\r\nhello\r\n0\r\nX-One: 1\r\nX-Two: two\r\n\r\n", "hello")
    fails = fails + expect(up, url, "a bare LF after chunk data", "5\r\nhello\n0\r\n\r\n", "error")
    fails = fails + expect(up, url, "a bare CR after chunk data", "5\r\nhello\r0\r\n\r\n", "error")
    fails = fails + expect(up, url, "a trailer line ending in a bare LF", "5\r\nhello\r\n0\r\nX-One: 1\n\r\n", "error")
    fails = fails + expect(up, url, "a CR inside a trailer line", "5\r\nhello\r\n0\r\nX-One: a\rb\r\n\r\n", "error")
    fails = fails + expect(up, url, "a trailer line past 1024 bytes", "5\r\nhello\r\n0\r\nX-Long: ${big}\r\n\r\n", "error")
    fails = fails + expect(up, url, "no empty line after the last chunk", "5\r\nhello\r\n0\r\n", "error")

    tcp.server_close(srv)
    if fails > 0 { exit(1) }
    println("PASS: the stream reader frames a chunked body as the buffered one does")
}
