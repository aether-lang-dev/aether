// Regression: a named function called as a closure value does not leak the
// string reference its adapter takes for it.
//
// A closure call borrows its arguments (#2499): the caller frees the string
// it passed once the call returns. A function that keeps a `string`
// parameter past the call therefore gets a reference of its own from its
// closure adapter. Assigning the parameter to a local counted as keeping
// it, although the local was dropped at the function's exit, so the
// adapter took a reference that nothing gave back: one string per call.
// Now an alias into a local is a keep only when that local keeps the
// value; a real keep (here, a list that holds the string) still gets its
// own reference and stays readable after the caller has freed its one.
//
// The check measures what the process holds (std.mem's heap_in_use) over
// two later windows of the same work, after a warm-up: work that leaks
// nothing holds steady in at least one of them. The check runs where the
// heap count is exact (mem.heap_in_use_exact); elsewhere the macOS leaks
// gate covers this program.

import std.mem
import std.string
import std.list

extern exit(code: int)

const PER_ROUND = 400

var seen = 0
var keeper: ptr = null

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

// Keeps nothing: the alias dies with the call.
note(s: string) {
    nm = s
    seen = seen + string.length(nm)
}

// Keeps the string in a list.
store(s: string) {
    _ = list.add(keeper, s)
}

apply1(f: fn, s: string) { call(f, s) }

fn keep_one(p: string) {
    apply1(store, string.concat(p, "pt-in-list"))
}

fn one_round(p: string) {
    i = 0
    while i < PER_ROUND {
        apply1(note, string.concat(p, "-note"))
        i = i + 1
    }
}

main() {
    keeper = list.new()
    keep_one("ke")
    if !mem.heap_in_use_exact() {
        println("OK") // count not exact here: the macOS leaks gate checks this program
        return
    }
    // A leak grows the exact count in every window of rounds; work that
    // leaks nothing holds it steady once warm. So warm up, then require one
    // of two equal later windows to hold steady.
    one_round("ab")
    one_round("ab")
    first_bytes = mem.heap_in_use()
    one_round("ab")
    one_round("ab")
    mid_bytes = mem.heap_in_use()
    one_round("ab")
    one_round("ab")
    last_bytes = mem.heap_in_use()
    check(mid_bytes - first_bytes == 0 || last_bytes - mid_bytes == 0,
        "both windows grew the heap: ${mid_bytes - first_bytes} then ${last_bytes - mid_bytes} bytes")
    check(seen == 6 * PER_ROUND * 7, "every call saw its string (${seen})")
    kept, _ = list.get(keeper, 0)
    check(string.length(kept) == 12, "the kept string is intact")
    println("OK")
}
