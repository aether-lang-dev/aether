// Regression: proxy.pool_metrics_text hands its caller a string the caller
// owns. aether_proxy_pool_metrics_text builds a fresh buffer per call, but
// its extern was a plain `-> string`, so the compiler took the result for a
// borrowed one and never freed it: every scrape leaked the whole metrics
// text. It is declared `-> string @heap` now.
import std.http.proxy
import std.mem
import std.string

extern exit(code: int)

// Scrape once; 1 when the text names the upstream the pool was given.
scrape(pool: ptr, url: string) -> int {
    text = proxy.pool_metrics_text(pool)
    if string.contains(text, url) != 1 { return 0 }
    return 1
}

scrapes(pool: ptr, url: string, n: int) {
    i = 0
    while i < n {
        scrape(pool, url)
        i = i + 1
    }
}

main() {
    fails = 0
    pool = proxy.upstream_pool_new("round_robin", 30, 0, 0)
    if pool == 0 { println("  FAIL pool is null"); exit(1) }
    url = string.concat("http://localhost:", string.from_int(19001))
    err = proxy.upstream_add(pool, url, 1)
    if err != "" { println("  FAIL upstream_add: ${err}"); exit(1) }

    if scrape(pool, url) != 1 { println("  FAIL the metrics text does not name the upstream"); fails = fails + 1 }

    // Where the allocator's count is exact: a leak grows every window of
    // calls, while a one-time allocation (a buffer a system library creates
    // lazily) lands in one. So, warm, one of two equal windows holds exactly
    // steady.
    if mem.heap_in_use_exact() {
        scrapes(pool, url, 200)
        a = mem.heap_in_use()
        scrapes(pool, url, 500)
        b = mem.heap_in_use()
        scrapes(pool, url, 500)
        c = mem.heap_in_use()
        if b - a != 0 && c - b != 0 {
            println("  FAIL both windows of 500 scrapes grew the heap: ${b - a} then ${c - b} bytes")
            fails = fails + 1
        }
    }

    proxy.upstream_pool_free(pool)
    if fails > 0 {
        println("FAIL: ${fails} checks failed")
        exit(1)
    }
    println("All PASS")
}
