// Regression: string.to_float parses to Aether's `float`, which is 64-bit
// (C double), correctly rounded. It used to parse with strtof and widen the
// 32-bit result, so to_float("0.1") gave 0.10000000149011612 and
// to_float("16777217") gave 16777216: about seven significant digits dressed
// as a double. string.to_f32 is the 32-bit parse, rounded once, as strtof.
import std.mem
import std.string

extern exit(code: int)

check(ok: int, what: string) -> int {
    if ok == 0 {
        println("  FAIL ${what}")
        return 1
    }
    return 0
}

main() {
    println("=== to_float is a 64-bit parse; to_f32 the 32-bit one ===")
    fails = 0

    a, ea = string.to_float("0.1")
    fails = fails + check(ea == "" && a == 0.1, "to_float(\"0.1\") == 0.1, got ${string.from_double(a)}")
    fails = fails + check(mem.bits_of_float(a) == 0x3fb999999999999a, "to_float(\"0.1\") bits")

    b, eb = string.to_float("16777217")
    fails = fails + check(eb == "" && b == 16777217.0, "to_float(\"16777217\"), got ${string.from_double(b)}")

    // 17 significant digits: the text from_double writes reads back to the
    // same bits, for values that need all of them.
    texts = ["0.10000000000000001", "3.1415926535897931", "1.7976931348623157e+308",
        "2.2250738585072014e-308", "9007199254740993", "0.30000000000000004"]
    for t in texts {
        v, ev = string.to_float(t)
        back = string.from_double(v)
        w, ew = string.to_float(back)
        fails = fails + check(ev == "" && ew == "" && mem.bits_of_float(v) == mem.bits_of_float(w),
            "round-trip ${t} -> ${back}")
    }
    // 2^53 + 1 is not a double; it rounds to even, 2^53.
    n, en = string.to_float("9007199254740993")
    fails = fails + check(en == "" && n == 9007199254740992.0, "to_float(2^53 + 1) rounds to even")
    pi, ep = string.to_float("3.1415926535897931")
    fails = fails + check(ep == "" && mem.bits_of_float(pi) == 0x400921fb54442d18, "to_float(pi) bits")

    // to_f32 rounds like strtof: once, straight to binary32.
    f, ef = string.to_f32("0.1")
    fails = fails + check(ef == "" && mem.bits_of_float(f as float) == 0x3fb99999a0000000, "to_f32(\"0.1\") bits")
    fails = fails + check(f == 0.1 as f32, "to_f32(\"0.1\") == 0.1 as f32")
    g, eg = string.to_f32("16777217")
    fails = fails + check(eg == "" && (g as float) == 16777216.0, "to_f32(\"16777217\") rounds to 16777216")
    h, eh = string.to_f32("1e39")
    fails = fails + check(eh != "", "to_f32(\"1e39\") overflows binary32, got ${h as float}")
    k, ek = string.to_float("1e39")
    fails = fails + check(ek == "" && k == 1e39, "to_float(\"1e39\") is in range")
    _x, ex = string.to_f32("abc")
    fails = fails + check(ex != "", "to_f32(\"abc\") errors")

    // to_double stays for now, slated for deletion: the same parse as to_float.
    same = ["0.1", "16777217", "3.1415926535897931", "0x1.8p3", "-Infinity", "1e39", " 2.5 "]
    for t in same {
        d, ed = string.to_double(t)
        v, ev = string.to_float(t)
        fails = fails + check(ed == "" && ev == "" && mem.bits_of_float(d) == mem.bits_of_float(v),
            "to_double(\"${t}\") == to_float")
    }
    _d, edbad = string.to_double("1.5x")
    fails = fails + check(edbad != "", "to_double(\"1.5x\") errors")

    if fails > 0 {
        println("FAIL: ${fails} checks failed")
        exit(1)
    }
    println("All PASS")
}
