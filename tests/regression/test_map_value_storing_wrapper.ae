// Regression: a heap string passed to a wrapper whose value parameter is
// typed `string` and which stores it into a map is owned by the map.
//
// (heap-string-map-value-use-after-free-multi-tu.md — surfaced by aeb's
// build session, where `build.fail(ctx, reason)` stored the reason into a
// nested status map and a later `reason_of` read it as garbage.)
//
// First root cause: `call_arg_escapes` judged a `string`-typed callee
// parameter read-only, so the caller's heap local was freed at scope exit
// while `pr`'s `map.put` had already stashed the pointer. The first fix
// kept the caller's local alive for ever and left the map borrowing it,
// so the program had to read the values back and free them by hand before
// `map.free`. Now the wrapper keeps its parameter the way a closure does
// (copy-on-keep): it takes a reference of its own on entry and the store
// moves it into the map, which owns the value and releases it with the
// entry; the caller's local is freed at its own scope exit as any other.
// Nothing is freed twice and nothing is left to the program. The macOS
// leaks gate runs this file.

import std.map
import std.mem
import std.string

extern exit(code: int)

// Storing wrapper: value parameter typed `string`, stored into the map.
pr(m: ptr, k: string, v: string) {
    _e = map.put(m, k, v)
}

reason_of(m: ptr, k: string) -> ptr {
    v, _ = map.get(m, k)
    return v
}

// Caller mints a NAMED heap local and hands it to the string-param wrapper.
record_fail(m: ptr, label: string, code: int) {
    reason = string.concat("exit ", string.from_int(code))
    pr(m, label, reason)
}

fill_and_free(n: int) {
    m = map.new()
    record_fail(m, "java", n)
    record_fail(m, "rust", n + 5)
    map.free(m)
}

main() {
    println("=== test_map_value_storing_wrapper ===")
    m = map.new()
    record_fail(m, "java", 2)
    record_fail(m, "rust", 7)

    // Heavy intervening heap churn — reuses any prematurely-freed buffer,
    // turning a latent UAF into observable corruption.
    j = 0
    while j < 500 {
        _t = string.concat("churn-", string.from_int(j))
        j = j + 1
    }

    r1 = reason_of(m, "java")
    if string.equals(r1, "exit 2") == 0 {
        println("FAIL: java reason corrupted (got length ${string.length(r1)})")
        exit(1)
    }
    r2 = reason_of(m, "rust")
    if string.equals(r2, "exit 7") == 0 {
        println("FAIL: rust reason corrupted (got length ${string.length(r2)})")
        exit(1)
    }
    println("  PASS: stored heap reasons survived the storing wrapper")
    // The map owns the reasons: freeing it releases them.
    map.free(m)

    // Where the allocator's count is exact: a leak grows every window of
    // calls, while a one-time allocation, or a thread the system starts in
    // the process, settles. So, warm, some window holds exactly steady
    // (mem.steady_growth).
    if mem.heap_in_use_exact() {
        i = 0
        while i < 20 { fill_and_free(i); i = i + 1 }
        grown = mem.steady_growth(|| {
                i = 0
                while i < 200 { fill_and_free(i); i = i + 1 }
            }, 5)
        if grown != 0 {
            println("FAIL: a window of 200 maps grew the heap by ${grown} bytes in every run")
            exit(1)
        }
    }
    println("=== all cases passed ===")
}
