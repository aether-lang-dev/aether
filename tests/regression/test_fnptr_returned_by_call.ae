// Regression (#2634): a call to a function that returns a named C function
// pointer type is that function pointer.
//
// `mk() -> Getter` (a `cfn Getter(p: ptr) -> string`, or `type Getter =
// fn(ptr) -> string`) was typed by its call as what calling the pointer
// would give, a string: the early inference pass took the function's symbol
// type, which is its result, for a fn-pointer local's signature. So `g =
// mk()` was "Type mismatch in variable initialization" and then "Undefined
// function 'g'". The call is the fn pointer now, so it binds to a local, a
// typed `let`, a struct field and a parameter, and `mk() as ptr` is the
// pointer it holds (a typed fn pointer is a `void*`, the way back from `p as
// fn(...)`). A string returned through the pointer is the caller's (#2586):
// the call takes what the function marked, and the leak window holds steady.
//
// The leak check runs where the heap count is exact (mem.heap_in_use_exact):
// after a warm-up, some window of the same work grows by exactly 0
// (mem.steady_growth). Strings are built from parameters, because
// string.concat of two literals folds to a literal.

import std.mem
import std.string

extern exit(code: int)

cfn Getter(p: ptr) -> string
type Pick = fn(int, int) -> int

struct Thing {
    name: string
}

struct Holder {
    get: Getter
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

// A field, returned as a copy of its own.
name_of(p: ptr) -> string {
    return (p as *Thing).name
}

// A fresh string.
loud_name(p: ptr) -> string {
    return string.concat((p as *Thing).name, "!")
}

larger(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

getter(loud: bool) -> Getter {
    if loud {
        return loud_name
    }
    return name_of
}

picker() -> Pick {
    return larger
}

length_through(g: Getter, p: ptr) -> int {
    return string.length(g(p))
}

round(t: *Thing) -> int {
    g = getter(false)
    total = string.length(g(t as ptr))
    let typed: Getter = getter(true)
    total = total + string.length(typed(t as ptr))
    h = Holder { get: getter(true) }
    total = total + string.length(h.get(t as ptr))
    total = total + length_through(getter(false), t as ptr)
    return total
}

main() {
    println("=== test_fnptr_returned_by_call ===")
    t = Thing { name: string.concat("ab", string.from_int(7)) }

    g = getter(false)
    check(g((&t) as ptr) == "ab7", "a call's fn pointer bound to a local")
    p = picker()
    check(p(3, 9) == 9, "a call's fn pointer through a `type` alias")
    q = getter(true) as ptr
    loud = getter(true)
    check(q != null && q == loud as ptr, "`as ptr` on a call's fn pointer")
    check(round(&t) == 3 + 4 + 4 + 3, "every binding of a call's fn pointer")

    if mem.heap_in_use_exact() {
        i = 0
        while i < 20 {
            round(&t)
            i = i + 1
        }
        grown = mem.steady_growth(|| {
                k = 0
                while k < 200 {
                    round(&t)
                    k = k + 1
                }
            }, 5)
        check(grown == 0, "a window of 200 rounds grew the heap by ${grown} bytes in every run")
    }
    println("=== test_fnptr_returned_by_call passed ===")
}
