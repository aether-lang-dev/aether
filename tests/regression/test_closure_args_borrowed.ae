// Regression (#2499): an owned string passed to a closure through an `fn`
// parameter is freed after the call.
//
// `apply(f: fn, s: string) { call(f, s) }` has no closure body to read, so
// handing `s` on counted as an escape: the caller of `apply` never freed its
// argument, and neither did `call(f, mk(a))` inside such a function. Every
// call leaked one string. A closure call now borrows its arguments when no
// closure the program can call keeps a parameter, and none here does: one
// only reads it, one captures it in a nested closure (whose env takes its
// own reference), one writes it from a nested closure (a cell with its own
// reference), one returns it (as a copy). The macOS leaks gate runs this
// program: each argument must be freed once, by its caller.
//
// Every argument is built at runtime from a parameter, so each is a heap
// string: `string.concat` of two literals folds to a literal.

import std.string

extern exit(code: int)

check(label: string, got: string, want: string) {
    if got != want {
        println("  FAIL: ${label} got=${got} want=${want}")
        exit(1)
    }
}

check_int(label: string, got: int, want: int) {
    if got != want {
        println("  FAIL: ${label} got=${got} want=${want}")
        exit(1)
    }
}

mk(a: string) -> string {
    return string.concat(a, "!")
}

apply(f: fn, s: string) {
    call(f, s)
}

apply_owned(f: fn, a: string) {
    call(f, mk(a))
    f(mk(a))
}

echo(f: fn, a: string) -> string {
    string r = call(f, mk(a))
    return r
}

run(seed: string) {
    count = 0
    look = | s: string | { count = count + string.length(s) }
    i = 0
    while i < 3 {
        apply(look, mk(seed))
        apply_owned(look, seed)
        i = i + 1
    }
    check_int("read", count, 18)

    same = | s: string | -> s
    check("returned", echo(same, seed), "s!")

    seen = 0
    held = | s: string | {
        show = || { seen = seen + string.length(s) }
        show()
        grow = || { s = string.concat(s, "+") }
        grow()
        seen = seen + string.length(s)
    }
    apply_owned(held, seed)
    check_int("captured and written", seen, 10)
}

main() {
    run(string.substring("xs", 1, 2))
    println("ok")
}
