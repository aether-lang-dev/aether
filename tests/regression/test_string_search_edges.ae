// Regression (#3531): index_of, its _from and _n forms, split and replace
// find a needle with memchr on its first byte and compare the rest only
// there, where they compared at every offset. The answers must be the ones
// the byte-by-byte scan gave: a first byte that repeats ("aab" in "aaab"),
// a needle at the very end, one and zero byte needles, a NUL inside the
// text, and delimiters that overlap, taken left to right without overlap.

import std.string

extern exit(code: int)

check(got: int, want: int, what: string) -> int {
    if got == want { return 0 }
    println("FAIL: ${what}: got ${got}, want ${want}")
    return 1
}

check_s(got: string, want: string, what: string) -> int {
    if string.equals(got, want) == 1 { return 0 }
    println("FAIL: ${what}: got '${got}', want '${want}'")
    return 1
}

main() {
    fails = 0
    fails = fails + check(string.index_of("aaab", "aab"), 1, "repeated first byte")
    fails = fails + check(string.index_of("abcabd", "abd"), 3, "a false start first")
    fails = fails + check(string.index_of("hello", "lo"), 3, "at the very end")
    fails = fails + check(string.index_of("hello", "lox"), -1, "past the end")
    fails = fails + check(string.index_of("hello", "o"), 4, "one byte")
    fails = fails + check(string.index_of("hello", ""), 0, "empty needle")
    fails = fails + check(string.index_of("", "a"), -1, "empty text")
    fails = fails + check(string.index_of_from("abcabc", "bc", 2), 4, "from past the first hit")
    fails = fails + check(string.index_of_from("abc", "", 3), 3, "empty needle at the end")
    fails = fails + check(string.index_of_from("abc", "c", 4), -1, "from past the end")
    fails = fails + check(string.index_of_from_n("abcabc", 6, "ca", 0), 2, "_n")
    fails = fails + check(string.index_of_from_n("abcabc", 5, "bc", 2), -1, "_n stops at its length")

    nul = string.from_char(0)
    head = string.concat("ab", nul)
    t = string.concat(head, "cd")
    fails = fails + check(string.index_of(t, "cd"), 3, "past a NUL")
    fails = fails + check(string.index_of(t, nul), 2, "the NUL itself")

    parts = string.split("aaa", "aa")
    fails = fails + check(string.array_size(parts), 2, "overlapping delimiters")
    first = string.array_get(parts, 0)
    second = string.array_get(parts, 1)
    fails = fails + check(string.length(first), 0, "first piece")
    fails = fails + check_s(second, "a", "second piece")
    string.array_free(parts)
    commas = string.split(",a,,b,", ",")
    fails = fails + check(string.array_size(commas), 5, "one byte delimiter")
    string.array_free(commas)

    r1 = string.replace_all("aaaa", "aa", "b")
    fails = fails + check_s(r1, "bb", "replace_all without overlap")
    r2 = string.replace("x.y.z", ".", "::")
    fails = fails + check_s(r2, "x::y.z", "replace the first only")
    r3 = string.replace_all("abcabc", "bc", "")
    fails = fails + check_s(r3, "aa", "replace with nothing")
    r4 = string.replace_all("abc", "zz", "y")
    fails = fails + check_s(r4, "abc", "no hit")

    if fails > 0 { exit(1) }
    println("PASS: every search found what the byte by byte scan found")
}
