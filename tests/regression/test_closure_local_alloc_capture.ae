// Regression: a heap string ALLOCATED INSIDE a closure and assigned to a
// CAPTURED outer variable must survive to be read AFTER the closure runs.
//
// This is the closure-local-alloc face of the capture-cell lifetime bug. #2019
// fixed the case where the closure reassigns the closure PARAMETER (backed by
// the sequence); this covers the distinct case where the closure allocates a
// fresh heap string (concat/copy result) and publishes it through the captured
// cell — the shape a running-max / accumulator over seq_each or fs.walk uses.
// The closure used to free that string on its own exit while the captured cell
// still pointed at it, so the read-after was garbage (a use-after-free, so it
// failed non-deterministically — sometimes "correct", sometimes junk). The fix
// marks the assignment-through-a-captured-cell as an escape (so the closure
// does not free it) and makes the string cell OWN its value (freed once, when
// the last cell reference dies; the prior value freed on each reassignment).
//
// Self-asserting: FAIL + exit(1), PASS at the end.

import std.string

extern exit(code: int)

main() {
    // --- single reassignment: concat result published through the cell -------
    items = string.split_to_seq("hello", ",")
    out = ""
    string.seq_each(items, |it: string| {
        c = string.concat(it, "!")   // heap alloc INSIDE the closure
        out = c                       // publish through the captured cell
    })
    string.seq_free(items)
    if string.equals(out, "hello!") == 0 {
        println("FAIL single: out='${out}', expected 'hello!'")
        exit(1)
    }

    // --- running max over allocated candidates (the _newest_jar shape) -------
    // Two captured accumulators, a fresh heap alloc per element, compared with
    // version_compare, read after the walk. Reliably garbage before the fix.
    jars = string.split_to_seq("clojure-1.9.jar,clojure-1.12.0.jar,clojure-1.11.jar", ",")
    newest = ""
    nb = ""
    string.seq_each(jars, |it: string| {
        cand = string.concat(it, "")
        cb = string.concat(cand, "")
        if string.length(newest) == 0 {
            newest = cand
            nb = cb
        } else {
            if string.version_compare(cb, nb) > 0 {
                newest = cand
                nb = cb
            }
        }
    })
    string.seq_free(jars)
    if string.equals(newest, "clojure-1.12.0.jar") == 0 {
        println("FAIL newest: got '${newest}', expected 'clojure-1.12.0.jar'")
        exit(1)
    }

    // --- accumulate a whole string across the callback (concat-in-place) -----
    letters = string.split_to_seq("a,b,c,d", ",")
    acc = ""
    string.seq_each(letters, |it: string| {
        acc = "${acc}${it}|"   // interp result (heap) published each iteration
    })
    string.seq_free(letters)
    if string.equals(acc, "a|b|c|d|") == 0 {
        println("FAIL accumulate: acc='${acc}', expected 'a|b|c|d|'")
        exit(1)
    }

    println("PASS test_closure_local_alloc_capture")
    return 0
}
