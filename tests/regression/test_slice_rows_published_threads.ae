// Regression (#3568): the rows of a slice of slices two actors share count
// atomically.
//
// A slice that other threads can reach (a module-level `var`, a message, a
// closure) is published: its count is made atomic. Only the outer buffer's
// was; its rows, which both threads reach through it, kept plain counts, so
// two actors copying a row at once (`r = rows[k]`, a reference taken and
// given back) lost increments and decrements, and a row was freed while a
// reader held it, or never. Publishing a buffer now publishes what its
// elements hold, once, as the bit is set atomically, and a row stored into
// it later is published by its store.
//
// Two actors read rows of a slice of slices a module `var` holds, and a
// message carries, in a loop at the same time. The check is that nothing
// crashes, every row read holds what was stored, and, where the heap count
// is exact (Windows), that a run of the work holds the heap steady.

import std.mem

extern exit(code: int)

var rows: int[][] = []

message Run {
    n: int
    mine: int[][]
}

message Get {}

message Seen {
    bad: int
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL #3568: ${msg}")
        exit(1)
    }
}

row(v: int, n: int) -> int[] {
    xs = make([]int, n)
    for i in 0..n {
        xs[i] = v
    }
    return xs
}

actor Reader {
    state bad = 0
    receive {
        Run(n: n, mine: mine) -> {
            i = 0
            while i < n {
                r = rows[i % 2]
                if r.len != 3 + i % 2 || r[0] != 7 + i % 2 {
                    bad = bad + 1
                }
                m = mine[i % 2]
                if m.len != 2 || m[1] != 5 {
                    bad = bad + 1
                }
                i = i + 1
            }
        }
        Get() -> {
            reply Seen { bad: bad }
        }
    }
}

round(a: ptr, b: ptr, n: int, mine: int[][]) -> int {
    a ! Run { n: n, mine: mine }
    b ! Run { n: n, mine: mine }
    int bad_a = a ? Get {}
    int bad_b = b ? Get {}
    return bad_a + bad_b
}

main() {
    rs = make([]int[], 2)
    rs[0] = row(7, 3)
    rs[1] = row(8, 4)
    rows = rs
    mine = make([]int[], 2)
    mine[0] = row(5, 2)
    mine[1] = row(5, 2)
    a = spawn(Reader())
    b = spawn(Reader())
    check(round(a, b, 200000, mine) == 0, "a row read held what was stored")
    check(rows[0][2] == 7 && rows[1][3] == 8 && mine[1][1] == 5, "the rows after the readers")
    if !mem.heap_in_use_exact() {
        println("OK") // count not exact here: the macOS leaks gate checks this program
        return
    }
    grown = mem.steady_growth(|| {
            check(round(a, b, 20000, mine) == 0, "a row read held what was stored")
        }, 5)
    check(grown == 0, "reading rows from two actors grew the heap by ${grown} bytes in every run")
    println("OK")
}
