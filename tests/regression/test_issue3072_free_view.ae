// #3072: a view owns nothing (R1, R2), so `free` of one gave the allocator a
// pointer it never handed out: `free(string.bytes(s))` corrupted the heap
// (0xC0000374 on Windows), and so did `free` of a sub-slice of a `make`
// buffer at an offset; one at the start freed the buffer under the slice
// that holds it, for a double free later. A view the checker cannot see
// (here, each given to a function) is now a named panic at run time; the
// ones it can see are refused (tests/integration/free_view). The slice that
// holds a `make` buffer, and a view of a raw pointer the program owns from
// its start, are freed as before, and the rounds must not grow the heap.
//
// #3568: a `make` buffer is counted, so a view of one given to a `@keep`
// parameter is a reference the parameter holds: `free` gives that reference
// back, and the buffer stays for the slice that holds it. Views of memory no
// count covers (a string's bytes, an array) and a pattern's tail (which
// holds no reference of its own) are still refused by name.

import std.mem
import std.string

extern exit(code: int)
extern malloc(n: int) -> ptr

struct Holder {
    buf: byte[]
}

check(ok: bool, what: string) {
    if !ok {
        println("FAIL: ${what}")
        exit(1)
    }
}

// A parameter borrows (E0901 to free one): these take the buffer, `@keep`.
drop(b: @keep byte[]) {
    free(b)
}

drop_ints(xs: @keep int[]) {
    free(xs)
}

// The tail of a clause's list pattern, and of a match's.
drop_tail([h | t]) -> int {
    free(t)
    return h
}

drop_match_tail(xs: int[]) -> int {
    match xs {
        [h | t] -> {
            free(t)
            return h
        }
        _ -> {
            return 0
        }
    }
}

nothing() -> int[] {
    return null
}

// Does `free` of the view panic with the message for its kind?
refused(what: string, how: int, b: @keep byte[], xs: @keep int[], want: string) {
    try {
        if how == 0 {
            drop(b)
        } else if how == 1 {
            drop_ints(xs)
        } else if how == 2 {
            drop_tail(xs)
        } else {
            drop_match_tail(xs)
        }
        println("FAIL: ${what}: no panic")
        exit(1)
    } catch e {
        check(string.ends_with(e, want) != 0, "${what}: the panic says why (${e})")
    }
}

// The owners, freed: a `make` buffer, and a raw pointer's view from its start.
round() -> int {
    b = make([]byte, 16)
    b[3] = 9
    total = b[3]
    drop(b)
    p = malloc(8)
    owned = (p as byte[])[0..8]
    owned[1] = 4
    total = total + owned[1]
    free(owned)
    free(nothing())
    return total
}

main() {
    view = "a view of elements another slice or an array holds, which owns nothing"
    ro = "a read-only view of a string, which owns nothing"
    b = make([]byte, 8)
    xs = make([]int, 3)
    // `b[..]` and `xs[..]` are views of the buffers, given where the
    // parameter that takes them is not the one tried.
    drop(b[1..])
    drop(b[0..4])
    drop(b[2..6][0..2])
    check(b.len == 8 && b[0] == 0, "a view given to a @keep parameter, freed, leaves the buffer")
    refused("a string's bytes", 0, string.bytes("abc"), xs[..], ro)
    refused("a sub-slice of a string's bytes", 0, string.bytes("abc")[1..], xs[..], ro)
    arr = [1, 2, 3]
    refused("an array viewed as a slice", 1, b[..], arr, view)
    refused("a clause's list tail", 2, b[..], xs[..], view)
    refused("a match's list tail", 3, b[..], xs[..], view)
    h = Holder { buf: b[2..] }
    drop(h.buf)
    check(b[0] == 0 && xs.len == 3, "the buffers the views were made of are intact")
    free(xs)
    drop(b)

    check(round() == 13, "the owners, used and freed")
    if mem.heap_in_use_exact() {
        g = mem.steady_growth(|| {
                round()
            }, 5)
        check(g == 0, "the heap grew by ${g} bytes")
    }
    println("ok")
}
