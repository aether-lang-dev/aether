// Regression test for os.chdir / os.getcwd — process working-directory
// accessors (POSIX chdir(2)/getcwd(3); Windows Set/GetCurrentDirectoryW).
// The one platform-shaped value is the root to chdir into: `/` on POSIX,
// the current drive's root (`C:\`) on Windows, where getcwd answers in
// the OS spelling with backslashes.

import std.os
import std.string

extern exit(code: int)

main() {
    println("=== os.chdir / os.getcwd ===")

    // getcwd returns something non-empty.
    start = os.getcwd()
    if start == "" {
        println("  FAIL: getcwd() returned empty")
        exit(1)
    }
    println("  PASS: getcwd() = ${start}")

    // chdir to the root (no symlink indirection, stable everywhere) and
    // confirm getcwd reflects it.
    root = "/"
    if os_getenv("OS") == "Windows_NT" {
        root = "${string.substring(start, 0, 2)}\\"
    }
    err = os.chdir(root)
    if err != "" {
        println("  FAIL: chdir('${root}') err=${err}")
        exit(1)
    }
    here = os.getcwd()
    if here != root {
        println("  FAIL: after chdir('${root}'), getcwd()=${here}, expected ${root}")
        exit(1)
    }
    println("  PASS: chdir('${root}') then getcwd() == ${root}")

    // chdir back to where we started, confirm round-trip.
    err2 = os.chdir(start)
    if err2 != "" {
        println("  FAIL: chdir back err=${err2}")
        exit(1)
    }
    back = os.getcwd()
    if !string.equals(back, start) {
        println("  FAIL: round-trip cwd=${back}, expected ${start}")
        exit(1)
    }
    println("  PASS: chdir round-trip restores cwd")

    // chdir to a path that doesn't exist → non-empty error.
    bad = os.chdir("/no/such/directory/anywhere")
    if bad == "" {
        println("  FAIL: chdir to missing dir should return an error")
        exit(1)
    }
    println("  PASS: chdir to missing dir → error (${bad})")

    println("=== All cases passed ===")
}
