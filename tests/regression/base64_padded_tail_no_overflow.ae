// Java4Shell (CVE-2026-114938, Nov 2026): OpenJDK's AVX-512 base64 intrinsic
// takes a tail of "=", "==", "X=", "X==", "XY=" or "===" after whole 4-char
// groups, computes an output length of -1 or -2, and writes a full 64-byte
// vector past the end of the result. The published trigger is 64 'A' then
// "=" (128 'A' then "=" on JDK 17).
//
// Aether's decoder (std.cryptography's ae_b64_decode, under std.encoding) is
// scalar C with no vector path. It sizes its buffer from the input length,
// not from the padding, and checks every store against that size. This test
// feeds it the same tails after every prefix length from 0 to 1024
// characters, through both alphabets. Each must be rejected, and each valid
// tail must decode to exactly the right number of bytes. The sweep under
// AddressSanitizer (`make test-asan-ae`) runs this file too, which is what
// would report a write past the buffer.

import std.encoding
import std.string

extern exit(code: int)

fn check(cond: bool, msg: string) -> int {
    if !cond { println("FAIL: ${msg}"); return 1 }
    return 0
}

fn a_run(n: int) -> string {
    s = ""
    i = 0
    while i < n {
        s = "${s}A"
        i = i + 1
    }
    return s
}

main() {
    fails = 0
    bad_tails = ["=", "==", "A=", "A==", "AA=", "==="]
    n = 0
    while n <= 1024 {
        prefix = a_run(n)

        // The malformed tails: every one must be an error, in both alphabets.
        t = 0
        while t < 6 {
            input = "${prefix}${bad_tails[t]}"
            _, e = encoding.base64_decode(input)
            fails = fails + check(e != "", "base64 accepted ${n} A + ${bad_tails[t]}")
            _, ue = encoding.base64url_decode(input)
            fails = fails + check(ue != "", "base64url accepted ${n} A + ${bad_tails[t]}")
            t = t + 1
        }

        // The well-formed tails beside them: exact length, all zero bytes.
        whole = (n / 4) * 3
        d1, e1 = encoding.base64_decode("${prefix}AA==")
        fails = fails + check(e1 == "" && string.length(d1) == whole + 1, "${n} A + AA== length")
        d2, e2 = encoding.base64_decode("${prefix}AAA=")
        fails = fails + check(e2 == "" && string.length(d2) == whole + 2, "${n} A + AAA= length")
        d3, e3 = encoding.base64_decode("${prefix}AAAA")
        fails = fails + check(e3 == "" && string.length(d3) == whole + 3, "${n} A + AAAA length")

        n = n + 4
    }

    // The two inputs exactly as published.
    _, p17 = encoding.base64_decode("${a_run(128)}=")
    fails = fails + check(p17 != "", "JDK 17 trigger (128 A + =) accepted")
    _, p21 = encoding.base64_decode("${a_run(64)}=")
    fails = fails + check(p21 != "", "JDK 21+ trigger (64 A + =) accepted")

    if fails > 0 {
        println("${fails} failure(s)")
        exit(1)
    }
    println("base64 padded tails: all rejected, no overflow")
}
