// Regression (#2684): a function whose result is not void must not let
// control reach the end of its body. Every function here returns on every
// path, ends in a call that never returns, or claims no result, so each must
// compile with no missing-return error and return what it says. The shapes
// the check rejects are in tests/integration/missing_return/.
import std.string

extern exit(code: int)

enum Dir { North, South, East }

struct Circle {
    r: int
}

struct Square {
    s: int
}

type Shape = Circle | Square

message Add {
    n: int
}

const FOREVER = true

var bad = 0
var noted = 0

check(label: string, got: int, want: int) {
    if got != want {
        println("FAIL ${label}: got ${got}, want ${want}")
        bad = bad + 1
    }
}

note() {
    noted = noted + 1
}

holder() -> ptr {
    return null
}

if_else(n: int) -> int {
    if n > 0 {
        return 1
    } else {
        return 0
    }
}

else_if_chain(n: int) -> int {
    if n > 0 {
        return 1
    } else if n < 0 {
        return 2
    } else {
        return 3
    }
}

// A condition the compiler decides leaves only the branch it selects.
if_decided() -> int {
    if FOREVER {
        return 7
    }
}

match_catchall(n: int) -> int {
    match n {
        1 -> { return 10 }
        _ -> { return 20 }
    }
}

match_enum(d: Dir) -> int {
    match d {
        North -> { return 1 }
        South -> { return 2 }
        East -> { return 3 }
    }
}

match_sum(s: Shape) -> int {
    match s {
        Circle -> { return s.r }
        Square -> { return s.s }
    }
}

match_optional(v: int?) -> int {
    match v {
        none -> { return 0 }
        some(x) -> { return x }
    }
}

match_bool(b: bool) -> int {
    match b {
        true -> { return 1 }
        false -> { return 2 }
    }
}

return_match(n: int) -> int {
    return match n {
        1 -> 100
        _ -> 200
    }
}

while_true(n: int) -> int {
    i = 0
    while true {
        if i == n {
            return i
        }
        i = i + 1
    }
}

while_const(n: int) -> int {
    i = 0
    while FOREVER {
        i = i + 1
        if i > n {
            return i
        }
    }
}

// The `break` leaves the inner loop only; the outer one never ends.
inner_break(n: int) -> int {
    total = 0
    while true {
        j = 0
        while j < 10 {
            if j == n {
                break
            }
            j = j + 1
        }
        total = total + j
        if total >= n {
            return total
        }
    }
}

for_forever(limit: int) -> int {
    k = 0
    for (;;) {
        k = k + 1
        if k >= limit {
            return k
        }
    }
}

switch_default(n: int) -> int {
    switch n {
        case 1: return 10
        case 2, 3: return 20
        default: return 30
    }
}

try_catch(n: int) -> int {
    try {
        if n < 0 {
            panic("negative")
        }
        return n
    } catch e {
        return 99
    }
}

ends_in_panic(n: int) -> int {
    if n >= 0 {
        return n
    }
    panic("negative")
}

ends_in_exit(n: int) -> int {
    if n >= 0 {
        return n
    }
    println("negative")
    exit(2)
}

with_defer(n: int) -> int {
    defer note()
    return n + 1
}

nested(n: int) -> int {
    if n > 0 {
        if n > 10 {
            return 2
        } else {
            return 1
        }
    }
    return 0
}

guarded(n: int) when n > 100 -> int {
    return 100
}
guarded(n: int) -> int {
    return n
}

fib(0) -> 0
fib(1) -> 1
fib(n) when n > 1 -> fib(n - 1) + fib(n - 2)

// #2645: a clause that returns nothing, in a set that returns a value,
// gives its caller the set's default.
twice(0) {
    println("twice zero")
}
twice(n) {
    return n * 2
}

closures(n: int) -> int {
    always = | x: int | {
        if x > 0 {
            return x
        }
        return 0
    }
    nothing = | x: int | {
        if x > 1000 {
            println("big ${x}")
        }
    }
    call(nothing, n)
    return call(always, n)
}

arrow(n: int) -> n * 3

arrow_block(n: int) -> {
    m = n + 1
    m * 2
}

arrow_early(n: int) -> {
    if n < 0 {
        return 0
    }
    n
}

no_result(n: int) {
    if n > 1000 {
        println("big")
    }
}

pair(n: int) -> (int, string) {
    if n > 0 {
        return n, "positive"
    }
    return 0, "other"
}

// A trailing block runs inline, so its `return`s are this function's.
trailing_returns(n: int) -> int {
    holder() {
        if n > 0 {
            return n
        }
        return 0
    }
}

parsed(s: string) -> long {
    v = string.to_long(s) or { return -1 }
    return v
}

actor Summer {
    state total = 0

    receive {
        Add(n) -> {
            total = total + n
        }
    }
}

main() {
    check("if/else", if_else(5), 1)
    check("else-if chain", else_if_chain(-4), 2)
    check("decided if", if_decided(), 7)
    check("match _", match_catchall(3), 20)
    check("match enum", match_enum(Dir.East), 3)
    check("match sum", match_sum(Square { s: 6 }), 6)
    check("match optional", match_optional(none), 0)
    check("match bool", match_bool(false), 2)
    check("return match", return_match(1), 100)
    check("while true", while_true(4), 4)
    check("while const", while_const(2), 3)
    check("inner break", inner_break(3), 3)
    check("for (;;)", for_forever(5), 5)
    check("switch default", switch_default(3), 20)
    check("try/catch", try_catch(-1), 99)
    check("ends in panic", ends_in_panic(8), 8)
    check("ends in exit", ends_in_exit(9), 9)
    check("defer", with_defer(1), 2)
    check("defer ran", noted, 1)
    check("nested", nested(4), 1)
    check("guarded", guarded(500), 100)
    check("fib", fib(10), 55)
    check("twice", twice(4), 8)
    check("closures", closures(6), 6)
    check("arrow", arrow(2), 6)
    check("arrow block", arrow_block(2), 6)
    check("arrow early", arrow_early(-3), 0)
    no_result(1)
    a, label = pair(5)
    check("tuple", a, 5)
    check("tuple label", string.length(label), 8)
    check("trailing block", trailing_returns(4), 4)
    check("or handler", parsed("x") as int, -1)
    s = spawn(Summer())
    s ! Add { n: 1 }
    wait_for_idle()
    if bad != 0 {
        println("${bad} check(s) failed")
        exit(1)
    }
    println("every path returns: ok")
}
