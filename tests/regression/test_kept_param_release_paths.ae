// Regression (#2499 copy-on-keep, found by the macOS leaks gate and LSan):
// a `string` parameter a function keeps is released on every path, a store
// into memory nothing destroys takes no copy, and a struct a call returns
// owning strings is destroyed when the statement that used it is done.
//
// 1. A tuple-returning function keeps its parameter only through a callee
//    that hands it back (fs.make_temp_file's prefix, through temp_prefix):
//    the copy it took was marked escaped, so no return freed it.
// 2. A field store through a pointer not proven to be a heap.new box
//    (`malloc(n) as *T`, freed with free()): nothing destroys that struct,
//    so the copy a capture took leaked; the parameter now borrows, as the
//    struct's owner expects.
// 3. A fluent chain, `expect_str(s).to_start_with(p)`: the subject the first
//    call returns owns its string, the next call only borrows it, and the
//    statement threw it away undestroyed.
//
// Checked where the heap count is exact (mem.heap_in_use_exact): one of two
// equal windows grows by exactly 0. The macOS leaks gate runs this program
// too.

import std.mem
import std.string

extern exit(code: int)
extern malloc(size: int) -> ptr
extern free(p: ptr)

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

// ---- 1. a kept parameter, a tuple return ----
pick(prefix: string) -> string {
    if prefix == "" {
        return "ae"
    }
    return prefix
}

fn measure(p: string) -> (int, string) {
    n = string.length(pick(p))
    if n == 0 {
        return 0, "empty"
    }
    return n, ""
}

// ---- 2. a field of a malloc'd struct ----
struct Note {
    code: int
    msg: string
}

make_note(code: int, msg: string) -> *Note {
    n = malloc(sizeof(Note)) as *Note
    n.code = code
    n.msg = msg
    return n
}

// ---- 3. a fluent chain ----
struct Subject {
    value: string
    hits: int
}

subject(v: string) -> Subject {
    c = string.concat(v, "")
    return Subject { value: c, hits: 0 }
}

starts(s: Subject, p: string) -> Subject {
    h = s.hits
    if string.starts_with(s.value, p) == 1 { h = h + 1 }
    return Subject { value: s.value, hits: h }
}

fn round(tag: string) -> int {
    total = 0
    i = 0
    while i < 20 {
        n, err = measure(tag)
        check(err == "" && n == string.length(tag), "measure sees the kept parameter")
        total = total + n
        note = make_note(i, "borrowed")
        check(note.code == i && string.equals(note.msg, "borrowed") == 1, "the note holds its message")
        free(note)
        starts(subject(tag), "ru")
        i = i + 1
    }
    return total
}

main() {
    tag = string.concat("run", "-x")
    check(round(tag) == 20 * 5, "each round measures twenty tags")
    if mem.heap_in_use_exact() {
        round(tag)
        before = mem.heap_in_use()
        round(tag)
        mid = mem.heap_in_use()
        round(tag)
        after = mem.heap_in_use()
        check(mid - before == 0 || after - mid == 0,
            "a round grew the heap by ${mid - before}, then ${after - mid} bytes")
    }
    println("OK")
}
