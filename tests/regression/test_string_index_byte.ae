// Regression (#3479): `s[i]` on a string is its byte i, an `int` from 0 to
// 255, checked against the string's length.
//
// The checker gave the read no type, so a local bound to it warned
// "unresolved type in codegen, defaulting to int"; the generated C read a
// plain `char`, which is signed on x86, so a byte past 127 (any non-ASCII
// UTF-8 byte) read negative there and positive on ARM; and an index past
// the terminator read past the string. The read is now an `int`, the type
// codegen gave such a local, with the value `string.bytes(s)[i]` has;
// `s[length]` is the terminator, 0, as a C-style scan reads it; and an index
// below 0 or past the terminator panics, as a slice index outside its
// length does, where a `try` catches it.

import std.string

extern exit(code: int)

check(got: int, want: int, what: string) {
    if got != want {
        println("FAIL: ${what}: ${got}, want ${want}")
        exit(1)
    }
}

first(text: string) -> int {
    c = text[0]
    return c
}

// A C-style scan: stops at the terminator.
scan_len(text: string) -> int {
    j = 0
    while text[j] != 0 {
        j = j + 1
    }
    return j
}

// `s[i]` at `i`, or -1 when the index panics; the panic's message is checked.
read_or_caught(s: string, i: int, n: int) -> int {
    try {
        return s[i]
    } catch e {
        if string.ends_with(e, "string index ${i} out of range for length ${n}") == 0 {
            println("FAIL: message: ${e}")
            exit(1)
        }
    }
    return -1
}

main() {
    s = "é"
    c = s[0]
    check(c, 195, "a lead byte bound to a local")
    check(s[1], 169, "a continuation byte")
    check(s[0], string.bytes(s)[0], "the byte string.bytes reads")
    check(c - 200, -5, "arithmetic on the local, as an int")
    check(first("A"), 65, "a parameter's byte")
    t = "Az"
    check(t[1] - t[0], 57, "arithmetic on two bytes")
    check(t[2], 0, "the terminator")
    check(scan_len("hello"), 5, "a scan to the terminator")
    check(read_or_caught("", 0, 0), 0, "the empty string's terminator")
    check(read_or_caught(t, 3, 2), -1, "one past the terminator")
    check(read_or_caught(t, 100000, 2), -1, "far past the end")
    check(read_or_caught(t, -1, 2), -1, "a negative index")
    println("ok")
}
