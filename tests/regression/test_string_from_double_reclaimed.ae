// Regression: string.from_double returns a fresh string the caller owns.
// Its extern was declared a plain `-> string`, so the compiler took the
// result for a borrowed one and never freed it: every call leaked the
// string (found by the macOS leaks gate on test_string_parse_inf_nan and
// test_string_embedded_nul). It is declared `-> string @heap` now.
import std.mem
import std.string

extern exit(code: int)

round_trips(x: float) -> int {
    text = string.from_double(x)
    v, err = string.to_double(text)
    if err != "" { return 0 }
    if v != x { return 0 }
    return 1
}

calls(n: int) {
    i = 0
    while i < n {
        round_trips(1.5)
        i = i + 1
    }
}

main() {
    fails = 0
    if round_trips(1.5) != 1 { println("  FAIL 1.5 does not round-trip"); fails = fails + 1 }
    if round_trips(0.0 - 2.25) != 1 { println("  FAIL -2.25 does not round-trip"); fails = fails + 1 }

    // Where the allocator's count is exact: a leak grows every window of
    // calls, while a one-time allocation lands in one. So, warm, one of two
    // equal windows holds exactly steady.
    if mem.heap_in_use_exact() {
        calls(200)
        a = mem.heap_in_use()
        calls(500)
        b = mem.heap_in_use()
        calls(500)
        c = mem.heap_in_use()
        if b - a != 0 && c - b != 0 {
            println("  FAIL both windows of 500 calls grew the heap: ${b - a} then ${c - b} bytes")
            fails = fails + 1
        }
    }

    if fails > 0 {
        println("FAIL: ${fails} checks failed")
        exit(1)
    }
    println("All PASS")
}
