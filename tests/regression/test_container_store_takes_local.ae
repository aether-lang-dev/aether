// Regression: a list add or a map put of a heap-tracked string local takes
// the value as every other owning slot does (a struct field, an `if`, a
// return): moved on the local's last use, copied otherwise. The container
// holds a reference of its own and the local keeps its own frees.
//
// The store adopted the local's single reference and marked the local
// escaped, so a local stored twice, or stored in a loop, was freed once per
// store (an access violation), and a `string` parameter a closure keeps by
// storing it (copy-on-keep, #2499) took a reference on entry that the raw
// store then left to nobody: a leak per call. The macOS leaks gate runs
// this file.

import std.list
import std.map
import std.mem
import std.string

extern exit(code: int)

check(label: string, got: int, want: int) {
    if got != want {
        println("  FAIL ${label}: got ${got} want ${want}")
        exit(1)
    }
}

// The same local in two lists, both freed.
twice(k: int) -> int {
    s = string.concat("s", string.from_int(k))
    a = list.new()
    b = list.new()
    list.add(a, s)
    list.add(b, s)
    n = string.length(s)
    list.free(a)
    list.free(b)
    return n
}

// Stored in a loop without being rebound.
in_loop(k: int) -> int {
    s = string.concat("loop", string.from_int(k))
    l = list.new()
    i = 0
    while i < 3 {
        list.add(l, s)
        i = i + 1
    }
    n = list.size(l) + string.length(s)
    list.free(l)
    return n
}

// Stored, then still used and rebound: the rebinding frees what the local
// still owns, the map keeps its own.
store_then_use(k: int) -> int {
    s = string.concat("s", string.from_int(k))
    m = map.new()
    map.put(m, "k", s)
    t = string.concat(s, "!")
    s = string.concat("again", string.from_int(k))
    v, _ = map.get(m, "k")
    n = string.length(t) + string.length(s) + string.length(v)
    map.free(m)
    return n
}

// A closure that keeps its string parameter by storing it: the reference
// it takes on entry moves into the list.
kept_by_closure(k: int) -> int {
    l = list.new()
    f = | x: string | { list.add(l, x) }
    call(f, string.concat("v", string.from_int(k)))
    call(f, string.concat("w", string.from_int(k)))
    a, _ = list.get(l, 0)
    b, _ = list.get(l, 1)
    n = string.length(a) + string.length(b)
    list.free(l)
    return n
}

// A string the closure keeps in two containers.
kept_twice(k: int) -> int {
    l = list.new()
    m = map.new()
    f = | x: string | {
        list.add(l, x)
        map.put(m, "x", x)
    }
    call(f, string.concat("vv", string.from_int(k)))
    a, _ = list.get(l, 0)
    b, _ = map.get(m, "x")
    n = string.length(a) + string.length(b)
    list.free(l)
    map.free(m)
    return n
}

round(k: int) -> int {
    return twice(k) + in_loop(k) + store_then_use(k) + kept_by_closure(k) + kept_twice(k)
}

rounds(n: int) {
    i = 0
    while i < n {
        round(i)
        i = i + 1
    }
}

main() {
    println("=== test_container_store_takes_local ===")
    check("twice", twice(3), 2)
    check("in loop", in_loop(3), 3 + 5)
    check("store then use", store_then_use(3), 3 + 6 + 2)
    check("kept by closure", kept_by_closure(3), 4)
    check("kept twice", kept_twice(3), 6)
    // Where the allocator's count is exact: a leak grows every window of
    // calls, while a one-time allocation lands in one. So, warm, one of two
    // equal windows holds exactly steady.
    if mem.heap_in_use_exact() {
        rounds(20)
        a = mem.heap_in_use()
        rounds(200)
        b = mem.heap_in_use()
        rounds(200)
        c = mem.heap_in_use()
        if b - a != 0 && c - b != 0 {
            println("  FAIL both windows of 200 rounds grew the heap: ${b - a} then ${c - b} bytes")
            exit(1)
        }
    }
    println("  PASS: container stores take the local, once per holder")
    println("=== test_container_store_takes_local passed ===")
}
