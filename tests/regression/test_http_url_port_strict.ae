// Regression (#3520): the HTTP client read a URL's port with atoi, so
// "host:80abc" dialled port 80, and "host:65616" went to a resolver that may
// keep only its low 16 bits, which is port 80 again. A forward proxy's port
// was read the same way. Before the fix the cases below dialled the server
// they name a port of (or failed to connect) instead of being refused as
// malformed. The port is now read whole by std.net's one number reader:
// digits only, in 1..65535, nothing left over.

import std.http
import std.http.client
import std.string

extern exit(code: int)
extern sleep(ms: int)

handle(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "ok")
}

// The error a GET of `url` ends in, "" when it was answered.
get_err(url: string, proxy: string) -> string {
    req = client.request("GET", url)
    if req == null { return "request() rejected the URL" }
    client.set_timeout(req, 3s)
    if string.length(proxy) > 0 {
        perr = client.use_http_proxy(req, proxy)
        if perr != "" {
            client.request_free(req)
            return perr
        }
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return err }
    client.response_free(resp)
    return ""
}

expect_err(url: string, proxy: string, want: string) -> int {
    err = get_err(url, proxy)
    if string.equals(err, want) == 1 { return 0 }
    println("FAIL: ${url} (proxy '${proxy}') gave '${err}', want '${want}'")
    return 1
}

main() {
    s = http.server_create(0)
    if s == 0 {
        println("FAIL: server_create")
        exit(1)
    }
    http.server_set_host(s, "127.0.0.1")
    http.server_get(s, "/*", handle, 0)
    _ = http.server_start_background(s)
    port = 0
    tries = 0
    while port <= 0 && tries < 100 {
        sleep(20)
        port = http.server_port(s)
        tries = tries + 1
    }
    if port <= 0 {
        println("FAIL: the server never bound")
        http.server_stop(s)
        http.server_free(s)
        exit(1)
    }

    fails = 0
    // A plain port is still read.
    fails = fails + expect_err("http://127.0.0.1:${port}/ok", "", "")
    // Anything after the digits, a port past 65535, the same port plus
    // 65536, no digits, a zero, a sign: none of them is a port.
    fails = fails + expect_err("http://127.0.0.1:${port}abc/ok", "", "malformed URL")
    fails = fails + expect_err("http://127.0.0.1:65616/ok", "", "malformed URL")
    fails = fails + expect_err("http://127.0.0.1:${port + 65536}/ok", "", "malformed URL")
    fails = fails + expect_err("http://127.0.0.1:/ok", "", "malformed URL")
    fails = fails + expect_err("http://127.0.0.1:0/ok", "", "malformed URL")
    fails = fails + expect_err("http://127.0.0.1:+${port}/ok", "", "malformed URL")
    fails = fails + expect_err("http://127.0.0.1:000000${port}/ok", "", "malformed URL")
    // A forward proxy's port is read the same way.
    fails = fails + expect_err("http://example.invalid/ok", "http://127.0.0.1:${port}abc", "malformed proxy URL")

    http.server_stop(s)
    http.server_free(s)
    if fails > 0 { exit(1) }
    println("PASS: every port was read whole")
}
