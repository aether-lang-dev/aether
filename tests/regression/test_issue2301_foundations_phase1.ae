// Issue #2301 (Foundations, phase 1): the remaining gaps after the first two
// rounds (bytes/cursor/mem/strbuilder's endian+copy+append forms) — a slice
// comparison for std.mem, finish_with_length as a bounded slice instead of a
// (ptr, int) tuple, checked SIMD loads/stores for std.lanes, a byte-view and
// string-array/StringSeq bridges for std.string, and a bounded view through
// the std.collections compatibility facade.
//
// Pre-fix this file fails to compile: none of these names existed (or, for
// finish_with_length, had this return shape). The blocks cover each one's
// happy path and, where the function can be out of range, the panic path.

import std.mem
import std.strbuilder
import std.lanes
import std.string
import std.collections

extern exit(code: int)

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

fn load4_panics(buf: f32[], index: long) -> bool {
    caught = false
    try {
        _v = lanes.load4_slice(buf, index)
    } catch e {
        caught = true
    }
    return caught
}

fn pack_panics(out: byte[]) -> bool {
    caught = false
    try {
        lanes.pack_i16_u8_slice(lanes.i16splat(1), lanes.i16splat(2), out)
    } catch e {
        caught = true
    }
    return caught
}

main() {
    // ---- mem.compare_slice ----
    a = make([]byte, 3)
    a[0] = 1
    a[1] = 2
    a[2] = 3
    b = make([]byte, 3)
    b[0] = 1
    b[1] = 2
    b[2] = 3
    c = make([]byte, 3)
    c[0] = 1
    c[1] = 2
    c[2] = 4
    check(mem.compare_slice(a, b) == 0, "equal slices compare 0")
    check(mem.compare_slice(a, c) < 0, "a byte difference orders lexicographically")
    check(mem.compare_slice(c, a) > 0, "comparison is antisymmetric")
    check(mem.compare_slice(a, a[0..2]) > 0, "a longer slice with the same prefix sorts after")
    check(mem.compare_slice(a[0..2], a) < 0, "...and the shorter one sorts before it")
    free(a)
    free(b)
    free(c)

    // ---- strbuilder.finish_with_length returns a bounded byte[] ----
    sb = strbuilder.new(8)
    strbuilder.append_byte(sb, 65)
    strbuilder.append_byte(sb, 0) // embedded NUL — content, not a terminator
    strbuilder.append_byte(sb, 66)
    fwl = strbuilder.finish_with_length(sb)
    check(fwl.len == 3, "finish_with_length's slice has the right length")
    check(fwl[0] == 65 && fwl[1] == 0 && fwl[2] == 66, "...and the right bytes, NUL included")
    free(fwl)

    sb_empty = strbuilder.new(4)
    fwl_empty = strbuilder.finish_with_length(sb_empty)
    check(fwl_empty.len == 0, "an empty builder yields a zero-length slice")
    free(fwl_empty) // still a real, freeable pointer at length 0

    // ---- lanes: slice-checked loads/stores ----
    fbuf = make([]f32, 4) // make zero-initializes, so no fill needed first
    lanes.store4_slice(fbuf, 0, lanes.f32x4(1.0, 2.0, 3.0, 4.0))
    v4 = lanes.load4_slice(fbuf, 0)
    check(lanes.sum4(v4) == 10.0, "store4_slice/load4_slice round-trip")
    check(!load4_panics(fbuf, 0), "a load that fits does not panic")
    check(load4_panics(fbuf, 1), "a load one element past the end panics")
    check(load4_panics(fbuf, -1), "a negative index panics")
    free(fbuf)

    ibuf = make([]int, 4)
    lanes.i32store_slice(ibuf, 0, lanes.i32x4(10, 20, 30, 40))
    iv = lanes.i32load_slice(ibuf, 0)
    check(lanes.i32sum(iv) == 100, "i32store_slice/i32load_slice round-trip")
    free(ibuf)

    sbuf = make([]uint16, 8)
    lanes.i16store_slice(sbuf, 0, lanes.i16splat(7))
    sv = lanes.i16load_slice(sbuf, 0)
    check(lanes.i16lane(sv, 3) == 7, "i16store_slice/i16load_slice round-trip")
    free(sbuf)

    packed = make([]byte, 16)
    lanes.pack_i16_u8_slice(lanes.i16splat(300), lanes.i16splat(5), packed)
    check(packed[0] == 255 && packed[8] == 5, "pack_i16_u8_slice saturates and writes both halves")
    check(pack_panics(make([]byte, 15)), "pack_i16_u8_slice into a 15-byte slice panics")
    free(packed)

    // ---- string: byte view, array-view, StringSeq bridges ----
    bv = string.bytes("abc")
    check(bv.len == 3 && bv[0] == 97 && bv[2] == 99, "string.bytes is a bounded view of the real bytes")
    check(string.bytes("") == null, "string.bytes of empty is the empty slice")

    arr = string.string_split("a,b,c", ",")
    av = string.array_view(arr)
    string.string_array_free(arr) // av must outlive this
    check(av.len == 3, "array_view has every element")
    check(av[0] == "a" && av[1] == "b" && av[2] == "c", "...in order")

    items = ["x", "y", "z"]
    seq = string.seq_from_strings(items)
    check(string.seq_length(seq) == 3, "seq_from_strings builds a seq of the right length")
    check(string.seq_head(seq) == "x", "...head first")
    back = string.seq_to_strings(seq)
    check(back.len == 3 && back[0] == "x" && back[2] == "z", "seq_to_strings round-trips")

    // ---- collections: a bounded view through the compatibility facade ----
    ia = collections.intarr_new_raw(3)
    collections.intarr_set_raw(ia, 0, 10)
    collections.intarr_set_raw(ia, 1, 20)
    collections.intarr_set_raw(ia, 2, 30)
    view = collections.intarr_view(ia)
    check(view.len == 3 && view[0] == 10 && view[2] == 30, "intarr_view through std.collections matches std.intarr.array()")
    collections.intarr_free(ia)

    println("OK")
}
