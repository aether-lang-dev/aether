// Regression (#2493): a heap-string argument to a closure call is freed
// after the call when the closure's parameter does not keep it.
//
// A named call `g(mk("x"))` hoists the argument into a temp and frees it
// once `g` returns, unless `g`'s body stores it. `call(f, mk("x"))`, and
// `f(mk("x"))` on a closure local, passed the argument straight through,
// so every such call leaked the string. The closure call now takes the
// same wrap, decided by the closure literal's body: a parameter that is
// only read is freed after the call, one the closure stores (in a captured
// variable, a list, a nested closure) is left to its new owner, and one
// returned as the call's string result is freed only when the result is
// not that same pointer. The macOS leaks gate runs this program.
//
// Every argument is built at runtime from a parameter, so each is a heap
// string: `string.concat` of two literals folds to a literal.

import std.string

extern exit(code: int)

check(label: string, got: string, want: string) {
    if got != want {
        println("  FAIL: ${label} got=${got} want=${want}")
        exit(1)
    }
}

check_int(label: string, got: int, want: int) {
    if got != want {
        println("  FAIL: ${label} got=${got} want=${want}")
        exit(1)
    }
}

mk(a: string) -> string {
    return string.concat(a, "!")
}

run(seed: string) {
    // Only read: freed after each call, in both spellings.
    seen = 0
    look = | s: string | {
        seen = seen + string.length(s)
    }
    i = 0
    while i < 3 {
        call(look, mk(seed))
        look(mk(seed))
        i = i + 1
    }
    check_int("read", seen, 12)

    // A value result, and two heap arguments in one call.
    both = | a: string, b: string | -> string.length(a) + string.length(b)
    check_int("two args", call(both, mk(seed), mk(seed)), 4)

    // The parameter returned as the string result: the result is the
    // closure's own copy, and the argument is freed.
    same = | s: string | -> s
    r = call(same, mk(seed))
    check("returned", r, "s!")
    r2 = same(mk(seed))
    check("returned direct", r2, "s!")

    // An interpolated argument and a nested closure call.
    check_int("interp", call(both, "${seed}-${seed}", "x"), 4)
    check("nested", call(same, call(same, mk(seed))), "s!")

    // Kept by the closure in a captured variable it writes: the variable's
    // cell owns it now and frees it. (A parameter stored in a list is kept
    // too; tests/integration/closure_call_frees_heap_arg covers that, since
    // a list does not own a string it is handed by reference.)
    last = ""
    note = | s: string | {
        last = s
    }
    note(mk(seed))
    call(note, mk(seed))
    check("kept last", last, "s!")
}

main() {
    run(string.substring("xs", 1, 2))
    println("ok")
}
