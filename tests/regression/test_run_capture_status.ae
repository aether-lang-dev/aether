// Regression test for #289 — os.run_capture returns (stdout, status, err).
//
// Pre-fix the wrapper returned only (stdout, err); the child's exit
// code was discarded by the C side. Callers that needed to
// distinguish "ran cleanly" from "ran but exited non-zero" couldn't.
// Now the third slot exposes WEXITSTATUS for normal exits and -1 for
// abnormal termination / spawn failure.
//
// Uses the platform shell with an explicit exit code rather than
// /bin/true / /bin/false directly, because the layout of those binaries
// varies by host: macOS has /usr/bin/true but /bin/true is shadowed in
// some shells; some minimal Linux containers ship only /usr/bin/true.
// POSIX guarantees /bin/sh, and `sh -c "exit N"` picks the code. On
// Windows the same test runs against the CreateProcessW backend through
// `cmd /c "exit N"`, so the Windows implementation is held to the same
// (stdout, status, err) contract on every push instead of being skipped.
//
// Cases:
//   1. shell "exit 0" — status reads 0, err is "".
//   2. shell "exit 1" — status reads 1, err is "" (spawn ok, child exits
//      non-zero).
//   3. a missing binary: (-1, "program not found") on every platform. POSIX
//      used to give (127, ""), since exec fails in the forked child; the
//      child now reports its errno to the parent on a close-on-exec pipe
//      (#3170). Windows looks the program up in the parent (#2171).
//   4. a program that runs and exits 127: (127, ""), so a caller can tell
//      it from one that could not start.

import std.os
import std.list

extern exit(code: int)

main() {
    println("=== os.run_capture status ===")

    windows = os.platform() == "windows"
    shell = "/bin/sh"
    flag = "-c"
    if windows {
        shell = "cmd"
        flag = "/c"
    }

    // Case 1: clean exit (status 0).
    av0 = list_new()
    list_add(av0, flag)
    list_add(av0, "exit 0")
    out0, status0, err0 = os.run_capture(shell, av0, null)
    if err0 != "" {
        println("  FAIL 1: spawn ${shell}: err=${err0}")
        exit(1)
    }
    if status0 != 0 {
        println("  FAIL 1: shell 'exit 0' status=${status0}, expected 0")
        exit(1)
    }
    println("  PASS: shell 'exit 0' → status 0, no err")

    // Case 2: non-zero exit, but spawn succeeded.
    av1 = list_new()
    list_add(av1, flag)
    list_add(av1, "exit 1")
    out1, status1, err1 = os.run_capture(shell, av1, null)
    if err1 != "" {
        println("  FAIL 2: spawn ${shell}: err=${err1}")
        exit(1)
    }
    if status1 != 1 {
        println("  FAIL 2: shell 'exit 1' status=${status1}, expected 1")
        exit(1)
    }
    println("  PASS: shell 'exit 1' → status 1, no err (clean exit-non-zero)")

    // Case 3: missing binary, the same on every platform (#3170).
    av2 = list_new()
    out2, status2, err2 = os.run_capture("/no/such/binary", av2, null)
    if err2 != "program not found" || status2 != -1 {
        println("  FAIL 3: missing-binary status=${status2} err='${err2}', expected -1 'program not found'")
        exit(1)
    }
    println("  PASS: missing binary → (-1, \"program not found\")")

    // Case 4: a program that ran and exited 127 is not one that could not
    // start.
    av3 = list_new()
    list_add(av3, flag)
    list_add(av3, "exit 127")
    out3, status3, err3 = os.run_capture(shell, av3, null)
    if err3 != "" || status3 != 127 {
        println("  FAIL 4: shell 'exit 127' status=${status3} err='${err3}', expected 127 and no err")
        exit(1)
    }
    println("  PASS: shell 'exit 127' → status 127, no err")

    list_free(av0)
    list_free(av1)
    list_free(av2)
    list_free(av3)
    println("=== All cases passed ===")
}
