// Regression (#2586): a string returned through a typed fn pointer
// (`fn(ptr) -> string`) is the caller's.
//
// A `string` function that returns a field returns a copy of its own (the
// uniform-heap return), and a direct caller frees it. A call through a typed
// fn pointer could not tell which function was behind it and took the result
// as borrowed, so ae3d's component copy, `setter(dst, getter(src))`, leaked
// one string per call. Now a function used as such a value marks the owned
// string it returns, a call through the pointer takes a marked result as it
// is and copies anything else (a literal, a borrow, C's string), and an owned
// string argument to such a call is freed after the call. A @c_callback
// function, a sized-array parameter, clauses that disagree on what they hand
// over, a clause set whose literal pattern precedes the stored argument, a
// call inside an extern's argument and a tuple function that destructures
// itself are covered too. The C side (pointers C made, a function handed to
// C) is tests/integration/fnptr_string_c_side.
//
// The leak check runs where the heap count is exact (mem.heap_in_use_exact):
// after a warm-up, some window of the same work grows by exactly 0
// (mem.steady_growth). Strings are built from parameters, because
// string.concat of two literals folds to a literal.

import std.list
import std.mem
import std.string

extern exit(code: int)
extern abs(x: int) -> int

// Where put_name's storing clause keeps its argument (a module-level var
// holds what it is given for the life of the program).
var g_kept: string = ""

struct Thing {
    name: string
    n: int
}

struct Field {
    get_text: fn(ptr) -> string
    set_text: fn(ptr, string)
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

text(value: string) -> string {
    if value == null {
        return ""
    }
    return value
}

set_owned(previous: string, value: string) -> string {
    fresh = string.copy(value)
    if previous != null {
        string.free(previous)
    }
    return fresh
}

// A field, returned as a copy of its own.
name_of(p: ptr) -> string {
    return (p as *Thing).name
}

// A fresh string.
loud_name(p: ptr) -> string {
    return string.concat((p as *Thing).name, "!")
}

// The caller's own pointer or a literal, handed back as it came.
plain_name(p: ptr) -> string {
    return text((p as *Thing).name)
}

set_name(p: ptr, value: string) {
    t = p as *Thing
    t.name = set_owned(t.name, value)
}

new_thing(w: string) -> *Thing {
    t = heap.new(Thing)
    t.name = string.concat(w, "#")
    return t
}

new_field(g: fn(ptr) -> string, s: fn(ptr, string)) -> *Field {
    f = heap.new(Field)
    f.get_text = g
    f.set_text = s
    return f
}

// ae3d's copy_field: the getter's string goes straight to the setter.
copy_field(dst: ptr, src: ptr, f: *Field) {
    getter = f.get_text
    setter = f.set_text
    if getter != null && setter != null {
        setter(dst, getter(src))
    }
}

// ae3d's get_text: a function that returns what the pointer returned.
get_text(t: ptr, f: *Field) -> string {
    if t == null || f.get_text == null {
        return ""
    }
    getter = f.get_text
    return getter(t)
}

round(fields: ptr, a: *Thing, b: *Thing) -> int {
    total = 0
    k = 0
    while k < 3 {
        f = list_field(fields, k)
        copy_field(b as ptr, a as ptr, f)
        total = total + string.length(get_text(b as ptr, f))
        // A field call: the struct's fn-pointer member called directly.
        total = total + string.length(f.get_text(a as ptr))
        k = k + 1
    }
    // A function name passed for a typed fn-pointer parameter.
    total = total + length_through(loud_name, a as ptr)
    total = total + length_through(tag_cb, a as ptr)
    total = total + length_of_pick(pick_of, string.concat(a.name, "?"))
    total = total + length_of_clause(clause_name, 5) + length_of_clause(clause_name, 0)
    m = measure as fn(fn(string) -> string, string) -> int
    total = total + abs(m(label_of, a.name))
    return total
}

// A string a named function returns, read through a typed pointer inside an
// extern's argument.
measure(f: fn(string) -> string, s: string) -> int {
    return string.length(f(s))
}

label_of(s: string) -> string {
    return "label"
}

// A clause set used as a typed pointer, whose first clause has a literal
// pattern before the string a later clause stores: the argument's position
// counts the literal.
put_name(t: ptr, 0, s: string) -> int {
    return 0
}
put_name(t: ptr, n: int, s: string) -> int {
    g_kept = s
    return n
}

// A tuple function that destructures its own result, reached from a
// function used as a value: the classifiers recursed until the compiler's
// stack ran out.
count_x(n: int, acc: string) -> (string, int) {
    if n == 0 {
        return acc, 0
    }
    s, k = count_x(n - 1, string.concat(acc, "y"))
    return s, k + 1
}

count_work(w: string) -> int {
    c, k = count_x(2, w)
    return string.length(c) + k
}

length_through(g: fn(ptr) -> string, p: ptr) -> int {
    return string.length(g(p))
}

// A @c_callback function, defined under the symbol it binds, used as a value.
@c_callback
tag_cb(p: ptr) -> string {
    return "callback"
}

// A sized-array parameter, declared as an array in the adapter.
pick_of(xs: int[2], w: string) -> string {
    if xs[0] > 0 {
        return w
    }
    return "none"
}

length_of_pick(g: fn(int[2], string) -> string, w: string) -> int {
    arr = [1, 2]
    return string.length(g(arr, w))
}

// Clauses that disagree: one hands over a fresh string, one a literal.
clause_name(n: int) when n > 0 -> string {
    return string.concat("p", string.from_int(n))
}
clause_name(n: int) -> string {
    return "lit"
}

length_of_clause(g: fn(int) -> string, n: int) -> int {
    return string.length(g(n))
}

list_field(fields: ptr, k: int) -> *Field {
    return list.get_raw(fields, k) as *Field
}

main() {
    println("=== test_fnptr_string_results ===")
    a = new_thing("w")
    b = new_thing("v")
    fields = list.new()
    list.add(fields, new_field(name_of, set_name) as ptr)
    list.add(fields, new_field(loud_name, set_name) as ptr)
    list.add(fields, new_field(plain_name, set_name) as ptr)
    // Per field: b after the copy, read back, then a read directly. The
    // loud getter adds "!" to whatever it reads: "w#!" copied into b reads
    // back as "w#!!". The last field copies plain_name's "w#".
    check(round(fields, a, b) == (2 + 2) + (4 + 3) + (2 + 2) + 3 + 8 + 3 + 2 + 3 + 5, "a round adds up")
    check(b.name == "w#", "the copied field holds its own string")
    keep = put_name as fn(ptr, int, string) -> int
    check(keep(a as ptr, 1, string.concat(a.name, "cd")) == 1, "the storing clause ran")
    filler = string.concat(a.name, "zzzz")
    check(g_kept == "w#cd" && filler == "w#zzzz", "a stored argument outlives the call")
    counter = count_work as fn(string) -> int
    check(counter(a.name) == 6, "a tuple function that destructures itself")
    i = 0
    while i < 20 {
        round(fields, a, b)
        i = i + 1
    }
    if mem.heap_in_use_exact() {
        grown = mem.steady_growth(|| {
                k = 0
                while k < 200 {
                    round(fields, a, b)
                    k = k + 1
                }
            }, 5)
        check(grown == 0, "a window of 200 rounds grew the heap by ${grown} bytes in every run")
    }
    k = 0
    while k < 3 {
        heap.free(list_field(fields, k))
        k = k + 1
    }
    list.free(fields)
    heap.free(a)
    heap.free(b)
    println("=== test_fnptr_string_results passed ===")
}
