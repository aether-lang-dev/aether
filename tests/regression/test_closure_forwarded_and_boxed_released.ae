// Regression: two closure shapes that leaked their env by design.
//
// A callback passed to a function that only passes it on to another that
// calls it (`it(cb) { it_impl(cb) }`) is dead after the call, like one
// passed to a function that calls it itself; the callee-body walk decided
// a `fn` parameter passed on was kept by its kind before reading the
// callee's body, so the env was never drained. And `list.add(l,
// box_closure(f))` is the store `list.add(l, f)` spelled with the box the
// coercion would make: the list holds its own reference and owns the box,
// so f's scope releases f's. Stored as a raw pointer, neither the box nor
// the env was reclaimed. The macOS leaks gate runs this file.

import std.list
import std.mem
import std.string

extern exit(code: int)

it_impl(cb: fn) { call(cb) }
it(cb: fn) { it_impl(cb) }
twice_over(cb: fn) { it(cb); it(cb) }

forward(k: int) -> int {
    n = k
    it(|| { n = n + 1 })
    twice_over(|| { n = n + 10 })
    return n
}

boxed_add(k: int) -> int {
    s = string.concat("b", string.from_int(k))
    f = || { return string.length(s) + k }
    l = list.new()
    list.add(l, box_closure(f))
    list.add(l, box_closure(|| { return k }))
    fn g = unbox_closure(list.get_raw(l, 0))
    fn h = unbox_closure(list.get_raw(l, 1))
    int v = call(g) + call(h)
    list.free(l)
    int w = call(f)
    return v + w
}

rounds(n: int) {
    i = 0
    while i < n {
        forward(i)
        boxed_add(i)
        i = i + 1
    }
}

main() {
    println("=== test_closure_forwarded_and_boxed_released ===")
    if forward(3) != 24 { println("  FAIL forward: ${forward(3)} want 24"); exit(1) }
    if boxed_add(3) != 2 + 3 + 3 + 2 + 3 { println("  FAIL boxed: ${boxed_add(3)} want 13"); exit(1) }
    // Where the allocator's count is exact: a leak grows every window of
    // calls, while a one-time allocation, or a thread the system starts in
    // the process, settles. So, warm, some window holds exactly steady
    // (mem.steady_growth).
    if mem.heap_in_use_exact() {
        rounds(20)
        grown = mem.steady_growth(|| {
                rounds(200)
            }, 5)
        if grown != 0 {
            println("  FAIL a window of 200 rounds grew the heap by ${grown} bytes in every run")
            exit(1)
        }
    }
    println("  PASS: a forwarded callback and a boxed store release their env")
    println("=== test_closure_forwarded_and_boxed_released passed ===")
}
