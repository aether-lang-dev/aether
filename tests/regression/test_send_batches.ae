// Regression (#3117): which loops batch their sends, and what a batch keeps.
//
// The compiler opened a send batch around every `while` loop that sent, so
// a loop that waited between sends held its messages until it ended, a
// message with a payload went around the batch and overtook the one-int ones
// sent before it, and an inner loop's batch emptied the outer one's, losing
// its messages. Now only a loop that cannot wait between its sends is
// batched, every send in it joins the batch, and an inner loop joins the
// outer loop's. A loop a labeled `break` can leave is not batched: the
// break jumps past the end where the batch is sent.

extern exit(code: int)

message Add { n: int }
message Note { n: int, tag: string }

actor Sum {
    state count = 0
    state last = -1
    state in_order = 1
    receive {
        Add(n) -> {
            count = count + 1
            if n != last + 1 { in_order = 0 }
            last = n
        }
        Note(n, tag) -> {
            count = count + 1
            if n != last + 1 { in_order = 0 }
            last = n
        }
    }
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL #3117: ${msg}")
        exit(1)
    }
}

main() {
    // A loop that waits between sends: each one is delivered as it goes.
    c = spawn(Sum())
    i = 0
    while i < 3 {
        c ! Add { n: i }
        wait_for_idle()
        check(c.count == i + 1, "a waiting loop's send ${i} was held: ${c.count} handled")
        i = i + 1
    }

    // A batched loop of one-int and payload messages keeps their order.
    m = spawn(Sum())
    i = 0
    while i < 40 {
        if i % 2 == 0 {
            m ! Add { n: i }
        } else {
            m ! Note { n: i, tag: "odd" }
        }
        i = i + 1
    }
    wait_for_idle()
    check(m.count == 40, "the mixed loop delivered ${m.count} of 40")
    check(m.in_order == 1, "a payload message overtook a one-int one")

    // An inner loop joins the outer loop's batch, which loses nothing.
    a = spawn(Sum())
    b = spawn(Sum())
    i = 0
    while i < 10 {
        a ! Add { n: i }
        j = 0
        while j < 2 {
            b ! Add { n: i * 2 + j }
            j = j + 1
        }
        i = i + 1
    }
    wait_for_idle()
    check(a.count == 10, "the outer loop's messages: ${a.count} of 10")
    check(b.count == 20, "the inner loop's messages: ${b.count} of 20")

    // An inner loop that sends and leaves the outer one with `break outer`.
    // Nothing flushes after it (wait_for_idle would), so the messages must
    // have gone as they were sent.
    d = spawn(Sum())
    k = 0
    outer: while k < 3 {
        check(k == 0, "the labeled break did not leave the outer loop")
        j = 0
        while j < 10 {
            d ! Add { n: j }
            if j == 4 { break outer }
            j = j + 1
        }
        k = k + 1
    }
    sleep(500)
    check(d.count == 5, "a loop left by a labeled break kept ${5 - d.count} of 5 messages")

    // #3826: a `for` loop is batched as a `while` loop is. Its mixed
    // messages keep their order.
    f = spawn(Sum())
    for i in 0..40 {
        if i % 2 == 0 {
            f ! Add { n: i }
        } else {
            f ! Note { n: i, tag: "odd" }
        }
    }
    wait_for_idle()
    check(f.count == 40, "the mixed for loop delivered ${f.count} of 40")
    check(f.in_order == 1, "a for loop's payload message overtook a one-int one")

    // A `for` inside a `while` and a `while` inside a `for` join the outer
    // loop's batch.
    g = spawn(Sum())
    h = spawn(Sum())
    i = 0
    while i < 10 {
        g ! Add { n: i }
        for j in 0..2 {
            h ! Add { n: i * 2 + j }
        }
        i = i + 1
    }
    for p in 0..10 {
        h ! Add { n: 20 + p * 2 }
        j = 0
        while j < 1 {
            h ! Add { n: 21 + p * 2 }
            j = j + 1
        }
    }
    wait_for_idle()
    check(g.count == 10, "the while loop's messages around a for: ${g.count} of 10")
    check(h.count == 40, "the nested for and while messages: ${h.count} of 40")
    check(h.in_order == 1, "nested for and while loops reordered their messages")

    // A `for` left by a plain `break` sends its batch where the loop ends:
    // nothing flushes after it, so the messages must have gone there.
    q = spawn(Sum())
    for n in 0..10 {
        q ! Add { n: n }
        if n == 4 { break }
    }
    sleep(500)
    check(q.count == 5, "a for loop left by break kept ${5 - q.count} of 5 messages")

    // A `for` a labeled break leaves is not batched.
    r = spawn(Sum())
    outer2: for k2 in 0..3 {
        check(k2 == 0, "the labeled break did not leave the outer for loop")
        for j2 in 0..10 {
            r ! Add { n: j2 }
            if j2 == 4 { break outer2 }
        }
    }
    sleep(500)
    check(r.count == 5, "a for loop left by a labeled break kept ${5 - r.count} of 5 messages")
    println("PASS #3117: loops batch only what cannot wait, in order, nothing lost")
}
