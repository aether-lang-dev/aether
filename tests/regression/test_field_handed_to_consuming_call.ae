// Regression: a struct's string field handed to a call that frees it gives
// its reference up, so nothing frees the same buffer again.
//
// A function that frees its `string` parameter takes the reference its
// caller passed. A local handed to one already counted as escaped; a field
// kept its `_heap_<field>` tracker set, so the next free of the field freed
// the buffer a second time:
//   - `p.name = set_owned(p.name, v)`, `set_owned` freeing its first
//     argument, through a box whose tracker the store reads (a heap.new
//     local, and a parameter every call fills with one): the store freed
//     the old value set_owned had already freed;
//   - `string.free(p.name)` or a helper that frees its argument, then
//     heap.free(p): the destructor freed it again;
//   - a field of a struct a call returned, kept in a temporary the
//     statement destroys: `drop(make_box(w).item.name)`.
// The frees a callee can take a reference with release a counted
// AetherString and leave a plain malloc'd buffer (an `@heap` extern's,
// os.getenv here) alone, so a plain buffer stays the field's own, for the
// field to free.
//
// The heap check runs where the count is exact (mem.heap_in_use_exact):
// after a warm-up, some window of the same work grows by exactly 0
// (mem.steady_growth). Strings are built from parameters, because
// string.concat of two literals folds to a literal.

import std.mem
import std.os
import std.string

extern exit(code: int)
// The runtime free under another name, as std.jsonpath binds it: a free all
// the same, so a local or field handed to it gives its reference up.
@extern("string_free") drop_raw(s: string)

struct Item {
    name: string
    tag: string
}

struct Box {
    item: Item
    n: int
}

fn check(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

set_owned(previous: string, value: string) -> string {
    fresh = string.copy(value)
    if previous != null { string.free(previous) }
    return fresh
}

drop(s: string) {
    string.free(s)
}

var made = 0
var seen = 0

counted_box(w: string) -> Box {
    made = made + 1
    return make_box(w)
}

// The second argument reads what the first one's call changes, so the
// first is evaluated ahead of the call into a temporary (#2478); the field
// is handed over there, once.
eat(s: string, n: int) {
    string.free(s)
    seen = n
}

set_name(it: *Item, name: string) {
    it.name = set_owned(it.name, name)
}

make_box(w: string) -> Box {
    return Box { item: Item { name: string.concat(w, "#"), tag: "${w}%" }, n: 1 }
}

round(w: string) -> int {
    it = heap.new(Item)
    set_name(it, w)
    set_name(it, w)
    it.name = set_owned(it.name, w)
    check(it.name == w, "set_owned through a parameter and a local box")
    it.tag = string.concat(w, "#")
    string.free(it.tag)
    it.tag = string.concat(w, "%")
    drop(it.tag)
    // Plain malloc'd buffers.
    it.tag = os.getenv("PATH")
    drop(it.tag)
    it.tag = os.getenv("PATH")
    string.free(it.tag)
    it.tag = os.getenv("PATH")
    release(it.tag)
    it.tag = os.getenv("PATH")
    // The free under an alias, of a local and of a field.
    loose = string.concat(w, "~")
    drop_raw(loose)
    it.tag = string.concat(w, "^")
    drop_raw(it.tag)
    // A field of a statement's temporary struct.
    drop(make_box(w).item.name)
    drop(make_box(w).item.tag)
    before = made
    eat(counted_box(w).item.name, made)
    check(made == before + 1 && seen == made, "the struct's call runs once, before the next argument")
    n = string.length(it.name)
    heap.free(it)
    return n
}

main() {
    println("=== test_field_handed_to_consuming_call ===")
    check(string.length(os.getenv("PATH")) > 0, "a PATH in the environment")
    check(round("abc") == 3, "the name survives every replacement")
    i = 0
    while i < 20 {
        round("abc")
        i = i + 1
    }
    if mem.heap_in_use_exact() {
        grown = mem.steady_growth(|| {
                k = 0
                while k < 200 {
                    round("abc")
                    k = k + 1
                }
            }, 5)
        check(grown == 0, "a window of 200 rounds grew the heap by ${grown} bytes in every run")
    }
    println("=== test_field_handed_to_consuming_call passed ===")
}
