// Regression: a closure's capture shadows a top-level function of its name.
//
// Outside a closure a parameter or local named like a top-level function is
// that parameter or local (#1657). Inside one it was not: the closure body's
// prologue declares each read-only capture (`_AeClosure cb = _env->cb;`) but
// never registered it as a binding of the body, so every codegen site that
// asks "is this identifier a top-level function?" and defers to a local
// binding first found none, and the program's `cb` won. A captured `fn` passed
// on as a value became `_aether_bare_adapter_cb` with `.env = NULL`: the
// caller's closure was dropped, the top-level function ran in its place
// (wrong output, or a SIGSEGV through a mismatched signature, as aether-ui's
// `reorderable(cb: fn ...)` did beside a program's own `cb`), and where the
// adapter was never declared the C did not compile.
//
// Each shape below was wrong. The top-level `cb` must never run.
// tests/integration/closure_capture_shadows_consumer_fn covers the parameter
// of an imported module's function against the program's function.

extern exit(code: int)

cb(x: int, y: int) {
    println("FAIL: the top-level cb ran (${x}, ${y}) in place of a captured binding")
    exit(1)
}

run_it(f: fn) {
    f(1)
}

call2(g: fn, a: int, b: int) {
    g(a, b)
}

call_boxed(p: ptr, a: int, b: int) {
    g = unbox_closure(p)
    g(a, b)
}

get_it(f: fn) -> fn {
    return f()
}

struct Holder {
    f: fn
}

// A captured `fn` parameter passed on as an argument.
param_as_argument(cb: fn, x: int) {
    run_it(| n: int | { call2(cb, n, x) })
}

// A captured local (not a parameter) passed on as an argument.
local_as_argument(x: int) {
    cb = | a: int, b: int | { println("ok local_as_argument ${a} ${b}") }
    run_it(| n: int | { call2(cb, n, x) })
}

// A closure nested in a closure, the capture two levels out.
nested_closure(cb: fn, x: int) {
    run_it(| n: int | {
            run_it(| m: int | { call2(cb, n + m, x) })
        })
}

// Bound to a local in the closure body (the C did not compile).
assigned_in_closure(cb: fn, x: int) {
    run_it(| n: int | {
            h = cb
            call2(h, n, x)
        })
}

// Boxed into a `ptr`.
boxed_in_closure(cb: fn, x: int) {
    run_it(| n: int | { call_boxed(box_closure(cb), n, x) })
}

// Returned from a closure (the C did not compile).
returned_from_closure(cb: fn) -> fn {
    return get_it(|| { return cb })
}

// Stored into a struct's `fn` field (the C did not compile).
stored_in_field(cb: @keep fn, x: int) {
    run_it(| n: int | {
            h = Holder { f: cb }
            g = h.f
            g(n, x)
        })
}

// A `callback { }` trailing block passed on as a closure.
trailing_callback(cb: fn, x: int) {
    run_it() callback {
        call2(cb, 1, x)
    }
}

// Not wrong before: a non-fn capture, and the name as the callee.
int_capture(cb: int) {
    run_it(| n: int | { println("ok int_capture ${cb + n}") })
}

callee_in_closure(cb: fn, x: int) {
    run_it(| n: int | { cb(n, x) })
}

main() {
    param_as_argument(| a: int, b: int | { println("ok param_as_argument ${a} ${b}") }, 3)
    local_as_argument(3)
    nested_closure(| a: int, b: int | { println("ok nested_closure ${a} ${b}") }, 3)
    assigned_in_closure(| a: int, b: int | { println("ok assigned_in_closure ${a} ${b}") }, 3)
    boxed_in_closure(| a: int, b: int | { println("ok boxed_in_closure ${a} ${b}") }, 3)
    g = returned_from_closure(| a: int, b: int | { println("ok returned_from_closure ${a} ${b}") })
    g(1, 3)
    stored_in_field(| a: int, b: int | { println("ok stored_in_field ${a} ${b}") }, 3)
    trailing_callback(| a: int, b: int | { println("ok trailing_callback ${a} ${b}") }, 3)
    int_capture(41)
    callee_in_closure(| a: int, b: int | { println("ok callee_in_closure ${a} ${b}") }, 3)
    println("PASS: a closure's capture shadows a top-level function of its name")
}
