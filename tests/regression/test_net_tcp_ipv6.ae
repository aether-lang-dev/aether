// TCP over IPv6: tcp.listen_on takes "::1", "[::1]" and "::" (both
// families; not built on Windows, where the wildcard opens a firewall
// prompt), tcp.connect dials an IPv6 literal, bracketed or not, and an
// IPv4 client reaches a "::" listener. Every one of these was refused
// while std.net resolved and bound IPv4 only. std.tcp's functions are the
// public face of the same C std.net binds (#3166).
//
// Skips where the host has no IPv6 loopback. On Linux that is asked of
// /proc, not of the code under test, so a listener that can't bind ::1 on a
// host that has it fails rather than skipping.

import std.tcp
import std.fs
import std.string

extern exit(code: int)

has_v6_loopback() -> int {
    if fs.exists("/proc/net/if_inet6") == 0 { return -1 } // unknown here
    text, err = fs.read("/proc/net/if_inet6")
    if err != "" { return -1 }
    if string.contains(text, "00000000000000000000000000000001 ") == 1 { return 1 }
    return 0
}

// Connect to `dial` at the port of `srv`, a listener on `what` (`lerr` its
// error), and close both. "" or why not.
round_trip(srv: ptr, lerr: string, what: string, dial: string) -> string {
    if lerr != "" { return "listen on ${what} refused: ${lerr}" }
    port = tcp.server_port(srv)
    conn, cerr = tcp.connect(dial, port)
    _ = tcp.server_close(srv)
    if cerr != "" { return "connect to ${dial} port ${port} (listener ${what}) failed: ${cerr}" }
    _ = tcp.close(conn)
    return ""
}

fail_if(err: string) {
    if err != "" {
        println("FAIL: ${err}")
        exit(1)
    }
}

main() {
    v6 = has_v6_loopback()
    if v6 == 0 {
        println("SKIP: no IPv6 loopback on this host")
        return
    }
    probe, perr = tcp.listen_on("::1", 0)
    if perr != "" {
        if v6 == 1 {
            println("FAIL: tcp.listen_on refused ::1, which this host has: ${perr}")
            exit(1)
        }
        println("SKIP: ::1 cannot be bound here")
        return
    }
    _ = tcp.server_close(probe)

    s1, e1 = tcp.listen_on("::1", 0)
    fail_if(round_trip(s1, e1, "::1", "::1"))
    s2, e2 = tcp.listen_on("::1", 0)
    fail_if(round_trip(s2, e2, "::1", "[::1]"))
    s3, e3 = tcp.listen_on("[::1]", 0) // loopback-ok: the bracketed spelling of ::1
    fail_if(round_trip(s3, e3, "[::1]", "::1"))
    // Dual-stack needs the wildcard, which opens a firewall prompt on
    // Windows; it is checked everywhere else.
    when target.os != "windows" {
        s4, e4 = tcp.listen_on("::", 0) // loopback-ok: dual-stack needs the wildcard (not built on Windows)
        fail_if(round_trip(s4, e4, "::", "::1"))
        // OpenBSD has no IPv4-mapped IPv6 sockets (IPV6_V6ONLY cannot be
        // turned off), so a listener on :: takes IPv6 only there.
        when target.os != "openbsd" {
            s5, e5 = tcp.listen_on("::", 0) // loopback-ok: as above
            fail_if(round_trip(s5, e5, "::", "127.0.0.1"))
        }
    }
    // A name is still refused as a listen address.
    _named, nerr = tcp.listen_on("localhost", 0) // loopback-ok: refused before any bind
    if nerr == "" {
        println("FAIL: tcp.listen_on accepted a name")
        exit(1)
    }
    println("PASS")
}
