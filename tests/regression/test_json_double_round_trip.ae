// Regression: a double written by std.json parses back to the same double
// (#2290).
//
// stringify wrote a non-integer number with %g, six significant digits, so
// 0.061234567891 came back as 0.0612346: a document written and read again
// was a different document. It now writes %.15g when that reads back as the
// same double, else %.16g, else %.17g, which always does. A NaN or an
// infinity, which JSON cannot spell, is written as null.
//
// Two checks: the exact text for values whose shortest form is known (the
// same digits Python's repr writes), and a sweep of computed doubles that
// must each survive stringify then parse unchanged.

import std.json
import std.string

extern exit(code: int)

// The number in `text`, parsed, stringified; "<err>" on failure.
rewrite(text: string) -> string {
    v, perr = json.parse(text)
    if perr != "" { return "<parse-err>" }
    out, serr = json.stringify(v)
    json.free(v)
    if serr != "" { return "<stringify-err>" }
    return out
}

check(input: string, want: string) -> int {
    got = rewrite(input)
    if string.equals(got, want) == 1 {
        println("  PASS ${input} -> ${got}")
        return 0
    }
    println("  FAIL ${input} -> ${got}, want ${want}")
    return 1
}

// `x` written and read back; 1 when it is not the same double.
round_trip_differs(x: float) -> int {
    node = json.num(x)
    text, serr = json.stringify(node)
    json.free(node)
    if serr != "" { return 1 }
    back, perr = json.parse(text)
    if perr != "" { return 1 }
    y = json.json_get_number(back)
    json.free(back)
    if y != x {
        println("  FAIL ${text} reads back as ${y}")
        return 1
    }
    return 0
}

main() {
    fails = 0
    println("std.json writes each double so it reads back unchanged")

    fails = fails + check("0.061234567891", "0.061234567891")
    fails = fails + check("0.1", "0.1")
    fails = fails + check("1.5", "1.5")
    fails = fails + check("0.30000000000000004", "0.30000000000000004")
    fails = fails + check("0.3333333333333333", "0.3333333333333333")
    fails = fails + check("3.141592653589793", "3.141592653589793")
    fails = fails + check("123456789.12345679", "123456789.12345679")
    fails = fails + check("1.7976931348623157e308", "1.7976931348623157e+308")
    fails = fails + check("2.2250738585072014e-308", "2.2250738585072014e-308")
    fails = fails + check("1e21", "1e+21")
    fails = fails + check("1e-7", "1e-07")
    fails = fails + check("-0.0", "-0")
    fails = fails + check("[0.5, 0.25, 0.061234567891]", "[0.5,0.25,0.061234567891]")

    // #2290's program.
    value = 0.061234567891
    fails = fails + round_trip_differs(value)

    // A sweep: thirds, sevenths and their products across many magnitudes.
    swept = 0
    i = 1
    while i <= 2000 {
        x = i / 3.0
        y = i / 7.0 * 1.1
        z = 0.0 - i * 0.017
        scale = 1.0
        k = 0
        while k < 12 {
            fails = fails + round_trip_differs(x * scale)
            fails = fails + round_trip_differs(y / scale)
            fails = fails + round_trip_differs(z * scale)
            swept = swept + 3
            scale = scale * 1000.0
            k = k + 1
        }
        i = i + 1
    }
    println("  swept ${swept} doubles")

    // No JSON spelling for these: null, as JSON.stringify writes them.
    big = 1.0
    j = 0
    while j < 400 {
        big = big * 10.0
        j = j + 1
    }
    inf_node = json.num(big)
    inf_text, _ = json.stringify(inf_node)
    json.free(inf_node)
    if string.equals(inf_text, "null") == 1 {
        println("  PASS infinity -> null")
    } else {
        println("  FAIL infinity -> ${inf_text}, want null")
        fails = fails + 1
    }
    nan_node = json.num(big - big)
    nan_text, _ = json.stringify(nan_node)
    json.free(nan_node)
    if string.equals(nan_text, "null") == 1 {
        println("  PASS NaN -> null")
    } else {
        println("  FAIL NaN -> ${nan_text}, want null")
        fails = fails + 1
    }

    if fails > 0 {
        println("${fails} failure(s)")
        exit(1)
    }
    println("all passed")
}
