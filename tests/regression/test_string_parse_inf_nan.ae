// Regression (#2472): string.to_double and string.to_float read the C99
// "inf" / "infinity" / "nan" spellings, in any case and with a sign, on
// every platform. string.from_double writes "Infinity", "-Infinity" and
// "NaN", and on Windows (msvcrt's _strtod_l) none of them read back:
// to_double(from_double(1.0 / 0.0)) failed with "invalid double".
import std.mem
import std.string

extern exit(code: int)

const INF_BITS = 0x7ff0000000000000
const NEG_INF_BITS = 0xfff0000000000000
const EXP_MASK = 0x7ff0000000000000
const MANT_MASK = 0x000fffffffffffff

is_nan(v: float) -> int {
    bits = mem.bits_of_float(v)
    if (bits & EXP_MASK) == EXP_MASK && (bits & MANT_MASK) != 0 { return 1 }
    return 0
}

// want: 1 = +inf, -1 = -inf, 2 = NaN, 3 = NaN with the sign bit set.
matches(v: float, want: int) -> int {
    bits = mem.bits_of_float(v)
    if want == 1 { if bits == INF_BITS { return 1 } return 0 }
    if want == -1 { if bits == NEG_INF_BITS { return 1 } return 0 }
    if is_nan(v) == 0 { return 0 }
    if want == 3 { if bits < 0 { return 1 } return 0 }
    return 1
}

accept(s: string, want: int) -> int {
    fails = 0
    d, derr = string.to_double(s)
    if derr != "" || matches(d, want) != 1 {
        println("  FAIL to_double(\"${s}\"): ${d} err='${derr}'")
        fails = fails + 1
    }
    f, ferr = string.to_float(s)
    if ferr != "" || matches(f, want) != 1 {
        println("  FAIL to_float(\"${s}\"): ${f} err='${ferr}'")
        fails = fails + 1
    }
    return fails
}

reject(s: string) -> int {
    fails = 0
    _d, derr = string.to_double(s)
    if derr == "" {
        println("  FAIL to_double(\"${s}\") should error")
        fails = fails + 1
    }
    _f, ferr = string.to_float(s)
    if ferr == "" {
        println("  FAIL to_float(\"${s}\") should error")
        fails = fails + 1
    }
    return fails
}

roundtrip(bits: long, want: int) -> int {
    text = string.from_double(mem.float_from_bits(bits))
    v, err = string.to_double(text)
    if err != "" || matches(v, want) != 1 {
        println("  FAIL round-trip of \"${text}\": ${v} err='${err}'")
        return 1
    }
    return 0
}

main() {
    println("=== to_double / to_float: inf and nan spellings ===")
    fails = 0

    // from_double's own output reads back.
    fails = fails + roundtrip(INF_BITS, 1)
    fails = fails + roundtrip(NEG_INF_BITS, -1)
    fails = fails + roundtrip(0x7ff8000000000000, 2)

    // Every case and sign.
    fails = fails + accept("inf", 1)
    fails = fails + accept("INF", 1)
    fails = fails + accept("Inf", 1)
    fails = fails + accept("+inf", 1)
    fails = fails + accept("-inf", -1)
    fails = fails + accept("infinity", 1)
    fails = fails + accept("INFINITY", 1)
    fails = fails + accept("Infinity", 1)
    fails = fails + accept("-Infinity", -1)
    fails = fails + accept("+InFiNiTy", 1)
    fails = fails + accept("nan", 2)
    fails = fails + accept("NAN", 2)
    fails = fails + accept("NaN", 2)
    fails = fails + accept("+nan", 2)
    fails = fails + accept("-nan", 3)
    fails = fails + accept("-NaN", 3)
    fails = fails + accept("nan()", 2)
    fails = fails + accept("nan(0x1f_A)", 2)
    // Surrounding whitespace, as for any other number.
    fails = fails + accept("  inf", 1)
    fails = fails + accept("-infinity  ", -1)
    fails = fails + accept("nan\n", 2)

    // Prefixes of the spellings, and trailing garbage after them.
    fails = fails + reject("in")
    fails = fails + reject("na")
    fails = fails + reject("infinit")
    fails = fails + reject("infx")
    fails = fails + reject("infinityx")
    fails = fails + reject("nanx")
    fails = fails + reject("nan(")
    fails = fails + reject("nan(1")
    fails = fails + reject("nan(1-2)")
    fails = fails + reject("+-inf")
    fails = fails + reject("--nan")
    fails = fails + reject("i nf")

    // Ordinary numbers are untouched.
    one, oerr = string.to_double("1.5")
    if oerr != "" || one != 1.5 { println("  FAIL to_double(\"1.5\")"); fails = fails + 1 }
    big, berr = string.to_double("1e999")
    if berr == "" { println("  FAIL to_double(\"1e999\") overflow accepted as ${big}"); fails = fails + 1 }

    if fails > 0 {
        println("FAIL: ${fails} checks failed")
        exit(1)
    }
    println("All PASS")
}
