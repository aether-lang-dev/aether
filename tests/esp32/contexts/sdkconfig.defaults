CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Aether's task contexts keep a task's context in FreeRTOS thread-local
# pointer slot 1 (slot 0 is ESP-IDF's pthreads'), with its deletion callback.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
CONFIG_FREERTOS_TLSP_DELETION_CALLBACKS=y
# The Aether tasks share one core, as on a single-core ESP32-C3.
CONFIG_FREERTOS_UNICORE=y
# The test's Aether tasks keep the core busy; the idle task's watchdog is
# not what this test is about.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
