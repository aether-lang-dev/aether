// Regression: ref cell survives across a function return. The cell is
// heap-allocated so the pointer remains valid; this was the documented
// escape hatch back when escaping closures didn't work at all, and
// must still work now that they do.

extern exit(code: int)

// The counter's cell is handed back beside the closure that uses it: it
// outlives this call, and the caller frees it when the closure is done.
make_counter() -> (ptr, fn) {
    count = ref(0)
    return count, || { ref_set(count, ref_get(count) + 1); return ref_get(count) }
}

main() {
    cell, c = make_counter()
    a = call(c)
    if a != 1 { println("FAIL: first"); exit(1) }
    b = call(c)
    if b != 2 { println("FAIL: second"); exit(1) }
    d = call(c)
    if d != 3 { println("FAIL: third"); exit(1) }
    if ref_get(cell) != 3 { println("FAIL: the cell the closure counts in"); exit(1) }
    ref_free(cell)
    println("ok")
}
