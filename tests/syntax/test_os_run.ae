// Test: os.run / os.run_capture, argv-based child process launch, through
// std.os's public functions (#3166).
//
// The point of os.run is that there is NO SHELL between us and the child:
// argv items are passed verbatim, so paths-with-spaces, $variables, |, ;,
// *, and other shell metacharacters are not interpreted.
//
// Platform note: the programs are run by absolute path, found on PATH first
// (true and false are /bin on Linux but /usr/bin on FreeBSD). It SKIPs on:
//   - Windows: none of those paths exist there
//   - macOS: /usr/bin/seq doesn't exist; /bin/echo differs (BSD vs GNU)

import std.os
import std.list
import std.string

extern exit(code: int)
extern os_which(name: string) -> string @heap

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

// The absolute path of a system program, which the test runs by that path.
bin(name: string) -> string {
    path = os_which(name)
    if string.starts_with(path, "/") != 1 {
        fail("${name} is not on PATH")
    }
    return path
}

// The program's stdout, failing the test if it could not be run.
capture(prog: string, argv: ptr, env: ptr) -> string {
    out, _status, err = os.run_capture(prog, argv, env)
    if err != "" {
        fail("${prog} could not be run: ${err}")
    }
    return out
}

main() {
    if os.platform() == "windows" {
        println("SKIP os_run: Linux-only paths")
        return
    }
    // Detect macOS (Darwin) vs Linux via `uname -s`: "Darwin\n" on macOS,
    // "Linux\n" on Linux. The paths the test itself exercises can't be the
    // probe (that would be circular).
    uname, uerr = os.exec("uname -s")
    if uerr != "" {
        fail("uname -s: ${uerr}")
    }
    if string.starts_with(uname, "Darwin") == 1 {
        println("SKIP os_run: Linux-only paths (no /usr/bin/seq on macOS, BSD echo differs)")
        return
    }

    // 1. true should exit 0
    argv = list.new()
    if os.run(bin("true"), argv, null) != 0 { fail("true should return 0") }

    // 2. false should exit 1
    list.free(argv)
    argv = list.new()
    if os.run(bin("false"), argv, null) != 1 { fail("false should return 1") }

    // 3. echo with arguments, captured stdout
    list.free(argv)
    argv = list.new()
    _a1 = list.add(argv, "hello")
    _a2 = list.add(argv, "world")
    if capture(bin("echo"), argv, null) != "hello world\n" {
        fail("echo hello world produced unexpected output")
    }

    // 4. Special shell metacharacters in argv MUST NOT be interpreted.
    list.free(argv)
    argv = list.new()
    _a3 = list.add(argv, "$HOME")
    _a4 = list.add(argv, "|")
    _a5 = list.add(argv, "*")
    _a6 = list.add(argv, ";")
    _a7 = list.add(argv, "rm -rf /")
    if capture(bin("echo"), argv, null) != "$HOME | * ; rm -rf /\n" {
        fail("shell metachars were interpreted instead of passed verbatim")
    }

    // 5. Arguments containing spaces, no shell quoting needed.
    list.free(argv)
    argv = list.new()
    _a8 = list.add(argv, "two words")
    _a9 = list.add(argv, "and another two")
    if capture(bin("echo"), argv, null) != "two words and another two\n" {
        fail("spaces in argv items were not preserved")
    }

    // 6. Custom env with explicit KEY=VALUE entries.
    list.free(argv)
    argv = list.new()
    env = list.new()
    _e1 = list.add(env, "FOO=bar")
    _e2 = list.add(env, "BAZ=qux")
    out = capture(bin("env"), argv, env)
    if string.contains(out, "FOO=bar") == 0 { fail("FOO=bar not in env output") }
    if string.contains(out, "BAZ=qux") == 0 { fail("BAZ=qux not in env output") }
    list.free(env)

    // 7. A null env inherits the parent's environment.
    list.free(argv)
    argv = list.new()
    if string.contains(capture(bin("env"), argv, null), "PATH=") == 0 {
        fail("inherited env should include PATH")
    }

    // 8. PATH-resolved program name (no leading slash).
    list.free(argv)
    argv = list.new()
    if os.run("true", argv, null) != 0 { fail("PATH-resolved 'true' should return 0") }

    // 9. A program that cannot start is -1, never an exit status, and one
    // that ran and exited 127 is 127 (#3170). POSIX used to give 127 for
    // both.
    list.free(argv)
    argv = list.new()
    missing = os.run("/this/program/definitely/does/not/exist", argv, null)
    if missing != -1 { fail("missing program: os.run returned ${missing}, expected -1") }
    list.free(argv)
    argv = list.new()
    _b1 = list.add(argv, "-c")
    _b2 = list.add(argv, "exit 127")
    ran127 = os.run("/bin/sh", argv, null)
    if ran127 != 127 { fail("sh -c 'exit 127': os.run returned ${ran127}, expected 127") }

    // 10. Large captured output, which forces several reallocs.
    list.free(argv)
    argv = list.new()
    _a10 = list.add(argv, "1")
    _a11 = list.add(argv, "2000")
    out = capture(bin("seq"), argv, null)
    if string.length(out) < 5 { fail("seq output too short") }
    if string.index_of(out, "2000\n") < 0 {
        fail("seq output missing terminal '2000\\n'")
    }

    list.free(argv)
    println("PASS os_run")
}
