# std.yaml / libfyaml: indicators, document markers, directives, tags,
# anchors and the escapes of double-quoted scalars.
map=": "
seq="- "
key="? "
flow_map_open="{"
flow_map_close="}"
flow_seq_open="["
flow_seq_close="]"
comma=", "
doc_start="---"
doc_end="..."
directive_yaml="%YAML 1.2"
directive_tag="%TAG ! tag:x,2000:"
anchor="&a "
alias="*a"
merge="<<: "
tag_str="!!str "
tag_int="!!int "
tag_map="!!map "
tag_local="!x "
literal="|"
literal_keep="|+"
literal_strip="|-"
folded=">"
folded_indent=">2"
comment="# "
dquote="\""
squote="'"
esc_x="\\x41"
esc_u="\\u00e9"
esc_U="\\U0001F600"
esc_nul="\\0"
newline_indent="\x0a  "
null="~"
tab="\x09"
bom="\xef\xbb\xbf"
