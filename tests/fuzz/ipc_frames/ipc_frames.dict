# Frame headers: 4-byte big-endian lengths at the edges that matter.
hdr_0="\x00\x00\x00\x00"
hdr_1="\x00\x00\x00\x01"
hdr_4="\x00\x00\x00\x04"
hdr_16="\x00\x00\x00\x10"
hdr_255="\x00\x00\x00\xff"
hdr_256="\x00\x00\x01\x00"
hdr_4096="\x00\x00\x10\x00"
hdr_4097="\x00\x00\x10\x01"
hdr_64k="\x00\x01\x00\x00"
hdr_top="\x7f\xff\xff\xff"
hdr_max="\xff\xff\xff\xff"
# CBOR heads a payload is likely to start with.
cbor_u8="\x18"
cbor_arr_indef="\x9f"
cbor_map_indef="\xbf"
cbor_break="\xff"
cbor_text3="\x63abc"
cbor_bytes1="\x41\x00"
