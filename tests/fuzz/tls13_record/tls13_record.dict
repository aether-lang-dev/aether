# TLS 1.3 record headers (RFC 8446 5.1, 5.2) and the lengths at the limits.
appdata="\x17\x03\x03"
handshake="\x16\x03\x03"
alert="\x15\x03\x03"
ccs="\x14\x03\x03"
legacy_version="\x03\x01"
len_2_14="\x40\x00"
len_2_14_plus_1="\x40\x01"
len_2_14_plus_256="\x41\x00"
len_2_14_plus_257="\x41\x01"
len_zero="\x00\x00"
type_handshake="\x16"
type_appdata="\x17"
type_alert="\x15"
