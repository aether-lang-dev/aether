# tar (POSIX.1-1988 ustar, pax, GNU): magic, type flags, and the names that
# try to leave the destination.
ustar="ustar\x0000"
gnu_magic="ustar  \x00"
type_file="0"
type_hard="1"
type_symlink="2"
type_dir="5"
type_pax="x"
type_pax_global="g"
type_gnu_long="L"
type_gnu_long_link="K"
dotdot="../"
dotdot_win="..\\"
absolute="/etc/"
drive="C:/"
unc="//server/share/"
pax_path="path="
pax_linkpath="linkpath="
pax_size="size="
octal_size="00000000012\x00"
octal_max="77777777777\x00"
mode="0000644\x00"
