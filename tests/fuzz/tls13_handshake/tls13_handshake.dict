# TLS 1.3 handshake fields (RFC 8446 4): message types, the legacy version,
# suites, groups, and extension types with their lengths.
client_hello="\x01"
server_hello="\x02"
legacy_version="\x03\x03"
tls13="\x03\x04"
aes128="\x13\x01"
aes256="\x13\x02"
chacha="\x13\x03"
x25519="\x00\x1d"
secp256r1="\x00\x17"
hybrid="\x11\xec"
ext_server_name="\x00\x00"
ext_status_request="\x00\x05"
ext_supported_groups="\x00\x0a"
ext_sig_algs="\x00\x0d"
ext_alpn="\x00\x10"
ext_psk="\x00\x29"
ext_early_data="\x00\x2a"
ext_supported_versions="\x00\x2b"
ext_cookie="\x00\x2c"
ext_cert_authorities="\x00\x2f"
ext_key_share="\x00\x33"
ext_flags="\x00\x3e"
hrr_random="\xcf\x21\xad\x74\xe5\x9a\x61\x11\xbe\x1d\x8c\x02\x1e\x65\xb8\x91\xc2\xa2\x11\x16\x7a\xbb\x8c\x5e\x07\x9e\x09\xe2\xc8\xa8\x33\x9c"
len24_max="\xff\xff\xff"
len16_max="\xff\xff"
