# HTTP/2 (RFC 9113 4.1, 6): frame types with flags, and the bytes of a
# frame header. In script mode the op bytes 0 to 7 pick a frame.
op_headers="\x00"
op_data="\x01"
op_rst="\x02"
op_ping="\x03"
op_window="\x04"
op_raw="\x05"
type_data="\x00"
type_headers="\x01"
type_priority="\x02"
type_rst="\x03"
type_settings="\x04"
type_push="\x05"
type_ping="\x06"
type_goaway="\x07"
type_window="\x08"
type_continuation="\x09"
flag_end_stream="\x01"
flag_end_headers="\x04"
flag_padded="\x08"
flag_priority="\x20"
stream_1="\x00\x00\x00\x01"
len_max="\x00\x40\x00"
settings_header="\x00\x00\x00\x04\x00\x00\x00\x00\x00"
