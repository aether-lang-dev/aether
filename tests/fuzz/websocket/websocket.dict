# WebSocket frame heads (RFC 6455 5.2): FIN and each opcode, the mask bit
# with each length form, and close codes.
text_fin="\x81"
binary_fin="\x82"
text_frag="\x01"
cont="\x00"
cont_fin="\x80"
close="\x88"
ping="\x89"
pong="\x8a"
reserved="\x83"
reserved_ctl="\x8b"
masked_len5="\x85"
masked_len16="\xfe"
masked_len64="\xff"
len16="\x7e"
len64="\x7f"
len126="\x00\x7e"
len65536="\x00\x00\x00\x00\x00\x01\x00\x00"
mask_key="\x37\xfa\x12\x81"
close_1000="\x03\xe8"
close_1002="\x03\xea"
