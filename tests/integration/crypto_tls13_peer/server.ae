// The pure TLS server (tls13_server.accept) for test_tls13_peer.sh's server
// cases: it listens on 127.0.0.1, writes its port to PEER_PORT_OUT, serves one
// connection with peer.ae's certificate, and prints "ACCEPTED" or
// "REFUSED: <why>". With SERVER_READ=1 it then echoes what it reads, printing
// "RECV <n>" for each record, until "EOF" or "RECVERR: <why>". SERVER_CERT
// and SERVER_KEY name PEM files to serve instead of the built-in pair;
// SERVER_CORRUPT_KEY=1 flips a bit of the loaded key's shielded form.

import std.os
import std.fs
import std.tcp
import std.bytes
import std.cryptography
import std.cryptography.tls13_server
import std.cryptography.shield

extern exit(code: int)

main() {
    srv, lerr = tcp.listen_on("127.0.0.1", 0)
    if lerr != "" {
        println("FAIL: ${lerr}")
        exit(1)
    }
    _pw = fs.write(os.getenv("PEER_PORT_OUT"), "${tcp.server_port(srv)}")
    sock, aerr = tcp.accept(srv)
    if aerr != "" {
        println("FAIL: ${aerr}")
        tcp.server_close(srv)
        exit(1)
    }
    // SERVER_CERT and SERVER_KEY name PEM files to serve instead (#3357).
    cert_pem = peer_pem()
    key_pem = peer_key()
    if os.getenv("SERVER_CERT") != "" {
        cp, _ce = fs.read(os.getenv("SERVER_CERT"))
        kp, _ke = fs.read(os.getenv("SERVER_KEY"))
        cert_pem = cp
        key_pem = kp
    }
    chain, lens = tls13_server.parse_cert_chain_pem(cert_pem)
    key, _kerr = tls13_server.load_private_key(key_pem)
    // SERVER_CORRUPT_KEY=1 flips one bit of the shielded key, as a bit
    // flipped in memory would (#3376): the server must refuse to use it.
    if os.getenv("SERVER_CORRUPT_KEY") == "1" {
        sh = (key as *tls13_server.ServerKey).shielded as *shield.Shielded
        bytes.set(sh.sealed, 3, bytes.get(sh.sealed, 3) ^ 8)
    }
    xpriv, _rerr = cryptography.random_buffer(32)
    conn, err = tls13_server.accept(sock, chain, lens, key, xpriv)
    bytes.free(xpriv)
    tls13_server.free_private_key(key)
    if err != "" {
        println("REFUSED: ${err}")
        // Drained, as the library's own entry closes a failed handshake
        // (#3465): what the client sent after the record refused (a second
        // change_cipher_spec, say) is still unread, and a plain close ends
        // with a reset, which on Windows can take the alert from the client
        // before it reads it ("HRR CLOSED" for "HRR ALERT 10").
        tcp.close_drained(sock)
        tls13_server.free_cert_chain(chain, lens)
        tcp.server_close(srv)
        exit(0)
    }
    println("ACCEPTED")
    if os.getenv("SERVER_READ") == "1" {
        going = 1
        while going == 1 {
            buf, n, rerr = tls13_server.conn_recv(conn)
            if rerr != "" {
                println("RECVERR: ${rerr}")
                going = 0
            } else if buf == null {
                println("EOF")
                going = 0
            } else {
                println("RECV ${n}")
                serr = tls13_server.conn_send(conn, bytes.view(buf)[0..n])
                bytes.free(buf)
                if serr != "" {
                    println("SENDERR: ${serr}")
                    going = 0
                }
            }
        }
    }
    tls13_server.close_conn(conn)
    tls13_server.free_cert_chain(chain, lens)
    tcp.server_close(srv)
    exit(0)
}

fn peer_pem() -> string {
    return "-----BEGIN CERTIFICATE-----\nMIIBezCCASGgAwIBAgIFUEVFUgEwCgYIKoZIzj0EAwIwFzEVMBMGA1UEAwwMcGVl\nci5leGFtcGxlMCAXDTI2MDEwMTAwMDAwMFoYDzIxMjYwMTAxMDAwMDAwWjAXMRUw\nEwYDVQQDDAxwZWVyLmV4YW1wbGUwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAARv\n7S9eWT57ZTmAOztQD2+5EetBRQ+B+cOtLJCr7BVBQPQExOwo/jrT1ahb6i7ZxObZ\nFrq4KWW801ggO2EZ0SqXo1gwVjAMBgNVHRMBAf8EAjAAMA4GA1UdDwEB/wQEAwIH\ngDAXBgNVHREEEDAOggxwZWVyLmV4YW1wbGUwHQYDVR0OBBYEFH8HRengm5cRK0K4\na6DbxP8afdpfMAoGCCqGSM49BAMCA0gAMEUCIDCIjkFoXJK1RI1twupNRu+WcP5M\nrU1MCAQ84vwQWP4tAiEArDbfJRioR7QSSuE4iKxVCCFaHbJs/7eLq3CNJGUFXoM=\n-----END CERTIFICATE-----\n"
}

fn peer_key() -> string {
    return "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgJkV1/PXrot1pb8nd\ndzrI+0SX8Cx63OCppeTS/FARImOhRANCAARv7S9eWT57ZTmAOztQD2+5EetBRQ+B\n+cOtLJCr7BVBQPQExOwo/jrT1ahb6i7ZxObZFrq4KWW801ggO2EZ0SqX\n-----END PRIVATE KEY-----\n"
}
