// TLS-terminating std.http server for the OpenSSL backend policy tests
// (#3312): it reports why server_set_tls refuses a certificate.
//
//   CERT_PATH, KEY_PATH   the certificate and key
//   SRV_BACKEND           "aether", "openssl", "" (default) or anything else
//
// Prints "READY <port>", or "FAIL: server_set_tls: <why>" when the
// certificate is refused, or "BACKEND-ERR: <error>" and exits 2.

import std.http
import std.os
import std.cryptography.tls13_server

extern exit(code: int)

handle_root(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "policy-ok")
}

message StartSrv { raw: ptr }

actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; _ = http.server_start(raw) } }
}

// A refusal the driver asks for (a certificate the policy refuses, a
// backend this build lacks) ends the program: the server is freed before
// the exit.
refuse(raw: @frees ptr, text: string, code: int) {
    println(text)
    http.server_free(raw)
    exit(code)
}

main() {
    raw = http.server_create(0)
    if raw == 0 {
        println("FAIL: server_create returned null")
        exit(1)
    }
    http.server_set_host(raw, "127.0.0.1")
    tls_err = http.server_set_tls(raw, os.getenv("CERT_PATH"), os.getenv("KEY_PATH"))
    if tls_err != "" {
        refuse(raw, "FAIL: server_set_tls: ${tls_err}", 1)
    }
    berr = http.server_set_tls_backend(raw, os.getenv("SRV_BACKEND"))
    if berr != "" {
        refuse(raw, "BACKEND-ERR: ${berr}", 2)
    }
    if http.server_bind(raw, "127.0.0.1", 0) != "" {
        refuse(raw, "FAIL: bind", 1)
    }
    println("READY ${http.server_port(raw)}")
    http.server_get(raw, "/", handle_root, 0)
    a = spawn(SrvActor())
    a ! StartSrv { raw: raw }
    sleep(60000)
    exit(0)
}
