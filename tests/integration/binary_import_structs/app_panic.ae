// A panic inside a binary-imported library reaches the host's catch
// (#2297). Holds where the host and the library share one runtime: a
// library built with --shared-runtime, which is how the test script runs
// it. A library with a runtime of its own keeps it on every platform
// (#3481), so its panic stays in it.

import engine

extern exit(code: int)

main() {
    caught = ""
    try {
        engine.boom(7)
    } catch e {
        caught = e
    }
    if caught != "engine boom 7" {
        println("FAIL: a library panic is caught by the host: '${caught}'")
        exit(1)
    }
    println("OK")
}
