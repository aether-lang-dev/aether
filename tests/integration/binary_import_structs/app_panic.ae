// A panic inside a binary-imported library reaches the host's catch
// (#2297) as itself where the host and the library share one runtime: a
// library built with --shared-runtime, which is how the test script runs
// it. A library with a runtime of its own (on every platform since #3481)
// ends the call in its own frame, and the import stub raises the failure
// again in the program with the same reason (#2956).

import engine

extern exit(code: int)

main() {
    caught = ""
    try {
        engine.boom(7)
    } catch e {
        caught = e
    }
    if caught != "engine boom 7" {
        println("FAIL: a library panic is caught by the host: '${caught}'")
        exit(1)
    }
    println("OK")
}
