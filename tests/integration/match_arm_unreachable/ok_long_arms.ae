// Two string arms that share their first 160 characters are distinct arms
// (#2521): the key used to be cut at 160 bytes, which made them duplicates.
import std.io

main() {
    x = "b"
    match x {
        "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789-first" -> { println("first") }
        "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789-second" -> { println("second") }
        _ -> { println("other") }
    }
}
