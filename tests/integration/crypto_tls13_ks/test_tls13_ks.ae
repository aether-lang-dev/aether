// Validate std.cryptography.tls13_ks — the TLS 1.3 key-schedule driver
// (RFC 8446 §7.1) — against the canonical RFC 8448 §3 "Simple 1-RTT
// Handshake" trace (TLS_AES_128_GCM_SHA256, X25519).
//
// Published RFC 8448 §3 inputs:
//   ECDHE shared secret = 8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d
//   Transcript-Hash(ClientHello..ServerHello)
//                       = 860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8
// Published RFC 8448 §3 intermediate secrets (what we reproduce):
//   Early Secret      33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a
//   Handshake Secret  1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac
//   s hs traffic      b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38
//   c hs traffic      b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21
//   server write_key  3fce516009c21727d0f2e4e86ee403bc   (AES-128-GCM, 16)
//   server write_iv   5d313eb2671276ee13000b30

import std.cryptography.tls13_ks
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(s, slen, i * 2))
        lo = hexval(string_char_at_n(s, slen, i * 2 + 1))
        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

fn to_hex(b: ptr, n: int) -> string {
    hx = bytes.new(n * 2)
    i = 0
    while i < n {
        v = bytes.get(b, i)
        hi = (v >> 4) & 15
        lo = v & 15
        chi = 48 + hi
        if hi >= 10 { chi = 87 + hi }
        clo = 48 + lo
        if lo >= 10 { clo = 87 + lo }
        bytes.set(hx, i * 2, chi)
        bytes.set(hx, i * 2 + 1, clo)
        i = i + 1
    }
    return bytes.finish(hx, n * 2)
}

fn check(label: string, got: string, want: string) -> int {
    if got == want {
        println("ok   ${label}")
        return 1
    }
    println("FAIL ${label}")
    println("  got:  ${got}")
    println("  want: ${want}")
    return 0
}

main() {
    total_ok = 1

    // Early Secret
    early = tls13_ks.early_secret("sha256")
    if check("early_secret", to_hex(early, 32),
        "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a") == 0 { total_ok = 0 }

    // Handshake Secret (ECDHE from RFC 8448)
    ecdhe = from_hex("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")
    hs = tls13_ks.handshake_secret("sha256", early, ecdhe, 32)
    if check("handshake_secret", to_hex(hs, 32),
        "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac") == 0 { total_ok = 0 }

    // Traffic secrets over Transcript-Hash(CH..SH)
    th = from_hex("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
    s_hs = tls13_ks.traffic_secret("sha256", hs, "s hs traffic", th, 32)
    if check("s hs traffic", to_hex(s_hs, 32),
        "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38") == 0 { total_ok = 0 }
    c_hs = tls13_ks.traffic_secret("sha256", hs, "c hs traffic", th, 32)
    if check("c hs traffic", to_hex(c_hs, 32),
        "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21") == 0 { total_ok = 0 }

    // Record protection key + iv from the server handshake traffic secret
    // (RFC 8448 §3 uses AES-128-GCM: key = 16 bytes, iv = 12).
    sk = tls13_ks.write_key("sha256", s_hs, 16)
    if check("server write_key", to_hex(sk, 16),
        "3fce516009c21727d0f2e4e86ee403bc") == 0 { total_ok = 0 }
    siv = tls13_ks.write_iv("sha256", s_hs)
    if check("server write_iv", to_hex(siv, 12),
        "5d313eb2671276ee13000b30") == 0 { total_ok = 0 }

    bytes.free(early)
    bytes.free(ecdhe)
    bytes.free(hs)
    bytes.free(th)
    bytes.free(s_hs)
    bytes.free(c_hs)
    bytes.free(sk)
    bytes.free(siv)

    if total_ok == 0 {
        println("tls13_ks: FAILURES")
        exit(1)
    }
    println("tls13_ks: all RFC 8448 §3 vectors pass")
}
