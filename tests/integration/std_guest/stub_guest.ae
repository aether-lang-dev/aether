// A worker for std.guest's tests, on std.guest.child: its "engine" runs a
// script of one command a line, so each case can say exactly what the
// guest does.
//
//   say TEXT          a SAY
//   call NAME JSON    a call to a mounted function; SAYs "value JSON",
//                     "fail MESSAGE", or stops on a cancel
//   call! NAME JSON   the same, but a FAIL stops: the script ends with
//                     ERROR, an export RAISEs "NAME: MESSAGE"
//   log LEVEL TEXT    a log message at LEVEL (0..5), with a tag
//   big N             a SAY of N bytes (in an export: a RETURN of a string
//                     of N, written straight down the socket, as a worker
//                     that ignores the frame limit would)
//   spin              loops until the host cancels, polling for it
//   deaf              stops answering: reads every frame, CANCEL
//                     included, and replies to none
//   args              a SAY of its own arguments (after the program)
//   exit N            DONE with exit code N
//
// Exports, for the host to call once the script has ended:
//
//   def NAME          the lines up to `end` are the export NAME's body;
//   end               a script with a def ends with READY and its names
//                     (in order) instead of DONE, and serves
//   return JSON       in an export: RETURN JSON (falling off the end
//                     returns null); one too large for the host's frame
//                     limit RAISEs why instead, as child.returned says
//   return-big N      in an export: return a string of N bytes, so
//   raise TEXT        in an export: RAISE TEXT
//   keep JSON         remembers JSON, across invocations
//   require-kept      in an export: RAISE "unknown txn ARGS" unless its
//                     arguments are [K] for a K kept earlier
//   ready RAW         end the script with READY RAW, whatever the defs
//   flood N           end the script with READY of N names f0 .. fN-1
//   frame RAW         sends RAW as a frame, as it stands
//
// In every line, $args is the current invocation's arguments (a JSON
// array, "[]" in the script), $last the value of the last call ("null"
// before one) and $kept what keep remembered, as a JSON array.
//
// Between lines it polls for a CANCEL. A mounted name with a '!' in it is
// one this engine cannot mount: the engine's own check, after read_script.

import std.guest.child
import std.ipc
import std.list
import std.os
import std.string

// What the engine keeps between lines and between invocations.
struct Stub {
    // The export names and their bodies, in order.
    names: ptr
    bodies: ptr
    // Values `keep` remembered, as JSON text.
    kept: ptr
    // The last call's value, and the current invocation's arguments.
    last: string
    args: string
    // `ready` or `flood`: the READY to send instead of the defs' names.
    ready_raw: string
}

// How a run of lines ended.
const FELL_OFF = 0
const ANSWERED = 1
const FINISHED = 2

main() {
    h, err = child.open("stub-guest")
    if err != "" {
        println(err)
        exit(2)
    }
    if child.read_script(h) != "" { exit(1) }
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, _lo, _hi = child.mount_at(h, i)
        if string.index_of(name, "!") >= 0 {
            child.error(h, "cannot mount '${name}': not a name this engine takes")
            exit(1)
        }
        i = i + 1
    }
    child.run(h) callback {
        run_script(h)
    }
    child.free(h)
    exit(0)
}

run_script(h: *child.Host) {
    st = Stub {
        names: list.new(), bodies: list.new(), kept: list.new(),
        last: "null", args: "[]", ready_raw: ""
    }
    top = split_defs(h.source, &st)
    status = run_lines(h, &st, top, false)
    if status == FELL_OFF {
        if st.ready_raw != "" {
            child.ready(h, st.ready_raw)
            serve_exports(h, &st)
        } else if list.size(st.names) > 0 {
            child.ready(h, names_json(&st))
            serve_exports(h, &st)
        } else {
            child.done(h, 0)
        }
    }
    list.free(st.names)
    list.free(st.bodies)
    list.free(st.kept)
}

// The script's own lines, with each def ... end moved into st.
fn split_defs(source: string, st: *Stub) -> string {
    lines = string.split(source, "\n")
    defer string.array_free(lines)
    count = string.array_size(lines)
    top = ""
    body = ""
    name = ""
    in_def = 0
    i = 0
    while i < count {
        line = string.copy(string.array_get(lines, i))
        cmd, rest = child.split_verb(line)
        if in_def == 1 {
            if cmd == "end" {
                list.add(st.names, name)
                list.add(st.bodies, body)
                in_def = 0
            } else {
                body = if body == "" { line } else { "${body}\n${line}" }
            }
        } else if cmd == "def" {
            name = rest
            body = ""
            in_def = 1
        } else {
            top = if top == "" { line } else { "${top}\n${line}" }
        }
        i = i + 1
    }
    return top
}

fn names_json(st: *Stub) -> string {
    out = "["
    n = list.size(st.names)
    i = 0
    while i < n {
        name, _ = list.get_string(st.names, i)
        out = if i == 0 { "${out}${child.json_string(name)}" } else { "${out},${child.json_string(name)}" }
        i = i + 1
    }
    return "${out}]"
}

fn kept_json(st: *Stub) -> string {
    out = "["
    n = list.size(st.kept)
    i = 0
    while i < n {
        v, _ = list.get_string(st.kept, i)
        out = if i == 0 { "${out}${v}" } else { "${out},${v}" }
        i = i + 1
    }
    return "${out}]"
}

// Serves the exports until the host ends or cancels.
fn serve_exports(h: *child.Host, st: *Stub) {
    while true {
        inv = child.serve(h)
        if inv.kind == "END" {
            child.done(h, 0)
            return
        }
        if inv.kind == "CANCEL" {
            child.error(h, "cancelled by host: ${inv.args}")
            return
        }
        body = ""
        n = list.size(st.names)
        i = 0
        while i < n {
            name, _ = list.get_string(st.names, i)
            if name == inv.name {
                b, _ = list.get_string(st.bodies, i)
                body = b
            }
            i = i + 1
        }
        st.args = inv.args
        status = run_lines(h, st, body, true)
        st.args = "[]"
        if status == FINISHED { return }
        if status == FELL_OFF { child.returned(h, "null") }
    }
}

fn expand(text: string, st: *Stub) -> string {
    out = string.replace(text, "$args", st.args)
    out = string.replace(out, "$last", st.last)
    return string.replace(out, "$kept", kept_json(st))
}

// Runs `source`, the script's lines or an export's body.
fn run_lines(h: *child.Host, st: *Stub, source: string, in_export: bool) -> int {
    lines = string.split(source, "\n")
    defer string.array_free(lines)
    count = string.array_size(lines)
    i = 0
    while i < count {
        if child.poll(h) != "" {
            child.error(h, "cancelled by host: ${h.cancel}")
            return FINISHED
        }
        line = expand(string.copy(string.array_get(lines, i)), st)
        cmd, rest = child.split_verb(line)
        if cmd == "say" {
            child.say(h, rest)
        } else if cmd == "call" || cmd == "call!" {
            name, args = child.split_verb(rest)
            if !child.is_mounted(h, name) {
                child.error(h, "${name} is not mounted")
                return FINISHED
            }
            r = child.call_host(h, name, args)
            if r.kind == "CANCEL" {
                child.error(h, "cancelled by host: ${r.text}")
                return FINISHED
            }
            if r.kind == "FAIL" {
                if cmd == "call!" {
                    if in_export {
                        child.raised(h, "${name}: ${r.text}")
                        return ANSWERED
                    }
                    child.error(h, "${name}: ${r.text}")
                    return FINISHED
                }
                st.last = "null"
                child.say(h, "fail ${r.text}")
            } else {
                st.last = r.text
                if cmd == "call" { child.say(h, "value ${r.text}") }
            }
        } else if cmd == "log" {
            level_text, text = child.split_verb(rest)
            level, _ = string.to_int(level_text)
            child.log(h, level, "{\"line\":${i + 1}}", text)
        } else if cmd == "big" {
            size, _ = string.to_int(rest)
            out = ""
            while string.length(out) < size { out = "${out}xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }
            if in_export {
                if ipc.write_frame(h.ch, "RETURN \"${out}\"") != "" { exit(1) }
                return ANSWERED
            }
            child.say(h, out)
        } else if cmd == "spin" {
            while child.poll(h) == "" {}
            child.error(h, "cancelled by host: ${h.cancel}")
            return FINISHED
        } else if cmd == "deaf" {
            while true {
                _, rerr = ipc.read_frame(h.ch, child.MAX_FRAME)
                if rerr != "" { exit(0) }
            }
        } else if cmd == "args" {
            out = ""
            k = 1
            while k < os.args_count() {
                out = "${out}[${os.args_get(k)}]"
                k = k + 1
            }
            child.say(h, out)
        } else if cmd == "exit" {
            code, _ = string.to_int(rest)
            child.done(h, code)
            return FINISHED
        } else if (cmd == "return" || cmd == "return-big") && in_export {
            value = rest
            if cmd == "return-big" {
                size, _ = string.to_int(rest)
                value = ""
                while string.length(value) < size { value = "${value}yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy" }
                value = "\"${string.substring(value, 0, size)}\""
            }
            rerr = child.returned(h, value)
            if rerr != "" { child.raised(h, rerr) }
            return ANSWERED
        } else if cmd == "raise" && in_export {
            child.raised(h, rest)
            return ANSWERED
        } else if cmd == "keep" {
            list.add(st.kept, rest)
        } else if cmd == "require-kept" && in_export {
            found = false
            n = list.size(st.kept)
            k = 0
            while k < n {
                v, _ = list.get_string(st.kept, k)
                if st.args == "[${v}]" { found = true }
                k = k + 1
            }
            if !found {
                child.raised(h, "unknown txn ${st.args}")
                return ANSWERED
            }
        } else if cmd == "ready" {
            st.ready_raw = rest
        } else if cmd == "flood" {
            n, _ = string.to_int(rest)
            out = "["
            k = 0
            while k < n {
                out = if k == 0 { "${out}\"f${k}\"" } else { "${out},\"f${k}\"" }
                k = k + 1
            }
            st.ready_raw = "${out}]"
        } else if cmd == "frame" {
            if ipc.write_frame(h.ch, rest) != "" { exit(1) }
        } else if cmd != "" {
            child.error(h, "stub: unknown command '${cmd}'")
            return FINISHED
        }
        i = i + 1
    }
    return FELL_OFF
}
