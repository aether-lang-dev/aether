// A bare call in a builder's block is a name the program binds itself, a
// function of the program or a local, before it is the receiver's function
// of the same name (#333), and every pass resolves it so: inference, the
// settle of which functions return a value, the module prune and codegen,
// as the checker does. The receiver was asked first, so `return note(n)`
// was blk.note (returns nothing) here although the program defines `note`.
// When the passes disagreed, `noting` was declared of the wrong type around
// the return the checker made of it (gcc "'return' with no value, in
// function returning non-void").

import blk

note(n: int) -> int {
    return n + 1000
}

size() -> string {
    return "top"
}

// The program's note returns an int: so does this.
noting(n: int) -> int {
    blk.run("noting") {
        return note(n)
    }
    return 0
}

// The program's size returns a string: so does this.
sized() -> string {
    blk.run("sized") {
        return size()
    }
    return ""
}

// A local of the function comes before the block's receiver too.
noting_local(n: int) -> int {
    note = | x: int | {
        return x * 3
    }
    println("local ${note(1)}")
    blk.run("local") {
        return note(n)
    }
    return 0
}

main() {
    a = noting(4)
    s = sized()
    b = noting_local(5)
    println("clash ${a} ${s} ${b} ${note(1)} ${size()}")
}
