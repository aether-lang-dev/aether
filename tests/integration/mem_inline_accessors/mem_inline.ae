// Differential test for the std.mem accessor lowering (#1733).
//
// The lowering emits each accessor's body inline instead of calling into
// libaether.a. That is only safe if the inline form is INDISTINGUISHABLE
// from the extern, so this compares them directly: every assertion calls
// the std.mem wrapper (now lowered) and the raw extern (unchanged), and
// requires identical results.
//
// The null returns are the part most likely to be got wrong, because they
// are ASYMMETRIC: byte reads return -1, every other getter returns 0, and
// every setter returns 0. A lowering that "helpfully" normalised those to
// 0 would pass a naive round-trip test and break real callers.

import std.mem
import std.arena

extern aether_mem_get_byte(p: ptr, i: int) -> int
extern aether_mem_set_byte(p: ptr, i: int, value: int) -> int
extern aether_mem_get_int(p: ptr, offset: int) -> int
extern aether_mem_set_int(p: ptr, offset: int, value: int) -> int
extern aether_mem_get_long(p: ptr, offset: int) -> long
extern aether_mem_set_long(p: ptr, offset: int, value: long) -> int
extern aether_mem_get_float64(p: ptr, offset: int) -> float
extern aether_mem_set_float64(p: ptr, offset: int, value: float) -> int
extern aether_mem_get_float32(p: ptr, offset: int) -> float
extern aether_mem_set_float32(p: ptr, offset: int, value: float) -> int
extern aether_mem_get_ptr(p: ptr, offset: int) -> ptr
extern aether_mem_set_ptr(p: ptr, offset: int, value: ptr) -> int
extern aether_mem_get_int8(p: ptr, offset: int) -> int
extern aether_mem_set_int8(p: ptr, offset: int, value: int) -> int
extern aether_mem_get_uint8(p: ptr, offset: int) -> int
extern aether_mem_set_uint8(p: ptr, offset: int, value: int) -> int
extern aether_mem_get_int16(p: ptr, offset: int) -> int
extern aether_mem_set_int16(p: ptr, offset: int, value: int) -> int
extern aether_mem_get_uint16(p: ptr, offset: int) -> int
extern aether_mem_set_uint16(p: ptr, offset: int, value: int) -> int
extern aether_mem_get_uint32(p: ptr, offset: int) -> long
extern aether_mem_set_uint32(p: ptr, offset: int, value: long) -> int
extern aether_mem_ptr_to_long(p: ptr) -> long
extern aether_mem_long_to_ptr(addr: long) -> ptr
extern exit(code: int)

ck(cond: int, label: string) -> int {
    if cond == 0 {
        println("  FAIL: ${label}")
        return 1
    }
    return 0
}

main() {
    f = 0
    ar = arena.create(4096)
    buf = arena.alloc_aligned(ar, 256, 8)

    // ---- byte: lowered vs extern, across the value range ----------------
    i = 0
    while i < 256 {
        _ = mem.set_byte(buf, 0, i)
        lowered = mem.get_byte(buf, 0)
        _ = aether_mem_set_byte(buf, 1, i)
        extern_v = aether_mem_get_byte(buf, 1)
        f = f + ck(lowered == extern_v, "byte ${i}: lowered ${lowered} != extern ${extern_v}")
        i = i + 1
    }

    // ---- int / long: including negatives and the boundaries -------------
    _ = mem.set_int(buf, 8, 0 - 2147483648)
    _ = aether_mem_set_int(buf, 16, 0 - 2147483648)
    f = f + ck(mem.get_int(buf, 8) == aether_mem_get_int(buf, 16), "int INT_MIN")

    _ = mem.set_int(buf, 8, 2147483647)
    _ = aether_mem_set_int(buf, 16, 2147483647)
    f = f + ck(mem.get_int(buf, 8) == aether_mem_get_int(buf, 16), "int INT_MAX")

    _ = mem.set_long(buf, 24, 1234567890123)
    _ = aether_mem_set_long(buf, 32, 1234567890123)
    f = f + ck(mem.get_long(buf, 24) == aether_mem_get_long(buf, 32), "long")

    _ = mem.set_long(buf, 24, 0 - 1234567890123)
    _ = aether_mem_set_long(buf, 32, 0 - 1234567890123)
    f = f + ck(mem.get_long(buf, 24) == aether_mem_get_long(buf, 32), "long negative")

    // ---- float32 / float64 ----------------------------------------------
    _ = mem.set_float64(buf, 40, 3.141592653589793)
    _ = aether_mem_set_float64(buf, 48, 3.141592653589793)
    f = f + ck(mem.get_float64(buf, 40) == aether_mem_get_float64(buf, 48), "float64")

    _ = mem.set_float32(buf, 56, 2.5)
    _ = aether_mem_set_float32(buf, 60, 2.5)
    f = f + ck(mem.get_float32(buf, 56) == aether_mem_get_float32(buf, 60), "float32")

    // ---- the null contract, which is ASYMMETRIC --------------------------
    // Byte reads are the odd one out: -1, not 0.
    f = f + ck(mem.get_byte(null, 0) == aether_mem_get_byte(null, 0), "null get_byte agrees")
    f = f + ck(mem.get_byte(null, 0) == 0 - 1, "null get_byte is -1, not 0")

    f = f + ck(mem.set_byte(null, 0, 1) == aether_mem_set_byte(null, 0, 1), "null set_byte agrees")
    f = f + ck(mem.set_byte(null, 0, 1) == 0, "null set_byte is 0")

    f = f + ck(mem.get_int(null, 0) == aether_mem_get_int(null, 0), "null get_int agrees")
    f = f + ck(mem.get_int(null, 0) == 0, "null get_int is 0")

    f = f + ck(mem.get_long(null, 0) == aether_mem_get_long(null, 0), "null get_long agrees")
    f = f + ck(mem.set_long(null, 0, 1) == aether_mem_set_long(null, 0, 1), "null set_long agrees")
    f = f + ck(mem.get_float64(null, 0) == aether_mem_get_float64(null, 0), "null get_float64 agrees")
    f = f + ck(mem.set_float64(null, 0, 1.0) == aether_mem_set_float64(null, 0, 1.0), "null set_float64 agrees")

    // ---- unaligned float access must stay defined (memcpy, not deref) ---
    _ = mem.set_float64(buf, 65, 1.5)
    _ = aether_mem_set_float64(buf, 73, 1.5)
    f = f + ck(mem.get_float64(buf, 65) == aether_mem_get_float64(buf, 73), "unaligned float64")

    // ---- narrow widths: sign/zero extension and masking ----------------
    _ = mem.set_int8(buf, 80, 200)
    _ = aether_mem_set_int8(buf, 81, 200)
    f = f + ck(mem.get_int8(buf, 80) == aether_mem_get_int8(buf, 81), "int8 sign-extends")
    f = f + ck(mem.get_uint8(buf, 80) == aether_mem_get_uint8(buf, 81), "uint8")
    _ = mem.set_uint8(buf, 82, 511)
    _ = aether_mem_set_uint8(buf, 83, 511)
    f = f + ck(mem.get_uint8(buf, 82) == aether_mem_get_uint8(buf, 83), "uint8 masks")
    _ = mem.set_int16(buf, 85, 0 - 2)
    _ = aether_mem_set_int16(buf, 87, 0 - 2)
    f = f + ck(mem.get_int16(buf, 85) == aether_mem_get_int16(buf, 87), "int16, unaligned")
    f = f + ck(mem.get_uint16(buf, 85) == aether_mem_get_uint16(buf, 87), "uint16, unaligned")
    _ = mem.set_uint16(buf, 90, 70000)
    _ = aether_mem_set_uint16(buf, 92, 70000)
    f = f + ck(mem.get_uint16(buf, 90) == aether_mem_get_uint16(buf, 92), "uint16 masks")
    _ = mem.set_uint32(buf, 96, 4294967295)
    _ = aether_mem_set_uint32(buf, 100, 4294967295)
    f = f + ck(mem.get_uint32(buf, 96) == aether_mem_get_uint32(buf, 100), "uint32 zero-extends")

    // ---- pointers and the ptr <-> long casts ----------------------------
    _ = mem.set_ptr(buf, 104, buf)
    _ = aether_mem_set_ptr(buf, 112, buf)
    f = f + ck(mem.ptr_to_long(mem.get_ptr(buf, 104)) == aether_mem_ptr_to_long(aether_mem_get_ptr(buf, 112)), "get_ptr / set_ptr")
    long a = mem.ptr_to_long(buf)
    f = f + ck(a == aether_mem_ptr_to_long(buf), "ptr_to_long")
    f = f + ck(mem.ptr_to_long(mem.long_to_ptr(a + 8)) == aether_mem_ptr_to_long(aether_mem_long_to_ptr(a + 8)), "long_to_ptr")
    // a slot written as a long and read back as a pointer (what a tagged
    // JS heap does), then the other way round
    _ = mem.set_long(buf, 120, a)
    f = f + ck(mem.ptr_to_long(mem.get_ptr(buf, 120)) == a, "long slot read as ptr")
    _ = mem.set_ptr(buf, 120, mem.long_to_ptr(a + 16))
    f = f + ck(mem.get_long(buf, 120) == a + 16, "ptr slot read as long")

    // ---- null paths of the new entries ----------------------------------
    f = f + ck(mem.ptr_to_long(mem.get_ptr(null, 0)) == aether_mem_ptr_to_long(aether_mem_get_ptr(null, 0)), "null get_ptr agrees")
    f = f + ck(mem.set_ptr(null, 0, buf) == aether_mem_set_ptr(null, 0, buf), "null set_ptr agrees")
    f = f + ck(mem.get_int8(null, 0) == aether_mem_get_int8(null, 0), "null get_int8 agrees")
    f = f + ck(mem.get_uint16(null, 0) == aether_mem_get_uint16(null, 0), "null get_uint16 agrees")
    f = f + ck(mem.get_uint32(null, 0) == aether_mem_get_uint32(null, 0), "null get_uint32 agrees")
    f = f + ck(mem.set_uint32(null, 0, 1) == aether_mem_set_uint32(null, 0, 1), "null set_uint32 agrees")

    // Bit reinterpretation preserves signed zero, infinities and NaN payloads.
    long[8] patterns = [0, 0x8000000000000000, 0x3ff8000000000000,
        0x7ff0000000000000, 0xfff0000000000000,
        0x7ff8000000001234, 0xfff8000000004321, 1]
    i = 0
    while i < 8 {
        long bits = patterns[i]
        f = f + ck(mem.bits_of_float(mem.float_from_bits(bits)) == bits, "bit round-trip ${i}")
        f = f + ck(mem.bits_of_float(mem.float_from_bits(bits)) == mem.aether_mem_bits_of_float(mem.aether_mem_float_from_bits(bits)), "bit extern ${i}")
        f = f + ck(mem.bits_of_float(mem.aether_mem_float_from_bits(bits)) == bits, "bits_of_float ${i}")
        f = f + ck(mem.aether_mem_bits_of_float(mem.float_from_bits(bits)) == bits, "float_from_bits ${i}")
        i = i + 1
    }
    // Every one-bit position, including the signed high bit; zero is UB.
    i = 0
    while i < 64 {
        uint64 word = 1
        word = word << i
        f = f + ck(mem.clz64(word as long) == 63 - i, "clz64 ${i}")
        f = f + ck(mem.clz64(word as long) == mem.aether_mem_clz64(word as long), "clz64 extern ${i}")
        if i < 32 {
            f = f + ck(mem.clz32(word as int) == 31 - i, "clz32 ${i}")
            f = f + ck(mem.clz32(word as int) == mem.aether_mem_clz32(word as int), "clz32 extern ${i}")
        }
        i = i + 1
    }

    // Unchecked stores must touch exactly the same bytes as checked externs.
    other = arena.alloc_aligned(ar, 256, 8)
    size_t wide_offset = 3
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_byte_unchecked(buf, 3, 0) == 1, "unchecked set_byte")
    _ = mem.aether_mem_set_byte(other, 3, 0)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked byte write width")
    f = f + ck(mem.get_byte_unchecked(buf, 3) == mem.aether_mem_get_byte(other, 3), "unchecked get_byte")
    f = f + ck(mem.aether_mem_get_byte_unchecked(buf, 3) == mem.aether_mem_get_byte(other, 3), "unchecked extern get_byte")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_byte_unchecked(other, 3, 0) == 1, "unchecked extern set_byte")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern byte write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_byte_unchecked(buf, 3, 255) == 1, "unchecked set_byte")
    _ = mem.aether_mem_set_byte(other, 3, 255)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked byte write width")
    f = f + ck(mem.get_byte_unchecked(buf, 3) == mem.aether_mem_get_byte(other, 3), "unchecked get_byte")
    f = f + ck(mem.aether_mem_get_byte_unchecked(buf, 3) == mem.aether_mem_get_byte(other, 3), "unchecked extern get_byte")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_byte_unchecked(other, 3, 255) == 1, "unchecked extern set_byte")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern byte write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_byte_unchecked(buf, 3, 511) == 1, "unchecked set_byte")
    _ = mem.aether_mem_set_byte(other, 3, 511)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked byte write width")
    f = f + ck(mem.get_byte_unchecked(buf, 3) == mem.aether_mem_get_byte(other, 3), "unchecked get_byte")
    f = f + ck(mem.aether_mem_get_byte_unchecked(buf, 3) == mem.aether_mem_get_byte(other, 3), "unchecked extern get_byte")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_byte_unchecked(other, 3, 511) == 1, "unchecked extern set_byte")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern byte write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_byte_sz_unchecked(buf, wide_offset, 0) == 1, "unchecked set_byte_sz")
    _ = mem.aether_mem_set_byte_sz(other, wide_offset, 0)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked byte_sz write width")
    f = f + ck(mem.get_byte_sz_unchecked(buf, wide_offset) == mem.aether_mem_get_byte_sz(other, wide_offset), "unchecked get_byte_sz")
    f = f + ck(mem.aether_mem_get_byte_sz_unchecked(buf, wide_offset) == mem.aether_mem_get_byte_sz(other, wide_offset), "unchecked extern get_byte_sz")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_byte_sz_unchecked(other, wide_offset, 0) == 1, "unchecked extern set_byte_sz")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern byte_sz write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_byte_sz_unchecked(buf, wide_offset, 255) == 1, "unchecked set_byte_sz")
    _ = mem.aether_mem_set_byte_sz(other, wide_offset, 255)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked byte_sz write width")
    f = f + ck(mem.get_byte_sz_unchecked(buf, wide_offset) == mem.aether_mem_get_byte_sz(other, wide_offset), "unchecked get_byte_sz")
    f = f + ck(mem.aether_mem_get_byte_sz_unchecked(buf, wide_offset) == mem.aether_mem_get_byte_sz(other, wide_offset), "unchecked extern get_byte_sz")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_byte_sz_unchecked(other, wide_offset, 255) == 1, "unchecked extern set_byte_sz")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern byte_sz write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_byte_sz_unchecked(buf, wide_offset, 511) == 1, "unchecked set_byte_sz")
    _ = mem.aether_mem_set_byte_sz(other, wide_offset, 511)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked byte_sz write width")
    f = f + ck(mem.get_byte_sz_unchecked(buf, wide_offset) == mem.aether_mem_get_byte_sz(other, wide_offset), "unchecked get_byte_sz")
    f = f + ck(mem.aether_mem_get_byte_sz_unchecked(buf, wide_offset) == mem.aether_mem_get_byte_sz(other, wide_offset), "unchecked extern get_byte_sz")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_byte_sz_unchecked(other, wide_offset, 511) == 1, "unchecked extern set_byte_sz")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern byte_sz write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_ptr_unchecked(buf, 8, buf) == 1, "unchecked set_ptr")
    _ = mem.aether_mem_set_ptr(other, 8, buf)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked ptr write width")
    f = f + ck(mem.get_ptr_unchecked(buf, 8) == mem.aether_mem_get_ptr(other, 8), "unchecked get_ptr")
    f = f + ck(mem.aether_mem_get_ptr_unchecked(buf, 8) == mem.aether_mem_get_ptr(other, 8), "unchecked extern get_ptr")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_ptr_unchecked(other, 8, buf) == 1, "unchecked extern set_ptr")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern ptr write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_ptr_unchecked(buf, 8, null) == 1, "unchecked set_ptr")
    _ = mem.aether_mem_set_ptr(other, 8, null)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked ptr write width")
    f = f + ck(mem.get_ptr_unchecked(buf, 8) == mem.aether_mem_get_ptr(other, 8), "unchecked get_ptr")
    f = f + ck(mem.aether_mem_get_ptr_unchecked(buf, 8) == mem.aether_mem_get_ptr(other, 8), "unchecked extern get_ptr")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_ptr_unchecked(other, 8, null) == 1, "unchecked extern set_ptr")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern ptr write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_int_unchecked(buf, 8, 0 - 2147483648) == 1, "unchecked set_int")
    _ = mem.aether_mem_set_int(other, 8, 0 - 2147483648)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked int write width")
    f = f + ck(mem.get_int_unchecked(buf, 8) == mem.aether_mem_get_int(other, 8), "unchecked get_int")
    f = f + ck(mem.aether_mem_get_int_unchecked(buf, 8) == mem.aether_mem_get_int(other, 8), "unchecked extern get_int")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_int_unchecked(other, 8, 0 - 2147483648) == 1, "unchecked extern set_int")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern int write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_int_unchecked(buf, 8, 2147483647) == 1, "unchecked set_int")
    _ = mem.aether_mem_set_int(other, 8, 2147483647)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked int write width")
    f = f + ck(mem.get_int_unchecked(buf, 8) == mem.aether_mem_get_int(other, 8), "unchecked get_int")
    f = f + ck(mem.aether_mem_get_int_unchecked(buf, 8) == mem.aether_mem_get_int(other, 8), "unchecked extern get_int")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_int_unchecked(other, 8, 2147483647) == 1, "unchecked extern set_int")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern int write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_long_unchecked(buf, 8, 0 - 1234567890123) == 1, "unchecked set_long")
    _ = mem.aether_mem_set_long(other, 8, 0 - 1234567890123)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked long write width")
    f = f + ck(mem.get_long_unchecked(buf, 8) == mem.aether_mem_get_long(other, 8), "unchecked get_long")
    f = f + ck(mem.aether_mem_get_long_unchecked(buf, 8) == mem.aether_mem_get_long(other, 8), "unchecked extern get_long")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_long_unchecked(other, 8, 0 - 1234567890123) == 1, "unchecked extern set_long")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern long write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_long_unchecked(buf, 8, 0x8000000000000000) == 1, "unchecked set_long")
    _ = mem.aether_mem_set_long(other, 8, 0x8000000000000000)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked long write width")
    f = f + ck(mem.get_long_unchecked(buf, 8) == mem.aether_mem_get_long(other, 8), "unchecked get_long")
    f = f + ck(mem.aether_mem_get_long_unchecked(buf, 8) == mem.aether_mem_get_long(other, 8), "unchecked extern get_long")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_long_unchecked(other, 8, 0x8000000000000000) == 1, "unchecked extern set_long")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern long write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_int8_unchecked(buf, 3, 200) == 1, "unchecked set_int8")
    _ = mem.aether_mem_set_int8(other, 3, 200)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked int8 write width")
    f = f + ck(mem.get_int8_unchecked(buf, 3) == mem.aether_mem_get_int8(other, 3), "unchecked get_int8")
    f = f + ck(mem.aether_mem_get_int8_unchecked(buf, 3) == mem.aether_mem_get_int8(other, 3), "unchecked extern get_int8")
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.aether_mem_set_int8_unchecked(other, 3, 200) == 1, "unchecked extern set_int8")
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked extern int8 write width")
    _ = mem.set(buf, 90, 256)
    _ = mem.set(other, 90, 256)
    f = f + ck(mem.set_int8_unchecked(buf, 3, 0 - 2) == 1, "unchecked set_int8")
    _ = mem.aether_mem_set_int8(other, 3, 0 - 2)
    f = f + ck(mem.compare(buf, other, 256) == 0, "unchecked int8 write width")
