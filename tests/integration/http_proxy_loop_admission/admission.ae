// A request the proxy event loop cannot take as it is gets the worker path's
// answer (#3233).
//
// On Linux and macOS a server whose first middleware is a std.http.proxy
// mount reads its plain-HTTP requests on the proxy event loop. Whatever the
// worker path refuses, or frames some other way, has to come out the same
// on the loop, and the loop leaves such a request to the worker path rather
// than keep a second copy of its rules. Here each request shape goes, in a
// write of its own on a connection of its own, to a bare proxy (the event
// loop on Linux and macOS) and to the same proxy behind a program's
// middleware (the worker path everywhere), and both answers must be the
// one expected: the status, the body, and whether the server then closed.
// Every server listens on 127.0.0.1 and a port the kernel picks.

import std.bytes
import std.http
import std.http.proxy
import std.string
import std.tcp

extern exit(code: int)

// What reached the upstream: the method, the path, the body's length and
// its last bytes.
handle_echo(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    n = string.length(body)
    tail = body
    if n > 8 {
        tail = string.substring(body, n - 8, n)
    }
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "up ${http.request_method(req)} body=${n} tail=${tail}")
}

@c_callback mw_pass(req: ptr, res: ptr, ud: ptr) -> int {
    return 1
}

start(server: ptr) -> int {
    if http.server_bind(server, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    err = http.server_start_background(server)
    if err != "" {
        println("FAIL: ${err}")
        exit(1)
    }
    return http.server_port(server)
}

need(label: string, err: string) {
    if err != "" {
        println("FAIL: ${label}: ${err}")
        exit(1)
    }
}

// A gateway's server and the pool and options its mount uses, which stay
// the program's: it frees them after the server (proxy.mount).
struct Gateway {
    server: ptr
    pool: ptr
    opts: ptr
}

// A proxy of "/" to `up_url` with a 64 KB body cap; `worker` 1 puts a
// program's middleware ahead of it.
gateway(up_url: string, worker: int) -> Gateway {
    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    if worker == 1 {
        http.server_use_middleware(s, mw_pass, 0)
    }
    pool = proxy.upstream_pool_new("round_robin", 5, 0, 0)
    if pool == 0 {
        println("FAIL: upstream_pool_new")
        exit(1)
    }
    need("upstream_add", proxy.upstream_add(pool, up_url, 1))
    opts = proxy.opts_new()
    need("opts_set_body_cap", proxy.opts_set_body_cap(opts, 65536))
    need("mount", proxy.mount(s, "/", pool, opts))
    return Gateway { server: s, pool: pool, opts: opts }
}

gateway_free(g: Gateway) {
    http.server_free(g.server)
    proxy.opts_free(g.opts)
    proxy.upstream_pool_free(g.pool)
}

// The value of `name` in a response head, "" when it has none.
head_value(head: string, name: string) -> string {
    at = string.index_of(head, "\r\n${name}: ")
    if at < 0 {
        return ""
    }
    from = at + string.length(name) + 4
    end = string.index_of_from(head, "\r\n", from)
    if end < 0 {
        return ""
    }
    return string.substring(head, from, end)
}

// `raw`, written on a connection of its own; the first response as
// "<status> <body>" ("(no answer)" when none came in five seconds), then
// "closed" when the server closed the connection after it, "open" when it
// had not a second later.
probe(port: int, raw: string) -> string {
    return probe_nul(port, raw, -1)
}

// `probe` with the byte at `nul_at` made NUL, which a string cannot carry;
// -1 for none.
probe_nul(port: int, raw: string, nul_at: int) -> string {
    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        return "connect failed"
    }
    data = bytes.new(string.length(raw))
    bytes.copy_from_string(data, 0, raw, string.length(raw))
    if nul_at >= 0 {
        bytes.set(data, nul_at, 0)
    }
    tcp.write_all(sock, bytes.view(data))
    bytes.free(data)
    wire = ""
    state = "open"
    answer = "(no answer)"
    idle = 0
    waited = 0
    while state == "open" && waited < 50 && (answer == "(no answer)" || idle < 10) {
        ready, _perr = tcp.poll(sock, 100)
        if ready {
            chunk, rerr = tcp.read(sock, 65536)
            if rerr != "" || string.length(chunk) == 0 {
                state = "closed"
            } else {
                wire = string.concat(wire, chunk)
                idle = 0
            }
        } else {
            idle = idle + 1
        }
        waited = waited + 1
        hdr_end = string.index_of(wire, "\r\n\r\n")
        if answer == "(no answer)" && hdr_end >= 0 {
            head = string.substring(wire, 0, hdr_end + 2)
            n = string.get_int(head_value(head, "Content-Length"))
            if string.length(wire) >= hdr_end + 4 + n {
                status = string.substring(head, 9, 12)
                answer = "${status} ${string.substring(wire, hdr_end + 4, hdr_end + 4 + n)}"
            }
        }
    }
    tcp.close(sock)
    return "${answer} ${state}"
}

// `raw`, written on a connection of its own and read until the server closes
// it or sends nothing for a second: the status of each response that came
// back, in order, then "closed" or "open".
answers(port: int, raw: string) -> string {
    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        return "connect failed"
    }
    tcp.write(sock, raw)
    wire = ""
    state = "open"
    idle = 0
    waited = 0
    while state == "open" && waited < 80 && idle < 10 {
        ready, _perr = tcp.poll(sock, 100)
        if ready {
            chunk, rerr = tcp.read(sock, 65536)
            if rerr != "" || string.length(chunk) == 0 {
                state = "closed"
            } else {
                wire = string.concat(wire, chunk)
                idle = 0
            }
        } else {
            idle = idle + 1
        }
        waited = waited + 1
    }
    tcp.close(sock)
    statuses = ""
    at = string.index_of(wire, "HTTP/1.1 ")
    while at >= 0 {
        statuses = string.concat(statuses, "${string.substring(wire, at + 9, at + 12)} ")
        at = string.index_of_from(wire, "HTTP/1.1 ", at + 9)
    }
    return "${statuses}${state}"
}

// The same request to both gateways, and the answer expected of both.
both(label: string, ports: int[], raw: string, want: string) -> int {
    return both_nul(label, ports, raw, -1, want)
}

// `both` with the byte at `nul_at` made NUL (`probe_nul`).
both_nul(label: string, ports: int[], raw: string, nul_at: int, want: string) -> int {
    bad = 0
    names = ["event loop", "worker path"]
    g = 0
    while g < 2 {
        got = probe_nul(ports[g], raw, nul_at)
        if got != want {
            println("  FAIL ${label} (${names[g]}): got '${got}', expected '${want}'")
            bad = bad + 1
        } else {
            println("  PASS ${label} (${names[g]})")
        }
        g = g + 1
    }
    return bad
}

// `both` for several requests on one connection (`answers`).
both_all(label: string, ports: int[], raw: string, want: string) -> int {
    bad = 0
    names = ["event loop", "worker path"]
    g = 0
    while g < 2 {
        got = answers(ports[g], raw)
        if got != want {
            println("  FAIL ${label} (${names[g]}): got '${got}', expected '${want}'")
            bad = bad + 1
        } else {
            println("  PASS ${label} (${names[g]})")
        }
        g = g + 1
    }
    return bad
}

main() {
    println("=== the event loop answers what it cannot take as the worker path does ===")
    upstream = http.server_create(0)
    http.server_set_host(upstream, "127.0.0.1")
    http.server_get(upstream, "/p", handle_echo, 0)
    http.server_post(upstream, "/p", handle_echo, 0)
    up_url = "http://127.0.0.1:${start(upstream)}"
    loop_gw = gateway(up_url, 0)
    worker_gw = gateway(up_url, 1)
    ports = [start(loop_gw.server), start(worker_gw.server)]
    sleep(200)

    bad = 0
    bad = bad + both("a plain request", ports, "GET /p HTTP/1.1\r\nHost: x\r\n\r\n",
        "200 up GET body=0 tail= open")

    // #3233: a request that does not parse, or whose length cannot be read.
    malformed = "400 malformed HTTP request closed"
    framing = "400 request framing is ambiguous or unsupported\r\n closed"
    bad = bad + both("a request line that is not one", ports, "GARBAGE\r\nHost: x\r\n\r\n", malformed)
    bad = bad + both("an HTTP version that is not 1.x", ports, "GET /p HTTP/2.0\r\nHost: x\r\n\r\n", malformed)
    bad = bad + both("two Content-Length headers that disagree", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nab", framing)
    bad = bad + both("a Content-Length that is not a number", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 12abc\r\n\r\nab", framing)

    // #3228: Transfer-Encoding frames the body, and with Content-Length too
    // the request is refused.
    bad = bad + both("a chunked body", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n",
        "200 up POST body=5 tail=hello open")
    bad = bad + both("a chunked body in three chunks", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n4\r\ndefg\r\n2\r\nhi\r\n0\r\n\r\n",
        "200 up POST body=9 tail=bcdefghi open")
    bad = bad + both("Content-Length with Transfer-Encoding", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n",
        framing)
    bad = bad + both("a coding other than chunked", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\n\r\nxyz", framing)

    // #3236: the head's shape, before its framing is trusted.
    bad = bad + both("whitespace between a header's name and its colon", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length : 2\r\n\r\nab", framing)
    bad = bad + both("an obs-fold continuation line", ports,
        "GET /p HTTP/1.1\r\nHost: x\r\nX-A: a\r\n b\r\n\r\n", framing)
    bad = bad + both("a Content-Length with a sign", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: +2\r\n\r\nab", framing)
    many = "GET /p HTTP/1.1\r\nHost: x\r\n"
    i = 0
    while i < 50 {
        many = string.concat(many, "X-H${i}: v\r\n")
        i = i + 1
    }
    too_large = "431 header line is too long\n closed"
    bad = bad + both("51 headers", ports, string.concat(many, "\r\n"), too_large)
    long_value = string.pad_end("", 1100, 118)
    bad = bad + both("a header line over 1 KiB", ports,
        "GET /p HTTP/1.1\r\nHost: x\r\nX-Long: ${long_value}\r\n\r\n", too_large)
    long_path = string.pad_end("/", 2100, 112)
    bad = bad + both("a request line over 2 KiB", ports,
        "GET ${long_path} HTTP/1.1\r\nHost: x\r\n\r\n", "414 request line is too long\r\n closed")

    // #3254: a NUL byte in a head is refused on both paths. The worker path
    // searched for the head's end with strstr, which stops at the NUL, and
    // waited for an end that had already arrived; the loop's length-bounded
    // search found it and forwarded the head.
    malformed_nul = "400 malformed HTTP request closed"
    with_nul = "GET /p HTTP/1.1\r\nHost: x\r\nX-A: a~b\r\n\r\n"
    bad = bad + both_nul("a NUL byte in a header value", ports, with_nul,
        string.index_of(with_nul, "~"), malformed_nul)
    nul_path = "GET /p~q HTTP/1.1\r\nHost: x\r\n\r\n"
    bad = bad + both_nul("a NUL byte in the request line", ports, nul_path,
        string.index_of(nul_path, "~"), malformed_nul)

    // #3237: what a request may make the server hold. A head that has not
    // ended in 16 KiB is refused, 431 (#3252); a body declared larger than
    // the proxy forwards is refused before it is read, so this one is never
    // sent.
    endless = string.pad_end("GET /p HTTP/1.1\r\nHost: x\r\nX-Big: ", 40000, 98)
    head_too_large = "431 request head is too large\n closed"
    bad = bad + both("a head that does not end in 16 KiB", ports, endless, head_too_large)
    // The refusal leaves the body unread, so the connection closes: kept,
    // the body was read as the next request, and one carrying a request of
    // its own had it proxied (#3255).
    bad = bad + both("a body declared over the proxy's cap", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 1000000\r\n\r\nabc",
        "502 request body exceeds proxy cap\n closed")
    bad = bad + both_all("a request inside a body over the proxy's cap", ports,
        "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 100000\r\n\r\nGET /p HTTP/1.1\r\nHost: x\r\n\r\n",
        "502 closed")
    // #3252: the refusal closes in stages, so the response to the request
    // before it, already sent, is not destroyed by a reset.
    bad = bad + both_all("a request, then a head that does not end in 16 KiB", ports,
        string.concat("GET /p HTTP/1.1\r\nHost: x\r\n\r\n", endless), "200 431 closed")

    // #3253: the bound holds wherever the head is read. One that ended past
    // 16 KiB within a single read was taken by the loop, and by the worker
    // path on a connection whose buffer a body of 16 KiB had grown.
    lines = ""
    i = 0
    while i < 22 {
        lines = string.concat(lines, "X-F${i}: ${string.pad_end("", 990, 102)}\r\n")
        i = i + 1
    }
    long_head = "GET /p HTTP/1.1\r\nHost: x\r\n${lines}\r\n"
    bad = bad + both("a head that ends past 16 KiB", ports, long_head, head_too_large)
    grow = "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 16384\r\n\r\n${string.pad_end("", 16384, 98)}"
    bad = bad + both_all("a head past 16 KiB after a body that grew the buffer", ports,
        string.concat(grow, long_head), "200 431 closed")

    http.server_stop(worker_gw.server)
    http.server_stop(loop_gw.server)
    http.server_stop(upstream)
    gateway_free(worker_gw)
    gateway_free(loop_gw)
    http.server_free(upstream)
    if bad > 0 {
        println("FAIL: ${bad} case(s)")
        exit(1)
    }
    println("All PASS")
}
