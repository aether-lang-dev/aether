// A request that names no owner for its connection must never be sent on a
// connection someone else authenticated.
//
// The upstream (conn_auth_upstream.c) authenticates the connection, as NTLM
// and Negotiate do: after a login on a connection, every request on it is
// that user's. One caller logs in; a second, independent caller then asks
// who it is with no credential. Through 0.938.0 std.http.client kept one idle
// pool for the whole process, keyed by origin alone, so the second request
// went out on the first caller's authenticated connection and was answered
// 200 as that user (servirtium-vcr's NTLM harness found it, recording
// through a proxy). A request with no owner now has a connection of its own,
// closed after its response, so the answer is 401.

import std.http.client
import std.io
import std.string

extern exit(code: int)

fail(msg: string) {
    println("FAIL: ${msg}")
    exit(1)
}

get(url: string, login: string) -> {
    req = client.request("GET", url)
    if req == null { fail("request() refused ${url}") }
    defer client.request_free(req)
    client.set_timeout(req, 10s)
    if string.length(login) > 0 { client.set_header(req, "X-Login", login) }
    resp, err = client.send_request(req)
    if err != "" { fail("${url}: ${err}") }
    status = client.response_status(resp)
    body = string.copy(client.response_body(resp))
    client.response_free(resp)
    return status, body
}

main() {
    port = io.getenv("UPSTREAM_PORT")
    if string.length(port) == 0 { fail("UPSTREAM_PORT not set") }
    base = "http://127.0.0.1:${port}"

    s1, b1 = get("${base}/login", "alice")
    if s1 != 200 { fail("login: ${s1} ${b1}") }

    s2, b2 = get("${base}/whoami", "")
    if s2 != 401 {
        fail("an anonymous request with no owner was answered ${s2} '${b2}': it went out on the connection alice authenticated (${b1})")
    }
    if string.contains(b2, "anonymous") == 0 { fail("whoami said '${b2}'") }

    println("PASS: an anonymous request did not inherit alice's connection (${b1}; then ${b2})")
}
