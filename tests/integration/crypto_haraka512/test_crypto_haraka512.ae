// Test std.cryptography.haraka512 against Bouncy Castle test vectors.
import std.cryptography.haraka512
import std.bytes
import std.string
import std.io

extern string_char_at_n(str: string, known_length: int, index: int) -> int

hex_to_bytes(hex: string) -> ptr {
    len = string.length(hex)
    n = len / 2
    b = bytes.new(n)
    i = 0
    while i < n {
        c_hi = string_char_at_n(hex, len, i * 2)
        c_lo = string_char_at_n(hex, len, i * 2 + 1)

        hi = 0
        if (c_hi >= 48) && (c_hi <= 57) { hi = c_hi - 48 }
        else if (c_hi >= 97) && (c_hi <= 102) { hi = c_hi - 97 + 10 }
        else if (c_hi >= 65) && (c_hi <= 70) { hi = c_hi - 65 + 10 }

        lo = 0
        if (c_lo >= 48) && (c_lo <= 57) { lo = c_lo - 48 }
        else if (c_lo >= 97) && (c_lo <= 102) { lo = c_lo - 97 + 10 }
        else if (c_lo >= 65) && (c_lo <= 70) { lo = c_lo - 65 + 10 }

        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

check_bytes(label: string, got: ptr, want_hex: string) -> int {
    want = hex_to_bytes(want_hex)
    i = 0
    while i < 32 {
        g = bytes.get(got, i)
        w = bytes.get(want, i)
        if g != w {
            println("FAIL ${label} at byte ${i}")
            bytes.free(want)
            return 1
        }
        i = i + 1
    }
    println("ok   ${label}")
    bytes.free(want)
    return 0
}

main() {
    fails = 0

    // ---- Known Vector Test ----
    // From Appendix B, Haraka-512 v2
    input1 = bytes.new(64)
    t = 0
    while t < 64 {
        bytes.set(input1, t, t)
        t = t + 1
    }

    ctx1, _ = haraka512.new()
    haraka512.update_bytes(ctx1, input1, 64)
    res1 = haraka512.final_bytes(ctx1)
    fails = fails + check_bytes("Haraka-512 known vector", res1, "be7f723b4e80a99813b292287f306f625a6d57331cae5f34dd9277b0945be2aa")
    bytes.free(input1)
    bytes.free(res1)


    // ---- Monty Test ----
    // Vector 1 (000102...)
    input_m1 = hex_to_bytes("000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F")
    t = 0
    while t < 1000 {
        ctx, _ = haraka512.new()
        haraka512.update_bytes(ctx, input_m1, 64)
        res = haraka512.final_bytes(ctx)

        if (t & 1) == 1 {
            bytes.copy_from_bytes(input_m1, 0, res, 0, 32)
        } else {
            bytes.copy_from_bytes(input_m1, 32, res, 0, 32)
        }

        // Wait, if t == 999, the final result is in res. Let us keep it if we are at final iteration!
        if t == 999 {
            fails = fails + check_bytes("Haraka-512 Monty 1", res, "ABE210FE673F3B28E70E5100C476D82F61A7E2BDB3D8423FB0A15E5DE3D3A4DE")
        }

        bytes.free(res)
        t = t + 1
    }
    bytes.free(input_m1)


    // Vector 2 (FF...)
    input_m2 = hex_to_bytes("FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF")
    t = 0
    while t < 1000 {
        ctx, _ = haraka512.new()
        haraka512.update_bytes(ctx, input_m2, 64)
        res = haraka512.final_bytes(ctx)

        if (t & 1) == 1 {
            bytes.copy_from_bytes(input_m2, 0, res, 0, 32)
        } else {
            bytes.copy_from_bytes(input_m2, 32, res, 0, 32)
        }

        if t == 999 {
            fails = fails + check_bytes("Haraka-512 Monty 2", res, "5F5ECB52C61F5036C96BE555D2E18C520AB3ED093954700C283A322D14DBFE02")
        }

        bytes.free(res)
        t = t + 1
    }
    bytes.free(input_m2)


    if fails == 0 {
        println("ALL PASS")
        return
    }
    println("FAILURES: ${fails}")
    exit(1)
}