// std.ipc round-trip integration test.
//
// Compiles tests/integration/std_ipc_roundtrip/child.ae to a binary,
// then exercises the three parent-side spawn variants:
//
//   1. os.run_pipe_drain_and_wait — convenience: spawn + drain +
//      wait + reap in one call. Asserts the payload arrives intact
//      and the child exits 0.
//
//   2. os.run_pipe + manual read + os.wait_pid — low-level path
//      that streaming consumers will use. Asserts the same payload
//      and exit code via the explicit read/wait shape.
//
//   3. os.run_capture (the existing surface) on the same binary —
//      proves that without the run_pipe spawn, the child sees
//      ipc.parent_channel() == -1 and exits 1 with an error
//      message. Pins the contract that AETHER_IPC_FD only appears
//      when the parent uses run_pipe.
//
//   4-6. A program that cannot start is an err with no child, through
//      run_pipe and run_pipe_drain_and_wait, and one that ran and
//      exited 127 is exit 127 with no err (#3170). Both used to read
//      as exit 127.
//
//   7. An explicit env is the child's, with AETHER_IPC_FD=3 in place of
//      the one it gives. It used to make the child exit 127 without
//      running the program, and then was refused.
//
//   8. With an AETHER_IPC_FD of this process's own, the child's is still
//      3: the parent builds the child's env, environ without its own entry
//      plus AETHER_IPC_FD=3, where the child used to setenv it between
//      fork and exec (#3200).

import std.os
import std.fs
import std.string
import std.list
import std.net

extern exit(code: int)

const CHILD_SRC = "tests/integration/std_ipc_roundtrip/child.ae"
const EXPECTED_PAYLOAD = "passed=44\nfailed=3\nname=demo\n"

// Compile the child to disk via `ae build`. Returns "" on success,
// error string on failure.
build_child(bin: string) -> string {
    argv = list.new()
    list.add(argv, "build")
    list.add(argv, CHILD_SRC)
    list.add(argv, "-o")
    list.add(argv, bin)
    out, exit_code, err = os.run_capture("build/ae", argv, null)
    list.free(argv)
    if err != "" { return "spawn error: ${err}" }
    if exit_code != 0 {
        return "ae build exit ${exit_code}: ${out}"
    }
    return ""
}

main() {
    println("std.ipc round-trip test")
    println("")

    // A name of this process's own: two sweeps at once shared one fixed
    // /tmp name, and one run's delete landed under the other (#2771).
    child_bin = "${os.temp_dir()}/std_ipc_roundtrip_child_${os.getpid()}"
    berr = build_child(child_bin)
    if berr != "" {
        println("FAIL: cannot build child: ${berr}")
        exit(1)
    }
    println("  ✓ child compiled to ${child_bin}")

    passed = 0
    failed = 0

    // Case 1 — convenience function (drain-and-wait).
    {
        argv = list.new()
        payload, exit_code, err = os.run_pipe_drain_and_wait(child_bin, argv, null)
        list.free(argv)
        if err != "" {
            println("  [1] FAIL run_pipe_drain_and_wait: err=${err}")
            failed = failed + 1
        } else {
            if exit_code != 0 {
                println("  [1] FAIL run_pipe_drain_and_wait: exit=${exit_code}, payload=${payload}")
                failed = failed + 1
            } else {
                if string_equals(payload, EXPECTED_PAYLOAD) == 0 {
                    println("  [1] FAIL run_pipe_drain_and_wait: payload mismatch")
                    println("    expected: ${EXPECTED_PAYLOAD}")
                    println("    actual:   ${payload}")
                    failed = failed + 1
                } else {
                    println("  [1] PASS run_pipe_drain_and_wait (payload byte-equal, exit 0)")
                    passed = passed + 1
                }
            }
        }
    }

    // Case 2 — low-level run_pipe + wait_pid, payload-fits-in-buffer.
    //
    // We don't have std.net.fd_read_all yet (flagged in the design
    // brief as a v1 companion), so this case can't fully drain the
    // pipe. Instead it exercises that:
    //   - run_pipe returns sensible (read_fd, child_pid, "")
    //   - the child runs to completion (writes payload < pipe
    //     buffer, closes fd, exits 0) without parent reading
    //   - wait_pid reaps cleanly and reports exit 0
    // Because our payload is ~30 bytes (well under any OS pipe
    // buffer), the child's write succeeds, the child exits, and
    // the parent's wait_pid finds it ready. Then we close the
    // unread read_fd. This is the correct usage pattern when the
    // parent only cares about the exit code and not the data —
    // a real consumer would read first, but that requires
    // std.net.fd_read_all.
    {
        argv2 = list.new()
        read_fd, child_pid, err2 = os.run_pipe(child_bin, argv2, null)
        list.free(argv2)
        if err2 != "" {
            println("  [2] FAIL run_pipe: err=${err2}")
            failed = failed + 1
        } else {
            if read_fd < 0 {
                println("  [2] FAIL run_pipe: read_fd=${read_fd}")
                failed = failed + 1
            } else {
                if child_pid <= 0 {
                    println("  [2] FAIL run_pipe: child_pid=${child_pid}")
                    failed = failed + 1
                } else {
                    // Wait for child first (small payload fits in
                    // pipe buffer; child writes + closes + exits
                    // without parent needing to read).
                    exit_code, werr = os.wait_pid(child_pid)
                    net.fd_close(read_fd)
                    if werr != "" {
                        println("  [2] FAIL wait_pid: err=${werr}")
                        failed = failed + 1
                    } else {
                        if exit_code != 0 {
                            println("  [2] FAIL wait_pid: exit_code=${exit_code}")
                            failed = failed + 1
                        } else {
                            println("  [2] PASS run_pipe + wait_pid (read_fd=${read_fd}, child_pid=${child_pid}, exit 0)")
                            passed = passed + 1
                        }
                    }
                }
            }
        }
    }

    // Case 3 — old run_capture: child sees no parent channel,
    // returns 1 with diagnostic.
    {
        argv3 = list.new()
        out3, exit3, err3 = os.run_capture(child_bin, argv3, null)
        list.free(argv3)
        if err3 != "" {
            println("  [3] FAIL run_capture (no-channel): err=${err3}")
            failed = failed + 1
        } else {
            if exit3 != 1 {
                println("  [3] FAIL run_capture: expected exit=1 (no AETHER_IPC_FD), got ${exit3}")
                println("    stdout: ${out3}")
                failed = failed + 1
            } else {
                if string_contains(out3, "no parent channel") == 0 {
                    println("  [3] FAIL run_capture: stdout doesn't contain expected error: ${out3}")
                    failed = failed + 1
                } else {
                    println("  [3] PASS run_capture (no-channel correctly detected, exit 1)")
                    passed = passed + 1
                }
            }
        }
    }

    // Case 4 — run_pipe on a program that cannot start (#3170).
    {
        argv4 = list.new()
        fd4, pid4, err4 = os.run_pipe("/no/such/program_3170", argv4, null)
        list.free(argv4)
        if fd4 != -1 || pid4 != -1 || err4 != "program not found" {
            println("  [4] FAIL run_pipe missing program: (${fd4}, ${pid4}, '${err4}'), expected (-1, -1, 'program not found')")
            failed = failed + 1
        } else {
            println("  [4] PASS run_pipe missing program → (-1, -1, program not found)")
            passed = passed + 1
        }
    }

    // Case 5 — run_pipe_drain_and_wait on a program that cannot start.
    {
        argv5 = list.new()
        _p5, code5, err5 = os.run_pipe_drain_and_wait("/no/such/program_3170", argv5, null)
        list.free(argv5)
        if code5 != -1 || err5 != "program not found" {
            println("  [5] FAIL run_pipe_drain_and_wait missing program: exit=${code5} err='${err5}', expected -1 'program not found'")
            failed = failed + 1
        } else {
            println("  [5] PASS run_pipe_drain_and_wait missing program → (-1, program not found)")
            passed = passed + 1
        }
    }

    // Case 6 — a program that ran and exited 127 is just that.
    {
        argv6 = list.new()
        list.add(argv6, "-c")
        list.add(argv6, "exit 127")
        _p6, code6, err6 = os.run_pipe_drain_and_wait("/bin/sh", argv6, null)
        list.free(argv6)
        if code6 != 127 || err6 != "" {
            println("  [6] FAIL run_pipe_drain_and_wait sh 'exit 127': exit=${code6} err='${err6}', expected 127 and no err")
            failed = failed + 1
        } else {
            println("  [6] PASS run_pipe_drain_and_wait sh 'exit 127' → 127, no err")
            passed = passed + 1
        }
    }

    // Case 7: an explicit env is the child's, with AETHER_IPC_FD=3 in place
    // of one the env gives. It was refused ("explicit env unsupported").
    {
        argv7 = list.new()
        list.add(argv7, "-c")
        list.add(argv7, "printf '%s %s' \"$A\" \"$AETHER_IPC_FD\" >&3")
        env7 = list.new()
        list.add(env7, "A=1")
        list.add(env7, "AETHER_IPC_FD=9")
        p7, code7, err7 = os.run_pipe_drain_and_wait("/bin/sh", argv7, env7)
        list.free(argv7)
        list.free(env7)
        if err7 != "" || code7 != 0 || p7 != "1 3" {
            println("  [7] FAIL run_pipe with env: payload='${p7}' exit=${code7} err='${err7}', expected '1 3', 0 and no err")
            failed = failed + 1
        } else {
            println("  [7] PASS run_pipe with an explicit env → the child has it, AETHER_IPC_FD=3")
            passed = passed + 1
        }
    }

    // Case 8 — this process's own AETHER_IPC_FD does not reach the child.
    {
        os.setenv("AETHER_IPC_FD", "9")
        argv8 = list.new()
        payload8, code8, err8 = os.run_pipe_drain_and_wait(child_bin, argv8, null)
        list.free(argv8)
        os.unsetenv("AETHER_IPC_FD")
        if err8 != "" || code8 != 0 || string_equals(payload8, EXPECTED_PAYLOAD) == 0 {
            println("  [8] FAIL with AETHER_IPC_FD=9 here: exit=${code8} err='${err8}' payload=${payload8}")
            failed = failed + 1
        } else {
            println("  [8] PASS with AETHER_IPC_FD=9 here, the child's is 3 (payload byte-equal, exit 0)")
            passed = passed + 1
        }
    }

    fs.delete(child_bin)

    println("")
    println("std_ipc_roundtrip: ${passed} passing, ${failed} failing (of 8)")
    if failed > 0 {
        exit(1)
    }
    exit(0)
}
