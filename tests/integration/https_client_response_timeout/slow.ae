// An https request whose server completes the handshake, reads the request
// and answers nothing for 4 s: with a 500 ms set_timeout the request must
// fail within a few times that, through each client TLS backend the build
// has (#3703). The pure-Aether client read a timed-out response 50 times
// over (RECIO_MAX_TIMEOUT_RETRIES), so it waited 50 x 500 ms = 25 s, or
// until the reply, where the OpenSSL client fails at the first timeout.
//
//   CERT_PATH, KEY_PATH   the server's certificate and key
//
// Prints "ROUND <backend> ELAPSED <ms> ERR <error>" per backend, or
// "ROUND <backend> SKIPPED <why>", then "DONE".

import std.http
import std.http.client
import std.cryptography.tls13_client
import std.os

extern sleep(ms: int)
extern exit(code: int)

handle_slow(req: ptr, res: ptr, ud: ptr) {
    sleep(4000)
    http.response_set_status(res, 200)
    http.response_set_body(res, "late")
}

round(port: int, backend: string) {
    req = client.request("GET", "https://127.0.0.1:${port}/slow")
    client.set_timeout(req, 500ms)
    client.set_insecure(req, 1)
    berr = client.set_tls_backend(req, backend)
    if berr != "" {
        println("ROUND ${backend} SKIPPED ${berr}")
        client.request_free(req)
        return
    }
    t0 = os.now_monotonic_ms()
    resp, err = client.send_request(req)
    elapsed = os.now_monotonic_ms() - t0
    client.request_free(req)
    if err == "" {
        status = client.response_status(resp)
        client.response_free(resp)
        println("ROUND ${backend} ELAPSED ${elapsed} ERR none: status ${status} after the timeout")
        return
    }
    println("ROUND ${backend} ELAPSED ${elapsed} ERR ${err}")
}

main() {
    s = http.server_create(0)
    if s == 0 {
        println("FAIL: server_create")
        exit(1)
    }
    http.server_set_host(s, "127.0.0.1")
    terr = http.server_set_tls(s, os.getenv("CERT_PATH"), os.getenv("KEY_PATH"))
    if terr != "" {
        println("FAIL: server_set_tls: ${terr}")
        exit(1)
    }
    http.server_get(s, "/slow", handle_slow, 0)
    serr = http.server_start_background(s)
    if serr != "" {
        println("FAIL: start_background: ${serr}")
        exit(1)
    }
    sleep(200)
    port = http.server_port(s)
    round(port, "aether")
    round(port, "openssl")
    http.server_stop(s)
    println("DONE")
    exit(0)
}
