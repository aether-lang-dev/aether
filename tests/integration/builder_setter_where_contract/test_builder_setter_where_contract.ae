// Regression (#2706): a builder setter whose parameter carries a `where`
// contract, called bare in a trailing block, gets the block's implicit
// `_ctx`. The contract is kept among the function's children as a requires
// clause, and the count that decides the injection took it for a parameter,
// so `set_n(3)` went out without `_ctx` and gcc reported too few arguments.
// The fix counts a definition's parameter nodes; an extern's children are
// all parameters, so an extern setter declared here keeps its `_ctx` too
// (counted as none, it got no `_ctx` and gcc reported too few arguments).

import bld

extern exit(code: int)
extern list_remove(_ctx: ptr, index: int)
extern list_free(list: @frees ptr)

main() {
    b = bld.new() {
        set_n(3)
        set_n(4)
    }
    if bld.count(b) != 2 {
        println("FAIL: the builder has ${bld.count(b)} entries, want 2")
        exit(1)
    }
    c = bld.new() {
        set_n(1)
        set_n(2)
        set_n(3)
        list_remove(0)
    }
    if bld.count(c) != 2 {
        println("FAIL: after the extern setter the builder has ${bld.count(c)} entries, want 2")
        exit(1)
    }
    // bld.new makes each builder a list, the program's to free.
    list_free(b)
    list_free(c)
    println("PASS: a where-contracted setter and an extern setter got the block's _ctx")
}
