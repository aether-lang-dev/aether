// Echoes what the server decided the request body was, so the test asserts on
// what a handler actually receives.

import std.http
import std.string

handle(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "bytes=${http.request_body_length(req)} len=${string.length(body)} body=[${body}]")
}

main() {
    s = http.server_create(18407)
    // Loopback only: the default host is every interface, and on Windows
    // each new executable listening there opens a firewall prompt (#2639).
    http.server_set_host(s, "127.0.0.1")
    http.server_post(s, "/upload", handle, 0)
    _ = http.server_start(s)
}
