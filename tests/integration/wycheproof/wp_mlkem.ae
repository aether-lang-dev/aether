// Wycheproof adversarial vectors: ML-KEM (FIPS 203), ML-KEM-512/-768/-1024.
//
// Three vector families, all at the pinned commit (see
// tests/vectors/wycheproof/README.md):
//
//   mlkem_N_test.json                 decapsulation. Each case gives the
//       64-byte seed d || z, a ciphertext c and the expected secret K. We
//       derive dk with keygen_derand(d, z) and run decaps(dk, c).
//   mlkem_N_encaps_test.json          encapsulation. Each case gives ek, the
//       32-byte coin m, and the expected c and K from encaps_derand(ek, m).
//   mlkem_N_semi_expanded_decaps_test.json   decapsulation with the expanded
//       768k + 96 byte dk given directly.
//
// "valid" means the call succeeds and returns exactly K (and c). That covers
// implicit rejection too: a tampered ciphertext of the right length is a
// valid case whose K is the rejection secret J(z || c).
//
// "invalid" means the inputs fail a FIPS 203 input check (#2482): a seed,
// ek, dk or ciphertext of the wrong length, an ek coefficient not reduced
// mod q (the §7.2 modulus check), or a dk whose stored H(ek) does not match
// its ek (the §7.3 hash check). The call MUST return an error and no output.
// Comparing an output against the empty K of an invalid case would pass for
// any output at all, so the driver asserts the error itself.
//
// All ~1400 cases take a few seconds, so the default is a FULL sweep
// (stride 1). WYCHEPROOF_STRIDE=N can still thin it if ever needed.

import std.cryptography.mlkem
import std.os
import std.fs
import std.json
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern atoi(s: string) -> int
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

const KIND_DECAPS = 0 // mlkem_N_test.json: seed, c, K
const KIND_ENCAPS = 1 // mlkem_N_encaps_test.json: ek, m, c, K
const KIND_DECAPS_DK = 2 // mlkem_N_semi_expanded_decaps_test.json: dk, c, K

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(s, slen, i * 2))
        lo = hexval(string_char_at_n(s, slen, i * 2 + 1))
        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

// Bytes [off, off + width) of src, clamped to what src holds, so a seed of
// the wrong length reaches keygen_derand as a d or z of the wrong length
// instead of being padded here.
fn slice_clamped(src: ptr, off: int, width: int) -> ptr {
    out = bytes.new(width)
    i = 0
    while i < width && off + i < bytes.length(src) { bytes.set(out, i, bytes.get(src, off + i)) i = i + 1 }
    return out
}

fn same_bytes(a: ptr, b: ptr) -> int {
    if a == null || b == null { return 0 }
    n = bytes.length(a)
    if n != bytes.length(b) { return 0 }
    i = 0
    while i < n {
        if bytes.get(a, i) != bytes.get(b, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn keygen_k(k: int, d: ptr, z: ptr) -> (ptr, ptr, string) {
    if k == 2 { ek, dk, err = mlkem.mlkem512_keygen_derand(d, z) return ek, dk, err }
    if k == 4 { ek, dk, err = mlkem.mlkem1024_keygen_derand(d, z) return ek, dk, err }
    ek, dk, err = mlkem.mlkem768_keygen_derand(d, z)
    return ek, dk, err
}

fn encaps_k(k: int, ek: ptr, m: ptr) -> (ptr, ptr, string) {
    if k == 2 { ct, key, err = mlkem.mlkem512_encaps_derand(ek, m) return ct, key, err }
    if k == 4 { ct, key, err = mlkem.mlkem1024_encaps_derand(ek, m) return ct, key, err }
    ct, key, err = mlkem.mlkem768_encaps_derand(ek, m)
    return ct, key, err
}

fn decaps_k(k: int, dk: ptr, c: ptr) -> (ptr, string) {
    if k == 2 { key, err = mlkem.mlkem512_decaps(dk, c) return key, err }
    if k == 4 { key, err = mlkem.mlkem1024_decaps(dk, c) return key, err }
    key, err = mlkem.mlkem768_decaps(dk, c)
    return key, err
}

fn field(t: ptr, name: string) -> ptr {
    return from_hex(json.json_get_string_raw(json.json_object_get_raw(t, name)))
}

// Run one case. Returns (ct, key, err); ct is null except for encaps. The
// caller frees ct and key.
fn run_case(kind: int, k: int, t: ptr) -> (ptr, ptr, string) {
    if kind == KIND_ENCAPS {
        ek = field(t, "ek")
        m = field(t, "m")
        ct, key, err = encaps_k(k, ek, m)
        bytes.free(ek)
        bytes.free(m)
        return ct, key, err
    }
    c = field(t, "c")
    if kind == KIND_DECAPS_DK {
        dk = field(t, "dk")
        key, err = decaps_k(k, dk, c)
        bytes.free(dk)
        bytes.free(c)
        return null, key, err
    }
    seed = field(t, "seed")
    zlen = bytes.length(seed) - 32
    if zlen < 0 { zlen = 0 }
    d = slice_clamped(seed, 0, 32)
    z = slice_clamped(seed, 32, zlen)
    ek, dk, kerr = keygen_k(k, d, z)
    bytes.free(seed)
    bytes.free(d)
    bytes.free(z)
    if kerr != "" {
        bytes.free(c)
        return null, null, kerr
    }
    key, err = decaps_k(k, dk, c)
    bytes.free(ek)
    bytes.free(dk)
    bytes.free(c)
    return null, key, err
}

// Run one vector file of the given kind at parameter set k (2/3/4 =
// 512/768/1024). Returns [ok, rejected invalid, failed].
fn run_file(path: string, kind: int, k: int, stride: int) -> (int, int, int) {
    doc, ferr = fs.read(path)
    if ferr != "" {
        println("FAIL: cannot read ${path}: ${ferr}")
        return 0, 0, 1
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: JSON parse ${path}: ${jerr}")
        return 0, 0, 1
    }

    groups = json.json_object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)

    passed = 0
    rejected_invalid = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        tests = json.json_object_get_raw(g, "tests")
        nt = json.array_size(tests)
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.json_get_int(json.json_object_get_raw(t, "tcId"))
            if (tc_id % stride) != 0 && stride > 1 {
                ti = ti + 1
                continue
            }
            res = json.json_get_string_raw(json.json_object_get_raw(t, "result"))
            ct, key, err = run_case(kind, k, t)

            if res == "valid" {
                want_k = field(t, "K")
                ok = 0
                if err == "" && same_bytes(key, want_k) == 1 { ok = 1 }
                if ok == 1 && kind == KIND_ENCAPS {
                    want_c = field(t, "c")
                    ok = same_bytes(ct, want_c)
                    bytes.free(want_c)
                }
                if ok == 1 { passed = passed + 1 } else {
                    println("FAIL ${path} tcId=${tc_id} (valid): err='${err}' or output != expected")
                    failed = failed + 1
                }
                bytes.free(want_k)
            } else {
                // FIPS 203 input check: an error and no output, never a key.
                if err != "" && key == null && ct == null { rejected_invalid = rejected_invalid + 1 } else {
                    println("FAIL ${path} tcId=${tc_id} (invalid): accepted, returned a key")
                    failed = failed + 1
                }
            }

            bytes.free(ct)
            bytes.free(key)
            ti = ti + 1
        }
        gi = gi + 1
    }
    return passed, rejected_invalid, failed
}

fn run_set(dir: string, name: string, kind: int, k: int, stride: int) -> int {
    p, r, f = run_file("${dir}/${name}.json", kind, k, stride)
    println("wycheproof ${name}: ${p} ok, ${r} invalid rejected, ${f} failed (stride ${stride})")
    // A family with no invalid case swept would hide a vacuous branch again.
    if r == 0 && stride == 1 {
        println("FAIL ${name}: no invalid case was exercised")
        return f + 1
    }
    return f
}

main() {
    stride = 1
    sv = os.os_getenv("WYCHEPROOF_STRIDE")
    if sv != 0 { stride = atoi(sv) }
    if stride < 1 { stride = 1 }

    dir = "tests/vectors/wycheproof"
    total_fail = 0
    total_fail = total_fail + run_set(dir, "mlkem_512_test", KIND_DECAPS, 2, stride)
    total_fail = total_fail + run_set(dir, "mlkem_768_test", KIND_DECAPS, 3, stride)
    total_fail = total_fail + run_set(dir, "mlkem_1024_test", KIND_DECAPS, 4, stride)
    total_fail = total_fail + run_set(dir, "mlkem_512_encaps_test", KIND_ENCAPS, 2, stride)
    total_fail = total_fail + run_set(dir, "mlkem_768_encaps_test", KIND_ENCAPS, 3, stride)
    total_fail = total_fail + run_set(dir, "mlkem_1024_encaps_test", KIND_ENCAPS, 4, stride)
    total_fail = total_fail + run_set(dir, "mlkem_512_semi_expanded_decaps_test", KIND_DECAPS_DK, 2, stride)
    total_fail = total_fail + run_set(dir, "mlkem_768_semi_expanded_decaps_test", KIND_DECAPS_DK, 3, stride)
    total_fail = total_fail + run_set(dir, "mlkem_1024_semi_expanded_decaps_test", KIND_DECAPS_DK, 4, stride)

    if total_fail > 0 { exit(1) }
    println("ALL PASS")
}
