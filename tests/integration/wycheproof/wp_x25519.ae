// Wycheproof adversarial vectors — X25519 (#739 / #1298).
//
// Runs every case in tests/vectors/wycheproof/x25519_test.json against
// std.cryptography.x25519.agree. Semantics per Wycheproof:
//   result "valid"      -> agree() MUST succeed and the shared secret match.
//   result "acceptable" -> an implementation may reject (ours rejects
//                          all-zero shared secrets, i.e. small-order /
//                          low-order public keys, by design); if it accepts,
//                          the shared secret MUST match the vector.
// There are no "invalid" results in this family.
//
// This is the adversarial complement to the RFC 7748 KATs in
// tests/integration/crypto_x25519/: twists, small-order points,
// non-canonical encodings, edge-case scalars — 518 cases.
//
// Run from the repo root (the vector path is root-relative); the
// test_wycheproof.sh wrapper does that.

import std.cryptography.x25519
import std.fs
import std.json
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(s, slen, i * 2))
        lo = hexval(string_char_at_n(s, slen, i * 2 + 1))
        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

fn bytes_eq_hex(b: ptr, n: int, hexs: string) -> int {
    if string_length(hexs) != n * 2 { return 0 }
    want = from_hex(hexs)
    i = 0
    ok = 1
    while i < n {
        if bytes.get(b, i) != bytes.get(want, i) { ok = 0 }
        i = i + 1
    }
    bytes.free(want)
    return ok
}

main() {
    doc, ferr = fs.read("tests/vectors/wycheproof/x25519_test.json")
    if ferr != "" {
        println("FAIL: cannot read vector file: ${ferr}")
        exit(1)
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: vector JSON parse: ${jerr}")
        exit(1)
    }

    groups = json.json_object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)

    passed = 0
    rejected_acceptable = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        tests = json.json_object_get_raw(g, "tests")
        nt = json.array_size(tests)
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.json_get_int(json.json_object_get_raw(t, "tcId"))
            res = json.json_get_string_raw(json.json_object_get_raw(t, "result"))
            pub_hex = json.json_get_string_raw(json.json_object_get_raw(t, "public"))
            priv_hex = json.json_get_string_raw(json.json_object_get_raw(t, "private"))
            shared_hex = json.json_get_string_raw(json.json_object_get_raw(t, "shared"))

            // Malformed encodings (wrong-length keys) must be rejected up
            // front — agree() assumes 32-byte buffers.
            if string_length(pub_hex) != 64 || string_length(priv_hex) != 64 {
                if res == "valid" {
                    println("FAIL tcId=${tc_id}: valid case with non-32-byte key?")
                    failed = failed + 1
                } else {
                    rejected_acceptable = rejected_acceptable + 1
                }
                ti = ti + 1
                continue
            }

            priv = from_hex(priv_hex)
            pub = from_hex(pub_hex)
            shared, aerr = x25519.agree(priv, pub)
            if shared == null {
                // Rejected. Fine for "acceptable" (small-order/zero-shared),
                // fatal for "valid".
                if res == "valid" {
                    println("FAIL tcId=${tc_id} (valid): rejected: ${aerr}")
                    failed = failed + 1
                } else {
                    rejected_acceptable = rejected_acceptable + 1
                }
            } else {
                if bytes_eq_hex(shared, 32, shared_hex) == 1 {
                    passed = passed + 1
                } else {
                    println("FAIL tcId=${tc_id} (${res}): shared mismatch")
                    failed = failed + 1
                }
                bytes.free(shared)
            }
            bytes.free(priv)
            bytes.free(pub)
            ti = ti + 1
        }
        gi = gi + 1
    }

    println("wycheproof x25519: ${passed} matched, ${rejected_acceptable} rejected-acceptable, ${failed} failed")
    if failed > 0 { exit(1) }
    println("ALL PASS")
}
