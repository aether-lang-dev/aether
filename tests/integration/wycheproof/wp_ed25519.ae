// Wycheproof adversarial vectors — Ed25519 verify (#739 / #1298).
//
// EddsaVerify schema: one public key per group, then (msg, sig, result)
// cases probing signature malleability, wrong-length sigs, s >= L,
// swapped halves, and the x=0/sign-bit edge points. Semantics:
//   "valid"   -> verify MUST return 1.
//   "invalid" -> verify MUST return 0 (a 1 is an accepted forgery).
// Signatures whose length is not exactly 64 bytes are rejected up front:
// verify() takes a fixed 64-byte buffer by contract, so a wrong-length
// sig cannot even be presented to it — refusal by construction.

import std.cryptography.ed25519
import std.fs
import std.json
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(s, slen, i * 2))
        lo = hexval(string_char_at_n(s, slen, i * 2 + 1))
        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

main() {
    doc, ferr = fs.read("tests/vectors/wycheproof/ed25519_test.json")
    if ferr != "" {
        println("FAIL: cannot read vector file: ${ferr}")
        exit(1)
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: vector JSON parse: ${jerr}")
        exit(1)
    }

    groups = json.json_object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)

    passed = 0
    rejected_invalid = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        pkobj = json.json_object_get_raw(g, "publicKey")
        pk_hex = json.json_get_string_raw(json.json_object_get_raw(pkobj, "pk"))
        pk = from_hex(pk_hex)
        tests = json.json_object_get_raw(g, "tests")
        nt = json.array_size(tests)
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.json_get_int(json.json_object_get_raw(t, "tcId"))
            res = json.json_get_string_raw(json.json_object_get_raw(t, "result"))
            msg_hex = json.json_get_string_raw(json.json_object_get_raw(t, "msg"))
            sig_hex = json.json_get_string_raw(json.json_object_get_raw(t, "sig"))

            if string_length(sig_hex) != 128 {
                if res == "valid" {
                    println("FAIL tcId=${tc_id}: valid case with non-64-byte sig?")
                    failed = failed + 1
                } else {
                    rejected_invalid = rejected_invalid + 1
                }
                ti = ti + 1
                continue
            }

            msg = from_hex(msg_hex)
            msg_len = string_length(msg_hex) / 2
            sig = from_hex(sig_hex)
            ok = ed25519.verify(pk, msg, msg_len, sig)
            if res == "valid" {
                if ok == 1 {
                    passed = passed + 1
                } else {
                    println("FAIL tcId=${tc_id} (valid): verify rejected a good signature")
                    failed = failed + 1
                }
            } else {
                if ok == 0 {
                    rejected_invalid = rejected_invalid + 1
                } else {
                    println("FAIL tcId=${tc_id} (invalid): verify ACCEPTED a forgery")
                    failed = failed + 1
                }
            }
            bytes.free(msg)
            bytes.free(sig)
            ti = ti + 1
        }
        bytes.free(pk)
        gi = gi + 1
    }

    println("wycheproof ed25519: ${passed} valid ok, ${rejected_invalid} forgeries rejected, ${failed} failed")
    if failed > 0 { exit(1) }
    println("ALL PASS")
}
