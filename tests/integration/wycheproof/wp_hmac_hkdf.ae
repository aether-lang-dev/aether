// Wycheproof adversarial vectors — HMAC-SHA256 + HKDF-SHA256 (#739).
//
// Two small families in one driver (both cheap, both keyed to sha2):
//   MacTest:  "valid" tags must be reproduced exactly; "invalid" tags
//             (flipped bits/truncations) must NOT match.
//   HkdfTest: "valid" okm must be reproduced; "invalid" (output length
//             beyond 255*hashLen) must be refused or mismatch.

import std.cryptography.hmac
import std.cryptography.hkdf
import std.fs
import std.json
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(s, slen, i * 2))
        lo = hexval(string_char_at_n(s, slen, i * 2 + 1))
        bytes.set(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return b
}

fn bytes_eq_hex(b: ptr, n: int, hexs: string) -> int {
    if string_length(hexs) != n * 2 { return 0 }
    want = from_hex(hexs)
    i = 0
    ok = 1
    while i < n {
        if bytes.get(b, i) != bytes.get(want, i) { ok = 0 }
        i = i + 1
    }
    bytes.free(want)
    return ok
}

fn run_hmac() -> int {
    doc, ferr = fs.read("tests/vectors/wycheproof/hmac_sha256_test.json")
    if ferr != "" {
        println("FAIL: cannot read hmac vectors: ${ferr}")
        return 1
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: hmac vector parse: ${jerr}")
        return 1
    }
    groups = json.json_object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)
    passed = 0
    rejected_invalid = 0
    skipped = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        tag_size = json.json_get_int(json.json_object_get_raw(g, "tagSize"))
        tests = json.json_object_get_raw(g, "tests")
        nt = json.array_size(tests)
        // Truncated-tag groups: our API returns the full 32-byte MAC; a
        // truncated comparison would be a driver artifact, so count+skip.
        if tag_size != 256 {
            skipped = skipped + nt
            gi = gi + 1
            continue
        }
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.json_get_int(json.json_object_get_raw(t, "tcId"))
            res = json.json_get_string_raw(json.json_object_get_raw(t, "result"))
            key_hex = json.json_get_string_raw(json.json_object_get_raw(t, "key"))
            msg_hex = json.json_get_string_raw(json.json_object_get_raw(t, "msg"))
            tag_hex = json.json_get_string_raw(json.json_object_get_raw(t, "tag"))

            key = from_hex(key_hex)
            msg = from_hex(msg_hex)
            mac = hmac.hmac_sha256(key, string_length(key_hex) / 2, msg, string_length(msg_hex) / 2)
            hit = bytes_eq_hex(mac, 32, tag_hex)
            if res == "valid" {
                if hit == 1 { passed = passed + 1 } else {
                    println("FAIL hmac tcId=${tc_id} (valid): tag mismatch")
                    failed = failed + 1
                }
            } else {
                if hit == 0 { rejected_invalid = rejected_invalid + 1 } else {
                    println("FAIL hmac tcId=${tc_id} (invalid): bogus tag matched")
                    failed = failed + 1
                }
            }
            bytes.free(mac)
            bytes.free(key)
            bytes.free(msg)
            ti = ti + 1
        }
        gi = gi + 1
    }
    println("wycheproof hmac_sha256: ${passed} valid ok, ${rejected_invalid} bogus rejected, ${skipped} skipped (truncated tag), ${failed} failed")
    return failed
}

fn run_hkdf() -> int {
    doc, ferr = fs.read("tests/vectors/wycheproof/hkdf_sha256_test.json")
    if ferr != "" {
        println("FAIL: cannot read hkdf vectors: ${ferr}")
        return 1
    }
    root, jerr = json.parse(doc)
    if jerr != "" {
        println("FAIL: hkdf vector parse: ${jerr}")
        return 1
    }
    groups = json.json_object_get_raw(root, "testGroups")
    ngroups = json.array_size(groups)
    passed = 0
    rejected_invalid = 0
    failed = 0
    gi = 0
    while gi < ngroups {
        g = json.array_get_raw(groups, gi)
        tests = json.json_object_get_raw(g, "tests")
        nt = json.array_size(tests)
        ti = 0
        while ti < nt {
            t = json.array_get_raw(tests, ti)
            tc_id = json.json_get_int(json.json_object_get_raw(t, "tcId"))
            res = json.json_get_string_raw(json.json_object_get_raw(t, "result"))
            ikm_hex = json.json_get_string_raw(json.json_object_get_raw(t, "ikm"))
            salt_hex = json.json_get_string_raw(json.json_object_get_raw(t, "salt"))
            info_hex = json.json_get_string_raw(json.json_object_get_raw(t, "info"))
            size = json.json_get_int(json.json_object_get_raw(t, "size"))
            okm_hex = json.json_get_string_raw(json.json_object_get_raw(t, "okm"))

            ikm = from_hex(ikm_hex)
            salt = from_hex(salt_hex)
            info = from_hex(info_hex)
            okm = hkdf.hkdf("sha256", salt, string_length(salt_hex) / 2,
                ikm, string_length(ikm_hex) / 2,
                info, string_length(info_hex) / 2, size)
            if okm == null {
                if res == "valid" {
                    println("FAIL hkdf tcId=${tc_id} (valid): refused")
                    failed = failed + 1
                } else {
                    rejected_invalid = rejected_invalid + 1
                }
            } else {
                hit = bytes_eq_hex(okm, size, okm_hex)
                if res == "valid" {
                    if hit == 1 { passed = passed + 1 } else {
                        println("FAIL hkdf tcId=${tc_id} (valid): okm mismatch")
                        failed = failed + 1
                    }
                } else {
                    if hit == 0 { rejected_invalid = rejected_invalid + 1 } else {
                        println("FAIL hkdf tcId=${tc_id} (invalid): bogus okm matched")
                        failed = failed + 1
                    }
                }
                bytes.free(okm)
            }
            bytes.free(ikm)
            bytes.free(salt)
            bytes.free(info)
            ti = ti + 1
        }
        gi = gi + 1
    }
    println("wycheproof hkdf_sha256: ${passed} valid ok, ${rejected_invalid} invalid rejected, ${failed} failed")
    return failed
}

main() {
    f = run_hmac()
    f2 = run_hkdf()
    if f + f2 > 0 { exit(1) }
    println("ALL PASS")
}
