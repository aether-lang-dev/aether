fn certs(pem: string) -> ptr {
    l = list_new()
    tls13_cert.trust_store_add_pem(l, pem)
    return l
}

// chain_verify_path(leaf, intermediates, [root]): "" or why not.
fn path_result(leaf_pem: string, inter_pem: string) -> string {
    anchors = certs(pem_root())
    inters = certs(inter_pem)
    leaves = certs(leaf_pem)
    r = "the leaf fixture does not parse"
    if list_size(leaves) == 1 {
        r = tls13_cert.chain_verify_path(list.at(leaves, 0) as *LeafCert, inters, anchors)
    }
    tls13_cert.free_anchors(anchors)
    tls13_cert.free_anchors(inters)
    tls13_cert.free_anchors(leaves)
    return r
}

// validate_chain(leaf, intermediates, [root], at, purpose, -1).
fn chain_result(leaf_pem: string, inter_pem: string, at: string, purpose: int) -> string {
    anchors = certs(pem_root())
    inters = certs(inter_pem)
    leaves = certs(leaf_pem)
    r = "the leaf fixture does not parse"
    if list_size(leaves) == 1 {
        r = tls13_cert.validate_chain(list.at(leaves, 0) as *LeafCert, inters, anchors, at, purpose, -1)
    }
    tls13_cert.free_anchors(anchors)
    tls13_cert.free_anchors(inters)
    tls13_cert.free_anchors(leaves)
    return r
}

// validate_chain(leaf, intermediates, [root], now, PURPOSE_SERVER, max_depth).
fn depth_result(leaf_pem: string, inter_pem: string, max_depth: int) -> string {
    anchors = certs(pem_root())
    inters = certs(inter_pem)
    leaves = certs(leaf_pem)
    r = "the leaf fixture does not parse"
    if list_size(leaves) == 1 {
        r = tls13_cert.validate_chain(list.at(leaves, 0) as *LeafCert, inters, anchors, "", tls13_cert.PURPOSE_SERVER, max_depth)
    }
    tls13_cert.free_anchors(anchors)
    tls13_cert.free_anchors(inters)
    tls13_cert.free_anchors(leaves)
    return r
}

// validate_chain(leaf, intermediates, [anchor], 2027, PURPOSE_SERVER, -1).
fn anchor_result(anchor_pem: string, leaf_pem: string, inter_pem: string) -> string {
    anchors = certs(anchor_pem)
    inters = certs(inter_pem)
    leaves = certs(leaf_pem)
    r = "the leaf fixture does not parse"
    if list_size(leaves) == 1 {
        r = tls13_cert.validate_chain(list.at(leaves, 0) as *LeafCert, inters, anchors, "20270101000000", tls13_cert.PURPOSE_SERVER, -1)
    }
    tls13_cert.free_anchors(anchors)
    tls13_cert.free_anchors(inters)
    tls13_cert.free_anchors(leaves)
    return r
}

// 0 when `got` is what the case wants, else 1 (and says why).
fn check(label: string, got: string, want_ok: int) -> int {
    if want_ok == 1 {
        if string.equals(got, "") == 1 {
            println("ok   ${label}")
            return 0
        }
        println("FAIL ${label}: refused (${got})")
        return 1
    }
    if string.equals(got, "") != 1 {
        println("ok   ${label}: refused (${got})")
        return 0
    }
    println("FAIL ${label}: accepted")
    return 1
}

main() {
    at = "20270101000000"
    server = tls13_cert.PURPOSE_SERVER
    fails = 0

    // The #3303 shape, through the call the client made.
    fails = fails + check("leaf <- ica <- root", path_result(pem_leaf(), pem_ica()), 1)
    fails = fails + check("an end entity of the root, as a leaf", path_result(pem_ee(), ""), 1)
    fails = fails + check("a certificate signed by an end entity (cA FALSE)", path_result(pem_forged(), pem_ee()), 0)
    fails = fails + check("a certificate signed by an end entity without basicConstraints", path_result(pem_forged2(), pem_eenobc()), 0)
    // keyUsage keyCertSign does not make a CA: without basicConstraints cA,
    // an intermediate still issues nothing, now that keyCertSign outside a
    // CA is no longer refused on its own (it is not, by OpenSSL).
    fails = fails + check("an intermediate with keyCertSign and no basicConstraints", path_result(pem_kunocaleaf(), pem_kunoca()), 0)
    fails = fails + check("an end entity offered beside the real intermediate", path_result(pem_leaf(), "${pem_ee()}${pem_ica()}"), 1)

    // What #3340's decoders read leniently (chain_verify_path accepted each
    // issuer before): a keyUsage that is not a BIT STRING (it counted as
    // absent), a repeated extension (the second keyUsage, with
    // keyCertSign, won), and a cA BOOLEAN of 0x01, which DER does not
    // allow. Each makes the certificate malformed, as OpenSSL refuses the
    // first two.
    fails = fails + check("an issuer whose keyUsage is not a BIT STRING", path_result(pem_badkuleaf(), pem_icabadku()), 0)
    fails = fails + check("an issuer with keyUsage twice", path_result(pem_dupleaf(), pem_icadup()), 0)
    fails = fails + check("an issuer whose cA is the BOOLEAN 0x01", path_result(pem_boolleaf(), pem_icabool()), 0)

    // What else an issuer and the path must satisfy.
    fails = fails + check("validate_chain: leaf <- ica <- root", chain_result(pem_leaf(), pem_ica(), at, server), 1)
    fails = fails + check("validate_chain: signed by an end entity", chain_result(pem_forged(), pem_ee(), at, server), 0)
    fails = fails + check("a clientAuth-only leaf for a server", chain_result(pem_clientonly(), pem_ica(), at, server), 0)
    fails = fails + check("a clientAuth-only leaf for a client", chain_result(pem_clientonly(), pem_ica(), at, tls13_cert.PURPOSE_CLIENT), 1)
    fails = fails + check("a CA below a pathLenConstraint 0 CA", chain_result(pem_subleaf(), "${pem_subca()}${pem_ica0()}", at, server), 0)
    fails = fails + check("an issuer without keyCertSign", chain_result(pem_nksleaf(), pem_icanoks(), at, server), 0)
    fails = fails + check("a name inside the permitted subtree", chain_result(pem_ncin(), pem_icanc(), at, server), 1)
    fails = fails + check("a name outside the permitted subtree", chain_result(pem_ncout(), pem_icanc(), at, server), 0)
    fails = fails + check("an unknown critical extension", chain_result(pem_crit(), pem_ica(), at, server), 0)
    fails = fails + check("before notBefore", chain_result(pem_leaf(), pem_ica(), "20251231235959", server), 0)
    fails = fails + check("after notAfter", chain_result(pem_leaf(), pem_ica(), "21260101000001", server), 0)

    // What x509-limbo showed missing.
    fails = fails + check("a 1024-bit RSA key", chain_result(pem_weak(), pem_ica(), at, server), 0)
    fails = fails + check("explicit curve parameters", chain_result(pem_explicit(), pem_ica(), at, server), 0)
    fails = fails + check("*.example.com under excluded bar.example.com (CVE-2025-61727)", chain_result(pem_wild(), pem_icaex(), at, server), 0)
    fails = fails + check("*.other.com under excluded bar.example.com", chain_result(pem_wildok(), pem_icaex(), at, server), 1)
    fails = fails + check("max_depth 0 with one intermediate", depth_result(pem_leaf(), pem_ica(), 0), 0)
    fails = fails + check("max_depth 1 with one intermediate", depth_result(pem_leaf(), pem_ica(), 1), 1)

    // A CA certificate (keyUsage keyCertSign and cRLSign, no
    // digitalSignature) as the leaf: TLS signs with the leaf's key, so it is
    // refused for either purpose, as OpenSSL refuses it (#3309).
    fails = fails + check("a CA certificate as the leaf, for a server", chain_result(pem_ica(), "", at, server), 0)
    fails = fails + check("a CA certificate as the leaf, for a client", chain_result(pem_ica(), "", at, tls13_cert.PURPOSE_CLIENT), 0)
    fails = fails + check("a leaf with keyUsage digitalSignature", chain_result(pem_leaf(), pem_ica(), at, server), 1)

    // Only a self-signed root ends a path, as on OpenSSL (#3310): not a
    // trusted intermediate, nor a self-issued root whose
    // authorityKeyIdentifier names another key, issuer or serial.
    fails = fails + check("a trusted intermediate as the anchor", anchor_result(pem_ica(), pem_leaf(), ""), 0)
    fails = fails + check("a root whose AKI keyIdentifier is not its SKI", anchor_result(pem_akikeyid(), pem_akikeyidleaf(), ""), 0)
    fails = fails + check("a root whose AKI names another issuer", anchor_result(pem_akiissuer(), pem_akiissuerleaf(), ""), 0)
    fails = fails + check("a root whose AKI names another serial", anchor_result(pem_akiserial(), pem_akiserialleaf(), ""), 0)
    fails = fails + check("a root whose AKI names another key, issuer and serial", anchor_result(pem_akiall(), pem_akiallleaf(), ""), 0)
    fails = fails + check("a root whose AKI names its own serial", anchor_result(pem_akiself(), pem_akiselfleaf(), ""), 1)
    fails = fails + check("the same leaf under its root", anchor_result(pem_root(), pem_leaf(), pem_ica()), 1)

    // A trust anchor's own pathLenConstraint holds, as on OpenSSL and Go
    // (#3432): a root with pathLenConstraint 0 allows no CA below it. The
    // root without the extension is "the same leaf under its root" above.
    pl_why = anchor_result(pem_rootpl0(), pem_plleaf(), pem_icapl())
    fails = fails + check("a CA below a pathLenConstraint 0 root", pl_why, 0)
    if string.equals(pl_why, "a CA's path length constraint is exceeded") != 1 {
        println("FAIL a CA below a pathLenConstraint 0 root: refused, but not for its path length (${pl_why})")
        fails = fails + 1
    }
    fails = fails + check("an end entity of a pathLenConstraint 0 root", anchor_result(pem_rootpl0(), pem_pldirect(), ""), 1)

    // A pinned self-signed leaf with basicConstraints cA FALSE: trusted as
    // it stands (it has no issuer), as OpenSSL trusts it.
    fails = fails + check("a pinned self-signed leaf (cA FALSE)", anchor_result(pem_pinned(), pem_pinned(), ""), 1)

    if fails > 0 {
        println("tls13_chain: ${fails} FAILURES")
        exit(1)
    }
    println("tls13_chain: all checks pass")
}
