import raw

// The program's own memcpy takes an int[] source; raw's takes a ptr. Each
// file's calls are checked against its own declaration: the program's
// against this one, raw's against raw's.
extern memcpy(dst: ptr, src: int[], n: long) -> ptr
extern malloc(n: long) -> ptr
extern free(p: ptr)
extern memcmp(a: ptr, b: ptr, n: long) -> int

main() {
    xs = [1, 2, 3]
    p = malloc(16)
    q = malloc(16)
    memcpy(p, xs, 12)
    raw.copy12(q, p)
    println("${memcmp(p, q, 12)}")
    free(p)
    free(q)
}
