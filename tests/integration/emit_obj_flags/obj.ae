// #3812: built as an executable and as an --emit=obj object, the two must
// print the same. AE_OBJ_TAG comes from aether.toml's cflags, so only a
// compile that carries the user's cflags sees it; the seed wraps past 2^31,
// which only -fwrapv makes defined.
extern const AE_OBJ_TAG: int @c_import

step(seed: int) -> int {
    return seed * 1103515245 + 12345
}

main() {
    s = 1
    i = 0
    while i < 10 {
        s = step(s)
        i = i + 1
    }
    println("tag ${AE_OBJ_TAG} seed ${s}")
}
