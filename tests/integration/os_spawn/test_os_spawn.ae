// Validate the cross-platform non-blocking spawn / wait / wait_any trio
// (std.os). The key property is CONCURRENCY: multiple children in flight
// at once, reaped in completion order, with exit codes correctly
// attributed and spawn failures distinguishable from failed children.
import std.os
import std.list
import std.mem
import std.io

check(label: string, ok: bool) -> int {
    if ok {
        println("ok   ${label}")
        return 0
    }
    println("FAIL ${label}")
    return 1
}

main() {
    // Re-run as a child: a program that runs and exits 127.
    if os.args_count() > 1 {
        if os.args_get(1) == "exit127" {
            exit(127)
        }
    }
    fails = 0

    // ---- spawn + single wait, exit code fidelity ----
    // `false` exits non-zero; `true` exits zero.
    at, ae = os.spawn_proc("true", null, null)
    fails = fails + check("spawn true succeeds", ae == "")
    ac, aerr = os.wait(at)
    fails = fails + check("true exits 0", ac == 0 && aerr == "")

    // ---- a reaped token is gone, never a pid (#2609) ----
    // On Windows a token is a table key, and os.kill / os.wait_pid_timeout
    // also take a real pid. Tokens counted from 1 once reaped were opened as
    // that pid: whatever process had the number now. They now lie above any
    // pid. (On POSIX the token is the pid, which the system may hand out
    // again once reaped, so it is not signalled here.)
    if os.platform() == "windows" {
        fails = fails + check("a token is above every pid", at >= 1073741824)
        fails = fails + check("kill of a reaped token reports it gone", os.kill(at, 9) == -1)
        fails = fails + check("probe of a reaped token reports it gone", os.kill(at, 0) == -1)
        _gs, gto, gerr = os.wait_pid_timeout(at, 1)
        fails = fails + check("bounded wait on a reaped token reports no such process",
            gto == 0 && gerr == "no such process")
    }

    bt, be = os.spawn_proc("false", null, null)
    fails = fails + check("spawn false succeeds", be == "")
    bc, berr = os.wait(bt)
    // A failed child is a non-zero exit with NO error string — distinct
    // from a spawn/reap failure (which sets err and returns -1).
    fails = fails + check("false exits non-zero, err empty", bc != 0 && berr == "")

    // ---- a program that cannot start fails the spawn (#3170) ----
    // On every platform: token -1 and the reason, nothing to reap. POSIX
    // used to start a child that exited 127, which a program that ran and
    // exited 127 also gives; that one spawns and reaps 127.
    ft, ferr = os.spawn_proc("this_program_does_not_exist_xyz", null, null)
    fails = fails + check("missing program fails the spawn with its reason",
        ft == -1 && ferr == "program not found")
    av127 = list.new()
    _ = list.add(av127, "exit127")
    t127, e127 = os.spawn_proc(os.argv0(), av127, null)
    fails = fails + check("a program that exits 127 spawns", e127 == "")
    c127, w127 = os.wait(t127)
    fails = fails + check("and reaps 127 with no err", c127 == 127 && w127 == "")
    list.free(av127)

    // ---- wait_any returns children in COMPLETION order, not spawn order ----
    // The order is made, not timed (#2892): the slow child does not exit on
    // its own, so the fast one is the only child that can have finished
    // when the first wait_any returns; the test then ends the slow one, and
    // only it is left for the second. A one-second margin between two
    // sleeps failed under load, both children done before wait_any looked.
    argv_slow = list.new()
    _ = list.add(argv_slow, "30")

    slow, _ = os.spawn_proc("sleep", argv_slow, null) // spawned first, finishes last
    list.free(argv_slow)
    fast, _ = os.spawn_proc("true", null, null) // spawned second, finishes first

    toks = list.new()
    _ = list.add(toks, mem.long_to_ptr(slow as long))
    _ = list.add(toks, mem.long_to_ptr(fast as long))

    first_tok, first_code, first_err = os.wait_any(toks)
    fails = fails + check("wait_any returns the faster child first", first_tok == fast)
    fails = fails + check("first child exit 0", first_code == 0 && first_err == "")

    _ks = os.kill(slow, 9)
    second_tok, second_code, second_err = os.wait_any(toks)
    fails = fails + check("wait_any then returns the slower child", second_tok == slow)
    fails = fails + check("second child reaps 137 (128+SIGKILL)", second_code == 137 && second_err == "")

    // ---- wait_any_timeout: per-call deadline, not a batch deadline (#1278) ----
    // One "hung" child (sleep 30) and one short (`true`, which exits at once,
    // so the 3s deadline is not a race with it either, #2892). A 3s
    // wait_any_timeout must return the short one (timed_out == 0), and a
    // *second* call, with only the hung child left, must report
    // timed_out == 1 without killing it.
    argv_hung = list.new()
    _ = list.add(argv_hung, "30")

    hung, _ = os.spawn_proc("sleep", argv_hung, null)
    list.free(argv_hung)
    short, _ = os.spawn_proc("true", null, null)

    ttoks = list.new()
    _ = list.add(ttoks, mem.long_to_ptr(hung as long))
    _ = list.add(ttoks, mem.long_to_ptr(short as long))

    // First call: the short child finishes within 3s.
    wt1, wc1, to1, we1 = os.wait_any_timeout(ttoks, 3)
    fails = fails + check("wait_any_timeout reaps the short child", wt1 == short)
    fails = fails + check("short child not timed out, exit 0", to1 == 0 && wc1 == 0 && we1 == "")

    // Second call: only the hung child remains; a 2s deadline must time out
    // rather than block for the remaining ~27s. token is -1, timed_out == 1.
    wt2, _, to2, we2 = os.wait_any_timeout(ttoks, 2)
    fails = fails + check("wait_any_timeout times out on the hung child", to2 == 1)
    fails = fails + check("timeout reports no token and no error", wt2 == -1 && we2 == "")

    // The token must still be usable: kill it, then reap a distinguishable
    // signalled status (POSIX 128+SIGKILL = 137).
    _k = os.kill(hung, 9)
    hc, herr = os.wait(hung)
    fails = fails + check("killed child reaps 137 (128+SIGKILL)", hc == 137 && herr == "")
    list.free(toks)
    list.free(ttoks)

    if fails == 0 {
        println("ALL PASS")
        return
    }
    println("FAILURES: ${fails}")
    exit(1)
}
