// #2494 / #2498 probe: a receive arm is a scope. Its defers run when the
// handler ends, and the closures, cells and struct locals it makes are
// released then, on every exit, so a message leaves nothing behind. A value
// stored into actor state is not released with the arm: it belongs to the
// state.
//
// test_closure_local_env_free.sh builds this with env_count.h force-included
// and checks every env and cell is freed exactly once; on its own it checks
// the output.

import std.string

struct Rec { name: string, count: int }

message Ping { n: int }
message Bump { n: int }
message Keep { s: string }
message Bye { n: int }
message Count { n: int }
message Show {}

actor Worker {
    state total = 0
    state kept = Rec { name: "", count: 0 }
    state counted = 0

    receive {
        // A closure and the cell it writes, on the fall-through exit, an
        // early return, and a loop left by break.
        Ping(n) -> {
            acc = 0
            g = || { acc = acc + n }
            g()
            g()
            total = total + acc
            if n > 40 {
                return
            }
            i = 0
            while i < 5 {
                h = || { acc = acc + 1 }
                h()
                if i == 2 {
                    break
                }
                i = i + 1
            }
        }
        // A closure that writes the pattern binding (#2492): the binding is
        // a cell of the arm.
        Bump(n) -> {
            f = || { n = n + 1 }
            f()
            total = total + n
        }
        // A struct local stored into state keeps its string; a closure
        // that captured it holds a copy of its own (#2504).
        Keep(s) -> {
            loc = Rec { name: string.concat(s, "!"), count: 1 }
            g = || {
                return string.length(loc.name)
            }
            kept = loc
            int len = call(g)
            total = total + len
        }
        // A state field summed in a loop (#2505).
        Count(n) -> {
            i = 0
            while i < n {
                counted = counted + 1
                i = i + 1
            }
        }
        Bye(n) -> {
            defer println("bye ${n}")
            println("hi ${n}")
        }
        Show() -> {
            println("kept ${kept.name} count ${kept.count} total ${total} counted ${counted}")
        }
    }
}

send_keep(w: ptr, a: string) {
    w ! Keep { s: string.concat(a, "pt") }
}

main() {
    w = spawn(Worker())
    i = 0
    while i < 50 {
        w ! Ping { n: i }
        w ! Bump { n: i }
        i = i + 1
    }
    send_keep(w, "ke")
    w ! Count { n: 4 }
    w ! Count { n: 3 }
    w ! Bye { n: 3 }
    w ! Show {}
    wait_for_idle()
}
