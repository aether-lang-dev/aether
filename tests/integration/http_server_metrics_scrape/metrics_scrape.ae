// The /metrics scrape lists every series it counts (#3264), and the series a
// client can create are bounded (#3265).
//
// The scrape was written into a fixed 64 KB buffer and stopped where it
// filled, without a word: a series is about 1.3 KB of text, so past about
// fifty of them the rest were silently missing from every scrape. And the
// per-route counters were keyed by the literal method and path a client
// sent, one series each, without limit, in a list searched under one lock
// on every request: a client requesting fresh paths grew it, and slowed
// every request, for as long as it liked. Past 1024 series, requests now
// count in one series labelled "(other)", which is the same series a client
// sending that method and path itself counts in: it was a second series
// with the same labels, which a Prometheus scrape rejects (#3279). A label
// is cut at 255 bytes, and two paths that agreed that far were two series
// written with one label; and a path's bytes went into its label as sent,
// one that is not UTF-8 included, which a scrape rejects too (#3282).
//
// A request whose method and path are both "(other)", two whose paths
// differ only past 300 bytes, one with a byte that is not UTF-8, requests to
// distinct paths, then a scrape: the requests the scrape counts must add up
// to every request the server served, it may list no more than 1025 series,
// none twice, and no byte that is not UTF-8. The server listens on 127.0.0.1
// and a port the kernel picks.
//
// What the scrape counts is the requests the server parsed and served: the
// metrics are a request hook, run with the request after its response. A
// head the server refuses before there is a request, answered 400, 414 or
// 431 on the connection and closed, is no request to a hook and counts in no
// series, whatever it was refused for: a NUL, a bare CR or LF (#3664), its
// framing, its size, or a request line that is not method SP target SP
// version (#3666). "(other) (other) HTTP/1.1" is one since #3666, as "(other)"
// is not a token: it was counted before, and is refused now, so a client can
// no longer send the overflow series' labels as a method at all. It is still
// sent, beside two other refusals, to hold all three to the same rule.

import std.http
import std.string
import std.tcp

extern exit(code: int)

handle_p(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "p")
}

// One response off `sock`, by its Content-Length: the whole of it.
read_response(sock: ptr) -> string {
    wire = ""
    want = -1
    quiet = 0
    while quiet < 20 && (want < 0 || string.length(wire) < want) {
        ready, _perr = tcp.poll(sock, 100)
        if ready {
            chunk, rerr = tcp.read(sock, 65536)
            if rerr != "" || string.length(chunk) == 0 {
                quiet = 20
            } else {
                wire = string.concat(wire, chunk)
                quiet = 0
                if want < 0 {
                    end = string.index_of(wire, "\r\n\r\n")
                    if end >= 0 {
                        at = string.index_of(wire, "Content-Length: ")
                        stop = string.index_of_from(wire, "\r\n", at)
                        want = end + 4 + string.get_int(string.substring(wire, at + 16, stop))
                    }
                }
            }
        } else {
            quiet = quiet + 1
        }
    }
    return wire
}

// `count` GETs to distinct paths starting at /x<from>, one at a time.
spray(sock: ptr, from: int, count: int) {
    i = 0
    while i < count {
        tcp.write(sock, "GET /x${from + i} HTTP/1.1\r\nHost: x\r\n\r\n")
        read_response(sock)
        i = i + 1
    }
}

// The scrape's request series: how many, then the requests they add up to.
series_and_total(scrape: string) -> (int, int) {
    series = 0
    total = 0
    marker = "\naether_http_requests_total{"
    at = string.index_of(scrape, marker)
    while at >= 0 {
        close = string.index_of_from(scrape, "} ", at)
        stop = string.index_of_from(scrape, "\n", close)
        total = total + string.get_int(string.substring(scrape, close + 2, stop))
        series = series + 1
        at = string.index_of_from(scrape, marker, stop)
    }
    return series, total
}

// One request on a connection of its own, its response read and returned,
// then closed.
alone(port: int, request: string) -> string {
    sock, err = tcp.connect("127.0.0.1", port)
    if err != "" {
        println("FAIL: connect")
        exit(1)
    }
    tcp.write(sock, request)
    response = read_response(sock)
    tcp.close(sock)
    return response
}

// 1 when `request`, alone on a connection, is refused with 400.
refused(port: int, label: string, request: string) -> int {
    response = alone(port, request)
    if string.index_of(response, "HTTP/1.1 400 ") == 0 {
        println("  PASS refused with 400: ${label}")
        return 0
    }
    println("  FAIL not refused with 400: ${label}")
    return 1
}

// How many times `needle` is in `hay`.
occurrences(hay: string, needle: string) -> int {
    n = 0
    at = string.index_of(hay, needle)
    while at >= 0 {
        n = n + 1
        at = string.index_of_from(hay, needle, at + 1)
    }
    return n
}

main() {
    println("=== the metrics scrape lists every series, and a client cannot grow them without end (#3264, #3265) ===")
    server = http.server_create(0)
    http.server_set_host(server, "127.0.0.1")
    http.server_get(server, "/p", handle_p, 0)
    merr = http.server_set_metrics(server, "/metrics")
    if merr != "" {
        println("FAIL: metrics: ${merr}")
        exit(1)
    }
    if http.server_bind(server, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    err = http.server_start_background(server)
    if err != "" {
        println("FAIL: ${err}")
        exit(1)
    }
    port = http.server_port(server)
    sleep(100)
    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        println("FAIL: connect")
        exit(1)
    }

    bad = 0
    // Three requests refused before they are requests, by the request line,
    // a bare LF and the framing, and a path that is not UTF-8, each on a
    // connection of its own: the server closes one whose request it refuses.
    // The refused ones count nowhere.
    bad = bad + refused(port, "the overflow series' labels as method and path", "(other) (other) HTTP/1.1\r\nHost: x\r\n\r\n")
    bad = bad + refused(port, "a header line ended by a bare LF", "GET /lf HTTP/1.1\nHost: x\r\n\r\n")
    bad = bad + refused(port, "a Content-Length that is not a number", "GET /cl HTTP/1.1\r\nHost: x\r\nContent-Length: x\r\n\r\n")
    alone(port, "GET /bad\xff HTTP/1.1\r\nHost: x\r\n\r\n")

    // Two paths the label cannot tell apart.
    long_path = string.pad_end("/", 301, 97)
    tcp.write(sock, "GET ${long_path}1 HTTP/1.1\r\nHost: x\r\n\r\n")
    read_response(sock)
    tcp.write(sock, "GET ${long_path}2 HTTP/1.1\r\nHost: x\r\n\r\n")
    read_response(sock)

    // 120 series: past what 64 KB of scrape held, well within the bound. The
    // requests served: /bad, the two long paths and these 120, 123; the three
    // refused are not among them.
    spray(sock, 0, 120)
    tcp.write(sock, "GET /metrics HTTP/1.1\r\nHost: x\r\n\r\n")
    series, total = series_and_total(read_response(sock))
    if total != 123 {
        println("  FAIL the scrape counts every request: ${total} of 123 in ${series} series")
        bad = bad + 1
    } else {
        println("  PASS the scrape counts every request")
    }

    // 1500 more: past the bound. The scrape before this one is counted too.
    spray(sock, 120, 1500)
    tcp.write(sock, "GET /metrics HTTP/1.1\r\nHost: x\r\n\r\n")
    scrape = read_response(sock)
    series, total = series_and_total(scrape)
    if series > 1025 {
        println("  FAIL the series a client can create are bounded: ${series}")
        bad = bad + 1
    } else {
        println("  PASS the series a client can create are bounded")
    }
    if total != 1624 {
        println("  FAIL the bounded scrape still counts every request: ${total} of 1624")
        bad = bad + 1
    } else {
        println("  PASS the bounded scrape still counts every request")
    }
    others = occurrences(scrape, "aether_http_requests_total{method=\"(other)\",path=\"(other)\"}")
    longs = occurrences(scrape, "aether_http_requests_total{method=\"GET\",path=\"${string.substring(long_path, 0, 255)}")
    if others != 1 || longs != 1 {
        println("  FAIL no two series share labels: the (other) series is listed ${others} times, the long path's ${longs}")
        bad = bad + 1
    } else {
        println("  PASS no two series share labels")
    }
    if string.index_of(scrape, "\xff") >= 0 || occurrences(scrape, "path=\"/bad?\"") == 0 {
        println("  FAIL every label is UTF-8")
        bad = bad + 1
    } else {
        println("  PASS every label is UTF-8")
    }

    tcp.close(sock)
    http.server_stop(server)
    http.server_free(server)
    if bad > 0 {
        println("FAIL: ${bad} case(s)")
        exit(1)
    }
    println("All PASS")
}
