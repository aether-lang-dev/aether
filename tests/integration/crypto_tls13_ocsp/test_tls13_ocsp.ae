// Validate OCSP responder-signature verification (RFC 6960 §4.2.2.2) in
// std.cryptography.tls13_cert.verify_ocsp_signature.
//
// Vectors are REAL: a stapled OCSP response fetched from ocsp.digicert.com for
// a digicert.com leaf, plus that leaf's issuer cert ("DigiCert EV RSA CA G2").
// DigiCert's responder is the issuer itself (direct-issuer signing), so this
// exercises the direct path with a genuine sha256WithRSAEncryption signature.
// The signature is over fixed bytes, so the vector does not expire.
//
// Asserts: (1) the authentic response verifies under the correct issuer;
// (2) a one-byte-tampered signature is rejected; (3) the wrong issuer key
// (the DigiCert root, which did not sign this response) is rejected.

import std.cryptography.tls13_cert
import std.bytes
import std.string
import std.io
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}

fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        bytes.set(b, i, (hexval(string_char_at_n(s, slen, i * 2)) << 4) | hexval(string_char_at_n(s, slen, i * 2 + 1)))
        i = i + 1
    }
    return b
}

main() {
    total_ok = 1

    issuer_der = from_hex("")
    resp_der = from_hex("")
    tamp_der = from_hex("")
    wrong_der = from_hex("")

    iss = tls13_cert.LeafCert { tbs: null, tbs_len: 0, sig_alg_oid: null, signature: null, signature_len: 0, spki_algo_oid: null, spki_key: null, spki_key_len: 0, issuer: null, issuer_len: 0, subject: null, subject_len: 0, not_before: null, not_before_len: 0, not_after: null, not_after_len: 0, dns_names: null }
    ierr = tls13_cert.parse_certificate(issuer_der, bytes.length(issuer_der), &iss)
    if string.equals(ierr, "") != 1 { println("FAIL parse issuer: ${ierr}"); total_ok = 0 }

    wrong = tls13_cert.LeafCert { tbs: null, tbs_len: 0, sig_alg_oid: null, signature: null, signature_len: 0, spki_algo_oid: null, spki_key: null, spki_key_len: 0, issuer: null, issuer_len: 0, subject: null, subject_len: 0, not_before: null, not_before_len: 0, not_after: null, not_after_len: 0, dns_names: null }
    werr = tls13_cert.parse_certificate(wrong_der, bytes.length(wrong_der), &wrong)
    if string.equals(werr, "") != 1 { println("FAIL parse wrong issuer: ${werr}"); total_ok = 0 }

    st = tls13_cert.parse_ocsp_status(resp_der, bytes.length(resp_der))
    if st == tls13_cert.OCSP_GOOD { println("ok   OCSP status parses good") }
    else { println("FAIL OCSP status not good (${st})"); total_ok = 0 }

    if tls13_cert.verify_ocsp_signature(resp_der, bytes.length(resp_der), &iss) == 1 {
        println("ok   OCSP responder signature verifies (direct issuer)")
    } else {
        println("FAIL OCSP responder signature rejected valid response"); total_ok = 0
    }

    if tls13_cert.verify_ocsp_signature(tamp_der, bytes.length(tamp_der), &iss) == 0 {
        println("ok   OCSP responder signature rejects tampered response")
    } else {
        println("FAIL OCSP accepted tampered response"); total_ok = 0
    }

    if tls13_cert.verify_ocsp_signature(resp_der, bytes.length(resp_der), &wrong) == 0 {
        println("ok   OCSP responder signature rejects wrong issuer key")
    } else {
        println("FAIL OCSP accepted response under wrong issuer"); total_ok = 0
    }

    // 4. Delegated responder (RFC 6960 §4.2.2.2): a real GoDaddy staple whose
    // signer is a responder cert embedded in certs[0] — issuer-signed and
    // carrying the OCSPSigning EKU. Verified end-to-end (parse embedded cert ->
    // check issuer signature + EKU -> verify response under the responder key).
    gd_issuer_der = from_hex("")
    gd_resp_der = from_hex("")
    gd_iss = tls13_cert.LeafCert { tbs: null, tbs_len: 0, sig_alg_oid: null, signature: null, signature_len: 0, spki_algo_oid: null, spki_key: null, spki_key_len: 0, issuer: null, issuer_len: 0, subject: null, subject_len: 0, not_before: null, not_before_len: 0, not_after: null, not_after_len: 0, dns_names: null }
    gderr = tls13_cert.parse_certificate(gd_issuer_der, bytes.length(gd_issuer_der), &gd_iss)
    if string.equals(gderr, "") != 1 { println("FAIL parse gd issuer: ${gderr}"); total_ok = 0 }
    if tls13_cert.verify_ocsp_signature(gd_resp_der, bytes.length(gd_resp_der), &gd_iss) == 1 {
        println("ok   OCSP delegated-responder signature verifies")
    } else {
        println("FAIL OCSP delegated-responder signature rejected"); total_ok = 0
    }
    tls13_cert.free_leaf(&gd_iss)
    bytes.free(gd_issuer_der); bytes.free(gd_resp_der)

    tls13_cert.free_leaf(&iss)
    tls13_cert.free_leaf(&wrong)
    bytes.free(issuer_der); bytes.free(resp_der); bytes.free(tamp_der); bytes.free(wrong_der)

    if total_ok == 1 { println("tls13_ocsp: all checks pass") }
    else { println("tls13_ocsp: FAILURES") }
}
