import std.string(*)
import mathy(*)

exports(bytes, describe)

extern abs(x: int) -> int

// Its own `bytes` (three arguments) and its own `extern abs` shadow the
// `string.bytes` and `mathy.abs` its glob imports would bind (#2632).
bytes(n: int, unit: string, sep: string) -> string {
    return "${n}${sep}${unit}"
}

// `length` is extern-backed in std.string (`string_length`): the glob binds
// it in a build as `ae check` of this file does (#2637).
describe(n: int) -> string {
    return "${bytes(abs(n), "B", " ")} ${length("xy")} ${twice(n)} ${pad("s")}"
}

// Locals shadow: a closure bound to `bytes` (this module's own function) or
// to `trim` (a name the std.string glob binds) is the one called (#2637).
pad(s: string) -> string {
    bytes = | x: string | -> "<${x}>"
    trim = | x: string | -> "[${x}]"
    return trim(bytes(s))
}
