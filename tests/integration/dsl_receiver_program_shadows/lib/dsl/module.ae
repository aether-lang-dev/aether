// Fixture for #333's shadowing rule: a module whose functions a trailing
// block passed to it reaches by their bare names, and a program that
// defines some of those names itself.
exports(say, tag, label, run, build, opt)

import std.map

say(a: int, b: int) {
    println("dsl.say ${a + b}")
}

tag(a: int) {
    println("dsl.tag ${a}")
}

label() -> string {
    return "dsl.label"
}

// Takes a closure: the block is written `callback { ... }`.
run(n: int, body: fn) {
    call(body)
}

// A builder: its block runs inline and its setters take `_ctx`.
builder build(name: string) {
    defer map.free(_builder)
    v = "<unset>"
    if _builder != null {
        if map_has(_builder, "opt") == 1 {
            v, _ = map.get_string(_builder, "opt")
        }
    }
    println("build ${name} opt=${v}")
}

opt(_ctx: ptr, v: string) {
    map_put(_ctx, "opt", v)
}
