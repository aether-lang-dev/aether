// What the proxy cache keys by, and what it refuses to keep (#3736).
//
// - The key left out the query: `/q?a=1` and `/q?a=2` shared an entry, so
//   one client was served another's answer. Each query now misses on its
//   own, and a repeat of the first still hits.
// - A response to a request with Authorization was stored and replayed to
//   every later client. It is stored only when the response says it may be
//   shared (public, s-maxage or must-revalidate, RFC 9111 3.5).
// - A response with Set-Cookie was stored and its cookie replayed. It is
//   not stored.
// - Under preserve_host the upstream answers by the client's Host, which the
//   key left out. Two Hosts now miss separately.
//
// A raw upstream numbers the connections it answers and echoes the request
// line and Host in the body, so a probe can tell a hit from a fresh answer.

import std.http
import std.http.proxy
import std.string
import std.tcp

extern exit(code: int)

message Serve { srv: ptr, conns: int }

// The value of field `name` in `head`, or "".
field(head: string, name: string) -> string {
    at = string.index_of(head, "\r\n${name}: ")
    if at < 0 {
        return ""
    }
    rest = string.substring(head, at + string.length(name) + 4, string.length(head))
    return string.substring(rest, 0, string.index_of(rest, "\r\n"))
}

// The headers the upstream answers a path with, beyond the framing.
extra_headers(line: string) -> string {
    if string.contains(line, " /auth-public") != 0 {
        return "Cache-Control: public, max-age=60\r\n"
    }
    if string.contains(line, " /cookie") != 0 {
        return "Cache-Control: max-age=60\r\nSet-Cookie: sid=secret-of-the-first-client\r\n"
    }
    return "Cache-Control: max-age=60\r\n"
}

// Accept `conns` connections on `srv`, one at a time, and answer each
// request with "<n> <request line> host=<Host>" as its body, then close.
actor Upstream {
    receive {
        Serve(srv, conns) -> {
            c = 0
            while c < conns {
                sock, aerr = tcp.accept(srv)
                if aerr != "" {
                    c = conns
                } else {
                    req = ""
                    t = 0
                    while t < 50 && string.index_of(req, "\r\n\r\n") < 0 {
                        chunk, rerr = tcp.read(sock, 4096)
                        if rerr != "" || string.length(chunk) == 0 {
                            t = 50
                        } else {
                            req = string.concat(req, chunk)
                        }
                        t = t + 1
                    }
                    c = c + 1
                    line = string.substring(req, 0, string.index_of(req, "\r\n"))
                    host = field(req, "Host")
                    body = "${c} ${line} host=${host}"
                    extra = extra_headers(line)
                    tcp.write(sock, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: ${string.length(body)}\r\n${extra}Connection: close\r\n\r\n${body}")
                    sleep(50)
                    tcp.close(sock)
                }
            }
        }
    }
}

// GET `target` with Host `host` and `extra` header lines, on a connection
// of its own: "<X-Cache> <body>".
probe(port: int, target: string, host: string, extra: string) -> string {
    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        return "connect failed"
    }
    tcp.write(sock, "GET ${target} HTTP/1.1\r\nHost: ${host}\r\n${extra}Connection: close\r\n\r\n")
    wire = ""
    tries = 0
    while tries < 30 {
        ready, _perr = tcp.poll(sock, 100)
        if ready {
            chunk, rerr = tcp.read(sock, 4096)
            if rerr != "" || string.length(chunk) == 0 {
                tries = 30
            } else {
                wire = string.concat(wire, chunk)
            }
        }
        tries = tries + 1
    }
    tcp.close(sock)
    end = string.index_of(wire, "\r\n\r\n")
    if end < 0 {
        return "no answer"
    }
    xcache = field(string.substring(wire, 0, end + 2), "X-Cache")
    body = string.substring(wire, end + 4, string.length(wire))
    return "${xcache} ${body}"
}

// A proxy with a "method_url" cache in front of an upstream that serves
// `conns` connections. Returns the server, the pool, the opts, the cache
// and the upstream listener, for teardown.
start(conns: int, preserve_host: int) -> (ptr, ptr, ptr, ptr, ptr) {
    srv, lerr = tcp.listen_on("127.0.0.1", 0)
    if lerr != "" {
        println("FAIL: listen: ${lerr}")
        exit(1)
    }
    up = spawn(Upstream())
    up ! Serve { srv: srv, conns: conns }
    pool = proxy.upstream_pool_new("round_robin", 5, 0, 0)
    proxy.upstream_add(pool, "http://127.0.0.1:${tcp.server_port(srv)}", 1)
    cache = proxy.cache_new(16, 65536, 60, "method_url")
    opts = proxy.opts_new()
    proxy.opts_bind_cache(opts, cache)
    proxy.opts_set_preserve_host(opts, preserve_host)
    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    merr = proxy.mount(s, "/", pool, opts)
    if merr != "" {
        println("FAIL: mount: ${merr}")
        exit(1)
    }
    if http.server_bind(s, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    serr = http.server_start_background(s)
    if serr != "" {
        println("FAIL: ${serr}")
        exit(1)
    }
    sleep(100)
    return s, pool, opts, cache, srv
}

stop(s: ptr, pool: ptr, opts: ptr, cache: ptr, srv: ptr) {
    http.server_stop(s)
    http.server_free(s)
    proxy.opts_free(opts)
    proxy.upstream_pool_free(pool)
    proxy.cache_free(cache)
    tcp.server_close(srv)
}

check(label: string, got: string, want: string) -> int {
    if got == want {
        println("  PASS ${label}: ${got}")
        return 0
    }
    println("  FAIL ${label}: got '${got}', expected '${want}'")
    return 1
}

main() {
    println("=== proxy cache key and credentialed responses (#3736) ===")
    bad = 0
    auth = "Authorization: Bearer first-client\r\n"

    s, pool, opts, cache, srv = start(7, 0)
    p = http.server_port(s)
    up = "host=127.0.0.1:${tcp.server_port(srv)}"
    // Two queries on one path are two resources; a repeat of the first hits.
    bad = bad + check("query a=1", probe(p, "/q?a=1", "x", ""), "MISS 1 GET /q?a=1 HTTP/1.1 ${up}")
    bad = bad + check("query a=2 misses", probe(p, "/q?a=2", "x", ""), "MISS 2 GET /q?a=2 HTTP/1.1 ${up}")
    bad = bad + check("query a=1 again hits", probe(p, "/q?a=1", "x", ""), "HIT 1 GET /q?a=1 HTTP/1.1 ${up}")
    // Authorization and a response that does not say it may be shared.
    bad = bad + check("credentialed GET", probe(p, "/auth-private", "x", auth), "MISS 3 GET /auth-private HTTP/1.1 ${up}")
    bad = bad + check("then an anonymous GET is not served it", probe(p, "/auth-private", "x", ""), "MISS 4 GET /auth-private HTTP/1.1 ${up}")
    // Authorization and `Cache-Control: public`: stored, as RFC 9111 allows.
    bad = bad + check("credentialed GET of a public answer", probe(p, "/auth-public", "x", auth), "MISS 5 GET /auth-public HTTP/1.1 ${up}")
    bad = bad + check("then it hits", probe(p, "/auth-public", "x", ""), "HIT 5 GET /auth-public HTTP/1.1 ${up}")
    // Set-Cookie: never stored.
    bad = bad + check("answer with Set-Cookie", probe(p, "/cookie", "x", ""), "MISS 6 GET /cookie HTTP/1.1 ${up}")
    bad = bad + check("then it is not replayed", probe(p, "/cookie", "x", ""), "MISS 7 GET /cookie HTTP/1.1 ${up}")
    stop(s, pool, opts, cache, srv)

    // preserve_host: the upstream answers by Host, and so does the key.
    s2, pool2, opts2, cache2, srv2 = start(2, 1)
    p2 = http.server_port(s2)
    bad = bad + check("Host a", probe(p2, "/h", "a.example", ""), "MISS 1 GET /h HTTP/1.1 host=a.example")
    bad = bad + check("Host b misses", probe(p2, "/h", "b.example", ""), "MISS 2 GET /h HTTP/1.1 host=b.example")
    bad = bad + check("Host a again hits", probe(p2, "/h", "a.example", ""), "HIT 1 GET /h HTTP/1.1 host=a.example")
    stop(s2, pool2, opts2, cache2, srv2)

    if bad > 0 {
        println("FAIL: ${bad} case(s)")
        exit(1)
    }
    println("All PASS")
}
