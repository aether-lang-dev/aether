// The server for http_server_h2_limits (#3738): HTTP/2 on with no stream
// count given, and a body limit of 20000 bytes. POST /len answers with the
// length of the body. Prints "NO_H2" and exits when the build has no
// libnghttp2, which the driver reports as a skip.

import std.http

extern exit(code: int)

len_handler(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    http.http_response_set_status(res, 200)
    http.http_response_set_body(res, "len=${http.request_body_length(req)}")
}

message StartSrv { raw: ptr }
actor SrvActor {
    state s = 0
    receive { StartSrv(raw) -> { s = raw; _ = http.server_start(raw) } }
}

main() {
    raw = http.server_create(0)
    if raw == 0 { println("FAIL: server_create"); exit(1) }
    http.server_set_host(raw, "127.0.0.1")
    herr = http.server_set_h2(raw, 0)
    if herr != "" {
        println("NO_H2 ${herr}")
        exit(0)
    }
    merr = http.server_set_max_body(raw, 20000)
    if merr != "" { println("FAIL: server_set_max_body: ${merr}"); exit(1) }
    http.http_server_post(raw, "/len", len_handler, null)
    if http.server_bind(raw, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    println("READY ${http.server_port(raw)}")

    a = spawn(SrvActor())
    a ! StartSrv { raw: raw }

    sleep(60000)
    exit(0)
}
