// The client half: dial the echo peer, round-trip a message, close.
import std.http
import std.os
import std.string

extern exit(code: int)
extern aether_caps_used_bytes() -> long

main() {
    w = http.ws_connect("ws://127.0.0.1:${os_getenv("AE_TEST_PORT")}/echo")
    if w == null {
        println("FAIL: ws_connect returned null")
        exit(1)
    }

    // Send a message the server will echo back with a prefix. Non-ASCII and
    // a length past the 125-byte short-frame boundary are deliberately NOT
    // used here: this proves the handshake and the mask, and a longer frame
    // belongs in its own case once this is trusted.
    rc = http.ws_send_text(w, "hello from the client")
    if rc < 0 {
        println("FAIL: ws_send_text returned ${rc}")
        exit(1)
    }

    kind = http.ws_recv(w)
    if kind != 1 {
        println("FAIL: ws_recv returned ${kind}, want 1 (text)")
        exit(1)
    }

    got = http.ws_message(w)
    want = "echo: hello from the client"
    if string.compare(got, want) != 0 {
        println("FAIL: got [${got}] want [${want}]")
        exit(1)
    }

    http.ws_close(w, 1000, "done")
    http.ws_client_free(w)
    println("PASS: ws round-trip")

    // #3758: a client handle's message buffer is grown through the runtime's
    // capped allocator, and ws_client_free released it with plain free(), so
    // the cap's byte counter kept every freed handle's buffer: a program
    // under a memory cap ran into it holding nothing. Each handle here
    // receives a message, which grows its buffer, and is freed; the counter
    // must end where it started.
    before = aether_caps_used_bytes()
    i = 0
    while i < 20 {
        c = http.ws_connect("ws://127.0.0.1:${os_getenv("AE_TEST_PORT")}/echo")
        if c == null {
            println("FAIL: ws_connect ${i} returned null")
            exit(1)
        }
        http.ws_send_text(c, "round ${i}")
        if http.ws_recv(c) != 1 {
            println("FAIL: ws_recv ${i}")
            exit(1)
        }
        http.ws_close(c, 1000, "done")
        http.ws_client_free(c)
        i = i + 1
    }
    after = aether_caps_used_bytes()
    if after != before {
        println("FAIL: the capped allocator counts ${after - before} bytes after 20 handles were freed")
        exit(1)
    }
    println("PASS: ws_client_free returns the message buffer to the cap")
    exit(0)
}
