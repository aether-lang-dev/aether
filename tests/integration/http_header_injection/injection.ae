// A CR LF in anything that is written into a head must not become a new line
// of that head. Four ways in: a header value, a header name, the URL, which
// lands in the request line, and the content type given with a body.

import std.http
import std.http.client
import std.io
import std.string

extern exit(code: int)

main() {
    port = io.getenv("UPSTREAM_PORT")
    if port == 0 {
        println("FAIL: UPSTREAM_PORT not set")
        exit(1)
    }
    base = "http://127.0.0.1:${port}/"

    // 1. A value carrying a line ending is refused, and the request still goes.
    req = client.request("GET", base)
    client.set_timeout(req, 5s)
    rc = client.set_header(req, "X-Probe", "ok\r\nX-Injected: yes")
    if rc == 0 {
        println("FAIL: set_header accepted a value containing CRLF")
        exit(1)
    }
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        println("FAIL: transport ${err}")
        exit(1)
    }
    head = string.concat(client.response_body(resp), "")
    client.response_free(resp)
    if string.contains(head, "X-Injected") != 0 {
        println("FAIL: an injected header reached the wire. Head was:")
        println(head)
        exit(1)
    }

    // 2. A name that is not a token is refused.
    req2 = client.request("GET", base)
    rc2 = client.set_header(req2, "X-Bad\r\nX-Injected", "v")
    client.request_free(req2)
    if rc2 == 0 {
        println("FAIL: set_header accepted a name containing CRLF")
        exit(1)
    }

    // 3. A URL carrying a line ending never builds a request at all.
    req3 = client.request("GET", "${base}a\r\nX-Injected: yes\r\n")
    if req3 != null {
        println("FAIL: request() accepted a URL containing CRLF")
        exit(1)
    }

    // 4. A content type given with a body is a header value too (#3741). The
    // request refuses it and keeps no body; sent anyway, its head carries no
    // injected line.
    req4 = client.request("POST", base)
    client.set_timeout(req4, 5s)
    rc4 = client.set_body(req4, string.bytes("payload"), "text/plain\r\nX-Injected: yes")
    if rc4 == "" {
        println("FAIL: set_body accepted a content type containing CRLF")
        exit(1)
    }
    resp4, err4 = client.send_request(req4)
    client.request_free(req4)
    if err4 != "" {
        println("FAIL: transport ${err4}")
        exit(1)
    }
    head4 = string.concat(client.response_body(resp4), "")
    client.response_free(resp4)
    if string.contains(head4, "X-Injected") != 0 {
        println("FAIL: a content type injected a header. Head was:")
        println(head4)
        exit(1)
    }

    // 5. http.post and http.put fail with such a content type rather than
    // sending the request, with or without its body.
    pbody, perr = http.post(base, "payload", "text/plain\r\nX-Injected: yes")
    if perr == "" {
        println("FAIL: http.post sent a request with a CRLF content type. Head was:")
        println(pbody)
        exit(1)
    }
    ubody, uerr = http.put(base, "payload", "text/plain\r\nX-Injected: yes")
    if uerr == "" {
        println("FAIL: http.put sent a request with a CRLF content type. Head was:")
        println(ubody)
        exit(1)
    }

    // 6. client.post_with_status reports the refusal too.
    sbody, sstatus, serr = client.post_with_status(base, "payload", "text/plain\r\nX-Injected: yes")
    if serr == "" {
        println("FAIL: post_with_status sent a request with a CRLF content type (status ${sstatus}). Body was:")
        println(sbody)
        exit(1)
    }

    println("PASS: header value, header name, URL and content type all refuse a line ending")
}
