import std.http1
import std.bytes
import std.string
import std.io
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int
extern string_concat(a: string, b: string) -> string @heap
// Build a bytes buffer from a string (CRLF written as \r\n literally).
fn sb(s: string) -> ptr { n = string_length(s); b = bytes.new(n); if n > 0 { bytes.set(b, n - 1, 0) } i = 0
    while i < n { bytes.set(b, i, string_char_at_n(s, n, i) & 0xFF); i = i + 1 } return b }
fn body_str(r: ptr) -> string {
    return bytes.string_from_slice(http1.body(r))
}
// 1 when `msg`, all of it fed at once, is refused as malformed rather than
// framed or waited on.
fn refused(label: string, msg: string) -> int {
    r = http1.response_new()
    m = sb(msg)
    e = http1.feed(r, bytes.view(m), 0)
    got = 0
    if string.equals(e, "") != 1 && string.equals(e, "incomplete") != 1 { got = 1 }
    if got == 1 { println("ok   refused: ${label}") } else { println("FAIL not refused: ${label} (err='${e}')") }
    http1.response_free(r)
    bytes.free(m)
    return got
}
// 1 when `msg`, the response to a `method` request fed at once with more to
// come, is complete with status `status` and no body.
fn no_body(label: string, method: string, msg: string, status: int) -> int {
    r = http1.response_new_for(method)
    m = sb(msg)
    e = http1.feed(r, bytes.view(m), 0)
    got = 0
    if string.equals(e, "") == 1 && http1.status_code(r) == status && http1.body(r).len == 0 { got = 1 }
    if got == 1 { println("ok   no body: ${label}") } else { println("FAIL body framed: ${label} (err='${e}' status=${http1.status_code(r)} body='${body_str(r)}')") }
    http1.response_free(r)
    bytes.free(m)
    return got
}
main() {
    ok = 1

    // 1. Content-Length body, all in one feed.
    r1 = http1.response_new()
    msg1 = sb("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello")
    e1 = http1.feed(r1, bytes.view(msg1), 0)
    if string.equals(e1, "") == 1 && http1.status_code(r1) == 200 && string.equals(body_str(r1), "hello") == 1 {
        ct = http1.header(r1, "Content-Type")
        if string.equals(ct, "text/plain") == 1 { println("ok   content-length + header lookup") } else { println("FAIL header ct='${ct}'"); ok = 0 }
        string.free(ct)
    } else { println("FAIL content-length: status=${http1.status_code(r1)} body='${body_str(r1)}' err='${e1}'"); ok = 0 }
    http1.response_free(r1)
    bytes.free(msg1)

    // 2. Content-Length split across TWO feeds (boundary mid-body).
    r2 = http1.response_new()
    a = sb("HTTP/1.1 200 OK\r\nContent-Length: 11\r\n\r\nhel")
    b = sb("lo world")
    http1.feed(r2, bytes.view(a), 0) // incomplete
    e2 = http1.feed(r2, bytes.view(b), 0)
    if string.equals(e2, "") == 1 && string.equals(body_str(r2), "hello world") == 1 { println("ok   content-length split across feeds") } else { println("FAIL split body='${body_str(r2)}' err='${e2}'"); ok = 0 }
    http1.response_free(r2)
    bytes.free(a); bytes.free(b)

    // 3. Chunked body.
    r3 = http1.response_new()
    // "Wiki" + "pedia " + "in chunks." classic example
    ch = sb("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n6\r\npedia \r\nE\r\nin \r\n\r\nchunks.\r\n0\r\n\r\n")
    e3 = http1.feed(r3, bytes.view(ch), 0)
    // decoded = "Wiki"+"pedia "+"in \r\n\r\nchunks." = 24 bytes (chunk data may itself contain CRLF)
    b3 = http1.body(r3)
    chunk_ok = 1
    if string.equals(e3, "") != 1 { chunk_ok = 0 }
    if b3.len != 24 { chunk_ok = 0 } else {
        if b3[0] != 87 { chunk_ok = 0 } // 'W'
        if b3[23] != 46 { chunk_ok = 0 } // '.'
    }
    if chunk_ok == 1 { println("ok   chunked decode (24 bytes, data with embedded CRLF)") } else { println("FAIL chunked len=${b3.len} err='${e3}'"); ok = 0 }
    http1.response_free(r3)
    bytes.free(ch)

    // 4. Close-delimited (no length): completes only on EOF.
    r4 = http1.response_new()
    c1 = sb("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nbody-until-")
    c2 = sb("close")
    http1.feed(r4, bytes.view(c1), 0) // incomplete (no eof)
    e4 = http1.feed(r4, bytes.view(c2), 1) // eof=1 -> complete
    if string.equals(e4, "") == 1 && string.equals(body_str(r4), "body-until-close") == 1 { println("ok   close-delimited body") } else { println("FAIL close body='${body_str(r4)}' err='${e4}'"); ok = 0 }
    http1.response_free(r4)
    bytes.free(c1); bytes.free(c2)

    // 5. Headers split from body across feeds (boundary inside headers).
    r5 = http1.response_new()
    h1 = sb("HTTP/1.1 404 Not Found\r\nContent-Len")
    h2 = sb("gth: 3\r\n\r\n404")
    http1.feed(r5, bytes.view(h1), 0)
    e5 = http1.feed(r5, bytes.view(h2), 0)
    if string.equals(e5, "") == 1 && http1.status_code(r5) == 404 && string.equals(body_str(r5), "404") == 1 { println("ok   header boundary split across feeds") } else { println("FAIL split-header status=${http1.status_code(r5)} body='${body_str(r5)}'"); ok = 0 }
    http1.response_free(r5)
    bytes.free(h1); bytes.free(h2)

    // 6. Chunked incomplete then completed.
    r6 = http1.response_new()
    p1 = sb("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel")
    i6 = http1.feed(r6, bytes.view(p1), 0)
    p2 = sb("lo\r\n0\r\n\r\n")
    e6 = http1.feed(r6, bytes.view(p2), 0)
    if string.equals(i6, "incomplete") == 1 && string.equals(e6, "") == 1 && string.equals(body_str(r6), "hello") == 1 { println("ok   chunked resumes across feeds") } else { println("FAIL chunked-resume i='${i6}' e='${e6}' body='${body_str(r6)}'"); ok = 0 }
    http1.response_free(r6)
    bytes.free(p1); bytes.free(p2)

    // 7. Framing numbers are read whole, by std.net's rules (#3520): the
    // Content-Length reader skipped any byte that was not a digit, and the
    // chunk-size reader stopped at the first one that was not hex and
    // wrapped past the largest int. Each of these framed a body.
    ok = ok & refused("a Content-Length with letters in it", "HTTP/1.1 200 OK\r\nContent-Length: 5abc\r\n\r\nhello")
    ok = ok & refused("a signed Content-Length", "HTTP/1.1 200 OK\r\nContent-Length: +5\r\n\r\nhello")
    ok = ok & refused("a Content-Length past the largest int", "HTTP/1.1 200 OK\r\nContent-Length: 4294967301\r\n\r\nhello")
    ok = ok & refused("a Content-Length padded with zeros", "HTTP/1.1 200 OK\r\nContent-Length: 000000000005\r\n\r\nhello")
    ok = ok & refused("a chunk size written 0x5", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0x5\r\nhello\r\n0\r\n\r\n")
    ok = ok & refused("a chunk size past the largest int", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n100000005\r\nhello\r\n0\r\n\r\n")
    ok = ok & refused("a chunk size with a stray byte after it", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5 x\r\nhello\r\n0\r\n\r\n")
    ok = ok & refused("a CR inside a chunk extension", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5;a\rb\r\nhello\r\n0\r\n\r\n")
    ok = ok & refused("chunk data not followed by CRLF", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhelXY0\r\n\r\n")

    // The status code is exactly three digits (RFC 9112 4), and two
    // Content-Length headers that disagree have not said where the body ends
    // (RFC 9112 6.3). The reader took 2000 and 2x0 (as 20) for statuses and
    // framed the body by the first of two lengths.
    ok = ok & refused("a four-digit status code", "HTTP/1.1 2000 OK\r\nContent-Length: 5\r\n\r\nhello")
    ok = ok & refused("a status code with a letter in it", "HTTP/1.1 2x0 OK\r\nContent-Length: 5\r\n\r\nhello")
    ok = ok & refused("two Content-Length headers that disagree", "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello!")
    r9 = http1.response_new()
    m9 = sb("HTTP/1.1 200\r\nContent-Length: 5\r\ncontent-length: 5\r\n\r\nhello")
    e9 = http1.feed(r9, bytes.view(m9), 0)
    if string.equals(e9, "") == 1 && http1.status_code(r9) == 200 && string.equals(body_str(r9), "hello") == 1 { println("ok   agreeing duplicate lengths, a status line without a reason") } else { println("FAIL duplicates err='${e9}' status=${http1.status_code(r9)}"); ok = 0 }
    http1.response_free(r9)
    bytes.free(m9)

    // 9. A 1xx, 204 or 304 response, and any response to HEAD, ends at its
    // header section whatever its headers say (RFC 9110 6.4.1), as std.net
    // reads one. The reader took the 204's Content-Length for a body of
    // "hello", and waited for the others' bodies, or for the connection to
    // close, with the response already complete.
    ok = ok & no_body("a 204 with a Content-Length", "GET", "HTTP/1.1 204\r\nContent-Length: 5\r\ncontent-length: 5\r\n\r\nhello", 204)
    ok = ok & no_body("a 204 sent chunked", "GET", "HTTP/1.1 204 No Content\r\nTransfer-Encoding: chunked\r\n\r\n", 204)
    ok = ok & no_body("a 100 Continue", "GET", "HTTP/1.1 100 Continue\r\n\r\n", 100)
    ok = ok & no_body("a 103 with headers", "GET", "HTTP/1.1 103 Early Hints\r\nLink: </s.css>; rel=preload\r\n\r\n", 103)
    ok = ok & no_body("a 304 with a Content-Length", "GET", "HTTP/1.1 304 Not Modified\r\nContent-Length: 1234\r\n\r\n", 304)
    ok = ok & no_body("a 200 to HEAD with a Content-Length", "HEAD", "HTTP/1.1 200 OK\r\nContent-Length: 1234\r\n\r\n", 200)
    ok = ok & no_body("a 200 to HEAD sent chunked", "HEAD", "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", 200)
    // A length past what a body read could hold says only how long the
    // resource is: a HEAD of a file over 2 GiB, a 304 of one.
    ok = ok & no_body("a 200 to HEAD of a file over 2 GiB", "HEAD", "HTTP/1.1 200 OK\r\nContent-Length: 3000000000\r\n\r\n", 200)
    ok = ok & no_body("a 304 of a file over 2 GiB", "GET", "HTTP/1.1 304 Not Modified\r\nContent-Length: 3000000000\r\n\r\n", 304)
    // As std.net reads it, a length that is not one is refused even here.
    ok = ok & refused("a 204 with two lengths that disagree", "HTTP/1.1 204\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\n")
    ok = ok & refused("a 204 with a length that is no number", "HTTP/1.1 204\r\nContent-Length: 5x\r\n\r\n")
    // The same 200 to a GET still waits for its body.
    rg = http1.response_new_for("GET")
    mg = sb("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n")
    eg = http1.feed(rg, bytes.view(mg), 0)
    if string.equals(eg, "incomplete") == 1 { println("ok   a 200 to GET waits for its body") } else { println("FAIL a 200 to GET err='${eg}'"); ok = 0 }
    http1.response_free(rg)
    bytes.free(mg)

    // 8. Chunk extensions are read, then ignored (RFC 9112 7.1).
    r8 = http1.response_new()
    m8 = sb("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5 ; name=value\r\nhello\r\n6;q=\"a \\\" b\";flag\r\n world\r\n0;last\r\n\r\n")
    e8 = http1.feed(r8, bytes.view(m8), 0)
    if string.equals(e8, "") == 1 && string.equals(body_str(r8), "hello world") == 1 { println("ok   chunk extensions read and ignored") } else { println("FAIL chunk extensions err='${e8}' body='${body_str(r8)}'"); ok = 0 }
    http1.response_free(r8)
    bytes.free(m8)

    if ok == 1 { println("http1: all checks pass") } else { println("http1: FAILURES"); exit(1) }
}
extern exit(code: int)
