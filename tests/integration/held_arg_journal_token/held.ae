// A string read from a field, passed to a call, is held for the call (R3):
// a reference taken, the place journaled for a panic, forgotten and the
// reference released after it. #3840: the journal says whether it wrote the
// entry, and the forget runs only then. Outside every `try` nothing is
// written; inside one the entry is written and forgotten after the call;
// a callee that panics leaves the drain to release the hold.

import std.string

extern exit(code: int)

struct Box {
    name: string
}

keep(s: string) -> int {
    return string.length(s)
}

boom(s: string) -> int {
    if string.length(s) > 3 {
        panic("boom ${s}")
    }
    return 1
}

apply(f: fn, s: string) -> int {
    return call(f, s)
}

main() {
    b = Box { name: string.concat("held", "-name") }
    total = 0
    i = 0
    while i < 1000 {
        total = total + keep(b.name)
        total = total + apply(| s: string | { return string.length(s) + 1 }, b.name)
        i = i + 1
    }
    caught = 0
    i = 0
    while i < 200 {
        try {
            total = total + keep(b.name)
            total = total + apply(| s: string | { return string.length(s) + 1 }, b.name)
            total = total + boom(b.name)
        } catch e {
            if e != "boom held-name" {
                println("FAIL: caught '${e}'")
                exit(1)
            }
            caught = caught + 1
        }
        i = i + 1
    }
    println("${total} ${caught} ${b.name}")
}
