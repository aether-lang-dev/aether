// Fixture for the cross-host redirect check.
//
// One server, three routes. /start redirects to the SAME port under a
// different host name, which is the change std.http.client acts on: it
// compares the parsed host of each hop and drops Authorization, Cookie and
// Proxy-Authorization when it differs. /same redirects under the identical
// name as a control. /landing reports which of them survived.
//
// Bound to 127.0.0.1, which both names reach wherever "localhost" resolves
// to it; loopback only, since a listener on every interface opens a firewall
// prompt on Windows (#2639). The driver checks that "localhost" is actually
// usable before asserting anything, because a host that resolves it to ::1
// alone would fail to connect and say nothing about header stripping.

import std.http

extern exit(code: int)
extern http_server_start_raw(server: ptr) -> int
extern http_server_bind_raw(server: ptr, host: string, port: int) -> int
extern http_server_port(server: ptr) -> int

// The redirect targets name this server's OWN port, and it now binds port 0,
// so the port is only known after the bind. Held here so the handlers can
// build the Location header from it.
var g_port: int = 0

redirect_handler(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 302)
    http.response_set_header(res, "Location",
        "http://localhost:${g_port}/landing")
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "moved\n")
}

// Same-name hop, the control: the credentials must survive this one.
same_host_handler(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 302)
    http.response_set_header(res, "Location",
        "http://127.0.0.1:${g_port}/landing")
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "moved\n")
}

echo_handler(req: ptr, res: ptr, ud: ptr) {
    // An absent header comes back as null, not "" — comparing against the
    // empty string reports every absent header as present.
    auth = http.get_header(req, "Authorization")
    cookie = http.get_header(req, "Cookie")
    body = "auth=present"
    if auth == null {
        body = "auth=absent"
    }
    if cookie == null {
        body = "${body} cookie=absent"
    } else {
        body = "${body} cookie=present"
    }
    http.response_set_status(res, 200)
    http.response_set_header(res, "Content-Type", "text/plain")
    http.response_set_body(res, "${body}\n")
}

main() {
    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    http.server_get(s, "/start", redirect_handler, 0)
    http.server_get(s, "/same", same_host_handler, 0)
    http.server_get(s, "/landing", echo_handler, 0)
    // #1920: bind on port 0 so the kernel picks a free one, and report it.
    // server_start reuses a socket the caller already bound, so this also
    // means READY is printed AFTER the listen socket exists rather than
    // before it, which is what the fixed sleep in the runner was covering.
    if http_server_bind_raw(s, "127.0.0.1", 0) < 0 {
        println("FAIL: bind")
        exit(1)
    }
    g_port = http_server_port(s)
    println("READY ${g_port}")
    http_server_start_raw(s)
    exit(0)
}
