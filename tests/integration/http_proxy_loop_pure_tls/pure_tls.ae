// A proxy gateway terminating TLS with the pure-Aether stack stays off the
// proxy event loop (#3256).
//
// The loop carries a client's TLS handshake through OpenSSL only. A server
// whose TLS is the pure-Aether stack (AETHER_PURE_TLS=1, or a build without
// OpenSSL) has no OpenSSL context for it, and on Linux and macOS the loop
// took its connections anyway: with OpenSSL it closed every one with nothing
// written, and without OpenSSL it read the TLS bytes as HTTP. Its
// connections are the worker path's, which runs the pure stack.
//
// A gateway set to pure TLS takes a connection; the loop must not have
// taken it, on any platform (Windows has no loop, and counts none). The
// handshake is not this test's business: the certificate is a self-signed one
// the test writes, and the worker path closes a connection that sends
// plain HTTP to a TLS port. The pure server is imported, as a program that
// uses it must (#1298), and its pair is real, since server_set_tls checks it
// (#3328). The servers listen on 127.0.0.1 and a port the kernel picks.

import std.cryptography.tls13_server
import std.fs
import std.http
import std.http.proxy
import std.os
import std.string
import std.tcp

extern exit(code: int)
extern http_server_evloop_connections(server: ptr) -> int

// A self-signed P-256 pair for localhost, good until 2126. server_set_tls
// checks the pair it is given (#3328), so the gateway needs real files.
fn test_cert() -> string {
    return "-----BEGIN CERTIFICATE-----\nMIIBlTCCATugAwIBAgIUTcmDMt5d7e0N56ALpyQQu9lFub8wCgYIKoZIzj0EAwIw\nFDESMBAGA1UEAwwJbG9jYWxob3N0MCAXDTI2MTAyODE4MDYxM1oYDzIxMjYxMDA0\nMTgwNjEzWjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIBBggqhkjO\nPQMBBwNCAASysB/pp9OO2HCoPvAPR6Bh2RMYwvQEaFPcYGah1XNuQV81ISkj0+li\nILe3MdnCkC2jiFoxIxO9pOfsKpMq+fA3o2kwZzAdBgNVHQ4EFgQUjNH0ltVjmUq2\nTbvlKu+ByFCh65MwHwYDVR0jBBgwFoAUjNH0ltVjmUq2TbvlKu+ByFCh65MwDwYD\nVR0TAQH/BAUwAwEB/zAUBgNVHREEDTALgglsb2NhbGhvc3QwCgYIKoZIzj0EAwID\nSAAwRQIhAJNTcbxDRkO9ST1q0UtHv+r2QlL2oJsUfmO7tDBjKw5gAiAocb88reSB\nW7SWl8242FJ4cD+7F1/bpwOVOboL1EKcQQ==\n-----END CERTIFICATE-----\n"
}

fn test_key() -> string {
    return "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgk2P0BnYO5mJHctnz\nIDF2r7nCNkL1tpLqIL6Jsr2wveShRANCAASysB/pp9OO2HCoPvAPR6Bh2RMYwvQE\naFPcYGah1XNuQV81ISkj0+liILe3MdnCkC2jiFoxIxO9pOfsKpMq+fA3\n-----END PRIVATE KEY-----\n"
}

handle_up(req: ptr, res: ptr, ud: ptr) {
    http.response_set_status(res, 200)
    http.response_set_body(res, "up")
}

start(server: ptr) -> int {
    if http.server_bind(server, "127.0.0.1", 0) != "" {
        println("FAIL: bind")
        exit(1)
    }
    err = http.server_start_background(server)
    if err != "" {
        println("FAIL: ${err}")
        exit(1)
    }
    return http.server_port(server)
}

main() {
    println("=== a pure-TLS proxy gateway stays off the event loop (#3256) ===")
    upstream = http.server_create(0)
    http.server_set_host(upstream, "127.0.0.1")
    http.server_get(upstream, "/p", handle_up, 0)
    up_url = "http://127.0.0.1:${start(upstream)}"

    serr = os.setenv("AETHER_PURE_TLS", "1")
    if serr != "" {
        println("FAIL: setenv: ${serr}")
        exit(1)
    }
    gateway = http.server_create(0)
    http.server_set_host(gateway, "127.0.0.1")
    merr = proxy.mount_simple(gateway, "/", up_url, 5)
    if merr != "" {
        println("FAIL: mount: ${merr}")
        exit(1)
    }
    dir, derr = fs.make_temp_dir("", "ae3256")
    if derr != "" {
        println("FAIL: temp dir: ${derr}")
        exit(1)
    }
    cert = "${dir}/cert.pem"
    key = "${dir}/key.pem"
    werr = fs.write(cert, test_cert())
    kerr = fs.write(key, test_key())
    if werr != "" || kerr != "" {
        println("FAIL: write the pair: ${werr}${kerr}")
        exit(1)
    }
    terr = http.server_set_tls(gateway, cert, key)
    if terr != "" {
        println("FAIL: server_set_tls: ${terr}")
        exit(1)
    }
    port = start(gateway)
    sleep(200)

    sock, cerr = tcp.connect("127.0.0.1", port)
    if cerr != "" {
        println("FAIL: connect: ${cerr}")
        exit(1)
    }
    tcp.write(sock, "GET /p HTTP/1.1\r\nHost: x\r\n\r\n")
    // Read until the server closes the connection, or two seconds.
    tries = 0
    while tries < 20 {
        ready, _perr = tcp.poll(sock, 100)
        if ready {
            chunk, rerr = tcp.read(sock, 4096)
            if rerr != "" || string.length(chunk) == 0 {
                tries = 20
            }
        }
        tries = tries + 1
    }
    tcp.close(sock)

    bad = 0
    taken = http_server_evloop_connections(gateway)
    if taken != 0 {
        println("  FAIL the event loop took the gateway's connection: ${taken}")
        bad = bad + 1
    } else {
        println("  PASS the event loop left the gateway's connection to the worker path")
    }

    http.server_stop(gateway)
    http.server_stop(upstream)
    http.server_free(gateway)
    http.server_free(upstream)
    fs.delete(cert)
    fs.delete(key)
    fs.delete_dir(dir)
    if bad > 0 {
        println("FAIL: ${bad} case(s)")
        exit(1)
    }
    println("All PASS")
}
