// A spawned child keeps only the parent's own standard streams (#3209).
//
// A child keeps fds 0, 1 and 2 even when the parent marked them
// close-on-exec, as Node does. When the parent has closed one of them, the
// next descriptor it opens takes that number: a pipe of another thread's
// spawn, say, which is close-on-exec. The child cleared the flag on that
// one too and held the other spawn's pipe open as its stdout, so that spawn
// waited for this child to exit. Only a descriptor that is still the file
// the stream was when the process started is the parent's stream now.
//
// shim.c puts the write end of a close-on-exec pipe on fd 1. A child that
// sleeps 3 s is spawned, and the parent closes its own write end: the read
// end sees EOF at once unless the child kept it.

import std.os
import std.list

extern stdio_slot_take() -> int
extern stdio_slot_child_kept(read_fd: int) -> int
extern exit(code: int)

main() {
    if os.platform() == "windows" {
        println("PASS (no fork on Windows)")
        return
    }
    read_fd = stdio_slot_take()
    if read_fd < 0 {
        println("FAIL: could not put a pipe on fd 1")
        exit(1)
    }
    argv = list.new()
    list.add(argv, "-c")
    list.add(argv, "sleep 3")
    tok, serr = os.spawn_proc("/bin/sh", argv, null)
    list.free(argv)
    kept = stdio_slot_child_kept(read_fd)
    if serr != "" {
        println("FAIL: spawn: ${serr}")
        exit(1)
    }
    _code, _werr = os.wait(tok)
    if kept != 0 {
        println("FAIL: the child kept a close-on-exec pipe end that took stdout's slot (${kept})")
        exit(1)
    }
    println("PASS")
}
