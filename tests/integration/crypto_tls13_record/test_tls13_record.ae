// Validate std.cryptography.tls13_record — the TLS 1.3 record protection
// layer (RFC 8446 §5.2). Offline: nonce-construction vectors, AAD assembly
// via a full seal->open round-trip, inner content-type recovery, tamper
// rejection, and sequence-number advance.

import std.cryptography.tls13_record
import std.bytes
import std.string
import std.io

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int
extern string_length(s: string) -> int

fn hexval(h: int) -> int {
    if h >= 48 && h <= 57 { return h - 48 }
    if h >= 97 && h <= 102 { return h - 87 }
    if h >= 65 && h <= 70 { return h - 55 }
    return 0
}
fn from_hex(s: string) -> ptr {
    slen = string_length(s)
    n = slen / 2
    b = bytes.new(n)
    if n == 0 { return b }
    i = 0
    while i < n {
        bytes.set(b, i, (hexval(string_char_at_n(s, slen, i * 2)) << 4) | hexval(string_char_at_n(s, slen, i * 2 + 1)))
        i = i + 1
    }
    return b
}
fn to_hex(b: ptr, n: int) -> string {
    hx = bytes.new(n * 2)
    i = 0
    while i < n {
        v = bytes.get(b, i)
        hi = (v >> 4) & 15
        lo = v & 15
        chi = 48 + hi
        if hi >= 10 { chi = 87 + hi }
        clo = 48 + lo
        if lo >= 10 { clo = 87 + lo }
        bytes.set(hx, i * 2, chi)
        bytes.set(hx, i * 2 + 1, clo)
        i = i + 1
    }
    return bytes.finish(hx, n * 2)
}
fn nonce_check(label: string, iv: ptr, seq: long, want: string) -> int {
    n = tls13_record.nonce_for(iv, seq)
    got = to_hex(n, 12)
    bytes.free(n)
    if got == want {
        println("ok   ${label}")
        return 1
    }
    println("FAIL ${label}: got ${got} want ${want}")
    return 0
}

main() {
    total_ok = 1

    // --- nonce construction (iv XOR seq, right-aligned big-endian) ---
    // Reference: iv=5d313eb2671276ee13000b30 (RFC 8448 §3 server iv).
    iv = from_hex("5d313eb2671276ee13000b30")
    if nonce_check("nonce seq=0",   iv, 0,   "5d313eb2671276ee13000b30") == 0 { total_ok = 0 }
    if nonce_check("nonce seq=1",   iv, 1,   "5d313eb2671276ee13000b31") == 0 { total_ok = 0 }
    if nonce_check("nonce seq=255", iv, 255, "5d313eb2671276ee13000bcf") == 0 { total_ok = 0 }
    if nonce_check("nonce seq=256", iv, 256, "5d313eb2671276ee13000a30") == 0 { total_ok = 0 }
    // seq = 0x0102030405060708
    if nonce_check("nonce seq=big", iv, 72623859790382856, "5d313eb2661075ea16060c38") == 0 { total_ok = 0 }
    bytes.free(iv)

    // --- seal -> open round-trip (ChaCha20-Poly1305 key/iv) ---
    key = from_hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    biv = from_hex("5d313eb2671276ee13000b30")
    sender = tls13_record.new(key, 32, biv)
    receiver = tls13_record.new(key, 32, biv)

    msg = from_hex("48656c6c6f2c20544c5320312e3321")   // "Hello, TLS 1.3!"
    rec = tls13_record.seal_record(sender, tls13_record.CONTENT_APPLICATION_DATA, msg, bytes.length(msg))

    // outer record header must be 0x17 0x0303 <len>
    if bytes.get(rec, 0) != 0x17 || bytes.get(rec, 1) != 0x03 || bytes.get(rec, 2) != 0x03 {
        println("FAIL record header not 17 0303"); total_ok = 0
    } else {
        println("ok   record header 0x17 0x0303")
    }

    opened = tls13_record.OpenedRecord { content_type: 0, plaintext: null, plaintext_len: 0 }
    oerr = tls13_record.open_record(receiver, rec, bytes.length(rec), &opened)
    if oerr != "" {
        println("FAIL open error: ${oerr}"); total_ok = 0
    } else {
        rt_ok = 1
        if opened.content_type != tls13_record.CONTENT_APPLICATION_DATA {
            println("FAIL content_type ${opened.content_type}"); rt_ok = 0
        }
        if opened.plaintext_len != bytes.length(msg) { println("FAIL pt_len"); rt_ok = 0 }
        if opened.plaintext != null {
            if to_hex(opened.plaintext, opened.plaintext_len) != to_hex(msg, bytes.length(msg)) {
                println("FAIL plaintext mismatch"); rt_ok = 0
            }
        } else {
            println("FAIL plaintext null"); rt_ok = 0
        }
        if rt_ok == 1 {
            println("ok   seal->open round-trip (content_type + plaintext)")
        } else {
            total_ok = 0
        }
    }
    if opened.plaintext != null { bytes.free(opened.plaintext) }

    // --- tamper: flip a ciphertext byte -> open must fail. Reset receiver seq
    //     by making a fresh receiver so the sequence matches record #0. ---
    receiver2 = tls13_record.new(key, 32, biv)
    bytes.set(rec, tls13_record.RECORD_HEADER_LEN + 2, (bytes.get(rec, tls13_record.RECORD_HEADER_LEN + 2) ^ 0x40) & 0xFF)
    opened2 = tls13_record.OpenedRecord { content_type: 0, plaintext: null, plaintext_len: 0 }
    terr = tls13_record.open_record(receiver2, rec, bytes.length(rec), &opened2)
    if terr == "" {
        println("FAIL tampered record accepted"); total_ok = 0
    } else {
        println("ok   tampered record rejected (${terr})")
    }
    if opened2.plaintext != null { bytes.free(opened2.plaintext) }

    // --- two records in sequence decrypt correctly (seq advances) ---
    s2 = tls13_record.new(key, 32, biv)
    r2 = tls13_record.new(key, 32, biv)
    m1 = from_hex("6669727374")   // "first"
    m2 = from_hex("7365636f6e64") // "second"
    rc1 = tls13_record.seal_record(s2, tls13_record.CONTENT_APPLICATION_DATA, m1, bytes.length(m1))
    rc2 = tls13_record.seal_record(s2, tls13_record.CONTENT_APPLICATION_DATA, m2, bytes.length(m2))
    o1 = tls13_record.OpenedRecord { content_type: 0, plaintext: null, plaintext_len: 0 }
    o2 = tls13_record.OpenedRecord { content_type: 0, plaintext: null, plaintext_len: 0 }
    e1 = tls13_record.open_record(r2, rc1, bytes.length(rc1), &o1)
    e2 = tls13_record.open_record(r2, rc2, bytes.length(rc2), &o2)
    seq_ok = 1
    if e1 != "" || e2 != "" { println("FAIL seq open err ${e1} ${e2}"); seq_ok = 0 }
    if o1.plaintext != null {
        if to_hex(o1.plaintext, o1.plaintext_len) != to_hex(m1, bytes.length(m1)) { seq_ok = 0 }
    }
    if o2.plaintext != null {
        if to_hex(o2.plaintext, o2.plaintext_len) != to_hex(m2, bytes.length(m2)) { seq_ok = 0 }
    }
    if seq_ok == 1 {
        println("ok   two-record sequence decrypts (seq advances)")
    } else {
        println("FAIL two-record sequence"); total_ok = 0
    }
    if o1.plaintext != null { bytes.free(o1.plaintext) }
    if o2.plaintext != null { bytes.free(o2.plaintext) }

    // --- AES-128-GCM AEAD selection round-trips (16-byte key) ---
    akey = bytes.new(16)
    ai = 0
    while ai < 16 { bytes.set(akey, ai, (ai * 13 + 5) & 0xFF); ai = ai + 1 }
    aiv = bytes.new(12)
    ai2 = 0
    while ai2 < 12 { bytes.set(aiv, ai2, (ai2 * 3 + 1) & 0xFF); ai2 = ai2 + 1 }
    asend = tls13_record.new_aead(tls13_record.AEAD_AES_128_GCM, akey, 16, aiv)
    arecv = tls13_record.new_aead(tls13_record.AEAD_AES_128_GCM, akey, 16, aiv)
    amsg = bytes.new(20)
    am = 0
    while am < 20 { bytes.set(amsg, am, 97 + (am % 26)); am = am + 1 }
    arec = tls13_record.seal_record(asend, tls13_record.CONTENT_APPLICATION_DATA, amsg, 20)
    ao = tls13_record.OpenedRecord { content_type: 0, plaintext: null, plaintext_len: 0 }
    aerr = tls13_record.open_record(arecv, arec, bytes.length(arec), &ao)
    aok = 1
    if string.equals(aerr, "") != 1 { aok = 0 }
    else {
        if ao.content_type != tls13_record.CONTENT_APPLICATION_DATA { aok = 0 }
        if ao.plaintext_len != 20 { aok = 0 }
        if aok == 1 {
            if to_hex(ao.plaintext, 20) != to_hex(amsg, 20) { aok = 0 }
        }
    }
    if aok == 1 {
        println("ok   AES-128-GCM record round-trips (16-byte key)")
    } else {
        println("FAIL AES-128-GCM record round-trip"); total_ok = 0
    }
    if ao.plaintext != null { bytes.free(ao.plaintext) }
    tls13_record.free_ctx(asend)
    tls13_record.free_ctx(arecv)
    bytes.free(akey); bytes.free(aiv); bytes.free(amsg); bytes.free(arec)

    tls13_record.free_ctx(sender)
    tls13_record.free_ctx(receiver)
    tls13_record.free_ctx(receiver2)
    tls13_record.free_ctx(s2)
    tls13_record.free_ctx(r2)
    bytes.free(key)
    bytes.free(biv)
    bytes.free(msg)
    bytes.free(rec)
    bytes.free(m1)
    bytes.free(m2)
    bytes.free(rc1)
    bytes.free(rc2)

    if total_ok == 0 {
        println("tls13_record: FAILURES")
        exit(1)
    }
    println("tls13_record: all checks pass")
}
