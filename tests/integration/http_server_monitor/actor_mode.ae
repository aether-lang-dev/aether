// The monitor in actor dispatch mode (#3131). A server whose connections go
// to actors starts on a path of its own, and its monitor's events fire there
// as on the thread-pool path: listening once it accepts connections, stopped
// once it stops. The lifecycle hooks this replaced never fired on it.
//
// actor_shim.c switches the mode, which has no Aether surface; the driving
// shell test builds the two together.

import std.http
import std.sync

extern monitor_actor_mode(server: ptr) -> int
extern http_server_port(server: ptr) -> int
extern sleep(ms: int)
extern exit(code: int)

main() {
    // The closures run on the server's thread and this one polls what they
    // set: std.sync cells, not refs, whose plain memory raced (#3542).
    heard_port = sync.atomic_new(0)
    defer sync.atomic_free(heard_port)
    heard_stop = sync.atomic_new(0)
    defer sync.atomic_free(heard_stop)

    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    http.monitor(s) {
        listening() | host: string, port: int | { sync.atomic_store(heard_port, port) }
        stopped() | host: string, port: int | { _ = sync.atomic_add(heard_stop, 1) }
    }
    if monitor_actor_mode(s) != 0 { println("SKIP actor dispatch mode is POSIX-only"); exit(0) }
    berr = http.server_bind(s, "127.0.0.1", 0)
    if berr != "" { println("FAIL bind: ${berr}"); exit(1) }
    port = http_server_port(s)
    if http.server_start_background(s) != "" { println("FAIL start_background"); exit(1) }

    waited = 0
    while sync.atomic_load(heard_port) == 0 && waited < 250 {
        sleep(20)
        waited = waited + 1
    }
    if sync.atomic_load(heard_port) != port {
        println("FAIL listening reported port ${sync.atomic_load(heard_port)}, the server is on ${port}")
        exit(1)
    }
    http.server_stop(s)
    if sync.atomic_load(heard_stop) != 1 {
        println("FAIL stopped fired ${sync.atomic_load(heard_stop)} times after the stop, expected 1")
        exit(1)
    }
    http.server_free(s)
    println("ACTOR-MONITOR-OK")
}
