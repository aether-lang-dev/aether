// The server's monitor (#3131): a program learns what the server has to say
// through closures it registers, and the server prints nothing itself.
//
//   1. A monitor block's listening closure gets the host and the bound port,
//      and its stopped closure fires once the server stops.
//   2. A bind that fails returns its reason ("cannot bind 127.0.0.1:<port>:
//      ..."), where it used to print it and return "bind failed".
//
// The driving shell test also checks that nothing reaches stdout but this
// program's own lines.

import std.http
import std.sync
import std.string

extern http_server_port(server: ptr) -> int
extern sleep(ms: int)
extern exit(code: int)

main() {
    failures = 0
    // The listening closure runs on the server's thread and this one polls
    // what it sets: std.sync cells, not refs, whose plain memory raced (#3542).
    heard_port = sync.atomic_new(0)
    defer sync.atomic_free(heard_port)
    heard_host = sync.atomic_new(0)
    defer sync.atomic_free(heard_host)
    heard_stop = sync.atomic_new(0)
    defer sync.atomic_free(heard_stop)

    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    http.monitor(s) {
        listening() | host: string, port: int | {
            sync.atomic_store(heard_port, port)
            if host == "127.0.0.1" { sync.atomic_store(heard_host, 1) }
        }
        stopped() | host: string, port: int | {
            _ = sync.atomic_add(heard_stop, 1)
        }
    }
    berr = http.server_bind(s, "127.0.0.1", 0)
    if berr != "" { println("FAIL bind: ${berr}"); exit(1) }
    port = http_server_port(s)
    if http.server_start_background(s) != "" { println("FAIL start_background"); exit(1) }

    waited = 0
    while sync.atomic_load(heard_port) == 0 && waited < 100 {
        sleep(20)
        waited = waited + 1
    }
    if sync.atomic_load(heard_port) != port {
        println("FAIL listening reported port ${sync.atomic_load(heard_port)}, the server is on ${port}")
        failures = failures + 1
    }
    if sync.atomic_load(heard_host) != 1 {
        println("FAIL listening did not report host 127.0.0.1")
        failures = failures + 1
    }

    // A second server on the same port: the reason comes back, not a print.
    t = http.server_create(port)
    terr = http.server_bind(t, "127.0.0.1", port)
    want = "cannot bind 127.0.0.1:${port}: "
    if string.starts_with(terr, want) == 0 {
        println("FAIL a taken port gave '${terr}', expected it to start '${want}'")
        failures = failures + 1
    }
    if http.server_error(t) != terr {
        println("FAIL server_error disagrees with server_bind's error")
        failures = failures + 1
    }
    http.server_free(t)

    if sync.atomic_load(heard_stop) != 0 {
        println("FAIL stopped fired while the server was running")
        failures = failures + 1
    }
    http.server_stop(s)
    if sync.atomic_load(heard_stop) != 1 {
        println("FAIL stopped fired ${sync.atomic_load(heard_stop)} times after the stop, expected 1")
        failures = failures + 1
    }
    http.server_free(s)

    if failures > 0 { exit(1) }
    println("MONITOR-OK")
}
