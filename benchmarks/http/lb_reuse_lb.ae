// The load balancer under measurement. BACKENDS and PORT come from the
// environment; NO_UPSTREAM_REUSE=1 turns the client's connection pool off so
// the same binary measures both sides of the comparison.

import std.http
import std.http.server.lb
import std.io
import std.string

main() {
    port_s = io.getenv("PORT")
    backends = io.getenv("BACKENDS")
    if port_s == 0 || backends == 0 {
        println("PORT and BACKENDS must be set")
        return
    }
    no_reuse = io.getenv("NO_UPSTREAM_REUSE")
    if no_reuse != 0 && string.length(no_reuse) > 0 {
        http.client_pool_disable()
    }
    // TLS_CERT/TLS_KEY turn the listener into a TLS terminator, so the same
    // binary measures the cleartext and the TLS path.
    cert = io.getenv("TLS_CERT")
    key = io.getenv("TLS_KEY")
    err = ""
    if cert != 0 && string.length(cert) > 0 && key != 0 && string.length(key) > 0 {
        err = lb.serve_tls("127.0.0.1", string.get_int(port_s), "round_robin", backends,
            cert, key, lb.no_health(), lb.no_breaker(), lb.no_cache())
    } else {
        err = lb.serve("127.0.0.1", string.get_int(port_s), "round_robin", backends,
            lb.no_health(), lb.no_breaker(), lb.no_cache())
    }
    if err != "" {
        println("lb: ${err}")
    }
}
