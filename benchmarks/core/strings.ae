// std.string hot paths (#3518): concatenation, interpolation, substring,
// search through a long text and splitting a long line.
//
// Prints `row <name> <value> <unit>` lines for benchmarks/core/run.ae.

import std.os
import std.string

per_op(t0: long, t1: long, n: int) -> float {
    return (t1 - t0) as float / n as float
}

struct Holder {
    name: string
}

// Reads nothing of its argument: the row is the hold around the call.
held_len(s: string) -> int {
    return 1
}

main() {
    n = 2000000
    total = 0

    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        s = string.concat("ab", "cd")
        t = string.concat(s, "ef")
        total = total + string.length(t)
        i = i + 1
    }
    println("row string_concat ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        s = "item ${i} of ${n}"
        total = total + string.length(s)
        i = i + 1
    }
    println("row string_interp ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        s = string.substring("the quick brown fox jumps over the lazy dog", 4, 19)
        total = total + string.length(s)
        i = i + 1
    }
    println("row string_substring ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    // #3830: an int's decimal text.
    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        s = string.from_int((i % 100000) * 7919 - 1000000)
        total = total + string.length(s)
        i = i + 1
    }
    println("row string_from_int ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    // #3828: a float with no fraction, interpolated.
    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        x = (i % 100000) as float
        s = "x=${x}"
        total = total + string.length(s)
        i = i + 1
    }
    println("row interp_float_integral ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    // A 256 KiB text with the needle only at its end.
    text = "abcdefghijklmnop"
    k = 0
    while k < 14 {
        text = string.concat(text, text)
        k = k + 1
    }
    text = string.concat(text, "needle")
    searches = 400
    t0 = os.now_monotonic_ns()
    i = 0
    while i < searches {
        total = total + string.index_of(text, "needle")
        i = i + 1
    }
    println("row string_index_of_256k ${per_op(t0, os.now_monotonic_ns(), searches) / 1000.0} us/search")

    // A line of 2000 comma separated fields.
    line = "field"
    k = 0
    while k < 1999 {
        line = string.concat(line, ",field")
        k = k + 1
    }
    splits = 2000
    t0 = os.now_monotonic_ns()
    i = 0
    while i < splits {
        parts = string.split(line, ",")
        total = total + string.array_size(parts)
        string.array_free(parts)
        i = i + 1
    }
    println("row string_split_2000 ${per_op(t0, os.now_monotonic_ns(), splits) / 1000.0} us/split")

    // #3836: a byte scan, the loop a hand-written parser runs: a length and
    // a char_at per character, over a 132-character line. A counted string,
    // as one read from a file or a socket is (a literal carries no length,
    // and each read of it would be a strlen).
    scan = string.concat("GET /index.html?query=abc&page=2 HTTP/1.1, Host: example.org, ",
                         "Accept: */*, User-Agent: bench/1.0, Connection: keep-alive, X-Id: 1234")
    scans = 200000
    t0 = os.now_monotonic_ns()
    i = 0
    while i < scans {
        j = 0
        while j < string.length(scan) {
            total = total + string.char_at(scan, j)
            j = j + 1
        }
        i = i + 1
    }
    println("row string_scan_char_at ${per_op(t0, os.now_monotonic_ns(), scans)} ns/scan")

    // #3840: a string read from a field, passed to a call. The callee could
    // store into the field, so the caller holds the argument for the call
    // (R3): a reference taken, the place journaled, then forgotten and the
    // reference released after it.
    holder = Holder { name: string.concat("held ", "argument") }
    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        total = total + held_len(holder.name)
        i = i + 1
    }
    println("row string_held_arg ${per_op(t0, os.now_monotonic_ns(), n)} ns/call")

    if total == 0 { println("nothing measured") }
}
