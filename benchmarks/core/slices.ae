// Slice hot paths (#3568): a `make` buffer made and released, one grown by
// `append` from empty, a view of it bound to a local (which holds a
// reference of its own), a view given to a function that only reads it, an
// index loop over a long slice, and a view a function returns against the
// same cast in place.
//
// Prints `row <name> <value> <unit>` lines for benchmarks/core/run.ae.

import std.os

per_op(t0: long, t1: long, n: int) -> float {
    return (t1 - t0) as float / n as float
}

total_of(xs: int[]) -> int {
    t = 0
    for x in xs {
        t = t + x
    }
    return t
}

// A view at an offset into memory a struct points at, as aephysics' hull
// accessors return, read in a function of its own as a narrow-phase
// routine reads one per call, and the same read through the cast written
// in place.
struct Block {
    data: ptr
}

view_at(b: *Block, k: int) -> int[] {
    return (b.data + k * 8) as int[]
}

read_returned(b: *Block, k: int) -> int {
    faces = view_at(b, k)
    return faces[3]
}

read_cast(b: *Block, k: int) -> int {
    faces = (b.data + k * 8) as int[]
    return faces[3]
}

main() {
    n = 1000000
    total = 0

    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        xs = make([]int, 16)
        xs[3] = i
        total = total + xs[3]
        i = i + 1
    }
    println("row slice_make ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    m = n / 10
    t0 = os.now_monotonic_ns()
    i = 0
    while i < m {
        int[] xs = []
        for k in 0..64 {
            xs = append(xs, k)
        }
        total = total + xs.len
        i = i + 1
    }
    println("row slice_append64 ${per_op(t0, os.now_monotonic_ns(), m)} ns/op")

    buf = make([]int, 64)
    for k in 0..64 {
        buf[k] = k
    }
    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        v = buf[8..24]
        total = total + v[3] + v.len
        i = i + 1
    }
    println("row slice_view_bound ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        total = total + total_of(buf[60..64])
        i = i + 1
    }
    println("row slice_view_passed ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    // A view a function returns (#3787) against the same cast in place: the
    // view carries no count, so its caller journals nothing for it.
    blk = Block { data: buf as ptr }
    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        total = total + read_returned(&blk, i & 7)
        i = i + 1
    }
    println("row slice_view_returned ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    t0 = os.now_monotonic_ns()
    i = 0
    while i < n {
        total = total + read_cast(&blk, i & 7)
        i = i + 1
    }
    println("row slice_view_cast ${per_op(t0, os.now_monotonic_ns(), n)} ns/op")

    big = make([]int, 4096)
    for k in 0..4096 {
        big[k] = k & 7
    }
    reps = 2000
    t0 = os.now_monotonic_ns()
    i = 0
    while i < reps {
        total = total + total_of(big)
        i = i + 1
    }
    println("row slice_index_4096 ${per_op(t0, os.now_monotonic_ns(), reps)} ns/op")

    if total == 42 {
        println("unlikely")
    }
}
