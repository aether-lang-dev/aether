// std.sandbox — build a grant list and run code under it.
// Import with: import std.sandbox
//
//   worker = sandbox.new("db-worker") {
//       grant_fs_read("/etc/app/*")
//       grant_tcp("db.internal", 5432)
//       grant_env("DATABASE_URL")
//   }
//   sandbox.enforce(worker) callback {
//       // std.fs / std.net / std.os calls here are checked against
//       // worker's grants; anything not granted is refused
//   }
//   sandbox.enforce(worker, audit_log) callback {
//       audit_log("started")   // trusted: runs with the caller's authority
//   }
//   sandbox.free(worker)
//
// The grant list is what docs/containment-sandbox.md describes: a list of
// (category, pattern) pairs that the in-process checks in std and the
// LD_PRELOAD library (libaether_sandbox.so) consult, and that the
// contrib/host/<lang> modules take as their `perms` argument
// (`lua.run_sandboxed(worker, code)`). This module is the one place those
// category names are spelt; a hand-written "fs-read" would match nothing
// and deny silently.
//
// Patterns: "*" matches anything, "/etc/*" a prefix, "*.example.com" a
// suffix, anything else exactly. A file-system path is matched where it
// leads: ".." and symlinks in it are resolved first (an fs grant's directory
// too, when it is made), and a path that cannot be resolved, such as a
// dangling symlink, is refused. A grant list with no grants denies
// everything; grant_all() allows everything. Nested enforce() blocks
// intersect: an inner block can only narrow what the outer one allows.
//
// What is checked: std's own fs / net / os / udp entry points, and, under
// the LD_PRELOAD library, libc's open / connect / listen / accept / execve
// / dlopen. Code that bypasses libc (raw syscall(), statically linked
// binaries, io_uring) is not contained by this layer; on FreeBSD,
// std.capsicum adds kernel enforcement. See docs/containment-sandbox.md.

import std.list
import std.string

// Grants are stored as plain C strings, which is what the runtime's checker
// and the host modules read (strcmp, no Aether string header), and as
// copies the list owns: a caller's interpolated pattern ("${dir}/*") is a
// temporary, and storing its pointer left a dangling grant.
extern strdup(s: string) -> ptr
// An fs grant's directory resolved as the checks resolve paths (runtime/
// aether_sandbox_path.h), so "/var/x/*" covers what is under /private/var/x
// on macOS and a grant named through a symlink covers where it leads.
extern aether_sandbox_grant_pattern(category: string, pattern: string) -> ptr
@extern("free") libc_free(p: ptr)
// For freezing a grant list: an element's characters (a plain C string or an
// Aether string), and a malloc'd copy of them.
extern aether_string_raw_ptr(s: ptr) -> ptr
@extern("strdup") strdup_raw(s: ptr) -> ptr

exports(
    Grants, new, enforce, free,
    grant_all, grant_fs_read, grant_fs_write, grant_fs, grant_exec,
    grant_env, grant_tcp, grant_tcp_listen, grant_udp, grant_native
)

// A grant list. Opaque: made by new(), filled by the grant_* calls in its
// trailing block, used by enforce() and the contrib/host run_sandboxed
// calls, released by free(). It is not a std.list a caller can edit; code
// that has one can only pass it on.
type Grants = distinct ptr

fn add_grant(perms: Grants, category: string, pattern: string) {
    p = perms as ptr
    // null is what an enforce block receives (see enforce): a grant written
    // there has no list to go into, and grants nothing.
    if p == null { return }
    list.add(p, strdup(category))
    list.add(p, aether_sandbox_grant_pattern(category, pattern))
}

// A tcp/udp grant pattern: the host alone (any port) when port is 0, else
// "host:port", with an IPv6 address in brackets ("[::1]:8080") so its own
// colons are not read as the port's. The checks name resources the same
// way (aether_net_resource in runtime/aether_sandbox_match.h).
fn net_pattern(host: string, port: int) -> string {
    // Checked here rather than with a `where` on the grant_* parameter: a
    // contract on a builder setter's parameter currently stops the trailing
    // block from passing its implicit context.
    if port < 0 || port > 65535 {
        panic("sandbox: a port is 0 (any) or 1..65535, got ${port}")
    }
    if port == 0 { return host }
    if string.contains(host, ":") == 1 {
        if string.starts_with(host, "[") == 0 { return "[${host}]:${port}" }
    }
    return "${host}:${port}"
}

// A new, empty grant list named `name` (the name is for the reader and for
// denial logs; it does not change what is allowed). Give it grants in the
// trailing block; with none it denies everything. Release with free().
new(name: string) -> Grants {
    _ = name
    return list.new() as Grants
}

// Run `code` with `perms` in force: every sandbox-checked operation inside
// it, and in anything it calls, must match one of the grants. The grants
// stop applying when `code` returns.
//
// Trusted names: `sandbox.enforce(perms, audit_log, db) callback { ... }`.
// A call written in the block to a named function (`audit_log(...)`), or into
// a named module (`db.query(...)`), runs with the authority of the code that
// wrote the enforce instead of the block's grants. The compiler handles the
// extra names (compiler/analysis/sandbox_trust.c): it checks them, routes
// those calls through wrappers, and leaves this two-argument function to do
// the rest. Trust is lexical and narrow on purpose:
//   - a trusted call's arguments are still evaluated inside the sandbox;
//   - a function called from somewhere else, even one that calls a trusted
//     name, stays sandboxed;
//   - the names cannot be used as values in the block;
//   - only Aether functions can be trusted, not C externs;
//   - an enforce written by contained code records the sandboxed authority
//     it runs under, so trusting a name there gains nothing.
//
// The grants are frozen when the block starts: enforce checks against its own
// copy, which nothing else can reach, so changing `perms` afterwards (or a
// grant_* call made with it from inside the block, by code it was passed to)
// does not widen what the running block may do. For the same reason the block
// is not given the list: its parameter is null.
enforce(perms: Grants, code: fn) {
    frozen = freeze(perms as ptr)
    defer free_list(frozen)
    sandbox_push(frozen)
    sandbox_install()
    call(code, null)
    sandbox_uninstall()
    sandbox_pop()
}

// A private copy of a grant list, with copies of its strings: what enforce
// checks against. null stays null, an empty list stays empty (deny all).
fn freeze(perms: ptr) -> ptr {
    if perms == null { return null }
    frozen = list.new()
    n = list.size(perms)
    i = 0
    while i < n {
        e = list_get_raw(perms, i)
        if e == null {
            list.add(frozen, null)
        } else {
            list.add(frozen, strdup_raw(aether_string_raw_ptr(e)))
        }
        i = i + 1
    }
    return frozen
}

// Release a grant list made by new(), and the grant strings it owns.
free(perms: Grants) {
    free_list(perms as ptr)
}

fn free_list(perms: ptr) {
    if perms == null { return }
    n = list.size(perms)
    i = 0
    while i < n {
        libc_free(list_get_raw(perms, i))
        i = i + 1
    }
    list.free(perms)
}

// ---- Grants: call these in new()'s trailing block ----

// Everything: the equivalent of no sandbox.
grant_all(_ctx: Grants) { add_grant(_ctx, "*", "*") }

// Opening files for reading whose resolved path matches `path`.
grant_fs_read(_ctx: Grants, path: string) { add_grant(_ctx, "fs_read", path) }

// Opening, creating or writing files whose resolved path matches `path`.
grant_fs_write(_ctx: Grants, path: string) { add_grant(_ctx, "fs_write", path) }

// Reading and writing under `path`, plus directory operations on it (such
// as os.chdir, which std checks under its own "fs" category).
grant_fs(_ctx: Grants, path: string) {
    add_grant(_ctx, "fs_read", path)
    add_grant(_ctx, "fs_write", path)
    add_grant(_ctx, "fs", path)
}

// Running commands whose command line matches `cmd` ("echo *").
grant_exec(_ctx: Grants, cmd: string) { add_grant(_ctx, "exec", cmd) }

// Reading the environment variables whose names match `name`.
grant_env(_ctx: Grants, name: string) { add_grant(_ctx, "env", name) }

// Outbound TCP to hosts matching `host` ("db.internal", "*.corp") on `port`,
// or on any port when `port` is 0. The LD_PRELOAD layer sees only the
// resolved address, so grant the IP too for code that connects outside
// std.net.
grant_tcp(_ctx: Grants, host: string, port: int) {
    add_grant(_ctx, "tcp", net_pattern(host, port))
}

// Listening for and accepting inbound TCP connections, on any port.
grant_tcp_listen(_ctx: Grants) { add_grant(_ctx, "tcp_listen", "*") }

// UDP to and from hosts matching `host` on `port`, or any port when 0.
grant_udp(_ctx: Grants, host: string, port: int) {
    add_grant(_ctx, "udp", net_pattern(host, port))
}

// Loading native code (dlopen) from paths matching `path`.
grant_native(_ctx: Grants, path: string) { add_grant(_ctx, "native", path) }
