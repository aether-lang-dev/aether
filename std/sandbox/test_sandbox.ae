// std.sandbox tests — co-located with the module (#1584).
//
// Each grant is checked the way a contained program meets it: through the
// ordinary std call it gates (os.getenv, fs.read, fs.write, os.exec), run
// inside sandbox.enforce, against a grant that should let it through and a
// neighbour that should not. The paths are this test's own fixtures, in a
// fresh temp directory written before any sandbox is in force, so the suite
// reads the same on Linux, macOS and FreeBSD. Paths and fs grants are both
// resolved before they are compared (test_sandbox_paths.ae has the escapes
// that makes necessary), so a macOS /tmp -> /private/tmp does not matter.
//
// The env cases set their own variables rather than rely on HOME or USER
// being present on a CI runner.

import std.spec
import std.sandbox
import std.os
import std.fs
import std.list
import std.string
import std.tcp
import std.audit

extern exit(code: int)

// `a` is an element of the grant list, which holds C text (strdup'd), not
// Aether strings: it stays a `ptr` here and goes to the C comparison as one.
fn same(a: ptr, b: string) -> int { return string.equals(a, b) }

// 1 when grant number i in `perms` is the (category, pattern) pair given.
// Code running inside a sandbox that has been handed the grant list, the way
// any ptr can reach a callee, tries to grant itself more.
fn widen(perms: sandbox.Grants) {
    sandbox.grant_env(perms, "AE_SANDBOX_TEST_SECRET")
}

fn has_grant(perms: ptr, i: int, category: string, pattern: string) -> int {
    if same(list.at(perms, i * 2), category) != 1 { return 0 }
    return same(list.at(perms, i * 2 + 1), pattern)
}

// An fs grant's pattern as the list stores it: resolved as the checks
// resolve paths (std.sandbox's add_grant), which leaves `/r/*` as written
// where it leads nowhere on POSIX and puts it on the current drive on
// Windows (`D:\r\*`).
extern aether_sandbox_grant_pattern(category: string, pattern: string) -> ptr
@extern("free") libc_free(p: ptr)
// The shell grant_shell names: /bin/sh, or what COMSPEC names on Windows.
extern aether_sandbox_shell_path() -> string

fn stored(category: string, pattern: string) -> string {
    p = aether_sandbox_grant_pattern(category, pattern)
    s = string.from_cstr(p)
    libc_free(p)
    return s
}

// #3762: os.execv in a child of this test, so that an exec that should
// have been refused replaces only the child. `role` is "execv-script" (the
// file's grant alone) or "execv-shell" (and grant_shell); the child exits 3
// when os.execv returned, which a refused start does.
fn execv_child(role: string, script: string) {
    argv = list.new()
    list.add(argv, script)
    g = sandbox.new("execv-child") {
        grant_exec(script)
        if role == "execv-shell" { grant_shell() }
    }
    sandbox.enforce(g) callback {
        _rc = os.execv(script, argv)
    }
    // Refused: what the child made is released before it reports, so a
    // leak check at exit (LeakSanitizer exits 23) does not hide the 3.
    sandbox.free(g)
    list.free(argv)
    exit(3)
}

main() {
    if os.args_count() > 2 {
        role = os.args_get(1)
        if role == "execv-script" || role == "execv-shell" {
            execv_child(role, os.args_get(2))
        }
    }
    fw = spec.init()

    dir, terr = fs.make_temp_dir("", "ae_sandbox_test")
    if terr != "" {
        println("cannot make a fixture directory: ${terr}")
        exit(1)
    }
    _ = fs.write("${dir}/allowed.txt", "allowed")
    _ = fs.write("${dir}/other.txt", "other")
    env_err = os.setenv("AE_SANDBOX_TEST_OPEN", "visible")
    if env_err != "" { println("cannot set the test variable: ${env_err}") }
    env_err2 = os.setenv("AE_SANDBOX_TEST_SECRET", "hidden")
    if env_err2 != "" { println("cannot set the test variable: ${env_err2}") }

    spec.describe(fw, "std.sandbox grant lists") {
        spec.it("spells each grant as the category the runtime checks") callback {
            g = sandbox.new("all-kinds") {
                grant_fs_read("/r/*")
                grant_fs_write("/w/*")
                grant_exec("echo *")
                grant_env("HOME")
                grant_tcp("*.corp", 0)
                grant_tcp_listen()
                grant_udp("dns.local", 0)
                grant_native("/opt/lib/*")
                grant_fork()
                grant_all()
            }
            spec.assert_eq(list.size(g as ptr), 20, "ten grants, two entries each")
            spec.assert_true(has_grant(g as ptr, 0, "fs_read", stored("fs_read", "/r/*")), "grant_fs_read")
            spec.assert_true(has_grant(g as ptr, 1, "fs_write", stored("fs_write", "/w/*")), "grant_fs_write")
            spec.assert_true(has_grant(g as ptr, 2, "exec", "echo *"), "grant_exec")
            spec.assert_true(has_grant(g as ptr, 3, "env", "HOME"), "grant_env")
            spec.assert_true(has_grant(g as ptr, 4, "tcp", "*.corp"), "grant_tcp")
            spec.assert_true(has_grant(g as ptr, 5, "tcp_listen", "*"), "grant_tcp_listen")
            spec.assert_true(has_grant(g as ptr, 6, "udp", "dns.local"), "grant_udp")
            spec.assert_true(has_grant(g as ptr, 7, "native", "/opt/lib/*"), "grant_native")
            spec.assert_true(has_grant(g as ptr, 8, "fork", "*"), "grant_fork")
            spec.assert_true(has_grant(g as ptr, 9, "*", "*"), "grant_all")
            sandbox.free(g)
        }

        spec.it("grant_tcp and grant_udp name a port, or any port with 0") callback {
            g = sandbox.new("ports") {
                grant_tcp("db.internal", 5432)
                grant_tcp("*.corp", 0)
                grant_udp("::1", 53)
            }
            spec.assert_true(has_grant(g as ptr, 0, "tcp", "db.internal:5432"), "host and port")
            spec.assert_true(has_grant(g as ptr, 1, "tcp", "*.corp"), "port 0 is any port")
            spec.assert_true(has_grant(g as ptr, 2, "udp", "[::1]:53"), "an IPv6 host is bracketed")
            sandbox.free(g)
        }

        spec.it("checks the port a connection goes to") callback {
            // Nothing listens on these ports: the sandbox decision is
            // recorded (std.audit) before the connect is attempted.
            g = sandbox.new("one-port") {
                grant_tcp("127.0.0.1", 47911)
            }
            audit.clear()
            sandbox.enforce(g) callback {
                _a, _ea = tcp.connect("127.0.0.1", 47911)
                _b, _eb = tcp.connect("127.0.0.1", 47912)
            }
            granted = -1
            other = -1
            n = audit.count()
            i = 0
            while i < n {
                cat, res, allowed = audit.entry(i)
                if string.equals(cat, "tcp") == 1 {
                    if string.equals(res, "127.0.0.1:47911") == 1 { granted = allowed }
                    if string.equals(res, "127.0.0.1:47912") == 1 { other = allowed }
                }
                i = i + 1
            }
            spec.assert_eq(granted, 1, "the granted port is allowed")
            spec.assert_eq(other, 0, "another port on the same host is refused")
            sandbox.free(g)
        }

        spec.it("grant_fs covers reads, writes and directory operations") callback {
            g = sandbox.new("fs") {
                grant_fs("/data/*")
            }
            spec.assert_eq(list.size(g as ptr), 6, "three grants")
            spec.assert_true(has_grant(g as ptr, 0, "fs_read", stored("fs_read", "/data/*")), "read")
            spec.assert_true(has_grant(g as ptr, 1, "fs_write", stored("fs_write", "/data/*")), "write")
            spec.assert_true(has_grant(g as ptr, 2, "fs", stored("fs", "/data/*")), "directory operations")
            sandbox.free(g)
        }
    }

    // grant_runtime's library directories are listed as well as read from:
    // an interpreter fills its import cache by listing each directory on its
    // path, and a grant of what is under a directory ("dir/*") does not grant
    // listing the directory itself.
    py_argv = list.new()
    list.add(py_argv, "-I")
    list.add(py_argv, "-c")
    list.add(py_argv, "import os; print(os.path.dirname(os.path.realpath(os.__file__)))")
    py_out, py_code, py_err = os.run_capture("python3", py_argv, null)
    list.free(py_argv)
    py_lib = string.trim(py_out)
    have_py = 0
    if py_err == "" && py_code == 0 && py_lib != "" { have_py = 1 }

    spec.describe(fw, "std.sandbox enforce") {
        spec.it_when(have_py, "grant_runtime lets the runtime list its library directories", "no python3 here") callback {
            g = sandbox.new("python") {
                grant_runtime("python3")
            }
            listed = "not tried"
            sandbox.enforce(g) callback {
                l, lerr = fs.list_dir(py_lib)
                listed = lerr
                if lerr == "" { fs.dir_list_free(l) }
            }
            sandbox.free(g)
            spec.assert_str_eq(listed, "", "the standard library's directory lists")
        }
        spec.it("lets a granted env variable through and hides the rest") callback {
            g = sandbox.new("env") {
                grant_env("AE_SANDBOX_TEST_OPEN")
            }
            sandbox.enforce(g) callback {
                spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_OPEN"), "visible", "granted variable reads")
                spec.assert_true(os.getenv("AE_SANDBOX_TEST_SECRET") == null, "ungranted variable is hidden")
            }
            sandbox.free(g)
        }

        spec.it("matches fs_read grants by prefix") callback {
            g = sandbox.new("reader") {
                grant_fs_read("${dir}/allowed*")
            }
            sandbox.enforce(g) callback {
                a, aerr = fs.read("${dir}/allowed.txt")
                spec.assert_ok(aerr, "granted file reads")
                spec.assert_str_eq(a, "allowed", "with its content")
                _o, oerr = fs.read("${dir}/other.txt")
                spec.assert_err(oerr, "a file outside the prefix is refused")
            }
            sandbox.free(g)
        }

        spec.it("keeps writes separate from reads") callback {
            g = sandbox.new("read-only") {
                grant_fs_read("${dir}/*")
            }
            sandbox.enforce(g) callback {
                werr = fs.write("${dir}/written.txt", "no")
                spec.assert_err(werr, "fs_read alone does not allow a write")
            }
            sandbox.free(g)
            spec.assert_eq(fs.exists("${dir}/written.txt"), 0, "and nothing was written")
        }

        // #3742: a mode is checked for everything it asks. "r+" reads and
        // writes, so a read-only grant refuses it, and "w+" and "a+" read,
        // so a write-only grant refuses those.
        spec.it("checks an open mode for each thing it asks of the file") callback {
            ro = sandbox.new("read-only") {
                grant_fs_read("${dir}/*")
            }
            sandbox.enforce(ro) callback {
                h, err = fs.open("${dir}/allowed.txt", "r")
                spec.assert_ok(err, "a read open is allowed")
                if err == "" { _c = fs.close(h) }
                _h2, err2 = fs.open("${dir}/allowed.txt", "r+")
                spec.assert_err(err2, "r+ needs fs_write as well")
                _h3, err3 = fs.open("${dir}/allowed.txt", "rb+")
                spec.assert_err(err3, "so does rb+")
            }
            sandbox.free(ro)
            a, _aerr = fs.read("${dir}/allowed.txt")
            spec.assert_str_eq(a, "allowed", "and the file is as it was")

            wo = sandbox.new("write-only") {
                grant_fs_write("${dir}/*")
            }
            sandbox.enforce(wo) callback {
                h, err = fs.open("${dir}/modes.txt", "w")
                spec.assert_ok(err, "a write open is allowed")
                if err == "" { _c = fs.close(h) }
                _h2, err2 = fs.open("${dir}/modes.txt", "w+")
                spec.assert_err(err2, "w+ needs fs_read as well")
                _h3, err3 = fs.open("${dir}/modes.txt", "a+")
                spec.assert_err(err3, "so does a+")
                _h4, err4 = fs.open("${dir}/modes.txt", "r+")
                spec.assert_err(err4, "and r+")
            }
            sandbox.free(wo)

            rw = sandbox.new("read-write") {
                grant_fs_read("${dir}/*")
                grant_fs_write("${dir}/*")
            }
            sandbox.enforce(rw) callback {
                h, err = fs.open("${dir}/modes.txt", "r+")
                spec.assert_ok(err, "r+ opens with both grants")
                if err == "" { _c = fs.close(h) }
            }
            sandbox.free(rw)
        }

        // #3743: listing, globbing, mtime and the directory calls did no
        // check at all, so a block with no grants could read and change the
        // file system's shape.
        spec.it("checks listing, globbing, mtime and directory calls") callback {
            _e = fs.create_dir("${dir}/empty")
            pats = list.new()
            _a = list.add(pats, "${dir}/*.txt")
            g = sandbox.new("no-fs") {}
            sandbox.enforce(g) callback {
                _l, lerr = fs.list_dir(dir)
                spec.assert_err(lerr, "list_dir is refused")
                _gl, gerr = fs.glob("${dir}/*.txt")
                spec.assert_err(gerr, "glob is refused")
                _gm, gmerr = fs.glob_multi(pats)
                spec.assert_err(gmerr, "glob_multi is refused")
                _t, merr = fs.mtime("${dir}/allowed.txt")
                spec.assert_err(merr, "mtime is refused")
                spec.assert_true(fs.file_mtime("${dir}/allowed.txt") == 0, "and so is the older file_mtime")
                spec.assert_eq(fs.dir_exists(dir), 0, "dir_exists answers no, as file_exists does")
                _st, _sf, _sa, serr = fs.statvfs(dir)
                spec.assert_err(serr, "statvfs is refused")
                cerr = fs.create_dir("${dir}/made")
                spec.assert_err(cerr, "create_dir is refused")
                ok, _k, _cm = fs.create_dir_with_mode("${dir}/made_mode", 448)
                spec.assert_eq(ok, 0, "create_dir_with_mode is refused")
                derr = fs.delete_dir("${dir}/empty")
                spec.assert_err(derr, "delete_dir is refused")
            }
            sandbox.free(g)
            list.free(pats)
            spec.assert_eq(fs.exists("${dir}/made"), 0, "no directory was made")
            spec.assert_eq(fs.exists("${dir}/made_mode"), 0, "with a mode either")
            spec.assert_eq(fs.exists("${dir}/empty"), 1, "and none was removed")
        }

        spec.it("lists and globs a granted directory, and globs report only granted paths") callback {
            g = sandbox.new("lister") {
                grant_fs_read(dir)
                grant_fs_read("${dir}/allowed*")
            }
            sandbox.enforce(g) callback {
                l, lerr = fs.list_dir(dir)
                spec.assert_ok(lerr, "the granted directory lists")
                if lerr == "" { fs.dir_list_free(l) }
                gl, gerr = fs.glob("${dir}/*.txt")
                spec.assert_ok(gerr, "and globs")
                if gerr == "" {
                    spec.assert_eq(fs.dir_list_count(gl), 1, "with only the file it may read")
                    if fs.dir_list_count(gl) == 1 {
                        spec.assert_contains(fs.dir_list_get(gl, 0), "allowed.txt", "which is allowed.txt")
                    }
                    fs.dir_list_free(gl)
                }
            }
            sandbox.free(g)
        }

        spec.it("matches exec grants against the command line") callback {
            g = sandbox.new("echoer") {
                grant_exec("echo *")
                grant_shell()
            }
            sandbox.enforce(g) callback {
                out, err = os.exec("echo sandboxed")
                spec.assert_ok(err, "a granted command runs")
                spec.assert_contains(out, "sandboxed", "and produces its output")
                _o2, err2 = os.exec("uname")
                spec.assert_err(err2, "a command outside the pattern is refused")
            }
            sandbox.free(g)
        }

        // #3735: "echo *" matches any command string that starts with
        // "echo ", and the shell runs all of the string, so a command string
        // needs the shell granted as well. Without grant_shell it is refused,
        // shell syntax after the matched part or not.
        spec.it("refuses a command string when the shell is not granted") callback {
            g = sandbox.new("echo-only") {
                grant_exec("echo *")
            }
            sandbox.enforce(g) callback {
                _o, err = os.exec("echo hi; uname")
                spec.assert_err(err, "shell syntax after a granted prefix is refused")
                _o2, err2 = os.exec("echo hi")
                spec.assert_err(err2, "and so is the plain command, with no shell grant")
                spec.assert_eq(os.system("echo hi"), -1, "os.system checks the shell too")
            }
            sandbox.free(g)
        }

        spec.it("grant_shell grants the shell the command string runs through") callback {
            g = sandbox.new("shell") {
                grant_shell()
            }
            spec.assert_true(has_grant(g as ptr, 0, "exec", aether_sandbox_shell_path()), "an exec grant for the shell")
            sandbox.enforce(g) callback {
                _o, err = os.exec("echo hi")
                spec.assert_err(err, "the shell alone does not grant the command")
            }
            sandbox.free(g)
        }

        // #3755: os.run and its siblings run a file with no #! line through
        // /bin/sh, as execvp does. The exec grant for the file let the shell
        // run it, and the shell runs whatever the file holds; the LD_PRELOAD
        // library already asked for a grant for the shell there, and now
        // the in-process path does too. POSIX only: Windows runs no such file
        // through a shell.
        spec.it("runs a file with no #! line through the shell only with grant_shell") callback {
            if select(windows: 1, other: 0) == 0 {
                script = "${dir}/no_shebang"
                _w = fs.write(script, "exit 7\n")
                _c = fs.chmod(script, 493) // 0o755
                argv = list.new()
                g = sandbox.new("script-only") {
                    grant_exec(script)
                }
                sandbox.enforce(g) callback {
                    _o, code, err = os.run_capture(script, argv, null)
                    spec.assert_err(err, "without a shell grant the script does not run")
                    spec.assert_eq(code, -1, "and reports that it could not start")
                }
                sandbox.free(g)
                g2 = sandbox.new("script-and-shell") {
                    grant_exec(script)
                    grant_shell()
                }
                sandbox.enforce(g2) callback {
                    _o2, code2, err2 = os.run_capture(script, argv, null)
                    spec.assert_ok(err2, "with grant_shell the shell runs it")
                    spec.assert_eq(code2, 7, "to its exit status")
                }
                sandbox.free(g2)
                list.free(argv)
            }
        }

        // #3762: os.execv used execvp, which runs a file with no #! line
        // through /bin/sh by itself, with no grant for the shell. It now
        // takes the shell only with grant_shell. The exec runs in a child
        // of this test (execv_child), which exits 3 when os.execv returned.
        spec.it("os.execv runs a file with no #! line through the shell only with grant_shell") callback {
            self_path = os.argv0()
            if select(windows: 1, other: 0) == 0 && string.index_of(self_path, "/") >= 0 {
                script = "${dir}/no_shebang_execv"
                _w = fs.write(script, "exit 7\n")
                _c = fs.chmod(script, 493) // 0o755
                argv = list.new()
                list.add(argv, "execv-script")
                list.add(argv, script)
                _o, code, err = os.run_capture(self_path, argv, null)
                spec.assert_ok(err, "the child starts")
                spec.assert_eq(code, 3, "without a shell grant os.execv returns, refused")
                argv2 = list.new()
                list.add(argv2, "execv-shell")
                list.add(argv2, script)
                _o2, code2, err2 = os.run_capture(self_path, argv2, null)
                spec.assert_ok(err2, "the child starts")
                spec.assert_eq(code2, 7, "with grant_shell the shell runs the script")
                list.free(argv)
                list.free(argv2)
            }
        }

        spec.it("denies everything when nothing is granted") callback {
            g = sandbox.new("nothing") {}
            sandbox.enforce(g) callback {
                spec.assert_true(os.getenv("AE_SANDBOX_TEST_OPEN") == null, "env is hidden")
                _a, err = fs.read("${dir}/allowed.txt")
                spec.assert_err(err, "files are refused")
            }
            sandbox.free(g)
        }

        spec.it("grant_all allows everything") callback {
            g = sandbox.new("app") {
                grant_all()
            }
            sandbox.enforce(g) callback {
                spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_SECRET"), "hidden", "env reads")
                _a, err = fs.read("${dir}/other.txt")
                spec.assert_ok(err, "files read")
            }
            sandbox.free(g)
        }

        spec.it("narrows in a nested enforce: the inner block gets the intersection") callback {
            outer = sandbox.new("outer") {
                grant_env("AE_SANDBOX_TEST_OPEN")
                grant_env("AE_SANDBOX_TEST_SECRET")
            }
            inner = sandbox.new("inner") {
                grant_env("AE_SANDBOX_TEST_OPEN")
                grant_fs_read("${dir}/*")
            }
            sandbox.enforce(outer) callback {
                spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_SECRET"), "hidden", "outer allows the secret")
                sandbox.enforce(inner) callback {
                    spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_OPEN"), "visible", "granted by both")
                    spec.assert_true(os.getenv("AE_SANDBOX_TEST_SECRET") == null, "inner did not grant it")
                    _a, err = fs.read("${dir}/allowed.txt")
                    spec.assert_err(err, "inner's fs grant cannot exceed outer, which has none")
                }
                spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_SECRET"), "hidden", "outer's grants are back")
            }
            sandbox.free(inner)
            sandbox.free(outer)
        }

        spec.it("cannot be widened from inside the block it guards") callback {
            g = sandbox.new("narrow") {
                grant_env("AE_SANDBOX_TEST_OPEN")
            }
            sandbox.enforce(g) callback {
                widen(g)
                spec.assert_true(os.getenv("AE_SANDBOX_TEST_SECRET") == null,
                    "a grant added to the list mid-block grants nothing")
                spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_OPEN"), "visible", "the frozen grants still apply")
            }
            // The caller's own list did change, and a later enforce of it
            // sees the change: grants are frozen per enforce, not forever.
            sandbox.enforce(g) callback {
                spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_SECRET"), "hidden", "the next enforce sees the new grant")
            }
            sandbox.free(g)
        }

        spec.it("does not hand the block the grant list") callback {
            g = sandbox.new("narrow") {
                grant_env("AE_SANDBOX_TEST_OPEN")
            }
            sandbox.enforce(g) | ctx: ptr | {
                spec.assert_true(ctx == null, "the block's parameter is null")
                sandbox.grant_env(ctx as sandbox.Grants, "AE_SANDBOX_TEST_SECRET")
                spec.assert_true(os.getenv("AE_SANDBOX_TEST_SECRET") == null, "granting through it does nothing")
            }
            sandbox.free(g)
        }

        spec.it("stops applying when the enforced block returns") callback {
            g = sandbox.new("nothing") {}
            sandbox.enforce(g) callback {
                spec.assert_true(os.getenv("AE_SANDBOX_TEST_OPEN") == null, "hidden inside")
            }
            spec.assert_str_eq(os.getenv("AE_SANDBOX_TEST_OPEN"), "visible", "visible again after")
            sandbox.free(g)
        }
    }

    rc = spec.run_summary(fw)
    _ = fs.remove_tree(dir)
    return rc
}
