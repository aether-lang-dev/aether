// std.sandbox: a path is matched where it leads, not as it is spelt, and an
// enforce block contains its own thread, not the process.
//
// Each fs case is an escape a grant for "<dir>/box/*" must not allow: a ".."
// after the granted prefix, the same through directories that do not exist
// yet (mkdir -p), a symlink inside the box followed by "..", and a dangling
// symlink inside the box whose target is outside. The file the escape would
// create is checked to be absent afterwards, so a refusal that came too late
// still fails. The grant itself is written through a symlink to the box, and
// the temp directory is under /var on macOS (a symlink to /private/var), so
// grants and paths both have to be resolved for the allowed cases to pass.

import std.spec
import std.sandbox
import std.os
import std.fs
import std.worker
import std.string
import std.list

extern exit(code: int)

// What the worker thread saw, written there and read on the main thread
// after worker.wait().
var thread_saw: int = 0 - 1

// A Windows junction at `link` to the directory `target`: 1 when made.
fn make_junction(link: string, target: string) -> int {
    l = string.replace_all(link, "/", "\\")
    t = string.replace_all(target, "/", "\\")
    argv = list.new()
    list.add(argv, "-NoProfile")
    list.add(argv, "-NonInteractive")
    list.add(argv, "-Command")
    list.add(argv, "New-Item -ItemType Junction -Path '${l}' -Target '${t}' | Out-Null")
    _o, code, err = os.run_capture("powershell.exe", argv, null)
    list.free(argv)
    if err != "" || code != 0 { return 0 }
    return 1
}

main() {
    fw = spec.init()

    tmp, terr = fs.make_temp_dir("", "ae_sandbox_paths")
    if terr != "" {
        println("cannot make a fixture directory: ${terr}")
        exit(1)
    }
    box = "${tmp}/box"
    outside = "${tmp}/outside"
    _m1 = fs.mkdir_p("${box}/sub")
    _m2 = fs.mkdir_p("${outside}/deep")
    _l1 = fs.symlink("${outside}/deep", "${box}/link")
    _l2 = fs.symlink("${outside}/new.txt", "${box}/dangling")
    _l3 = fs.symlink(box, "${tmp}/boxlink")
    // Symlinks are followed where the kernel follows them. On Windows a
    // symlink needs Developer Mode or an administrator to create, and ".."
    // is resolved by the text before any link is followed (as Windows
    // resolves it), so "link/.." stays in the box there: these cases run on
    // POSIX, and Windows has its junction cases below (#3763).
    have_links = 0
    if os.platform() != "windows" && fs.is_symlink("${box}/link") == 1 && fs.is_symlink("${tmp}/boxlink") == 1 {
        have_links = 1
    }
    no_links = "symlinks not created or not followed on this platform"
    env_err = os.setenv("AE_SANDBOX_PATHS_VAR", "visible")
    if env_err != "" { println("cannot set the test variable: ${env_err}") }

    // Spelt as the paths below are, so a matcher that compares strings
    // would let every escape through.
    in_box = sandbox.new("box") {
        grant_fs_write("${box}/*")
        grant_fs_read("${box}/*")
    }
    // The same box named through a symlink to it.
    via_link = sandbox.new("box, through a symlink") {
        grant_fs_write("${tmp}/boxlink/*")
    }
    nothing = sandbox.new("nothing") {}

    spec.describe(fw, "std.sandbox fs grants match where a path leads") {
        spec.it_when(have_links, "allows a file in the box, the grant written through a symlink", no_links) callback {
            err = ""
            sandbox.enforce(via_link) callback {
                err = fs.write("${box}/inside.txt", "ok")
            }
            spec.assert_str_eq(err, "", "written")
            spec.assert_eq(fs.exists("${box}/inside.txt"), 1, "and there")
        }
        spec.it("allows a .. that stays in the box") callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.write("${box}/sub/../back.txt", "ok")
            }
            spec.assert_str_eq(err, "", "written")
            spec.assert_eq(fs.exists("${box}/back.txt"), 1, "and there")
        }
        spec.it("refuses a .. that climbs out of the box") callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.write("${box}/../escaped.txt", "no")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_eq(fs.exists("${tmp}/escaped.txt"), 0, "nothing written beside the box")
        }
        spec.it("refuses mkdir -p climbing out through directories that do not exist") callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.mkdir_p("${box}/../made/x")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_eq(fs.exists("${tmp}/made"), 0, "nothing made beside the box")
        }
        spec.it_when(have_links, "refuses a symlink in the box followed by ..", no_links) callback {
            err = ""
            sandbox.enforce(in_box) callback {
                // link -> outside/deep, so link/.. is outside, not the box
                err = fs.write("${box}/link/../via_link.txt", "no")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_eq(fs.exists("${outside}/via_link.txt"), 0, "nothing written outside")
        }
        spec.it_when(have_links, "refuses a dangling symlink in the box that points out", no_links) callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.write("${box}/dangling", "no")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_eq(fs.exists("${outside}/new.txt"), 0, "its target not created")
        }
    }

    // #3763: on Windows a path was resolved with _fullpath, which follows no
    // junction, so a junction in the box let the block reach outside it. A
    // junction needs no privilege; it is made with PowerShell's New-Item.
    have_junctions = 0
    if os.platform() == "windows" {
        _w = fs.write("${outside}/secret.txt", "secret")
        if make_junction("${box}/jout", outside) == 1 && make_junction("${box}/jin", "${box}/sub") == 1 &&
        make_junction("${tmp}/boxj", box) == 1 {
            have_junctions = 1
        }
    }
    no_junctions = "Windows junctions only"
    via_junction = sandbox.new("box, through a junction") {
        grant_fs_write("${tmp}/boxj/*")
    }

    spec.describe(fw, "std.sandbox fs grants follow Windows junctions") {
        spec.it_when(have_junctions, "refuses a write through a junction in the box that points out", no_junctions) callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.write("${box}/jout/leak.txt", "no")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_eq(fs.exists("${outside}/leak.txt"), 0, "nothing written outside")
        }
        spec.it_when(have_junctions, "refuses a read through a junction in the box that points out", no_junctions) callback {
            got = ""
            err = ""
            sandbox.enforce(in_box) callback {
                got, err = fs.read("${box}/jout/secret.txt")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_true(got != "secret", "the file behind the junction was not read")
        }
        spec.it_when(have_junctions, "refuses mkdir -p under a junction that points out", no_junctions) callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.mkdir_p("${box}/jout/made/x")
            }
            spec.assert_true(err != "", "refused")
            spec.assert_eq(fs.exists("${outside}/made"), 0, "nothing made outside")
        }
        spec.it_when(have_junctions, "allows a junction in the box that stays in it", no_junctions) callback {
            err = ""
            sandbox.enforce(in_box) callback {
                err = fs.write("${box}/jin/via_jin.txt", "ok")
            }
            spec.assert_str_eq(err, "", "written")
            spec.assert_eq(fs.exists("${box}/sub/via_jin.txt"), 1, "into the directory it leads to")
        }
        spec.it_when(have_junctions, "allows a file in the box, the grant written through a junction", no_junctions) callback {
            err = ""
            sandbox.enforce(via_junction) callback {
                err = fs.write("${box}/inside_j.txt", "ok")
            }
            spec.assert_str_eq(err, "", "written")
            spec.assert_eq(fs.exists("${box}/inside_j.txt"), 1, "and there")
        }
    }

    spec.describe(fw, "std.sandbox enforce leaves nothing behind") {
        spec.it_when(have_links, "after a block, a dangling symlink is one again, and resolves as before", no_links) callback {
            before = fs.is_symlink("${box}/dangling")
            sandbox.enforce(in_box) callback {
                _e = fs.exists("${box}/sub")
            }
            spec.assert_eq(before, 1, "a symlink before the block")
            spec.assert_eq(fs.is_symlink("${box}/dangling"), 1, "and after it: nothing is checked once the block returns")
            _rp, _k, rerr = fs.realpath("${box}/dangling")
            spec.assert_true(string.contains(rerr, "sandbox") == 0, "realpath's answer is not the sandbox's")
        }
        spec.it("a nested block's end leaves the outer block in force") callback {
            outer_saw = 1
            sandbox.enforce(nothing) callback {
                sandbox.enforce(in_box) callback {
                    _e = fs.exists("${box}/sub")
                }
                if os.getenv("AE_SANDBOX_PATHS_VAR") == null { outer_saw = 0 }
            }
            spec.assert_eq(outer_saw, 0, "the outer block still may not read the variable")
        }
    }

    spec.describe(fw, "std.sandbox enforce contains its own thread") {
        spec.it("a worker thread is not under the main thread's enforce") callback {
            sandbox.enforce(nothing) callback {
                ok = worker.run(| _c: ptr | {
                        if os.getenv("AE_SANDBOX_PATHS_VAR") != null { thread_saw = 1 } else { thread_saw = 0 }
                    }, | _c: ptr | {})
                if ok { worker.wait() }
            }
            worker.drain(16)
            spec.assert_eq(thread_saw, 1, "the worker saw the variable the block may not")
            seen_here = 1
            sandbox.enforce(nothing) callback {
                if os.getenv("AE_SANDBOX_PATHS_VAR") == null { seen_here = 0 }
            }
            spec.assert_eq(seen_here, 0, "while the block itself still may not")
        }
    }

    sandbox.free(in_box)
    sandbox.free(via_link)
    sandbox.free(via_junction)
    sandbox.free(nothing)
    worker.pool_shutdown()
    _r = fs.remove_tree(tmp)
    exit(spec.run_summary(fw))
}
