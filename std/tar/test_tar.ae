main() {
    println("=== TAR REGRESSION TESTS ===")

    var base_dir = path.clean("tar_temp_test_dir")
    var probe_err = ""
    defer {
        string_release(base_dir)
        string_release(probe_err)
    }

    delete_recursive(base_dir)
    fs.mkdir_p(base_dir)

    // Probe if host can create symlinks
    var can_create_symlinks = 1
    probe_err = fs.symlink("dummy", "${base_dir}/probe_symlink")
    if probe_err != "" {
        can_create_symlinks = 0
        println("Note: host platform cannot create symlinks, skipping symlink filesystem tests.")
    } else {
        fs.unlink("${base_dir}/probe_symlink")
    }

    // -------------------------------------------------------------
    // Test 1: Positive roundtrip (Writer & Reader)
    // -------------------------------------------------------------
    {
        var src_dir = "${base_dir}/src"
        var archive_path = "${base_dir}/test1.tar"
        var err = ""
        var r_err = ""
        var r_err_dir = ""
        var r_err_empty = ""
        var r_err_512 = ""
        var r_err_padded = ""
        var r_err_utf8 = ""
        var r_err_long = ""
        var r_err_sym = ""
        var r_err_eof = ""
        var long_name = ""
        var str_512 = ""
        var str_padded = ""
        defer {
            string_release(src_dir)
            string_release(archive_path)
            string_release(err)
            string_release(r_err)
            string_release(r_err_dir)
            string_release(r_err_empty)
            string_release(r_err_512)
            string_release(r_err_padded)
            string_release(r_err_utf8)
            string_release(r_err_long)
            string_release(r_err_sym)
            string_release(r_err_eof)
            string_release(long_name)
            string_release(str_512)
            string_release(str_padded)
        }

        fs.mkdir_p(src_dir)
        fs.mkdir_p("${src_dir}/a")
        fs.mkdir_p("${src_dir}/a/b")

        fs.write("${src_dir}/empty.txt", "")

        // 512-byte payload
        let sb_512 = strbuilder.new(512)
        var i = 0
        while i < 512 {
            strbuilder.append_byte(sb_512, 65) // 'A'
            i = i + 1
        }
        str_512 = strbuilder.finish(sb_512)
        fs.write("${src_dir}/a/512.txt", str_512)

        // 123-byte padded payload
        let sb_padded = strbuilder.new(128)
        i = 0
        while i < 123 {
            strbuilder.append_byte(sb_padded, 66) // 'B'
            i = i + 1
        }
        str_padded = strbuilder.finish(sb_padded)
        fs.write("${src_dir}/a/b/padded.txt", str_padded)

        // UTF-8 filename
        fs.write("${src_dir}/a/b/utf8_파일.txt", "UTF-8 content")

        // Create archive
        var w_ptr: ptr = null
        w_ptr, err = tar.writer_create(archive_path)
        assert(err == "", "writer_create failed: ${err}")

        err = tar.writer_add_directory(w_ptr, "dir", 493, 123456789) // 0o755
        assert(err == "", "add directory failed: ${err}")

        err = tar.writer_add_file(w_ptr, "dir/empty.txt", "${src_dir}/empty.txt")
        assert(err == "", "add empty failed: ${err}")

        err = tar.writer_add_file(w_ptr, "dir/512.txt", "${src_dir}/a/512.txt")
        assert(err == "", "add 512 failed: ${err}")

        err = tar.writer_add_file(w_ptr, "dir/padded.txt", "${src_dir}/a/b/padded.txt")
        assert(err == "", "add padded failed: ${err}")

        err = tar.writer_add_file(w_ptr, "dir/utf8_파일.txt", "${src_dir}/a/b/utf8_파일.txt")
        assert(err == "", "add utf8 failed: ${err}")

        // Test long path representation through ustar split
        long_name = "prefix_field_goes_here_to_be_represented_by_ustar_prefix_split_because_this_is_such_an_exceedingly_long_directory_name/suffix_name_of_the_file_is_here.txt"
        err = tar.writer_add_file(w_ptr, long_name, "${src_dir}/a/b/padded.txt")
        assert(err == "", "add long name failed: ${err}")

        if can_create_symlinks == 1 {
            err = tar.writer_add_symlink(w_ptr, "dir/sym.txt", "empty.txt", 511, 123456789) // 0o777
            assert(err == "", "add symlink failed: ${err}")
        }

        err = tar.writer_finish(w_ptr)
        assert(err == "", "writer_finish failed: ${err}")

        // Read & Validate archive
        var r_ptr: ptr = null
        r_ptr, r_err = tar.reader_open(archive_path)
        assert(r_err == "", "reader_open failed: ${r_err}")

        // 1. dir
        var ok = 0
        ok, r_err_dir = tar.reader_next(r_ptr)
        assert(r_err_dir == "" && ok == 1, "next failed on dir: ${r_err_dir}")
        assert(tar.entry_name(r_ptr) == "dir", "mismatch name")
        assert(tar.entry_kind(r_ptr) == tar.KIND_DIRECTORY, "mismatch kind")
        assert(tar.entry_mode(r_ptr) == 493, "mismatch mode")
        assert(tar.entry_mtime(r_ptr) == 123456789, "mismatch mtime")

        // 2. dir/empty.txt
        ok, r_err_empty = tar.reader_next(r_ptr)
        assert(r_err_empty == "" && ok == 1, "next failed on empty: ${r_err_empty}")
        assert(tar.entry_name(r_ptr) == "dir/empty.txt", "mismatch name")
        assert(tar.entry_size(r_ptr) == 0, "mismatch size")

        // 3. dir/512.txt (read in small chunks)
        ok, r_err_512 = tar.reader_next(r_ptr)
        assert(r_err_512 == "" && ok == 1, "next failed on 512: ${r_err_512}")
        assert(tar.entry_name(r_ptr) == "dir/512.txt", "mismatch name")
        assert(tar.entry_size(r_ptr) == 512, "mismatch size")

        var bytes_read = 0
        while bytes_read < 512 {
            var chunk, n, read_err = tar.entry_read(r_ptr, 13)
            assert(read_err == "", "read err: ${read_err}")
            assert(n > 0, "unexpected EOF")
            string_release(chunk)
            bytes_read = bytes_read + n
            string_release(read_err)
        }
        assert(bytes_read == 512, "mismatch payload size read")

        // 4. dir/padded.txt (test skip)
        ok, r_err_padded = tar.reader_next(r_ptr)
        assert(r_err_padded == "" && ok == 1, "next failed on padded: ${r_err_padded}")
        assert(tar.entry_name(r_ptr) == "dir/padded.txt", "mismatch name")

        var skip_err = tar.entry_skip(r_ptr)
        assert(skip_err == "", "skip failed: ${skip_err}")
        string_release(skip_err)

        // 5. dir/utf8_파일.txt
        ok, r_err_utf8 = tar.reader_next(r_ptr)
        assert(r_err_utf8 == "" && ok == 1, "next failed on utf8: ${r_err_utf8}")
        assert(tar.entry_name(r_ptr) == "dir/utf8_파일.txt", "mismatch name")

        // 6. long_name
        ok, r_err_long = tar.reader_next(r_ptr)
        assert(r_err_long == "" && ok == 1, "next failed on long_name: ${r_err_long}")
        assert(tar.entry_name(r_ptr) == long_name, "mismatch long_name")

        if can_create_symlinks == 1 {
            // 7. dir/sym.txt
            ok, r_err_sym = tar.reader_next(r_ptr)
            assert(r_err_sym == "" && ok == 1, "next failed on symlink: ${r_err_sym}")
            assert(tar.entry_name(r_ptr) == "dir/sym.txt", "mismatch name")
            assert(tar.entry_kind(r_ptr) == tar.KIND_SYMLINK, "mismatch kind")
            assert(tar.entry_link_name(r_ptr) == "empty.txt", "mismatch linkname")
        }

        // Clean EOF
        ok, r_err_eof = tar.reader_next(r_ptr)
        assert(r_err_eof == "" && ok == 0, "expected clean EOF: ${r_err_eof}")

        tar.reader_close(r_ptr)
        println("PASS: low-level writer and reader roundtrip")
    }

    // -------------------------------------------------------------
    // Test 2: Safe Extraction
    // -------------------------------------------------------------
    {
        var extract_dest = "${base_dir}/extract_dest"
        var ext_err = ""
        defer {
            string_release(extract_dest)
            string_release(ext_err)
        }

        fs.mkdir_p(extract_dest)

        var opts = tar.default_extract_options()
        opts.overwrite = 1
        opts.preserve_mode = 1
        opts.preserve_mtime = 1
        if can_create_symlinks == 1 {
            opts.allow_symlinks = 1
        }

        ext_err = tar.extract("${base_dir}/test1.tar", extract_dest, opts)
        assert(ext_err == "", "extraction failed: ${ext_err}")

        // Verify regular files, directories, modes and contents
        assert(fs.exists("${extract_dest}/dir") == 1, "dir missing")
        assert(fs.exists("${extract_dest}/dir/empty.txt") == 1, "empty missing")
        assert(fs.exists("${extract_dest}/dir/512.txt") == 1, "512 missing")
        assert(fs.exists("${extract_dest}/dir/padded.txt") == 1, "padded missing")
        assert(fs.exists("${extract_dest}/dir/utf8_파일.txt") == 1, "utf8 missing")

        // Check file size
        var s_sz, s_err = fs.size("${extract_dest}/dir/512.txt")
        assert(s_err == "" && s_sz == 512, "mismatch 512 size")
        string_release(s_err)

        var p_sz, p_err = fs.size("${extract_dest}/dir/padded.txt")
        assert(p_err == "" && p_sz == 123, "mismatch padded size")
        string_release(p_err)

        if can_create_symlinks == 1 {
            assert(fs.fs_is_symlink("${extract_dest}/dir/sym.txt") == 1, "symlink missing")
        }

        println("PASS: safe extraction and metadata preservation")
    }

    // Run modularized rejection/malformed/security tests
    test_bad_checksum(base_dir)
    test_truncated_header(base_dir)
    test_truncated_payload(base_dir)
    test_missing_padding(base_dir)
    test_invalid_size(base_dir)
    test_overflowing_size(base_dir)
    test_one_zero(base_dir)
    test_abs_path(base_dir)
    test_traversal(base_dir)
    test_nested_traversal(base_dir)
    test_windows_drive(base_dir)
    test_unc_path(base_dir)
    test_sym_escape(base_dir, can_create_symlinks)
    test_parent_symlink(base_dir, can_create_symlinks)
    test_max_entries(base_dir)
    test_max_entry_bytes(base_dir)
    test_max_total_bytes(base_dir)
    test_default_symlink_policy(base_dir)
    test_overwrite(base_dir)
    test_unsupported(base_dir)

    delete_recursive(base_dir)
    println("All PASS")
}
