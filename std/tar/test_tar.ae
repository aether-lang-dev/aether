test_truncated_payload(base_dir: string) {
    var tar_path = "${base_dir}/truncated_payload.tar"
    var r_err = ""
    var r_err2 = ""
    var read_err = ""
    var chunk = ""
    defer {
        string_release(tar_path)
        string_release(r_err)
        string_release(r_err2)
        string_release(read_err)
        string_release(chunk)
    }

    write_mock_tar(tar_path, "test.txt", 1000, 0, 48, false, false, "")
    let pad_buf = bytes.new(50)
    defer bytes.free(pad_buf)
    var p = 0
    while p < 50 {
        bytes.set(pad_buf, p, 65)
        p = p + 1
    }
    var pad_str = bytes.to_string(pad_buf, 50)
    io.append_file(tar_path, pad_str)
    string_release(pad_str)

    var r_ptr: ptr = null
    var ok = 0
    r_ptr, r_err = tar.reader_open(tar_path)
    assert(r_err == "", "open short payload")
    ok, r_err2 = tar.reader_next(r_ptr)
    assert(ok == 1, "next should succeed to read header")

    var read_n = 0
    chunk, read_n, read_err = tar.entry_read(r_ptr, 4096)
    assert(read_err != "" && string_index_of(read_err, "payload") >= 0, "expected payload read failure: ${read_err}")

    tar.reader_close(r_ptr)
    println("PASS: truncated file payload rejected")
}

