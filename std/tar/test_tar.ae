        string_release(r_err)
        string_release(r_err2)
    }

    let zero_buf = bytes.new(512)
    defer bytes.free(zero_buf)
    var z = 0
    while z < 512 {
        bytes.set(zero_buf, z, 0)
        z = z + 1
    }
    var zero_str = bytes.to_string(zero_buf, 512)
    fs.write_binary(tar_path, zero_str, 512)
    string_release(zero_str)

    var r_ptr: ptr = null
