    ok, r_err2 = tar.reader_next(r_ptr)
    assert(ok == 0 && string_index_of(r_err2, "truncated archive: missing second zero block") >= 0, "expected missing second zero block")
    tar.reader_close(r_ptr)
    println("PASS: archive with only one zero block rejected")
}

