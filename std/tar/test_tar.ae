import std.io
import std.fs
import std.path
import std.string
import std.bytes
import std.list
import std.tar
import std.strbuilder

extern exit(code: int)

assert(cond: bool, msg: string) {
    if !cond {
        println("FAIL: ${msg}")
        exit(1)
    }
}

// Helper: recursive delete for cleanups
delete_recursive(dir: string) {
    if fs.exists(dir) == 0 {
        return
    }
    let list = list_new()
    fs.walk(dir, | path: string, kind: int, depth: int | {
            list_add_raw(list, string_concat(path, ""))
            return 0
        })
    var i = list_size(list) - 1
    while i >= 0 {
        p = list_get_raw(list, i)
        st_kind, st_size, st_mtime, st_err = fs.file_stat(p)
        if st_kind == fs.STAT_KIND_DIR {
            fs.delete_dir(p)
        } else {
            fs.unlink(p)
        }
        string_release(st_err)
        i = i - 1
    }
    list_free(list)
    fs.delete_dir(dir)
}

calculate_checksum_test(block: string) -> long {
    var sum: long = 0
    var i = 0
    while i < 512 {
        if i >= 148 && i < 156 {
            sum = sum + 32
        } else {
            sum = sum + string_char_at_n(block, 512, i)
        }
        i = i + 1
    }
    return sum
}

// Helper to write a mock tar header with precision
write_mock_tar(path: string, name: string, size: long, chksum_val: long, typeflag: int, use_bad_chksum: bool, use_bad_size: bool, size_str: string) {
    let buf = bytes.new(512)
    defer bytes.free(buf)
    var j = 0
    while j < 512 {
        bytes.set(buf, j, 0)
        j = j + 1
    }
    bytes.copy_from_string(buf, 0, name, string_length(name))
    if use_bad_size {
        bytes.copy_from_string(buf, 124, size_str, string_length(size_str))
    } else {
        // Write size (12 bytes)
        var i = 0
        while i < 11 {
            bytes.set(buf, 124 + i, 48)
            i = i + 1
        }
        bytes.set(buf, 124 + 11, 0)
        var val = size
        var idx = 124 + 10
        while idx >= 124 && val > 0 {
            digit = (val % 8) as int
            bytes.set(buf, idx, 48 + digit)
            val = val / 8
            idx = idx - 1
        }
    }

    // Write mode
    var i = 0
    while i < 7 {
        bytes.set(buf, 100 + i, 48)
        i = i + 1
    }
    bytes.set(buf, 100 + 7, 0)
    bytes.set(buf, 100 + 6, 48 + 4) // '4'
    bytes.set(buf, 100 + 5, 48 + 2) // '2'
    bytes.set(buf, 100 + 4, 48 + 0) // '0'

    // Write uid/gid
    i = 0
    while i < 7 {
        bytes.set(buf, 108 + i, 48)
        bytes.set(buf, 116 + i, 48)
        i = i + 1
    }
    bytes.set(buf, 108 + 7, 0)
    bytes.set(buf, 116 + 7, 0)

    // Write mtime
    i = 0
    while i < 11 {
        bytes.set(buf, 136 + i, 48)
        i = i + 1
    }
    bytes.set(buf, 136 + 11, 0)

    bytes.set(buf, 156, typeflag)
    bytes.copy_from_string(buf, 257, "ustar", 5)
    bytes.set(buf, 262, 0)
    bytes.set(buf, 263, 48)
    bytes.set(buf, 264, 48)

    // Calculate checksum
    hdr_str = bytes.to_string(buf, 512)
    var sum = calculate_checksum_test(hdr_str)

    if use_bad_chksum {
        sum = chksum_val
    }

    // Write checksum
    i = 0
    while i < 6 {
        bytes.set(buf, 148 + i, 48)
        i = i + 1
    }
    bytes.set(buf, 148 + 6, 0)
    bytes.set(buf, 148 + 7, 32)
    var val2 = sum
    var idx2 = 148 + 5
    while idx2 >= 148 && val2 > 0 {
        digit = (val2 % 8) as int
        bytes.set(buf, idx2, 48 + digit)
        val2 = val2 / 8
        idx2 = idx2 - 1
    }

    final_hdr = bytes.to_string(buf, 512)
    fs.write_binary(path, final_hdr, 512)
    string_release(hdr_str)
    string_release(final_hdr)
}

test_bad_checksum(base_dir: string) {
    var tar_path = "${base_dir}/bad_checksum.tar"
    var r_err = ""
    var r_err2 = ""
    defer {
        string_release(tar_path)
        string_release(r_err)
        string_release(r_err2)
    }

    write_mock_tar(tar_path, "test.txt", 100, 99999 as long, 48, true, false, "")
    var r_ptr: ptr = null
    var ok = 0
    r_ptr, r_err = tar.reader_open(tar_path)
    assert(r_err == "", "open bad chksum")
    ok, r_err2 = tar.reader_next(r_ptr)
    assert(ok == 0 && string_index_of(r_err2, "checksum validation failed") >= 0, "expected checksum failure")
    tar.reader_close(r_ptr)
    println("PASS: bad checksum rejected")
}

