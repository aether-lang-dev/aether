    fs.mkdir_p(overwrite_dest)
    fs.mkdir_p("${overwrite_dest}/dir")
    fs.write("${overwrite_dest}/dir/empty.txt", "pre-existing content")

    var opts = tar.default_extract_options()
    opts.overwrite = 0
    ext_err = tar.extract("${base_dir}/test1.tar", overwrite_dest, opts)
    assert(ext_err != "" && string_index_of(ext_err, "already exists and overwrite is disabled") >= 0, "expected overwrite error")
    println("PASS: overwrite check enforced")
}

