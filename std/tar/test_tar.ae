test_sym_escape(base_dir: string, can_create_symlinks: int) {
    if can_create_symlinks == 1 {
        var tar_path = "${base_dir}/sym_escape.tar"
        var w_err = ""
        var err = ""
        var ext_err = ""
        defer {
            string_release(tar_path)
            string_release(w_err)
            string_release(err)
            string_release(ext_err)
        }

        var w_ptr: ptr = null
        w_ptr, w_err = tar.writer_create(tar_path)
        assert(w_err == "", "create sym_escape.tar")

        err = tar.writer_add_symlink(w_ptr, "sym_escaped", "../../outside.txt", 511, 123456789)
        assert(err == "", "add escaping symlink")

        err = tar.writer_finish(w_ptr)
        assert(err == "", "finish sym_escape.tar")

        var opts = tar.default_extract_options()
        opts.allow_symlinks = 1
        ext_err = tar.extract(tar_path, "${base_dir}/ext_sym_escape", opts)
        assert(ext_err != "" && string_index_of(ext_err, "escapes extraction root") >= 0, "expected symlink escape rejection: ${ext_err}")
        println("PASS: symlink escape target rejected")
    }
}

test_parent_symlink(base_dir: string, can_create_symlinks: int) {
    if can_create_symlinks == 1 {
        var tar_path = "${base_dir}/parent_symlink.tar"
        var w_err = ""
        var err = ""
        var ext_err = ""
        defer {
            string_release(tar_path)
            string_release(w_err)
            string_release(err)
            string_release(ext_err)
        }

        var w_ptr: ptr = null
        w_ptr, w_err = tar.writer_create(tar_path)
        assert(w_err == "", "create parent symlink tar")

        err = tar.writer_add_symlink(w_ptr, "link", "sub", 511, 123456789)
        assert(err == "", "add symlink link")

        fs.write("${base_dir}/dummy_empty.txt", "")
        err = tar.writer_add_file(w_ptr, "link/file.txt", "${base_dir}/dummy_empty.txt")
        assert(err == "", "add link/file.txt")
        fs.unlink("${base_dir}/dummy_empty.txt")

        err = tar.writer_finish(w_ptr)
        assert(err == "", "finish parent_symlink.tar")

        var opts = tar.default_extract_options()
        opts.allow_symlinks = 1
        ext_err = tar.extract(tar_path, "${base_dir}/ext_parent_sym", opts)
        assert(ext_err != "" && string_index_of(ext_err, "resolves through a symlink") >= 0, "expected parent symlink rejection: ${ext_err}")
        println("PASS: parent component as symlink rejected")
    }
}

