// std.tcp - TCP Socket Operations (alias for std.net)
//
// Raw externs end in `_raw` and return NULL/int in C-style. Aether-native
// wrappers (below) use Go-style `(value, err)` tuple returns.
// The implementations are in std/net/aether_net.c.

exports(
    tcp_connect_raw, tcp_send_raw,
    tcp_receive_raw, tcp_receive_n_raw, tcp_close,
    tcp_listen_raw, tcp_listen_on_raw, tcp_accept_raw, tcp_server_close,
    tcp_server_port_raw, tcp_server_poll_raw, tcp_set_nodelay_raw,
    tcp_fd_raw, tcp_server_fd_raw, tcp_poll_raw, tcp_poll2_raw,
    tcp_send_bytes_raw, tcp_receive_into_raw,
    connect, write, write_n, write_slice, read, read_n, read_into,
    listen, listen_on, accept, fd, server_fd,
    server_port, server_poll, set_nodelay, poll, poll2
)

// Raw externs - escape hatch
extern tcp_connect_raw(host: string, port: int) -> ptr
extern tcp_send_raw(sock: ptr, data: string) -> int
// `data` is `ptr`, not `string`, and this is not exported (#2301): write_n
// passes a byte[] slice's raw data pointer. A `string` parameter routes
// through the AetherString unwrap, which would misread a payload beginning
// with the header's magic bytes as a header — for a relay forwarding a
// peer's bytes, that is the peer choosing which memory gets sent. And a
// heap string passed to a `ptr` parameter would send its header. std.net
// no longer declares this symbol, so the two prototypes cannot disagree.
extern tcp_send_n_raw(sock: ptr, data: ptr, length: int) -> int
// A fresh buffer the caller owns, as std.net declares it; a plain `-> string`
// here took it for borrowed and leaked one buffer per read.
extern tcp_receive_raw(sock: ptr, max_bytes: int) -> string @heap
extern tcp_receive_n_raw(sock: ptr, max_bytes: int) -> (string @heap, int, string)
extern tcp_send_bytes_raw(sock: ptr, data: ptr, length: int) -> int
extern tcp_receive_into_raw(sock: ptr, buf: ptr, cap: int) -> int
extern tcp_close(sock: ptr) -> int
extern tcp_listen_raw(port: int) -> ptr
extern tcp_listen_on_raw(address: string, port: int) -> ptr
extern tcp_server_port_raw(server: ptr) -> int
extern tcp_server_poll_raw(server: ptr, timeout_ms: int) -> int
extern tcp_set_nodelay_raw(sock: ptr, on: int) -> int
extern tcp_accept_raw(server: ptr) -> ptr
extern tcp_server_close(server: ptr) -> int
extern tcp_fd_raw(sock: ptr) -> int
extern tcp_server_fd_raw(server: ptr) -> int
extern tcp_poll_raw(sock: ptr, timeout_ms: int) -> int
extern tcp_poll2_raw(a: ptr, b: ptr, timeout_ms: int) -> int

// Connect to host:port. Returns (socket, "") on success, (null, error)
// on failure. Caller must tcp.close the returned socket.
connect(host: string, port: int) -> {
    sock = tcp_connect_raw(host, port)
    if sock == null {
        return null, "connect failed"
    }
    return sock, ""
}

// Write data to a socket. Returns (bytes_sent, "") on success,
// (0, error) on failure.
//
// Note: named `write`/`read` (not `send`/`receive`) because `send` and
// `receive` are reserved actor keywords in Aether. The `tcp.send_raw`
// extern is still available under the old name for direct use.
write(sock: ptr, data: string) -> {
    n = tcp_send_raw(sock, data)
    if n < 0 {
        return 0, "send failed"
    }
    return n, ""
}

// Length-aware socket write: sends the bytes of `data`, whose length
// travels with the slice (#2301), so embedded NUL bytes do not truncate
// the send. Returns the OS send(2) byte count; callers that require
// full-buffer delivery should loop, sending `data[n..]` until every byte
// has been accepted. An empty slice sends nothing and returns (0, "").
//
// For a string, send its byte view: `tcp.write_n(sock, string.bytes(s))`,
// a prefix with `string.bytes(s)[0..n]`; for a `std.bytes` buffer,
// `bytes.view(buf)`.
write_n(sock: ptr, data: byte[]) -> {
    if data.len < 0 {
        panic("tcp.write_n: the slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`")
    }
    if data.len == 0 {
        return 0, ""
    }
    n = tcp_send_n_raw(sock, data, data.len)
    if n < 0 {
        return 0, "send failed"
    }
    return n, ""
}

// Read up to max_bytes from a socket. Returns (data, "") on success,
// ("", error) on transport failure or connection close. The caller owns
// the data. This text wrapper is strlen-shaped; use read_n when the
// payload may contain embedded NUL bytes.
read(sock: ptr, max_bytes: int) -> {
    data = tcp_receive_raw(sock, max_bytes)
    if data == null {
        return "", "connection closed or receive failed"
    }
    return data, ""
}

// Binary-safe read. Returns (bytes, length, "") on success, with the
// byte buffer stored in a length-aware AetherString. The returned
// length is authoritative; callers should pass it to length-aware
// consumers rather than re-derive length with strlen-shaped APIs.
//
// Error discipline (#1092): a quiet-but-alive peer (recv-timeout /
// would-block) returns ("", 0, "timeout") and leaves the socket
// connected — retry or poll, do NOT treat it as a close. Only an
// orderly FIN or a hard error returns "connection closed or receive
// failed"; that is the terminal state. A full-duplex relay must branch
// on the "timeout" sentinel rather than collapsing all non-empty errors
// into "closed."
read_n(sock: ptr, max_bytes: int) -> {
    return tcp_receive_n_raw(sock, max_bytes)
}

// A slice with no bound (`p as byte[]`, `.len` -1) has no length to send
// or to receive into: refuse it rather than guess one (#2301).
fn need_bound(fname: string, s: byte[]) {
    if s.len < 0 {
        panic("tcp.${fname}: the slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`")
    }
}

// Write a `byte[]` slice's bytes, binary-safe: the length travels with
// the slice (#2301). Returns (bytes_sent, "") or (0, "send failed"). The
// count is one send(2) and may be SHORT, as with write_n: a caller that
// needs the whole slice delivered loops on the rest, `s[sent..]`. An empty
// slice sends nothing and returns (0, ""). A slice with no bound panics.
write_slice(sock: ptr, s: byte[]) -> {
    need_bound("write_slice", s)
    n = tcp_send_bytes_raw(sock, s, s.len)
    if n < 0 {
        return 0, "send failed"
    }
    return n, ""
}

// Read into a caller-owned `byte[]` (#2301): one receive of at most
// `buf.len` bytes, nothing allocated, never a byte past `buf.len`. Returns
// (n, "") with the data in `buf[0..n]`, which may be fewer bytes than
// asked. Errors follow read_n: (0, "timeout") for a quiet peer (the socket
// stays connected: retry or poll), (0, "connection closed or receive
// failed") for an orderly close or an error (terminal). An empty slice
// returns (0, "receive buffer is empty") without touching the socket; a
// slice with no bound panics.
read_into(sock: ptr, buf: byte[]) -> {
    need_bound("read_into", buf)
    if buf.len == 0 {
        return 0, "receive buffer is empty"
    }
    n = tcp_receive_into_raw(sock, buf, buf.len)
    if n == -2 {
        return 0, "timeout"
    }
    if n < 0 {
        return 0, "connection closed or receive failed"
    }
    return n, ""
}

// Wait until `sock` is readable, up to timeout_ms (-1 blocks, 0 polls,
// >0 waits that many ms). Returns (true, "") when a subsequent read_n
// will not block, (false, "") on timeout, (false, error) if the handle
// is closed or poll failed. Neither reads nor closes the socket — pair
// it with read_n to build a nonblocking loop over a single direction.
poll(sock: ptr, timeout_ms: int) -> {
    rc = tcp_poll_raw(sock, timeout_ms)
    if rc < 0 {
        return false, "poll failed"
    }
    if rc == 0 {
        return false, ""
    }
    return true, ""
}

// Wait on two sockets at once — the full-duplex relay primitive. Returns
// (a_ready, b_ready, "") where each flag is true when that side is
// readable (both may be true); (false, false, "") on timeout;
// (false, false, error) if both handles are closed or poll failed.
// Service whichever side is ready with read_n, then re-poll.
poll2(a: ptr, b: ptr, timeout_ms: int) -> {
    rc = tcp_poll2_raw(a, b, timeout_ms)
    if rc < 0 {
        return false, false, "poll failed"
    }
    a_ready = (rc & 1) != 0
    b_ready = (rc & 2) != 0
    return a_ready, b_ready, ""
}

// Listen on a port. Returns (server, "") on success, (null, error) on
// failure. Caller must tcp.server_close the returned server.
listen(port: int) -> {
    server = tcp_listen_raw(port)
    if server == null {
        return null, "listen failed"
    }
    return server, ""
}

// Listen on ONE address (#2136): "127.0.0.1" for a loopback-only
// channel that the network cannot reach, "0.0.0.0" for every interface
// (what `listen` does). Port 0 asks the OS for an ephemeral port; read it
// back with `server_port`. Returns (server, "") or (null, error).
listen_on(address: string, port: int) -> {
    server = tcp_listen_on_raw(address, port)
    if server == null {
        return null, "listen failed"
    }
    return server, ""
}

// The port a server is bound to — the one the OS chose for a
// `listen_on(addr, 0)` — or -1 for a null handle.
server_port(server: ptr) -> int {
    return tcp_server_port_raw(server)
}

// Wait up to timeout_ms for a connection to be waiting, so `accept` will
// not block: 1 = a connection is queued, 0 = timeout, -1 = null handle or
// error. A serving loop with a stop flag polls this between checks of the
// flag instead of blocking in `accept` (closing the listener from another
// thread does not wake `accept` on Linux).
server_poll(server: ptr, timeout_ms: int) -> int {
    return tcp_server_poll_raw(server, timeout_ms)
}

// TCP_NODELAY: send each write at once instead of waiting to coalesce it
// (Nagle). Request/response lines want it on. Returns "" on success or
// an error; `setsockopt` cannot be declared from Aether because the
// runtime's headers already declare it with the platform's signature.
set_nodelay(sock: ptr, on: bool) -> string {
    flag = 0
    if on { flag = 1 }
    if tcp_set_nodelay_raw(sock, flag) != 0 {
        return "set_nodelay failed"
    }
    return ""
}

// Accept an incoming connection. Returns (socket, "") on success,
// (null, error) on failure or shutdown.
accept(server: ptr) -> {
    sock = tcp_accept_raw(server)
    if sock == null {
        return null, "accept failed"
    }
    return sock, ""
}

// The OS-level descriptor inside a connected socket, or -1 if the
// handle is null/closed (#1003). Exists for capability plumbing:
// connect through the stdlib, then narrow the descriptor with
// capsicum.rights_limit(tcp.fd(sock), ...) before capsicum.enter().
// The fd is owned by the handle — do not close it directly; it is
// released by tcp.close.
fd(sock: ptr) -> int {
    return tcp_fd_raw(sock)
}

// The OS-level listening descriptor inside a server handle, or -1 if
// the handle is null (#1003). Same ownership rule: released by
// tcp.server_close, never closed directly.
server_fd(server: ptr) -> int {
    return tcp_server_fd_raw(server)
}
