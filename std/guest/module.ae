// std.guest: an Aether host running a guest in a separate, sandboxed child
// process, and talking to it both ways over std.ipc.
//
// The guest is a worker program: an engine for some language with nothing
// of its own to reach the world through. Every SAY and every call to a
// function the host mounted comes up the socket as a frame, and the host
// answers it. Two walls hold the child: the process sandbox the host spawns
// it in (sandbox.spawn_socket), and the worker's own sandbox.enforce, which
// it enters with no grants before its script's first step. The worker's
// half is std.guest.child; README.md beside this file has the protocol,
// every message in both directions, and docs/design/guest-host-calls-guest.md
// the design of the host-calls-guest direction.
//
// The host may call the guest too. A script that leaves functions behind
// ends with READY and their names instead of DONE; the guest then serves:
// it sits idle until the host INVOKEs one of them (answered with RETURN or
// RAISE, with SAY, LOG and the guest's own CALLs on the way) or ENDs it
// (answered with DONE 0). Host and guest strictly alternate: the host
// invokes only an idle guest, one invocation at a time, and a guest never
// invokes the host's functions any other way than CALL. A script that
// exports nothing sends DONE exactly as before.
//
// Deadlines. Each exchange, from what the host last sent or received to the
// guest's next frame, is bounded by `deadline_ms`, inside an invocation as
// inside the script. When it passes the host sends CANCEL; a guest whose
// script is looping or waiting on a reply stops it in the engine and
// answers ERROR "cancelled by host: ...". One that does not answer within
// `grace_ms` is hung up on and killed. A frame over `max_frame`, a
// malformed one or one that stalls part way is refused the same way. An
// idle guest has no deadline: the host decides when it is next spoken to.
// Every spawn, GRANT, DENY, INVOKE, END, timeout, cancel and kill goes to
// one audit log, with what the guest reported from its own sandbox.
//
// Usage, the loop written out:
//
//   perms = sandbox.new("rexx") {}            // the worker reads nothing
//   g, err = guest.launch(perms, "build/rexxae-worker", null, "rexx", "audit.log")
//   guest.mount(&g, "GREET", 1, 1)
//   guest.start(&g, source)
//   while true {
//       e = guest.next(&g)
//       if e.kind == "SAY" { println(guest.printable(e.text)) }
//       else if e.kind == "CALL" { guest.answer(&g, guest.json_string("hi")) }
//       else if e.kind == "LOG" { }           // only after guest.log_level
//       else { break }                        // DONE, ERROR, KILLED or READY
//   }
//
// or with the loop written once, in run_script and call_export, and only
// the host's own functions in a handler:
//
//   e = guest.run_script(&g, source) callback | h: *guest.Guest, ev: guest.Event | {
//       if ev.kind == "CALL" { guest.answer(h, guest.json_string("hi")) }
//   }
//   if e.kind == "READY" {
//       v, verr = guest.call_export(&g, "on_tick", "[1]") callback | h: *guest.Guest, ev: guest.Event | {
//           // the export's CALLs to the host's functions, answered here
//       }
//       guest.end(&g)
//       guest.next(&g)                        // DONE 0
//   }

exports(Guest, Event, launch, launch_uncontained, mount, probe, log_level,
    start, answer, fail, grant_file, deny, cancel, next, close, audit,
    invoke, end, result, is_exported, is_serving, run_script, call_export,
    json_string, printable, level_name, MAX_FRAME, DEADLINE_MS, GRACE_MS,
    MAX_EXPORTS, MAX_EXPORT_NAME, SCRIPT, SERVING, INVOKING, ENDING, CANCELLED)

import std.io
import std.ipc
import std.list
import std.os
import std.sandbox
import std.string

// The largest frame either side accepts.
const MAX_FRAME = 65536
// The default bound on one exchange, and on the answer to a CANCEL.
const DEADLINE_MS = 5000
const GRACE_MS = 1000
// The most functions a guest may export, and the longest name of one, in
// bytes. A READY over either is a protocol error: the guest is hung up on.
const MAX_EXPORTS = 256
const MAX_EXPORT_NAME = 128

// Where a guest's conversation is (Guest.phase):
//   SCRIPT     its script runs (from launch to READY or DONE)
//   SERVING    its script has ended with READY: idle, waiting for INVOKE or END
//   INVOKING   an invocation runs (from INVOKE to RETURN or RAISE)
//   ENDING     END has been sent: only DONE (or ERROR) may come
//   CANCELLED  CANCEL has been sent: the guest is ending (see cancelling)
const SCRIPT = 0
const SERVING = 1
const INVOKING = 2
const ENDING = 3
const CANCELLED = 4

// A running guest. `deadline_ms`, `grace_ms` and `max_frame` may be changed
// at any time.
struct Guest {
    ch: int
    pid: int
    name: string
    audit_path: string
    deadline_ms: int
    grace_ms: int
    max_frame: int
    // 1 once DONE, ERROR or KILLED has been returned: the child is reaped.
    over: int
    // SCRIPT, SERVING, INVOKING, ENDING or CANCELLED (above).
    phase: int
    // What READY exported: a JSON array of names, written ["a","b"]
    // whatever spacing the guest used; "[]" before READY.
    exported: string
    // 1 from a CALL until the host answers it (answer, fail, grant_file,
    // deny).
    pending: int
}

// One thing the guest did. kind is
//   SAY     text
//   LOG     code = the level 0..5, name = TRACE .. FATAL, text = the
//           message, tags = a JSON object; nothing to answer
//   CALL    name, text = the arguments as a JSON array; answer it with
//           answer, fail, grant_file or deny before the next call to next
//   DONE    code, the script's exit code
//   ERROR   text, the guest's message ("cancelled by host: ..." after a
//           deadline or a cancel)
//   KILLED  text, why the host hung up and killed it
//   READY   text = the exported names as a JSON array (also g.exported):
//           the script has ended and the guest serves; invoke, or end
//   RETURN  text = the JSON value the invoked function returned
//   RAISE   text = the error the invoked function raised; the guest
//           still serves
//   IDLE    next was called while the guest serves: nothing was read
struct Event {
    kind: string
    name: string
    text: string
    code: int
    tags: string
}

fn event(kind: string, name: string, text: string, code: int) -> Event {
    return Event { kind: kind, name: name, text: text, code: code, tags: "" }
}

// TRACE, DEBUG, INFO, WARN, ERROR or FATAL for a level 0..5; "?" otherwise.
level_name(level: int) -> string {
    match level {
        0 -> { return "TRACE" }
        1 -> { return "DEBUG" }
        2 -> { return "INFO" }
        3 -> { return "WARN" }
        4 -> { return "ERROR" }
        5 -> { return "FATAL" }
        _ -> { return "?" }
    }
}

// "<level> <n> <tags> <message>" from a LOG frame, or why it is malformed.
fn log_event(rest: string) -> (Event, string) {
    level_text, after_level = split_verb(rest)
    count_text, after_count = split_verb(after_level)
    level, lerr = string.to_int(level_text)
    count, cerr = string.to_int(count_text)
    if lerr != "" || cerr != "" || level < 0 || level > 5 || count < 2 || count > string.length(after_count) {
        return event("LOG", "", "", -1), "protocol: malformed LOG"
    }
    tags = string.substring(after_count, 0, count)
    msg = ""
    if string.length(after_count) > count + 1 {
        msg = string.substring(after_count, count + 1, string.length(after_count))
    }
    e = event("LOG", level_name(level), msg, level)
    e.tags = tags
    return e, ""
}

fn new_guest(ch: int, pid: int, name: string, audit_path: string) -> Guest {
    return Guest {
        ch: ch, pid: pid, name: name, audit_path: audit_path,
        deadline_ms: DEADLINE_MS, grace_ms: GRACE_MS, max_frame: MAX_FRAME, over: 0,
        phase: SCRIPT, exported: "[]", pending: 0
    }
}

// Starts the worker program `prog` in a child held to `perms`
// (sandbox.spawn_socket), with `args`, a std.list of strings, as its
// arguments (null for none: an Aether worker reads everything from the
// socket; a foreign interpreter takes its script, `-I guest.py`). Fails closed: where the child cannot be contained
// (macOS, Windows; Linux without Landlock) it returns the reason and starts
// nothing. `name` labels the audit log lines; `audit_path` is the log (""
// for none). An Aether worker needs no grants to run a script: it is one
// binary and reads its script from the socket.
launch(perms: sandbox.Grants, prog: string, args: ptr, name: string, audit_path: string) -> (Guest, string) {
    argv = if args == null { list.new() } else { args }
    env = list.new()
    ch, pid, err = sandbox.spawn_socket(perms, prog, argv, env)
    if args == null { list.free(argv) }
    list.free(env)
    g = new_guest(ch, pid, name, audit_path)
    if err != "" {
        g.over = 1
        audit(&g, "SPAWN refused: ${err}")
        return g, err
    }
    audit(&g, "SPAWN ${prog} (sandbox.spawn_socket)")
    return g, ""
}

// launch with NO process sandbox (sandbox.spawn_socket_uncontained), for
// development where spawn_socket refuses (macOS). The worker still locks
// itself down with sandbox.enforce. The audit log says which it was.
launch_uncontained(perms: sandbox.Grants, prog: string, args: ptr, name: string, audit_path: string) -> (Guest, string) {
    argv = if args == null { list.new() } else { args }
    env = list.new()
    ch, pid, err = sandbox.spawn_socket_uncontained(perms, prog, argv, env)
    if args == null { list.free(argv) }
    list.free(env)
    g = new_guest(ch, pid, name, audit_path)
    if err != "" {
        g.over = 1
        audit(&g, "SPAWN refused: ${err}")
        return g, err
    }
    audit(&g, "SPAWN ${prog} UNCONTAINED (sandbox.spawn_socket_uncontained)")
    return g, ""
}

// Mounts a host function `name` taking min..max arguments. Before start.
mount(g: *Guest, name: string, min: int, max: int) -> string {
    return ipc.write_frame(g.ch, "MOUNT ${name} ${min} ${max}")
}

// Asks the guest to check its own wall once it has locked down: it tries
// to read /etc/passwd and connect to 1.1.1.1:443 and reports both as AUDIT
// lines. Before start.
probe(g: *Guest) -> string {
    return ipc.write_frame(g.ch, "PROBE")
}

// Sets the guest's log threshold: -1 off (the default), 0 trace, 1 debug,
// 2 info, 3 warn, 4 error, 5 fatal. Before start it holds from the first
// step; after, from the guest's next step, also while a CALL waits for its
// answer. Out of range: the error, and nothing is sent.
log_level(g: *Guest, level: int) -> string {
    if level < -1 || level > 5 { return "log_level: -1 (off) or 0..5, not ${level}" }
    return ipc.write_frame(g.ch, "LOGLEVEL ${level}")
}

// Sends the script; the guest locks itself down and runs it. A max_frame
// set below MAX_FRAME goes first, as MAXFRAME, so the worker holds what it
// sends to the limit this host will read: a RETURN it cannot send whole it
// can RAISE instead (std.guest.child, returned). At the default nothing
// extra is sent. A max_frame lowered after start the worker does not hear
// of: its frames over it are refused here, and the guest killed.
start(g: *Guest, source: string) -> string {
    if g.max_frame < MAX_FRAME {
        err = ipc.write_frame(g.ch, "MAXFRAME ${g.max_frame}")
        if err != "" { return err }
    }
    return ipc.write_frame(g.ch, "SCRIPT ${source}")
}

// Answers the pending CALL with a JSON value.
answer(g: *Guest, json: string) -> string {
    g.pending = 0
    return ipc.write_frame(g.ch, "REPLY ${json}")
}

// Fails the pending CALL; the script sees an error with this message.
fail(g: *Guest, why: string) -> string {
    g.pending = 0
    return ipc.write_frame(g.ch, "FAIL ${why}")
}

// Answers the pending CALL, a request for the file `name`, with the file at
// `path` as an open descriptor: the guest reads it and the script gets
// {"granted":true,"text":...}. If `path` cannot be opened it is a deny.
grant_file(g: *Guest, name: string, path: string) -> string {
    fd, oerr = io.fd_open_read(path)
    if oerr != "" { return deny(g, name, oerr) }
    g.pending = 0
    audit(g, "GRANT ${printable(name)} -> ${path}")
    err = ipc.write_frame(g.ch, "FILE")
    if err == "" { err = ipc.send_fd(g.ch, fd, "F") }
    io.fd_close(fd)
    return err
}

// Answers the pending CALL, a request for the file `name`, with no: the
// script gets {"granted":false,"why":why}.
deny(g: *Guest, name: string, why: string) -> string {
    audit(g, "DENY ${printable(name)}: ${why}")
    g.pending = 0
    return ipc.write_frame(g.ch, "REPLY {\"granted\":false,\"why\":${json_string(why)}}")
}

// Asks the guest to stop now: its script, its invocation, or (serving)
// itself. next() then returns its ERROR. A cancel ends the guest
// (cancelling, below).
cancel(g: *Guest, reason: string) -> string {
    audit(g, "CANCEL ${reason}")
    err = ipc.write_frame(g.ch, "CANCEL ${reason}")
    if err == "" && g.over == 0 { cancelling(g) }
    return err
}

// Open question (i), decided here and nowhere else on the host: a cancel,
// the host's own or a passed deadline's, ENDS THE GUEST, inside an
// invocation as inside its script, because the function's state is half
// done. From here only ERROR (or DONE) ends the exchange; a READY, RETURN
// or RAISE already on its way is dropped (next), and deadline_passed waits
// for ERROR or DONE alone. The alternative, ending only the invocation,
// would keep an INVOKING guest INVOKING here, take a RAISE as the answer
// to the cancel in deadline_passed too, and have the worker answer a
// cancel inside an invocation with RAISE (std.guest.child, serve).
fn cancelling(g: *Guest) {
    g.phase = CANCELLED
}

// Open question (ii), decided here: an invocation has NO total time
// budget. Each exchange inside it is bounded by deadline_ms, as in a
// script, so an export that keeps calling the host runs as long as the
// host keeps answering. A budget would be the remainder of it, when
// smaller, returned from here while the phase is INVOKING.
fn exchange_deadline_ms(g: *Guest) -> int {
    return g.deadline_ms
}

// Open question (iii), decided here: INVOKE carries NO sequence number.
// What can be checked without one is checked: a guest that is idle has
// nothing to say, so a frame from it before the host's INVOKE or END (or
// when next is called on it) is unsolicited, and the host hangs up. A
// RETURN the guest sends after the host's INVOKE has gone but before it
// has read it cannot be told from the answer, and is taken as one: the
// guest can only lie about its own function, which it could anyway. A
// number that RETURN and RAISE echo would close that; it would be checked
// here and in next. "" when the guest is quiet, or why to hang up.
fn unsolicited_while_idle(g: *Guest) -> string {
    ready, werr = ipc.wait_readable(g.ch, 0)
    if werr != "" { return "while the guest was idle: ${werr}" }
    if ready == 0 { return "" }
    data, rerr = ipc.read_frame_timeout(g.ch, g.max_frame, g.grace_ms)
    if rerr != "" { return "while the guest was idle: ${rerr}" }
    verb, _rest = split_verb(data)
    return "protocol: '${printable(verb)}' from the guest while it was idle"
}

// The guest's next event, waiting at most deadline_ms for it (see the top
// of this file). AUDIT frames go to the audit log and are not returned.
next(g: *Guest) -> Event {
    if g.over == 1 { return event("ERROR", "", "the guest has finished", -1) }
    // A serving guest is idle until the host invokes or ends it: there is
    // nothing to wait for, and waiting would only run the deadline down.
    if g.phase == SERVING {
        uerr = unsolicited_while_idle(g)
        if uerr != "" { return hang_up(g, uerr) }
        return event("IDLE", "", "the guest serves; invoke or end it", 0)
    }
    while true {
        data, rerr = ipc.read_frame_timeout(g.ch, g.max_frame, exchange_deadline_ms(g))
        // Nothing of a frame arrived: the stream is still in step, so CANCEL
        // can go down it. Any other error (a frame that stalled part way
        // included) leaves it out of step.
        if rerr == ipc.TIMED_OUT_BETWEEN_FRAMES { return deadline_passed(g) }
        if rerr != "" { return hang_up(g, "frame refused: ${rerr}") }
        verb, rest = split_verb(data)
        // After END the guest may only finish.
        if g.phase == ENDING && verb != "AUDIT" && verb != "DONE" && verb != "ERROR" {
            return hang_up(g, "protocol: '${printable(verb)}' after END")
        }
        match verb {
            "AUDIT" -> { audit(g, "reports: ${printable(rest)}") }
            "SAY" -> { return event("SAY", "", rest, 0) }
            "LOG" -> {
                e, lerr = log_event(rest)
                if lerr != "" { return hang_up(g, lerr) }
                return e
            }
            "CALL" -> {
                name, args = split_verb(rest)
                g.pending = 1
                return event("CALL", name, args, 0)
            }
            "DONE" -> { return ended(g, verb, rest) }
            "ERROR" -> { return ended(g, verb, rest) }
            "READY" -> {
                if g.phase == CANCELLED {
                    audit(g, "READY after CANCEL, dropped")
                } else if g.phase != SCRIPT {
                    return hang_up(g, "protocol: a second READY")
                } else {
                    names, xerr = check_exports(rest)
                    if xerr != "" { return hang_up(g, "protocol: READY ${xerr}") }
                    g.exported = names
                    g.phase = SERVING
                    audit(g, "READY exports ${names}")
                    return event("READY", "", names, 0)
                }
            }
            "RETURN" -> {
                if g.phase == CANCELLED {
                    audit(g, "RETURN after CANCEL, dropped")
                } else if g.phase != INVOKING {
                    return hang_up(g, "protocol: RETURN with no INVOKE")
                } else {
                    g.phase = SERVING
                    g.pending = 0
                    return event("RETURN", "", rest, 0)
                }
            }
            "RAISE" -> {
                if g.phase == CANCELLED {
                    audit(g, "RAISE after CANCEL, dropped")
                } else if g.phase != INVOKING {
                    return hang_up(g, "protocol: RAISE with no INVOKE")
                } else {
                    g.phase = SERVING
                    g.pending = 0
                    why = if rest == "" { "guest function failed" } else { rest }
                    audit(g, "RAISE ${printable(why)}")
                    return event("RAISE", "", why, 0)
                }
            }
            _ -> { return hang_up(g, "protocol: unexpected '${printable(verb)}'") }
        }
    }
}

// DONE <code> or ERROR <message>: the guest has finished; reap it.
fn ended(g: *Guest, verb: string, rest: string) -> Event {
    if verb == "ERROR" {
        audit(g, "ERROR ${printable(rest)}")
        finish(g)
        return event("ERROR", "", rest, -1)
    }
    code, cerr = string.to_int(rest)
    if cerr != "" { code = -1 }
    finish(g)
    return event("DONE", "", "", code)
}

// The exchange ran out of time with nothing received, so the stream is
// still between frames: ask the guest to cancel and give it grace_ms to
// say it has.
fn deadline_passed(g: *Guest) -> Event {
    ms = exchange_deadline_ms(g)
    audit(g, "TIMEOUT no frame within ${ms} ms; CANCEL sent")
    serr = ipc.write_frame(g.ch, "CANCEL deadline of ${ms} ms passed")
    if serr != "" { return hang_up(g, "CANCEL not delivered: ${serr}") }
    cancelling(g)
    while true {
        data, rerr = ipc.read_frame_timeout(g.ch, g.max_frame, g.grace_ms)
        if rerr == ipc.TIMED_OUT_BETWEEN_FRAMES {
            return hang_up(g, "no answer to CANCEL within ${g.grace_ms} ms")
        }
        if rerr != "" { return hang_up(g, "after CANCEL: ${rerr}") }
        verb, rest = split_verb(data)
        if verb == "ERROR" || verb == "DONE" { return ended(g, verb, rest) }
        if verb == "AUDIT" { audit(g, "reports: ${printable(rest)}") }
        // A SAY, LOG, CALL, READY, RETURN or RAISE already on its way when
        // the CANCEL went: dropped.
    }
}

// Hangs up and kills the guest.
fn hang_up(g: *Guest, why: string) -> Event {
    audit(g, "KILLED ${why}")
    io.fd_close(g.ch)
    // Never a pid of 0 or below: kill(2) would take a process group, or all.
    if g.pid > 0 {
        os.kill(g.pid, 9)
        os.wait_pid(g.pid)
    }
    g.over = 1
    return event("KILLED", "", why, -1)
}

// After DONE or ERROR: hang up and reap. A guest that says it is done and
// then does not exit is killed after grace_ms (rounded up to a second).
fn finish(g: *Guest) {
    io.fd_close(g.ch)
    g.over = 1
    if g.pid <= 0 { return }
    secs = (g.grace_ms + 999) / 1000
    _status, timed_out, _err = os.wait_pid_timeout(g.pid, secs)
    if timed_out != 0 {
        audit(g, "KILLED did not exit after it finished")
        os.kill(g.pid, 9)
        os.wait_pid(g.pid)
    }
}

// Calls the guest's exported function `name` with `args`, a JSON array.
// Only while the guest serves: after READY, and after the RETURN or RAISE
// that ended the last invocation. The host then reads the invocation's
// events with next as it reads a script's: SAY, LOG, CALL (answer each),
// and at the end RETURN or RAISE, each exchange bounded by deadline_ms. A
// deadline that passes cancels the guest, which ends it. "" when sent, or
// why nothing was: the guest is not serving (its script, an invocation or
// a host call it waits on is still running, or it is ending), it does not
// export `name`, `args` is not an array, or the INVOKE frame would be
// longer than MAX_FRAME, the most a worker reads. A frame the idle guest sent
// unasked is a protocol error: the host hangs up and says so.
invoke(g: *Guest, name: string, args: string) -> string {
    if g.over == 1 { return "invoke: the guest has finished" }
    refused = not_serving(g, "invoke")
    if refused != "" { return refused }
    if !is_exported(g, name) { return "invoke: the guest does not export '${printable(name)}'" }
    if !is_array_text(args) { return "invoke: the arguments are a JSON array, not '${printable(args)}'" }
    frame = "INVOKE ${name} ${args}"
    if string.length(frame) > MAX_FRAME {
        return "invoke: the INVOKE frame would be ${string.length(frame)} bytes, over the frame limit of ${MAX_FRAME} bytes a worker reads"
    }
    uerr = unsolicited_while_idle(g)
    if uerr != "" {
        hang_up(g, uerr)
        return "invoke: ${uerr}"
    }
    audit(g, "INVOKE ${name}")
    err = ipc.write_frame(g.ch, frame)
    if err == "" { g.phase = INVOKING }
    return err
}

// Ends a serving guest politely: END, which it answers with DONE 0 (next
// returns it, and reaps the guest). "" or why nothing was sent.
end(g: *Guest) -> string {
    if g.over == 1 { return "end: the guest has finished" }
    refused = not_serving(g, "end")
    if refused != "" { return refused }
    uerr = unsolicited_while_idle(g)
    if uerr != "" {
        hang_up(g, uerr)
        return "end: ${uerr}"
    }
    audit(g, "END")
    err = ipc.write_frame(g.ch, "END")
    if err == "" { g.phase = ENDING }
    return err
}

// "" while the guest serves, or why `what` is refused.
fn not_serving(g: *Guest, what: string) -> string {
    match g.phase {
        SERVING -> { return "" }
        SCRIPT -> { return "${what}: the guest is not serving: its script is still running" }
        INVOKING -> {
            if g.pending == 1 {
                return "${what}: the guest is not serving: it is waiting on a host call inside an invocation"
            }
            return "${what}: the guest is not serving: an invocation is still running"
        }
        _ -> { return "${what}: the guest is not serving: it is ending" }
    }
}

// Whether the guest is idle and serving: invoke and end may be called.
is_serving(g: *Guest) -> bool {
    return g.over == 0 && g.phase == SERVING
}

// Whether the guest's READY exported `name` (compared exactly).
is_exported(g: *Guest, name: string) -> bool {
    if string.length(name) == 0 || !is_export_name(name) { return false }
    return string.contains(g.exported, "\"${name}\"") == 1
}

// An invocation's outcome from the event that ended it: (the JSON value,
// "") for RETURN; ("", the error) for RAISE, and for the ERROR, KILLED or
// DONE that ended the guest instead.
result(e: Event) -> (string, string) {
    if e.kind == "RETURN" { return e.text, "" }
    if e.kind == "RAISE" { return "", e.text }
    if e.kind == "DONE" { return "", "the guest ended (DONE ${e.code})" }
    return "", "${e.kind} ${e.text}"
}

// Starts `source` and runs it to its end, handing every SAY, LOG and CALL
// to `on_event`, a function of (*Guest, Event), which answers each CALL
// (answer, fail, grant_file or deny). A CALL it leaves unanswered is
// failed for it. Returns the event that ended the script: READY (the guest
// serves; call_export, then end), DONE, ERROR or KILLED.
run_script(g: *Guest, source: string, on_event: fn) -> Event {
    if g.over == 1 { return event("ERROR", "", "the guest has finished", -1) }
    serr = start(g, source)
    if serr != "" { return hang_up(g, "SCRIPT not delivered: ${serr}") }
    return until_settled(g, on_event)
}

// invoke, then the invocation's events up to its end, handed to
// `on_event` as run_script hands a script's: (the JSON value, "") for a
// RETURN; ("", the error) for a RAISE, a refused invoke, or the end of the
// guest (a deadline, a kill). The guest still serves after a RAISE.
call_export(g: *Guest, name: string, args: string, on_event: fn) -> (string, string) {
    ierr = invoke(g, name, args)
    if ierr != "" { return "", ierr }
    return result(until_settled(g, on_event))
}

// next until the script or the invocation settles: the first event that
// is not SAY, LOG or CALL.
fn until_settled(g: *Guest, on_event: fn) -> Event {
    while true {
        e = next(g)
        if e.kind != "SAY" && e.kind != "LOG" && e.kind != "CALL" { return e }
        call(on_event, g, e)
        if e.kind == "CALL" && g.pending == 1 {
            fail(g, "the host has no answer for '${printable(e.name)}'")
        }
    }
}

// A JSON array, by its brackets (the values in it are the host's own).
fn is_array_text(text: string) -> bool {
    t = string.trim(text)
    n = string.length(t)
    return n >= 2 && string.char_at(t, 0) == 91 && string.char_at(t, n - 1) == 93
}

// Letters, digits, '_' and '.'; 1 to MAX_EXPORT_NAME bytes.
fn is_export_name(name: string) -> bool {
    n = string.length(name)
    if n < 1 || n > MAX_EXPORT_NAME { return false }
    i = 0
    while i < n {
        c = string.char_at(name, i)
        ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 46
        if !ok { return false }
        i = i + 1
    }
    return true
}

fn is_json_space(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

// READY's text: a JSON array of 1 to MAX_EXPORTS distinct names, each a
// string of letters, digits, '_' and '.' of at most MAX_EXPORT_NAME
// bytes (so no escapes), with JSON's spacing anywhere between. The names
// written ["a","b"], or why the list is refused.
fn check_exports(text: string) -> (string, string) {
    n = string.length(text)
    shape = "wants a JSON array of names"
    i = 0
    while i < n && is_json_space(string.char_at(text, i)) { i = i + 1 }
    if i >= n || string.char_at(text, i) != 91 { return "", shape }
    i = i + 1
    out = "["
    count = 0
    while true {
        while i < n && is_json_space(string.char_at(text, i)) { i = i + 1 }
        if i >= n { return "", shape }
        if string.char_at(text, i) == 93 && count == 0 {
            return "", "exports nothing (a guest with nothing to serve sends DONE)"
        }
        if string.char_at(text, i) != 34 { return "", shape }
        j = i + 1
        while j < n && string.char_at(text, j) != 34 { j = j + 1 }
        if j >= n { return "", shape }
        name = string.substring(text, i + 1, j)
        if string.length(name) > MAX_EXPORT_NAME {
            return "", "a name is at most ${MAX_EXPORT_NAME} bytes"
        }
        if !is_export_name(name) {
            return "", "a name holds letters, digits, '_' and '.', not '${printable(name)}'"
        }
        quoted = "\"${name}\""
        if string.contains(out, quoted) == 1 { return "", "exports ${quoted} twice" }
        count = count + 1
        if count > MAX_EXPORTS { return "", "exports more than ${MAX_EXPORTS} functions" }
        out = if count == 1 { "${out}${quoted}" } else { "${out},${quoted}" }
        i = j + 1
        while i < n && is_json_space(string.char_at(text, i)) { i = i + 1 }
        if i >= n { return "", shape }
        c = string.char_at(text, i)
        i = i + 1
        if c == 93 {
            while i < n && is_json_space(string.char_at(text, i)) { i = i + 1 }
            if i != n { return "", shape }
            return "${out}]", ""
        }
        if c != 44 { return "", shape }
    }
}

// Ends a guest early: hangs up and kills it. Safe after it has finished.
close(g: *Guest) {
    if g.over == 1 { return }
    hang_up(g, "closed by the host")
}

// One line in the audit log, labelled with the guest's name: "" or why it
// could not be written. With no audit log, nothing.
audit(g: *Guest, line: string) -> string {
    if g.audit_path == "" { return "" }
    return io.append_file(g.audit_path, "${g.name} ${line}\n")
}

// `s` as a JSON string literal.
json_string(s: string) -> string {
    hex = "0123456789abcdef"
    out = "\""
    run = 0
    i = 0
    n = string.length(s)
    while i < n {
        c = string.char_at(s, i)
        if c == 34 || c == 92 || (c >= 0 && c < 32) {
            out = string.concat(out, string.substring(s, run, i))
            if c == 34 {
                out = string.concat(out, "\\\"")
            } else if c == 92 {
                out = string.concat(out, "\\\\")
            } else if c == 10 {
                out = string.concat(out, "\\n")
            } else {
                hi = c / 16
                lo = c % 16
                out = string.concat(out, "\\u00${string.substring(hex, hi, hi + 1)}${string.substring(hex, lo, lo + 1)}")
            }
            run = i + 1
        }
        i = i + 1
    }
    out = string.concat(out, string.substring(s, run, n))
    return string.concat(out, "\"")
}

// `s` safe to print or log: control bytes, DEL and backslashes as \xNN, so a
// guest cannot forge a log line or send escape sequences to a terminal.
printable(s: string) -> string {
    hex = "0123456789abcdef"
    out = ""
    run = 0
    i = 0
    n = string.length(s)
    while i < n {
        c = string.char_at(s, i)
        if c >= 0 && (c < 32 || c == 127 || c == 92) {
            out = string.concat(out, string.substring(s, run, i))
            hi = c / 16
            lo = c % 16
            out = string.concat(out, "\\x${string.substring(hex, hi, hi + 1)}${string.substring(hex, lo, lo + 1)}")
            run = i + 1
        }
        i = i + 1
    }
    return string.concat(out, string.substring(s, run, n))
}

// "VERB the rest" -> ("VERB", "the rest").
fn split_verb(line: string) -> (string, string) {
    at = string.index_of(line, " ")
    if at < 0 { return line, "" }
    return string.substring(line, 0, at), string.substring(line, at + 1, string.length(line))
}
