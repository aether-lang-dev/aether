// std.zlib unit tests (#1584) — co-located with the module.
//
// The module had no test of any kind before this. Both codecs are
// byte-exact, so the assertions are round-trip fidelity for the raw
// deflate and the gzip-framed variants, the compression-level range,
// and the (data, length, err) contract.
//
// The whole suite is gated on zlib.available(): the backend is an
// optional build dependency, and a box built without it should report
// these as skipped rather than failed. A provisioning gap is not a code
// defect — but nor should it pass silently, which is what skip_all_if
// exists for (#1610).

import std.spec
import std.zlib
import std.string
import std.bytes

const SAMPLE = "the quick brown fox jumps over the lazy dog, and then does it again and again"

main() {
    fw = spec.init()

    // The backend is an optional build dependency. Skipping is reported
    // (never silent) so a box built without zlib is distinguishable from
    // one where these actually ran.
    unavailable = spec.skip_all_if(fw, zlib.available() == 0,
        "zlib backend not built in")

    if unavailable == 0 {
        spec.describe(fw, "std.zlib deflate/inflate") {
            spec.it("round-trips a string byte for byte") callback {
                n = string.length(SAMPLE)
                packed, plen, err = zlib.deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(err, "deflate succeeds")
                spec.assert_true(plen > 0, "compressed length is positive")
                back, blen, derr = zlib.inflate(string.bytes(packed)[0..plen])
                spec.assert_ok(derr, "inflate succeeds")
                spec.assert_eq(blen, n, "length restored")
                spec.assert_str_eq(back, SAMPLE, "content restored")
            }

            spec.it("shrinks repetitive input") callback {
                original = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                n = string.length(original)
                packed, plen, err = zlib.deflate(string.bytes(original)[0..n], 6)
                spec.assert_ok(err, "deflate succeeds")
                spec.assert_true(plen < n, "compressed ${plen} < original ${n}")
            }

            spec.it("round-trips at every compression level") callback {
                // 0 is store-only and 9 is maximum; both must survive a
                // round trip, and 0 is the level most likely to be handled
                // by a different code path.
                n = string.length(SAMPLE)
                for (lvl = 0; lvl <= 9; lvl = lvl + 1) {
                    packed, plen, err = zlib.deflate(string.bytes(SAMPLE)[0..n], lvl)
                    spec.assert_ok(err, "deflate at level ${lvl}")
                    back, blen, derr = zlib.inflate(string.bytes(packed)[0..plen])
                    spec.assert_ok(derr, "inflate at level ${lvl}")
                    spec.assert_str_eq(back, SAMPLE, "content restored at ${lvl}")
                }
            }
        }

        spec.describe(fw, "std.zlib edge cases") {
            spec.it("round-trips an empty input to zero bytes") callback {
                // Ported from tests/integration/zlib_roundtrip/probe.ae,
                // which this suite replaces. Deflating nothing still
                // produces a non-empty stream (the header and checksum), and
                // inflating that has to give zero bytes back rather than an
                // error.
                packed, plen, err = zlib.deflate(string.bytes(""), -1)
                spec.assert_ok(err, "deflate of an empty input succeeds")
                spec.assert_true(plen > 0,
                    "an empty input still yields a framed stream")
                back, blen, derr = zlib.inflate(string.bytes(packed)[0..plen])
                spec.assert_ok(derr, "inflate succeeds")
                spec.assert_eq(blen, 0, "zero bytes back")
            }

            spec.it("rejects an empty buffer on inflate") callback {
                // Distinct from the case above: an empty INPUT to inflate is
                // not a valid stream at all, whereas the deflate of an empty
                // input is.
                data, n, err = zlib.inflate(string.bytes(""))
                spec.assert_err(err, "inflate of an empty buffer is rejected")
            }

            spec.it("rejects input that is not a zlib stream") callback {
                data, n, err = zlib.inflate(string.bytes("not a zlib stream"))
                spec.assert_err(err, "garbage input is rejected")
            }

            spec.it("rejects bytes after the end of a zlib stream") callback {
                // One stream is one stream; the rest used to be ignored.
                n = string.length(SAMPLE)
                packed, plen, err = zlib.deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(err, "deflate succeeds")
                b = bytes.new(plen + 3)
                bytes.copy_from_string(b, 0, packed, plen)
                bytes.copy_from_string(b, plen, "xyz", 3)
                junk = bytes.finish(b, plen + 3)
                _d, _n, derr = zlib.inflate(string.bytes(junk)[0..plen + 3])
                spec.assert_err(derr, "trailing bytes are rejected")
            }

            spec.it("rejects a compression level outside -1..9") callback {
                // The documented levels; any other was quietly replaced by the
                // default, in deflate and in stream_new.
                _d, _n, derr = zlib.deflate(string.bytes("abc")[0..3], 42)
                spec.assert_err(derr, "deflate at level 42")
                _g, _gn, gerr = zlib.gzip_deflate(string.bytes("abc")[0..3], 0 - 2)
                spec.assert_err(gerr, "gzip_deflate at level -2")
                _h, serr = zlib.stream_new(zlib.ZLIB, 42)
                spec.assert_err(serr, "stream_new at level 42")
                _h2, serr2 = zlib.stream_new(7, 6)
                spec.assert_err(serr2, "stream_new with an unknown format")
                ok, okerr = zlib.stream_new(zlib.GZIP, 0 - 1)
                spec.assert_ok(okerr, "stream_new at the default level")
                zlib.stream_free(ok)
            }
        }

        spec.describe(fw, "std.zlib gzip framing") {
            spec.it("round-trips through the gzip container") callback {
                n = string.length(SAMPLE)
                packed, plen, err = zlib.gzip_deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(err, "gzip_deflate succeeds")
                back, blen, derr = zlib.gzip_inflate(string.bytes(packed)[0..plen])
                spec.assert_ok(derr, "gzip_inflate succeeds")
                spec.assert_eq(blen, n, "length restored")
                spec.assert_str_eq(back, SAMPLE, "content restored")
            }

            spec.it("emits the gzip magic bytes") callback {
                // A gzip member starts 1f 8b; a raw deflate stream does not.
                // This is what distinguishes the two entry points, so it is
                // worth asserting rather than trusting the name.
                n = string.length(SAMPLE)
                packed, plen, err = zlib.gzip_deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(err, "gzip_deflate succeeds")
                spec.assert_eq(string.char_at_n(packed, plen, 0), 31,
                    "first byte is 0x1f")
                spec.assert_eq(string.char_at_n(packed, plen, 1), 139,
                    "second byte is 0x8b")
            }

            spec.it("inflates every member of a multi-member gzip file") callback {
                // RFC 1952 2.2, and gzip -d: the members decompress to their
                // concatenation. Only the first used to come back.
                n = string.length(SAMPLE)
                p1, l1, e1 = zlib.gzip_deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(e1, "first member")
                p2, l2, e2 = zlib.gzip_deflate(string.bytes("tail")[0..4], 6)
                spec.assert_ok(e2, "second member")
                b = bytes.new(l1 + l2)
                bytes.copy_from_string(b, 0, p1, l1)
                bytes.copy_from_string(b, l1, p2, l2)
                both = bytes.finish(b, l1 + l2)
                back, blen, derr = zlib.gzip_inflate(string.bytes(both)[0..l1 + l2])
                spec.assert_ok(derr, "two members inflate")
                spec.assert_eq(blen, n + 4, "both members' bytes")
                spec.assert_str_eq(back, "${SAMPLE}tail", "in order")
            }

            spec.it("caps raw inflate at a stated size") callback {
                // std.zip inflates an entry against its stated size: a stream
                // that would expand past it stops there, with an error.
                b = bytes.new(1000)
                i = 0
                while i < 1000 {
                    bytes.set(b, i, 97)
                    i = i + 1
                }
                plain = bytes.finish(b, 1000)
                packed, plen, err = zlib.deflate_raw(string.bytes(plain)[0..1000], 6)
                spec.assert_ok(err, "deflate_raw succeeds")
                _exact, elen, eerr = zlib.inflate_raw_max(string.bytes(packed)[0..plen], 1000)
                spec.assert_ok(eerr, "a cap of exactly the size passes")
                spec.assert_eq(elen, 1000, "all 1000 bytes")
                _o, _on, oerr = zlib.inflate_raw_max(string.bytes(packed)[0..plen], 999)
                spec.assert_err_contains(oerr, "exceeds 999 bytes", "one byte short of the cap is refused")
            }

            spec.it("rejects bytes after the last gzip member") callback {
                n = string.length(SAMPLE)
                p1, l1, e1 = zlib.gzip_deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(e1, "member")
                b = bytes.new(l1 + 3)
                bytes.copy_from_string(b, 0, p1, l1)
                bytes.copy_from_string(b, l1, "xyz", 3)
                junk = bytes.finish(b, l1 + 3)
                _d, _n, derr = zlib.gzip_inflate(string.bytes(junk)[0..l1 + 3])
                spec.assert_err(derr, "trailing garbage is not a member")
            }

            spec.it("rejects input that is not gzip at all") callback {
                // Ported from tests/integration/test_zlib_gzip.ae, which this
                // suite replaces.
                data, n, err = zlib.gzip_inflate(string.bytes("not gzip"))
                spec.assert_err(err, "corrupt gzip input is rejected")
            }

            spec.it("rejects raw deflate output as gzip") callback {
                // The two framings are not interchangeable; feeding one to
                // the other's reader must fail rather than return garbage.
                n = string.length(SAMPLE)
                packed, plen, err = zlib.deflate(string.bytes(SAMPLE)[0..n], 6)
                spec.assert_ok(err, "deflate succeeds")
                back, blen, derr = zlib.gzip_inflate(string.bytes(packed)[0..plen])
                spec.assert_err(derr, "gzip_inflate rejects a raw deflate stream")
            }
        }
    }

    return spec.run_summary(fw)
}
