// std.zlib - One-shot zlib and gzip deflate/inflate.
// Import with: import std.zlib
//
// v1 exposes two functions that operate on in-memory byte buffers:
//
//   zlib.deflate(data, level) -> (bytes, length, err)
//   zlib.inflate(data)        -> (bytes, length, err)
//
// `data` is a `byte[]` slice whose length travels with it (#2301): pass a
// string as `string.bytes(s)`, a `std.bytes` buffer as `bytes.view(buf)`.
//
// `level` is 0..9 (0 = no compression, 9 = best); pass -1 for the
// library default. Output is variable-length binary (may contain
// embedded NULs) — the wrapper returns a length-aware AetherString
// via string_new_with_length, so string.length matches the reported
// byte count.
//
// Streaming APIs are out of scope for v1 — additive future work
// under the same module. See docs/stdlib-vs-contrib.md for the
// "one obvious shape" criterion.
//
// When the toolchain was built without zlib (AETHER_HAS_ZLIB
// undefined), the wrappers return ("", 0, "zlib unavailable")
// rather than crashing.

exports(
    zlib_backend_available,
    zlib_get_deflate_bytes, zlib_get_deflate_length,
    zlib_release_deflate,
    zlib_get_inflate_bytes, zlib_get_inflate_length,
    zlib_release_inflate,
    zlib_try_stream_new, zlib_try_stream_flush,
    zlib_try_stream_finish, zlib_get_stream_bytes, zlib_get_stream_length,
    zlib_release_stream,
    available, deflate, inflate, gzip_deflate, gzip_inflate,
    deflate_raw, inflate_raw, inflate_raw_max,
    stream_new, stream_write, stream_flush, stream_finish, stream_free,
    // Stream formats for stream_new
    RAW, ZLIB, GZIP
)

// Probe: returns 1 when the toolchain was built with zlib detected,
// 0 otherwise. Lets callers / tests distinguish "no backend" from
// "backend returned an error at runtime". C-side name is
// `zlib_backend_available` to avoid colliding with the Aether-side
// `zlib.available()` wrapper's mangled name.
extern zlib_backend_available() -> int

// Split-accessor boundary: try_ performs the op and stashes the
// result in a TLS buffer; get_ returns a borrowed pointer and
// length; release_ frees early (otherwise the buffer is freed on
// the next try_ call on the same thread).
// The `*_try_*` calls that take input bytes have `data: ptr`, not `string`,
// and are not exported (#2301): the wrappers pass a byte[] slice's raw data
// pointer. A `string` parameter routes through the AetherString unwrap,
// which misreads a payload beginning with the header's magic bytes as a
// header; a heap string passed to a `ptr` parameter would feed in its header.
extern zlib_try_deflate(data: ptr, length: int, level: int) -> int
extern zlib_get_deflate_bytes() -> string
extern zlib_get_deflate_length() -> int
extern zlib_release_deflate()

extern zlib_try_inflate(data: ptr, length: int) -> int
extern zlib_get_inflate_bytes() -> string
extern zlib_get_inflate_length() -> int
extern zlib_release_inflate()

extern zlib_try_gzip_deflate(data: ptr, length: int, level: int) -> int
extern zlib_try_gzip_inflate(data: ptr, length: int) -> int
extern zlib_try_inflate_raw(data: ptr, length: int) -> int
extern zlib_try_inflate_raw_max(data: ptr, length: int, max_out: int) -> int
extern zlib_try_deflate_raw(data: ptr, length: int, level: int) -> int

// Streaming deflate (#1890). The handle keeps ONE deflate stream open
// across many writes, so a long-lived response (an SSE connection, a
// chunked body) is a single continuous stream the client can decode.
extern zlib_try_stream_new(format: int, level: int) -> ptr
extern zlib_try_stream_write(handle: ptr, data: ptr, length: int) -> int
extern zlib_try_stream_flush(handle: ptr) -> int
extern zlib_try_stream_finish(handle: ptr) -> int
extern zlib_get_stream_bytes(handle: ptr) -> string
extern zlib_get_stream_length(handle: ptr) -> int
extern zlib_release_stream(handle: ptr)

// Length-preserving string constructor from std.string — takes an
// explicit byte count so binary payloads with embedded NULs survive
// the copy out of the TLS buffer into an owned AetherString.
extern string_new_with_length(data: string, length: int) -> ptr

// A slice with no bound (`p as byte[]`, `.len` -1) has no length.
fn unbounded(fname: string) {
    panic("zlib.${fname}: the slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`")
}

// Compress the bytes of `data` at the given level (0..9, or -1
// for the library default). Returns (bytes, byte_count, "") on
// success, ("", 0, error) on failure. The returned string is
// length-aware: string.length(bytes) == byte_count.
// Alias for the capability probe. Use when skipping a test or
// choosing a fallback path.
available() -> int { return zlib_backend_available() }

deflate(data: byte[], level: int) -> {
    if data.len < 0 { unbounded("deflate") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    ok = zlib_try_deflate(data, data.len, level)
    if ok == 0 {
        return "", 0, "zlib deflate failed"
    }
    raw = zlib_get_deflate_bytes()
    n = zlib_get_deflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_deflate()
    return owned, n, ""
}

// Decompress the bytes of `data` (a zlib stream — RFC 1950).
// Returns (bytes, byte_count, "") on success, ("", 0, error) on
// corruption, truncation, or empty input. The output buffer grows
// geometrically — callers don't need to know the decompressed size
// in advance.
inflate(data: byte[]) -> {
    if data.len < 0 { unbounded("inflate") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    ok = zlib_try_inflate(data, data.len)
    if ok == 0 {
        return "", 0, "zlib inflate failed"
    }
    raw = zlib_get_inflate_bytes()
    n = zlib_get_inflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_inflate()
    return owned, n, ""
}

// gzip-framed siblings (RFC 1952), intended for HTTP
// Content-Encoding: gzip.
gzip_deflate(data: byte[], level: int) -> {
    if data.len < 0 { unbounded("gzip_deflate") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    ok = zlib_try_gzip_deflate(data, data.len, level)
    if ok == 0 {
        return "", 0, "gzip deflate failed"
    }
    raw = zlib_get_deflate_bytes()
    n = zlib_get_deflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_deflate()
    return owned, n, ""
}

gzip_inflate(data: byte[]) -> {
    if data.len < 0 { unbounded("gzip_inflate") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    ok = zlib_try_gzip_inflate(data, data.len)
    if ok == 0 {
        return "", 0, "gzip inflate failed"
    }
    raw = zlib_get_inflate_bytes()
    n = zlib_get_inflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_inflate()
    return owned, n, ""
}

// Raw DEFLATE (RFC 1951) — no zlib/gzip wrapper — the COMPRESSING side.
// This is the framing a ZIP entry stores for method 8: the archive's
// central directory carries the sizes and CRC, so the stream has no
// header of its own. `level` is 0..9 (0 = store, 9 = best); -1 for the
// zlib default. std.zip's writer is the primary caller.
deflate_raw(data: byte[], level: int) -> {
    if data.len < 0 { unbounded("deflate_raw") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    ok = zlib_try_deflate_raw(data, data.len, level)
    if ok == 0 {
        return "", 0, "raw deflate failed"
    }
    raw = zlib_get_deflate_bytes()
    n = zlib_get_deflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_deflate()
    return owned, n, ""
}

// Raw DEFLATE (RFC 1951) — no zlib/gzip wrapper — the DECOMPRESSING side.
// This is the framing a ZIP entry stores for method 8 (deflate): the
// archive's central directory carries the sizes and CRC, so the stream
// itself has no header. std.zip is the primary caller.
inflate_raw(data: byte[]) -> {
    if data.len < 0 { unbounded("inflate_raw") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    ok = zlib_try_inflate_raw(data, data.len)
    if ok == 0 {
        return "", 0, "raw inflate failed"
    }
    raw = zlib_get_inflate_bytes()
    n = zlib_get_inflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_inflate()
    return owned, n, ""
}

// inflate_raw that stops at `max_bytes` of output: a stream that would
// decompress past it is an error, raised as it crosses the limit rather
// than after inflating all of it. For a container that states the
// uncompressed size, as a ZIP entry does, so an entry that lies about its
// size cannot expand past the claim in memory.
inflate_raw_max(data: byte[], max_bytes: int) -> {
    if data.len < 0 { unbounded("inflate_raw_max") }
    if zlib_backend_available() == 0 {
        return "", 0, "zlib unavailable"
    }
    rc = zlib_try_inflate_raw_max(data, data.len, max_bytes)
    if rc < 0 {
        return "", 0, "raw inflate: output exceeds ${max_bytes} bytes"
    }
    if rc == 0 {
        return "", 0, "raw inflate failed"
    }
    raw = zlib_get_inflate_bytes()
    n = zlib_get_inflate_length()
    owned = string_new_with_length(raw, n)
    zlib_release_inflate()
    return owned, n, ""
}

// ---- Streaming deflate (#1890) -------------------------------------
//
// The one-shot calls above each emit a COMPLETE stream, which is wrong
// for a long-lived response: an SSE connection carrying many events
// needs one stream held open and flushed at each event boundary. N
// independently-compressed events concatenated is not a stream any
// `Content-Encoding: gzip` client will decode.
//
//   s, err = zlib.stream_new(zlib.GZIP, 6)
//   _, _, err = zlib.stream_write(s, string.bytes(event))
//   chunk, n, err = zlib.stream_flush(s)     // send these bytes now
//   ...                                       // more events, same stream
//   tail, n, err = zlib.stream_finish(s)      // at connection close
//   zlib.stream_free(s)

// Framing for stream_new. RAW is bare DEFLATE (RFC 1951), ZLIB adds the
// RFC 1950 wrapper, GZIP the RFC 1952 one -- the last is what
// `Content-Encoding: gzip` means.
const RAW = 0
const ZLIB = 1
const GZIP = 2

// Open a stream. Returns (handle, "") on success, (null, error) when
// zlib is absent, the format/level is out of range, or allocation
// fails. Every other stream call needs the handle, so an unavailable
// backend fails HERE rather than silently producing nothing later.
stream_new(format: int, level: int) -> {
    if zlib_backend_available() == 0 {
        return null, "zlib unavailable"
    }
    // Both are checked here, as documented: an out-of-range level used to
    // be replaced by the default without a word.
    if format != RAW && format != ZLIB && format != GZIP {
        return null, "zlib stream_new: format must be RAW, ZLIB or GZIP"
    }
    if level < -1 || level > 9 {
        return null, "zlib stream_new: level must be -1 (default) to 9"
    }
    h = zlib_try_stream_new(format, level)
    if h == null {
        return null, "zlib stream_new failed"
    }
    return h, ""
}

// Feed bytes into the stream. Returns (bytes, byte_count, "") -- and
// the byte count is USUALLY 0, because deflate buffers internally for
// compression ratio. Emit whatever comes back, then call stream_flush
// when the event is complete.
stream_write(handle: ptr, data: byte[]) -> {
    if data.len < 0 { unbounded("stream_write") }
    if handle == null { return "", 0, "zlib stream: null handle" }
    ok = zlib_try_stream_write(handle, data, data.len)
    if ok == 0 { return "", 0, "zlib stream_write failed" }
    return stream_take(handle)
}

// Z_SYNC_FLUSH: emit everything buffered and end on a byte boundary the
// decoder can consume, WITHOUT closing the stream. This is the call
// that makes per-event streaming work.
stream_flush(handle: ptr) -> {
    if handle == null { return "", 0, "zlib stream: null handle" }
    ok = zlib_try_stream_flush(handle)
    if ok == 0 { return "", 0, "zlib stream_flush failed" }
    return stream_take(handle)
}

// Z_FINISH: emit the tail and any trailer. The handle takes no further
// writes; calling it twice is harmless and yields no bytes the second
// time. Still requires stream_free afterwards.
stream_finish(handle: ptr) -> {
    if handle == null { return "", 0, "zlib stream: null handle" }
    ok = zlib_try_stream_finish(handle)
    if ok == 0 { return "", 0, "zlib stream_finish failed" }
    return stream_take(handle)
}

// Copy the borrowed C buffer into an owned, length-aware AetherString.
// Shared by write/flush/finish so the ownership rule lives in one place.
stream_take(handle: ptr) -> {
    raw = zlib_get_stream_bytes(handle)
    n = zlib_get_stream_length(handle)
    if n == 0 { return "", 0, "" }
    owned = string_new_with_length(raw, n)
    return owned, n, ""
}

// Release the handle. Safe on null.
stream_free(handle: ptr) {
    if handle != null { zlib_release_stream(handle) }
}
