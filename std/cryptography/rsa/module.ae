//
// Portions copyright (c) 2026 Aether Developers.
//
// std.cryptography.rsa: RSA (RFC 8017) in pure Aether.
//
// The public-key operation is std.bignum.mod_pow, the key is parsed from
// PKCS#1 DER via std.cryptography.asn1, and the paddings are built byte by
// byte. No OpenSSL RSA; the OS CSPRNG (std.cryptography.random_buffer)
// supplies the PKCS#1 v1.5 encryption padding and the blinding factors.
//
// Ported from Bouncy Castle's RsaCoreEngine + Pkcs1Encoding +
// RsaDigestSigner (crypto/src/crypto/{engines,encodings,signers}/, MIT).
//
//   key_from_components(n, e, d) / key_from_bytes(n, e, d) /
//   key_from_pkcs1_der(der) / key_free
//   raw_encrypt (m^e mod n) / raw_decrypt (c^d mod n)
//   PKCS#1 v1.5 encrypt (type 2) / decrypt, sign (type 1) / verify over a
//   caller-supplied DigestInfo blob (any std.cryptography digest composes)
//   OAEP (SHA-256, empty label) encrypt / decrypt, and with another hash
//   (SHA-1, SHA-384, SHA-512; MGF1 with the same hash) through
//   encrypt_oaep_hash / decrypt_oaep_hash, PSS (SHA-256) sign / verify
//
// The private-key operation (raw_decrypt, and through it decrypt_pkcs1,
// decrypt_oaep, sign_pkcs1, sign_pss) is constant time: Montgomery
// arithmetic on fixed-width limb vectors with masked reductions, and a
// fixed 4-bit window exponentiation over all of d's bytes that reads every
// table entry. The base is blinded with a fresh random r (c * r^e, then the
// result times r^-1). The two decryptions check their padding without an
// early exit or a branch on the plaintext, and only the final verdict (and
// the message length) is declassified. Loading a key is not constant time
// (the DER reader and std.bignum branch on the encoding). key_from_bytes and
// key_from_pkcs1_der copy d into the key byte by byte, without std.bignum,
// so their keys have no d bignum (RsaKey.d is null), and the DER copies d
// passes through are wiped as they are freed (#3382).
// tests/integration/crypto_ct_valgrind checks the private-key operations
// under Valgrind.
//
// A 2048-bit private-key operation takes about 11 ms with the default
// `ae build` (27 ms on std.bignum's variable-time mod_pow before #2600).

import std.string
import std.bignum
import std.bytes
import std.mem
import std.cryptography
import std.cryptography.sha1
import std.cryptography.sha2
import std.cryptography.asn1
import std.cryptography.ct

exports(
    key_from_components, key_from_bytes, key_from_pkcs1_der, key_free,
    modulus_bytes, modulus_bits,
    raw_encrypt, raw_decrypt,
    encrypt_pkcs1, decrypt_pkcs1,
    sign_pkcs1, verify_pkcs1,
    encrypt_oaep, decrypt_oaep, encrypt_oaep_hash, decrypt_oaep_hash,
    sign_pss, verify_pss, sign_pss_hash, verify_pss_hash
)

extern malloc(size: int) -> ptr
@extern("free") libc_free(p: ptr)

// An RSA key owns its component bignums (n, e, d). `d` is null for a
// public-only key, and for the keys key_from_bytes and key_from_pkcs1_der
// build: they copy the private exponent into `dbe` and never put it
// through std.bignum, whose numbers are freed without a wipe (#3382).
// raw_decrypt / sign require a private key, which `dbe` says.
//
// The private exponent is also held as `dbe`, exactly modulus_bytes(k)
// big-endian bytes: the private-key operation reads its 4-bit windows from
// there in constant time. Loading a key (the DER reader, std.bignum) is not
// constant time; every operation with it is.
struct RsaKey {
    n: ptr // modulus (bignum)
    e: ptr // public exponent (bignum)
    d: ptr // private exponent (bignum) or null
    dbe: ptr // private exponent as k big-endian bytes (std.bytes), or null
}

// Build a key from already-parsed bignums. The key TAKES OWNERSHIP of n,
// e, d (frees them in key_free) — pass clones if you need to keep them.
key_from_components(n: @keep ptr, e: @keep ptr, d: @keep ptr) -> ptr {
    k = malloc(sizeof(RsaKey)) as *RsaKey
    k.n = n
    k.e = e
    k.d = d
    k.dbe = null
    if d != null {
        k.dbe = to_fixed(d, (bignum.bit_length(n) + 7) / 8)
    }
    return k
}

// Build a key from big-endian byte strings (as JWK and PKCS#11 carry them).
// `d` may be empty for a public key. The private exponent is copied into the
// key byte by byte, so a key built this way never puts d through std.bignum.
// Returns null when n or e is empty or d is longer than n.
key_from_bytes(n: byte[], e: byte[], d: byte[]) -> ptr {
    if n.len < 1 || e.len < 1 || d.len < 0 {
        return null
    }
    nb = bytes.from_slice(n)
    nn = bignum.from_bytes_unsigned(nb, n.len)
    bytes.wipe_free(nb)
    eb = bytes.from_slice(e)
    ee = bignum.from_bytes_unsigned(eb, e.len)
    bytes.wipe_free(eb)
    int klen = (bignum.bit_length(nn) + 7) / 8
    if d.len > klen {
        // A longer d must be leading zeros; check them, publicly.
        int i = 0
        while i < d.len - klen {
            if d[i] != 0 {
                bignum.free(nn)
                bignum.free(ee)
                return null
            }
            i = i + 1
        }
    }
    k = malloc(sizeof(RsaKey)) as *RsaKey
    k.n = nn
    k.e = ee
    k.d = null
    k.dbe = null
    if d.len > 0 {
        dbe = bytes.new(klen)
        bytes.set(dbe, klen - 1, 0)
        int j = 0
        while j < klen {
            int src = d.len - klen + j
            int v = 0
            if src >= 0 {
                v = d[src] & 255
            }
            bytes.set(dbe, j, v)
            j = j + 1
        }
        k.dbe = dbe
    }
    return k
}

key_free(k: @frees ptr) {
    if k == null { return }
    kk = k as *RsaKey
    if kk.n != null { bignum.free(kk.n) }
    if kk.e != null { bignum.free(kk.e) }
    if kk.d != null { bignum.free(kk.d) }
    if kk.dbe != null { wipe_free(kk.dbe) }
    libc_free(k)
}

// Zero a std.bytes buffer, then free it.
fn wipe_free(b: @frees ptr) {
    bytes.wipe_free(b)
}

// Parse a PKCS#1 RSAPrivateKey DER (SEQUENCE { version, n, e, d, p, q,
// dp, dq, qinv }). Returns (key, "") or (null, err). The key is built as
// key_from_bytes builds one: n and e as numbers, d copied byte by byte into
// the key, never through std.bignum, whose numbers are freed as they are
// (#3382); the CRT parameters are not read (this slice does not use CRT).
// The SEQUENCE's copy and d's INTEGER content are wiped as they are freed.
key_from_pkcs1_der(der: @keep ptr) -> (ptr, string) {
    r = asn1.reader_new(der)
    sub, body, serr = asn1.read_sequence(r)
    if string.equals(serr, "") != 1 {
        asn1.reader_free(r)
        return null, serr
    }
    ver, verr = asn1.read_integer(sub)
    if string.equals(verr, "") != 1 {
        asn1.reader_free(sub); wipe_free(body); asn1.reader_free(r)
        return null, verr
    }
    bignum.free(ver)
    nb, nerr = read_int_content(sub)
    eb, eerr = read_int_content(sub)
    db, derr = read_int_content(sub)
    asn1.reader_free(sub); wipe_free(body); asn1.reader_free(r)
    err = ""
    if string.equals(nerr, "") != 1 { err = nerr }
    if string.equals(err, "") == 1 && string.equals(eerr, "") != 1 { err = eerr }
    if string.equals(err, "") == 1 && string.equals(derr, "") != 1 { err = derr }
    k = null
    if string.equals(err, "") == 1 {
        // An INTEGER's content is two's complement; n, e and d are
        // positive, their leading zero byte only a sign.
        k = key_from_bytes(bytes.view(nb)[0..bytes.length(nb)], bytes.view(eb)[0..bytes.length(eb)], bytes.view(db)[0..bytes.length(db)])
        if k == null { err = "rsa: not an RSA private key (n, e or d)" }
    }
    if nb != null { bytes.wipe_free(nb) }
    if eb != null { bytes.wipe_free(eb) }
    if db != null { wipe_free(db) }
    return k, err
}

// The content of the next INTEGER in `r`, as bytes (caller frees, wiping
// a secret), or (null, why).
fn read_int_content(r: ptr) -> (ptr, string) {
    c, err = asn1.read_tlv(r)
    if string.equals(err, "") != 1 { return null, err }
    if asn1.last_tag(r) != 0x02 {
        wipe_free(c)
        return null, "rsa: an RSAPrivateKey field is not an INTEGER"
    }
    return c, ""
}

// Byte length of the modulus (the RSA block size k).
modulus_bytes(k: ptr) -> int {
    kk = k as *RsaKey
    return (bignum.bit_length(kk.n) + 7) / 8
}

modulus_bits(k: ptr) -> int {
    kk = k as *RsaKey
    return bignum.bit_length(kk.n)
}

// ---- raw primitives ----
//
// raw_encrypt: m^e mod n. raw_decrypt: c^d mod n. Input/output are
// fixed-width k-byte big-endian std.bytes (caller frees). The integer
// must be < n; callers go through the PKCS#1 wrappers normally.
raw_encrypt(k: ptr, m_bytes: ptr) -> ptr {
    return raw_encrypt_slice(k, bytes.view(m_bytes))
}

// The slice form of raw_encrypt (#2301); raw_encrypt views its std.bytes handle into it.
fn raw_encrypt_slice(k: ptr, m_bytes: byte[]) -> ptr {
    kk = k as *RsaKey
    klen = modulus_bytes(k)
    owned = bytes.from_slice(m_bytes)
    m = bignum.from_bytes_unsigned(owned, m_bytes.len)
    bytes.wipe_free(owned)
    c = bignum.mod_pow(m, kk.e, kk.n)
    out = to_fixed(c, klen)
    bignum.free(m); bignum.free(c)
    return out
}

// c^d mod n with the private key, as k big-endian bytes (caller frees), or
// null for a public-only key or a c longer than k bytes. Constant time in d
// and in the result, and blinded: see private_op.
raw_decrypt(k: ptr, c_bytes: ptr) -> ptr {
    kk = k as *RsaKey
    if kk.dbe == null || c_bytes == null {
        return null
    }
    if bytes.length(c_bytes) > modulus_bytes(k) {
        return null
    }
    return private_op(kk, bytes.view(c_bytes))
}

// ---- the private-key operation: constant time, blinded ----
//
// Montgomery arithmetic on little-endian 32-bit limb vectors of the
// modulus's width, on the heap for the duration of one operation and viewed
// as unbounded uint32[]: CIOS multiplication with a masked final
// subtraction, so the instructions and memory touched depend only on the
// modulus's size. The exponentiation is a fixed 4-bit window from the top
// of d (as many windows as n has bytes, whatever the bit length of d is),
// reading all 16 table entries for each window and keeping one with a mask.
//
// The base is blinded as well: c is multiplied by r^e for a fresh random r
// and the result by r^-1, so the value raised to d is uniformly random and
// unrelated to the ciphertext an attacker chose. r^-1 comes from std.bignum's
// variable-time mod_inverse applied to r*b for another random b (then times
// b), so that inversion only ever sees a random number.

struct RsaMont {
    nl: int // limbs of n
    m: ptr // n
    m0inv: uint32 // -n^-1 mod 2^32
    one: ptr // R mod n, R = 2^(32 nl)
    r2: ptr // R^2 mod n
    t: ptr // nl + 2 limbs of scratch for mont_mul
}

fn limbs_new(nl: int) -> ptr {
    p = malloc(nl * 4)
    v = p as uint32[]
    int i = 0
    while i < nl {
        v[i] = 0
        i = i + 1
    }
    return p
}

// The limbs zeroed with mem.wipe, then freed: a zeroing loop before the free
// is a dead store the compiler may drop (#3414).
fn limbs_wipe_free(p: @frees ptr, nl: int) {
    mem.wipe(p, (nl * 4) as long)
    libc_free(p)
}

fn limbs_copy(r: ptr, a: ptr, nl: int) {
    rv = r as uint32[]
    av = a as uint32[]
    int i = 0
    while i < nl {
        rv[i] = av[i]
        i = i + 1
    }
}

// a = the big-endian bytes b, zero-extended to nl limbs (b.len <= 4 nl).
fn limbs_from_be(a: ptr, nl: int, b: byte[]) {
    v = a as uint32[]
    int i = 0
    while i < nl {
        v[i] = 0
        i = i + 1
    }
    int n = b.len
    i = 0
    while i < n {
        int limb = i / 4
        if limb < nl {
            v[limb] = v[limb] | (((b[n - 1 - i] & 255) as uint32) << ((i % 4) * 8))
        }
        i = i + 1
    }
}

// The low len bytes of a as big-endian bytes in a fresh buffer.
fn limbs_to_be(a: ptr, nl: int, len: int) -> ptr {
    v = a as uint32[]
    out = bytes.new(len)
    bytes.set(out, len - 1, 0)
    int i = 0
    while i < len {
        int limb = i / 4
        int bv = 0
        if limb < nl {
            bv = ((v[limb] >> ((i % 4) * 8)) & 255) as int
        }
        bytes.set(out, len - 1 - i, bv)
        i = i + 1
    }
    return out
}

// a = 2a mod m (a < m).
fn mont_dbl(M: *RsaMont, a: ptr) {
    int n = M.nl
    av = a as uint32[]
    t = M.t as uint32[]
    mv = M.m as uint32[]
    uint32 cin = 0
    int i = 0
    while i < n {
        uint32 w = av[i]
        t[i] = (w << 1) | cin
        cin = w >> 31
        i = i + 1
    }
    uint64 bw = 0
    i = 0
    while i < n {
        uint64 d = (t[i] as uint64) - (mv[i] as uint64) - bw
        av[i] = d as uint32
        bw = d >> 63
        i = i + 1
    }
    uint32 mask = 0 - (((1 - cin) as uint32) & (bw as uint32))
    i = 0
    while i < n {
        av[i] = av[i] ^ (mask & (av[i] ^ t[i]))
        i = i + 1
    }
}

// r = a * b / R mod n (CIOS); a < R, b < n. r may alias a or b.
fn mont_mul(M: *RsaMont, r: ptr, a: ptr, b: ptr) {
    int n = M.nl
    t = M.t as uint32[]
    av = a as uint32[]
    bv = b as uint32[]
    mv = M.m as uint32[]
    rv = r as uint32[]
    uint32 m0inv = M.m0inv
    int i = 0
    while i < n + 2 {
        t[i] = 0
        i = i + 1
    }
    i = 0
    while i < n {
        uint64 bi = bv[i] as uint64
        uint64 c = 0
        int j = 0
        while j < n {
            uint64 s = (t[j] as uint64) + (av[j] as uint64) * bi + c
            t[j] = s as uint32
            c = s >> 32
            j = j + 1
        }
        uint64 s2 = (t[n] as uint64) + c
        t[n] = s2 as uint32
        t[n + 1] = (s2 >> 32) as uint32
        uint64 mm = ((t[0] * m0inv) as uint32) as uint64
        uint64 s3 = (t[0] as uint64) + mm * (mv[0] as uint64)
        c = s3 >> 32
        j = 1
        while j < n {
            uint64 s4 = (t[j] as uint64) + mm * (mv[j] as uint64) + c
            t[j - 1] = s4 as uint32
            c = s4 >> 32
            j = j + 1
        }
        uint64 s5 = (t[n] as uint64) + c
        t[n - 1] = s5 as uint32
        t[n] = t[n + 1] + ((s5 >> 32) as uint32)
        i = i + 1
    }
    uint64 bw = 0
    i = 0
    while i < n {
        uint64 d = (t[i] as uint64) - (mv[i] as uint64) - bw
        rv[i] = d as uint32
        bw = d >> 63
        i = i + 1
    }
    uint32 keep = (bw as uint32) & ((((t[n] as uint64) - 1) >> 63) as uint32)
    uint32 mask = 0 - keep
    i = 0
    while i < n {
        rv[i] = rv[i] ^ (mask & (rv[i] ^ t[i]))
        i = i + 1
    }
}

// The Montgomery context of the odd modulus whose big-endian bytes are nbe.
fn mont_new(nbe: byte[]) -> *RsaMont {
    M = malloc(sizeof(RsaMont)) as *RsaMont
    int nl = (nbe.len + 3) / 4
    M.nl = nl
    M.m = limbs_new(nl)
    limbs_from_be(M.m, nl, nbe)
    M.t = limbs_new(nl + 2)
    uint32 m0 = (M.m as uint32[])[0]
    uint32 x = m0
    int it = 0
    while it < 5 {
        x = x * (2 - m0 * x)
        it = it + 1
    }
    M.m0inv = 0 - x
    M.one = limbs_new(nl)
    ov = M.one as uint32[]
    ov[0] = 1
    int k = 0
    while k < 32 * nl {
        mont_dbl(M, M.one)
        k = k + 1
    }
    M.r2 = limbs_new(nl)
    limbs_copy(M.r2, M.one, nl)
    k = 0
    while k < 32 * nl {
        mont_dbl(M, M.r2)
        k = k + 1
    }
    return M
}

fn mont_free(M: @frees *RsaMont) {
    int nl = M.nl
    libc_free(M.m)
    libc_free(M.one)
    libc_free(M.r2)
    limbs_wipe_free(M.t, nl + 2)
    libc_free(M)
}

// r = a^e (Montgomery form in and out) for a PUBLIC exponent e (big-endian
// bytes): square-and-multiply whose sequence depends on e only.
fn mont_pow_public(M: *RsaMont, r: ptr, a: ptr, e: ptr) {
    int nl = M.nl
    acc = limbs_new(nl)
    limbs_copy(acc, M.one, nl)
    int el = bytes.length(e)
    int bi = 0
    while bi < el {
        int ev = bytes.get(e, bi) & 255
        int j = 7
        while j >= 0 {
            mont_mul(M, acc, acc, acc)
            if ((ev >> j) & 1) == 1 {
                mont_mul(M, acc, acc, a)
            }
            j = j - 1
        }
        bi = bi + 1
    }
    limbs_copy(r, acc, nl)
    libc_free(acc)
}

// r = a^d (Montgomery form in and out) for the SECRET exponent d (klen
// big-endian bytes): a fixed 4-bit window, every window four squarings and
// one multiplication by a table entry chosen with masks.
fn mont_pow_secret(M: *RsaMont, r: ptr, a: ptr, d: ptr, klen: int) {
    int nl = M.nl
    // 16 entries of nl limbs: entry j starts j * nl * 4 bytes into tbl.
    tbl = limbs_new(16 * nl)
    tv = tbl as uint32[]
    limbs_copy(tbl, M.one, nl)
    limbs_copy(tbl + nl * 4, a, nl)
    int i = 2
    while i < 16 {
        mont_mul(M, tbl + i * nl * 4, tbl + (i - 1) * nl * 4, a)
        i = i + 1
    }
    acc = limbs_new(nl)
    limbs_copy(acc, M.one, nl)
    sel = limbs_new(nl)
    sv = sel as uint32[]
    int bi = 0
    while bi < klen {
        int kv = bytes.get(d, bi) & 255
        int half = 0
        while half < 2 {
            int digit = (kv >> (4 - 4 * half)) & 15
            mont_mul(M, acc, acc, acc)
            mont_mul(M, acc, acc, acc)
            mont_mul(M, acc, acc, acc)
            mont_mul(M, acc, acc, acc)
            int w = 0
            while w < nl {
                sv[w] = 0
                w = w + 1
            }
            int j = 0
            while j < 16 {
                uint32 mask = 0 - (ct.eq(j, digit) as uint32)
                int base = j * nl
                w = 0
                while w < nl {
                    sv[w] = sv[w] | (tv[base + w] & mask)
                    w = w + 1
                }
                j = j + 1
            }
            mont_mul(M, acc, acc, sel)
            half = half + 1
        }
        bi = bi + 1
    }
    limbs_copy(r, acc, nl)
    limbs_wipe_free(tbl, 16 * nl)
    limbs_wipe_free(acc, nl)
    limbs_wipe_free(sel, nl)
}

// The blinding pair for one operation: (r^e, r^-1), both Montgomery form,
// for a fresh random r. (null, null) when the CSPRNG fails.
fn blinding(M: *RsaMont, kk: *RsaKey, ebe: ptr, klen: int) -> (ptr, ptr) {
    int nl = M.nl
    int tries = 0
    while tries < 8 {
        rb, rerr = cryptography.random_buffer(klen)
        bb, berr = cryptography.random_buffer(klen)
        if rerr != "" || berr != "" {
            if rb != null { wipe_free(rb) }
            if bb != null { wipe_free(bb) }
            return null, null
        }
        rl = limbs_new(nl)
        limbs_from_be(rl, nl, bytes.view(rb))
        rm = limbs_new(nl)
        mont_mul(M, rm, rl, M.r2) // r R
        limbs_from_be(rl, nl, bytes.view(bb))
        bm = limbs_new(nl)
        mont_mul(M, bm, rl, M.r2) // b R
        wipe_free(rb)
        wipe_free(bb)
        // t = r b mod n, inverted by std.bignum: t is uniformly random.
        tm = limbs_new(nl)
        mont_mul(M, tm, rm, bm) // r b R
        one_plain = limbs_new(nl)
        opv = one_plain as uint32[]
        opv[0] = 1
        mont_mul(M, tm, tm, one_plain) // r b
        tbe = limbs_to_be(tm, nl, klen)
        tbn = bignum.from_bytes_unsigned(tbe, klen)
        wipe_free(tbe)
        tinv = bignum.mod_inverse(tbn, kk.n)
        bignum.free(tbn)
        if tinv != null && bignum.is_zero(tinv) != 1 {
            ibe = to_fixed(tinv, klen)
            bignum.free(tinv)
            limbs_from_be(tm, nl, bytes.view(ibe))
            wipe_free(ibe)
            im = limbs_new(nl)
            mont_mul(M, im, tm, M.r2) // (r b)^-1 R
            mont_mul(M, im, im, bm) // r^-1 R
            am = limbs_new(nl)
            mont_pow_public(M, am, rm, ebe) // r^e R
            limbs_wipe_free(rl, nl)
            limbs_wipe_free(rm, nl)
            limbs_wipe_free(bm, nl)
            limbs_wipe_free(tm, nl)
            libc_free(one_plain)
            return am, im
        }
        if tinv != null { bignum.free(tinv) }
        limbs_wipe_free(rl, nl)
        limbs_wipe_free(rm, nl)
        limbs_wipe_free(bm, nl)
        limbs_wipe_free(tm, nl)
        libc_free(one_plain)
        tries = tries + 1
    }
    return null, null
}

// c^d mod n for the key's d, blinded and constant time; k bytes, or null
// when the CSPRNG fails.
fn private_op(kk: *RsaKey, c: byte[]) -> ptr {
    int klen = (bignum.bit_length(kk.n) + 7) / 8
    nbe = bignum.to_bytes_unsigned(kk.n)
    ebe = bignum.to_bytes_unsigned(kk.e)
    M = mont_new(bytes.view(nbe))
    bytes.wipe_free(nbe)
    int nl = M.nl
    am, im = blinding(M, kk, ebe, klen)
    bytes.wipe_free(ebe)
    if am == null {
        mont_free(M)
        return null
    }
    x = limbs_new(nl)
    limbs_from_be(x, nl, c)
    mont_mul(M, x, x, M.r2) // c R (any c < R reduces)
    mont_mul(M, x, x, am) // c r^e R
    mont_pow_secret(M, x, x, kk.dbe, klen) // (c r^e)^d R = m r R
    mont_mul(M, x, x, im) // m R
    one_plain = limbs_new(nl)
    opv = one_plain as uint32[]
    opv[0] = 1
    mont_mul(M, x, x, one_plain) // m
    out = limbs_to_be(x, nl, klen)
    limbs_wipe_free(x, nl)
    limbs_wipe_free(am, nl)
    limbs_wipe_free(im, nl)
    libc_free(one_plain)
    mont_free(M)
    return out
}

// bignum -> exactly `width` big-endian bytes, left-zero-padded. The
// unsigned magnitude is right-aligned into a fresh std.bytes.
to_fixed(n: ptr, width: int) -> ptr {
    mag = bignum.to_bytes_unsigned(n)
    mlen = bytes.length(mag)
    out = bytes.new(width)
    z = 0
    while z < width { bytes.set(out, z, 0); z = z + 1 }
    // copy mag into the low (rightmost) bytes
    off = width - mlen
    i = 0
    while i < mlen {
        if off + i >= 0 {
            bytes.set(out, off + i, bytes.get(mag, i))
        }
        i = i + 1
    }
    // The magnitude of a private exponent too (key_from_components, #3382).
    wipe_free(mag)
    return out
}

// ---- PKCS#1 v1.5 ----
//
// EME-PKCS1-v1_5 encryption block (type 2):
//   0x00 || 0x02 || PS(random nonzero, >= 8 bytes) || 0x00 || M
// Returns (ciphertext_bytes, "") or (null, err). `msg` must satisfy
// len(msg) <= k - 11.
encrypt_pkcs1(k: ptr, msg: ptr) -> (ptr, string) {
    klen = modulus_bytes(k)
    mlen = bytes.length(msg)
    if mlen > klen - 11 {
        return null, "rsa: message too long for PKCS#1 v1.5"
    }
    block = bytes.new(klen)
    bytes.set(block, 0, 0x00)
    bytes.set(block, 1, 0x02)
    pslen = klen - mlen - 3
    // fill PS with nonzero random bytes, drawing more until it is full
    filled = 0
    while filled < pslen {
        rnd, rerr = cryptography.random_buffer(pslen - filled + 16)
        if rerr != "" {
            bytes.wipe_free(block)
            return null, rerr
        }
        rn = bytes.length(rnd)
        ri = 0
        while ri < rn && filled < pslen {
            rb = bytes.get(rnd, ri) & 0xFF
            if rb != 0 {
                bytes.set(block, 2 + filled, rb)
                filled = filled + 1
            }
            ri = ri + 1
        }
        wipe_free(rnd)
    }
    bytes.set(block, 2 + pslen, 0x00)
    i = 0
    while i < mlen {
        bytes.set(block, 3 + pslen + i, bytes.get(msg, i))
        i = i + 1
    }
    c = raw_encrypt(k, block)
    wipe_free(block)
    return c, ""
}

// Decrypt + strip PKCS#1 v1.5 type-2 padding. Returns (message, "") or
// (null, err). The padding check reads every byte of the block and folds
// the verdict into masks (a Bleichenbacher oracle needs only the timing of
// an early exit); the verdict and, on success, the message length are
// public once returned and go through ct.declassify.
decrypt_pkcs1(k: ptr, ct_bytes: ptr) -> (ptr, string) {
    klen = modulus_bytes(k)
    if sig_in_range(k, ct_bytes) != 1 {
        return null, "ciphertext out of range"
    }
    block = raw_decrypt(k, ct_bytes)
    if block == null {
        return null, "rsa: not a private key, or no randomness for blinding"
    }
    // expect 0x00 0x02 PS 0x00 M, PS at least 8 bytes
    int good = ct.eq(bytes.get(block, 0) & 255, 0x00) & ct.eq(bytes.get(block, 1) & 255, 0x02)
    int found = 0
    int sep = 0
    int i = 2
    while i < klen {
        int is_zero = ct.eq(bytes.get(block, i) & 255, 0)
        int first = is_zero & (1 - found)
        sep = ct.select(first, i, sep)
        found = found | is_zero
        i = i + 1
    }
    good = good & found & (1 - ct.lt(sep, 10)) // 2 prefix + >= 8 PS
    if ct.declassify(good) != 1 {
        wipe_free(block)
        return null, "rsa: PKCS#1 v1.5 decryption error"
    }
    sep = ct.declassify(sep)
    mlen = klen - sep - 1
    out = bytes.new(mlen)
    if mlen > 0 {
        bytes.copy_from_bytes(out, 0, block, sep + 1, mlen)
    }
    wipe_free(block)
    return out, ""
}

// ---- PKCS#1 v1.5 signatures (type 1) ----
//
// EMSA-PKCS1-v1_5 over a caller-supplied DigestInfo blob `di` (the DER
// of the AlgorithmIdentifier+digest; the caller composes it so RSA stays
// hash-agnostic):
//   0x00 || 0x01 || PS(0xFF, >= 8 bytes) || 0x00 || di
// sign returns the raw signature (k bytes). verify recomputes the block
// and compares.
sign_pkcs1(k: ptr, di: ptr) -> (ptr, string) {
    klen = modulus_bytes(k)
    dlen = bytes.length(di)
    if dlen > klen - 11 {
        return null, "rsa: DigestInfo too long for modulus"
    }
    block = build_emsa(di, klen)
    s = raw_decrypt(k, block) // signing = private-key op (c^d mod n)
    bytes.wipe_free(block)
    if s == null {
        return null, "rsa: not a private key, or no randomness for blinding"
    }
    return s, ""
}

// RFC 8017 range gate, used for BOTH signatures (§8.2.2 step 1) and
// ciphertexts (§7.1.2/§7.2.2 step 1): the input must be EXACTLY k octets
// and its integer value must be < n. The raw modexp reduces mod n, so
// without this check s+n / c+n (distinct byte strings, same residue)
// verify/decrypt identically — malleability, caught by Wycheproof
// rsa_signature tcId 244 and rsa_oaep tcId 27 ("added n to c").
sig_in_range(k: ptr, sig: ptr) -> int {
    return sig_in_range_slice(k, bytes.view(sig))
}

// The slice form of sig_in_range (#2301); sig_in_range views its std.bytes handle into it.
fn sig_in_range_slice(k: ptr, sig: byte[]) -> int {
    kk = k as *RsaKey
    if sig.len != modulus_bytes(k) { return 0 }
    owned = bytes.from_slice(sig)
    s = bignum.from_bytes_unsigned(owned, sig.len)
    bytes.wipe_free(owned)
    ok = 1
    if bignum.compare(s, kk.n) >= 0 { ok = 0 }
    bignum.free(s)
    return ok
}

// verify: public-key op on the signature, rebuild the expected EMSA block
// from `di`, compare byte-for-byte. Returns 1 (valid) / 0 (invalid).
verify_pkcs1(k: ptr, di: ptr, sig: byte[]) -> int {
    if sig_in_range_slice(k, sig) != 1 { return 0 }
    klen = modulus_bytes(k)
    recovered = raw_encrypt_slice(k, sig) // s^e mod n
    expected = build_emsa(di, klen)
    ok = 1
    if bytes.length(recovered) != bytes.length(expected) { ok = 0 }
    if ok == 1 {
        i = 0
        while i < bytes.length(expected) {
            if bytes.get(recovered, i) != bytes.get(expected, i) { ok = 0 }
            i = i + 1
        }
    }
    bytes.wipe_free(recovered); bytes.wipe_free(expected)
    return ok
}

// Build the type-1 EMSA block: 0x00 0x01 FF...FF 0x00 di  (k bytes).
build_emsa(di: ptr, klen: int) -> ptr {
    dlen = bytes.length(di)
    block = bytes.new(klen)
    bytes.set(block, 0, 0x00)
    bytes.set(block, 1, 0x01)
    pslen = klen - dlen - 3
    i = 0
    while i < pslen { bytes.set(block, 2 + i, 0xFF); i = i + 1 }
    bytes.set(block, 2 + pslen, 0x00)
    j = 0
    while j < dlen {
        bytes.set(block, 3 + pslen + j, bytes.get(di, j))
        j = j + 1
    }
    return block
}

// ---- SHA-256 helper (binary-safe via std.cryptography.sha2) ----
// hLen for SHA-256.
oaep_hlen() -> int { return 32 }
sha256b(data: byte[]) -> ptr {
    return hashb("sha256", data)
}

// ---- MGF1 (RFC 8017 B.2.1) with SHA-256 ----
// mask = MGF1(seed, mask_len): for counter = 0,1,...: T ||= SHA256(seed || I2OSP(counter,4)).
mgf1(seed: byte[], mask_len: int) -> ptr {
    if seed.len < 0 { panic("rsa.mgf1: the `seed` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    return mgf1_hash("sha256", seed, mask_len)
}

// XOR src into dst over `len` bytes (dst modified in place).
xor_into(dst: ptr, src: byte[]) {
    if src.len < 0 { panic("rsa.xor_into: the `src` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int len = src.len
    i = 0
    while i < len {
        bytes.set(dst, i, (bytes.get(dst, i) ^ src[i]) & 0xFF)
        i = i + 1
    }
}

// ---- RSAES-OAEP (RFC 8017 §7.1), empty label ----
// Encrypt `msg` (mlen bytes) with SHA-256 and MGF1-SHA256: encrypt_oaep_hash
// with "sha256". `seed` must be exactly hLen (32) random bytes
// (caller-supplied for determinism/testability). Returns k-byte ciphertext,
// or null if the message is too long (mlen > k - 2*hLen - 2).
encrypt_oaep(k: ptr, msg: byte[], seed: ptr) -> ptr {
    if msg.len < 0 { panic("rsa.encrypt_oaep: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    return encrypt_oaep_hash(k, "sha256", msg, seed)
}

// The OAEP hashes: "sha1" (OpenSSL's RSA_PKCS1_OAEP_PADDING, what MySQL's
// caching_sha2_password and sha256_password exchanges and most older
// protocols use), "sha256", "sha384", "sha512". MGF1 uses the same hash.
fn oaep_hash_ok(algo: string) -> int {
    if algo == "sha1" || algo == "sha256" || algo == "sha384" || algo == "sha512" { return 1 }
    return 0
}

// Encrypt `msg` with RSAES-OAEP over `algo` ("sha1", "sha256", "sha384" or
// "sha512"; MGF1 with the same hash), empty label. `seed` must be exactly
// hLen random bytes (20 for SHA-1, 32, 48, 64), caller-supplied as for
// encrypt_oaep. Returns the k-byte ciphertext, or null for a message too
// long (mlen > k - 2*hLen - 2), an unknown hash, or a seed shorter than hLen.
encrypt_oaep_hash(k: ptr, algo: string, msg: byte[], seed: ptr) -> ptr {
    if msg.len < 0 { panic("rsa.encrypt_oaep_hash: the `msg` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    if oaep_hash_ok(algo) != 1 { return null }
    int mlen = msg.len
    klen = modulus_bytes(k)
    hlen = pss_hlen(algo)
    if seed == null || bytes.length(seed) < hlen { return null }
    if mlen > klen - 2 * hlen - 2 {
        return null
    }
    // lHash = Hash("")  (empty label)
    empty = bytes.new(0)
    lhash = hashb(algo, bytes.view(empty)[0..0])
    bytes.wipe_free(empty)

    // DB = lHash || PS(0x00..) || 0x01 || M   (length k - hLen - 1)
    dblen = klen - hlen - 1
    db = bytes.new(dblen)
    z = 0
    while z < dblen { bytes.set(db, z, 0); z = z + 1 }
    bytes.copy_from_bytes(db, 0, lhash, 0, hlen)
    ps_end = dblen - mlen - 1 // index of the 0x01 separator
    bytes.set(db, ps_end, 0x01)
    if mlen > 0 { bytes.copy_from_slice(db, ps_end + 1, msg[0..mlen]) }
    bytes.wipe_free(lhash)

    // dbMask = MGF1(seed, dblen); maskedDB = DB ^ dbMask
    dbmask = mgf1_hash(algo, bytes.view(seed)[0..hlen], dblen)
    xor_into(db, bytes.view(dbmask)[0..dblen])
    bytes.wipe_free(dbmask)

    // seedMask = MGF1(maskedDB, hLen); maskedSeed = seed ^ seedMask
    seedmask = mgf1_hash(algo, bytes.view(db)[0..dblen], hlen)
    mseed = bytes.new(hlen)
    bytes.copy_from_bytes(mseed, 0, seed, 0, hlen)
    xor_into(mseed, bytes.view(seedmask)[0..hlen])
    bytes.wipe_free(seedmask)

    // EM = 0x00 || maskedSeed || maskedDB
    em = bytes.new(klen)
    bytes.set(em, 0, 0)
    bytes.copy_from_bytes(em, 1, mseed, 0, hlen)
    bytes.copy_from_bytes(em, 1 + hlen, db, 0, dblen)
    bytes.wipe_free(mseed); bytes.wipe_free(db)

    ct = raw_encrypt(k, em)
    bytes.wipe_free(em)
    return ct
}

// Decrypt OAEP ciphertext (k bytes), SHA-256 and MGF1-SHA256:
// decrypt_oaep_hash with "sha256". Returns (plaintext, "") or (null, error)
// on any padding/format failure.
decrypt_oaep(k: ptr, ct_bytes: ptr) -> (ptr, string) {
    return decrypt_oaep_hash(k, "sha256", ct_bytes)
}

// Decrypt OAEP ciphertext (k bytes) over `algo` ("sha1", "sha256",
// "sha384" or "sha512"; MGF1 with the same hash), empty label. Returns
// (plaintext, "") or (null, error) on any padding/format failure. Every
// check reads all of the block and folds into one mask (Manger's attack
// needs only to tell the leading-byte check from the others); the verdict
// and the message length go through ct.declassify.
decrypt_oaep_hash(k: ptr, algo: string, ct_bytes: ptr) -> (ptr, string) {
    if oaep_hash_ok(algo) != 1 {
        return null, "unsupported OAEP hash '${algo}' (sha1, sha256, sha384, sha512)"
    }
    klen = modulus_bytes(k)
    hlen = pss_hlen(algo)
    if bytes.length(ct_bytes) != klen {
        return null, "ciphertext length mismatch"
    }
    if sig_in_range(k, ct_bytes) != 1 {
        return null, "ciphertext out of range"
    }
    if klen < 2 * hlen + 2 {
        return null, "modulus too small for OAEP"
    }
    em = raw_decrypt(k, ct_bytes)
    if em == null {
        return null, "rsa: not a private key, or no randomness for blinding"
    }

    empty = bytes.new(0)
    lhash = hashb(algo, bytes.view(empty)[0..0])
    bytes.wipe_free(empty)

    int good = ct.eq(bytes.get(em, 0) & 0xFF, 0) // leading byte must be 0x00

    // split: maskedSeed = em[1..1+hLen], maskedDB = em[1+hLen..k]
    dblen = klen - hlen - 1
    mseed = bytes.new(hlen)
    bytes.copy_from_bytes(mseed, 0, em, 1, hlen)
    db = bytes.new(dblen)
    bytes.copy_from_bytes(db, 0, em, 1 + hlen, dblen)

    // seed = maskedSeed ^ MGF1(maskedDB, hLen)
    seedmask = mgf1_hash(algo, bytes.view(db)[0..dblen], hlen)
    xor_into(mseed, bytes.view(seedmask)[0..hlen])
    bytes.wipe_free(seedmask)
    // DB = maskedDB ^ MGF1(seed, dblen)
    dbmask = mgf1_hash(algo, bytes.view(mseed)[0..hlen], dblen)
    xor_into(db, bytes.view(dbmask)[0..dblen])
    wipe_free(dbmask)

    // DB = lHash' || PS || 0x01 || M ; check lHash' == lHash
    int diff = 0
    int i = 0
    while i < hlen {
        diff = diff | ((bytes.get(db, i) ^ bytes.get(lhash, i)) & 0xFF)
        i = i + 1
    }
    bytes.wipe_free(lhash)
    good = good & ct.eq(diff, 0)

    // the 0x01 separator after zero padding: any other byte before it is bad
    int found = 0
    int sep = 0
    int stray = 0
    int j = hlen
    while j < dblen {
        int bv = bytes.get(db, j) & 0xFF
        int is_one = ct.eq(bv, 0x01)
        int is_zero = ct.eq(bv, 0x00)
        int before = 1 - found
        sep = ct.select(is_one & before, j, sep)
        stray = stray | (before & (1 - is_one) & (1 - is_zero))
        found = found | is_one
        j = j + 1
    }
    good = good & found & (1 - stray)

    if ct.declassify(good) != 1 {
        wipe_free(em); wipe_free(mseed); wipe_free(db)
        return null, "decryption error"
    }

    sep = ct.declassify(sep)
    mlen = dblen - sep - 1
    out = bytes.new(mlen)
    if mlen > 0 { bytes.copy_from_bytes(out, 0, db, sep + 1, mlen) }
    wipe_free(em); wipe_free(mseed); wipe_free(db)
    return out, ""
}

// ---- RSASSA-PSS (RFC 8017 §8.1 / §9.1) ----
// Sign the SHA-256 `mhash` (32 bytes) with `salt` (slen bytes, caller-
// supplied for determinism). Returns the k-byte signature, or null on error.
sign_pss(k: ptr, mhash: ptr, salt: byte[]) -> ptr {
    if salt.len < 0 { panic("rsa.sign_pss: the `salt` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    return sign_pss_hash(k, "sha256", mhash, salt)
}

// Verify a SHA-256 PSS signature (verify_pss_hash with "sha256").
verify_pss(k: ptr, mhash: ptr, sig: byte[], slen: int) -> int {
    if sig.len < 0 { panic("rsa.verify_pss: the `sig` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    return verify_pss_hash(k, "sha256", mhash, sig, slen)
}

// The digest length of `algo` ("sha1", "sha256", "sha384", "sha512"; 32
// otherwise).
fn pss_hlen(algo: string) -> int {
    if algo == "sha1" { return 20 }
    if algo == "sha384" { return 48 }
    if algo == "sha512" { return 64 }
    return 32
}

// The `algo` digest of `data` (fresh bytes), or null.
fn hashb(algo: string, data: byte[]) -> ptr {
    if algo == "sha1" { return sha1.bytes(data) }
    ctx, err = sha2.new(algo)
    if err != "" { return null }
    sha2.update(ctx, data)
    return sha2.final_bytes(ctx)
}

// MGF1 (RFC 8017 B.2.1) with `algo`.
fn mgf1_hash(algo: string, seed: byte[], mask_len: int) -> ptr {
    int seed_len = seed.len
    out = bytes.new(mask_len)
    produced = 0
    counter = 0
    while produced < mask_len {
        inb = bytes.new(seed_len + 4)
        bytes.copy_from_slice(inb, 0, seed[0..seed_len])
        bytes.set(inb, seed_len + 0, (counter >> 24) & 0xFF)
        bytes.set(inb, seed_len + 1, (counter >> 16) & 0xFF)
        bytes.set(inb, seed_len + 2, (counter >> 8) & 0xFF)
        bytes.set(inb, seed_len + 3, counter & 0xFF)
        h = hashb(algo, bytes.view(inb)[0..seed_len + 4])
        bytes.wipe_free(inb)
        take = bytes.length(h)
        if mask_len - produced < take { take = mask_len - produced }
        bytes.copy_from_bytes(out, produced, h, 0, take)
        bytes.wipe_free(h)
        produced = produced + take
        counter = counter + 1
    }
    return out
}

// Sign the `algo` digest `mhash` ("sha256", "sha384" or "sha512"; MGF1
// with the same hash) with `salt` (slen bytes, caller-supplied for
// determinism). Returns the k-byte signature, or null on error. TLS 1.3's
// rsa_pss_rsae_sha384 and _sha512 use it (#3357).
sign_pss_hash(k: ptr, algo: string, mhash: ptr, salt: byte[]) -> ptr {
    if salt.len < 0 { panic("rsa.sign_pss_hash: the `salt` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    int slen = salt.len
    klen = modulus_bytes(k)
    hlen = pss_hlen(algo)
    embits = modulus_bits(k) - 1
    emlen = (embits + 7) / 8
    if emlen < hlen + slen + 2 {
        return null
    }
    // M' = 0x00*8 || mHash || salt ; H = Hash(M')
    mp_len = 8 + hlen + slen
    mp = bytes.new(mp_len)
    z = 0
    while z < 8 { bytes.set(mp, z, 0); z = z + 1 }
    bytes.copy_from_bytes(mp, 8, mhash, 0, hlen)
    if slen > 0 { bytes.copy_from_slice(mp, 8 + hlen, salt[0..slen]) }
    h = hashb(algo, bytes.view(mp)[0..mp_len])
    bytes.wipe_free(mp)

    // DB = PS(0x00) || 0x01 || salt   (length emLen - hLen - 1)
    dblen = emlen - hlen - 1
    db = bytes.new(dblen)
    z = 0
    while z < dblen { bytes.set(db, z, 0); z = z + 1 }
    bytes.set(db, dblen - slen - 1, 0x01)
    if slen > 0 { bytes.copy_from_slice(db, dblen - slen, salt[0..slen]) }

    // maskedDB = DB ^ MGF1(H, dblen)
    dbmask = mgf1_hash(algo, bytes.view(h)[0..hlen], dblen)
    xor_into(db, bytes.view(dbmask)[0..dblen])
    bytes.wipe_free(dbmask)
    // clear the leftmost (8*emLen - embits) bits of maskedDB
    clear_bits = 8 * emlen - embits
    if clear_bits > 0 {
        mask = (0xFF >> clear_bits) & 0xFF
        bytes.set(db, 0, bytes.get(db, 0) & mask)
    }

    // EM = maskedDB || H || 0xbc
    em = bytes.new(emlen)
    bytes.copy_from_bytes(em, 0, db, 0, dblen)
    bytes.copy_from_bytes(em, dblen, h, 0, hlen)
    bytes.set(em, emlen - 1, 0xbc)
    bytes.wipe_free(db); bytes.wipe_free(h)

    // sig = raw_decrypt(EM as integer) — but emLen may be < klen; left-pad.
    emfull = bytes.new(klen)
    z = 0
    while z < klen { bytes.set(emfull, z, 0); z = z + 1 }
    bytes.copy_from_bytes(emfull, klen - emlen, em, 0, emlen)
    bytes.wipe_free(em)
    sig = raw_decrypt(k, emfull)
    bytes.wipe_free(emfull)
    return sig
}

// Verify a PSS signature `sig` (k bytes) over `mhash` (the `algo` digest:
// "sha256", "sha384" or "sha512"; MGF1 with the same hash) with the
// expected salt length `slen`. Returns 1 if valid, 0 otherwise.
verify_pss_hash(k: ptr, algo: string, mhash: ptr, sig: byte[], slen: int) -> int {
    if sig.len < 0 { panic("rsa.verify_pss_hash: the `sig` slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`") }
    klen = modulus_bytes(k)
    hlen = pss_hlen(algo)
    embits = modulus_bits(k) - 1
    emlen = (embits + 7) / 8
    if sig.len != klen { return 0 }
    // Same RFC 8017 range requirement as verify_pkcs1: s >= n is a
    // distinct byte string with the same residue — reject (malleability).
    if sig_in_range_slice(k, sig) != 1 { return 0 }

    emfull = raw_encrypt_slice(k, sig)
    // take the low emLen bytes as EM
    em = bytes.new(emlen)
    bytes.copy_from_bytes(em, 0, emfull, klen - emlen, emlen)
    bytes.wipe_free(emfull)

    ok = 1
    if (bytes.get(em, emlen - 1) & 0xFF) != 0xbc { ok = 0 }

    dblen = emlen - hlen - 1
    maskeddb = bytes.new(dblen)
    bytes.copy_from_bytes(maskeddb, 0, em, 0, dblen)
    h = bytes.new(hlen)
    bytes.copy_from_bytes(h, 0, em, dblen, hlen)

    // leftmost clear_bits of maskedDB must be zero
    clear_bits = 8 * emlen - embits
    if clear_bits > 0 {
        top = (bytes.get(maskeddb, 0) >> (8 - clear_bits)) & 0xFF
        if top != 0 { ok = 0 }
    }

    // DB = maskedDB ^ MGF1(H, dblen)
    dbmask = mgf1_hash(algo, bytes.view(h)[0..hlen], dblen)
    xor_into(maskeddb, bytes.view(dbmask)[0..dblen])
    bytes.wipe_free(dbmask)
    if clear_bits > 0 {
        mask = (0xFF >> clear_bits) & 0xFF
        bytes.set(maskeddb, 0, bytes.get(maskeddb, 0) & mask)
    }

    // DB must be 0x00*(dblen-slen-1) || 0x01 || salt
    i = 0
    while i < dblen - slen - 1 {
        if (bytes.get(maskeddb, i) & 0xFF) != 0 { ok = 0 }
        i = i + 1
    }
    if (bytes.get(maskeddb, dblen - slen - 1) & 0xFF) != 0x01 { ok = 0 }

    // salt = last slen bytes of DB; recompute H' = Hash(0^8 || mHash || salt)
    mp_len = 8 + hlen + slen
    mp = bytes.new(mp_len)
    z = 0
    while z < 8 { bytes.set(mp, z, 0); z = z + 1 }
    bytes.copy_from_bytes(mp, 8, mhash, 0, hlen)
    if slen > 0 { bytes.copy_from_bytes(mp, 8 + hlen, maskeddb, dblen - slen, slen) }
    hp = hashb(algo, bytes.view(mp)[0..mp_len])
    bytes.wipe_free(mp)
    i = 0
    while i < hlen {
        if (bytes.get(hp, i) & 0xFF) != (bytes.get(h, i) & 0xFF) { ok = 0 }
        i = i + 1
    }
    bytes.wipe_free(hp); bytes.wipe_free(h); bytes.wipe_free(maskeddb); bytes.wipe_free(em)
    return ok
}
