struct Haraka512Ctx {
    buf: ptr
    buf_pos: int
    s_scratch: ptr
    t_scratch: ptr
    s1_0: ptr
    s1_1: ptr
    s1_2: ptr
    s1_3: ptr
    s2_0: ptr
    s2_1: ptr
    s2_2: ptr
    s2_3: ptr
}

mul_x(p: int) -> int {
    return (((p & 0x7F) << 1) ^ (((p >> 7) & 1) * 0x1B)) & 255
}

aes_enc(c: *Haraka512Ctx, src: ptr, dst: ptr, rc_offset: int) {
    bytes.copy_from_bytes(dst, 0, src, 0, 16)

    // 1. SubBytes: dst -> s_scratch
    i = 0
    while i < 16 {
        b = bytes.get(dst, i)
        bytes.set(c.s_scratch, i, AES_SBOX[b & 255])
        i = i + 1
    }

    // 2. ShiftRows: s_scratch -> t_scratch
    bytes.set(c.t_scratch, 0, bytes.get(c.s_scratch, 0))
    bytes.set(c.t_scratch, 1, bytes.get(c.s_scratch, 5))
    bytes.set(c.t_scratch, 2, bytes.get(c.s_scratch, 10))
    bytes.set(c.t_scratch, 3, bytes.get(c.s_scratch, 15))
    bytes.set(c.t_scratch, 4, bytes.get(c.s_scratch, 4))
    bytes.set(c.t_scratch, 5, bytes.get(c.s_scratch, 9))
    bytes.set(c.t_scratch, 6, bytes.get(c.s_scratch, 14))
    bytes.set(c.t_scratch, 7, bytes.get(c.s_scratch, 3))
    bytes.set(c.t_scratch, 8, bytes.get(c.s_scratch, 8))
    bytes.set(c.t_scratch, 9, bytes.get(c.s_scratch, 13))
    bytes.set(c.t_scratch, 10, bytes.get(c.s_scratch, 2))
    bytes.set(c.t_scratch, 11, bytes.get(c.s_scratch, 7))
    bytes.set(c.t_scratch, 12, bytes.get(c.s_scratch, 12))
    bytes.set(c.t_scratch, 13, bytes.get(c.s_scratch, 1))
    bytes.set(c.t_scratch, 14, bytes.get(c.s_scratch, 6))
    bytes.set(c.t_scratch, 15, bytes.get(c.s_scratch, 11))

    // 3. MixColumns: t_scratch -> dst
    j = 0
    col = 0
    while col < 4 {
        col4 = col << 2
        s0 = bytes.get(c.t_scratch, col4)
        s1 = bytes.get(c.t_scratch, col4 + 1)
        s2 = bytes.get(c.t_scratch, col4 + 2)
        s3 = bytes.get(c.t_scratch, col4 + 3)

        m0 = mul_x(s0)
        m1 = mul_x(s1)
        m2 = mul_x(s2)
        m3 = mul_x(s3)

        bytes.set(dst, j, (m0 ^ m1 ^ s1 ^ s2 ^ s3) & 255)
        bytes.set(dst, j + 1, (s0 ^ m1 ^ m2 ^ s2 ^ s3) & 255)
        bytes.set(dst, j + 2, (s0 ^ s1 ^ m2 ^ m3 ^ s3) & 255)
        bytes.set(dst, j + 3, (m0 ^ s0 ^ s1 ^ s2 ^ m3) & 255)

        j = j + 4
        col = col + 1
    }

    // 4. XOR with rk (round constant)
    i = 0
    while i < 16 {
        b_s = bytes.get(dst, i)
        b_rc = HARAKA_RC[rc_offset + i]
        bytes.set(dst, i, (b_s ^ b_rc) & 255)
        i = i + 1
    }
}

mix512(c: *Haraka512Ctx) {
    bytes.copy_from_bytes(c.s2_0, 0, c.s1_0, 12, 4)
    bytes.copy_from_bytes(c.s2_0, 4, c.s1_2, 12, 4)
    bytes.copy_from_bytes(c.s2_0, 8, c.s1_1, 12, 4)
    bytes.copy_from_bytes(c.s2_0, 12, c.s1_3, 12, 4)

    bytes.copy_from_bytes(c.s2_1, 0, c.s1_2, 0, 4)
    bytes.copy_from_bytes(c.s2_1, 4, c.s1_0, 0, 4)
    bytes.copy_from_bytes(c.s2_1, 8, c.s1_3, 0, 4)
    bytes.copy_from_bytes(c.s2_1, 12, c.s1_1, 0, 4)

    bytes.copy_from_bytes(c.s2_2, 0, c.s1_2, 4, 4)
    bytes.copy_from_bytes(c.s2_2, 4, c.s1_0, 4, 4)
    bytes.copy_from_bytes(c.s2_2, 8, c.s1_3, 4, 4)
    bytes.copy_from_bytes(c.s2_2, 12, c.s1_1, 4, 4)

    bytes.copy_from_bytes(c.s2_3, 0, c.s1_0, 8, 4)
    bytes.copy_from_bytes(c.s2_3, 4, c.s1_2, 8, 4)
    bytes.copy_from_bytes(c.s2_3, 8, c.s1_1, 8, 4)
    bytes.copy_from_bytes(c.s2_3, 12, c.s1_3, 8, 4)
}

bytes_xor(len: int, s: ptr, src: ptr, src_off: int, dst: ptr, dst_off: int) {
    i = 0
    while i < len {
        b_s = bytes.get(s, i)
        b_src = bytes.get(src, src_off + i)
        bytes.set(dst, dst_off + i, (b_s ^ b_src) & 255)
        i = i + 1
    }
}

haraka512_256(c: *Haraka512Ctx, msg: ptr, output: ptr, outOff: int) {
    bytes.copy_from_bytes(c.s1_0, 0, msg, 0, 16)
    bytes.copy_from_bytes(c.s1_1, 0, msg, 16, 16)
    bytes.copy_from_bytes(c.s1_2, 0, msg, 32, 16)
    bytes.copy_from_bytes(c.s1_3, 0, msg, 48, 16)

    aes_enc(c, c.s1_0, c.s1_0, 0)
    aes_enc(c, c.s1_1, c.s1_1, 16)
    aes_enc(c, c.s1_2, c.s1_2, 32)
    aes_enc(c, c.s1_3, c.s1_3, 48)

    aes_enc(c, c.s1_0, c.s1_0, 64)
    aes_enc(c, c.s1_1, c.s1_1, 80)
    aes_enc(c, c.s1_2, c.s1_2, 96)
    aes_enc(c, c.s1_3, c.s1_3, 112)
    mix512(c)

    aes_enc(c, c.s2_0, c.s1_0, 128)
    aes_enc(c, c.s2_1, c.s1_1, 144)
    aes_enc(c, c.s2_2, c.s1_2, 160)
    aes_enc(c, c.s2_3, c.s1_3, 176)

    aes_enc(c, c.s1_0, c.s1_0, 192)
    aes_enc(c, c.s1_1, c.s1_1, 208)
    aes_enc(c, c.s1_2, c.s1_2, 224)
    aes_enc(c, c.s1_3, c.s1_3, 240)
    mix512(c)

    aes_enc(c, c.s2_0, c.s1_0, 256)
    aes_enc(c, c.s2_1, c.s1_1, 272)
    aes_enc(c, c.s2_2, c.s1_2, 288)
    aes_enc(c, c.s2_3, c.s1_3, 304)

    aes_enc(c, c.s1_0, c.s1_0, 320)
    aes_enc(c, c.s1_1, c.s1_1, 336)
    aes_enc(c, c.s1_2, c.s1_2, 352)
    aes_enc(c, c.s1_3, c.s1_3, 368)
    mix512(c)

    aes_enc(c, c.s2_0, c.s1_0, 384)
    aes_enc(c, c.s2_1, c.s1_1, 400)
    aes_enc(c, c.s2_2, c.s1_2, 416)
    aes_enc(c, c.s2_3, c.s1_3, 432)

    aes_enc(c, c.s1_0, c.s1_0, 448)
    aes_enc(c, c.s1_1, c.s1_1, 464)
    aes_enc(c, c.s1_2, c.s1_2, 480)
    aes_enc(c, c.s1_3, c.s1_3, 496)
    mix512(c)

    aes_enc(c, c.s2_0, c.s1_0, 512)
    aes_enc(c, c.s2_1, c.s1_1, 528)
    aes_enc(c, c.s2_2, c.s1_2, 544)
    aes_enc(c, c.s2_3, c.s1_3, 560)

    aes_enc(c, c.s1_0, c.s1_0, 576)
    aes_enc(c, c.s1_1, c.s1_1, 592)
    aes_enc(c, c.s1_2, c.s1_2, 608)
    aes_enc(c, c.s1_3, c.s1_3, 624)
    mix512(c)

    bytes_xor(16, c.s2_0, msg, 0, c.s1_0, 0)
    bytes_xor(16, c.s2_1, msg, 16, c.s1_1, 0)
    bytes_xor(16, c.s2_2, msg, 32, c.s1_2, 0)
    bytes_xor(16, c.s2_3, msg, 48, c.s1_3, 0)

    bytes.copy_from_bytes(output, outOff, c.s1_0, 8, 8)
    bytes.copy_from_bytes(output, outOff + 8, c.s1_1, 8, 8)
    bytes.copy_from_bytes(output, outOff + 16, c.s1_2, 0, 8)
    bytes.copy_from_bytes(output, outOff + 24, c.s1_3, 0, 8)
}

reset_ctx(c: *Haraka512Ctx) {
    c.buf_pos = 0
    i = 0
    while i < 64 {
        bytes.set(c.buf, i, 0)
        i = i + 1
    }
}

new() -> {
    c = malloc(96) as *Haraka512Ctx
    if c == null {
        return null, "allocation failed"
    }
    c.buf = bytes.new(64)
    c.s_scratch = bytes.new(16)
    c.t_scratch = bytes.new(16)
    c.s1_0 = bytes.new(16)
    c.s1_1 = bytes.new(16)
    c.s1_2 = bytes.new(16)
    c.s1_3 = bytes.new(16)
    c.s2_0 = bytes.new(16)
    c.s2_1 = bytes.new(16)
    c.s2_2 = bytes.new(16)
    c.s2_3 = bytes.new(16)
    reset_ctx(c)
    return c, ""
}

update_byte(c: *Haraka512Ctx, b: int) {
    if c.buf_pos >= 64 {
        // Haraka-512 takes exactly 64 bytes max
        return
    }
    bytes.set(c.buf, c.buf_pos, b & 255)
    c.buf_pos = c.buf_pos + 1
}

update(ctx: ptr, data: string, length: int) {
    c = ctx as *Haraka512Ctx
    if length <= 0 {
        return
    }
    i = 0
    while i < length {
        update_byte(c, string_char_at_n(data, length, i))
        i = i + 1
    }
}

update_bytes(ctx: ptr, data: ptr, length: int) {
    c = ctx as *Haraka512Ctx
    if length <= 0 {
        return
    }
    i = 0
    while i < length {
        update_byte(c, bytes.get(data, i))
        i = i + 1
    }
}

finalize_to_bytes(c: *Haraka512Ctx) -> ptr {
    out = bytes.new(32)
    haraka512_256(c, c.buf, out, 0)
    return out
}

free_internals(c: *Haraka512Ctx) {
    if c.buf != null {
        bytes.free(c.buf)
        c.buf = null
    }
    if c.s_scratch != null {
        bytes.free(c.s_scratch)
        c.s_scratch = null
    }
    if c.t_scratch != null {
        bytes.free(c.t_scratch)
        c.t_scratch = null
    }
    if c.s1_0 != null {
        bytes.free(c.s1_0)
        c.s1_0 = null
    }
    if c.s1_1 != null {
        bytes.free(c.s1_1)
        c.s1_1 = null
    }
    if c.s1_2 != null {
        bytes.free(c.s1_2)
        c.s1_2 = null
    }
    if c.s1_3 != null {
        bytes.free(c.s1_3)
        c.s1_3 = null
    }
    if c.s2_0 != null {
        bytes.free(c.s2_0)
        c.s2_0 = null
    }
    if c.s2_1 != null {
        bytes.free(c.s2_1)
        c.s2_1 = null
    }
    if c.s2_2 != null {
        bytes.free(c.s2_2)
        c.s2_2 = null
    }
    if c.s2_3 != null {
        bytes.free(c.s2_3)
        c.s2_3 = null
    }
}

final_bytes(ctx: ptr) -> ptr {
    c = ctx as *Haraka512Ctx
    out = finalize_to_bytes(c)
    s = bytes.finish(out, 32)
    free_internals(c)
    free(ctx)
    res = bytes.new(32)
    bytes.copy_from_string(res, 0, s, 32)
    return res
}

final_hex(ctx: ptr) -> string {
    c = ctx as *Haraka512Ctx
    out = finalize_to_bytes(c)
    hexbuf = bytes.new(64)
    i = 0
    while i < 32 {
        b = bytes.get(out, i)
        hi = (b >> 4) & 15
        lo = b & 15
        c_hi = 48 + hi
        if hi >= 10 {
            c_hi = 87 + hi
        }
        c_lo = 48 + lo
        if lo >= 10 {
            c_lo = 87 + lo
        }
        bytes.set(hexbuf, i * 2, c_hi)
        bytes.set(hexbuf, i * 2 + 1, c_lo)
        i = i + 1
    }
    bytes.free(out)
    s = bytes.finish(hexbuf, 64)
    free_internals(c)
    free(ctx)
    return s
}

free_ctx(ctx: ptr) {
    if ctx == null {
        return
    }
    c = ctx as *Haraka512Ctx
    free_internals(c)
    free(ctx)
}

// One-shot wrappers
haraka512_hex(data: string, len: int) -> string {
    ctx, err = new()
    if err != "" {
        return ""
    }
    update(ctx, data, len)
    return final_hex(ctx)
}

haraka512_bytes(data: string, len: int) -> ptr {
    ctx, err = new()
    if err != "" {
        return null
    }
    update(ctx, data, len)
    return final_bytes(ctx)
}