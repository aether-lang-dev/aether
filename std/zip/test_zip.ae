// std.zip reader tests. Self-contained: a small reference archive (produced by
// system `zip`, a stored a.txt + a deflate b.txt) is embedded as hex and
// decoded in-code, so the test needs no filesystem fixtures and runs anywhere.
// Run: ae run std/zip/test_zip.ae
import std.zip
import std.string
import std.bytes
import std.io
import std.fs
import std.path
import std.os
import std.tar

extern exit(code: int)
extern string_char_at_n(str: string, known_length: int, index: int) -> int

var fails: int = 0

fn check(name: string, got: string, want: string) {
    if string.equals(got, want) == 1 { println("  ok   ${name}") }
    else { println("  FAIL ${name}: got [${got}] want [${want}]"); fails = fails + 1 }
}
fn check_int(name: string, got: int, want: int) {
    if got == want { println("  ok   ${name}") }
    else { println("  FAIL ${name}: got ${got} want ${want}"); fails = fails + 1 }
}

fn hexval(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}

// Decode a hex string into a raw byte string of length n/2.
fn from_hex(h: string) -> (string, int) {
    hn = string.length(h)
    n = hn / 2
    b = bytes_new_str(n)
    i = 0
    while i < n {
        hi = hexval(string_char_at_n(h, hn, i * 2))
        lo = hexval(string_char_at_n(h, hn, i * 2 + 1))
        bytes_set_str(b, i, (hi << 4) | lo)
        i = i + 1
    }
    return bytes_finish_str(b, n), n
}

// Tiny helpers over std.bytes to assemble the decoded buffer as a string.
fn bytes_new_str(n: int) -> ptr {
    bb = bytes.new(n)
    if n > 0 { bytes.set(bb, n - 1, 0) }
    return bb
}
fn bytes_set_str(bb: ptr, i: int, v: int) { bytes.set(bb, i, v) }
fn bytes_finish_str(bb: ptr, n: int) -> string {
    s = bytes.to_string(bb, n)
    bytes.free(bb)
    return s
}

// A copy of `n` bytes of `s` in a std.bytes buffer whose length is `n + extra`
// (the extra bytes zeroed), for patching an archive in place.
fn patchable(s: string, n: int, extra: int) -> ptr {
    b = bytes.new(n + extra)
    bytes.set(b, n + extra - 1, 0)
    bytes.copy_from_string(b, 0, s, n)
    k = 0
    while k < extra {
        bytes.set(b, n + k, 0)
        k = k + 1
    }
    return b
}

// An end-of-central-directory comment that itself holds the EOCD signature
// must not hide the real record: open scans past it, as the comment length
// of a candidate has to reach exactly the end of the buffer.
fn check_eocd_comment() {
    out, outn, _e = zip.create("a.txt", string.bytes("hello zip")[0..9], zip.METHOD_STORED, 0)
    b = patchable(out, outn, 24)
    bytes.set_le16(b, outn - 2, 24) // the real record's comment length
    bytes.set_le32(b, outn, 0x06054b50) // the comment starts with "PK\5\6"
    ar, err = zip.open(bytes.view(b))
    check("eocd signature in comment: open err", err, "")
    if string.equals(err, "") == 1 {
        check_int("eocd signature in comment: real record found", zip.count(ar), 1)
        zip.close(ar)
    }
    bytes.free(b)
    string.free(out)
}

// Bytes appended after the EOCD record (padding, a signature block) leave
// the archive readable: no candidate's comment then reaches the end exactly,
// and the latest one that fits is the record, as Python's zipfile reads it.
fn check_eocd_trailing_bytes() {
    out, outn, _e = zip.create("a.txt", string.bytes("hello zip")[0..9], zip.METHOD_STORED, 0)
    b = patchable(out, outn, 3)
    ar, err = zip.open(bytes.view(b))
    check("eocd with trailing bytes: open err", err, "")
    if string.equals(err, "") == 1 {
        check_int("eocd with trailing bytes: entry found", zip.count(ar), 1)
        zip.close(ar)
    }
    bytes.free(b)
    string.free(out)
}

// A stored entry is its own size: a central directory whose uncompressed
// size disagrees (here 1 for 100 bytes) would make entry_size lie and let
// extract write past max_entry_bytes.
fn check_lying_stored_size(base: string) {
    data = "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
    out, outn, _e = zip.create("big.bin", string.bytes(data)[0..100], zip.METHOD_STORED, 0)
    b = patchable(out, outn, 0)
    cd = bytes.get_le32(b, outn - 22 + 16) // EOCD: central directory offset
    bytes.set_le32(b, cd + 24, 1) // the entry's uncompressed size: 1
    ar, err = zip.open(bytes.view(b))
    check("lying stored size: open err", err, "")
    if string.equals(err, "") == 1 {
        _body, blen, rerr = zip.entry_read(ar, 0)
        check_int("lying stored size: entry_read refused", string.equals(rerr, "") == 0, 1)
        check_int("lying stored size: entry_read returns nothing", blen, 0)
        zip.close(ar)
    }
    opts = zip.default_extract_options()
    opts.max_entry_bytes = 10
    opts.max_total_bytes = 10
    xerr = zip.extract(bytes.view(b), "${base}/bomb", opts)
    check_int("lying stored size: extract refused", string.equals(xerr, "") == 0, 1)
    check_int("lying stored size: nothing written", fs.exists("${base}/bomb/big.bin"), 0)
    bytes.free(b)
    string.free(out)
}

// One stored entry "n.txt" = "hello" whose central-directory sizes and
// local-header offset all sit in a ZIP64 extra field, set to `uncomp`,
// `comp` and `lfh`. 141 bytes: local header + data (0..40), central
// directory (40..119), EOCD (119..141).
fn zip64_archive(uncomp: long, comp: long, lfh: long) -> ptr {
    return zip64_archive_crc(uncomp, comp, lfh, 0x3610A686) // CRC-32 of "hello"
}

fn zip64_archive_crc(uncomp: long, comp: long, lfh: long, crc: int) -> ptr {
    b = bytes.new(141)
    bytes.set(b, 140, 0)
    // local file header
    bytes.set_le32(b, 0, 0x04034b50)
    bytes.set_le16(b, 4, 45)
    bytes.set_le16(b, 6, 0)
    bytes.set_le16(b, 8, 0) // stored
    bytes.set_le32(b, 10, 0) // time + date
    bytes.set_le32(b, 14, crc)
    bytes.set_le32(b, 18, 5)
    bytes.set_le32(b, 22, 5)
    bytes.set_le16(b, 26, 5)
    bytes.set_le16(b, 28, 0)
    bytes.copy_from_string(b, 30, "n.txt", 5)
    bytes.copy_from_string(b, 35, "hello", 5)
    // central directory header
    bytes.set_le32(b, 40, 0x02014b50)
    bytes.set_le16(b, 44, 45)
    bytes.set_le16(b, 46, 45)
    bytes.set_le16(b, 48, 0)
    bytes.set_le16(b, 50, 0) // stored
    bytes.set_le32(b, 52, 0) // time + date
    bytes.set_le32(b, 56, crc)
    bytes.set_le32(b, 60, -1) // compressed size: see ZIP64
    bytes.set_le32(b, 64, -1) // uncompressed size: see ZIP64
    bytes.set_le16(b, 68, 5)
    bytes.set_le16(b, 70, 28) // extra length
    bytes.set_le16(b, 72, 0)
    bytes.set_le16(b, 74, 0)
    bytes.set_le16(b, 76, 0)
    bytes.set_le32(b, 78, 0)
    bytes.set_le32(b, 82, -1) // local header offset: see ZIP64
    bytes.copy_from_string(b, 86, "n.txt", 5)
    bytes.set_le16(b, 91, 1) // ZIP64 extra block
    bytes.set_le16(b, 93, 24)
    bytes.set_le64(b, 95, uncomp)
    bytes.set_le64(b, 103, comp)
    bytes.set_le64(b, 111, lfh)
    // end of central directory
    bytes.set_le32(b, 119, 0x06054b50)
    bytes.set_le32(b, 123, 0) // disk numbers
    bytes.set_le16(b, 127, 1)
    bytes.set_le16(b, 129, 1)
    bytes.set_le32(b, 131, 79) // central directory size
    bytes.set_le32(b, 135, 40) // central directory offset
    bytes.set_le16(b, 139, 0)
    return b
}

// ZIP64 sizes and offsets are 64-bit: one at or past 2^63 must not come back
// as a negative size (which slips under extract's limits), and one past 2^32
// must not be narrowed to an in-range int that reads the wrong bytes.
fn check_zip64_fields() {
    var five: long = 5
    var zero: long = 0
    var past32: long = 4294967296 // 2^32
    var neg: long = -1 // 0xFFFFFFFFFFFFFFFF on the wire

    ok = zip64_archive(five, five, zero)
    ar, err = zip.open(bytes.view(ok))
    check("zip64 control: open err", err, "")
    if string.equals(err, "") == 1 {
        body, _bl, rerr = zip.entry_read(ar, 0)
        check("zip64 control: read err", rerr, "")
        check("zip64 control: content", body, "hello")
        zip.close(ar)
    }
    bytes.free(ok)

    nb = zip64_archive(neg, five, zero)
    _na, nerr = zip.open(bytes.view(nb))
    check_int("zip64 negative size: open refused", string.equals(nerr, "") == 0, 1)
    bytes.free(nb)

    cb = zip64_archive(past32 + five, past32 + five, zero)
    car, cerr = zip.open(bytes.view(cb))
    check("zip64 size past 2^32: open err", cerr, "")
    if string.equals(cerr, "") == 1 {
        _cbody, _cl, crerr = zip.entry_read(car, 0)
        check_int("zip64 size past 2^32: entry_read refused", string.equals(crerr, "") == 0, 1)
        zip.close(car)
    }
    bytes.free(cb)

    // A size just under 2^63: added to the data offset it wrapped negative,
    // slipped under the bounds check and was narrowed to a garbage count.
    // With CRC 0, a count narrowed to a negative int matched the CRC of
    // no bytes and came back as the entry's length.
    var huge: long = 9223372036854775800
    hb = zip64_archive_crc(huge, huge, zero, 0)
    har, herr = zip.open(bytes.view(hb))
    check("zip64 size near 2^63: open err", herr, "")
    if string.equals(herr, "") == 1 {
        _hbody, hl, hrerr = zip.entry_read(har, 0)
        check_int("zip64 size near 2^63: entry_read refused", string.equals(hrerr, "") == 0, 1)
        check_int("zip64 size near 2^63: entry_read returns nothing", hl, 0)
        zip.close(har)
    }
    bytes.free(hb)

    lb = zip64_archive(five, five, past32)
    lar, lerr = zip.open(bytes.view(lb))
    check("zip64 offset past 2^32: open err", lerr, "")
    if string.equals(lerr, "") == 1 {
        _lbody, _ll, lrerr = zip.entry_read(lar, 0)
        check_int("zip64 offset past 2^32: entry_read refused", string.equals(lrerr, "") == 0, 1)
        zip.close(lar)
    }
    bytes.free(lb)
}

// Make `link` a link to the directory `target_abs` (an absolute path):
// a symlink where the host allows one, else on Windows a directory
// junction, which needs no privilege. Returns 1 for a symlink, 2 for a
// junction, 0 when neither could be made.
fn make_dir_link(target_abs: string, link: string, link_win: string) -> int {
    if string.equals(fs.symlink(target_abs, link), "") == 1 { return 1 }
    if string.equals(os.platform(), "windows") == 1 {
        rc = os.os_system("mklink /J \"${link_win}\" \"${target_abs}\" >NUL")
        if rc == 0 && fs.exists(link) == 1 { return 2 }
    }
    return 0
}

fn one_entry_zip(name: string) -> (string, int) {
    w = zip.writer_new()
    zip.writer_add(w, name, string.bytes("pwn")[0..3], zip.METHOD_STORED, 0)
    out, outn, _e = zip.writer_finish(w)
    zip.writer_free(w)
    return out, outn
}

// An entry under a directory that already exists in the destination as a
// symlink (or junction) to somewhere else must not be written through it,
// neither by its plain name nor by a ".." route through a directory that
// does not exist yet (mkdir_p would create it, and then the OS walks on
// through the link).
fn check_symlinked_parent(base: string) {
    outside = "${base}/outside"
    dest = "${base}/linkdest"
    fs.mkdir_p(outside)
    fs.mkdir_p(dest)
    outside_abs, _k, _m = fs.realpath(outside)
    link = "${dest}/link"
    kind = make_dir_link(outside_abs, link, "${base}\\linkdest\\link")
    if kind == 0 {
        println("  skip symlinked parent: this host can make neither a symlink nor a junction")
        return
    }
    opts = zip.default_extract_options()

    a, an = one_entry_zip("link/pwned.txt")
    aerr = zip.extract(string.bytes(a)[0..an], dest, opts)
    check_int("symlinked parent: refused", string.contains(aerr, "resolves through a symlink"), 1)
    check_int("symlinked parent: nothing written outside", fs.exists("${outside}/pwned.txt"), 0)

    d, dn = one_entry_zip("missing/../link/pwned2.txt")
    derr = zip.extract(string.bytes(d)[0..dn], dest, opts)
    check_int("symlinked parent via ..: refused", string.contains(derr, "resolves through a symlink"), 1)
    check_int("symlinked parent via ..: nothing written outside", fs.exists("${outside}/pwned2.txt"), 0)

    // Remove the link itself, never what it points at.
    if kind == 1 { fs.unlink(link) } else { fs.delete_dir(link) }
    check_int("symlinked parent: link removed", fs.exists(link), 0)
}

// std.zip and std.tar share one ExtractOptions definition, so both import
// together and either module's options drive the other's extract.
fn check_options_shared_with_tar(base: string) {
    topts = tar.default_extract_options()
    out, outn, _e = zip.create("t.txt", string.bytes("tar opts")[0..8], zip.METHOD_STORED, 0)
    err = zip.extract(string.bytes(out)[0..outn], "${base}/taropts", topts)
    check("tar options drive zip.extract", err, "")
    check_int("tar options: file written", fs.exists("${base}/taropts/t.txt"), 1)
    topts.preserve_mode = 1
    perr = zip.extract(string.bytes(out)[0..outn], "${base}/taropts2", topts)
    check_int("preserve_mode refused by zip", string.equals(perr, "") == 0, 1)
    string.free(out)
}

// A 2-entry .zip (stored "a.txt" = "hi\n"; deflate "b.txt" = "xyz " * 40),
// produced by system `zip` and embedded verbatim.
const ZIP_HEX = ""

main() {
    println("=== std.zip ===")

    data, len = from_hex(ZIP_HEX)
    ar, oerr = zip.open(string.bytes(data)[0..len])
    if string.equals(oerr, "") != 1 { println("open FAIL: ${oerr}"); exit(1) }

    check_int("count", zip.count(ar), 2)

    // stored entry
    si = zip.find(ar, "a.txt")
    check_int("find a.txt", si >= 0, 1)
    check_int("a.txt method stored", zip.entry_method(ar, si), zip.METHOD_STORED)
    sb, _sl, serr = zip.entry_read(ar, si)
    check("a.txt read err empty", serr, "")
    check("a.txt content", sb, "hi\n")

    // deflate entry
    di = zip.find(ar, "b.txt")
    check_int("find b.txt", di >= 0, 1)
    check_int("b.txt method deflate", zip.entry_method(ar, di), zip.METHOD_DEFLATE)
    db, dl, derr = zip.entry_read(ar, di)
    check("b.txt read err empty", derr, "")
    check_int("b.txt length", dl, 160)
    check("b.txt head", string.substring(db, 0, 4), "xyz ")

    // missing name
    check_int("find missing -> -1", zip.find(ar, "nope"), -1)
    // not a dir
    check_int("a.txt not dir", zip.entry_is_dir(ar, si), 0)
    // not encrypted
    check_int("a.txt not encrypted", zip.entry_is_encrypted(ar, si), 0)

    zip.close(ar)

    // not a zip
    _na, naerr = zip.open(string.bytes("plainly not a zip archive at all, no sir")[0..39])
    if string.equals(naerr, "") == 0 { println("  ok   non-zip rejected") }
    else { println("  FAIL non-zip accepted"); fails = fails + 1 }

    // ---- writer: build in memory, then read back with the trusted reader ---
    println("--- writer ---")

    // Highly repetitive payload so deflate is genuinely smaller than stored.
    w_body = "ababababababababababababababababababababababababababababababababab deflate this"
    w_bl = string.length(w_body)
    s_body = "tiny" // 4 bytes: stored stays stored (deflate can't shrink it)
    s_bl = string.length(s_body)

    w = zip.writer_new()
    check("w add dir", zip.writer_add_dir(w, "d"), "")
    check("w add stored", zip.writer_add(w, "d/s.txt", string.bytes(s_body)[0..s_bl], zip.METHOD_STORED, 0), "")
    check("w add deflate", zip.writer_add(w, "big.txt", string.bytes(w_body)[0..w_bl], zip.METHOD_DEFLATE, 9), "")
    check("w add empty", zip.writer_add(w, "empty.dat", string.bytes(""), zip.METHOD_DEFLATE, 6), "")
    out, outlen, ferr = zip.writer_finish(w)
    check("w finish err", ferr, "")
    check_int("w archive nonempty", outlen > 0, 1)

    war, woerr = zip.open(string.bytes(out)[0..outlen])
    if string.equals(woerr, "") != 1 { println("  FAIL writer output not readable: ${woerr}"); fails = fails + 1 }
    else {
        check_int("w count", zip.count(war), 4)

        wi = zip.find(war, "big.txt")
        check_int("w find big.txt", wi >= 0, 1)
        // it must have actually deflated (smaller payload chose method 8)
        check_int("w big.txt method deflate", zip.entry_method(war, wi), zip.METHOD_DEFLATE)
        wb, _wl, wrerr = zip.entry_read(war, wi)
        check("w big.txt read err empty", wrerr, "")
        check("w big.txt content", wb, w_body)

        // the un-shrinkable payload fell back to stored
        sti = zip.find(war, "d/s.txt")
        check_int("w s.txt method stored", zip.entry_method(war, sti), zip.METHOD_STORED)
        stb, _stl, sterr = zip.entry_read(war, sti)
        check("w s.txt content", stb, s_body)

        // the directory entry
        wdi = zip.find(war, "d/")
        check_int("w dir is_dir", zip.entry_is_dir(war, wdi), 1)

        // the empty entry reads back as empty with no error
        wei = zip.find(war, "empty.dat")
        check_int("w find empty", wei >= 0, 1)
        eb, ebl, eerr = zip.entry_read(war, wei)
        check("w empty read err empty", eerr, "")
        check_int("w empty length 0", ebl, 0)
        check("w empty content", eb, "")

        zip.close(war)
    }
    zip.writer_free(w)

    // one-shot create(): a single deflate entry, read straight back
    c_body = "one-shot create: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    c_bl = string.length(c_body)
    cout, coutlen, cerr = zip.create("only.txt", string.bytes(c_body)[0..c_bl], zip.METHOD_DEFLATE, 6)
    check("create err empty", cerr, "")
    car, caoerr = zip.open(string.bytes(cout)[0..coutlen])
    if string.equals(caoerr, "") != 1 { println("  FAIL create output not readable: ${caoerr}"); fails = fails + 1 }
    else {
        check_int("create count", zip.count(car), 1)
        cb, _cl, crerr = zip.entry_read(car, 0)
        check("create read err empty", crerr, "")
        check("create content", cb, c_body)
        zip.close(car)
    }

    // ---- filesystem: dir-tree writer + extract round-trip -----------------
    println("--- filesystem ---")
    base = path.clean("zip_temp_test_dir")
    fs.remove_tree(base)
    fs.mkdir_p(base)

    // Build a small source tree.
    src = string.concat(base, "/src")
    fs.mkdir_p("${src}/sub/deep")
    fs.write_binary("${src}/a.txt", string.bytes("alpha\n"))
    big = "beta beta beta beta beta beta beta beta beta beta beta beta beta\n"
    fs.write_binary("${src}/sub/b.txt", string.bytes(big))
    fs.write_binary("${src}/sub/deep/c.txt", string.bytes("gamma\n"))

    // Pack it, prefixing entries with "pkg".
    tw = zip.writer_new()
    tperr = zip.add_dir_tree(tw, src, "pkg", zip.METHOD_DEFLATE, 6)
    check("add_dir_tree err empty", tperr, "")
    tout, toutlen, tferr = zip.writer_finish(tw)
    check("tree finish err empty", tferr, "")

    // Confirm the three files landed (order is fs.walk's, so check by find).
    tar2, tarerr = zip.open(string.bytes(tout)[0..toutlen])
    if string.equals(tarerr, "") != 1 { println("  FAIL tree archive unreadable: ${tarerr}"); fails = fails + 1 }
    else {
        check_int("tree count", zip.count(tar2), 3)
        check_int("tree find pkg/a.txt", zip.find(tar2, "pkg/a.txt") >= 0, 1)
        check_int("tree find pkg/sub/b.txt", zip.find(tar2, "pkg/sub/b.txt") >= 0, 1)
        check_int("tree find pkg/sub/deep/c.txt", zip.find(tar2, "pkg/sub/deep/c.txt") >= 0, 1)
        zip.close(tar2)
    }

    // Extract it back and verify content.
    xopts = zip.default_extract_options()
    xdest = string.concat(base, "/out")
    xerr = zip.extract(string.bytes(tout)[0..toutlen], xdest, xopts)
    check("extract err empty", xerr, "")
    check_int("extracted a.txt exists", fs.exists("${xdest}/pkg/a.txt"), 1)
    check_int("extracted nested exists", fs.exists("${xdest}/pkg/sub/deep/c.txt"), 1)
    ra, rlen, rerr2 = fs.read_binary("${xdest}/pkg/a.txt")
    check("extracted a.txt content", ra, "alpha\n")
    string.free(ra)
    zip.writer_free(tw)
    string.free(tout)

    // extract_file convenience: write the archive, extract from the path.
    zpath = string.concat(base, "/pkg.zip")
    cf_out, cf_len, _cfe = zip.create("hello.txt", string.bytes("world\n"), zip.METHOD_STORED, 0)
    fs.write_binary(zpath, string.bytes(cf_out)[0..cf_len])
    string.free(cf_out)
    ef_err = zip.extract_file(zpath, "${base}/out2", xopts)
    check("extract_file err empty", ef_err, "")
    check_int("extract_file wrote hello.txt", fs.exists("${base}/out2/hello.txt"), 1)

    // Security: a traversal entry must be refused, and nothing written.
    ew = zip.writer_new()
    zip.writer_add(ew, "../escape.txt", string.bytes("pwned"), zip.METHOD_STORED, 0)
    eout, eoutlen, _ef = zip.writer_finish(ew)
    e_err = zip.extract(string.bytes(eout)[0..eoutlen], "${base}/evil", xopts)
    check_int("traversal rejected", string.equals(e_err, "") == 0, 1)
    check_int("nothing escaped", fs.exists("${base}/escape.txt"), 0)
    string.free(eout)
    zip.writer_free(ew)

    // Absolute path must be refused too.
    aw = zip.writer_new()
    zip.writer_add(aw, "/tmp/pwn", string.bytes("x"), zip.METHOD_STORED, 0)
    aout, aoutlen, _af = zip.writer_finish(aw)
    a_err = zip.extract(string.bytes(aout)[0..aoutlen], "${base}/evil2", xopts)
    check_int("absolute path rejected", string.equals(a_err, "") == 0, 1)
    string.free(aout)
    zip.writer_free(aw)

    // ---- security regressions ----------------------------------------------
    println("--- security ---")
    check_eocd_comment()
    check_eocd_trailing_bytes()
    check_lying_stored_size(base)
    check_zip64_fields()
    check_symlinked_parent(base)
    check_options_shared_with_tar(base)

    string.free(src)
    string.free(xdest)
    string.free(zpath)
    fs.remove_tree(base)
    string.free(base)

    if fails == 0 { println("ALL PASS") }
    else { println("${fails} FAILED"); exit(1) }
}
