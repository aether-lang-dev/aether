// std.ipc, co-located with the module: what works within one process,
// over a socket pair from os.socketpair(). The cross-process half (a
// child spawned with os.run_socket, a hostile peer sending descriptors
// recv_fd must refuse, a 1 MB transfer each way) is
// tests/integration/std_ipc_socket/.
//
// On Windows the socket channel does not exist, and the suite checks
// that each entry point says so instead of skipping: portable code calls
// them unguarded.

import std.spec
import std.ipc
import std.os
import std.fs
import std.io
import std.bytes
import std.string
import std.list

// 0 when a child process inherits `fd`, as it would when the descriptor
// is not close-on-exec: the shell's redirection from it fails otherwise.
child_sees_fd(fd: int) -> int {
    argv = list.new()
    list.add(argv, "-c")
    list.add(argv, "exec 2>/dev/null; exec 9>&${fd}")
    _out, code, _err = os.run_capture("/bin/sh", argv, null)
    list.free(argv)
    return code
}

// A frame by hand, not by write_frame, so the tests do not trust what they
// test: the 4-byte big-endian length of `payload` (under 65536), then it.
frame_of(payload: string) -> string {
    n = string.length(payload)
    head = string.concat(string.from_char(0), string.from_char(0))
    head = string.concat(head, string.from_char(n / 256))
    head = string.concat(head, string.from_char(n % 256))
    return string.concat(head, payload)
}

// 7 bytes with a zero byte, a newline, a high byte and a CR in them.
const BINARY = "a\0b\nc\xffd\r"

// The first `n` bytes of the file `fd` reads from.
read_fd(fd: int, n: int) -> string {
    buf = bytes.new(n)
    got, err = io.fd_read_into(fd, bytes.capacity_view(buf)[0..n])
    if err != "" {
        bytes.free(buf)
        return "read failed: ${err}"
    }
    s = bytes.to_string(buf, got)
    bytes.free(buf)
    return s
}

main() {
    fw = spec.init()
    on_windows = string.equals(os.platform(), "windows")

    spec.describe(fw, "std.ipc without a parent channel") {
        spec.it("parent_channel is -1 and its kind is empty") callback {
            spec.assert_eq(ipc.parent_channel(), -1, "no AETHER_IPC_FD, no channel")
            spec.assert_str_eq(ipc.parent_channel_kind(), "", "no channel, no kind")
        }
    }

    if on_windows == 1 {
        spec.describe(fw, "std.ipc socket channel on Windows") {
            spec.it("reports each socket entry point as unsupported") callback {
                _a, _b, sp_err = os.socketpair()
                spec.assert_err(sp_err, "os.socketpair")
                spec.assert_err(ipc.send_fd(3, 4, "x"), "ipc.send_fd")
                fd, _p, rerr = ipc.recv_fd(3, 16)
                spec.assert_eq(fd, -1, "ipc.recv_fd gives no descriptor")
                spec.assert_err(rerr, "ipc.recv_fd")
                _d, _f, cerr = ipc.recv(3, 16)
                spec.assert_err(cerr, "ipc.recv")
                // wait_readable and read_frame_timeout wait on anonymous
                // pipes there (tests/integration/os_run_stdio); fd 3 is none.
                _r, werr = ipc.wait_readable(3, 10)
                spec.assert_err(werr, "ipc.wait_readable on no pipe")
                _fd, terr = ipc.read_frame_timeout(3, 16, 10)
                spec.assert_err(terr, "ipc.read_frame_timeout on no pipe")
            }
        }
        return spec.run_summary(fw)
    }

    spec.describe(fw, "os.socketpair") {
        // The probe's own control: a descriptor that is inherited (stdout)
        // must read as inherited, or "not inherited" below proves nothing.
        spec.it("child_sees_fd sees a descriptor a child does inherit") callback {
            spec.assert_eq(child_sees_fd(1), 0, "stdout is inherited")
        }

        spec.it("gives two open descriptors, both close-on-exec") callback {
            a, b, err = os.socketpair()
            spec.assert_ok(err, "socketpair")
            spec.assert_true(a >= 0 && b >= 0, "both ends are descriptors")
            spec.assert_not_eq(child_sees_fd(a), 0, "a child does not inherit end a")
            spec.assert_not_eq(child_sees_fd(b), 0, "a child does not inherit end b")
            io.fd_close(a)
            io.fd_close(b)
        }
    }

    spec.describe(fw, "ipc.write and ipc.read") {
        spec.it("carry bytes both ways, a zero byte and all included") callback {
            a, b, _ = os.socketpair()
            there = string.concat("hello\0world", "\xff!")
            spec.assert_ok(ipc.write(a, there), "write a to b")
            got, err = ipc.read(b, 100)
            spec.assert_ok(err, "read on b")
            spec.assert_eq(string.length(got), 13, "every byte arrived, past the zero")
            spec.assert_true(got == there, "and they are the bytes sent")

            spec.assert_ok(ipc.write(b, "and back"), "write b to a")
            back, err2 = ipc.read(a, 100)
            spec.assert_ok(err2, "read on a")
            spec.assert_str_eq(back, "and back", "the reply arrived")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("reads end of stream as no bytes and no error") callback {
            a, b, _ = os.socketpair()
            io.fd_close(a)
            got, err = ipc.read(b, 100)
            spec.assert_ok(err, "end of stream is not an error")
            spec.assert_eq(string.length(got), 0, "and carries no bytes")
            io.fd_close(b)
        }

        // Without MSG_NOSIGNAL (SO_NOSIGPIPE on macOS) this write ends the
        // whole test process with SIGPIPE, and the summary never prints.
        spec.it("fails, rather than raising SIGPIPE, writing to a closed peer") callback {
            a, b, _ = os.socketpair()
            io.fd_close(b)
            err = ipc.write(a, "into the void")
            spec.assert_err_contains(err, "ipc.write", "an error naming the call")
            io.fd_close(a)
        }

        spec.it("refuses a bad descriptor and a non-positive max") callback {
            spec.assert_err(ipc.write(-1, "x"), "write to -1")
            _d, err = ipc.read(-1, 10)
            spec.assert_err(err, "read from -1")
            a, b, _ = os.socketpair()
            _d2, err2 = ipc.read(a, 0)
            spec.assert_err(err2, "read of max 0")
            io.fd_close(a)
            io.fd_close(b)
        }
    }

    spec.describe(fw, "ipc.send_fd and ipc.recv_fd") {
        spec.it("pass an open file the receiver reads through") callback {
            path = "${os.temp_dir()}/std_ipc_spec_${os.getpid()}.txt"
            fs.write_atomic(path, string.bytes("passed by descriptor\n"))
            f, ferr = io.fd_open_read(path)
            spec.assert_ok(ferr, "open the file")

            a, b, _ = os.socketpair()
            spec.assert_ok(ipc.send_fd(a, f, "open this"), "send_fd")
            io.fd_close(f)
            fs.delete(path)

            got, payload, err = ipc.recv_fd(b, 100)
            spec.assert_ok(err, "recv_fd")
            spec.assert_true(got >= 0, "a descriptor arrived")
            spec.assert_str_eq(payload, "open this", "with its payload")
            spec.assert_str_eq(read_fd(got, 64), "passed by descriptor\n",
                "the file reads through it, though the sender closed its own and the path is gone")
            spec.assert_not_eq(child_sees_fd(got), 0, "the received descriptor is close-on-exec")
            io.fd_close(got)
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("refuses an empty payload") callback {
            a, b, _ = os.socketpair()
            spec.assert_err_contains(ipc.send_fd(a, a, ""), "empty payload", "nothing to attach it to")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("reports a message without a descriptor as an error") callback {
            a, b, _ = os.socketpair()
            ipc.write(a, "just bytes")
            got, _p, err = ipc.recv_fd(b, 100)
            spec.assert_eq(got, -1, "no descriptor")
            spec.assert_err_contains(err, "no descriptor", "an error saying so")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("reports end of stream as an error") callback {
            a, b, _ = os.socketpair()
            io.fd_close(a)
            got, _p, err = ipc.recv_fd(b, 100)
            spec.assert_eq(got, -1, "no descriptor")
            spec.assert_err_contains(err, "end of stream", "an error saying so")
            io.fd_close(b)
        }
    }

    spec.describe(fw, "ipc.recv") {
        spec.it("returns the bytes and the descriptor of one message") callback {
            path = "${os.temp_dir()}/std_ipc_recv_${os.getpid()}.txt"
            fs.write_atomic(path, string.bytes("through recv\n"))
            f, _ = io.fd_open_read(path)
            a, b, _ = os.socketpair()
            spec.assert_ok(ipc.send_fd(a, f, "no announcement"), "send_fd")
            io.fd_close(f)
            fs.delete(path)

            data, got, err = ipc.recv(b, 100)
            spec.assert_ok(err, "recv")
            spec.assert_str_eq(data, "no announcement", "the bytes")
            spec.assert_true(got >= 0, "and a descriptor with them, in the one call")
            spec.assert_str_eq(read_fd(got, 64), "through recv\n", "it reads through")
            spec.assert_not_eq(child_sees_fd(got), 0, "close-on-exec")
            io.fd_close(got)
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("gives -1 for a message that carried no descriptor") callback {
            a, b, _ = os.socketpair()
            ipc.write(a, BINARY)
            data, got, err = ipc.recv(b, 100)
            spec.assert_ok(err, "recv")
            spec.assert_eq(got, -1, "no descriptor")
            spec.assert_true(data == BINARY, "binary bytes intact")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("reads end of stream as no bytes, no descriptor, no error") callback {
            a, b, _ = os.socketpair()
            io.fd_close(a)
            data, got, err = ipc.recv(b, 100)
            spec.assert_ok(err, "end of stream is not an error")
            spec.assert_eq(string.length(data), 0, "no bytes")
            spec.assert_eq(got, -1, "no descriptor")
            io.fd_close(b)
        }

        spec.it("refuses a bad channel and a non-positive max") callback {
            _d, _f, err = ipc.recv(-1, 10)
            spec.assert_err(err, "recv on -1")
            a, b, _ = os.socketpair()
            _d2, _f2, err2 = ipc.recv(a, 0)
            spec.assert_err(err2, "recv of max 0")
            io.fd_close(a)
            io.fd_close(b)
        }
    }

    spec.describe(fw, "ipc.write_frame and ipc.read_frame") {
        spec.it("write a 4-byte big-endian length, then the bytes") callback {
            a, b, _ = os.socketpair()
            spec.assert_ok(ipc.write_frame(a, BINARY), "write_frame")
            raw, err = ipc.read(b, 100)
            spec.assert_ok(err, "read the wire")
            spec.assert_true(raw == frame_of(BINARY), "header 00 00 00 08, then the bytes")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("round-trip binary: NUL, newline, 0xff, and an empty frame") callback {
            a, b, _ = os.socketpair()
            spec.assert_ok(ipc.write_frame(a, BINARY), "write binary")
            spec.assert_ok(ipc.write_frame(a, ""), "write empty")
            spec.assert_ok(ipc.write_frame(a, "\n"), "write a newline")
            got, err = ipc.read_frame(b, 100)
            spec.assert_ok(err, "read binary")
            spec.assert_eq(string.length(got), 8, "every byte arrived")
            spec.assert_true(got == BINARY, "the bytes sent")
            empty, eerr = ipc.read_frame(b, 100)
            spec.assert_ok(eerr, "read empty")
            spec.assert_eq(string.length(empty), 0, "a frame of no bytes")
            nl, nerr = ipc.read_frame(b, 100)
            spec.assert_ok(nerr, "read newline")
            spec.assert_true(nl == "\n", "a newline alone")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("read whole a frame split at every offset") callback {
            wire = frame_of(BINARY)
            total = string.length(wire)
            k = 1
            while k < total {
                a, b, _ = os.socketpair()
                // The first part, a pause for the reader to block on it,
                // then the rest, and a second frame right behind.
                ipc.write(a, string.substring(wire, 0, k))
                ipc.write(a, string.concat(string.substring(wire, k, total), frame_of("next")))
                got, err = ipc.read_frame(b, 100)
                spec.assert_ok(err, "split at ${k}")
                spec.assert_true(got == BINARY, "whole frame split at ${k}")
                nxt, nerr = ipc.read_frame(b, 100)
                spec.assert_ok(nerr, "the next frame after a split at ${k}")
                spec.assert_str_eq(nxt, "next", "and nothing of it was taken by the first read")
                io.fd_close(a)
                io.fd_close(b)
                k = k + 1
            }
        }

        spec.it("read a frame dribbled a byte at a time") callback {
            wire = frame_of(BINARY)
            total = string.length(wire)
            a, b, _ = os.socketpair()
            i = 0
            while i < total {
                ipc.write(a, string.substring(wire, i, i + 1))
                i = i + 1
            }
            got, err = ipc.read_frame(b, 100)
            spec.assert_ok(err, "dribbled")
            spec.assert_true(got == BINARY, "whole")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("refuse a header announcing more than max, reading nothing past it") callback {
            a, b, _ = os.socketpair()
            // 0xffffffff bytes announced, 5 sent.
            big = string.concat(string.concat(string.from_char(255), string.from_char(255)),
                string.concat(string.from_char(255), string.from_char(255)))
            ipc.write(a, string.concat(big, "hello"))
            got, err = ipc.read_frame(b, 1000)
            spec.assert_err_contains(err, "longer than max", "oversize header")
            spec.assert_eq(string.length(got), 0, "no data")
            rest, rerr = ipc.read(b, 100)
            spec.assert_ok(rerr, "read the rest")
            spec.assert_str_eq(rest, "hello", "the payload was left unread: nothing was buffered")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("accept a frame of exactly max and refuse one byte over") callback {
            a, b, _ = os.socketpair()
            ipc.write_frame(a, "12345")
            got, err = ipc.read_frame(b, 5)
            spec.assert_ok(err, "5 within max 5")
            spec.assert_str_eq(got, "12345", "payload")
            ipc.write_frame(a, "123456")
            _g, err2 = ipc.read_frame(b, 5)
            spec.assert_err_contains(err2, "longer than max", "6 over max 5")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("tell end of stream from an empty frame, and truncation from both") callback {
            a, b, _ = os.socketpair()
            io.fd_close(a)
            _g, err = ipc.read_frame(b, 10)
            spec.assert_err_contains(err, "end of stream", "closed at a frame boundary")
            io.fd_close(b)

            c, d, _ = os.socketpair()
            ipc.write(c, string.substring(frame_of("abcdef"), 0, 7))
            io.fd_close(c)
            _g2, err2 = ipc.read_frame(d, 10)
            spec.assert_err_contains(err2, "inside a frame", "closed mid-payload")
            io.fd_close(d)

            e, f, _ = os.socketpair()
            ipc.write(e, string.substring(frame_of("abcdef"), 0, 2))
            io.fd_close(e)
            _g3, err3 = ipc.read_frame(f, 10)
            spec.assert_err_contains(err3, "inside a frame header", "closed mid-header")
            io.fd_close(f)
        }

        spec.it("refuse a bad channel and a non-positive max") callback {
            spec.assert_err(ipc.write_frame(-1, "x"), "write_frame to -1")
            _g, err = ipc.read_frame(-1, 10)
            spec.assert_err(err, "read_frame from -1")
            a, b, _ = os.socketpair()
            _g2, err2 = ipc.read_frame(a, 0)
            spec.assert_err(err2, "read_frame of max 0")
            io.fd_close(a)
            io.fd_close(b)
        }
    }

    spec.describe(fw, "ipc.wait_readable and ipc.read_frame_timeout") {
        spec.it("times out on a silent peer, after about the time asked") callback {
            a, b, _ = os.socketpair()
            t0 = os.now_monotonic_ms()
            ready, err = ipc.wait_readable(b, 100)
            took = os.now_monotonic_ms() - t0
            spec.assert_ok(err, "wait_readable")
            spec.assert_eq(ready, 0, "nothing to read")
            spec.assert_true(took >= 80, "it waited (${took} ms)")
            spec.assert_true(took < 5000, "and not forever (${took} ms)")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("is ready at once when bytes are there, and at end of stream") callback {
            a, b, _ = os.socketpair()
            ipc.write(a, "x")
            ready, err = ipc.wait_readable(b, 5000)
            spec.assert_ok(err, "bytes there")
            spec.assert_eq(ready, 1, "readable")
            ipc.read(b, 10)
            ready0, _ = ipc.wait_readable(b, 0)
            spec.assert_eq(ready0, 0, "a timeout of 0 asks without waiting")
            io.fd_close(a)
            ready2, _ = ipc.wait_readable(b, 5000)
            spec.assert_eq(ready2, 1, "a closed peer is readable: the read says end of stream")
            io.fd_close(b)
        }

        spec.it("refuses a bad descriptor") callback {
            _r, err = ipc.wait_readable(-1, 10)
            spec.assert_err(err, "wait on -1")
            _r2, err2 = ipc.wait_readable(9999, 10)
            spec.assert_err(err2, "wait on a closed number")
        }

        spec.it("read_frame_timeout times out on a silent peer") callback {
            a, b, _ = os.socketpair()
            t0 = os.now_monotonic_ms()
            _g, err = ipc.read_frame_timeout(b, 100, 100)
            took = os.now_monotonic_ms() - t0
            spec.assert_err_contains(err, "timed out", "nothing sent")
            spec.assert_true(took >= 80 && took < 5000, "in about 100 ms (${took})")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("read_frame_timeout bounds a peer that sends a header and stalls") callback {
            a, b, _ = os.socketpair()
            ipc.write(a, string.substring(frame_of("abcdef"), 0, 6))
            t0 = os.now_monotonic_ms()
            _g, err = ipc.read_frame_timeout(b, 100, 150)
            took = os.now_monotonic_ms() - t0
            spec.assert_err_contains(err, "timed out", "stalled mid-payload")
            spec.assert_true(took >= 120 && took < 5000, "in about 150 ms (${took})")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("a timeout before any byte leaves the stream usable, and says so") callback {
            a, b, _ = os.socketpair()
            _g, err = ipc.read_frame_timeout(b, 100, 50)
            spec.assert_true(err == ipc.TIMED_OUT_BETWEEN_FRAMES, "clean: ${err}")
            ipc.write_frame(a, "after")
            got, err2 = ipc.read_frame_timeout(b, 100, 5000)
            spec.assert_ok(err2, "the next frame reads")
            spec.assert_true(got == "after", "whole and in step")
            io.fd_close(a)
            io.fd_close(b)
        }

        spec.it("a timeout part-way through a header or payload says the stream is lost") callback {
            a, b, _ = os.socketpair()
            ipc.write(a, string.substring(frame_of("abcdef"), 0, 2))
            _g, err = ipc.read_frame_timeout(b, 100, 50)
            spec.assert_true(err == ipc.TIMED_OUT_INSIDE_FRAME, "mid-header: ${err}")
            io.fd_close(a)
            io.fd_close(b)
            c, d, _ = os.socketpair()
            ipc.write(c, string.substring(frame_of("abcdef"), 0, 6))
            _g2, err3 = ipc.read_frame_timeout(d, 100, 50)
            spec.assert_true(err3 == ipc.TIMED_OUT_INSIDE_FRAME, "mid-payload: ${err3}")
            io.fd_close(c)
            io.fd_close(d)
        }

        spec.it("read_frame_timeout reads a frame that arrives in time") callback {
            a, b, _ = os.socketpair()
            ipc.write_frame(a, BINARY)
            got, err = ipc.read_frame_timeout(b, 100, 5000)
            spec.assert_ok(err, "in time")
            spec.assert_true(got == BINARY, "whole")
            io.fd_close(a)
            io.fd_close(b)
        }
    }

    return spec.run_summary(fw)
}
