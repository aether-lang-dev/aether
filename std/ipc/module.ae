// std.ipc — child-to-parent and two-way channel IPC with descriptor passing.
//
// Companion to std.os.run_pipe and std.os.run_socket (parent side). When
// a parent spawns a child via std.os, the child can use std.ipc.parent_channel()
// to find the inherited channel descriptor.
//
// Supports two channel types:
//   - "pipe": write-only report pipe created by os.run_pipe / os.run_pipe_drain_and_wait.
//   - "socket": bidirectional Unix domain socket created by os.run_socket.
//
// Functions:
//   parent_channel() -> int                     Find channel fd or -1
//   parent_channel_kind() -> string             "pipe", "socket", or ""
//   write(fd, bytes) -> string                  Write bytes; "" or err
//   write_close(fd, bytes) -> string            Write bytes + close; "" or err
//   read(fd, max) -> (data, err)                Read up to max bytes; "" data and "" err on EOF
//   send_fd(ch, fd, payload) -> string          Send 1 descriptor + >=1 byte payload
//   recv_fd(ch, max) -> (fd, payload, err)      Receive 1 descriptor + payload

import std.net

exports(
    ipc_parent_channel_raw, ipc_parent_channel_kind_raw,
    ipc_write_raw, ipc_read_raw, ipc_send_fd_raw, ipc_recv_fd_raw,
    ipc_set_sock_buf_raw, ipc_get_cloexec_raw, test_ipc_send_two_fds, ipc_test_send_async_raw,
    parent_channel, parent_channel_kind, write, write_close, read, send_fd, recv_fd
)

extern ipc_parent_channel_raw() -> int
extern ipc_parent_channel_kind_raw() -> string
extern ipc_write_raw(fd: int, bytes: @aether string) -> string
extern ipc_read_raw(fd: int, max: int) -> (string @heap, string)
extern ipc_send_fd_raw(ch: int, fd: int, payload: @aether string) -> string
extern ipc_recv_fd_raw(ch: int, max: int) -> (int, string @heap, string)
extern ipc_set_sock_buf_raw(fd: int, size: int) -> int
extern ipc_get_cloexec_raw(fd: int) -> int
extern test_ipc_send_two_fds(ch: int, fd1: int, fd2: int, payload: string) -> int
extern ipc_test_send_async_raw(fd: int, payload: string) -> int

// Returns the parent-channel fd if the parent spawned this process
// via os.run_pipe or os.run_socket (i.e. AETHER_IPC_FD is set in env
// and the named fd is open); -1 otherwise.
parent_channel() -> int { return ipc_parent_channel_raw() }

// Returns the channel kind: "pipe" for a pipe channel, "socket" for a socket
// channel, or "" when no channel exists.
parent_channel_kind() -> string { return ipc_parent_channel_kind_raw() }

// Write `bytes` to `fd`. Returns "" on success, non-empty error string
// on failure. Loops on short writes and handles SIGPIPE / EINTR.
write(fd: int, bytes: string) -> string {
    return ipc_write_raw(fd, bytes)
}

// Write `bytes` then close the channel.
write_close(fd: int, bytes: string) -> string {
    werr = write(fd, bytes)
    net.fd_close(fd)
    return werr
}

// Binary-safe read of up to `max` bytes from `fd`. Returns (payload, err).
// On EOF (end-of-stream), returns ("", ""). On error, returns ("", err).
read(ch: int, max: int) -> (string @heap, string) {
    return ipc_read_raw(ch, max)
}

// Send one open file descriptor `fd` across socket channel `ch`, accompanied by
// `payload` (must be at least 1 byte). Returns "" on success, error message on failure.
send_fd(ch: int, fd: int, payload: string) -> string {
    return ipc_send_fd_raw(ch, fd, payload)
}

// Receive one open file descriptor and payload up to `max` bytes from socket
// channel `ch`. Returns (received_fd, payload, err).
recv_fd(ch: int, max: int) -> (int, string @heap, string) {
    return ipc_recv_fd_raw(ch, max)
}
