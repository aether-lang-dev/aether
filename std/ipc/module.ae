// std.ipc — a process's channel to its parent: a report pipe, or a two-way
// socket that can also pass open file descriptors.
//
// Companion to std.os.run_pipe and std.os.run_socket (parent side).
// When a parent spawns a child via os.run_pipe /
// os.run_pipe_drain_and_wait / os.run_socket, the child can use
// std.ipc.parent_channel() to find the fd of the inherited channel,
// and parent_channel_kind() to learn which kind it is.
//
// Models the brief in
// `~/scm/aetherBuild/asks/lightweight-ipc-dx.md` (DX shape) +
// `lightweight-ipc-dx-aether-reply.md` (proposed surface) +
// `lightweight-ipc-dx-aeb-final.md` (agreement).
//
// Primitives:
//
//   parent_channel() -> int                    find fd or -1
//   parent_channel_kind() -> string            "pipe", "socket" or ""
//   write(fd, bytes) -> string                 write all; "" or err
//   write_close(fd, bytes) -> string           write + close; "" or err
//   read(fd, max) -> (data, err)               one read; ("", "") at EOF
//   send_fd(ch, fd, payload) -> string         pass a descriptor; "" or err
//   recv_fd(ch, max) -> (fd, payload, err)     receive one descriptor
//   recv(ch, max) -> (data, fd, err)           bytes and the descriptor, if any
//   write_frame(ch, data) -> string            one length-prefixed frame
//   read_frame(ch, max) -> (data, err)         one frame, capped at max
//   read_frame_timeout(ch, max, ms) -> (data, err)   the same, bounded
//   TIMED_OUT_BETWEEN_FRAMES, TIMED_OUT_INSIDE_FRAME  its two timeouts
//   wait_readable(ch, ms) -> (ready, err)      bound a wait with poll()
//
// (write/write_close were originally named `send`/`send_close` per the
// design discussion; renamed because `send` is a reserved keyword in
// Aether for actor message-passing. `write` reads correctly here — the
// channel IS a writeable file descriptor under the hood.)
//
// read, send_fd and recv_fd work on any connected AF_UNIX stream socket,
// the parent's end from os.run_socket and both ends of os.socketpair
// included, not only on parent_channel(). send_fd / recv_fd are POSIX-only;
// on Windows they, and parent_channel(), report that there is none.
// recv and wait_readable are the same; write_frame, read_frame and
// read_frame_timeout work on Windows over plain descriptors (read_frame_timeout
// and wait_readable need poll(), which a CRT descriptor lacks, so with a
// deadline they report that).
//
// A descriptor never travels up a channel: the parent end os.run_socket
// returns refuses any descriptor its child sends, in recv and recv_fd. The
// child end, and both ends of os.socketpair, accept.
//
// Common shape — child writes one report at exit:
//
//   import std.ipc
//
//   ch = ipc.parent_channel()
//   if ch >= 0 {
//       err = ipc.write_close(ch, "passed=44\nfailed=3\n")
//   }

import std.io

exports(
    ipc_parent_channel_raw, ipc_parent_channel_kind_raw,
    ipc_write_raw, ipc_read_raw, ipc_send_fd_raw, ipc_recv_fd_raw,
    ipc_recv_raw, ipc_write_frame_raw, ipc_read_frame_raw, ipc_wait_readable_raw,
    parent_channel, parent_channel_kind, write, write_close, read, send_fd, recv_fd,
    recv, write_frame, read_frame, read_frame_timeout, wait_readable,
    TIMED_OUT_BETWEEN_FRAMES, TIMED_OUT_INSIDE_FRAME
)

// Returns the parent-channel fd if the parent spawned this process
// via os.run_pipe or os.run_socket (i.e. AETHER_IPC_FD is set in env
// and the named fd is open); -1 otherwise. Children of os.run /
// os.run_capture see -1 — those don't open a back-channel. On Windows
// always -1 (v1 stub). The fd value is whatever the parent picked;
// current parent-side default is 3 but consumers MUST NOT hardcode that.
extern ipc_parent_channel_raw() -> int
extern ipc_parent_channel_kind_raw() -> string
extern ipc_write_raw(fd: int, bytes: @aether string) -> string
extern ipc_read_raw(fd: int, max: int) -> (string @heap, string)
extern ipc_send_fd_raw(ch: int, fd: int, payload: @aether string) -> string
extern ipc_recv_fd_raw(ch: int, max: int) -> (int, string @heap, string)
extern ipc_recv_raw(ch: int, max: int) -> (string @heap, int, string)
extern ipc_write_frame_raw(ch: int, data: @aether string) -> string
extern ipc_read_frame_raw(ch: int, max: int, timeout_ms: int) -> (string @heap, string)
extern ipc_wait_readable_raw(ch: int, timeout_ms: int) -> (int, string)

// Aether-side wrappers. parent_channel returns the raw int from
// the extern; -1 sentinel for "no parent channel."
parent_channel() -> int { return ipc_parent_channel_raw() }

// "socket" for a channel from os.run_socket (two-way, can pass
// descriptors), "pipe" for one from os.run_pipe (write-only from the
// child), "" when parent_channel() finds none.
parent_channel_kind() -> string { return ipc_parent_channel_kind_raw() }

// Write all of `bytes` to `fd`. Returns "" on success, non-empty
// error string on failure. A short write continues where it stopped
// and an interrupted one retries, so "" means every byte went; a
// string with a zero byte in it goes whole. On a socket whose peer has
// gone this is an error, not SIGPIPE.
//
// For the common case where the child writes one payload and
// exits, prefer write_close so the parent's read_all loop sees
// EOF promptly.
write(fd: int, bytes: string) -> string {
    return ipc_write_raw(fd, bytes)
}

// Write `bytes` then close the channel. The common case: child
// produces one structured report at exit and closes the fd so
// the parent's drain loop sees EOF and stops.
//
// Calling close releases the writer's reference on the pipe; the
// parent sees EOF only after every writer has closed. If the
// child is itself going to exit immediately after, the kernel
// will close the fd anyway during process teardown — explicit
// close is still preferred because it lets the parent's reader
// unblock before the child exits, useful when the parent's
// reader runs in the same thread as the child-wait loop.
write_close(fd: int, bytes: string) -> string {
    werr = write(fd, bytes)
    io.fd_close(fd)
    return werr
}

// One read of up to `max` bytes: (data, "") with what arrived, which
// may be less than was written (the channel is a byte stream; framing
// is the caller's), ("", "") at end of stream, or ("", err).
// Binary-safe. Blocks until something arrives.
read(ch: int, max: int) -> {
    return ipc_read_raw(ch, max)
}

// Pass the open descriptor `fd` to the process at the other end of
// socket `ch`, attached to `payload`, which must be at least one byte
// (on a stream socket a descriptor travels with bytes). The receiver
// gets its own descriptor for the same open file; this side's `fd`
// stays open, so close it when this side is done with it.
send_fd(ch: int, fd: int, payload: string) -> string {
    return ipc_send_fd_raw(ch, fd, payload)
}

// Receive one descriptor from socket `ch`, with the bytes that came
// with it (up to `max`): (fd, payload, ""), or (-1, "", err). The
// descriptor is close-on-exec. A message carrying no descriptor, more
// than one, or control data of another kind is an error, and every
// descriptor that did arrive is closed first.
recv_fd(ch: int, max: int) -> {
    return ipc_recv_fd_raw(ch, max)
}

// One receive from socket `ch`: (data, fd, ""), up to `max` bytes and the
// descriptor that came with them, or -1 when the message carried none. One
// recvmsg returns both, so a peer need not announce a descriptor before
// sending it. ("", -1, "") is end of stream; ("", -1, err) a failure.
//
// At most one descriptor (close-on-exec). More than one, control data of
// another kind, or control data cut short is an error, and every descriptor
// that arrived is closed first, with the bytes that came with it.
//
// The parent end of a channel os.run_socket made takes no descriptor at all:
// one arriving from the child is closed and an error returned, with no opt-in
// by the host (a sandboxed child has no business handing its parent
// descriptors). The child end and os.socketpair's ends accept. The parent end
// is the descriptor os.run_socket returned, until it is closed with
// io.fd_close; recv_fd refuses on it too. read, which receives no control
// data, lets the kernel drop a descriptor riding on the bytes.
recv(ch: int, max: int) -> {
    return ipc_recv_raw(ch, max)
}

// Write `data` as one frame: a 4-byte big-endian unsigned length, then the
// bytes. Any bytes, 0x00 and 0x0a included: the length is the string's, not
// a terminator's. "" or an error; a payload of 4 GiB or more is one. An empty
// payload is a frame of length 0.
write_frame(ch: int, data: string) -> string {
    return ipc_write_frame_raw(ch, data)
}

// Read one frame: (data, "") whole, blocking until all of it has arrived.
// `max` is a hard cap on the payload: a header announcing more is an error,
// and nothing is allocated or read past the header. A frame split at any
// offset across writes reads the same. Exactly the frame is consumed, never
// a byte of the next.
//
// A frame of length 0 is ("", ""). End of stream before the first header
// byte is the error "end of stream", so ("", "") is never an end; end inside
// a frame is an error too. Receives no descriptors (see recv).
read_frame(ch: int, max: int) -> {
    return ipc_read_frame_raw(ch, max, -1)
}

// read_frame_timeout's error when the deadline passed before the first byte
// of a frame arrived. Nothing was consumed: the stream is between frames and
// fit to use, to send the peer a CANCEL, say, and read its answer.
const TIMED_OUT_BETWEEN_FRAMES = "ipc.read_frame: timed out before a frame began"

// read_frame_timeout's error when the deadline passed part-way through a
// frame's header or payload. The bytes already read are gone with the call,
// so the stream is out of step: close the channel.
const TIMED_OUT_INSIDE_FRAME = "ipc.read_frame: timed out inside a frame; the stream is out of step"

// read_frame with a deadline: `timeout_ms` bounds the whole frame, header
// and payload together, so a peer that sends a header and stalls, or drips
// bytes, cannot hold the reader past it. A negative timeout waits forever,
// as read_frame does. A timeout is one of two errors: TIMED_OUT_BETWEEN_FRAMES
// when no byte of a frame had arrived (the stream is intact; carry on using
// it), TIMED_OUT_INSIDE_FRAME when one had (close the channel). Any other
// error leaves the stream unusable too. Not available on Windows (an error
// there, unless the timeout is negative).
read_frame_timeout(ch: int, max: int, timeout_ms: int) -> {
    return ipc_read_frame_raw(ch, max, timeout_ms)
}

// Wait up to `timeout_ms` for `ch` to be readable (poll): (1, "") when a
// read will not block, which includes the peer having closed (the read then
// gives end of stream), (0, "") on a timeout, (0, err) on a failure. A
// negative timeout waits forever; 0 asks without waiting. Bounds the wait for
// the first byte of read or recv. Frames need no wait first:
// read_frame_timeout tells a timeout between frames from one inside a frame.
// An error on Windows.
wait_readable(ch: int, timeout_ms: int) -> {
    return ipc_wait_readable_raw(ch, timeout_ms)
}
