// std.math random_* and the integer/NaN edges of the basic helpers.
//
// random_int was `min + rand() % (max - min + 1)`: on Windows RAND_MAX is
// 32767, so random_int(0, 1000000) never went above 32767, the modulo was
// biased, and over the whole int range `max - min + 1` overflowed to 0 and
// divided by zero. It is splitmix64 now, seeded, the same on every
// platform.

import std.math

extern exit(code: int)

var fails: int = 0

fn check(cond: bool, msg: string) {
    if cond { println("  PASS: ${msg}") }
    else { println("  FAIL: ${msg}"); fails = fails + 1 }
}

main() {
    print("=== std.math random and edges ===\n\n")

    // The same seed, the same sequence.
    math.random_seed(7)
    a1 = math.random_int(0, 1000000)
    a2 = math.random_int(0, 1000000)
    a3 = math.random_int(0, 1000000)
    math.random_seed(7)
    b1 = math.random_int(0, 1000000)
    b2 = math.random_int(0, 1000000)
    b3 = math.random_int(0, 1000000)
    check(a1 == b1 && a2 == b2 && a3 == b3, "a seed replays its sequence")
    // And it is splitmix64's sequence on every platform: the values below
    // were computed independently from the published algorithm. Any other
    // generator (the old rand()) fails this everywhere, not only where
    // RAND_MAX is small.
    check(a1 == 964678 && a2 == 892899 && a3 == 478616, "seed 7 gives splitmix64's draws (${a1} ${a2} ${a3})")
    math.random_seed(7)
    f1 = math.random_float()
    check(f1 > 0.38982974839127 && f1 < 0.38982974839128, "seed 7's first random_float is splitmix64's (${f1})")

    // The whole span is reachable: 20000 draws from [0, 1000000] reach far
    // past 32767, and stay in range.
    math.random_seed(1)
    hi = 0
    out_of_range = 0
    i = 0
    while i < 20000 {
        r = math.random_int(0, 1000000)
        if r > hi { hi = r }
        if r < 0 || r > 1000000 { out_of_range = out_of_range + 1 }
        i = i + 1
    }
    check(hi > 900000, "random_int(0, 1000000) reaches the top of its range (max ${hi})")
    check(out_of_range == 0, "random_int stays within [min, max]")

    // The whole int range: no divide by zero, and both signs come up.
    neg = 0
    pos = 0
    i = 0
    while i < 1000 {
        r = math.random_int(0 - 2147483647 - 1, 2147483647)
        if r < 0 { neg = neg + 1 }
        if r > 32767 { pos = pos + 1 }
        i = i + 1
    }
    check(neg > 0 && pos > 0, "random_int(INT_MIN, INT_MAX) draws across the range")

    // Both ends included, every value reachable.
    seen = 0
    i = 0
    while i < 2000 {
        r = math.random_int(0 - 3, 3)
        if r < 0 - 3 || r > 3 { out_of_range = out_of_range + 1 }
        seen = seen | (1 << (r + 3))
        i = i + 1
    }
    check(seen == 127 && out_of_range == 0, "random_int(-3, 3) hits all seven values and nothing else")
    check(math.random_int(5, 5) == 5 && math.random_int(9, 2) == 9, "an empty or single range returns min")

    // [0, 1): never 1.0.
    lo_ok = 1
    i = 0
    while i < 20000 {
        f = math.random_float()
        if f < 0.0 || f >= 1.0 { lo_ok = 0 }
        i = i + 1
    }
    check(lo_ok == 1, "random_float is in [0, 1)")

    // abs_int(INT_MIN) wraps to INT_MIN (no positive counterpart in an int);
    // it was signed overflow, undefined in C.
    int_min = 0 - 2147483647 - 1
    check(math.abs_int(int_min) == int_min, "abs_int(INT_MIN) is INT_MIN")
    check(math.abs_int(0 - 5) == 5 && math.abs_int(5) == 5, "abs_int of ordinary values")

    // A NaN operand gives the other one, whichever side it is on: min(NaN, 1)
    // was 1 but min(1, NaN) was NaN.
    nan = math.sqrt(0.0 - 1.0)
    check(math.min_float(nan, 1.0) == 1.0 && math.min_float(1.0, nan) == 1.0, "min_float ignores a NaN on either side")
    check(math.max_float(nan, 1.0) == 1.0 && math.max_float(1.0, nan) == 1.0, "max_float ignores a NaN on either side")

    if fails > 0 {
        println("\n${fails} FAILED")
        exit(1)
    }
    print("\n=== All math random/edge tests passed ===\n")
}
