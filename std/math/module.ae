// std.math - Math Module
// Import with: import std.math

exports(
    math_abs_int, math_abs_float,
    math_min_int, math_max_int, math_min_float, math_max_float,
    math_clamp_int, math_clamp_float,
    math_sqrt, math_pow,
    math_sin, math_cos, math_tan,
    math_asin, math_acos, math_atan, math_atan2,
    math_floor, math_ceil, math_round, math_lrint,
    math_log, math_log10, math_exp,
    math_random_seed, math_random_int, math_random_float,
    math_pi, math_tau, math_e, math_deg_to_rad, math_rad_to_deg,
    math_sqrt_f32, math_abs_f32, math_min_f32, math_max_f32, math_clamp_f32,
    math_sin_f32, math_cos_f32, math_tan_f32, math_atan2_f32,
    math_floor_f32, math_ceil_f32, math_pow_f32, math_exp_f32
)

// Basic operations (int/float variants)
extern math_abs_int(x: int) -> int
extern math_abs_float(x: float) -> float
extern math_min_int(a: int, b: int) -> int
extern math_max_int(a: int, b: int) -> int
extern math_min_float(a: float, b: float) -> float
extern math_max_float(a: float, b: float) -> float
extern math_clamp_int(x: int, min: int, max: int) -> int
extern math_clamp_float(x: float, min: float, max: float) -> float

// Advanced math
extern math_sqrt(x: float) -> float
extern math_pow(base: float, exp: float) -> float
extern math_sin(x: float) -> float
extern math_cos(x: float) -> float
extern math_tan(x: float) -> float
extern math_asin(x: float) -> float
extern math_acos(x: float) -> float
extern math_atan(x: float) -> float
extern math_atan2(y: float, x: float) -> float
extern math_floor(x: float) -> float
extern math_ceil(x: float) -> float
extern math_round(x: float) -> float
// Rounds half-to-EVEN and returns an integer directly (math_round rounds
// half-away-from-zero and returns a float you must then cast).
extern math_lrint(x: float) -> long
extern math_log(x: float) -> float
extern math_log10(x: float) -> float
extern math_exp(x: float) -> float

// Single precision (#2151). Each is libm's `f` function (sqrtf, fabsf,
// fminf, ...): an f32 argument stays a C float and the result is f32, so
// `math.sqrt_f32(dot(v, v))` in an f32 pipeline is one float sqrt. The
// double functions above take an f32 too, but widen it and return float.
extern math_sqrt_f32(x: f32) -> f32
extern math_abs_f32(x: f32) -> f32
extern math_min_f32(a: f32, b: f32) -> f32
extern math_max_f32(a: f32, b: f32) -> f32
extern math_clamp_f32(x: f32, min: f32, max: f32) -> f32
extern math_sin_f32(x: f32) -> f32
extern math_cos_f32(x: f32) -> f32
extern math_tan_f32(x: f32) -> f32
extern math_atan2_f32(y: f32, x: f32) -> f32
extern math_floor_f32(x: f32) -> f32
extern math_ceil_f32(x: f32) -> f32
extern math_pow_f32(base: f32, exp: f32) -> f32
extern math_exp_f32(x: f32) -> f32

// Random numbers
extern math_random_seed(seed: int)
extern math_random_int(min: int, max: int) -> int
extern math_random_float() -> float

// Function-constants. Aether has no const-expression evaluator at the
// call site, so trigonometric / radian-conversion constants are
// zero-arg functions. The C lowering is `return <literal>`; any
// reasonable C compiler inlines it. Keeps the `math.*` namespace
// uniform with the trig / pow / sqrt functions above.
extern math_pi() -> float
extern math_tau() -> float
extern math_e() -> float
extern math_deg_to_rad() -> float
extern math_rad_to_deg() -> float
