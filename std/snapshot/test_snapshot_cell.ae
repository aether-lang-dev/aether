// std.snapshot unit tests (#1584) — co-located with the module.
//
// The module had no test of any kind before this. A snapshot cell is a
// lock-free pointer holder: load reads it, store publishes a new value
// and hands back the displaced one for the writer to reclaim, and cas
// swaps only if the current value matches what the caller expected.
//
// The contracts worth pinning are the ones a reader has to take on
// trust from the doc comments: that store RETURNS the old pointer
// rather than freeing it, that a failed cas leaves the cell untouched,
// and that every entry point is null-safe. All three are the kind of
// thing a refactor can quietly break.
//
// Values here are list handles used purely as distinct heap pointers —
// the cell never dereferences what it holds, so their contents are
// irrelevant and only their identity matters. Identity is compared via
// mem.ptr_to_long because ptr has no direct equality operator.

import std.spec
import std.snapshot
import std.collections
import std.mem

fn same_ptr(a: ptr, b: ptr) -> int {
    if mem.ptr_to_long(a) == mem.ptr_to_long(b) {
        return 1
    }
    return 0
}

main() {
    fw = spec.init()

    spec.describe(fw, "std.snapshot load and store") {
        spec.it("loads the value it was created with") callback {
            v = collections.list_new()
            cell = snapshot.new(v)
            spec.assert_true(same_ptr(snapshot.load(cell), v),
                "load returns the initial value")
            snapshot.free(cell)
            collections.list_free(v)
        }

        spec.it("publishes a new value and returns the displaced one") callback {
            // The displaced pointer is the writer's to reclaim — the
            // cell does not free it. A store that returned the NEW
            // value, or null, would leak the old one at every call
            // site that follows the documented pattern.
            first = collections.list_new()
            second = collections.list_new()
            cell = snapshot.new(first)
            displaced = snapshot.store(cell, second)
            spec.assert_true(same_ptr(displaced, first),
                "store returns the previous value")
            spec.assert_true(same_ptr(snapshot.load(cell), second),
                "load now sees the new value")
            snapshot.free(cell)
            collections.list_free(first)
            collections.list_free(second)
        }

        spec.it("holds a null value without complaint") callback {
            cell = snapshot.new(null)
            spec.assert_true(same_ptr(snapshot.load(cell), null),
                "a null-initialised cell loads null")
            snapshot.free(cell)
        }
    }

    spec.describe(fw, "std.snapshot compare-and-swap") {
        spec.it("swaps when the expected value matches") callback {
            current = collections.list_new()
            next = collections.list_new()
            cell = snapshot.new(current)
            spec.assert_eq(snapshot.cas(cell, current, next), 1,
                "cas reports success")
            spec.assert_true(same_ptr(snapshot.load(cell), next),
                "cell now holds the new value")
            snapshot.free(cell)
            collections.list_free(current)
            collections.list_free(next)
        }

        spec.it("refuses and changes nothing when expected does not match") callback {
            current = collections.list_new()
            wrong = collections.list_new()
            next = collections.list_new()
            cell = snapshot.new(current)
            spec.assert_eq(snapshot.cas(cell, wrong, next), 0,
                "cas reports failure")
            spec.assert_true(same_ptr(snapshot.load(cell), current),
                "cell is untouched after a failed cas")
            snapshot.free(cell)
            collections.list_free(current)
            collections.list_free(wrong)
            collections.list_free(next)
        }

        spec.it("supports the documented load-then-cas retry loop") callback {
            // The pattern the module's own comment prescribes: read the
            // current snapshot, build a successor, swap it in.
            a = collections.list_new()
            b = collections.list_new()
            cell = snapshot.new(a)
            observed = snapshot.load(cell)
            spec.assert_eq(snapshot.cas(cell, observed, b), 1,
                "cas against a freshly loaded value succeeds")
            snapshot.free(cell)
            collections.list_free(a)
            collections.list_free(b)
        }
    }

    spec.describe(fw, "std.snapshot null safety") {
        spec.it("loads null from a null cell") callback {
            spec.assert_true(same_ptr(snapshot.load(null), null),
                "load(null) is null, not a crash")
        }

        spec.it("reports failure for a cas on a null cell") callback {
            v = collections.list_new()
            spec.assert_eq(snapshot.cas(null, v, v), 0,
                "cas(null, ...) returns 0")
            collections.list_free(v)
        }

        spec.it("tolerates freeing a null cell") callback {
            // Documented null-safe; the assertion is that control
            // reaches the next line at all.
            snapshot.free(null)
            spec.assert_true(1, "free(null) did not crash")
        }
    }

    spec.run_summary(fw)
}
