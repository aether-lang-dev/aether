// std.time regression — civil date/time over Unix epoch (UTC).
//
// Vectors adapted from C3's stdlib unit tests (test/unit/stdlib/time/
// datetime.c3) — Copyright (c) 2022-2026 Christoffer Lernö and
// contributors, MIT — plus known Unix-epoch fixtures. Aether's API is
// free-function + struct-field rather than C3's methods/operators, so the
// vectors are re-expressed (e.g. `d.add_weeks(1)` -> `time.add_days(d, 7)`).

import std.time
import std.string

extern exit(code: int)

fn ck(cond: bool, msg: string) -> int {
    if !cond { println("FAIL: ${msg}"); return 1 }
    return 0
}

main() {
    fails = 0

    // ---- known epoch fixtures ----
    e0 = time.from_unix(0)
    fails = fails + ck(e0.year == 1970 && e0.month == 1 && e0.day == 1, "epoch date")
    fails = fails + ck(e0.hour == 0 && e0.minute == 0 && e0.second == 0, "epoch time")
    fails = fails + ck(e0.wday == 4, "epoch is Thursday (wday 4)")

    // 1234567890 = 2009-02-13T23:31:30Z (a Friday)
    t = time.from_unix(1234567890)
    fails = fails + ck(t.year == 2009 && t.month == 2 && t.day == 13, "1234567890 date")
    fails = fails + ck(t.hour == 23 && t.minute == 31 && t.second == 30, "1234567890 time")
    fails = fails + ck(t.wday == 5, "1234567890 is Friday")

    // ---- civil round-trip ----
    c = time.from_civil(2009, 2, 13, 23, 31, 30)
    fails = fails + ck(c.epoch == 1234567890, "civil -> epoch round-trip")

    // ---- C3 datetime vector: 1973-04-27, add 1 week -> 1973-05-04 ----
    d = time.from_civil(1973, 4, 27, 0, 0, 0)
    fails = fails + ck(d.year == 1973 && d.month == 4 && d.day == 27, "c3 base date")
    d1 = time.add_days(d, 7)
    fails = fails + ck(d1.year == 1973 && d1.month == 5 && d1.day == 4, "c3 add 1 week")
    // + 1 day / - 1 day
    dp = time.add_days(d1, 1)
    fails = fails + ck(dp.day == 5, "c3 add 1 day")
    dm = time.add_days(dp, -1)
    fails = fails + ck(dm.day == 4, "c3 sub 1 day")

    // ---- leap-year handling: 2000 is leap, 1900 is not, 2001 is not ----
    fails = fails + ck(time.is_leap_year(2000), "2000 leap")
    fails = fails + ck(!time.is_leap_year(1900), "1900 not leap")
    fails = fails + ck(!time.is_leap_year(2001), "2001 not leap")
    fails = fails + ck(time.is_leap_year(2024), "2024 leap")
    fails = fails + ck(time.days_in_month(2024, 2) == 29, "feb 2024 = 29")
    fails = fails + ck(time.days_in_month(2023, 2) == 28, "feb 2023 = 28")

    // crossing a leap day: 2024-02-28 + 1 day = 2024-02-29
    ld = time.add_days(time.from_civil(2024, 2, 28, 0, 0, 0), 1)
    fails = fails + ck(ld.month == 2 && ld.day == 29, "leap-day crossing")

    // ---- ISO-8601 format + parse round-trip ----
    fails = fails + ck(time.to_iso8601(t) == "2009-02-13T23:31:30Z", "iso format")
    p, pe = time.parse_iso8601("2009-02-13T23:31:30Z")
    fails = fails + ck(pe == "" && p.epoch == 1234567890, "iso parse")
    // space separator accepted
    p2, pe2 = time.parse_iso8601("2009-02-13 23:31:30")
    fails = fails + ck(pe2 == "" && p2.epoch == 1234567890, "iso parse (space sep)")
    // malformed rejected
    _, be = time.parse_iso8601("not-a-date")
    fails = fails + ck(be != "", "malformed rejected")
    _, be2 = time.parse_iso8601("2009-13-13T00:00:00Z") // month 13
    fails = fails + ck(be2 != "", "bad month rejected")
    _, be3 = time.parse_iso8601("2023-02-29T00:00:00Z") // not a leap year
    fails = fails + ck(be3 != "", "feb 29 non-leap rejected")
    // Nothing may follow the seconds but 'Z': an offset was dropped (the
    // UTC instant came back five hours late) and garbage was accepted, both
    // with an empty error. Offsets are parse_iso8601_offset's.
    _, be4 = time.parse_iso8601("2024-01-01T00:00:00+05:00")
    fails = fails + ck(be4 != "", "offset rejected (parse_iso8601_offset reads it)")
    _, be5 = time.parse_iso8601("2024-01-01T00:00:00garbage")
    fails = fails + ck(be5 != "", "trailing text rejected")
    _, be6 = time.parse_iso8601("2024-01-01T00:00:00X")
    fails = fails + ck(be6 != "", "a 20th character other than Z rejected")
    // A fraction (dropped) and a lowercase z are UTC stamps as written by
    // JavaScript's toISOString and allowed by RFC 3339.
    pf, pfe = time.parse_iso8601("2009-02-13T23:31:30.123Z")
    fails = fails + ck(pfe == "" && pf.epoch == 1234567890, "fraction before Z accepted")
    pz, pze = time.parse_iso8601("2009-02-13T23:31:30z")
    fails = fails + ck(pze == "" && pz.epoch == 1234567890, "lowercase z accepted")
    pc, pce = time.parse_iso8601("2009-02-13 23:31:30,5")
    fails = fails + ck(pce == "" && pc.epoch == 1234567890, "comma fraction, no zone")
    _, be7 = time.parse_iso8601("2009-02-13T23:31:30.Z")
    fails = fails + ck(be7 != "", "a fraction without digits rejected")
    _, be8 = time.parse_iso8601("2009-02-13T23:31:30.5+01:00")
    fails = fails + ck(be8 != "", "an offset after a fraction rejected")

    // Years outside 0..9999 are written in full, signed when negative: both
    // were clamped to "0000".
    fails = fails + ck(time.to_iso8601(time.from_civil(10000, 1, 1, 0, 0, 0)) == "10000-01-01T00:00:00Z", "year 10000")
    fails = fails + ck(time.to_iso8601(time.from_civil(-1, 12, 31, 23, 59, 59)) == "-0001-12-31T23:59:59Z", "year -1")
    fails = fails + ck(time.to_iso8601(time.from_civil(9999, 12, 31, 23, 59, 59)) == "9999-12-31T23:59:59Z", "year 9999")
    fails = fails + ck(time.to_iso8601(time.from_civil(0, 1, 1, 0, 0, 0)) == "0000-01-01T00:00:00Z", "year 0")

    // ---- diff + ordering ----
    a = time.from_unix(1000)
    b = time.from_unix(1060)
    fails = fails + ck(time.diff_seconds(b, a) == 60, "diff 60s")
    fails = fails + ck(time.is_before(a, b), "a before b")
    fails = fails + ck(time.is_after(b, a), "b after a")

    // ---- add_hours / add_minutes ----
    h = time.add_hours(e0, 25) // 1970-01-02T01:00:00Z
    fails = fails + ck(h.day == 2 && h.hour == 1, "add 25 hours")

    // ---- a far-future + negative (pre-epoch) date, exact civil math ----
    // 1969-12-31T23:59:59Z = epoch -1
    neg = time.from_unix(-1)
    fails = fails + ck(neg.year == 1969 && neg.month == 12 && neg.day == 31, "pre-epoch date")
    fails = fails + ck(neg.hour == 23 && neg.minute == 59 && neg.second == 59, "pre-epoch time")

    // ---- strftime: every conversion over 2009-02-13T23:31:30Z (a Friday) ----
    fails = fails + ck(time.strftime(t, "%Y-%m-%d %H:%M:%S") == "2009-02-13 23:31:30", "strftime basic")
    fails = fails + ck(time.strftime(t, "%B %b %h %A %a") == "February Feb Feb Friday Fri", "strftime names")
    fails = fails + ck(time.strftime(t, "%C %y %j %e") == "20 09 044 13", "strftime century/yday/e")
    fails = fails + ck(time.strftime(t, "%I %l %p %P %k") == "11 11 PM pm 23", "strftime 12-hour")
    fails = fails + ck(time.strftime(t, "%u %w %U %W %V %G %g") == "5 5 06 06 07 2009 09", "strftime weeks")
    fails = fails + ck(time.strftime(t, "%s %L %N %3N") == "1234567890 000 000000000 000", "strftime epoch/fraction")
    fails = fails + ck(time.strftime(t, "%z %:z %::z %Z") == "+0000 +00:00 +00:00:00 UTC", "strftime zone at UTC")
    fails = fails + ck(time.strftime(t, "%F|%T|%D|%R|%r") == "2009-02-13|23:31:30|02/13/09|23:31|11:31:30 PM",
        "strftime combinations")
    fails = fails + ck(time.strftime(t, "%c") == "Fri Feb 13 23:31:30 2009", "strftime %c")
    fails = fails + ck(time.strftime(t, "%%|%Q|100%") == "%|%Q|100%", "strftime literal percent and unknown")

    // flags and widths: 2024-03-05T07:04:09Z
    f = time.from_civil(2024, 3, 5, 7, 4, 9)
    fails = fails + ck(time.strftime(f, "%-d/%-m %-H:%M %e|%-e") == "5/3 7:04  5|5", "strftime - flag")
    fails = fails + ck(time.strftime(f, "%_m %0e %^B %^a %#p %10A") == " 3 05 MARCH TUE am    Tuesday",
        "strftime _ 0 ^ # flags and width")

    // ISO weeks at the year boundaries: 2021-01-03 is in 2020-W53, 2024-12-30 in 2025-W01.
    w1 = time.from_civil(2021, 1, 3, 0, 0, 0)
    fails = fails + ck(time.strftime(w1, "%G-W%V-%u") == "2020-W53-7", "iso week before new year")
    w2 = time.from_civil(2024, 12, 30, 0, 0, 0)
    fails = fails + ck(time.strftime(w2, "%G-W%V-%u") == "2025-W01-1", "iso week after new year")

    // A clock east of UTC: the same instant, read at +05:30.
    fails = fails + ck(time.strftime_at(t, 19800, "%Y-%m-%d %H:%M %z %:z|%Z|") == "2009-02-14 05:01 +0530 +05:30||",
        "strftime_at east")
    fails = fails + ck(time.strftime_at(t, -18000, "%H:%M %z") == "18:31 -0500", "strftime_at west")

    // ---- parse_iso8601_offset ----
    z, zo, ze = time.parse_iso8601_offset("2009-02-13T23:31:30Z")
    fails = fails + ck(ze == "" && z.epoch == 1234567890 && zo == 0, "offset parse Z")
    dd, ddo, dde = time.parse_iso8601_offset("2024-01-02")
    fails = fails + ck(dde == "" && dd.epoch == 1704153600 && ddo == 0, "offset parse date only")
    hm, _hmo, hme = time.parse_iso8601_offset("2024-01-02T10:20")
    fails = fails + ck(hme == "" && hm.hour == 10 && hm.minute == 20 && hm.second == 0, "offset parse HH:MM")
    fr, _fro, fre = time.parse_iso8601_offset("2009-02-13T23:31:30.987654Z")
    fails = fails + ck(fre == "" && fr.epoch == 1234567890, "offset parse fraction dropped")
    ea, eao, eae = time.parse_iso8601_offset("2009-02-14T05:01:30+05:30")
    fails = fails + ck(eae == "" && ea.epoch == 1234567890 && eao == 19800, "offset parse +05:30")
    wb, wbo, wbe = time.parse_iso8601_offset("2009-02-13 18:31:30 -0500")
    fails = fails + ck(wbe == "" && wb.epoch == 1234567890 && wbo == -18000, "offset parse Ruby Time#to_s form")
    uu, uuo, uue = time.parse_iso8601_offset("2009-02-13 23:31:30 UTC")
    fails = fails + ck(uue == "" && uu.epoch == 1234567890 && uuo == 0, "offset parse UTC suffix")
    hh, hho, hhe = time.parse_iso8601_offset("2009-02-14T01:31:30+02")
    fails = fails + ck(hhe == "" && hh.epoch == 1234567890 && hho == 7200, "offset parse +HH")
    _, _o1, x1 = time.parse_iso8601_offset("2024-02-30")
    fails = fails + ck(x1 != "", "offset parse rejects Feb 30")
    _, _o2, x2 = time.parse_iso8601_offset("2024-01-02T25:00")
    fails = fails + ck(x2 != "", "offset parse rejects hour 25")
    _, _o3, x3 = time.parse_iso8601_offset("2024-01-02 tomorrow")
    fails = fails + ck(x3 != "", "offset parse rejects trailing text")
    _, _o4, x4 = time.parse_iso8601_offset("2024-01-02T10:00+05:3")
    fails = fails + ck(x4 != "", "offset parse rejects a short offset")
    _, _o5, x5 = time.parse_iso8601_offset("Jan 2, 2024")
    fails = fails + ck(x5 != "", "offset parse rejects a non-ISO date")

    if fails != 0 {
        println("time: ${fails} failure(s)")
        exit(1)
    }
    println("PASS: test_time")
}
