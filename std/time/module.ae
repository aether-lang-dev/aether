// std.time — civil date/time over Unix epoch seconds (UTC), and the clock.
//
// The calendar -- DateTime, the conversions, the arithmetic, ISO-8601 and
// strftime -- is std.time.calendar, which reads no clock; see that module
// for how the civil fields are derived (Howard Hinnant's algorithms, all
// times UTC). This module adds the current time, which it reads through
// std.os, and offers the calendar's functions under the same names, so a
// program that wants both imports one module.
//
// A module that must not depend on the clock -- and so on std.os, which
// `--emit=lib` gates behind `--with=os` -- imports std.time.calendar.

import std.time.calendar
import std.os

exports(
    DateTime,
    now, now_ms,
    from_civil,
    from_unix, to_unix,
    weekday, day_of_year, is_leap_year, days_in_month,
    add_seconds, add_minutes, add_hours, add_days,
    diff_seconds, is_before, is_after,
    to_iso8601, parse_iso8601, parse_iso8601_offset,
    strftime, strftime_at
)

// ---- the clock -------------------------------------------------------------

// Current UTC time (whole seconds).
now() -> DateTime {
    return calendar.from_unix(now_ms() / 1000)
}

// Current Unix time in milliseconds (raw, no civil decode).
now_ms() -> long {
    return os.now_unix_ms()
}

// ---- the calendar, as std.time.calendar has it -----------------------------

from_unix(epoch: long) -> DateTime { return calendar.from_unix(epoch) }

from_civil(year: int, month: int, day: int, hour: int, minute: int, second: int) -> DateTime {
    return calendar.from_civil(year, month, day, hour, minute, second)
}

to_unix(dt: DateTime) -> long { return calendar.to_unix(dt) }
weekday(dt: DateTime) -> int { return calendar.weekday(dt) }
day_of_year(dt: DateTime) -> int { return calendar.day_of_year(dt) }
is_leap_year(y: int) -> bool { return calendar.is_leap_year(y) }
days_in_month(y: int, m: int) -> int { return calendar.days_in_month(y, m) }

add_seconds(dt: DateTime, s: long) -> DateTime { return calendar.add_seconds(dt, s) }
add_minutes(dt: DateTime, m: long) -> DateTime { return calendar.add_minutes(dt, m) }
add_hours(dt: DateTime, h: long) -> DateTime { return calendar.add_hours(dt, h) }
add_days(dt: DateTime, d: long) -> DateTime { return calendar.add_days(dt, d) }

diff_seconds(a: DateTime, b: DateTime) -> long { return calendar.diff_seconds(a, b) }
is_before(a: DateTime, b: DateTime) -> bool { return calendar.is_before(a, b) }
is_after(a: DateTime, b: DateTime) -> bool { return calendar.is_after(a, b) }

to_iso8601(dt: DateTime) -> string { return calendar.to_iso8601(dt) }
parse_iso8601(s: string) -> (DateTime, string) { return calendar.parse_iso8601(s) }
parse_iso8601_offset(s: string) -> (DateTime, int, string) { return calendar.parse_iso8601_offset(s) }

strftime(dt: DateTime, fmt: string) -> string { return calendar.strftime(dt, fmt) }
strftime_at(dt: DateTime, offset: int, fmt: string) -> string { return calendar.strftime_at(dt, offset, fmt) }
