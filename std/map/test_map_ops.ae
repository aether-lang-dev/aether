// std.map unit tests (#1584) — co-located with the module.
//
// The module had no co-located test before this. std.map is the
// string-keyed pointer map the rest of std builds on — std.spec itself
// keeps its whole framework state in one.
//
// As with std.list, a lookup miss reports success and hands back null
// rather than reporting an error. That is pinned below as observed
// behaviour with a comment saying what a caller must do about it, not
// as an endorsement.
//
// Values are list handles used purely as distinct heap pointers; the
// map never dereferences them, so only identity matters, and identity
// is compared via mem.ptr_to_long because ptr has no direct equality
// operator.

import std.spec
import std.map
import std.collections
import std.mem

fn same_ptr(a: ptr, b: ptr) -> int {
    if mem.ptr_to_long(a) == mem.ptr_to_long(b) {
        return 1
    }
    return 0
}

main() {
    fw = spec.init()

    spec.describe(fw, "std.map put and get") {
        spec.it("starts empty") callback {
            m = map.map_new()
            spec.assert_eq(map.map_size(m), 0, "new map has size 0")
            map.map_free(m)
        }

        spec.it("binds a key and reads it back") callback {
            m = map.map_new()
            v = collections.list_new()
            spec.assert_ok(map.put(m, "key", v), "put succeeds")
            spec.assert_eq(map.map_size(m), 1, "size is 1")
            got, err = map.get(m, "key")
            spec.assert_ok(err, "get succeeds")
            spec.assert_true(same_ptr(got, v), "the bound value comes back")
            map.map_free(m)
            collections.list_free(v)
        }

        spec.it("replaces a rebound key without growing") callback {
            m = map.map_new()
            first = collections.list_new()
            second = collections.list_new()
            map.put(m, "key", first)
            map.put(m, "key", second)
            spec.assert_eq(map.map_size(m), 1,
                "rebinding does not add an entry")
            got, err = map.get(m, "key")
            spec.assert_ok(err, "get succeeds")
            spec.assert_true(same_ptr(got, second),
                "the later binding wins")
            map.map_free(m)
            collections.list_free(first)
            collections.list_free(second)
        }

        spec.it("keeps distinct keys apart") callback {
            m = map.map_new()
            a = collections.list_new()
            b = collections.list_new()
            map.put(m, "a", a)
            map.put(m, "b", b)
            spec.assert_eq(map.map_size(m), 2, "two entries")
            got_a, e1 = map.get(m, "a")
            got_b, e2 = map.get(m, "b")
            spec.assert_ok(e1, "get(a) succeeds")
            spec.assert_ok(e2, "get(b) succeeds")
            spec.assert_true(same_ptr(got_a, a), "a maps to its own value")
            spec.assert_true(same_ptr(got_b, b), "b maps to its own value")
            map.map_free(m)
            collections.list_free(a)
            collections.list_free(b)
        }
    }

    spec.describe(fw, "std.map membership and removal") {
        spec.it("reports membership for bound and unbound keys") callback {
            m = map.map_new()
            v = collections.list_new()
            map.put(m, "present", v)
            spec.assert_eq(map.map_has(m, "present"), 1, "present is bound")
            spec.assert_eq(map.map_has(m, "absent"), 0, "absent is not bound")
            map.map_free(m)
            collections.list_free(v)
        }

        spec.it("drops a key on remove") callback {
            m = map.map_new()
            v = collections.list_new()
            map.put(m, "gone", v)
            map.map_remove(m, "gone")
            spec.assert_eq(map.map_has(m, "gone"), 0, "no longer bound")
            spec.assert_eq(map.map_size(m), 0, "size back to 0")
            map.map_free(m)
            collections.list_free(v)
        }

        spec.it("tolerates removing an unbound key") callback {
            m = map.map_new()
            v = collections.list_new()
            map.put(m, "keep", v)
            map.map_remove(m, "never-bound")
            spec.assert_eq(map.map_size(m), 1,
                "removing an absent key leaves the map alone")
            spec.assert_eq(map.map_has(m, "keep"), 1, "the other key survives")
            map.map_free(m)
            collections.list_free(v)
        }

        spec.it("empties on clear") callback {
            m = map.map_new()
            v = collections.list_new()
            map.put(m, "a", v)
            map.put(m, "b", v)
            map.map_clear(m)
            spec.assert_eq(map.map_size(m), 0, "size is 0 after clear")
            spec.assert_eq(map.map_has(m, "a"), 0, "a is gone")
            map.map_free(m)
            collections.list_free(v)
        }
    }

    spec.describe(fw, "std.map lookup misses") {
        spec.it("reports success and returns null for an unbound key") callback {
            // NOT an endorsement — the same wart std.list.get has. A
            // caller following the (value, err) convention reads the
            // empty err as success and must additionally null-check the
            // pointer. map_has is the unambiguous membership test.
            // Pinned so that changing it is a deliberate, visible act.
            m = map.map_new()
            got, err = map.get(m, "never-bound")
            spec.assert_ok(err, "a miss reports success today")
            spec.assert_true(same_ptr(got, null),
                "...but hands back null, so use map_has to test membership")
            map.map_free(m)
        }
    }

    spec.run_summary(fw)
}
