strings_by(arr: string[], n: int, cmp: fn(string, string) -> int) {
    if n < 2 { return }
    gap = 1
    idx = 0
    while idx < 8 && CIURA[idx] < n {
        gap = CIURA[idx]
        idx = idx + 1
