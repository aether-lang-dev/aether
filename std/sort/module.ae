    n = xs.len
    if n < 0 {
        unbounded("longs")
    }
    if n < 2 {
        return
    }
    v = xs as ptr as long[] // bound checked above; the loops index unchecked
    gap = first_gap(n)
    while gap >= 1 {
        i = gap
        while i < n {
            tmp = v[i]
            j = i
            while j >= gap && v[j - gap] > tmp {
                v[j] = v[j - gap]
                j = j - gap
