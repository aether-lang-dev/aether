// Sort `xs` in place by `cmp`, which returns <0 when its first argument
// sorts before its second, 0 when they tie, >0 when it sorts after.
longs_by(xs: long[], cmp: fn(long, long) -> int) {
    n = xs.len
    if n < 0 {
        unbounded("longs_by")
    }
    if n < 2 {
        return
    }
    v = xs as ptr as long[]
    gap = first_gap(n)
    while gap >= 1 {
        i = gap
        while i < n {
            tmp = v[i]
            j = i
            while j >= gap && cmp(v[j - gap], tmp) > 0 {
                v[j] = v[j - gap]
                j = j - gap
