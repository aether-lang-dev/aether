    while gap >= 1 {
        i = gap
        while i < n {
            tmp = arr[i]
            j = i
            while j >= gap && cmp(arr[j - gap], tmp) > 0 {
                arr[j] = arr[j - gap]
                j = j - gap
            }
            arr[j] = tmp
            i = i + 1
        }
        if gap == 1 {
            gap = 0
        } else {
            gap = (gap * 4) / 9
            if gap < 1 { gap = 1 }
