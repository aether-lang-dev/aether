// ---- string[] ----------------------------------------------------------------

// Sort `xs` ascending, in place.
strings(xs: string[]) {
    n = xs.len
    if n < 0 {
        unbounded("strings")
    }
    if n < 2 {
        return
    }
    v = xs as ptr as string[] // bound checked above; the loops index unchecked
    gap = first_gap(n)
    while gap >= 1 {
        i = gap
        while i < n {
            tmp = v[i]
            j = i
            while j >= gap && string.compare(v[j - gap], tmp) > 0 {
                v[j] = v[j - gap]
                j = j - gap
            }
            v[j] = tmp
            i = i + 1
        }
        gap = next_gap(gap)
    }
}

// Binary search a SORTED `xs` for `x`: the index of the first element not
// ordered before `x`, which is `x`'s index when present and otherwise where
// it would be inserted to keep `xs` sorted (`xs.len` when every element
// sorts before it). C3's binarysearch contract.
string_search(xs: string[], x: string) -> int {
    if xs.len < 0 {
        unbounded("string_search")
    }
    v = xs as ptr as string[]
    lo = 0
    hi = xs.len
    while lo < hi {
        mid = lo + (hi - lo) / 2
        if string.compare(v[mid], x) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// Sort `xs` in place by `cmp`, which returns <0 when its first argument
// sorts before its second, 0 when they tie, >0 when it sorts after.
strings_by(xs: string[], cmp: fn(string, string) -> int) {
    n = xs.len
    if n < 0 {
        unbounded("strings_by")
    }
    if n < 2 {
        return
    }
    v = xs as ptr as string[]
    gap = first_gap(n)
    while gap >= 1 {
        i = gap
        while i < n {
            tmp = v[i]
            j = i
            while j >= gap && cmp(v[j - gap], tmp) > 0 {
                v[j] = v[j - gap]
                j = j - gap
            }
            v[j] = tmp
            i = i + 1
        }
        gap = next_gap(gap)
    }
}
