    while gap >= 1 {
        i = gap
        while i < n {
            tmp = floatarr_get_unchecked(arr, i)
            j = i
            while j >= gap && floatarr_get_unchecked(arr, j - gap) > tmp {
                floatarr_set_unchecked(arr, j, floatarr_get_unchecked(arr, j - gap))
                j = j - gap
