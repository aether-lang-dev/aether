// Regression (#2471): std.xml reports the first well-formedness error, with
// its position, instead of handing back events for a broken tree; and it
// decodes character references per XML 1.0 section 4.1, refusing any that
// does not name a legal Char. #2510 adds one root element, unique attribute
// names, no raw control characters, and no undeclared entities.

import std.xml
import std.string
import std.bytes

extern exit(code: int)

// Pull every event; returns the error message ("" if the document reached
// EOF cleanly) and the decoded text of the last TEXT event.
drain(doc: string) -> (string, string) {
    p = xml.parser(doc)
    last_text = ""
    err = ""
    done = 0
    while done == 0 {
        ev = xml.next(p)
        if ev == xml.EVENT_EOF {
            done = 1
        } else if ev == xml.EVENT_ERROR {
            err = xml.error(p)
            done = 1
        } else if ev == xml.EVENT_TEXT {
            last_text = xml.text(p)
        }
    }
    xml.free(p)
    return err, last_text
}

// `doc` must fail with a message that contains `want`.
refuse(doc: string, want: string) -> int {
    err, _text = drain(doc)
    if err == "" {
        println("  FAIL: accepted ${doc}")
        return 1
    }
    if string.contains(err, want) == 0 {
        println("  FAIL: ${doc}: error '${err}' does not contain '${want}'")
        return 1
    }
    return 0
}

// `doc` must parse to EOF, its last text being exactly `want`.
accept(doc: string, want: string) -> int {
    err, text = drain(doc)
    if err != "" {
        println("  FAIL: refused ${doc}: ${err}")
        return 1
    }
    if text != want {
        println("  FAIL: ${doc}: text '${text}' (${string.length(text)} bytes), want '${want}' (${string.length(want)} bytes)")
        return 1
    }
    return 0
}

// A string of the given bytes.
raw(b0: int, b1: int, b2: int, b3: int, n: int) -> string {
    b = bytes.new(4)
    bytes.set(b, 0, b0)
    bytes.set(b, 1, b1)
    bytes.set(b, 2, b2)
    bytes.set(b, 3, b3)
    return bytes.finish(b, n)
}

main() {
    println("=== test_xml_well_formed ===")
    fails = 0

    // ---- Element structure, positioned at the offending tag ----
    fails = fails + refuse("<a><b></a>", "end tag </a> does not match the open <b> (line 1, column 7, byte 6)")
    fails = fails + refuse("<root><item>", "<item> is not closed (line 1, column 13, byte 12)")
    fails = fails + refuse("</x>", "end tag </x> has no open element to close (line 1, column 1, byte 0)")
    fails = fails + refuse("<a></>", "end tag without a name (line 1, column 4, byte 3)")
    fails = fails + refuse("<a x=\"1\"y=\"2\"/>", "missing whitespace before attribute (line 1, column 9, byte 8)")
    fails = fails + refuse("<a>\n  <b>\n</a>", "does not match the open <b> (line 3, column 1, byte 10)")
    fails = fails + refuse("<a><b/></a></a>", "end tag </a> has no open element to close")

    // ---- Character references: only a legal Char (section 4.1) ----
    fails = fails + refuse("<a>x&#0;y</a>", "character reference to a character XML does not allow (line 1, column 5, byte 4)")
    fails = fails + refuse("<a>&#xD800;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a>&#xDFFF;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a>&#x110000;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a>&#99999999999999999999;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a>&#1;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a>&#xFFFE;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a>&#xFFFF;</a>", "character reference to a character XML does not allow")
    fails = fails + refuse("<a b=\"&#0;\"/>", "character reference to a character XML does not allow (line 1, column 7, byte 6)")
    fails = fails + refuse("<a>&#x;</a>", "malformed character reference")
    fails = fails + refuse("<a>&#;</a>", "malformed character reference")
    fails = fails + refuse("<a>&#12a;</a>", "malformed character reference")
    fails = fails + refuse("<a>&#X41;</a>", "malformed character reference")
    fails = fails + refuse("<a>&#65</a>", "malformed character reference")

    // Legal references decode to UTF-8, supplementary planes included, with
    // any number of leading zeros.
    fails = fails + accept("<a>&#65;&#x42;&#0000000000067;</a>", "ABC")
    fails = fails + accept("<a>&#x1F600;</a>", raw(240, 159, 152, 128, 4))
    fails = fails + accept("<a>&#x10FFFF;</a>", raw(244, 143, 191, 191, 4))
    fails = fails + accept("<a>&#x10000;</a>", raw(240, 144, 128, 128, 4))
    fails = fails + accept("<a>&#xD7FF;</a>", raw(237, 159, 191, 0, 3))
    fails = fails + accept("<a>&#xE000;</a>", raw(238, 128, 128, 0, 3))
    fails = fails + accept("<a>&#xFFFD;</a>", raw(239, 191, 189, 0, 3))
    fails = fails + accept("<a>&#9;&#xA;&#xd;</a>", raw(9, 10, 13, 0, 3))
    fails = fails + accept("<a x=\"1\"\ty='2'\n/>", "")
    fails = fails + accept("<a><b/><c>t</c></a>", "t")

    // ---- One root element (#2510) ----
    fails = fails + refuse("<a/><b/>", "second root element <b>: a document has one (line 1, column 5, byte 4)")
    fails = fails + refuse("<a></a>\n<a></a>", "second root element <a>")
    fails = fails + refuse("<a/>x", "text outside the root element (line 1, column 5, byte 4)")
    fails = fails + refuse("x<a/>", "text outside the root element (line 1, column 1, byte 0)")
    fails = fails + refuse("<![CDATA[x]]><a/>", "CDATA outside the root element (line 1, column 1, byte 0)")
    fails = fails + refuse("", "no root element")
    fails = fails + refuse("<?xml version=\"1.0\"?><!-- nothing -->", "no root element")
    // Whitespace, the prolog, comments and a byte order mark may surround it.
    fails = fails + accept("<?xml version=\"1.0\"?>\n<!-- c -->\n<a>t</a>\n", "\n")
    fails = fails + accept(string.concat(raw(239, 187, 191, 0, 3), "<a>t</a>"), "t")

    // ---- Unique attribute names (#2510) ----
    fails = fails + refuse("<a x=\"1\" x=\"2\"/>", "attribute x appears twice in one tag (line 1, column 10, byte 9)")
    fails = fails + accept("<a x=\"1\" y=\"1\" X=\"1\">t</a>", "t")

    // ---- No raw control characters but tab, LF and CR (#2510) ----
    fails = fails + refuse(string.concat("<a>x", string.concat(raw(1, 0, 0, 0, 1), "y</a>")), "control character 0x01, which XML does not allow (line 1, column 5, byte 4)")
    fails = fails + refuse(string.concat("<a b=\"", string.concat(raw(27, 0, 0, 0, 1), "\"/>")), "control character 0x1B, which XML does not allow (line 1, column 7, byte 6)")
    fails = fails + refuse(string.concat("<a><![CDATA[", string.concat(raw(31, 0, 0, 0, 1), "]]></a>")), "control character 0x1F, which XML does not allow")
    fails = fails + accept(string.concat("<a>", string.concat(raw(9, 10, 13, 0, 3), "</a>")), raw(9, 10, 13, 0, 3))

    // ---- Only the five predefined entities (#2510) ----
    fails = fails + refuse("<a>x&foo;y</a>", "reference to undeclared entity &foo; (only &amp; &lt; &gt; &quot; &apos; are predefined) (line 1, column 5, byte 4)")
    fails = fails + refuse("<a b=\"&nbsp;\"/>", "reference to undeclared entity &nbsp;")
    fails = fails + refuse("<a>x & y</a>", "'&' that does not start a reference (write &amp;) (line 1, column 6, byte 5)")
    fails = fails + refuse("<a>&;</a>", "'&' that does not start a reference")
    fails = fails + refuse("<a>&amp</a>", "'&' that does not start a reference")
    fails = fails + accept("<a>&amp;&lt;&gt;&quot;&apos;</a>", "&<>\"'")

    if fails > 0 {
        println("FAIL: ${fails} checks failed")
        exit(1)
    }
    println("=== test_xml_well_formed passed ===")
}
