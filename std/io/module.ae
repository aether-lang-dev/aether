// std.io - Input/Output Module
// Import with: import std.io
//
// Raw externs end in `_raw` and return the C-style NULL/0/1 convention.
// The Aether-native wrappers (below) use Go-style `(value, err)` tuples.

import std.string

exports(
    io_print, io_print_line, io_print_int, io_print_float,
    io_read_file_raw, io_write_file_raw, io_append_file_raw, io_file_exists,
    io_delete_file_raw, io_file_info_raw, io_file_info_free,
    io_getenv, io_setenv_raw, io_unsetenv_raw,
    io_stderr_write_raw, io_stdout_write_raw,
    io_perror_raw, io_errno_message_raw,
    io_fd_open_read_tuple, io_fd_open_write_tuple, io_fd_close_raw,
    io_fd_read_n_tuple, io_fd_read_line_tuple,
    io_fd_read_into_raw,
    read_file, write_file, append_file, delete_file, file_info,
    setenv, unsetenv,
    stderr_write, stdout_write, perror, errno_message,
    fd_open_read, fd_open_write, fd_close,
    fd_write, fd_read_n, fd_read_into, fd_read_line
)

// Console I/O — infallible in practice
extern io_print(str: string)
extern io_print_line(str: string)
extern io_print_int(value: int)
extern io_print_float(value: float)

// File I/O — raw externs
extern io_read_file_raw(path: string) -> string
extern io_write_file_raw(path: string, content: string) -> int
extern io_append_file_raw(path: string, content: string) -> int
extern io_file_exists(path: string) -> int
extern io_delete_file_raw(path: string) -> int

// File info
extern io_file_info_raw(path: string) -> ptr
extern io_file_info_free(info: ptr)

// Environment variables
extern io_getenv(name: string) -> string
extern io_setenv_raw(name: string, value: string) -> int
extern io_unsetenv_raw(name: string) -> int

// Unbuffered fd-1 / fd-2 writes — bypass stdio buffering so output is
// guaranteed on the wire before the process exits / crashes / aborts.
// Returns bytes written, -1 on error. Loops on partial writes and
// retries on EINTR.
extern io_stderr_write_raw(data: string, length: int) -> int
extern io_stdout_write_raw(data: string, length: int) -> int

// errno-based error reporting — see the perror / errno_message
// wrappers below.
extern io_perror_raw(name: string)
extern io_errno_message_raw() -> string

// Full fd-level I/O surface. Section 1 of nuther-ask-of-aether-team.md.
// fd_open_read       → POSIX O_RDONLY  / Win _O_RDONLY | _O_BINARY
// fd_open_write      → POSIX O_WRONLY|O_CREAT|O_TRUNC, mode 0644 /
//                      Win _O_WRONLY|_O_CREAT|_O_TRUNC|_O_BINARY
// fd_close           → close(fd) or _close(fd)
// fd_write           → looped write of a byte[], retries EINTR; 0 ok / -1 fail
// fd_read_n          → looped read of up to `n` bytes; (bytes, count, err);
//                      bytes is a refcounted AetherString (binary-safe;
//                      embedded NULs survive)
// fd_read_line       → reads until '\n', stripping trailing CR/LF;
//                      ("", "") on clean EOF before any byte; partial
//                      line returned on EOF mid-line
extern io_fd_open_read_tuple(path: string) -> (int, string)
extern io_fd_open_write_tuple(path: string) -> (int, string)
extern io_fd_close_raw(fd: int) -> string
// `data` is `ptr`, not `string`, so a byte[] slice reaches C as its raw
// data pointer: a `string` parameter routes through the AetherString
// unwrap, which would misread a binary payload that happens to begin with
// the string header's magic bytes as a header. Not exported for the same
// reason in reverse: a heap string passed to this `ptr` parameter would
// write its header bytes. Use fd_write (#2301).
extern io_fd_write_n(fd: int, data: ptr, length: int) -> int
// Position 0 (the read buffer) is `@heap`: the C side returns a fresh
// AetherString (string_new_with_length, "" on EOF/error) that the caller
// owns and must release — without the annotation the destructured local
// was never reclaimed, leaking one buffer per read. aether_heap_str_free
// dispatches on the magic header (string_release here); never a literal.
extern io_fd_read_n_tuple(fd: int, n: int) -> (string @heap, int, string)
extern io_fd_read_into_raw(fd: int, buf: ptr, length: int) -> int
extern io_fd_read_line_tuple(fd: int) -> (string @heap, string)

// string_concat for owned-copy duplication
extern string_concat(a: string, b: string) -> string

// Read the entire contents of a file at `path`.
// Returns (content, "") on success, ("", error) on failure.
read_file(path: string) -> {
    content = io_read_file_raw(path)
    if content == null {
        return "", "cannot read file"
    }
    content_copy = string_concat(content, "")
    return content_copy, ""
}

// Write `content` to a file at `path`. Overwrites if exists.
// Returns "" on success, error string on failure.
write_file(path: string, content: string) -> {
    ok = io_write_file_raw(path, content)
    if ok == 0 {
        return "cannot write file"
    }
    return ""
}

// Append `content` to a file at `path`. Creates if missing.
// Returns "" on success, error string on failure.
append_file(path: string, content: string) -> {
    ok = io_append_file_raw(path, content)
    if ok == 0 {
        return "cannot append to file"
    }
    return ""
}

// Delete the file at `path`. Returns "" on success, error on failure.
delete_file(path: string) -> {
    ok = io_delete_file_raw(path)
    if ok == 0 {
        return "cannot delete file"
    }
    return ""
}

// Get file info (FileInfo ptr with size, is_directory, modified_time).
// Returns (info, "") on success, (null, error) on failure.
// Caller must free the returned ptr with io.file_info_free.
file_info(path: string) -> {
    info = io_file_info_raw(path)
    if info == null {
        return null, "cannot stat file"
    }
    return info, ""
}

// Set an environment variable. Returns "" on success, error on failure.
setenv(name: string, value: string) -> {
    ok = io_setenv_raw(name, value)
    if ok == 0 {
        return "cannot set env var"
    }
    return ""
}

// Unset an environment variable. Returns "" on success, error on failure.
unsetenv(name: string) -> {
    ok = io_unsetenv_raw(name)
    if ok == 0 {
        return "cannot unset env var"
    }
    return ""
}

// Unbuffered write to stderr (fd 2). Writes the whole of `data`;
// the byte count comes from the string itself via string.length —
// which reads an AetherString's stored length (NUL-safe) or falls
// back to strlen for a bare C string. Returns bytes written, -1 on
// error. Reach for this in crash-trace paths where println's
// buffering would lose output.
//
//     io.stderr_write("PANIC: ${msg}\n")
//
// Distinct from `println` (line-buffered, lost on abort) and
// `eprintln` (block-buffered when stderr is piped).
//
// API note: the former two-arg form (data, length) was removed —
// `string` already carries its own length, so a caller-supplied
// count was redundant and a source of mismatch bugs.
stderr_write(data: string) -> int {
    return io_stderr_write_raw(data, string.length(data))
}

// Unbuffered write to stdout (fd 1). Same shape as stderr_write.
// Useful for shell-pipe-friendly tools that need to flush each
// record before the next stage reads.
stdout_write(data: string) -> int {
    return io_stdout_write_raw(data, string.length(data))
}

// Print "name: <errno message>\n" to stderr — the POSIX perror(3).
// Call it immediately after a failing libc-backed operation, while
// errno is still live (same constraint as C's perror).
//
//     fd, err = io.fd_open_read(path)
//     if fd < 0 { io.perror("open") ; exit(1) }
perror(name: string) {
    io_perror_raw(name)
}

// The current errno as a human-readable message string — strerror(3)
// for `errno`. Same "call right after the failure" rule as perror.
// Use this when you want the message in a string (to wrap in a
// Go-style error tuple, log it, etc.) rather than printed to stderr.
errno_message() -> string {
    s = io_errno_message_raw()
    if s == null {
        return "unknown error"
    }
    return s
}

// Open `path` for reading. Returns (fd, err): success → (fd >= 0, "");
// failure → (-1, "..."). Use with fd_read_n / fd_read_line / fd_close.
//
//     fd, err = io.fd_open_read("data.bin")
//     if err != "" { return err }
//     defer io.fd_close(fd)
fd_open_read(path: string) -> int! {
    return io_fd_open_read_tuple(path)
}

// Open `path` for writing — implicit O_CREAT + O_TRUNC, mode 0644 on
// POSIX. Returns (fd, err) like fd_open_read. The truncate-on-open
// matches std.fs.write_binary semantics; if you need O_APPEND or
// open-without-truncate, file an issue (the porter says no svn-aether
// site needs them today).
fd_open_write(path: string) -> int! {
    return io_fd_open_write_tuple(path)
}

// Close `fd`. Returns "" on success, error string on failure.
fd_close(fd: int) -> string {
    return io_fd_close_raw(fd)
}

// Write every byte of `data` to `fd` — the length travels with the slice
// (#2301). Loops on partial writes; retries EINTR on POSIX. `data` may
// contain NULs. Returns 0 on success, -1 on error. An empty slice writes
// nothing and succeeds; a slice with no bound panics.
//
//     n = io.fd_write(fd, bytes.view(frame))
//     if n != 0 { return "write failed" }
//
// For a string, take its byte view: `io.fd_write(fd, string.bytes(s))`,
// and a prefix of it with `string.bytes(s)[0..n]`.
//
// Formerly `fd_write_n(fd, data, length)`. It is not `fd_write_n` any more
// because a module function's C name is `<module>_<name>`, and
// `io_fd_write_n` is the C function itself: the two names were one symbol,
// so `io.fd_write_n(...)` always bound the extern, whatever this wrapper
// said.
fd_write(fd: int, data: byte[]) -> int {
    if data.len < 0 {
        panic("io.fd_write: the slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`")
    }
    if data.len == 0 {
        return 0
    }
    return io_fd_write_n(fd, data, data.len)
}

// Read up to `n` bytes from `fd`. Returns (bytes, count, err):
//   - On success: (bytes, count, "") with `count` between 1 and `n`.
//   - On clean EOF before any byte: ("", 0, "").
//   - On error: ("", 0, "<reason>").
// `bytes` is a refcounted AetherString carrying the explicit byte
// count, so embedded NULs survive (binary-safe).
// Inferred return type (`-> {`) so the extern's `@heap` tuple flag on
// position 0 propagates to callers' destructure sites — an explicit
// tuple type can't carry the per-position annotation. Mirrors std.fs's
// read_binary / realpath wrappers.
fd_read_n(fd: int, n: int) -> {
    return io_fd_read_n_tuple(fd, n)
}

// Zero-allocation sibling of `fd_read_n` (#1471): read into a buffer the
// caller owns instead of minting a fresh string per call. Mirrors
// `fs.pread_into`, which is the same shape for files.
//
// Returns (n, err). `n == 0` means EOF; `0 < n < buf.len` is a normal SHORT
// READ, not an error — unlike `fd_read_n`, this returns as soon as any bytes
// are available rather than looping to fill the buffer. That is precisely
// what makes it usable on a live pipe: waiting to fill would stall until the
// producer happened to send a whole buffer's worth.
//
// Reads at most `buf.len` bytes into `buf` (#2301): the slice is the
// writable space, so its bound is the read limit and the bytes read are
// `buf[0..n]`. Loop until it returns 0 to consume a stream to EOF. Reading a
// frame at a time into one reused buffer avoids ~250 MB/s of allocator churn
// at 1080p30 versus the allocating form. A zero-length slice is an error,
// the same as a zero length was before; an unbounded one panics.
//
// For a `std.bytes` buffer, read into its writable storage and then publish
// the count — writing through the view does not move the buffer's length,
// and `bytes.to_string` reads that length:
//
//     n, e = io.fd_read_into(fd, bytes.capacity_view(buf))
//     _ = bytes.set_length(buf, n)          // <- required before to_string
//     s = bytes.to_string(buf, n)
//
// A caller passing the bytes straight on (another write, the video case)
// uses `buf[0..n]` and never needs set_length.
fd_read_into(fd: int, buf: byte[]) -> int! {
    if buf.len < 0 {
        panic("io.fd_read_into: the slice has no bound (.len -1); give it one, as `(p as byte[])[0..n]`")
    }
    if buf.len == 0 {
        return 0, "fd_read_into failed"
    }
    n = io_fd_read_into_raw(fd, buf, buf.len)
    if n < 0 {
        return 0, "fd_read_into failed"
    }
    return n, ""
}

// Read one '\n'-delimited line from `fd`. The trailing '\n' is
// stripped (and a '\r' before it for CRLF input). Returns (line, err):
//   - Normal line: (content, "").
//   - Clean EOF before any byte: ("", "").
//   - EOF mid-line: returns the partial line and ("", "") — server-
//     side dump streams sometimes end without a trailing '\n'.
//   - Read error: ("", "<reason>").
fd_read_line(fd: int) -> {
    return io_fd_read_line_tuple(fd)
}
