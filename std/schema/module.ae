// std.schema — declarative, typed data validation & coercion.
//
// A `record { ... }` describes a set of typed fields with composable
// validation rules; `parse(schema, input)` turns an untyped string→string
// map into a typed, validated value-map, OR a list of structured errors.
// Validation and parsing are a single act (the "parse, don't validate"
// philosophy) — a successful parse yields coerced typed values; a failure
// yields `[{field, code, message}]` with Zod-style issue codes.
//
// The module is HTTP-agnostic and depends only on std.map/list/string:
// use it to validate a request body, a config file, a set of CLI args, a
// JSON document read from disk, or any other untyped key→value input.
//
// Design credits (all MIT):
//   - Zod (© 2025 Colin McDonnell) — the parse→(value|errors) contract and
//     the issue-code vocabulary (invalid_type, too_small, too_big,
//     invalid_format, invalid_value, custom).
//   - Pydantic (© Pydantic Services Inc.) — lax-vs-strict coercion (a
//     lax parse coerces "25"→25; a strict parse rejects a type mismatch).
//   - io-ts (© 2017 Giulio Canti) — decode as `input → success | failure`,
//     errors accumulated rather than thrown.
//   - Ash Framework (© 2019 ash contributors) — the declarative
//     resource/attribute/validation block shape (record { field { rules } }).
//
// Example:
//   author = schema.record() {
//       schema.field("age", schema.INT)  {
//           schema.min(18)
//           schema.max(120)
//       }
//       schema.field("name", schema.STR) {
//           schema.present()
//           schema.len(1, 80)
//       }
//       schema.field("role", schema.STR) {
//           schema.one_of("admin,user")
//           schema.optional()
//       }
//   }
//   values, errors = schema.parse(author, input_map)
//   if schema.ok(errors) { ... use values ... }
//
// Nested data: a field of type OBJECT holds fields of its own, and a field
// of type array(T) holds a list of T. `parse_json(schema, json_root)` walks
// a std.json tree against such a schema and returns the coerced values as a
// std.json tree (ints as ints, bools as bools), each error naming its path:
//   order = schema.record() {
//       schema.field("customer", schema.OBJECT) {
//           schema.field("email", schema.STR) { schema.email() }
//       }
//       schema.field("lines", schema.array(schema.OBJECT)) {
//           schema.min(1)
//           schema.field("sku", schema.STR) { schema.present() }
//           schema.field("qty", schema.INT) { schema.positive() }
//       }
//       schema.field("tags", schema.array(schema.STR)) {
//           schema.items() { schema.len(1, 20) }
//       }
//   }
//   values, errors = schema.parse_json(order, root)   // errors like "lines[2].qty"

exports(
    // types
    STR, INT, FLOAT, BOOL, OBJECT, array,
    // builders
    record, field, items,
    min, max, len, present, optional, one_of, email, refine,
    default_to, positive, nonneg, pattern,
    // transforms
    trim, lowercase, uppercase,
    // parse + result helpers
    parse, parse_json, ok, error_count, error_field, error_code, error_message,
    // projection
    to_json_schema,
    // introspection
    schema_free, values_free, errors_free
)

// Dependency-light on purpose: map/list/string, and std.json for nested
// input. Arbitrary pattern matching is available through refine() closures,
// so the module carries no hard dependency on the (optional,
// pkg-config-probed) regex/PCRE2 backend.
import std.json
import std.map
import std.map(map_new, map_has, map_free)
import std.list
import std.list(list_new, list_add_raw, list_get_raw, list_size, list_free)
import std.strbuilder
import std.string(string_length, string_equals, string_concat, string_char_at,
    string_char_at_n, string_contains, string_index_of, string_index_of_from,
    string_index_of_from_n, string_to_lower, string_to_upper,
    string_trim, string_ends_with, string_free, string_substring,
    string_starts_with, to_long, to_float)

// box_closure() mallocs a two-word _AeClosure box; free it with libc free.
@extern("free") libc_free(p: ptr)

// ---- Field type tags ----
const STR = 0
// A 64-bit integer: the range std.json reads an integer literal in, and the
// type of the min/max bounds. Text outside it is not an INT.
const INT = 1
const FLOAT = 2
const BOOL = 3
// A field holding fields of its own: a nested record. Declare them in the
// field's block, as in record()'s.
const OBJECT = 4
// array(T) is ARRAY_OF + T, so arrays nest: array(array(INT)).
const ARRAY_OF = 16

// The type of a list of T. Rules in the field's block count its items
// (min/max/len/present); rules for the items go in items(), and an array of
// OBJECT takes the item record's fields directly in its block.
array(item_type: int) -> int {
    return ARRAY_OF + item_type
}

fn is_array(ty: int) -> bool {
    return ty >= ARRAY_OF
}

// What a builder's context is: record() and an OBJECT field's nested record
// are schemas, field() and items() are fields. Both structs lead with it.
const KIND_SCHEMA = 1
const KIND_FIELD = 2

// std.json's value types (aether_json.h's enum).
const JSON_NULL = 0
const JSON_BOOL = 1
const JSON_NUMBER = 2
const JSON_STRING = 3
const JSON_ARRAY = 4
const JSON_OBJECT = 5

// ---- Rule kinds ----
// Rules split into two families, applied in declaration order during parse:
//   TRANSFORMS (>= RULE_XFORM_FIRST) rewrite the canonical value (trim/case).
//   CHECKS (< RULE_XFORM_FIRST) validate it and may push an error.
const RULE_MIN = 0 // numeric >=  (ival) / string length >= for STR
const RULE_MAX = 1 // numeric <=  (ival) / string length <= for STR
const RULE_LEN = 2 // string length in [ival, ival2]
const RULE_PRESENT = 3 // non-empty
const RULE_ONE_OF = 4 // value in comma-separated set (sval)
const RULE_EMAIL = 5 // basic email shape
const RULE_REFINE = 6 // custom closure predicate (fn value:string -> int)
const RULE_POSITIVE = 7 // numeric > 0
const RULE_NONNEG = 8 // numeric >= 0
const RULE_PATTERN = 9 // substring/prefix/suffix contains (sval "kind:needle")
// -- transforms (rewrite the value; never fail) --
const RULE_XFORM_FIRST = 100
const RULE_TRIM = 100 // strip surrounding whitespace
const RULE_LOWER = 101 // lowercase
const RULE_UPPER = 102 // uppercase

struct Rule {
    kind: int
    ival: long // primary numeric arg (min / max / len-lo)
    ival2: long // secondary numeric arg (len-hi)
    sval: string // string arg (one_of set, pattern)
    refine_fn: ptr // boxed closure for RULE_REFINE
}

struct Field {
    kind: int // KIND_FIELD: shares its first member with Schema
    name: string
    ty: int
    is_optional: int
    has_default: int // 1 if default_val supplies an absent field
    default_val: string // value substituted when the field is absent
    rules: ptr // *List of *Rule
    nested: ptr // OBJECT: the *Schema of its fields
    item: ptr // array(T): the *Field each item is checked as
}

struct Schema {
    kind: int // KIND_SCHEMA
    strict: int // 0 = lax coercion (Pydantic default), 1 = strict
    fields: ptr // *List of *Field
}

// A parse error: {field, code, message}. Stored as a *List of *SchemaError.
struct SchemaError {
    field: string
    code: string
    msg: string
}

// ---------------------------------------------------------------------------
// Builders
// ---------------------------------------------------------------------------

// record() { field(...) ... }  — the top-level container. Its trailing block
// runs immediately and populates the schema via field() calls.
record() -> ptr {
    return new_schema()
}

fn new_schema() -> *Schema {
    s = heap.new(Schema)
    s.kind = KIND_SCHEMA
    s.strict = 0
    s.fields = list_new()
    return s
}

fn new_field(name: string, ty: int) -> *Field {
    f = heap.new(Field)
    f.kind = KIND_FIELD
    f.name = name
    f.ty = ty
    f.is_optional = 0
    f.has_default = 0
    f.default_val = ""
    f.rules = list_new()
    f.nested = null
    f.item = null
    if ty == OBJECT {
        f.nested = new_schema()
    }
    if is_array(ty) {
        f.item = new_field("", ty - ARRAY_OF)
    }
    return f
}

// The record a field() call in this block belongs to: record()'s own, an
// OBJECT field's nested record, or the record each item of an array of
// OBJECT is checked against. Null in a scalar field's block.
fn record_of(ctx: ptr) -> *Schema {
    s = ctx as *Schema
    if s.kind == KIND_SCHEMA {
        return s
    }
    f = ctx as *Field
    while is_array(f.ty) {
        f = f.item as *Field
    }
    if f.ty == OBJECT {
        return f.nested as *Schema
    }
    return null
}

// field(name, type) { min(...); max(...); ... }
// Container-with-config-block: appends a Field to the enclosing record and
// returns it so the trailing block's rule calls accumulate onto it. Inside
// an OBJECT field's block it declares one of that object's fields; inside
// an array(OBJECT) field's block, one of each item's.
field(_ctx: ptr, name: string, ty: int) -> ptr {
    s = record_of(_ctx)
    if s == null {
        parent = _ctx as *Field
        panic("schema.field(\"${name}\") inside the block of ${parent.name}, which is not a record: declare nested fields under a field of type schema.OBJECT or schema.array(schema.OBJECT)")
    }
    f = new_field(name, ty)
    list_add_raw(s.fields, f)
    return f
}

// items() { rules }: the rules each item of an array field is checked
// against, where the field's own rules count the items. For an array of
// OBJECT, declare the item's fields directly in the field's block instead.
items(_ctx: ptr) -> ptr {
    f = _ctx as *Field
    if f.kind != KIND_FIELD || !is_array(f.ty) {
        panic("schema.items() belongs in the block of a field of type schema.array(...)")
    }
    return f.item
}

// -- rule builders (run inside a field() block; _ctx is the *Field) --

fn add_rule(_ctx: ptr, kind: int, ival: long, ival2: long, sval: string, refine_fn: ptr) {
    f = _ctx as *Field
    if f.kind != KIND_FIELD {
        panic("schema rules belong in a field's block, not directly in a record's")
    }
    if f.ty == OBJECT {
        panic("schema rule on ${f.name}, an OBJECT: rules apply to its fields")
    }
    if is_array(f.ty) && kind != RULE_MIN && kind != RULE_MAX && kind != RULE_LEN && kind != RULE_PRESENT {
        panic("schema rule on ${f.name}, an array: only min, max, len and present count its items; put item rules in items()")
    }
    r = heap.new(Rule)
    r.kind = kind
    r.ival = ival
    r.ival2 = ival2
    r.sval = sval
    r.refine_fn = refine_fn
    list_add_raw(f.rules, r)
}

// numeric: value >= n  |  STR: length >= n
min(_ctx: ptr, n: long) {
    add_rule(_ctx, RULE_MIN, n, 0, "", null)
}

// numeric: value <= n  |  STR: length <= n
max(_ctx: ptr, n: long) {
    add_rule(_ctx, RULE_MAX, n, 0, "", null)
}

// STR length in [lo, hi]
len(_ctx: ptr, lo: long, hi: long) {
    add_rule(_ctx, RULE_LEN, lo, hi, "", null)
}

// non-empty (STR) / present in input
present(_ctx: ptr) {
    add_rule(_ctx, RULE_PRESENT, 0, 0, "", null)
}

// mark field optional (absence is not an error; rules skipped when absent)
optional(_ctx: ptr) {
    f = _ctx as *Field
    if f.kind != KIND_FIELD {
        panic("schema.optional() belongs in a field's block")
    }
    f.is_optional = 1
}

// value must be one of a comma-separated set, e.g. one_of("admin,user")
one_of(_ctx: ptr, set: string) {
    add_rule(_ctx, RULE_ONE_OF, 0, 0, set, null)
}

// value must look like an email
email(_ctx: ptr) {
    add_rule(_ctx, RULE_EMAIL, 0, 0, "", null)
}

// custom predicate: fn(value: string) -> int (1 = ok, 0 = fail)
refine(_ctx: ptr, predicate: fn) {
    add_rule(_ctx, RULE_REFINE, 0, 0, "", box_closure(predicate))
}

// Supply a value when the field is absent from the input (implies optional:
// an absent field is filled with `v` rather than erroring). A present field is
// validated normally; the default only fires on absence.
default_to(_ctx: ptr, v: string) {
    f = _ctx as *Field
    if f.kind != KIND_FIELD || f.ty == OBJECT || is_array(f.ty) {
        panic("schema.default_to() supplies a scalar field; an object or array field can be optional()")
    }
    // Refused here rather than dropped from parse_json's values later.
    _, code = check_type(v, f.ty, 0)
    if code != "" {
        panic("schema.default_to(\"${v}\") on ${f.name}: the default is not a valid ${type_name(f.ty)}")
    }
    f.has_default = 1
    f.default_val = v
    f.is_optional = 1
}

// numeric > 0
positive(_ctx: ptr) {
    add_rule(_ctx, RULE_POSITIVE, 0, 0, "", null)
}

// numeric >= 0
nonneg(_ctx: ptr) {
    add_rule(_ctx, RULE_NONNEG, 0, 0, "", null)
}

// Lightweight string pattern match without a regex dependency. `spec` is
// "kind:needle" where kind is one of contains / prefix / suffix, e.g.
// pattern("prefix:SAVE") or pattern("contains:@"). For full regex, use refine().
pattern(_ctx: ptr, spec: string) {
    add_rule(_ctx, RULE_PATTERN, 0, 0, spec, null)
}

// -- transforms: rewrite the canonical value (applied in declaration order,
//    before checks that follow them; they never fail) --

// strip surrounding whitespace
trim(_ctx: ptr) {
    add_rule(_ctx, RULE_TRIM, 0, 0, "", null)
}

// lowercase the value
lowercase(_ctx: ptr) {
    add_rule(_ctx, RULE_LOWER, 0, 0, "", null)
}

// uppercase the value
uppercase(_ctx: ptr) {
    add_rule(_ctx, RULE_UPPER, 0, 0, "", null)
}

// ---------------------------------------------------------------------------
// Parse
// ---------------------------------------------------------------------------

// `field_name` is the field's path ("address.city", "tags[2]") and is
// copied: a nested path is built for the one error. `code` is always a
// borrowed string-literal issue code, stored by reference.
fn push_error(errors: ptr, field_name: string, code: string, msg: string) {
    e = heap.new(SchemaError)
    e.field = string_concat(field_name, "")
    e.code = code
    // `msg` arrives as a plain char* string interpolation (`${...}`), which the
    // heap-tracker frees on scope exit — NOT via string_free — so it cannot be
    // stored in a long-lived struct field as-is. Mint a magic AetherString copy
    // (string_concat(_, "")) that errors_free can reclaim with string_free; the
    // original interp temporary is tracker-freed when this frame returns.
    e.msg = string_concat(msg, "")
    list_add_raw(errors, e)
}

// Coerce/type-check a raw string against a field type.
// Returns (typed_string_repr, code) — code == "" on success. In lax mode we
// accept and re-canonicalize; in strict mode a non-native shape is rejected.
fn check_type(raw: string, ty: int, strict: int) -> (string, string) {
    if ty == STR {
        return raw, ""
    }
    if ty == INT {
        _, err = to_long(raw)
        if err != "" {
            return "", "invalid_type"
        }
        return raw, ""
    }
    if ty == FLOAT {
        _, ferr = to_float(raw)
        if ferr != "" {
            return "", "invalid_type"
        }
        return raw, ""
    }
    if ty == BOOL {
        low = string_to_lower(raw)
        is_true = string_equals(low, "true") == 1 || string_equals(low, "1") == 1
        is_false = string_equals(low, "false") == 1 || string_equals(low, "0") == 1
        string_free(low)
        if is_true {
            return "true", ""
        }
        if is_false {
            return "false", ""
        }
        return "", "invalid_type"
    }
    return raw, ""
}

// Something before the @, and a domain after it with a dot that neither
// starts nor ends it. The local part may hold dots of its own.
fn looks_like_email(v: string) -> int {
    at = string_index_of(v, "@")
    if at <= 0 {
        return 0
    }
    // the domain's dot: after the @, not immediately after
    dot = string_index_of_from(v, ".", at + 1)
    if dot <= at + 1 {
        return 0
    }
    n = string_length(v)
    if string_char_at_n(v, n, n - 1) == 46 { // '.'
        return 0 // trailing dot
    }
    return 1
}

// An INT field's value for a numeric check: (n, 0), or (0, 1) after pushing
// invalid_type. check_type has accepted the text by the same parse, so the
// failure arm only guards a check that would otherwise compare a 0.
fn int_value(errors: ptr, path: string, v: string) -> (long, int) {
    n, err = to_long(v)
    if err != "" {
        push_error(errors, path, "invalid_type", "${path} is not a valid integer")
        return 0, 1
    }
    return n, 0
}

// Whether `v` is exactly one of the comma-separated options in `set`,
// compared in place: no option is copied out.
fn in_set(set: string, v: string) -> int {
    n = string_length(set)
    vn = string_length(v)
    start = 0
    while start <= n {
        end = string_index_of_from_n(set, n, ",", start)
        if end < 0 {
            end = n
        }
        if end - start == vn {
            i = 0
            while i < vn && string_char_at_n(set, n, start + i) == string_char_at_n(v, vn, i) {
                i = i + 1
            }
            if i == vn {
                return 1
            }
        }
        start = end + 1
    }
    return 0
}

// Apply one rule to a (typed) value at `path`. On failure pushes an error
// (borrowed literal code + owned interpolated message) and returns 1; returns
// 0 on pass.
// Pushing directly (rather than returning a tuple) keeps issue codes as
// borrowed string literals — only the message is owned, so ownership is
// unambiguous: errors_free frees exactly the messages.
fn apply_rule(errors: ptr, r: *Rule, f: *Field, path: string, v: string) -> int {
    k = r.kind
    if k == RULE_PRESENT {
        if string_length(v) == 0 {
            push_error(errors, path, "invalid_value", "${path} must not be empty")
            return 1
        }
        return 0
    }
    if k == RULE_MIN {
        if f.ty == STR {
            if string_length(v) < (r.ival as int) {
                push_error(errors, path, "too_small", "${path} must be at least ${r.ival} characters")
                return 1
            }
        } else if f.ty == FLOAT {
            fv, _ = to_float(v)
            if fv < (r.ival as float) {
                push_error(errors, path, "too_small", "${path} must be >= ${r.ival}")
                return 1
            }
        } else {
            iv, bad = int_value(errors, path, v)
            if bad == 1 {
                return 1
            }
            if iv < r.ival {
                push_error(errors, path, "too_small", "${path} must be >= ${r.ival}")
                return 1
            }
        }
        return 0
    }
    if k == RULE_MAX {
        if f.ty == STR {
            if string_length(v) > (r.ival as int) {
                push_error(errors, path, "too_big", "${path} must be at most ${r.ival} characters")
                return 1
            }
        } else if f.ty == FLOAT {
            fv, _ = to_float(v)
            if fv > (r.ival as float) {
                push_error(errors, path, "too_big", "${path} must be <= ${r.ival}")
                return 1
            }
        } else {
            iv, bad = int_value(errors, path, v)
            if bad == 1 {
                return 1
            }
            if iv > r.ival {
                push_error(errors, path, "too_big", "${path} must be <= ${r.ival}")
                return 1
            }
        }
        return 0
    }
    if k == RULE_LEN {
        n = string_length(v)
        if (n as long) < r.ival {
            push_error(errors, path, "too_small", "${path} must be at least ${r.ival} characters")
            return 1
        }
        if (n as long) > r.ival2 {
            push_error(errors, path, "too_big", "${path} must be at most ${r.ival2} characters")
            return 1
        }
        return 0
    }
    if k == RULE_ONE_OF {
        if in_set(r.sval, v) != 1 {
            push_error(errors, path, "invalid_value", "${path} must be one of: ${r.sval}")
            return 1
        }
        return 0
    }
    if k == RULE_EMAIL {
        if looks_like_email(v) != 1 {
            push_error(errors, path, "invalid_format", "${path} must be a valid email")
            return 1
        }
        return 0
    }
    if k == RULE_REFINE {
        pred = unbox_closure(r.refine_fn)
        int res = call(pred, v)
        if res != 1 {
            push_error(errors, path, "custom", "${path} failed validation")
            return 1
        }
        return 0
    }
    if k == RULE_POSITIVE {
        if f.ty == FLOAT {
            fv, _ = to_float(v)
            if fv <= 0.0 {
                push_error(errors, path, "too_small", "${path} must be positive")
                return 1
            }
        } else {
            iv, bad = int_value(errors, path, v)
            if bad == 1 {
                return 1
            }
            if iv <= 0 {
                push_error(errors, path, "too_small", "${path} must be positive")
                return 1
            }
        }
        return 0
    }
    if k == RULE_NONNEG {
        if f.ty == FLOAT {
            fv, _ = to_float(v)
            if fv < 0.0 {
                push_error(errors, path, "too_small", "${path} must be non-negative")
                return 1
            }
        } else {
            iv, bad = int_value(errors, path, v)
            if bad == 1 {
                return 1
            }
            if iv < 0 {
                push_error(errors, path, "too_small", "${path} must be non-negative")
                return 1
            }
        }
        return 0
    }
    if k == RULE_PATTERN {
        // spec is "kind:needle" — kind in {contains, prefix, suffix}
        colon = string_index_of(r.sval, ":")
        matched = 0
        if colon > 0 {
            kind_s = string_substring(r.sval, 0, colon)
            needle = string_substring(r.sval, colon + 1, string_length(r.sval))
            if string_equals(kind_s, "contains") == 1 {
                matched = string_contains(v, needle)
            } else if string_equals(kind_s, "prefix") == 1 {
                matched = string_starts_with(v, needle)
            } else if string_equals(kind_s, "suffix") == 1 {
                matched = string_ends_with(v, needle)
            }
            string_free(kind_s)
            string_free(needle)
        }
        if matched != 1 {
            push_error(errors, path, "invalid_format", "${path} does not match pattern ${r.sval}")
            return 1
        }
        return 0
    }
    return 0
}

// Apply a transform rule to `v`, returning a freshly-owned (magic) string.
// The caller owns the result and must free the previous value if it owned it.
fn apply_transform(kind: int, v: string) -> string {
    if kind == RULE_TRIM {
        return string_trim(v)
    }
    if kind == RULE_LOWER {
        return string_to_lower(v)
    }
    if kind == RULE_UPPER {
        return string_to_upper(v)
    }
    return string_concat(v, "") // identity copy (keeps ownership uniform)
}

// Run a field's rules, in declaration order, on its typed value at `path`.
// Transforms rewrite the value (owning a fresh string each step); checks
// validate it. Returns (value, failed): the value is owned by the caller
// either way.
fn run_rules(errors: ptr, f: *Field, path: string, typed: string) -> (string, int) {
    cur = string_concat(typed, "")
    rsz = list_size(f.rules)
    j = 0
    while j < rsz {
        r = list_get_raw(f.rules, j) as *Rule
        if r.kind >= RULE_XFORM_FIRST {
            next = apply_transform(r.kind, cur)
            string_free(cur)
            cur = next
        } else if apply_rule(errors, r, f, path, cur) == 1 {
            return cur, 1
        }
        j = j + 1
    }
    return cur, 0
}

// parse(schema, input_map) -> (values_map, errors_list)
//   input_map: *Map of string(field name) -> string(raw value)
//   values_map: *Map of field name -> coerced string value (canonical form)
//   errors_list: *List of *SchemaError (empty on success)
// Both returns are always non-null and owned by the caller
// (values_free / errors_free). A flat map cannot carry an OBJECT or array
// field: one given here is an invalid_type error; use parse_json.
parse(schema_ptr: ptr, input: ptr) -> (ptr, ptr) {
    s = schema_ptr as *Schema
    values = map_new()
    errors = list_new()

    fsz = list_size(s.fields)
    i = 0
    while i < fsz {
        f = list_get_raw(s.fields, i) as *Field
        present_in = map_has(input, f.name)

        if present_in == 0 {
            if f.has_default == 1 {
                // absent + default → supply it. map.put auto-routes a string
                // value to the owning sibling, so values_free reclaims it.
                map.put(values, f.name, string_concat(f.default_val, ""))
            } else if f.is_optional == 0 {
                push_error(errors, f.name, "missing", "${f.name} is required")
            }
            i = i + 1
            continue
        }

        if f.ty == OBJECT || is_array(f.ty) {
            push_error(errors, f.name, "invalid_type", "${f.name} is ${type_name(f.ty)}: validate nested input with parse_json")
            i = i + 1
            continue
        }

        raw, _ = map.get(input, f.name)

        // 1. type check / coercion
        typed, tcode = check_type(raw, f.ty, s.strict)
        if tcode != "" {
            push_error(errors, f.name, tcode, "${f.name} is not a valid ${type_name(f.ty)}")
            i = i + 1
            continue
        }

        // 2. the rules
        cur, failed = run_rules(errors, f, f.name, typed)
        if failed == 0 {
            // map.put auto-routes the owned string `cur` to the owning sibling.
            map.put(values, f.name, cur)
        } else {
            string_free(cur)
        }
        i = i + 1
    }

    return values, errors
}

// parse_json(schema, root) -> (values, errors_list)
//   root: a std.json object (json.parse's result)
//   values: a std.json object of the fields that passed, coerced to their
//           types: STR a string, INT an integer, FLOAT a number, BOOL a
//           boolean, OBJECT an object of its own fields, array(T) an array
//   errors_list: as parse's, each error's field its path from the root:
//           "address.city", "tags[2]", "lines[0].qty"
// Both returns are non-null and owned by the caller: json.json_free(values)
// and errors_free(errors). A JSON null is an absent field. Keys the schema
// does not declare are left out of values. In lax mode (the default) a
// string holding a number or boolean is coerced, and a number or boolean
// given for a STR field is taken as its text; strict mode refuses both.
parse_json(schema_ptr: ptr, root: ptr) -> (ptr, ptr) {
    s = schema_ptr as *Schema
    errors = list_new()
    if root == null || json.json_type(root) != JSON_OBJECT {
        push_error(errors, "", "invalid_type", "the input is not a JSON object")
        return json.json_create_object(), errors
    }
    return check_object(s, root, "", s.strict, errors), errors
}

fn join_path(prefix: string, name: string) -> string {
    if string_length(prefix) == 0 {
        return string_concat(name, "")
    }
    with_dot = string_concat(prefix, ".")
    joined = string_concat(with_dot, name)
    string_free(with_dot)
    return joined
}

// A JSON object's declared fields, checked; the passing ones as a new object.
fn check_object(s: *Schema, obj: ptr, prefix: string, strict: int, errors: ptr) -> ptr {
    out = json.json_create_object()
    fsz = list_size(s.fields)
    i = 0
    while i < fsz {
        f = list_get_raw(s.fields, i) as *Field
        path = join_path(prefix, f.name)
        v = json.json_object_get_raw(obj, f.name)
        if v != null && json.json_type(v) == JSON_NULL {
            v = null
        }
        if v == null {
            if f.has_default == 1 {
                d = typed_json(f.ty, f.default_val)
                if d != null {
                    _ = json.json_object_set_raw(out, f.name, d)
                }
            } else if f.is_optional == 0 {
                push_error(errors, path, "missing", "${path} is required")
            }
        } else {
            checked = check_value(f, v, path, strict, errors)
            if checked != null {
                _ = json.json_object_set_raw(out, f.name, checked)
            }
        }
        string_free(path)
        i = i + 1
    }
    return out
}

// One value against its field: the coerced JSON value, or null after
// pushing what is wrong.
fn check_value(f: *Field, v: ptr, path: string, strict: int, errors: ptr) -> ptr {
    t = json.json_type(v)
    if f.ty == OBJECT {
        if t != JSON_OBJECT {
            push_error(errors, path, "invalid_type", "${path} is not an object")
            return null
        }
        before = list_size(errors)
        obj = check_object(f.nested as *Schema, v, path, strict, errors)
        if list_size(errors) > before {
            json.json_free(obj)
            return null
        }
        return obj
    }
    if is_array(f.ty) {
        if t != JSON_ARRAY {
            push_error(errors, path, "invalid_type", "${path} is not an array")
            return null
        }
        n = json.json_array_size(v)
        if count_fails(errors, f, path, n) == 1 {
            return null
        }
        item = f.item as *Field
        arr = json.json_create_array()
        failed = 0
        k = 0
        while k < n {
            item_path = "${path}[${k}]"
            checked = check_value(item, json.json_array_get_raw(v, k), item_path, strict, errors)
            if checked == null {
                failed = 1
            } else {
                _ = json.json_array_add_raw(arr, checked)
            }
            k = k + 1
        }
        if failed == 1 {
            json.json_free(arr)
            return null
        }
        return arr
    }
    text, tcode = scalar_text(f.ty, v, strict)
    if tcode != "" {
        push_error(errors, path, tcode, "${path} is not a valid ${type_name(f.ty)}")
        return null
    }
    cur, failed2 = run_rules(errors, f, path, text)
    string_free(text)
    if failed2 == 1 {
        string_free(cur)
        return null
    }
    out = typed_json(f.ty, cur)
    string_free(cur)
    if out == null {
        push_error(errors, path, "invalid_type", "${path} is not a valid ${type_name(f.ty)}")
    }
    return out
}

// An array field's own rules count its items. 1 after pushing a failure.
fn count_fails(errors: ptr, f: *Field, path: string, n: int) -> int {
    rsz = list_size(f.rules)
    j = 0
    while j < rsz {
        r = list_get_raw(f.rules, j) as *Rule
        k = r.kind
        if k == RULE_PRESENT && n == 0 {
            push_error(errors, path, "invalid_value", "${path} must not be empty")
            return 1
        }
        if (k == RULE_MIN || k == RULE_LEN) && (n as long) < r.ival {
            push_error(errors, path, "too_small", "${path} must have at least ${r.ival} items")
            return 1
        }
        if k == RULE_MAX && (n as long) > r.ival {
            push_error(errors, path, "too_big", "${path} must have at most ${r.ival} items")
            return 1
        }
        if k == RULE_LEN && (n as long) > r.ival2 {
            push_error(errors, path, "too_big", "${path} must have at most ${r.ival2} items")
            return 1
        }
        j = j + 1
    }
    return 0
}

// A JSON scalar as the canonical text the rules check, owned: (text, "") or
// ("", "invalid_type").
fn scalar_text(ty: int, v: ptr, strict: int) -> (string, string) {
    t = json.json_type(v)
    if t == JSON_STRING {
        raw = json.json_get_string_raw(v)
        if ty == STR {
            return string_concat(raw, ""), ""
        }
        if strict == 1 {
            return "", "invalid_type"
        }
        typed, code = check_type(raw, ty, strict)
        if code != "" {
            return "", code
        }
        return string_concat(typed, ""), ""
    }
    if t == JSON_NUMBER {
        if ty == STR && strict == 1 {
            return "", "invalid_type"
        }
        if ty == INT {
            if json.json_is_integer(v) != 1 {
                return "", "invalid_type"
            }
            return string_concat("${json.json_get_long(v)}", ""), ""
        }
        if ty == FLOAT || ty == STR {
            text, _ = json.stringify(v)
            return text, ""
        }
        return "", "invalid_type"
    }
    if t == JSON_BOOL {
        if ty == BOOL || (ty == STR && strict == 0) {
            if json.json_get_bool(v) == 1 {
                return string_concat("true", ""), ""
            }
            return string_concat("false", ""), ""
        }
        return "", "invalid_type"
    }
    return "", "invalid_type"
}

// A field's canonical text as the JSON value of its type; null when the
// text does not read as one, which a caller reports.
fn typed_json(ty: int, text: string) -> ptr {
    if ty == INT {
        n, err = to_long(text)
        if err != "" {
            return null
        }
        return json.json_create_int(n)
    }
    if ty == FLOAT {
        x, ferr = to_float(text)
        if ferr != "" {
            return null
        }
        return json.json_create_number(x)
    }
    if ty == BOOL {
        low = string_to_lower(text)
        yes = string_equals(low, "true") == 1 || string_equals(low, "1") == 1
        string_free(low)
        if yes {
            return json.json_create_bool(1)
        }
        return json.json_create_bool(0)
    }
    return json.json_create_string(text)
}

fn type_name(ty: int) -> string {
    if ty == OBJECT {
        return "an object"
    }
    if is_array(ty) {
        return "an array"
    }
    if ty == INT {
        return "integer"
    }
    if ty == FLOAT {
        return "number"
    }
    if ty == BOOL {
        return "boolean"
    }
    return "string"
}

// ---------------------------------------------------------------------------
// Result helpers
// ---------------------------------------------------------------------------

// True (1) if the errors list is empty.
ok(errors: ptr) -> int {
    if list_size(errors) == 0 {
        return 1
    }
    return 0
}

error_count(errors: ptr) -> int {
    return list_size(errors)
}

// The getters below read error `idx` of an errors list. They have no error
// channel, so an index outside [0, error_count) reads as "", which no error
// carries as its code, rather than a crash.
fn error_at(errors: ptr, idx: int) -> *SchemaError {
    e, err = list.get(errors, idx)
    if err != "" {
        return null
    }
    return e as *SchemaError
}

error_field(errors: ptr, idx: int) -> string {
    e = error_at(errors, idx)
    if e == null {
        return ""
    }
    return e.field
}

error_code(errors: ptr, idx: int) -> string {
    e = error_at(errors, idx)
    if e == null {
        return ""
    }
    return e.code
}

error_message(errors: ptr, idx: int) -> string {
    e = error_at(errors, idx)
    if e == null {
        return ""
    }
    return e.msg
}

// ---------------------------------------------------------------------------
// Projection — emit a standard JSON Schema document (Zod's z.toJSONSchema()).
//
// A schema is a description, not just a gate: to_json_schema() turns a record
// into a draft-07 JSON Schema string so the same declaration drives OpenAPI
// docs, other-language validators, or form generators. Constraints map as:
//   min/max      -> minimum/maximum (numeric)  or minLength/maxLength (STR)
//   len(lo,hi)   -> minLength/maxLength
//   one_of       -> enum
//   email        -> "format": "email"
//   pattern      -> description hint (our lightweight kind:needle isn't regex)
//   positive     -> exclusiveMinimum: 0   |  nonneg -> minimum: 0
//   present/!opt -> listed in "required"
// ---------------------------------------------------------------------------

fn json_type_for(ty: int) -> string {
    if ty == OBJECT {
        return "object"
    }
    if is_array(ty) {
        return "array"
    }
    if ty == INT {
        return "integer"
    }
    if ty == FLOAT {
        return "number"
    }
    if ty == BOOL {
        return "boolean"
    }
    return "string"
}

// Minimal JSON string escaping for values we emit (field names, enum items,
// defaults). Handles the characters that would break a JSON string literal.
fn json_escape_into(b: ptr, s: string) {
    n = string_length(s)
    i = 0
    while i < n {
        c = string_char_at(s, i)
        if c == 34 { // "
            strbuilder.append(b, "\\\"")
        } else if c == 92 { // backslash
            strbuilder.append(b, "\\\\")
        } else if c == 10 {
            strbuilder.append(b, "\\n")
        } else if c == 9 {
            strbuilder.append(b, "\\t")
        } else {
            strbuilder.append_byte(b, c)
        }
        i = i + 1
    }
}

fn append_kv_str(b: ptr, key: string, val: string) {
    strbuilder.append(b, "\"")
    strbuilder.append(b, key)
    strbuilder.append(b, "\":\"")
    json_escape_into(b, val)
    strbuilder.append(b, "\"")
}

// A record's "type":"object","properties":{...},"required":[...] members.
fn object_schema_into(b: ptr, s: *Schema) {
    strbuilder.append(b, "\"type\":\"object\",\"properties\":{")
    fsz = list_size(s.fields)
    i = 0
    while i < fsz {
        f = list_get_raw(s.fields, i) as *Field
        if i > 0 {
            strbuilder.append(b, ",")
        }
        strbuilder.append(b, "\"")
        json_escape_into(b, f.name)
        strbuilder.append(b, "\":")
        field_schema_into(b, f)
        i = i + 1
    }
    strbuilder.append(b, "},\"required\":[")
    first_req = 1
    i = 0
    while i < fsz {
        f = list_get_raw(s.fields, i) as *Field
        if f.is_optional == 0 && f.has_default == 0 {
            if first_req == 0 {
                strbuilder.append(b, ",")
            }
            strbuilder.append(b, "\"")
            json_escape_into(b, f.name)
            strbuilder.append(b, "\"")
            first_req = 0
        }
        i = i + 1
    }
    strbuilder.append(b, "]")
}

// One field's schema object: its type, and its rules as JSON Schema keywords.
fn field_schema_into(b: ptr, f: *Field) {
    strbuilder.append(b, "{")
    if f.ty == OBJECT {
        object_schema_into(b, f.nested as *Schema)
        strbuilder.append(b, "}")
        return
    }
    append_kv_str(b, "type", json_type_for(f.ty))
    if is_array(f.ty) {
        strbuilder.append(b, ",\"items\":")
        field_schema_into(b, f.item as *Field)
        rsz = list_size(f.rules)
        j = 0
        while j < rsz {
            r = list_get_raw(f.rules, j) as *Rule
            if r.kind == RULE_MIN || r.kind == RULE_LEN {
                strbuilder.append(b, ",\"minItems\":")
                strbuilder.append_long(b, r.ival)
            }
            if r.kind == RULE_PRESENT {
                strbuilder.append(b, ",\"minItems\":1")
            }
            if r.kind == RULE_MAX {
                strbuilder.append(b, ",\"maxItems\":")
                strbuilder.append_long(b, r.ival)
            }
            if r.kind == RULE_LEN {
                strbuilder.append(b, ",\"maxItems\":")
                strbuilder.append_long(b, r.ival2)
            }
            j = j + 1
        }
        strbuilder.append(b, "}")
        return
    }
    is_str = f.ty == STR
    rsz = list_size(f.rules)
    j = 0
    while j < rsz {
        r = list_get_raw(f.rules, j) as *Rule
        k = r.kind
        if k == RULE_MIN {
            if is_str {
                strbuilder.append(b, ",\"minLength\":")
            } else {
                strbuilder.append(b, ",\"minimum\":")
            }
            strbuilder.append_long(b, r.ival)
        } else if k == RULE_MAX {
            if is_str {
                strbuilder.append(b, ",\"maxLength\":")
            } else {
                strbuilder.append(b, ",\"maximum\":")
            }
            strbuilder.append_long(b, r.ival)
        } else if k == RULE_LEN {
            strbuilder.append(b, ",\"minLength\":")
            strbuilder.append_long(b, r.ival)
            strbuilder.append(b, ",\"maxLength\":")
            strbuilder.append_long(b, r.ival2)
        } else if k == RULE_ONE_OF {
            strbuilder.append(b, ",\"enum\":[")
            set_s = r.sval
            start = 0
            slen = string_length(set_s)
            first = 1
            pos = 0
            while pos <= slen {
                if pos == slen || string_char_at(set_s, pos) == 44 { // ','
                    item = string_substring(set_s, start, pos)
                    if first == 0 {
                        strbuilder.append(b, ",")
                    }
                    strbuilder.append(b, "\"")
                    json_escape_into(b, item)
                    strbuilder.append(b, "\"")
                    string_free(item)
                    first = 0
                    start = pos + 1
                }
                pos = pos + 1
            }
            strbuilder.append(b, "]")
        } else if k == RULE_EMAIL {
            strbuilder.append(b, ",\"format\":\"email\"")
        } else if k == RULE_POSITIVE {
            strbuilder.append(b, ",\"exclusiveMinimum\":0")
        } else if k == RULE_NONNEG {
            strbuilder.append(b, ",\"minimum\":0")
        } else if k == RULE_PATTERN {
            strbuilder.append(b, ",\"description\":\"matches ")
            json_escape_into(b, r.sval)
            strbuilder.append(b, "\"")
        }
        j = j + 1
    }
    if f.has_default == 1 {
        strbuilder.append(b, ",")
        append_kv_str(b, "default", f.default_val)
    }
    strbuilder.append(b, "}")
}

// to_json_schema(schema) -> owned JSON string (draft-07). Caller frees with
// string_free. Built directly with strbuilder (no JSON DOM) so it is leak-clean
// by construction and carries no ownership entanglement. An OBJECT field is a
// nested "object" schema; an array field is "array" with its "items" schema,
// its counting rules as minItems/maxItems.
to_json_schema(schema_ptr: ptr) -> string {
    s = schema_ptr as *Schema
    b = strbuilder.new(256)
    strbuilder.append(b, "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",")
    object_schema_into(b, s)
    strbuilder.append(b, "}")

    // strbuilder.finish returns a plain char*; mint an owned magic string so the
    // caller can string_free it (and the plain char* is tracker-reclaimed).
    raw = strbuilder.finish(b)
    return string_concat(raw, "")
}

// ---------------------------------------------------------------------------
// Cleanup
// ---------------------------------------------------------------------------

schema_free(schema_ptr: ptr) {
    if schema_ptr == null {
        return
    }
    s = schema_ptr as *Schema
    fsz = list_size(s.fields)
    i = 0
    while i < fsz {
        field_free(list_get_raw(s.fields, i) as *Field)
        i = i + 1
    }
    list_free(s.fields)
    heap.free(s)
}

fn field_free(f: *Field) {
    rsz = list_size(f.rules)
    j = 0
    while j < rsz {
        r = list_get_raw(f.rules, j) as *Rule
        if r.refine_fn != null {
            libc_free(r.refine_fn) // free the box_closure()'d _AeClosure
        }
        heap.free(r)
        j = j + 1
    }
    list_free(f.rules)
    if f.nested != null {
        schema_free(f.nested)
    }
    if f.item != null {
        field_free(f.item as *Field)
    }
    heap.free(f)
}

// The values map now OWNS each stored value (parse stores coerced/transformed/
// defaulted strings via map_put_string_owned). map_free reclaims both the spine
// and every owned value.
values_free(values: ptr) {
    if values != null {
        map_free(values)
    }
}

errors_free(errors: ptr) {
    if errors == null {
        return
    }
    sz = list_size(errors)
    i = 0
    while i < sz {
        e = list_get_raw(errors, i) as *SchemaError
        // heap.free runs SchemaError's typed destructor, which frees the owned
        // magic-string fields e.field and e.msg; e.code is a borrowed string
        // literal (not a magic AetherString), so the destructor skips it.
        heap.free(e)
        i = i + 1
    }
    list_free(errors)
}
