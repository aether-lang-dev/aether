    0x616BFFD3, 0x166CCF45, 0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2,
    0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB, 0xAED16A4A, 0xD9D65ADC,
    0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
    0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693,
    0x54DE5729, 0x23D967BF, 0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94,
    0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D
]

// Continues a CRC-32 over `length` more bytes of `data`: pass the value a
// previous crc32 / crc32_update returned (0 to start), and the result is the
// CRC of everything so far, as crc32 of the whole input would be. Returned as
// the unsigned 32-bit value in a `long`.
crc32_update(crc: long, data: string, length: int) -> long {
    let mask: long = 0xFFFFFFFF
    let c: long = (crc ^ mask) & mask
    i = 0
    while i < length {
        b = (string.char_at_n(data, length, i) & 255) as long
        idx = ((c ^ b) & 255) as int
        entry = (CRC32_TABLE[idx] as long) & mask
        c = (entry ^ (c >> 8)) & mask
        i = i + 1
    }
    return (c ^ mask) & mask
}

// CRC-32 of `length` bytes of `data`.
crc32(data: string, length: int) -> long {
    return crc32_update(0, data, length)
}
