// std.encoding regression test — hex and base64 codecs (RFC 4648).
//
// Test vectors are ported from the c3c standard-library unit tests
// (test/unit/stdlib/encoding/{hex,base64}.c3) — Copyright (c) 2022-2026
// Christoffer Lernö and contributors, MIT. The classic RFC 4648 §10
// "" / "f" / "fo" / "foo" / "foobar" progression plus hex byte patterns.

import std.encoding
import std.string
import std.bytes

extern exit(code: int)

fn check(cond: bool, msg: string) -> int {
    if !cond { println("FAIL: ${msg}"); return 1 }
    return 0
}

main() {
    fails = 0

    // ---- hex encode (lowercase; from c3 hex.c3 test cases) ----
    fails = fails + check(encoding.hex_encode(string.bytes("")) == "", "hex encode empty")
    fails = fails + check(encoding.hex_encode(string.bytes("g")) == "67", "hex encode 'g'")
    fails = fails + check(encoding.hex_encode(string.bytes("hello")) == "68656c6c6f", "hex encode hello")

    // ---- hex decode (case-insensitive; even length) ----
    d1, e1 = encoding.hex_decode("68656c6c6f")
    fails = fails + check(e1 == "" && d1 == "hello", "hex decode lower")
    d2, e2 = encoding.hex_decode("E3A1") // upper-case accepted
    fails = fails + check(e2 == "" && string.length(d2) == 2, "hex decode upper len")
    // round-trip: upper and lower decode to the same bytes
    dl, _ = encoding.hex_decode("e3a1")
    fails = fails + check(dl == d2, "hex decode case-insensitive")

    // ---- hex decode errors ----
    _, oe = encoding.hex_decode("abc") // odd length
    fails = fails + check(oe != "", "hex odd-length rejected")
    _, ce = encoding.hex_decode("zz") // non-hex chars
    fails = fails + check(ce != "", "hex invalid-char rejected")

    // ---- base64 encode (unpadded, from c3 base64.c3 encode_nopadding) ----
    fails = fails + check(encoding.base64_encode(string.bytes("")) == "", "b64 encode empty")
    fails = fails + check(encoding.base64_encode(string.bytes("f")) == "Zg", "b64 encode f")
    fails = fails + check(encoding.base64_encode(string.bytes("fo")) == "Zm8", "b64 encode fo")
    fails = fails + check(encoding.base64_encode(string.bytes("foo")) == "Zm9v", "b64 encode foo")
    fails = fails + check(encoding.base64_encode(string.bytes("foobar")) == "Zm9vYmFy", "b64 encode foobar")

    // ---- base64 encode (padded, from c3 encode) ----
    fails = fails + check(encoding.base64_encode_padded(string.bytes("f")) == "Zg==", "b64 padded f")
    fails = fails + check(encoding.base64_encode_padded(string.bytes("foobar")) == "Zm9vYmFy", "b64 padded foobar")

    // ---- base32 (RFC 4648 §6 vectors, from c3 base32.c3) ----
    fails = fails + check(encoding.base32_encode(string.bytes("")) == "", "b32 empty")
    fails = fails + check(encoding.base32_encode(string.bytes("f")) == "MY======", "b32 f")
    fails = fails + check(encoding.base32_encode(string.bytes("fo")) == "MZXQ====", "b32 fo")
    fails = fails + check(encoding.base32_encode(string.bytes("foo")) == "MZXW6===", "b32 foo")
    fails = fails + check(encoding.base32_encode(string.bytes("foob")) == "MZXW6YQ=", "b32 foob")
    fails = fails + check(encoding.base32_encode(string.bytes("fooba")) == "MZXW6YTB", "b32 fooba")
    fails = fails + check(encoding.base32_encode(string.bytes("foobar")) == "MZXW6YTBOI======", "b32 foobar")
    b32d, b32e = encoding.base32_decode("MZXW6YTBOI======")
    fails = fails + check(b32e == "" && b32d == "foobar", "b32 decode foobar")
    b32d2, b32e2 = encoding.base32_decode("MZXW6===")
    fails = fails + check(b32e2 == "" && b32d2 == "foo", "b32 decode foo")
    // base32 round-trip
    b32r, _ = encoding.base32_decode(encoding.base32_encode(string.bytes("hello world")))
    fails = fails + check(b32r == "hello world", "b32 round-trip")
    // unpadded and lower-case input are accepted (every short-group length)
    b32u, b32ue = encoding.base32_decode("mzxw6ytboi")
    fails = fails + check(b32ue == "" && b32u == "foobar", "b32 decode unpadded lower-case")
    b32u4, b32u4e = encoding.base32_decode("MZXW6YQ")
    fails = fails + check(b32u4e == "" && b32u4 == "foob", "b32 decode unpadded 7-char group")

    // ---- base32 decode errors (RFC 4648 §6: a final group is 2, 4, 5 or
    // 7 chars; padding, when present, completes it to 8; spare bits are 0)
    _, b32l1 = encoding.base32_decode("M")
    fails = fails + check(b32l1 != "", "b32 1-char group rejected")
    _, b32l6 = encoding.base32_decode("MZXW6Y")
    fails = fails + check(b32l6 != "", "b32 6-char group rejected")
    _, b32l9 = encoding.base32_decode("MZXW6YTBO")
    fails = fails + check(b32l9 != "", "b32 9-char input rejected")
    _, b32p1 = encoding.base32_decode("MZXW6=")
    fails = fails + check(b32p1 != "", "b32 short padding rejected")
    _, b32p2 = encoding.base32_decode("MY=======")
    fails = fails + check(b32p2 != "", "b32 over-long padding rejected")
    _, b32p3 = encoding.base32_decode("MZXW6YTB========")
    fails = fails + check(b32p3 != "", "b32 padding-only group rejected")
    _, b32t = encoding.base32_decode("MZ======")
    fails = fails + check(b32t != "", "b32 non-zero trailing bits rejected")
    _, b32t2 = encoding.base32_decode("MZ")
    fails = fails + check(b32t2 != "", "b32 non-zero trailing bits rejected (unpadded)")

    // ---- base64 decode (padded and unpadded, from c3 decode) ----
    bd1, be1 = encoding.base64_decode("Zm9vYmFy")
    fails = fails + check(be1 == "" && bd1 == "foobar", "b64 decode foobar")
    bd2, be2 = encoding.base64_decode("Zg==")
    fails = fails + check(be2 == "" && bd2 == "f", "b64 decode padded f")
    bd3, be3 = encoding.base64_decode("Zm8")
    fails = fails + check(be3 == "" && bd3 == "fo", "b64 decode unpadded fo")
    bd4, be4 = encoding.base64_decode("Zm9v\nYmFy")
    fails = fails + check(be4 == "" && bd4 == "foobar", "b64 decode across a line break")

    // ---- base64 decode errors: '=' only as trailing padding (at most two,
    // completing a multiple of 4), no 1-char final group, spare bits 0.
    // Each of these decoded to something with an empty error.
    _, b64l1 = encoding.base64_decode("Z")
    fails = fails + check(b64l1 != "", "b64 1-char group rejected")
    _, b64mid = encoding.base64_decode("Zm9v=Zm9v")
    fails = fails + check(b64mid != "", "b64 '=' before data rejected")
    _, b64pad = encoding.base64_decode("Zg=")
    fails = fails + check(b64pad != "", "b64 short padding rejected")
    _, b64pad3 = encoding.base64_decode("Zg===")
    fails = fails + check(b64pad3 != "", "b64 three '=' rejected")
    _, b64bits = encoding.base64_decode("Zh==")
    fails = fails + check(b64bits != "", "b64 non-zero trailing bits rejected")

    // ---- round-trip a longer string through both ----
    let msg = "The quick brown fox"
    let mlen = string.length(msg)
    hround, _ = encoding.hex_decode(encoding.hex_encode(string.bytes(msg)[0..mlen]))
    fails = fails + check(hround == msg, "hex round-trip")
    bround, _ = encoding.base64_decode(encoding.base64_encode(string.bytes(msg)[0..mlen]))
    fails = fails + check(bround == msg, "base64 round-trip")

    // ---- base64url (RFC 4648 §5; §10 vectors in the `-_` alphabet) ----
    fails = fails + check(encoding.base64url_encode(string.bytes("")) == "", "b64url encode empty")
    fails = fails + check(encoding.base64url_encode(string.bytes("f")) == "Zg", "b64url encode f")
    fails = fails + check(encoding.base64url_encode(string.bytes("fo")) == "Zm8", "b64url encode fo")
    fails = fails + check(encoding.base64url_encode(string.bytes("foo")) == "Zm9v", "b64url encode foo")
    fails = fails + check(encoding.base64url_encode(string.bytes("foob")) == "Zm9vYg", "b64url encode foob")
    fails = fails + check(encoding.base64url_encode(string.bytes("fooba")) == "Zm9vYmE", "b64url encode fooba")
    fails = fails + check(encoding.base64url_encode(string.bytes("foobar")) == "Zm9vYmFy", "b64url encode foobar")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("")) == "", "b64url padded empty")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("f")) == "Zg==", "b64url padded f")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("fo")) == "Zm8=", "b64url padded fo")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("foo")) == "Zm9v", "b64url padded foo")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("foob")) == "Zm9vYg==", "b64url padded foob")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("fooba")) == "Zm9vYmE=", "b64url padded fooba")
    fails = fails + check(encoding.base64url_encode_padded(string.bytes("foobar")) == "Zm9vYmFy", "b64url padded foobar")

    // bytes 0xfb 0xff 0xbf: standard is "+/+/", url-safe is "-_-_"
    ab = bytes.new(3)
    bytes.set(ab, 0, 251)
    bytes.set(ab, 1, 255)
    bytes.set(ab, 2, 191)
    abv = bytes.view(ab)
    fails = fails + check(encoding.base64_encode(abv) == "+/+/", "alphabet: standard has +/")
    fails = fails + check(encoding.base64url_encode(abv) == "-_-_", "alphabet: url-safe has -_")
    ad, ae1 = encoding.base64url_decode("-_-_")
    fails = fails + check(ae1 == "" && string.length(ad) == 3, "b64url decode -_ length")
    fails = fails + check(encoding.base64_encode(string.bytes(ad)[0..3]) == "+/+/", "b64url decode -_ bytes")
    bytes.free(ab)

    // decode: padded and unpadded
    ud1, ue1 = encoding.base64url_decode("Zm9vYmFy")
    fails = fails + check(ue1 == "" && ud1 == "foobar", "b64url decode foobar")
    ud2, ue2 = encoding.base64url_decode("Zg==")
    fails = fails + check(ue2 == "" && ud2 == "f", "b64url decode padded f")
    ud3, ue3 = encoding.base64url_decode("Zg")
    fails = fails + check(ue3 == "" && ud3 == "f", "b64url decode unpadded f")
    ud4, ue4 = encoding.base64url_decode("Zm8=")
    fails = fails + check(ue4 == "" && ud4 == "fo", "b64url decode padded fo")
    ud5, ue5 = encoding.base64url_decode("Zm8")
    fails = fails + check(ue5 == "" && ud5 == "fo", "b64url decode unpadded fo")
    ud6, ue6 = encoding.base64url_decode("")
    fails = fails + check(ue6 == "" && ud6 == "", "b64url decode empty")

    // decode errors: the standard alphabet's `+` `/`, junk, bad lengths
    _, ue7 = encoding.base64url_decode("+/+/")
    fails = fails + check(ue7 != "", "b64url rejects + and /")
    _, ue8 = encoding.base64url_decode("ab+d")
    fails = fails + check(ue8 != "", "b64url rejects +")
    _, ue9 = encoding.base64url_decode("ab/d")
    fails = fails + check(ue9 != "", "b64url rejects /")
    _, ue10 = encoding.base64url_decode("Zm9v!mFy")
    fails = fails + check(ue10 != "", "b64url rejects bad char")
    _, ue11 = encoding.base64url_decode("Z")
    fails = fails + check(ue11 != "", "b64url 1-char group rejected")
    _, ue12 = encoding.base64url_decode("Zm9vY")
    fails = fails + check(ue12 != "", "b64url 5-char input rejected")
    _, ue13 = encoding.base64url_decode("Zg=")
    fails = fails + check(ue13 != "", "b64url short padding rejected")
    _, ue14 = encoding.base64url_decode("Zh==")
    fails = fails + check(ue14 != "", "b64url non-zero trailing bits rejected")
    _, ue15 = encoding.base64url_decode("Zm9v=Zm9v")
    fails = fails + check(ue15 != "", "b64url '=' before data rejected")
    // and the standard decoder rejects the url-safe characters
    _, se1 = encoding.base64_decode("-_-_")
    fails = fails + check(se1 != "", "b64 rejects - and _")
    sd1, se2 = encoding.base64_decode("+/+/")
    fails = fails + check(se2 == "" && string.length(sd1) == 3, "b64 still accepts +/")

    // all 256 byte values, every alphabet/padding combination
    allb = bytes.new(256)
    k = 0
    while k < 256 {
        bytes.set(allb, k, k)
        k = k + 1
    }
    allv = bytes.view(allb)
    for_each_len = 0
    while for_each_len < 5 {
        // prefixes of length 252..256 cover every remainder mod 3
        n = 252 + for_each_len
        sl = allv[0..n]
        r1, re1 = encoding.base64url_decode(encoding.base64url_encode(sl))
        fails = fails + check(re1 == "" && string.length(r1) == n && encoding.hex_encode(string.bytes(r1)[0..n]) == encoding.hex_encode(sl), "b64url round-trip unpadded n=${n}")
        r2, re2 = encoding.base64url_decode(encoding.base64url_encode_padded(sl))
        fails = fails + check(re2 == "" && string.length(r2) == n && encoding.hex_encode(string.bytes(r2)[0..n]) == encoding.hex_encode(sl), "b64url round-trip padded n=${n}")
        r3, re3 = encoding.base64_decode(encoding.base64_encode(sl))
        fails = fails + check(re3 == "" && string.length(r3) == n && encoding.hex_encode(string.bytes(r3)[0..n]) == encoding.hex_encode(sl), "b64 round-trip n=${n}")
        for_each_len = for_each_len + 1
    }
    full = encoding.base64url_encode(allv)
    fails = fails + check(string.index_of(full, "+") < 0 && string.index_of(full, "/") < 0, "b64url output has no + or /")
    fd, fe = encoding.base64url_decode(full)
    fails = fails + check(fe == "" && string.length(fd) == 256, "b64url 256-byte length")
    fails = fails + check(encoding.hex_encode(string.bytes(fd)[0..256]) == encoding.hex_encode(allv), "b64url 256-byte content")
    bytes.free(allb)

    // pseudo-random binary with embedded NULs, lengths 0..299
    seed = 12345
    rl = 0
    while rl < 300 {
        rb = bytes.new(rl + 1)
        q = 0
        while q < rl {
            seed = (seed * 1103515245 + 12345) & 2147483647
            v = (seed >> 8) & 255
            if q % 7 == 3 { v = 0 }
            bytes.set(rb, q, v)
            q = q + 1
        }
        rv = bytes.view(rb)[0..rl]
        want = encoding.hex_encode(rv)
        ru, rue = encoding.base64url_decode(encoding.base64url_encode(rv))
        if rue != "" || string.length(ru) != rl || encoding.hex_encode(string.bytes(ru)[0..rl]) != want {
            fails = fails + check(false, "b64url random round-trip len ${rl}")
        }
        rp, rpe = encoding.base64url_decode(encoding.base64url_encode_padded(rv))
        if rpe != "" || string.length(rp) != rl || encoding.hex_encode(string.bytes(rp)[0..rl]) != want {
            fails = fails + check(false, "b64url random padded round-trip len ${rl}")
        }
        rs, rse = encoding.base64_decode(encoding.base64_encode(rv))
        if rse != "" || string.length(rs) != rl || encoding.hex_encode(string.bytes(rs)[0..rl]) != want {
            fails = fails + check(false, "b64 random round-trip len ${rl}")
        }
        bytes.free(rb)
        rl = rl + 1
    }

    // ---- csv (vectors from c3 encoding/csv test) ----
    // comma-separated
    h1 = encoding.csv_split("aaa,bbb,ccc", ",")
    fails = fails + check(encoding.csv_count(h1) == 3, "csv comma count")
    fails = fails + check(encoding.csv_field(h1, 0) == "aaa", "csv f0")
    fails = fails + check(encoding.csv_field(h1, 2) == "ccc", "csv f2")
    encoding.csv_free(h1)
    // semicolon separator (c3 vector {"aaa;bbb;ccc",";"})
    h2 = encoding.csv_split("aaa;bbb;ccc", ";")
    fails = fails + check(encoding.csv_count(h2) == 3, "csv semicolon count")
    fails = fails + check(encoding.csv_field(h2, 1) == "bbb", "csv semicolon f1")
    encoding.csv_free(h2)
    // whitespace preserved inside fields (c3 vector: "aaa , bbb" -> "aaa ", " bbb")
    h3 = encoding.csv_split("aaa , bbb ,ccc", ",")
    fails = fails + check(encoding.csv_field(h3, 0) == "aaa " && encoding.csv_field(h3, 1) == " bbb ", "csv preserves spaces")
    encoding.csv_free(h3)
    // \r\n line ending: trailing \r trimmed (caller split on \n)
    h4 = encoding.csv_split("111,222,333\r", ",")
    fails = fails + check(encoding.csv_count(h4) == 3 && encoding.csv_field(h4, 2) == "333", "csv strips trailing CR")
    encoding.csv_free(h4)
    // out-of-range field yields ""
    h5 = encoding.csv_split("a,b", ",")
    fails = fails + check(encoding.csv_field(h5, 9) == "", "csv oob empty")
    encoding.csv_free(h5)

    if fails != 0 {
        println("encoding: ${fails} failure(s)")
        exit(1)
    }
    println("PASS: test_encoding")
}
