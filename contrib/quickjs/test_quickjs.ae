// contrib.quickjs tests — co-located with the module.
//
// Each case runs real JavaScript in a real runtime: modern syntax passed
// through untouched, host functions both ways, exceptions with their stack,
// the interrupt (a deadline, cancel and stop cells set from another thread)
// and the memory cap, JSON, a script awaiting a promise Aether
// settles later, and the absence of quickjs-libc. Every case releases what
// it took, and the last checks the runtime holds no handles.
//
// DEPENDENCY: the amalgamation (scripts/fetch-quickjs-amalgamation.sh).

import contrib.quickjs
import std.bytes
import std.mem
import std.spec
import std.string
import std.sync

extern exit(code: int)

// What the `sum_bytes` host function last saw: arg_bytes's count, and the
// sum of the bytes it read through the pointer.
var seen_n_: int = 0
var seen_sum_: int = 0

// The sum of n bytes at p.
sum_at(p: ptr, n: int) -> int {
    t = 0
    i = 0
    while i < n {
        t = t + mem.get_byte(p, i)
        i = i + 1
    }
    return t
}

// A deadline 20 s off, so a case whose cell failed to stop JavaScript fails
// with the wrong reason instead of hanging the run.
guard(q: ptr) { quickjs.set_deadline_ns(q, quickjs.now_ns() + 20000000000) }

// The promise a host function handed a script, for a later case to settle.
var pending_: int = 0

// Set by the `mark` host function once a script is running, for the actor
// that sets a cell from another thread.
var started_: ptr = null

// Waits (on its own scheduler thread) until `started` is set, then records
// the time in `at` and sets `cell`: a cancel or stop from another thread.
// Bounded: after 10 s it sets the cell anyway.
message Arm { started: ptr, cell: ptr, at: ptr }

actor Setter {
    receive {
        Arm(started, cell, at) -> {
            limit = quickjs.now_ns() + 10000000000
            spins = 0
            while sync.atomic_load(started) == 0 && quickjs.now_ns() < limit {
                spins = spins + 1
            }
            sync.atomic_store(at, quickjs.now_ns())
            sync.atomic_store(cell, 1)
        }
    }
}

// Runs `code` (which calls mark()) while another thread sets `cell` once it
// started: the reason interrupted() gives, and how long JS ran on after the
// cell was set, in ns. A 30 s deadline keeps a lost actor from hanging the
// run: it would show as INTERRUPTED_DEADLINE.
stopped_from_another_thread(q: ptr, cell: @keep ptr, code: string) -> (int, long, string) {
    sync.atomic_store(started_, 0)
    sync.atomic_store(cell, 0)
    at = sync.atomic_new(0)
    quickjs.set_deadline_ns(q, quickjs.now_ns() + 30000000000)
    setter = spawn(Setter())
    setter ! Arm { started: started_, cell: cell, at: at }
    _h, err = quickjs.eval(q, code, "spin.js")
    stopped = quickjs.now_ns()
    lag = stopped - sync.atomic_load(at)
    why = quickjs.interrupted(q)
    quickjs.clear_deadline(q)
    quickjs.clear_interrupted(q)
    sync.atomic_free(at)
    return why, lag, err
}

eval_string(q: ptr, code: string) -> string {
    h, err = quickjs.eval(q, code, "test.js")
    if err != "" { return "ERROR: ${err}" }
    s = quickjs.to_string(q, h)
    quickjs.release(q, h)
    return s
}

main() {
    fw = spec.init()
    q = quickjs.runtime(16384, 0)
    if q == null {
        println("cannot make a QuickJS runtime")
        exit(1)
    }

    spec.describe(fw, "contrib.quickjs: running code") {
        spec.it("evaluates and reads back numbers") callback {
            h, err = quickjs.eval(q, "1 + 2", "t.js")
            spec.assert_str_eq(err, "", "no error")
            spec.assert_eq(quickjs.to_int(q, h), 3, "1 + 2")
            spec.assert_str_eq(quickjs.type_of(q, h), "number", "a number")
            quickjs.release(q, h)
        }
        spec.it("runs modern JavaScript as written") callback {
            cls = "class A { #n = 0; inc() { this.#n++; return this } get n() { return this.#n } }\n"
            map = "const m = new Map([['k', [1, 2, 3]]]);\n"
            use = "[new A().inc().inc().n, Math.max(...m.get('k')), ({}).a?.b ?? 'none', [...'ab'].join('-')].join(' ')"
            s = eval_string(q, string.concat(string.concat(cls, map), use))
            spec.assert_str_eq(s, "2 3 none a-b", "private fields, Map, spread, ?., ??")
        }
        spec.it("reports an exception with its kind, message and stack") callback {
            h, err = quickjs.eval(q, "function f() { return null.x }\nf()", "boom.js")
            spec.assert_eq(h, 0, "no value")
            spec.assert_contains(err, "TypeError", "kind")
            spec.assert_contains(err, "boom.js", "where")
        }
    }

    spec.describe(fw, "contrib.quickjs: host functions") {
        spec.it("calls an Aether closure from JS and returns its value") callback {
            add = quickjs.function(q, "add", 2, | q: ptr, this_h: int, args: int | {
                    return quickjs.new_int(q, quickjs.arg_int(q, args, 0) + quickjs.arg_int(q, args, 1))
                })
            quickjs.set_global(q, "add", add)
            quickjs.release(q, add)
            spec.assert_str_eq(eval_string(q, "add(2, 3) * 10"), "50", "add(2, 3) * 10")
            spec.assert_str_eq(eval_string(q, "add.name + '/' + add.length"), "add/2", "named, with its arity")
        }
        spec.it("passes strings both ways") callback {
            shout = quickjs.function(q, "shout", 1, | q: ptr, this_h: int, args: int | {
                    return quickjs.new_string(q, string.concat(quickjs.arg_string(q, args, 0), "!"))
                })
            quickjs.set_global(q, "shout", shout)
            quickjs.release(q, shout)
            spec.assert_str_eq(eval_string(q, "shout('héllo ' + 'wörld')"), "héllo wörld!", "UTF-8 round trip")
        }
        spec.it("a host function's throw is a JS exception the script can catch") callback {
            refuse = quickjs.function(q, "refuse", 1, | q: ptr, this_h: int, args: int | {
                    return quickjs.throw_error(q, "TypeError", "refused: ${quickjs.arg_string(q, args, 0)}")
                })
            quickjs.set_global(q, "refuse", refuse)
            quickjs.release(q, refuse)
            spec.assert_str_eq(eval_string(q, "try { refuse('fs') } catch (e) { e.name + ': ' + e.message }"),
                "TypeError: refused: fs", "caught in JS")
            _h, err = quickjs.eval(q, "refuse('shell')", "t.js")
            spec.assert_contains(err, "TypeError: refused: shell", "or reported to the host")
        }
        spec.it("calls a JS function from Aether") callback {
            f, err = quickjs.eval(q, "(a, b) => a + '-' + b", "t.js")
            spec.assert_str_eq(err, "", "a function")
            args = quickjs.new_array(q)
            x = quickjs.new_string(q, "x")
            _s1 = quickjs.set_index(q, args, 0, x)
            seven = quickjs.new_int(q, 7)
            _s2 = quickjs.set_index(q, args, 1, seven)
            r, cerr = quickjs.call(q, f, 0, args)
            spec.assert_str_eq(cerr, "", "called")
            spec.assert_str_eq(quickjs.to_string(q, r), "x-7", "its result")
            quickjs.release(q, r)
            quickjs.release(q, seven)
            quickjs.release(q, x)
            quickjs.release(q, args)
            quickjs.release(q, f)
        }
    }

    spec.describe(fw, "contrib.quickjs: exceptions through host functions") {
        spec.it("rethrow hands the script the very exception a nested call raised") callback {
            each = quickjs.function(q, "each", 1, | q: ptr, this_h: int, args: int | {
                    f = quickjs.arg(q, args, 0)
                    r, err = quickjs.call(q, f, 0, 0)
                    quickjs.release(q, f)
                    if err != "" { return quickjs.rethrow(q) }
                    quickjs.release(q, r)
                    return 0
                })
            quickjs.set_global(q, "each", each)
            quickjs.release(q, each)
            s = eval_string(q, "function thrower() { throw new RangeError('deep') }\ntry { each(thrower); 'no throw' } catch (e) { [e instanceof RangeError, e.message, e.stack.indexOf('thrower') >= 0].join(' ') }")
            spec.assert_str_eq(s, "true deep true", "type, message and stack intact")
            _h, err = quickjs.eval(q, "each(function () { null.x })", "t.js")
            spec.assert_contains(err, "TypeError", "uncaught, it reaches the host as itself")
        }
        spec.it("with no exception value, rethrow raises an InternalError with the text") callback {
            bad = quickjs.function(q, "bad", 0, | q: ptr, this_h: int, args: int | {
                    notfn = quickjs.new_int(q, 1)
                    _r, err = quickjs.call(q, notfn, 0, 0)
                    quickjs.release(q, notfn)
                    return quickjs.rethrow(q)
                })
            quickjs.set_global(q, "bad", bad)
            quickjs.release(q, bad)
            spec.assert_str_eq(eval_string(q, "try { bad() } catch (e) { e.name + ': ' + e.message }"),
                "InternalError: TypeError: not a function", "the host's own error")
        }
    }

    spec.describe(fw, "contrib.quickjs: limits") {
        spec.it("stops a runaway script at the deadline, and keeps working") callback {
            quickjs.set_deadline_ns(q, quickjs.now_ns() + 50000000)
            _h, err = quickjs.eval(q, "try { for (;;) {} } catch (e) { 'caught' }", "loop.js")
            spec.assert_contains(err, "interrupted", "stopped, and the script could not catch it")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_DEADLINE, "by the deadline")
            quickjs.clear_deadline(q)
            quickjs.clear_interrupted(q)
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_NONE, "cleared")
            spec.assert_str_eq(eval_string(q, "6 * 7"), "42", "the runtime still runs code")
        }
        spec.it("refuses to grow past the memory cap") callback {
            small = quickjs.runtime(1024, 0)
            _h, err = quickjs.eval(small, "const a = []; for (let i = 0; i < 1e7; i++) a.push('x' + i); a.length", "big.js")
            spec.assert_contains(err, "out of memory", "refused")
            quickjs.dispose(small)
        }
        spec.it("gives scripts no file or OS access of their own") callback {
            spec.assert_str_eq(eval_string(q, "[typeof std, typeof os, typeof require, typeof process].join(' ')"),
                "undefined undefined undefined undefined", "no quickjs-libc, no Node")
        }
    }

    spec.describe(fw, "contrib.quickjs: interrupts") {
        started_ = sync.atomic_new(0)
        mark = quickjs.function(q, "mark", 0, | q: ptr, this_h: int, args: int | {
                sync.atomic_store(started_, 1)
                return 0
            })
        quickjs.set_global(q, "mark", mark)
        quickjs.release(q, mark)

        spec.it("a cancel cell set from another thread stops a busy loop at once") callback {
            cancel = sync.atomic_new(0)
            quickjs.set_cancel_cell(q, cancel)
            why, lag, err = stopped_from_another_thread(q, cancel, "mark(); for (;;) {}")
            spec.assert_contains(err, "interrupted", "stopped")
            spec.assert_eq(why, quickjs.INTERRUPTED_CANCEL, "by the cancel")
            spec.assert_true(lag >= 0, "after the cell was set")
            spec.assert_true(lag < 500000000, "within half a second of it (${lag} ns)")
            // Still set: every entry stops, until the host clears the cell.
            guard(q)
            _h2, err2 = quickjs.eval(q, "for (;;) {}", "again.js")
            spec.assert_contains(err2, "interrupted", "a set cell stops the next entry too")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_CANCEL, "the cancel again")
            quickjs.clear_deadline(q)
            sync.atomic_store(cancel, 0)
            quickjs.clear_interrupted(q)
            spec.assert_str_eq(eval_string(q, "'runs'"), "runs", "cleared, the runtime runs code")
            quickjs.set_cancel_cell(q, null)
            sync.atomic_free(cancel)
        }
        spec.it("the deadline is the host's, cumulative across entries") callback {
            // Ten entries of 100 ms against a 350 ms deadline: a limit reset
            // per entry would never fire; this one stops the fourth and holds
            // for every entry after it.
            quickjs.set_deadline_ns(q, quickjs.now_ns() + 350000000)
            first = -1
            stopped = 0
            i = 0
            while i < 10 {
                h, err = quickjs.eval(q, "{ const t0 = Date.now(); while (Date.now() - t0 < 100) {} }", "slice.js")
                quickjs.release(q, h)
                if err != "" {
                    stopped = stopped + 1
                    if first < 0 { first = i }
                }
                i = i + 1
            }
            spec.assert_true(first >= 2 && first <= 4, "stopped in the 3rd to 5th entry (the ${first + 1}th)")
            spec.assert_eq(stopped, 10 - first, "and in every entry after it")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_DEADLINE, "by the deadline")
            spec.assert_true(quickjs.deadline_ns(q) != 0, "which stays set")
            quickjs.clear_deadline(q)
            quickjs.clear_interrupted(q)
            spec.assert_eq(quickjs.deadline_ns(q), 0, "until cleared")
            spec.assert_str_eq(eval_string(q, "'runs'"), "runs", "after which entries run")
        }
        spec.it("a deadline in the past stops the next entry, an eval or a call") callback {
            f, _fe = quickjs.eval(q, "() => { for (;;) {} }", "f.js")
            quickjs.set_deadline_ns(q, quickjs.now_ns() - 1)
            _r, cerr = quickjs.call(q, f, 0, 0)
            spec.assert_contains(cerr, "interrupted", "a call is stopped")
            n, jerr = quickjs.run_jobs(q)
            spec.assert_eq(n, 0, "run_jobs with nothing queued runs nothing")
            spec.assert_str_eq(jerr, "", "and is not an error")
            quickjs.clear_deadline(q)
            quickjs.clear_interrupted(q)
            quickjs.release(q, f)
        }
        spec.it("conversions that run JavaScript are stopped too: toString, valueOf, a getter") callback {
            o, _oe = quickjs.eval(q, "({ toString() { for (;;) {} }, valueOf() { for (;;) {} }, get x() { for (;;) {} } })", "o.js")
            quickjs.set_deadline_ns(q, quickjs.now_ns() + 50000000)
            s = quickjs.to_string(q, o)
            spec.assert_str_eq(s, "", "no string")
            spec.assert_contains(quickjs.last_error(q), "interrupted", "a looping toString is stopped")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_DEADLINE, "by the deadline")
            quickjs.clear_deadline(q)
            quickjs.clear_interrupted(q)
            cancel = sync.atomic_new(1)
            quickjs.set_cancel_cell(q, cancel)
            guard(q)
            _n = quickjs.to_int(q, o)
            spec.assert_contains(quickjs.last_error(q), "interrupted", "a looping valueOf is stopped")
            _x, gerr = quickjs.get(q, o, "x")
            spec.assert_contains(gerr, "interrupted", "a looping getter is stopped")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_CANCEL, "by the cancel")
            quickjs.clear_deadline(q)
            quickjs.set_cancel_cell(q, null)
            sync.atomic_free(cancel)
            quickjs.clear_interrupted(q)
            quickjs.release(q, o)
        }
        spec.it("a stop cell is reported apart from a cancel") callback {
            stop = sync.atomic_new(0)
            quickjs.set_stop_cell(q, stop)
            why, lag, err = stopped_from_another_thread(q, stop, "mark(); for (;;) {}")
            spec.assert_contains(err, "interrupted", "stopped")
            spec.assert_eq(why, quickjs.INTERRUPTED_STOP, "by the stop, not a cancel")
            spec.assert_true(lag < 500000000, "within half a second (${lag} ns)")
            // Both set: the cancel is the one reported.
            sync.atomic_store(stop, 1)
            cancel = sync.atomic_new(1)
            quickjs.set_cancel_cell(q, cancel)
            guard(q)
            _h, err2 = quickjs.eval(q, "for (;;) {}", "both.js")
            spec.assert_contains(err2, "interrupted", "stopped")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_CANCEL, "a cancel over a stop")
            quickjs.clear_deadline(q)
            quickjs.set_cancel_cell(q, null)
            quickjs.set_stop_cell(q, null)
            quickjs.clear_interrupted(q)
            spec.assert_str_eq(eval_string(q, "'runs'"), "runs", "with the cells unset, entries run")
            sync.atomic_free(cancel)
            sync.atomic_free(stop)
        }
        spec.it("the first reason stays while the host reads what happened") callback {
            quickjs.set_deadline_ns(q, quickjs.now_ns() - 1)
            _h, err = quickjs.eval(q, "for (;;) {}", "d.js")
            spec.assert_contains(err, "interrupted", "stopped")
            quickjs.clear_deadline(q)
            stop = sync.atomic_new(1)
            quickjs.set_stop_cell(q, stop)
            guard(q)
            _h2, err2 = quickjs.eval(q, "for (;;) {}", "s.js")
            quickjs.clear_deadline(q)
            spec.assert_contains(err2, "interrupted", "stopped again, by the stop cell")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_DEADLINE, "the first reason, not the latest")
            quickjs.set_stop_cell(q, null)
            sync.atomic_free(stop)
            quickjs.clear_interrupted(q)
        }
        spec.it("an async eval: interrupted before its first await is an error, after it run_jobs fails") callback {
            quickjs.set_deadline_ns(q, quickjs.now_ns() - 1)
            p, err = quickjs.eval_async(q, "for (;;) {}", "a.js")
            spec.assert_eq(p, 0, "no promise")
            spec.assert_contains(err, "interrupted", "the interrupt")
            quickjs.clear_deadline(q)
            quickjs.clear_interrupted(q)
            p2, err2 = quickjs.eval_async(q, "await 0; for (;;) {}", "b.js")
            spec.assert_str_eq(err2, "", "started")
            quickjs.set_deadline_ns(q, quickjs.now_ns() + 50000000)
            n, jerr = quickjs.run_jobs(q)
            spec.assert_eq(n, -1, "run_jobs fails")
            spec.assert_contains(jerr, "interrupted", "with the interrupt")
            spec.assert_eq(quickjs.interrupted(q), quickjs.INTERRUPTED_DEADLINE, "the deadline's")
            spec.assert_eq(quickjs.promise_state(q, p2), quickjs.PROMISE_PENDING, "and the promise is not rejected: it stays pending")
            quickjs.clear_deadline(q)
            quickjs.clear_interrupted(q)
            quickjs.release(q, p2)
        }
        spec.it("a fresh runtime has no deadline, no cells and no reason") callback {
            r = quickjs.runtime(0, 0)
            spec.assert_eq(quickjs.deadline_ns(r), 0, "no deadline")
            spec.assert_eq(quickjs.interrupted(r), quickjs.INTERRUPTED_NONE, "no reason")
            h, err = quickjs.eval(r, "let n = 0; for (let i = 0; i < 1e6; i++) n += i; n", "n.js")
            spec.assert_str_eq(err, "", "runs to the end")
            quickjs.release(r, h)
            quickjs.dispose(r)
            spec.assert_true(quickjs.now_ns() > 0, "the clock runs")
        }
        _d = eval_string(q, "delete globalThis.mark")
    }

    spec.describe(fw, "contrib.quickjs: data") {
        spec.it("round-trips JSON and reads properties") callback {
            o, err = quickjs.parse_json(q, "{\"name\":\"ana\",\"tags\":[\"a\",\"b\"]}")
            spec.assert_str_eq(err, "", "parsed")
            name, _e1 = quickjs.get(q, o, "name")
            spec.assert_str_eq(quickjs.to_string(q, name), "ana", "a property")
            tags, _e2 = quickjs.get(q, o, "tags")
            spec.assert_eq(quickjs.length(q, tags), 2, "an array's length")
            spec.assert_str_eq(quickjs.type_of(q, tags), "array", "an array")
            ks = quickjs.keys(q, o)
            spec.assert_str_eq(quickjs.to_json(q, ks), "[\"name\",\"tags\"]", "its keys")
            spec.assert_str_eq(quickjs.to_json(q, o), "{\"name\":\"ana\",\"tags\":[\"a\",\"b\"]}", "back to JSON")
            _b, bad = quickjs.parse_json(q, "{nope")
            spec.assert_contains(bad, "SyntaxError", "bad JSON refused")
            quickjs.release(q, ks)
            quickjs.release(q, tags)
            quickjs.release(q, name)
            quickjs.release(q, o)
        }
    }

    spec.describe(fw, "contrib.quickjs: promises") {
        spec.it("a script awaits a promise Aether settles later") callback {
            later = quickjs.function(q, "later", 0, | q: ptr, this_h: int, args: int | {
                    pending_ = quickjs.new_promise(q)
                    p, _e = quickjs.get(q, pending_, "promise")
                    return p
                })
            quickjs.set_global(q, "later", later)
            quickjs.release(q, later)
            h, err = quickjs.eval(q, "globalThis.got = 'waiting'; (async () => { globalThis.got = (await later()) * 2 })(); got", "t.js")
            spec.assert_str_eq(err, "", "started")
            spec.assert_str_eq(quickjs.to_string(q, h), "waiting", "still waiting")
            quickjs.release(q, h)
            // The answer arrives (from an actor, say): resolve, then run the jobs.
            resolve, _e2 = quickjs.get(q, pending_, "resolve")
            args = quickjs.new_array(q)
            v = quickjs.new_int(q, 21)
            _s = quickjs.set_index(q, args, 0, v)
            r, cerr = quickjs.call(q, resolve, 0, args)
            spec.assert_str_eq(cerr, "", "resolved")
            n, jerr = quickjs.run_jobs(q)
            spec.assert_str_eq(jerr, "", "jobs ran")
            spec.assert_true(n > 0, "some jobs ran")
            spec.assert_str_eq(eval_string(q, "got"), "42", "the await carried on")
            quickjs.release(q, r)
            quickjs.release(q, v)
            quickjs.release(q, args)
            quickjs.release(q, resolve)
            quickjs.release(q, pending_)
        }
    }

    spec.describe(fw, "contrib.quickjs: promise state") {
        spec.it("reads a fulfilled promise's state and value") callback {
            p, err = quickjs.eval(q, "Promise.resolve(7)", "p.js")
            spec.assert_str_eq(err, "", "no error")
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_FULFILLED, "fulfilled")
            v, verr = quickjs.promise_result(q, p)
            spec.assert_str_eq(verr, "", "a result")
            spec.assert_eq(quickjs.to_int(q, v), 7, "its value")
            quickjs.release(q, v)
            quickjs.release(q, p)
        }
        spec.it("reads a rejected promise's state and the reason it holds") callback {
            p, err = quickjs.eval(q, "const r = Promise.reject(new RangeError('no')); r.catch(() => {}); r", "r.js")
            spec.assert_str_eq(err, "", "no error")
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_REJECTED, "rejected")
            e, eerr = quickjs.promise_result(q, p)
            spec.assert_str_eq(eerr, "", "a result")
            spec.assert_str_eq(quickjs.type_of(q, e), "error", "the reason is the error")
            m, _me = quickjs.get(q, e, "message")
            spec.assert_eq(quickjs.length(q, m), 2, "its message, 'no'")
            quickjs.release(q, m)
            quickjs.release(q, e)
            quickjs.release(q, p)
        }
        spec.it("a pending promise has no result until the jobs that settle it run") callback {
            p, err = quickjs.eval(q, "Promise.resolve(1).then(v => v + 41)", "t.js")
            spec.assert_str_eq(err, "", "no error")
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_PENDING, "pending before the jobs run")
            nothing, perr = quickjs.promise_result(q, p)
            spec.assert_eq(nothing, 0, "no handle")
            spec.assert_contains(perr, "pending", "refused while pending")
            _n, jerr = quickjs.run_jobs(q)
            spec.assert_str_eq(jerr, "", "jobs ran")
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_FULFILLED, "fulfilled after")
            v, _ve = quickjs.promise_result(q, p)
            spec.assert_eq(quickjs.to_int(q, v), 42, "and holds the value")
            quickjs.release(q, v)
            forever, _fe = quickjs.eval(q, "new Promise(() => {})", "f.js")
            spec.assert_eq(quickjs.promise_state(q, forever), quickjs.PROMISE_PENDING, "a promise nothing settles stays pending")
            quickjs.release(q, forever)
            quickjs.release(q, p)
        }
        spec.it("says what is not a promise") callback {
            n, _e = quickjs.eval(q, "({ then() {} })", "n.js")
            spec.assert_eq(quickjs.promise_state(q, n), quickjs.PROMISE_NOT_A_PROMISE, "a thenable is not a promise")
            nothing, err = quickjs.promise_result(q, n)
            spec.assert_eq(nothing, 0, "no handle")
            spec.assert_contains(err, "not a promise", "refused")
            quickjs.release(q, n)
            spec.assert_eq(quickjs.promise_state(q, 0), quickjs.PROMISE_NOT_A_PROMISE, "handle 0 (undefined) is not one")
            spec.assert_eq(quickjs.promise_state(q, 999999), quickjs.PROMISE_NOT_A_PROMISE, "nor is a handle never given out")
        }
    }

    spec.describe(fw, "contrib.quickjs: async global eval") {
        spec.it("awaits at top level and keeps the script's completion value") callback {
            // Neither eval (a SyntaxError) nor eval_module (no completion
            // value) can run this and give back the 42.
            _h, serr = quickjs.eval(q, "const x = await Promise.resolve(2); x * 21", "run.js")
            spec.assert_contains(serr, "SyntaxError", "plain eval refuses top-level await")
            p, err = quickjs.eval_async(q, "const x = await Promise.resolve(2); x * 21", "run.js")
            spec.assert_str_eq(err, "", "started")
            spec.assert_str_eq(quickjs.type_of(q, p), "promise", "a promise")
            _n, jerr = quickjs.run_jobs(q)
            spec.assert_str_eq(jerr, "", "jobs ran")
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_FULFILLED, "fulfilled")
            r, rerr = quickjs.promise_result(q, p)
            spec.assert_str_eq(rerr, "", "a result")
            v, verr = quickjs.get(q, r, "value")
            spec.assert_str_eq(verr, "", "it has a value")
            spec.assert_eq(quickjs.to_int(q, v), 42, "the completion value, 42")
            quickjs.release(q, v)
            quickjs.release(q, r)
            quickjs.release(q, p)
        }
        spec.it("waits on a promise the host settles, then completes") callback {
            later = quickjs.function(q, "later2", 0, | q: ptr, this_h: int, args: int | {
                    pending_ = quickjs.new_promise(q)
                    lp, _e = quickjs.get(q, pending_, "promise")
                    return lp
                })
            quickjs.set_global(q, "later2", later)
            quickjs.release(q, later)
            p, err = quickjs.eval_async(q, "const a = await later2(); const b = 'got ' + a; b", "w.js")
            spec.assert_str_eq(err, "", "started")
            _n0, _j0 = quickjs.run_jobs(q)
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_PENDING, "pending while the host has not answered")
            resolve, _e2 = quickjs.get(q, pending_, "resolve")
            args = quickjs.new_array(q)
            s = quickjs.new_string(q, "it")
            _s = quickjs.set_index(q, args, 0, s)
            rr, _ce = quickjs.call(q, resolve, 0, args)
            _n1, _j1 = quickjs.run_jobs(q)
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_FULFILLED, "fulfilled once answered")
            r, _re = quickjs.promise_result(q, p)
            v, _ve = quickjs.get(q, r, "value")
            spec.assert_eq(quickjs.length(q, v), 6, "'got it'")
            quickjs.release(q, v)
            quickjs.release(q, r)
            quickjs.release(q, rr)
            quickjs.release(q, s)
            quickjs.release(q, args)
            quickjs.release(q, resolve)
            quickjs.release(q, pending_)
            quickjs.release(q, p)
            _d = eval_string(q, "delete globalThis.later2")
        }
        spec.it("a throw, before or after an await, rejects the promise") callback {
            p, err = quickjs.eval_async(q, "null.x", "early.js")
            spec.assert_str_eq(err, "", "not an exception: a rejection")
            _n, _j = quickjs.run_jobs(q)
            spec.assert_eq(quickjs.promise_state(q, p), quickjs.PROMISE_REJECTED, "rejected")
            e, _ee = quickjs.promise_result(q, p)
            spec.assert_str_eq(quickjs.type_of(q, e), "error", "with the TypeError")
            quickjs.release(q, e)
            quickjs.release(q, p)
            p2, err2 = quickjs.eval_async(q, "await 1; throw new RangeError('late')", "late.js")
            spec.assert_str_eq(err2, "", "started")
            _n2, _j2 = quickjs.run_jobs(q)
            spec.assert_eq(quickjs.promise_state(q, p2), quickjs.PROMISE_REJECTED, "rejected after the await")
            quickjs.release(q, p2)
        }
        spec.it("a script that does not parse is an error, not a promise") callback {
            p, err = quickjs.eval_async(q, "const = ;", "bad.js")
            spec.assert_eq(p, 0, "no handle")
            spec.assert_contains(err, "SyntaxError", "the parse error")
        }
    }

    spec.describe(fw, "contrib.quickjs: bytes") {
        spec.it("bytes_of reads a Uint8Array's own window of its buffer") callback {
            h, err = quickjs.eval(q, "new Uint8Array([9, 1, 2, 250]).subarray(1)", "b.js")
            spec.assert_str_eq(err, "", "no error")
            p, n = quickjs.bytes_of(q, h)
            spec.assert_eq(n, 3, "three bytes: the view, not the buffer")
            spec.assert_not_null(p, "a pointer")
            spec.assert_eq(mem.get_byte(p, 0), 1, "starts at the view's offset")
            spec.assert_eq(mem.get_byte(p, 2), 250, "bytes are unsigned")
            quickjs.release(q, h)
            c, cerr = quickjs.eval(q, "Uint8ClampedArray.of(7, 300)", "c.js")
            spec.assert_str_eq(cerr, "", "no error")
            cp, cn = quickjs.bytes_of(q, c)
            spec.assert_eq(cn, 2, "a Uint8ClampedArray is bytes too")
            spec.assert_eq(mem.get_byte(cp, 1), 255, "clamped as JS stored it")
            quickjs.release(q, c)
            e, eerr = quickjs.eval(q, "new Uint8Array(0)", "e.js")
            spec.assert_str_eq(eerr, "", "no error")
            ep, en = quickjs.bytes_of(q, e)
            spec.assert_eq(en, 0, "an empty array has no bytes")
            spec.assert_not_null(ep, "and is still one (not null, -1)")
            quickjs.release(q, e)
        }
        spec.it("bytes_of refuses what is not bytes, leaving no exception behind") callback {
            for_each = "[new Uint16Array(2), [1, 2], 'ab', new ArrayBuffer(4), 5]"
            arr, err = quickjs.eval(q, for_each, "n.js")
            spec.assert_str_eq(err, "", "no error")
            i = 0
            while i < 5 {
                v, _e = quickjs.get_index(q, arr, i)
                p, n = quickjs.bytes_of(q, v)
                spec.assert_eq(n, -1, "element ${i} is not a Uint8Array")
                spec.assert_null(p, "and has no pointer")
                quickjs.release(q, v)
                i = i + 1
            }
            quickjs.release(q, arr)
            d, derr = quickjs.eval(q, "globalThis.det = new Uint8Array(new ArrayBuffer(8)); det.buffer.transfer(); det", "d.js")
            spec.assert_str_eq(derr, "", "a view of a detached buffer")
            _dp, dn = quickjs.bytes_of(q, d)
            spec.assert_eq(dn, -1, "a detached buffer has no bytes")
            quickjs.release(q, d)
            spec.assert_str_eq(eval_string(q, "1 + 1"), "2", "no exception was left pending")
            _np, nn = quickjs.bytes_of(q, 0)
            spec.assert_eq(nn, -1, "handle 0 (undefined) is not one")
        }
        spec.it("arg_bytes reads a host function's Uint8Array argument in one call") callback {
            f = quickjs.function(q, "sum_bytes", 1, | q: ptr, this_h: int, args: int | {
                    p, n = quickjs.arg_bytes(q, args, 0)
                    seen_n_ = n
                    if n < 0 { return quickjs.throw_error(q, "TypeError", "not bytes") }
                    seen_sum_ = sum_at(p, n)
                    return quickjs.new_int(q, seen_sum_)
                })
            quickjs.set_global(q, "sum_bytes", f)
            quickjs.release(q, f)
            s = eval_string(q, "const big = new Uint8Array(65536); for (let i = 0; i < big.length; i++) big[i] = i & 255; sum_bytes(big)")
            spec.assert_eq(seen_n_, 65536, "all 65536 bytes, one call")
            spec.assert_str_eq(s, "8355840", "and the sum the script would compute")
            t = eval_string(q, "try { sum_bytes('nope') } catch (e) { e.message }")
            spec.assert_eq(seen_n_, -1, "a string is not bytes")
            spec.assert_str_eq(t, "not bytes", "the host function can say so")
            // A refusal leaves no exception pending: a host function that
            // then fails without throwing is reported as exactly that, not
            // as an error the engine raised while being asked.
            g = quickjs.function(q, "peek_bytes", 1, | q: ptr, this_h: int, args: int | {
                    _p, _n = quickjs.arg_bytes(q, args, 0)
                    return -1
                })
            quickjs.set_global(q, "peek_bytes", g)
            quickjs.release(q, g)
            u = eval_string(q, "const gone = new Uint8Array(new ArrayBuffer(8)); gone.buffer.transfer(); try { peek_bytes(gone) } catch (e) { e.message }")
            spec.assert_str_eq(u, "host function failed without throwing", "nothing stale surfaces: ${u}")
        }
        spec.it("new_uint8array hands a script a copy of the host's bytes") callback {
            b = bytes.new(4)
            _s0 = bytes.set(b, 0, 0)
            _s1 = bytes.set(b, 1, 128)
            _s2 = bytes.set(b, 2, 255)
            _s3 = bytes.set(b, 3, 7)
            h = quickjs.new_uint8array(q, bytes.data(b), bytes.length(b))
            bytes.free(b)
            spec.assert_true(h > 0, "a handle")
            quickjs.set_global(q, "fromHost", h)
            spec.assert_str_eq(eval_string(q, "fromHost instanceof Uint8Array && fromHost.join(',')"), "0,128,255,7",
                "a Uint8Array with the bytes, after the host's buffer was freed")
            p, n = quickjs.bytes_of(q, h)
            spec.assert_eq(n, 4, "and reads back")
            spec.assert_eq(mem.get_byte(p, 2), 255, "byte for byte")
            quickjs.release(q, h)
            z = quickjs.new_uint8array(q, null, 0)
            spec.assert_str_eq(quickjs.type_of(q, z), "object", "an empty one from nothing")
            quickjs.release(q, z)
            spec.assert_eq(quickjs.new_uint8array(q, null, 3), -1, "null data with a count is refused")
            spec.assert_eq(quickjs.new_uint8array(q, null, -1), -1, "so is a negative count")
            _g = eval_string(q, "delete globalThis.fromHost; delete globalThis.det; delete globalThis.sum_bytes; delete globalThis.peek_bytes")
        }
    }

    spec.describe(fw, "contrib.quickjs: bookkeeping") {
        spec.it("holds no handles once every case released what it took") callback {
            spec.assert_eq(quickjs.handles(q), 0, "no handles")
            spec.assert_true(quickjs.memory_used(q) > 0, "memory is accounted")
        }
    }

    quickjs.dispose(q)
    exit(spec.run_summary(fw))
}
