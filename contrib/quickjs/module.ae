// contrib.quickjs — QuickJS (quickjs-ng), embedded: modern JavaScript
// (ES2023: classes, async/await, Map/Set, ?., ??, modules) run inside an
// Aether program, with a host-controlled interrupt (a deadline, cancel and
// stop cells) and a memory cap.
// Import with: import contrib.quickjs
//
//   import contrib.quickjs
//
//   main() {
//       q = quickjs.runtime(8192, 0)          // 8 MB heap cap, default stack
//       quickjs.set_deadline_ns(q, quickjs.now_ns() + 100000000)   // stop JS 100 ms from now
//       add = quickjs.function(q, "add", 2, |q: ptr, this_h: int, args: int| {
//           return quickjs.new_int(q, quickjs.arg_int(q, args, 0) + quickjs.arg_int(q, args, 1))
//       })
//       quickjs.set_global(q, "add", add)
//       quickjs.release(q, add)
//       v, err = quickjs.eval(q, "add(2, 3) * 10", "demo.js")
//       if err != "" { println(err); return }
//       println(quickjs.to_int(q, v))         // 50
//       quickjs.release(q, v)
//       quickjs.dispose(q)
//   }
//
// Values are HANDLES (ints): every function that returns one hands the
// caller a reference to release with quickjs.release (or that a host
// function returns, which hands it to the engine). quickjs.handles(q) is 0
// when everything taken has been released. A JSValue never crosses into
// Aether: on 64-bit it is a 16-byte struct (aether_quickjs.c has why).
//
// A script reaches only what the host gives it: quickjs-libc (the engine's
// own file and OS modules) is not compiled in. Host functions are Aether
// closures, |q: ptr, this_h: int, args: int| (returning int), where args is an array
// of the arguments (the arg_* helpers read it without leaving handles
// behind); they return a handle, 0 for undefined, or quickjs.throw_error(...).
//
// The engine is quickjs-ng's amalgamation, pinned in amalgamation.lock and
// fetched by scripts/fetch-quickjs-amalgamation.sh (release archives ship
// it). README.md has the details.

import std.string

@source("aether_quickjs.c")
@link("-lm")

exports(
    runtime, dispose, last_error, handles, memory_used,
    now_ns, set_deadline_ns, clear_deadline, deadline_ns, set_cancel_cell, set_stop_cell,
    interrupted, clear_interrupted,
    INTERRUPTED_NONE, INTERRUPTED_DEADLINE, INTERRUPTED_CANCEL, INTERRUPTED_STOP,
    eval, eval_async, eval_module, call, run_jobs,
    function, throw_error, rethrow, set_global, get_global,
    release, dup, global, new_undefined, new_null, new_bool, new_int, new_float, new_string, new_object, new_array,
    parse_json, to_json, to_string, to_int, to_float, to_bool, type_of,
    get, set, get_index, set_index, length, keys,
    arg, arg_int, arg_float, arg_string, arg_bool, arg_count,
    new_promise, promise_state, promise_result,
    PROMISE_NOT_A_PROMISE, PROMISE_PENDING, PROMISE_FULFILLED, PROMISE_REJECTED,
    bytes_of, arg_bytes, new_uint8array
)

extern qjs_new(memory_kb: int, stack_kb: int) -> ptr
extern qjs_free(q: ptr)
extern qjs_now_ns() -> long
extern qjs_set_deadline_ns(q: ptr, ns: long)
extern qjs_deadline_ns(q: ptr) -> long
extern qjs_set_cancel_cell(q: ptr, cell: ptr)
extern qjs_set_stop_cell(q: ptr, cell: ptr)
extern qjs_interrupted(q: ptr) -> int
extern qjs_clear_interrupted(q: ptr)
extern qjs_error(q: ptr) -> string
extern qjs_handles(q: ptr) -> int
extern qjs_memory_used(q: ptr) -> long
extern qjs_eval(q: ptr, code: string, filename: string, flags: int) -> int
extern qjs_call(q: ptr, f: int, this_h: int, args: int) -> int
extern qjs_run_jobs(q: ptr) -> int
extern qjs_function(q: ptr, name: string, arity: int, cb: @retain fn(@keep ptr, int, int) -> int) -> int
extern qjs_throw(q: ptr, kind: string, msg: string) -> int
extern qjs_rethrow(q: ptr) -> int
extern qjs_release(q: ptr, h: int)
extern qjs_dup(q: ptr, h: int) -> int
extern qjs_global(q: ptr) -> int
extern qjs_undefined(q: ptr) -> int
extern qjs_null(q: ptr) -> int
extern qjs_bool(q: ptr, b: int) -> int
extern qjs_int(q: ptr, n: int) -> int
extern qjs_float(q: ptr, d: float) -> int
extern qjs_string(q: ptr, s: string) -> int
extern qjs_object(q: ptr) -> int
extern qjs_array(q: ptr) -> int
extern qjs_parse_json(q: ptr, text: string) -> int
extern qjs_to_json(q: ptr, h: int) -> string
extern qjs_to_string(q: ptr, h: int) -> string
extern qjs_to_int(q: ptr, h: int) -> int
extern qjs_to_float(q: ptr, h: int) -> float
extern qjs_to_bool(q: ptr, h: int) -> int
extern qjs_type(q: ptr, h: int) -> string
extern qjs_get(q: ptr, obj: int, name: string) -> int
extern qjs_set(q: ptr, obj: int, name: string, v: int) -> int
extern qjs_get_index(q: ptr, obj: int, i: int) -> int
extern qjs_set_index(q: ptr, obj: int, i: int, v: int) -> int
extern qjs_length(q: ptr, obj: int) -> int
extern qjs_keys(q: ptr, obj: int) -> int
extern qjs_new_promise(q: ptr) -> int
extern qjs_promise_state(q: ptr, h: int) -> int
extern qjs_promise_result(q: ptr, h: int) -> int
extern qjs_u8_length(q: ptr, h: int) -> int
extern qjs_u8_data(q: ptr, h: int) -> ptr
extern qjs_new_uint8array(q: ptr, data: ptr, n: int) -> int

// ---- runtimes ----

// A runtime with one context. memory_kb caps the heap (0: no cap);
// stack_kb caps the JS stack (0: QuickJS's default). null if it cannot be
// made.
runtime(memory_kb: int, stack_kb: int) -> ptr { return qjs_new(memory_kb, stack_kb) }

// Frees the runtime, every handle still held, and the host closures.
dispose(q: ptr) { qjs_free(q) }

// ---- interrupting JavaScript ----
//
// The host decides when JavaScript stops, per runtime: a deadline it sets and
// moves itself, and two std.sync cells any thread may set. Running JS that
// meets one is stopped with "InternalError: interrupted", which a script
// cannot catch, whatever entered it: an eval, a call, run_jobs, or a
// conversion that runs a getter, valueOf or toString (to_string, to_int,
// get, ...). The runtime stays usable. QuickJS checks every few thousand
// operations, so a busy loop stops within microseconds of a cell being set;
// a single long native call (a huge regexp, say) is not interrupted midway.
//
// Threads: the cells may be set from any thread (Esc, SIGINT, a watchdog);
// they are read with an acquire load. Everything else here, the deadline
// included, belongs to the thread that runs the runtime.

// What interrupted() says stopped JavaScript.
const INTERRUPTED_NONE = 0
const INTERRUPTED_DEADLINE = 1
const INTERRUPTED_CANCEL = 2
const INTERRUPTED_STOP = 3

// Monotonic nanoseconds, the clock set_deadline_ns is on: the same clock as
// std.os's now_monotonic_ns (CLOCK_MONOTONIC; QueryPerformanceCounter on
// Windows), without importing std.os.
now_ns() -> long { return qjs_now_ns() }

// Stop JavaScript that runs at or after `ns` (on now_ns's clock): in this
// entry and in every later one, until the host moves or clears it. It is not
// reset per entry, so a budget of JS time across many entries is the host
// setting `now_ns() + remaining` when JS starts running and taking the time
// spent off `remaining` when it stops (clear_deadline while it waits on
// something else). 0 means no deadline.
set_deadline_ns(q: ptr, ns: long) { qjs_set_deadline_ns(q, ns) }

// No deadline (as set_deadline_ns(q, 0)).
clear_deadline(q: ptr) { qjs_set_deadline_ns(q, 0) }

// The deadline set now, 0 for none.
deadline_ns(q: ptr) -> long { return qjs_deadline_ns(q) }

// A std.sync cell (sync.atomic_new) whose nonzero value stops JavaScript: a
// cancel (Esc, SIGINT). null for none. The cell stays the host's: free it
// after dispose, or after setting null here.
set_cancel_cell(q: ptr, cell: ptr) { qjs_set_cancel_cell(q, cell) }

// A second cell that stops JavaScript, reported as INTERRUPTED_STOP rather
// than a cancel (a replay that diverged from its recording, say, whose
// outcome is what the script threw, not "canceled"). Owned as the cancel
// cell is.
set_stop_cell(q: ptr, cell: ptr) { qjs_set_stop_cell(q, cell) }

// Why JavaScript was first stopped since the runtime was made or
// clear_interrupted: INTERRUPTED_NONE (0), INTERRUPTED_DEADLINE (1),
// INTERRUPTED_CANCEL (2) or INTERRUPTED_STOP (3). When several hold at once
// a cancel is reported over a deadline, and both over a stop. It stays put
// while the host reads errors and values afterwards.
interrupted(q: ptr) -> int { return qjs_interrupted(q) }

// Forget the reason, before reusing the runtime for the next piece of work.
clear_interrupted(q: ptr) { qjs_clear_interrupted(q) }

// The text of the last exception, with its stack.
last_error(q: ptr) -> string { return string.copy(qjs_error(q)) }

// Handles held now (0 when everything taken was released).
handles(q: ptr) -> int { return qjs_handles(q) }

// Bytes the runtime has allocated.
memory_used(q: ptr) -> long { return qjs_memory_used(q) }

// ---- running code ----

// Run a script; (its value, "") or (0, the exception's text).
eval(q: ptr, code: string, filename: string) -> (int, string) {
    h = qjs_eval(q, code, filename, 0)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// Run a script that may `await` at top level, and keep its completion value
// (what `eval` would give): (a promise, "") or (0, the exception's text) for
// a script that does not parse or is interrupted before its first await. The
// promise settles, as run_jobs runs what
// the awaits queued, to an object { value: <the completion value> }, or is
// rejected with what the script threw, so a throw before the first await is a
// rejected promise too. An interrupt is never a rejection: after the first
// await, run_jobs reports it and the promise stays pending. promise_state and promise_result read it:
//
//   p, err = quickjs.eval_async(q, "const x = await Promise.resolve(2); x * 21", "run.js")
//   _n, _e = quickjs.run_jobs(q)
//   if quickjs.promise_state(q, p) == quickjs.PROMISE_FULFILLED {
//       r, _e2 = quickjs.promise_result(q, p)     // { value: 42 }
//       v, _e3 = quickjs.get(q, r, "value")
//   }
eval_async(q: ptr, code: string, filename: string) -> (int, string) {
    h = qjs_eval(q, code, filename, 4)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// Run a module (import/export, top-level await); its value is a promise
// (a module has no completion value: eval_async keeps a script's).
eval_module(q: ptr, code: string, filename: string) -> (int, string) {
    h = qjs_eval(q, code, filename, 1)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// Call f with this_h (0: undefined) and the elements of array args (0: none).
call(q: ptr, f: int, this_h: int, args: int) -> (int, string) {
    h = qjs_call(q, f, this_h, args)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// Run the promise jobs that await and .then() queued, until none are left:
// (number run, "") or (-1, the exception's text). Call it after anything
// that may settle a promise (a host callback, a resolve).
run_jobs(q: ptr) -> (int, string) {
    n = qjs_run_jobs(q)
    if n < 0 { return -1, string.copy(qjs_error(q)) }
    return n, ""
}

// ---- host functions ----

// A JS function that calls cb(q, this_h, args), where args is an array of
// its arguments. cb returns a handle (the engine takes it), 0 for undefined,
// or quickjs.throw_error(...). cb's q is `@keep ptr`: the engine outlives the
// call, so a callback may keep q (a registry, a widget callback). cb is typed,
// so a plain `fn` or a function taking a borrowed ptr is refused (E0902).
function(q: ptr, name: string, arity: int, cb: @keep fn(@keep ptr, int, int) -> int) -> int { return qjs_function(q, name, arity, cb) }

// Throw from a host function: `return quickjs.throw_error(q, "TypeError", "...")`.
// kind: "TypeError", "RangeError", "SyntaxError", "ReferenceError" or "Error".
throw_error(q: ptr, kind: string, msg: string) -> int { return qjs_throw(q, kind, msg) }

// Throw again, from a host function, the exception a nested call or eval
// just failed with: the same value, so its type, message and stack reach
// the script intact. `return quickjs.rethrow(q)`.
rethrow(q: ptr) -> int { return qjs_rethrow(q) }

// globalThis[name] = v; v stays held by its handle.
set_global(q: ptr, name: string, v: int) {
    g = qjs_global(q)
    _r = qjs_set(q, g, name, v)
    qjs_release(q, g)
}

// globalThis[name]: (handle, "") or (0, error).
get_global(q: ptr, name: string) -> (int, string) {
    g = qjs_global(q)
    h = qjs_get(q, g, name)
    qjs_release(q, g)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// ---- values ----

release(q: ptr, h: int) { qjs_release(q, h) }
dup(q: ptr, h: int) -> int { return qjs_dup(q, h) }
global(q: ptr) -> int { return qjs_global(q) }
new_undefined(q: ptr) -> int { return qjs_undefined(q) }
new_null(q: ptr) -> int { return qjs_null(q) }
new_bool(q: ptr, b: int) -> int { return qjs_bool(q, b) }
new_int(q: ptr, n: int) -> int { return qjs_int(q, n) }
new_float(q: ptr, d: float) -> int { return qjs_float(q, d) }
new_string(q: ptr, s: string) -> int { return qjs_string(q, s) }
new_object(q: ptr) -> int { return qjs_object(q) }
new_array(q: ptr) -> int { return qjs_array(q) }

// JSON.parse: (handle, "") or (0, error).
parse_json(q: ptr, text: string) -> (int, string) {
    h = qjs_parse_json(q, text)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// JSON.stringify(h) ("" if it has no JSON form).
to_json(q: ptr, h: int) -> string { return string.copy(qjs_to_json(q, h)) }
to_string(q: ptr, h: int) -> string { return string.copy(qjs_to_string(q, h)) }
to_int(q: ptr, h: int) -> int { return qjs_to_int(q, h) }
to_float(q: ptr, h: int) -> float { return qjs_to_float(q, h) }
to_bool(q: ptr, h: int) -> int { return qjs_to_bool(q, h) }

// "undefined", "null", "boolean", "number", "bigint", "string", "symbol",
// "function", "array", "error", "promise" or "object".
type_of(q: ptr, h: int) -> string { return string.copy(qjs_type(q, h)) }

// ---- properties ----

// obj[name]: (handle, "") or (0, error) (a getter can throw).
get(q: ptr, obj: int, name: string) -> (int, string) {
    h = qjs_get(q, obj, name)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

// obj[name] = v (v stays held by its handle): "" or the error.
set(q: ptr, obj: int, name: string, v: int) -> string {
    if qjs_set(q, obj, name, v) < 0 { return string.copy(qjs_error(q)) }
    return ""
}

get_index(q: ptr, obj: int, i: int) -> (int, string) {
    h = qjs_get_index(q, obj, i)
    if h < 0 { return 0, string.copy(qjs_error(q)) }
    return h, ""
}

set_index(q: ptr, obj: int, i: int, v: int) -> string {
    if qjs_set_index(q, obj, i, v) < 0 { return string.copy(qjs_error(q)) }
    return ""
}

// obj.length (-1 if it has none that is a number).
length(q: ptr, obj: int) -> int { return qjs_length(q, obj) }

// An array of obj's own enumerable string keys.
keys(q: ptr, obj: int) -> int { return qjs_keys(q, obj) }

// ---- reading a host function's arguments ----

arg_count(q: ptr, args: int) -> int { return qjs_length(q, args) }

// Argument i (a handle to release; undefined past the end).
arg(q: ptr, args: int, i: int) -> int { return qjs_get_index(q, args, i) }

arg_int(q: ptr, args: int, i: int) -> int {
    h = qjs_get_index(q, args, i)
    n = qjs_to_int(q, h)
    qjs_release(q, h)
    return n
}

arg_float(q: ptr, args: int, i: int) -> float {
    h = qjs_get_index(q, args, i)
    d = qjs_to_float(q, h)
    qjs_release(q, h)
    return d
}

arg_string(q: ptr, args: int, i: int) -> string {
    h = qjs_get_index(q, args, i)
    s = string.copy(qjs_to_string(q, h))
    qjs_release(q, h)
    return s
}

arg_bool(q: ptr, args: int, i: int) -> int {
    h = qjs_get_index(q, args, i)
    b = qjs_to_bool(q, h)
    qjs_release(q, h)
    return b
}

// ---- bytes ----

// The bytes of a Uint8Array or Uint8ClampedArray (a view's own window of
// its buffer, so `a.subarray(4)` starts at a[4]): (a pointer into the
// engine's buffer, the byte count), or (null, -1) when h is not one, or its
// buffer is detached. Other typed arrays are not bytes and give (null, -1).
// The pointer is the engine's own memory, with no copy: read it or copy it
// before JS runs again (a script can resize or detach the buffer), and never
// free it. An empty array gives a non-null pointer and 0.
bytes_of(q: ptr, h: int) -> (ptr, int) {
    n = qjs_u8_length(q, h)
    if n < 0 { return null, -1 }
    return qjs_u8_data(q, h), n
}

// bytes_of of a host function's argument i, as one call: (pointer, count) or
// (null, -1). The pointer stays valid while the host function runs (the
// arguments array holds the value) and JS does not.
arg_bytes(q: ptr, args: int, i: int) -> (ptr, int) {
    h = qjs_get_index(q, args, i)
    if h < 0 { return null, -1 }
    n = qjs_u8_length(q, h)
    d = qjs_u8_data(q, h)
    qjs_release(q, h)
    if n < 0 { return null, -1 }
    return d, n
}

// A new Uint8Array holding a copy of the n bytes at data (a raw pointer:
// `bytes.data(b)` for a std.bytes buffer, not the handle). The engine owns
// the copy, so data can be freed at once. A handle, or -1 (last_error says
// why) for a negative n or a null data with n > 0.
new_uint8array(q: ptr, data: ptr, n: int) -> int { return qjs_new_uint8array(q, data, n) }

// ---- promises ----

// A new promise as an object { promise, resolve, reject }: give the script
// `promise`, and call `resolve` or `reject` when the answer arrives (say,
// from an actor), then run_jobs so its awaits carry on.
new_promise(q: ptr) -> int { return qjs_new_promise(q) }

// What promise_state says a handle is.
const PROMISE_NOT_A_PROMISE = -1
const PROMISE_PENDING = 0
const PROMISE_FULFILLED = 1
const PROMISE_REJECTED = 2

// Whether h is a promise and how it stands: PROMISE_NOT_A_PROMISE (-1),
// PROMISE_PENDING (0), PROMISE_FULFILLED (1) or PROMISE_REJECTED (2). Runs no
// JavaScript, so it is safe to ask between run_jobs calls.
promise_state(q: ptr, h: int) -> int { return qjs_promise_state(q, h) }

// What a settled promise holds: its value if it was fulfilled, the reason
// (usually an Error) if it was rejected, as (handle, ""); (0, error) when h
// is not a promise or is still pending. Release the handle.
promise_result(q: ptr, h: int) -> (int, string) {
    r = qjs_promise_result(q, h)
    if r < 0 { return 0, string.copy(qjs_error(q)) }
    return r, ""
}
