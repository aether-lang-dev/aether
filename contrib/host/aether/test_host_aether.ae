// Integration spec for contrib.host.aether — co-located with the bridge,
// written in Aether against std.spec, like stunt's test_host_stunt.ae: it
// drives the bridge through its `import` rather than a C harness, so the
// spec exercises the same link and module surface a user's program does.
//
// Replaces tests/integration/host_aether/, whose wrapper existed to build
// the bridge archive, export AETHER_AE_PATH / AETHER_HOST_CHILD, and grep
// the driver's stdout for a sentinel line. The `[2/2]` discovery phase
// already builds `libaether_host_aether.a` on demand and skips when it
// cannot, so the only jobs left were the two env vars and the child
// script — both of which this spec now does itself, making it runnable
// under a bare `ae run`.
//
// WHAT THIS EXERCISES: the simplest, portable rung of the
// Aether-hosts-Aether bridge — compile a child .ae to a native binary
// (the bridge shells out to the ae driver), then run it as a subprocess
// and check its exit code. The sandboxed rungs (run_sandboxed and the
// *_with_map variants) need libaether_sandbox.so plus the LD_PRELOAD
// path, so they stay out of the portable spec exactly as the retired
// wrapper had it.
//
// SKIPPING: the bridge body is `#if defined(__linux__) || defined(__APPLE__)`
// — elsewhere the .c compiles to an empty stub with no aether_host_*
// symbols. It also needs a built `ae` to shell out to. Both are
// provisioning conditions rather than code defects, so they skip.

import contrib.host.aether
import std.fs
import std.list
import std.mem
import std.os
import std.sandbox
import std.spec
import std.string
import std.worker

var longest_capture: long = 0
var captures_run = 0
var captures_wrong = 0

// Capture from a binary that is not there; the "" result dies with this call.
fn capture_missing(path: string) -> int {
    // This ownership probe deliberately runs without a grant list/preload.
    out = aether.host_capture_sandboxed(null as sandbox.Grants, path)
    return string.length(out)
}

// #3040: two long children (4 s each) one after the other, started through
// std.os by this program re-run with `--long`.
long_children() {
    argv = list.new()
    _a = list.add(argv, "--long")
    i = 0
    while i < 2 {
        _out, _err_out, _status, _err = os.run_full(os.argv0(), argv, null, "")
        i = i + 1
    }
    list.free(argv)
}

// Bridge captures of this program as the short child (it prints "short"),
// for 6 s; the longest single capture in milliseconds.
short_captures() -> long {
    start = os.now_monotonic_ms()
    longest = 0 as long
    while os.now_monotonic_ms() - start < 6000 {
        t0 = os.now_monotonic_ms()
        out = aether.host_capture_sandboxed(null as sandbox.Grants, os.argv0())
        took = os.now_monotonic_ms() - t0
        if took > longest { longest = took }
        if string.starts_with(out, "short") != 1 { captures_wrong = captures_wrong + 1 }
        captures_run = captures_run + 1
    }
    return longest
}

main() {
    // The children of the capture race below: this program, re-run.
    if os.args_count() > 1 && string.equals(os.args_get(1), "--long") == 1 {
        sleep(4000)
        return 0
    }
    if string.equals(os.getenv("AETHER_HOST_RACE_CHILD"), "short") == 1 {
        println("short")
        return 0
    }

    fw = spec.init()

    // The bridge's compile step shells out to the ae driver, reading
    // AETHER_AE_PATH and falling back to a bare "ae" on $PATH. The
    // retired wrapper exported this; do it here so a bare `ae run` works.
    ae_path = os.getenv("AETHER_AE_PATH")
    if string.length(ae_path) == 0 {
        if fs.exists("build/ae") == 1 {
            os.setenv("AETHER_AE_PATH", "build/ae")
            ae_path = "build/ae"
        }
    }
    have_ae = 0
    if string.length(ae_path) != 0 { have_ae = 1 }
    reason = "no ae driver (set AETHER_AE_PATH, or build build/ae)"
    plat = os.platform()
    is_posix = 0
    if string.equals(plat, "linux") == 1 { is_posix = 1 }
    if string.equals(plat, "darwin") == 1 { is_posix = 1 }

    // Stage the child script the bridge will compile and run. PID-scoped
    // so concurrent runs cannot collide. The child is deliberately
    // trivial: this rung proves compile + spawn worked, and the exit code
    // is what carries that.
    dir = string.concat("/tmp/aether_host_aether_spec_", string.from_int(os.getpid()))
    fs.mkdir_p(dir)
    child = string.concat(dir, "/child.ae")
    fs.write(child, "main() {\n    println(\"child-ran-ok\")\n}\n")

    spec.describe(fw, "contrib.host.aether") {
        // The round trip: compile a real .ae to a native binary, spawn it,
        // and get its exit status back. A bridge that resolved its symbols
        // but never actually invoked the compiler would fail here.
        spec.it_when(have_ae, "compiles and runs a child script", reason) callback {
            spec.assert_eq(aether.host_run_script(child), 0,
                "run_script returns the child's exit code 0")
        }

        // A child that exits non-zero must surface as non-zero, not be
        // flattened to success — otherwise a failing child is invisible to
        // the host.
        spec.it_when(have_ae, "propagates a non-zero child exit code", reason) callback {
            bad = string.concat(dir, "/child_fails.ae")
            fs.write(bad, "extern exit(code: int)\nmain() {\n    exit(3)\n}\n")
            spec.assert_not_eq(aether.host_run_script(bad), 0,
                "a child exiting 3 must NOT report success")
        }

        // A script that does not compile must be reported rather than
        // treated as a child that ran and succeeded.
        spec.it_when(have_ae, "reports a child that fails to compile", reason) callback {
            broken = string.concat(dir, "/child_broken.ae")
            fs.write(broken, "main() { this is not aether ((( }\n")
            spec.assert_not_eq(aether.host_run_script(broken), 0,
                "an uncompilable child must NOT report success")
        }

        // A missing path is the caller-error case: it must fail rather
        // than silently succeed on nothing.
        spec.it_when(have_ae, "reports a missing script path", reason) callback {
            spec.assert_not_eq(
                aether.host_run_script("/nonexistent-aether-child-zzz.ae"), 0,
                "a missing script must NOT report success")
        }

        // capture_sandboxed hands back a fresh string the caller owns, the
        // child's stdout or "" when it could not run. Its extern was a
        // plain `-> string`, so the compiler took it for borrowed and every
        // capture leaked. Where the allocator's count is exact, one of two
        // windows of a hundred captures of a binary that is not there
        // leaves the heap where it was (a leak grows both; a one-time
        // allocation at most one). Gated like the spawn itself: elsewhere
        // the bridge is a stub.
        spec.it_when(is_posix, "reclaims captured output", "the bridge spawns on Linux and macOS only") callback {
            missing = string.concat(dir, "/no-such-binary")
            spec.assert_eq(capture_missing(missing), 0, "nothing is captured from a missing binary")
            if mem.heap_in_use_exact() {
                before = mem.heap_in_use()
                for (i = 0; i < 100; i++) {
                    _n = capture_missing(missing)
                }
                mid = mem.heap_in_use()
                for (i = 0; i < 100; i++) {
                    _n = capture_missing(missing)
                }
                after = mem.heap_in_use()
                spec.assert_true(mid - before == 0 || after - mid == 0,
                    "100 captures grew the heap by ${mid - before}, then ${after - mid} bytes")
            }
        }

        // #3040: the capture pipe closes on exec. Four threads start long
        // children through std.os while one captures short ones through the
        // bridge; a long child started while a capture's pipe is open must
        // not inherit its write end, or that capture waits for it to exit
        // (4 s). The bound is 2.5 s against tens of milliseconds, as
        // os_run_full_threads has it (#2917).
        spec.it_when(is_posix, "captures while other threads start children", "the bridge spawns on Linux and macOS only") callback {
            os.setenv("AETHER_HOST_RACE_CHILD", "short")
            worker.pool_size(5)
            k = 0
            while k < 4 {
                _ok = worker.run(|| {
                        long_children()
                        return null
                    }, | r: ptr | {
                    })
                k = k + 1
            }
            _ok2 = worker.run(|| {
                    return mem.long_to_ptr(short_captures())
                }, | r: ptr | {
                    longest_capture = mem.ptr_to_long(r)
                })
            worker.wait()
            os.unsetenv("AETHER_HOST_RACE_CHILD")
            spec.assert_true(captures_run >= 5, "only ${captures_run} captures ran")
            spec.assert_eq(captures_wrong, 0, "a capture did not read the child's output")
            spec.assert_true(longest_capture <= 2500,
                "a capture waited ${longest_capture} ms, for a child another thread started")
        }
    }

    return spec.run_summary(fw)
}
