// jq.lexer — jq source to tokens.
//
// Ported from gojq's lexer.go. The token stream is a std.list of Token
// boxes; the parser walks it by index and never re-lexes. String literals
// are lexed here into their parts (literal runs and `\(...)` interpolation
// sources) so the parser can hand each interpolated expression back to a
// fresh parse; a `\(` scans to its matching `)` through nested strings and
// parentheses, which is the one place the lexer has to understand nesting.
//
// A token's text is an owned JSON string (see ast.ae for why), and a string
// token's parts are an owned JSON array whose elements are either a string
// (literal text, escapes already decoded) or a one-element array holding
// the source of an interpolated expression.

import std.json
import std.list
import std.string
import std.strbuilder

exports(
    TK_EOF, TK_IDENT, TK_KEYWORD, TK_FIELD, TK_VAR, TK_NUM, TK_STR, TK_FORMAT, TK_OP,
    Token,
    tokenize, free_tokens, token_kind, token_text, token_num, token_pos, token_parts,
    is_keyword
)

const TK_EOF = 0
const TK_IDENT = 1 // name, or name::name
const TK_KEYWORD = 2 // def as if then elif else end reduce foreach try catch label import include and or
const TK_FIELD = 3 // .name   (text = name)
const TK_VAR = 4 // $name   (text = name)
const TK_NUM = 5 // 1, 2.5, 1e3
const TK_STR = 6 // "..."   (parts)
const TK_FORMAT = 7 // @name   (text = name)
const TK_OP = 8 // punctuation and operators (text = spelling)

struct Token {
    kind: int,
    text: ptr, // owned JSON string, or null
    parts: ptr, // owned JSON array (TK_STR), or null
    num: float,
    pos: int
}

// The source and the diagnostic are held as JSON strings, like the tokens'
// text: their lifetime is then explicit (released in _dispose), with no
// generated string destructor guessing at ownership.
struct Lexer {
    src: ptr,
    len: int,
    pos: int,
    tokens: ptr,
    err: ptr,
    err_pos: int
}

_dispose(lx: *Lexer) {
    json.json_free(lx.src)
    if lx.err != null { json.json_free(lx.err) }
    heap.free(lx)
}

_src(lx: *Lexer) -> string {
    return json.json_get_string_raw(lx.src)
}

// Tokenize `src`. Returns (tokens, "") or (null, diagnostic).
tokenize(src: string) -> ptr! {
    lx = heap.new(Lexer)
    lx.src = json.json_create_string(src)
    lx.len = string.length(src)
    lx.pos = 0
    lx.tokens = list.new()
    lx.err = null
    lx.err_pos = 0
    ok = _run(lx)
    if ok == 0 {
        msg = "${json.json_get_string_raw(lx.err)} at position ${lx.err_pos}"
        free_tokens(lx.tokens)
        _dispose(lx)
        return null, msg
    }
    _push(lx, TK_EOF, null, 0.0, lx.pos)
    toks = lx.tokens
    _dispose(lx)
    return toks, ""
}

free_tokens(toks: ptr) {
    if toks == null { return }
    n = list.size(toks)
    i = 0
    while i < n {
        t = list.get_raw(toks, i) as *Token
        if t.text != null { json.json_free(t.text) }
        if t.parts != null { json.json_free(t.parts) }
        heap.free(list.get_raw(toks, i))
        list.set(toks, i, null)
        i = i + 1
    }
    list.free(toks)
}

token_kind(t: ptr) -> int { return (t as *Token).kind }
token_num(t: ptr) -> float { return (t as *Token).num }
token_pos(t: ptr) -> int { return (t as *Token).pos }
token_parts(t: ptr) -> ptr { return (t as *Token).parts }

// The token's text, borrowed ("" when it has none).
token_text(t: ptr) -> string {
    p = t as *Token
    if p.text == null { return "" }
    return json.json_get_string_raw(p.text)
}

is_keyword(s: string) -> int {
    match (s) {
        "def" -> { return 1 }
        "as" -> { return 1 }
        "if" -> { return 1 }
        "then" -> { return 1 }
        "elif" -> { return 1 }
        "else" -> { return 1 }
        "end" -> { return 1 }
        "reduce" -> { return 1 }
        "foreach" -> { return 1 }
        "try" -> { return 1 }
        "catch" -> { return 1 }
        "label" -> { return 1 }
        "import" -> { return 1 }
        "include" -> { return 1 }
        "and" -> { return 1 }
        "or" -> { return 1 }
        "__loc__" -> { return 1 }
        _ -> { return 0 }
    }
    return 0
}

// --- character classes ---------------------------------------------

_is_digit(c: int) -> int {
    if c >= 48 { if c <= 57 { return 1 } }
    return 0
}

_is_ident_start(c: int) -> int {
    if c >= 65 { if c <= 90 { return 1 } }
    if c >= 97 { if c <= 122 { return 1 } }
    if c == 95 { return 1 }
    return 0
}

_is_ident_char(c: int) -> int {
    if _is_ident_start(c) == 1 { return 1 }
    return _is_digit(c)
}

_is_ws(c: int) -> int {
    if c == 32 { return 1 }
    if c == 9 { return 1 }
    if c == 10 { return 1 }
    if c == 13 { return 1 }
    return 0
}

// --- cursor ----------------------------------------------------------

_peek(lx: *Lexer) -> int {
    if lx.pos >= lx.len { return -1 }
    return string.char_at_n(_src(lx), lx.len, lx.pos)
}

_peek_at(lx: *Lexer, off: int) -> int {
    at = lx.pos + off
    if at >= lx.len { return -1 }
    return string.char_at_n(_src(lx), lx.len, at)
}

_fail(lx: *Lexer, msg: string, pos: int) -> int {
    if lx.err != null { json.json_free(lx.err) }
    lx.err = json.json_create_string(msg)
    lx.err_pos = pos
    return 0
}

_push(lx: *Lexer, kind: int, text: ptr, num: float, pos: int) {
    t = heap.new(Token)
    t.kind = kind
    t.text = text
    t.parts = null
    t.num = num
    t.pos = pos
    list.list_add_raw(lx.tokens, t)
}

_push_text(lx: *Lexer, kind: int, text: string, pos: int) {
    _push(lx, kind, json.json_create_string(text), 0.0, pos)
}

// Consume `op` if the source has it here. Returns 1 on consume.
_take_op(lx: *Lexer, op: string) -> int {
    n = string.length(op)
    if lx.pos + n > lx.len { return 0 }
    i = 0
    while i < n {
        if string.char_at_n(_src(lx), lx.len, lx.pos + i) != string.char_at(op, i) { return 0 }
        i = i + 1
    }
    _push_text(lx, TK_OP, op, lx.pos)
    lx.pos = lx.pos + n
    return 1
}

// --- main loop -------------------------------------------------------

_run(lx: *Lexer) -> int {
    while lx.pos < lx.len {
        c = _peek(lx)
        if _is_ws(c) == 1 {
            lx.pos = lx.pos + 1
        } else if c == 35 { // '#' comment to end of line
            while lx.pos < lx.len {
                if _peek(lx) == 10 { break }
                lx.pos = lx.pos + 1
            }
        } else if c == 34 { // '"'
            if _lex_string(lx) == 0 { return 0 }
        } else if _is_digit(c) == 1 || (c == 46 && _is_digit(_peek_at(lx, 1)) == 1) {
            // `.5` is a number in jq, as in its own lexer
            _lex_number(lx)
        } else if _is_ident_start(c) == 1 {
            _lex_ident(lx)
        } else if c == 36 { // '$'
            start = lx.pos
            lx.pos = lx.pos + 1
            if _is_ident_start(_peek(lx)) == 0 {
                return _fail(lx, "expected a variable name after '$'", start)
            }
            name = _read_ident(lx)
            _push_text(lx, TK_VAR, name, start)
        } else if c == 64 { // '@'
            start = lx.pos
            lx.pos = lx.pos + 1
            if _is_ident_start(_peek(lx)) == 0 {
                return _fail(lx, "expected a format name after '@'", start)
            }
            name = _read_ident(lx)
            _push_text(lx, TK_FORMAT, name, start)
        } else if c == 46 { // '.'
            if _peek_at(lx, 1) == 46 {
                _take_op(lx, "..")
            } else if _is_ident_start(_peek_at(lx, 1)) == 1 {
                start = lx.pos
                lx.pos = lx.pos + 1
                name = _read_ident(lx)
                _push_text(lx, TK_FIELD, name, start)
            } else {
                _take_op(lx, ".")
            }
        } else {
            if _lex_op(lx) == 0 {
                return _fail(lx, "unexpected character '${string.substring_n(_src(lx), lx.len, lx.pos, lx.pos + 1)}'", lx.pos)
            }
        }
    }
    return 1
}

// Longest operator first, so `//=` is not read as `/` `/` `=`.
_lex_op(lx: *Lexer) -> int {
    if _take_op(lx, "?//") == 1 { return 1 }
    if _take_op(lx, "//=") == 1 { return 1 }
    if _take_op(lx, "|=") == 1 { return 1 }
    if _take_op(lx, "+=") == 1 { return 1 }
    if _take_op(lx, "-=") == 1 { return 1 }
    if _take_op(lx, "*=") == 1 { return 1 }
    if _take_op(lx, "/=") == 1 { return 1 }
    if _take_op(lx, "%=") == 1 { return 1 }
    if _take_op(lx, "==") == 1 { return 1 }
    if _take_op(lx, "!=") == 1 { return 1 }
    if _take_op(lx, "<=") == 1 { return 1 }
    if _take_op(lx, ">=") == 1 { return 1 }
    if _take_op(lx, "//") == 1 { return 1 }
    if _take_op(lx, "[") == 1 { return 1 }
    if _take_op(lx, "]") == 1 { return 1 }
    if _take_op(lx, "{") == 1 { return 1 }
    if _take_op(lx, "}") == 1 { return 1 }
    if _take_op(lx, "(") == 1 { return 1 }
    if _take_op(lx, ")") == 1 { return 1 }
    if _take_op(lx, "|") == 1 { return 1 }
    if _take_op(lx, ",") == 1 { return 1 }
    if _take_op(lx, ":") == 1 { return 1 }
    if _take_op(lx, ";") == 1 { return 1 }
    if _take_op(lx, "=") == 1 { return 1 }
    if _take_op(lx, "<") == 1 { return 1 }
    if _take_op(lx, ">") == 1 { return 1 }
    if _take_op(lx, "+") == 1 { return 1 }
    if _take_op(lx, "-") == 1 { return 1 }
    if _take_op(lx, "*") == 1 { return 1 }
    if _take_op(lx, "/") == 1 { return 1 }
    if _take_op(lx, "%") == 1 { return 1 }
    if _take_op(lx, "?") == 1 { return 1 }
    return 0
}

// An identifier, with `::` module separators kept in the name.
_read_ident(lx: *Lexer) -> string {
    start = lx.pos
    while lx.pos < lx.len {
        c = _peek(lx)
        if _is_ident_char(c) == 1 {
            lx.pos = lx.pos + 1
        } else if c == 58 && _peek_at(lx, 1) == 58 && _is_ident_start(_peek_at(lx, 2)) == 1 {
            lx.pos = lx.pos + 2
        } else {
            break
        }
    }
    return string.substring_n(_src(lx), lx.len, start, lx.pos)
}

_lex_ident(lx: *Lexer) {
    start = lx.pos
    name = _read_ident(lx)
    if is_keyword(name) == 1 {
        _push_text(lx, TK_KEYWORD, name, start)
    } else {
        _push_text(lx, TK_IDENT, name, start)
    }
}

// digits [ '.' digits ] [ ('e'|'E') ['+'|'-'] digits ]
_lex_number(lx: *Lexer) {
    start = lx.pos
    while _is_digit(_peek(lx)) == 1 { lx.pos = lx.pos + 1 }
    if _peek(lx) == 46 && _is_digit(_peek_at(lx, 1)) == 1 {
        lx.pos = lx.pos + 1
        while _is_digit(_peek(lx)) == 1 { lx.pos = lx.pos + 1 }
    }
    c = _peek(lx)
    if c == 101 || c == 69 {
        save = lx.pos
        lx.pos = lx.pos + 1
        if _peek(lx) == 43 || _peek(lx) == 45 { lx.pos = lx.pos + 1 }
        if _is_digit(_peek(lx)) == 1 {
            while _is_digit(_peek(lx)) == 1 { lx.pos = lx.pos + 1 }
        } else {
            lx.pos = save
        }
    }
    text = string.substring_n(_src(lx), lx.len, start, lx.pos)
    d, err = string.to_double(text)
    if err != "" {
        // Out of double range: 1e1000 overflows to infinity (which prints as
        // the largest double, as in jq), 1e-1000 underflows to zero.
        d = 1.0 / 0.0
        if string.contains(text, "e-") == 1 || string.contains(text, "E-") == 1 { d = 0.0 }
    }
    _push(lx, TK_NUM, null, d, start)
}

// --- strings ---------------------------------------------------------

_hex_val(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return -1
}

// Four hex digits at lx.pos, or -1.
_read_hex4(lx: *Lexer) -> int {
    if lx.pos + 4 > lx.len { return -1 }
    v = 0
    i = 0
    while i < 4 {
        h = _hex_val(string.char_at_n(_src(lx), lx.len, lx.pos + i))
        if h < 0 { return -1 }
        v = v * 16 + h
        i = i + 1
    }
    lx.pos = lx.pos + 4
    return v
}

// Flush the literal run in `sb` (if any) into `parts`. finish destroys the
// builder, so the caller continues with the one returned here.
_flush_literal(sb: ptr, parts: ptr) -> ptr {
    if strbuilder.length(sb) > 0 {
        s = strbuilder.finish(sb)
        json.json_array_add_raw(parts, json.json_create_string(s))
        return strbuilder.new(16)
    }
    return sb
}

// The opening quote is at lx.pos.
_lex_string(lx: *Lexer) -> int {
    start = lx.pos
    lx.pos = lx.pos + 1
    parts = json.json_create_array()
    sb = strbuilder.new(16)
    closed = 0
    while lx.pos < lx.len {
        c = _peek(lx)
        if c == 34 {
            lx.pos = lx.pos + 1
            closed = 1
            break
        }
        if c == 92 { // backslash
            lx.pos = lx.pos + 1
            e = _peek(lx)
            if e == -1 { break }
            lx.pos = lx.pos + 1
            if e == 110 { strbuilder.append_byte(sb, 10) }
            else if e == 116 { strbuilder.append_byte(sb, 9) }
            else if e == 114 { strbuilder.append_byte(sb, 13) }
            else if e == 98 { strbuilder.append_byte(sb, 8) }
            else if e == 102 { strbuilder.append_byte(sb, 12) }
            else if e == 34 { strbuilder.append_byte(sb, 34) }
            else if e == 92 { strbuilder.append_byte(sb, 92) }
            else if e == 47 { strbuilder.append_byte(sb, 47) }
            else if e == 117 { // \uXXXX, with surrogate pairs combined
                cp = _read_hex4(lx)
                if cp < 0 {
                    strbuilder.free(sb)
                    json.json_free(parts)
                    return _fail(lx, "invalid \\u escape in string", lx.pos)
                }
                if cp >= 55296 && cp <= 56319 && _peek(lx) == 92 && _peek_at(lx, 1) == 117 {
                    save = lx.pos
                    lx.pos = lx.pos + 2
                    lo = _read_hex4(lx)
                    if lo >= 56320 && lo <= 57343 {
                        cp = 65536 + ((cp - 55296) << 10) + (lo - 56320)
                    } else {
                        lx.pos = save
                        cp = 65533
                    }
                } else if cp >= 55296 && cp <= 57343 {
                    cp = 65533
                }
                strbuilder.append_codepoint(sb, cp)
            } else if e == 40 { // \( expression )
                sb = _flush_literal(sb, parts)
                expr_start = lx.pos
                if _skip_interpolation(lx) == 0 {
                    strbuilder.free(sb)
                    json.json_free(parts)
                    return _fail(lx, "unterminated string interpolation", expr_start)
                }
                src = string.substring_n(_src(lx), lx.len, expr_start, lx.pos - 1)
                holder = json.json_create_array()
                json.json_array_add_raw(holder, json.json_create_string(src))
                json.json_array_add_raw(parts, holder)
            } else {
                strbuilder.free(sb)
                json.json_free(parts)
                return _fail(lx, "invalid escape in string", lx.pos - 2)
            }
        } else {
            strbuilder.append_byte(sb, c)
            lx.pos = lx.pos + 1
        }
    }
    if closed == 0 {
        strbuilder.free(sb)
        json.json_free(parts)
        return _fail(lx, "unterminated string", start)
    }
    sb = _flush_literal(sb, parts)
    strbuilder.free(sb)
    t = heap.new(Token)
    t.kind = TK_STR
    t.text = null
    t.parts = parts
    t.num = 0.0
    t.pos = start
    list.list_add_raw(lx.tokens, t)
    return 1
}

// Advance past the `)` that closes a `\(`. lx.pos is just after `\(`.
// Nested parentheses and nested strings (with their own escapes and
// interpolations) are skipped, so `"\("a)b" | length)"` lexes.
_skip_interpolation(lx: *Lexer) -> int {
    depth = 1
    while lx.pos < lx.len {
        c = _peek(lx)
        if c == 40 {
            depth = depth + 1
            lx.pos = lx.pos + 1
        } else if c == 41 {
            depth = depth - 1
            lx.pos = lx.pos + 1
            if depth == 0 { return 1 }
        } else if c == 34 {
            if _skip_string(lx) == 0 { return 0 }
        } else {
            lx.pos = lx.pos + 1
        }
    }
    return 0
}

// Skip a string literal starting at the quote at lx.pos, including any
// `\(...)` inside it.
_skip_string(lx: *Lexer) -> int {
    lx.pos = lx.pos + 1
    while lx.pos < lx.len {
        c = _peek(lx)
        if c == 34 {
            lx.pos = lx.pos + 1
            return 1
        }
        if c == 92 {
            lx.pos = lx.pos + 1
            if _peek(lx) == 40 {
                lx.pos = lx.pos + 1
                if _skip_interpolation(lx) == 0 { return 0 }
            } else {
                lx.pos = lx.pos + 1
            }
        } else {
            lx.pos = lx.pos + 1
        }
    }
    return 0
}
