// contrib.metal: GPU rendering, compute and presentation with Metal.
// Import with: import contrib.metal
//
// The same shape as contrib.vulkan and contrib.d3d12: a program written
// against one reads the same against the others, and what differs is the
// shading language (Metal Shading Language here) and the coordinates (Metal's
// y points UP, as Direct3D's does).
//
//   metal.available()                   -> int     1 when a Metal device exists
//   metal.device_name()                 -> string  the device, "" when none
//   metal.last_error()                  -> string
//
//   metal.device_create()               -> ptr     the system default device
//   metal.device_destroy(dev)
//   metal.device_unified_memory(dev)    -> int     1 on Apple silicon
//
//   metal.target_create(dev, w, h)      -> ptr     offscreen RGBA8 image
//   metal.target_create_ex(dev, w, h, depth, samples) -> ptr
//   metal.target_create_format(dev, w, h, format, depth, samples) -> ptr
//   metal.target_destroy(t)   target_width(t)   target_height(t)
//   metal.target_format(t)    target_bytes_per_pixel(t)   rgba_size(t)
//   metal.target_has_depth(t) target_samples(t)
//   metal.target_resize(t, w, h)        -> int     keeps every pipeline valid
//   metal.target_set_readback(t, on)    -> int     off: no per-frame copy out
//   metal.target_set_frames(t, n)       -> int     frames in flight, 1..8
//   metal.target_set_timeout_ms(t, ms)  -> int
//
//   metal.pipeline_create(dev, t, vs, vs_len, ps, ps_len)           -> ptr
//   metal.pipeline_create_ex(dev, t, vs, vs_len, ps, ps_len, layout, push_bytes, bindings) -> ptr
//   metal.pipeline_destroy(p)
//   metal.layout_create() / layout_binding / layout_attr / layout_destroy
//   metal.bindings_create() / bindings_uniform / bindings_texture /
//         bindings_storage / bindings_destroy
//
//   metal.texture_create(dev, w, h)     -> ptr
//   metal.texture_create_ex(dev, w, h, mipmapped, linear, repeat) -> ptr
//   metal.texture_upload(tex, rgba, len) -> int
//   metal.texture_mip_levels(tex)       -> int
//   metal.texture_destroy(tex)
//
//   metal.set_texture / set_uniform / set_buffer / uniform_floats /
//         uniform_float                 the pipeline's own resources
//   metal.material_create(p) / material_set_texture / material_set_uniform /
//         material_set_buffer / material_floats / material_float /
//         material_destroy               one set of resources per draw
//
//   metal.verts_reserve(t, n) / verts_set(t, i, x, y, r, g, b)
//   metal.verts_reserve_n(t, n, floats) / verts_set_float(t, i, v)
//   metal.indices_reserve(t, n) / indices_reserve_ex(t, n, bits) / indices_set
//   metal.push_floats(t, n) / push_float(t, i, v) / set_push(t, data, len)
//   metal.batch_reset(t) / batch_add(t, m, first, count) / batch_count(t)
//   metal.draw(t, p, r, g, b, a) / draw_material(t, p, m, r, g, b, a)
//   metal.submit(t, p, r, g, b, a) / submit_material(...) / wait_all(t)
//   metal.pixel(t, x, y)                -> long    0xRRGGBBAA, -1 outside
//   metal.pixel_value(t, x, y, channel) -> float   full precision
//   metal.copy_rgba(t, dest, len) / copy_rgba8(t, dest, len)
//   metal.save_ppm(t, path) -> int      save_png(t, path) -> string
//
//   metal.buffer_create(dev, bytes) / buffer_destroy / buffer_size /
//         buffer_write / buffer_read / buffer_set_float / buffer_float /
//         buffer_set_int / buffer_int
//   metal.compute_create(dev, cs, len, bindings, push_bytes) -> ptr
//   metal.compute_set_group_size(c, x, y, z) -> int  threads a group; MSL
//         does not declare them, so this is required before a dispatch
//   metal.compute_set_buffer / compute_set_texture / compute_push_float /
//         compute_push_int / compute_set_timeout_ms / compute_destroy
//   metal.dispatch(c, gx, gy, gz) / dispatch_async / compute_wait
//
//   metal.swapchain_create(dev, kind, display, window, w, h) -> ptr
//   metal.swapchain_destroy / swapchain_resize / swapchain_set_vsync /
//         swapchain_width / swapchain_height / swapchain_format /
//         swapchain_presented
//   metal.present(sc, t)                -> int
//
// Shaders are Metal Shading Language, source compiled at runtime or a
// metallib compiled ahead of time; the entry point is the library's one
// function of the stage's kind (vertex, fragment, kernel), whatever its name.
// Resources map to argument-table indices by binding number: a uniform or a
// storage buffer at binding N is [[buffer(N)]], a texture [[texture(N)]] with
// its sampler [[sampler(N)]], the push constants [[buffer(8)]], and vertex
// stream B [[buffer(16 + B)]]. Vertex attribute location N is [[attribute(N)]]
// of the [[stage_in]] struct.
//
// Nothing links against Metal: Metal, QuartzCore, Foundation and the
// Objective-C runtime are opened at runtime. The module builds on every
// platform, and away from macOS available() is 0 and every call says why. The
// view a swapchain presents into is never this module's: it is the NSView a
// toolkit hands out (aether-ui's native_view kind 2), or a CAMetalLayer.

@source("aether_metal.c")

import std.bytes
import std.string
import contrib.png

exports(
    OK, ERR_NO_LOADER, ERR_NO_DEVICE, ERR_ARG, ERR_OOM, ERR_UNSUPPORTED, ERR_SHADER, ERR_DEVICE_LOST,
    WINDOW_NSVIEW, WINDOW_METAL_LAYER, PER_VERTEX, PER_INSTANCE,
    FORMAT_R32_SFLOAT, FORMAT_R32G32_SFLOAT, FORMAT_R32G32B32_SFLOAT, FORMAT_R32G32B32A32_SFLOAT,
    FORMAT_R8G8B8A8_UNORM, FORMAT_R8G8B8A8_SRGB, FORMAT_R16G16B16A16_SFLOAT,
    FORMAT_B8G8R8A8_UNORM, FORMAT_B8G8R8A8_SRGB,
    aemt_ae_available, aemt_ae_last_error, aemt_ae_device_name,
    aemt_ae_device_create, aemt_ae_device_destroy, aemt_ae_device_unified_memory,
    aemt_ae_target_create, aemt_ae_target_create_ex, aemt_ae_target_create_format, aemt_ae_target_destroy,
    aemt_ae_target_width, aemt_ae_target_height, aemt_ae_target_format, aemt_ae_target_bytes_per_pixel,
    aemt_ae_target_has_depth, aemt_ae_target_samples, aemt_ae_target_resize,
    aemt_ae_target_set_readback, aemt_ae_target_readback, aemt_ae_target_set_frames, aemt_ae_target_frames,
    aemt_ae_target_set_timeout_ms, aemt_ae_rgba_size,
    aemt_ae_pipeline_create, aemt_ae_pipeline_create_ex, aemt_ae_pipeline_destroy,
    aemt_ae_layout_create, aemt_ae_layout_destroy, aemt_ae_layout_binding, aemt_ae_layout_attr,
    aemt_ae_bindings_create, aemt_ae_bindings_destroy, aemt_ae_bindings_uniform, aemt_ae_bindings_texture,
    aemt_ae_bindings_storage,
    aemt_ae_texture_create, aemt_ae_texture_create_ex, aemt_ae_texture_destroy, aemt_ae_texture_mip_levels,
    aemt_ae_texture_upload,
    aemt_ae_set_uniform, aemt_ae_set_texture, aemt_ae_set_buffer, aemt_ae_uniform_floats, aemt_ae_uniform_float,
    aemt_ae_material_create, aemt_ae_material_destroy, aemt_ae_material_set_texture,
    aemt_ae_material_set_uniform, aemt_ae_material_set_buffer, aemt_ae_material_floats, aemt_ae_material_float,
    aemt_ae_verts_reserve, aemt_ae_verts_reserve_n, aemt_ae_verts_set, aemt_ae_verts_set_float,
    aemt_ae_indices_reserve, aemt_ae_indices_reserve_ex, aemt_ae_indices_set,
    aemt_ae_set_push, aemt_ae_push_floats, aemt_ae_push_float,
    aemt_ae_batch_reset, aemt_ae_batch_add, aemt_ae_batch_count,
    aemt_ae_draw, aemt_ae_draw_material, aemt_ae_submit, aemt_ae_submit_material, aemt_ae_wait_all,
    aemt_ae_copy_rgba, aemt_ae_copy_rgba8, aemt_ae_pixel, aemt_ae_pixel_value, aemt_ae_save_ppm,
    aemt_ae_buffer_create, aemt_ae_buffer_destroy, aemt_ae_buffer_size, aemt_ae_buffer_write,
    aemt_ae_buffer_read, aemt_ae_buffer_set_float, aemt_ae_buffer_float, aemt_ae_buffer_set_int,
    aemt_ae_buffer_int,
    aemt_ae_compute_create, aemt_ae_compute_destroy, aemt_ae_compute_set_group_size,
    aemt_ae_compute_set_buffer, aemt_ae_compute_set_texture,
    aemt_ae_compute_set_push, aemt_ae_compute_push_float, aemt_ae_compute_push_int,
    aemt_ae_compute_set_timeout_ms, aemt_ae_dispatch, aemt_ae_dispatch_async, aemt_ae_compute_wait,
    aemt_ae_swapchain_create, aemt_ae_swapchain_destroy, aemt_ae_swapchain_resize,
    aemt_ae_swapchain_set_vsync, aemt_ae_swapchain_width, aemt_ae_swapchain_height,
    aemt_ae_swapchain_format, aemt_ae_swapchain_presented, aemt_ae_present,
    available, last_error, device_name, device_create, device_destroy, device_unified_memory,
    target_create, target_create_ex, target_create_format, target_destroy, target_width, target_height,
    target_format, target_bytes_per_pixel, target_has_depth, target_samples, target_resize,
    target_set_readback, target_readback, target_set_frames, target_frames, target_set_timeout_ms,
    rgba_size,
    pipeline_create, pipeline_create_ex, pipeline_destroy,
    layout_create, layout_destroy, layout_binding, layout_attr,
    bindings_create, bindings_destroy, bindings_uniform, bindings_texture, bindings_storage,
    texture_create, texture_create_ex, texture_destroy, texture_mip_levels, texture_upload,
    set_uniform, set_texture, set_buffer, uniform_floats, uniform_float,
    material_create, material_destroy, material_set_texture, material_set_uniform, material_set_buffer,
    material_floats, material_float,
    verts_reserve, verts_reserve_n, verts_set, verts_set_float,
    indices_reserve, indices_reserve_ex, indices_set,
    set_push, push_floats, push_float,
    batch_reset, batch_add, batch_count,
    draw, draw_material, submit, submit_material, wait_all,
    copy_rgba, copy_rgba8, pixel, pixel_value, save_ppm, save_png,
    red, green, blue, alpha,
    buffer_create, buffer_destroy, buffer_size, buffer_write, buffer_read,
    buffer_set_float, buffer_float, buffer_set_int, buffer_int,
    compute_create, compute_destroy, compute_set_group_size, compute_set_buffer, compute_set_texture,
    compute_set_push,
    compute_push_float, compute_push_int, compute_set_timeout_ms, dispatch, dispatch_async, compute_wait,
    swapchain_create, swapchain_destroy, swapchain_resize, swapchain_set_vsync,
    swapchain_width, swapchain_height, swapchain_format, swapchain_presented, present
)

