// A swapchain over an NSView (kind WINDOW_NSVIEW, given a CAMetalLayer; on
// the main thread) or a CAMetalLayer (WINDOW_METAL_LAYER) the caller owns;
// display is unused. A view's size is followed, and presenting while its
// window is miniaturised shows nothing and succeeds. A bare layer takes the
// size given here and to swapchain_resize.
swapchain_create(dev: ptr, kind: int, display: ptr, window: ptr, w: int, h: int) -> ptr {
    return aemt_ae_swapchain_create(dev, kind, display, window, w, h)
}
swapchain_destroy(sc: ptr) { aemt_ae_swapchain_destroy(sc) }
swapchain_resize(sc: ptr, w: int, h: int) -> int { return aemt_ae_swapchain_resize(sc, w, h) }
swapchain_set_vsync(sc: ptr, on: int) -> int { return aemt_ae_swapchain_set_vsync(sc, on) }
swapchain_width(sc: ptr) -> int { return aemt_ae_swapchain_width(sc) }
swapchain_height(sc: ptr) -> int { return aemt_ae_swapchain_height(sc) }
swapchain_format(sc: ptr) -> int { return aemt_ae_swapchain_format(sc) }
swapchain_presented(sc: ptr) -> int { return aemt_ae_swapchain_presented(sc) }
// Shows the target's newest frame, scaled to the drawable and encoded for
// display when the target is sRGB or float.
present(sc: ptr, t: ptr) -> int { return aemt_ae_present(sc, t) }
