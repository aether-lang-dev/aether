save_ppm(t: ptr, path: string) -> int { return aemt_ae_save_ppm(t, path) }

// Writes the newest frame as a PNG (8-bit RGBA); "" on success.
save_png(t: ptr, path: string) -> string {
    w = aemt_ae_target_width(t)
    h = aemt_ae_target_height(t)
    if t == null || w <= 0 || h <= 0 { return "target is null" }
    buf = bytes.new(w * h * 4)
    bytes.set_length(buf, w * h * 4)
    rc = aemt_ae_copy_rgba8(t, bytes.data(buf), w * h * 4)
    if rc != 0 {
        bytes.free(buf)
        return aemt_ae_last_error()
    }
    err = png.write_rgba8(path, bytes.data(buf), w, h)
    bytes.free(buf)
    return err
}

// Channels of the packed value pixel() returns: a long, so every colour is
// non-negative and -1 means only "no pixel there".
red(px: long) -> int { return ((px >> 24) & 255) as int }
green(px: long) -> int { return ((px >> 16) & 255) as int }
blue(px: long) -> int { return ((px >> 8) & 255) as int }
alpha(px: long) -> int { return (px & 255) as int }

// A buffer shaders read and write (CPU-visible, mapped, zeroed).
buffer_create(dev: ptr, bytes: int) -> ptr { return aemt_ae_buffer_create(dev, bytes) }
buffer_destroy(b: ptr) { aemt_ae_buffer_destroy(b) }
buffer_size(b: ptr) -> int { return aemt_ae_buffer_size(b) }
buffer_write(b: ptr, offset: int, data: ptr, len: int) -> int { return aemt_ae_buffer_write(b, offset, data, len) }
buffer_read(b: ptr, offset: int, dest: ptr, len: int) -> int { return aemt_ae_buffer_read(b, offset, dest, len) }
buffer_set_float(b: ptr, index: int, value: float) -> int { return aemt_ae_buffer_set_float(b, index, value) }
buffer_float(b: ptr, index: int) -> float { return aemt_ae_buffer_float(b, index) }
buffer_set_int(b: ptr, index: int, value: int) -> int { return aemt_ae_buffer_set_int(b, index, value) }
buffer_int(b: ptr, index: int) -> int { return aemt_ae_buffer_int(b, index) }

// A compute pipeline from MSL or a metallib: its one kernel function.
compute_create(dev: ptr, cs: string, len: int, bindings: ptr, push_bytes: int) -> ptr {
    return aemt_ae_compute_create(dev, cs, len, bindings, push_bytes)
}
compute_destroy(c: ptr) { aemt_ae_compute_destroy(c) }
// The threads in one group: what [numthreads] gives in HLSL and local_size
// in GLSL. MSL does not declare it, so a dispatch is refused until it is set.
compute_set_group_size(c: ptr, x: int, y: int, z: int) -> int {
    return aemt_ae_compute_set_group_size(c, x, y, z)
}
compute_set_buffer(c: ptr, binding: int, buf: ptr) -> int { return aemt_ae_compute_set_buffer(c, binding, buf) }
compute_set_texture(c: ptr, binding: int, tex: ptr) -> int { return aemt_ae_compute_set_texture(c, binding, tex) }
compute_set_push(c: ptr, data: ptr, len: int) -> int { return aemt_ae_compute_set_push(c, data, len) }
