// Status codes, mirroring aether_metal.h (and contrib.vulkan's).
const OK = 0
const ERR_NO_LOADER = -1
const ERR_NO_DEVICE = -2
const ERR_ARG = -3
const ERR_OOM = -4
const ERR_UNSUPPORTED = -5
const ERR_SHADER = -6
const ERR_DEVICE_LOST = -7

// The window kinds a swapchain presents into, numbered as aether-ui's
// native_view_kind(): an NSView (given a CAMetalLayer, on the main thread),
// or a CAMetalLayer the program made itself.
const WINDOW_NSVIEW = 2
const WINDOW_METAL_LAYER = 5

// Input rate for layout_binding.
const PER_VERTEX = 0
const PER_INSTANCE = 1

// Compare ops for reading a depth through a comparison sampler (#2373): a
// texel passes when `reference op texel`.
const COMPARE_LESS = 1
const COMPARE_LESS_EQUAL = 2
const COMPARE_GREATER = 3
const COMPARE_GREATER_EQUAL = 4
// The rest of the compare ops (#2399), for the stencil test, the depth test
// and comparison samplers alike.
const COMPARE_EQUAL = 5
const COMPARE_NOT_EQUAL = 6
const COMPARE_ALWAYS = 7
const COMPARE_NEVER = 8

// A target's depth (#2399): the last-but-one argument of every target
// create, 0 for none, DEPTH, or DEPTH_STENCIL for a depth with an 8-bit
// stencil, cleared to 0 with the depth.
const DEPTH = 1
const DEPTH_STENCIL = 2

// What the stencil test does to the stored value (#2399): numbered as
// Vulkan's VkStencilOp in every module.
const STENCIL_KEEP = 0
const STENCIL_ZERO = 1
const STENCIL_REPLACE = 2              // the reference
const STENCIL_INCREMENT_CLAMP = 3
const STENCIL_DECREMENT_CLAMP = 4
const STENCIL_INVERT = 5
const STENCIL_INCREMENT_WRAP = 6
const STENCIL_DECREMENT_WRAP = 7

// The channels a pipeline writes (#2411), for state_color_mask: bits as
// Vulkan's VkColorComponentFlagBits number them, in every module.
const COLOR_RED = 1
const COLOR_GREEN = 2
const COLOR_BLUE = 4
const COLOR_ALPHA = 8
const COLOR_ALL = 15

// Pipeline state (#2385): how a fragment's colour meets the target's, and
// which faces are culled. A face is front-facing when its corners run
// counter-clockwise on screen, in every module.
const BLEND_NONE = 0           // replace
const BLEND_ALPHA = 1          // src * a + dst * (1 - a)
const BLEND_PREMULTIPLIED = 2  // src + dst * (1 - a)
const BLEND_ADDITIVE = 3       // src + dst
const CULL_NONE = 0
const CULL_BACK = 1
const CULL_FRONT = 2

// What a pipeline's vertices assemble into (#2398). A point's size comes
// from the vertex shader where the API reads one (gl_PointSize in Vulkan,
// [[point_size]] in Metal); Direct3D 12 draws points one pixel wide.
const TOPOLOGY_TRIANGLES = 0
const TOPOLOGY_TRIANGLE_STRIP = 1
const TOPOLOGY_LINES = 2
const TOPOLOGY_LINE_STRIP = 3
const TOPOLOGY_POINTS = 4

// Formats, named and numbered as contrib.vulkan's (VkFormat): Metal keeps
// pixel and vertex formats in two enums, and one name here serves both, so
// the module translates the number where it is used. For layout_attr: the
// four float ones and R8G8B8A8_UNORM (four normalised bytes); for
// target_create_format: the four RGBA ones. swapchain_format() reports a
// B8G8R8A8 one.
const FORMAT_R32_SFLOAT = 100
const FORMAT_R32G32_SFLOAT = 103
const FORMAT_R32G32B32_SFLOAT = 106
const FORMAT_R32G32B32A32_SFLOAT = 109
const FORMAT_R8G8B8A8_UNORM = 37
const FORMAT_R8G8B8A8_SRGB = 43
// Sampled texture formats (#2397): one and two 8-bit channels, and the BC
// block formats, 4x4 texels a block of 8 (BC1, BC4) or 16 bytes (BC3, BC5,
// BC7). Numbered as this module's API numbers them, like the rest.
const FORMAT_R8_UNORM = 9
const FORMAT_R8G8_UNORM = 16
const FORMAT_BC1_RGBA_UNORM = 133
const FORMAT_BC1_RGBA_SRGB = 134
const FORMAT_BC3_UNORM = 137
const FORMAT_BC3_SRGB = 138
const FORMAT_BC4_UNORM = 139
const FORMAT_BC5_UNORM = 141
const FORMAT_BC7_UNORM = 145
const FORMAT_BC7_SRGB = 146
const FORMAT_R16G16B16A16_SFLOAT = 97
const FORMAT_B8G8R8A8_UNORM = 44
const FORMAT_B8G8R8A8_SRGB = 50

available() -> int { return aemt_ae_available() }
last_error() -> string { return aemt_ae_last_error() }
device_name() -> string { return aemt_ae_device_name() }

// The system default device (MTLCreateSystemDefaultDevice).
device_create() -> ptr { return aemt_ae_device_create() }
device_destroy(dev: ptr) { aemt_ae_device_destroy(dev) }
// 1 when the device shares memory with the CPU (Apple silicon).
device_unified_memory(dev: ptr) -> int { return aemt_ae_device_unified_memory(dev) }

target_create(dev: ptr, w: int, h: int) -> ptr { return aemt_ae_target_create(dev, w, h) }
// Depth makes geometry resolve by distance; samples is 1, 2, 4, 8 or 16,
// checked against the device rather than rounded down.
target_create_ex(dev: ptr, w: int, h: int, want_depth: int, samples: int) -> ptr {
    return aemt_ae_target_create_ex(dev, w, h, want_depth, samples)
}
// FORMAT_R8G8B8A8_UNORM, _SRGB, FORMAT_R16G16B16A16_SFLOAT or
// FORMAT_R32G32B32A32_SFLOAT.
target_create_format(dev: ptr, w: int, h: int, format: int, want_depth: int, samples: int) -> ptr {
    return aemt_ae_target_create_format(dev, w, h, format, want_depth, samples)
}
target_destroy(t: ptr) { aemt_ae_target_destroy(t) }
target_width(t: ptr) -> int { return aemt_ae_target_width(t) }
target_height(t: ptr) -> int { return aemt_ae_target_height(t) }
target_format(t: ptr) -> int { return aemt_ae_target_format(t) }
target_bytes_per_pixel(t: ptr) -> int { return aemt_ae_target_bytes_per_pixel(t) }
target_has_depth(t: ptr) -> int { return aemt_ae_target_has_depth(t) }
target_samples(t: ptr) -> int { return aemt_ae_target_samples(t) }
target_resize(t: ptr, w: int, h: int) -> int { return aemt_ae_target_resize(t, w, h) }
target_set_readback(t: ptr, on: int) -> int { return aemt_ae_target_set_readback(t, on) }
target_readback(t: ptr) -> int { return aemt_ae_target_readback(t) }
target_set_frames(t: ptr, count: int) -> int { return aemt_ae_target_set_frames(t, count) }
target_frames(t: ptr) -> int { return aemt_ae_target_frames(t) }
target_set_timeout_ms(t: ptr, ms: int) -> int { return aemt_ae_target_set_timeout_ms(t, ms) }
rgba_size(t: ptr) -> int { return aemt_ae_rgba_size(t) }

// MSL source or a metallib: the vertex shader's one vertex function and the
// fragment shader's one fragment function.
pipeline_create(dev: ptr, t: ptr, vs: string, vs_len: int, fs: string, fs_len: int) -> ptr {
    return aemt_ae_pipeline_create(dev, t, vs, vs_len, fs, fs_len)
}
pipeline_create_ex(dev: ptr, t: ptr, vs: string, vs_len: int, fs: string, fs_len: int,
    layout: ptr, push_bytes: int, bindings: ptr) -> ptr {
    return aemt_ae_pipeline_create_ex(dev, t, vs, vs_len, fs, fs_len, layout, push_bytes, bindings)
}
pipeline_destroy(p: ptr) { aemt_ae_pipeline_destroy(p) }

// Attribute `location` is [[attribute(location)]]; stream `binding` is
// [[buffer(16 + binding)]]. An empty layout is a pipeline with no vertex
// input.
layout_create() -> ptr { return aemt_ae_layout_create() }
layout_destroy(l: ptr) { aemt_ae_layout_destroy(l) }
layout_binding(l: ptr, binding: int, stride: int, per_instance: int) -> int {
    return aemt_ae_layout_binding(l, binding, stride, per_instance)
}
layout_attr(l: ptr, location: int, binding: int, format: int, offset: int) -> int {
    return aemt_ae_layout_attr(l, location, binding, format, offset)
}

// Binding N is [[buffer(N)]] (uniform or storage), or [[texture(N)]] with
// [[sampler(N)]] (texture).
bindings_create() -> ptr { return aemt_ae_bindings_create() }
bindings_destroy(b: ptr) { aemt_ae_bindings_destroy(b) }
bindings_uniform(b: ptr, binding: int) -> int { return aemt_ae_bindings_uniform(b, binding) }
bindings_texture(b: ptr, binding: int) -> int { return aemt_ae_bindings_texture(b, binding) }
bindings_storage(b: ptr, binding: int) -> int { return aemt_ae_bindings_storage(b, binding) }

// An RGBA8 texture; upload before binding. A mipmapped one builds its chain
// on upload, on the GPU (generateMipmapsForTexture).
texture_create(dev: ptr, w: int, h: int) -> ptr { return aemt_ae_texture_create(dev, w, h) }
texture_create_ex(dev: ptr, w: int, h: int, mipmapped: int, linear: int, repeat: int) -> ptr {
    return aemt_ae_texture_create_ex(dev, w, h, mipmapped, linear, repeat)
}
texture_destroy(tex: ptr) { aemt_ae_texture_destroy(tex) }
texture_mip_levels(tex: ptr) -> int { return aemt_ae_texture_mip_levels(tex) }
// A 3D texture: `depth` slices of w x h RGBA, read through a texture3d. No
// mip chain. Upload w * h * depth * 4 bytes, slice after slice.
texture_create_3d(dev: ptr, w: int, h: int, depth: int, linear: int, repeat: int) -> ptr {
    return aemt_ae_texture_create_3d(dev, w, h, depth, linear, repeat)
}
texture_depth(tex: ptr) -> int { return aemt_ae_texture_depth(tex) }
texture_upload(tex: ptr, rgba: ptr, len: int) -> int { return aemt_ae_texture_upload(tex, rgba, len) }

set_uniform(p: ptr, binding: int, data: ptr, len: int) -> int { return aemt_ae_set_uniform(p, binding, data, len) }
set_texture(p: ptr, binding: int, tex: ptr) -> int { return aemt_ae_set_texture(p, binding, tex) }
// A target's newest frame where a texture goes: its colour, or its depth as
// a float (near 0, far 1). Draw the target first.
set_target(p: ptr, binding: int, t: ptr) -> int { return aemt_ae_set_target(p, binding, t, 0) }
set_target_depth(p: ptr, binding: int, t: ptr) -> int { return aemt_ae_set_target(p, binding, t, 1) }
set_buffer(p: ptr, binding: int, buf: ptr) -> int { return aemt_ae_set_buffer(p, binding, buf) }
uniform_floats(p: ptr, binding: int, count: int) -> int { return aemt_ae_uniform_floats(p, binding, count) }
uniform_float(p: ptr, binding: int, index: int, value: float) -> int {
    return aemt_ae_uniform_float(p, binding, index, value)
}

material_create(p: ptr) -> ptr { return aemt_ae_material_create(p) }
material_destroy(m: ptr) { aemt_ae_material_destroy(m) }
material_set_texture(m: ptr, binding: int, tex: ptr) -> int { return aemt_ae_material_set_texture(m, binding, tex) }
material_set_target(m: ptr, binding: int, t: ptr) -> int { return aemt_ae_material_set_target(m, binding, t, 0) }
material_set_target_depth(m: ptr, binding: int, t: ptr) -> int {
    return aemt_ae_material_set_target(m, binding, t, 1)
}
material_set_uniform(m: ptr, binding: int, data: ptr, len: int) -> int {
    return aemt_ae_material_set_uniform(m, binding, data, len)
}
material_set_buffer(m: ptr, binding: int, buf: ptr) -> int { return aemt_ae_material_set_buffer(m, binding, buf) }
material_floats(m: ptr, binding: int, count: int) -> int { return aemt_ae_material_floats(m, binding, count) }
material_float(m: ptr, binding: int, index: int, value: float) -> int {
    return aemt_ae_material_float(m, binding, index, value)
}

verts_reserve(t: ptr, count: int) -> int { return aemt_ae_verts_reserve(t, count) }
verts_reserve_n(t: ptr, count: int, floats_per_vertex: int) -> int {
    return aemt_ae_verts_reserve_n(t, count, floats_per_vertex)
}
verts_set(t: ptr, index: int, x: float, y: float, r: float, g: float, b: float) -> int {
    return aemt_ae_verts_set(t, index, x, y, r, g, b)
}
verts_set_float(t: ptr, float_index: int, value: float) -> int {
    return aemt_ae_verts_set_float(t, float_index, value)
}
indices_reserve(t: ptr, count: int) -> int { return aemt_ae_indices_reserve(t, count) }
indices_reserve_ex(t: ptr, count: int, bits: int) -> int { return aemt_ae_indices_reserve_ex(t, count, bits) }
indices_set(t: ptr, index: int, value: int) -> int { return aemt_ae_indices_set(t, index, value) }
set_push(t: ptr, data: ptr, len: int) -> int { return aemt_ae_set_push(t, data, len) }
push_floats(t: ptr, count: int) -> int { return aemt_ae_push_floats(t, count) }
push_float(t: ptr, index: int, value: float) -> int { return aemt_ae_push_float(t, index, value) }
batch_reset(t: ptr) -> int { return aemt_ae_batch_reset(t) }
batch_add(t: ptr, m: ptr, first: int, count: int) -> int { return aemt_ae_batch_add(t, m, first, count) }
batch_count(t: ptr) -> int { return aemt_ae_batch_count(t) }

// Instancing (#2198). Every draw of a target makes `count` instances unless
// a batch entry says otherwise; a per-instance stream advances once each.
target_set_instances(t: ptr, count: int) -> int { return aemt_ae_target_set_instances(t, count) }

// A target's depth read through a comparison sampler: a shadow map (#2373).
// The shader samples it with a reference depth and gets the fraction of the
// footprint whose depth passes `reference op texel`, `op` one of the
// COMPARE_* constants. Where target_depth_linear(t) is 1 the fraction is
// filtered across neighbouring texels (percentage-closer filtering in the
// sampler), and it is 0 or 1 otherwise.
set_target_depth_compare(p: ptr, binding: int, t: ptr, op: int) -> int {
    return aemt_ae_set_target_depth_compare(p, binding, t, op)
}
material_set_target_depth_compare(m: ptr, binding: int, t: ptr, op: int) -> int {
    return aemt_ae_material_set_target_depth_compare(m, binding, t, op)
}
target_depth_linear(t: ptr) -> int { return aemt_ae_target_depth_linear(t) }

// Pipeline state (#2385), described the way layouts and bindings are and
// passed to pipeline_create_state. A fresh state is the one every pipeline
// has: no blending, no culling, and with depth a LESS test that writes.
// state_depth sets the test (a COMPARE_* op, `fragment op stored`) and
// whether a passing fragment writes; it needs a target with depth.
state_create() -> ptr { return aemt_ae_state_create() }
state_destroy(s: ptr) { aemt_ae_state_destroy(s) }
state_blend(s: ptr, mode: int) -> int { return aemt_ae_state_blend(s, mode) }
state_cull(s: ptr, mode: int) -> int { return aemt_ae_state_cull(s, mode) }
state_depth(s: ptr, op: int, write: int) -> int { return aemt_ae_state_depth(s, op, write) }
state_topology(s: ptr, topology: int) -> int { return aemt_ae_state_topology(s, topology) }

// The stencil test (#2399): `reference compare stored`, both ANDed with
// `read_mask`; then `pass_op` where the stencil and depth tests pass,
// `fail_op` where the stencil test fails and `depth_fail_op` where only the
// depth test does, writing the bits of `write_mask`. The same for front and
// back faces. Needs a target made with DEPTH_STENCIL.
state_stencil(s: ptr, compare: int, ref: int, pass_op: int, fail_op: int, depth_fail_op: int,
              read_mask: int, write_mask: int) -> int {
    return aemt_ae_state_stencil(s, compare, ref, pass_op, fail_op, depth_fail_op, read_mask, write_mask)
}

// A batch entry's own stencil reference (#2399), 0..255, in place of the
// state's; -1 goes back to the state's.
batch_set_stencil_ref(t: ptr, item: int, ref: int) -> int { return aemt_ae_batch_set_stencil_ref(t, item, ref) }

// The channels a pipeline writes (#2411): COLOR_* bits, all four unless
// set. 0 writes no colour, for a draw that only marks the stencil or depth.
state_color_mask(s: ptr, mask: int) -> int { return aemt_ae_state_color_mask(s, mask) }

// A batch entry's own pipeline (#2411), made for the same target: one frame
// can mark a stencil with one pipeline and draw through it with another.
// The entry's material, if any, is one of that pipeline's; null goes back
// to the frame's pipeline. The pipeline must outlive the entry.
batch_set_pipeline(t: ptr, item: int, p: ptr) -> int { return aemt_ae_batch_set_pipeline(t, item, p) }

// A batch entry's scissor and viewport (#2398), in pixels from the target's
// top left in every module. The scissor must lie inside the target when the
// frame is drawn; a width of 0 sets either back to the whole target.
batch_set_scissor(t: ptr, item: int, x: int, y: int, w: int, h: int) -> int {
    return aemt_ae_batch_set_scissor(t, item, x, y, w, h)
}
batch_set_viewport(t: ptr, item: int, x: float, y: float, w: float, h: float,
                   min_depth: float, max_depth: float) -> int {
    return aemt_ae_batch_set_viewport(t, item, x, y, w, h, min_depth, max_depth)
}
pipeline_create_state(dev: ptr, t: ptr, vs: string, vlen: int, fs: string, flen: int,
                      layout: ptr, push_bytes: int, bindings: ptr, st: ptr) -> ptr {
    return aemt_ae_pipeline_create_state(dev, t, vs, vlen, fs, flen, layout, push_bytes, bindings, st)
}

// Cube maps and 2D arrays (#2387). A cube is six square faces uploaded +X,
// -X, +Y, -Y, +Z, -Z (size * size * 4 bytes each), and a shader picks the
// face and texel from a direction the same way in every module. An array is
// `layers` images uploaded one after another, read with the layer as the
// third coordinate. Mip chains are built per face and per layer.
texture_create_cube(dev: ptr, size: int, mipmapped: int, linear: int) -> ptr {
    return aemt_ae_texture_create_cube(dev, size, mipmapped, linear)
}
texture_create_array(dev: ptr, w: int, h: int, layers: int, mipmapped: int, linear: int, repeat: int) -> ptr {
    return aemt_ae_texture_create_array(dev, w, h, layers, mipmapped, linear, repeat)
}
// 6 for a cube, the layers of an array, 1 for a 2D or 3D texture.
texture_layers(tex: ptr) -> int { return aemt_ae_texture_layers(tex) }

// A target of `layers` layers (#2399), or with `cube` 1 a cube's six square
// faces: target_set_layer picks the one the next draws render into, each
// draw clearing only its own, and set_target_array / set_target_cube sample
// them all, as an array or as a cube. `depth` is 0, DEPTH or DEPTH_STENCIL,
// layered too. A layered target is single-sampled with one attachment.
target_create_layered(dev: ptr, w: int, h: int, layers: int, format: int, depth: int, cube: int) -> ptr {
    return aemt_ae_target_create_layered(dev, w, h, layers, format, depth, cube)
}
target_set_layer(t: ptr, layer: int) -> int { return aemt_ae_target_set_layer(t, layer) }
target_layers(t: ptr) -> int { return aemt_ae_target_layers(t) }
set_target_array(p: ptr, binding: int, t: ptr) -> int { return aemt_ae_set_target_array(p, binding, t) }
set_target_cube(p: ptr, binding: int, t: ptr) -> int { return aemt_ae_set_target_cube(p, binding, t) }
material_set_target_array(m: ptr, binding: int, t: ptr) -> int {
    return aemt_ae_material_set_target_array(m, binding, t)
}
material_set_target_cube(m: ptr, binding: int, t: ptr) -> int {
    return aemt_ae_material_set_target_cube(m, binding, t)
}

// A layered target multisampled `samples` times (#2412): each frame renders
// into one multisampled image and resolves into the layer drawn. Its depth
// is not sampled.
target_create_layered_ex(dev: ptr, w: int, h: int, layers: int, format: int, depth: int, cube: int,
                         samples: int) -> ptr {
    return aemt_ae_target_create_layered_ex(dev, w, h, layers, format, depth, cube, samples)
}

// A layered target's depth (#2412), every layer as a 2D array or a cube
// target's faces as a cube: raw with `op` 0, or through a comparison sampler
// with a COMPARE_* op, as cascaded shadow maps and a point light's shadow
// are read. A layer never drawn reads the far plane, 1.
set_target_depth_array(p: ptr, binding: int, t: ptr, op: int) -> int {
    return aemt_ae_set_target_depth_array(p, binding, t, op)
}
set_target_depth_cube(p: ptr, binding: int, t: ptr, op: int) -> int {
    return aemt_ae_set_target_depth_cube(p, binding, t, op)
}
material_set_target_depth_array(m: ptr, binding: int, t: ptr, op: int) -> int {
    return aemt_ae_material_set_target_depth_array(m, binding, t, op)
}
material_set_target_depth_cube(m: ptr, binding: int, t: ptr, op: int) -> int {
    return aemt_ae_material_set_target_depth_cube(m, binding, t, op)
}

// A 2D texture in any sampled format (#2397): FORMAT_R8_UNORM,
// FORMAT_R8G8_UNORM, FORMAT_R8G8B8A8_UNORM and _SRGB (sampled in linear
// values), FORMAT_R16G16B16A16_SFLOAT, FORMAT_R32G32B32A32_SFLOAT, and the
// BC block formats. `anisotropy` above 1 filters anisotropically, up to the
// device's limit, which texture_anisotropy reports. texture_upload takes
// level 0 and builds the rest of a mipmapped chain; a block format's chain
// cannot be built, so each level is uploaded with texture_upload_level, and
// the texture binds once every level has pixels. A format the device cannot
// sample is refused; texture_format_supported asks first.
texture_create_format(dev: ptr, w: int, h: int, format: int, mipmapped: int, linear: int, repeat: int,
                      anisotropy: int) -> ptr {
    return aemt_ae_texture_create_format(dev, w, h, format, mipmapped, linear, repeat, anisotropy)
}
texture_format_supported(dev: ptr, format: int) -> int { return aemt_ae_texture_format_supported(dev, format) }
texture_anisotropy(tex: ptr) -> int { return aemt_ae_texture_anisotropy(tex) }
texture_upload_level(tex: ptr, level: int, data: ptr, len: int) -> int {
    return aemt_ae_texture_upload_level(tex, level, data, len)
}

// A target with `count` colour attachments, 1..4 (#2386): a G-buffer in one
// draw. Attachment N is in format fN (a FORMAT_* value, unused past count)
// and fragment output N writes it; every one clears to the draw's colour and
// resolves when multisampled. Present, pixel, copy_rgba and save_png read
// attachment 0; pixel_value_at reads any.
target_create_mrt(dev: ptr, w: int, h: int, count: int, f0: int, f1: int, f2: int, f3: int,
                  depth: int, samples: int) -> ptr {
    return aemt_ae_target_create_mrt(dev, w, h, count, f0, f1, f2, f3, depth, samples)
}
target_attachments(t: ptr) -> int { return aemt_ae_target_attachments(t) }
// Colour attachment `n` of a target's newest frame, where a texture goes:
// set_target is attachment 0.
set_target_attachment(p: ptr, binding: int, t: ptr, n: int) -> int {
    return aemt_ae_set_target_attachment(p, binding, t, n)
}
material_set_target_attachment(m: ptr, binding: int, t: ptr, n: int) -> int {
    return aemt_ae_material_set_target_attachment(m, binding, t, n)
}
pixel_value_at(t: ptr, n: int, x: int, y: int, channel: int) -> float {
    return aemt_ae_pixel_value_at(t, n, x, y, channel)
}

// A texture compute passes write (#2388): 2D, or 3D when depth is above 1,
// in FORMAT_R8G8B8A8_UNORM, FORMAT_R16G16B16A16_SFLOAT or
// FORMAT_R32G32B32A32_SFLOAT. It starts zeroed; a pass writes it through a
// storage-texture binding, and draws sample it (by nearest texel) like any
// texture once the dispatch has run. texture_upload takes its own texel size.
texture_create_storage(dev: ptr, w: int, h: int, depth: int, format: int) -> ptr {
    return aemt_ae_texture_create_storage(dev, w, h, depth, format)
}
bindings_storage_texture(b: ptr, binding: int) -> int { return aemt_ae_bindings_storage_texture(b, binding) }
compute_set_storage_texture(c: ptr, binding: int, tex: ptr) -> int {
    return aemt_ae_compute_set_storage_texture(c, binding, tex)
}
target_instances(t: ptr) -> int { return aemt_ae_target_instances(t) }
// A buffer as vertex stream `binding`, 1..7: binding 0 is the target's own
// vertices. The pipeline's layout gives the stride and whether it advances
// per vertex or per instance; null unbinds it. A draw refuses a stream the
// pipeline reads that is unbound or shorter than what the draw reads. The
// buffer has to outlive the draws that use it.
vertex_stream(t: ptr, binding: int, buf: ptr) -> int { return aemt_ae_vertex_stream(t, binding, buf) }
// `instances` copies of indices (or vertices) first..first+count-1, the
// first of them instance `first_instance`.
batch_add_instanced(t: ptr, m: ptr, first: int, count: int, first_instance: int, instances: int) -> int {
    return aemt_ae_batch_add_instanced(t, m, first, count, first_instance, instances)
}
// `draws` commands read from `buf` at `offset` (a multiple of 4) when the
// frame runs. The commands are the GPU's to supply and are not checked
// against the geometry, as in the native APIs.
batch_add_indirect(t: ptr, m: ptr, buf: ptr, offset: int, draws: int) -> int {
    return aemt_ae_batch_add_indirect(t, m, buf, offset, draws)
}
// The offset batch entry `item` (0 is the first added) reads dynamic uniform
// `binding` at: a multiple of uniform_offset_alignment(dev).
batch_set_offset(t: ptr, item: int, binding: int, offset: int) -> int {
    return aemt_ae_batch_set_offset(t, item, binding, offset)
}
uniform_offset_alignment(dev: ptr) -> int { return aemt_ae_uniform_offset_alignment(dev) }
// A uniform read as a `bytes` window of the buffer set_buffer binds, at the
// offset each batch entry sets: one buffer holds every draw's block.
bindings_uniform_dynamic(b: ptr, binding: int, bytes: int) -> int {
    return aemt_ae_bindings_uniform_dynamic(b, binding, bytes)
}

// GPU time in milliseconds of the newest frame (or dispatch) the host waited
// for, start to end, readback copy included; -1 while timing is off or before
// a timed one has finished. ERR_UNSUPPORTED where the queue keeps no time.
target_set_timing(t: ptr, on: int) -> int { return aemt_ae_target_set_timing(t, on) }
target_gpu_ms(t: ptr) -> float { return aemt_ae_target_gpu_ms(t) }
compute_set_timing(c: ptr, on: int) -> int { return aemt_ae_compute_set_timing(c, on) }
compute_gpu_ms(c: ptr) -> float { return aemt_ae_compute_gpu_ms(c) }

draw(t: ptr, p: ptr, r: float, g: float, b: float, a: float) -> int { return aemt_ae_draw(t, p, r, g, b, a) }
draw_material(t: ptr, p: ptr, m: ptr, r: float, g: float, b: float, a: float) -> int {
    return aemt_ae_draw_material(t, p, m, r, g, b, a)
}
submit(t: ptr, p: ptr, r: float, g: float, b: float, a: float) -> int { return aemt_ae_submit(t, p, r, g, b, a) }
submit_material(t: ptr, p: ptr, m: ptr, r: float, g: float, b: float, a: float) -> int {
    return aemt_ae_submit_material(t, p, m, r, g, b, a)
}
wait_all(t: ptr) -> int { return aemt_ae_wait_all(t) }

copy_rgba(t: ptr, dest: ptr, dest_len: int) -> int { return aemt_ae_copy_rgba(t, dest, dest_len) }
copy_rgba8(t: ptr, dest: ptr, dest_len: int) -> int { return aemt_ae_copy_rgba8(t, dest, dest_len) }
pixel(t: ptr, x: int, y: int) -> long { return aemt_ae_pixel(t, x, y) }
pixel_value(t: ptr, x: int, y: int, channel: int) -> float { return aemt_ae_pixel_value(t, x, y, channel) }
save_ppm(t: ptr, path: string) -> int { return aemt_ae_save_ppm(t, path) }

// Writes the newest frame as a PNG (8-bit RGBA); "" on success.
save_png(t: ptr, path: string) -> string {
    w = aemt_ae_target_width(t)
    h = aemt_ae_target_height(t)
    if t == null || w <= 0 || h <= 0 { return "target is null" }
    buf = bytes.new(w * h * 4)
    bytes.set_length(buf, w * h * 4)
    rc = aemt_ae_copy_rgba8(t, bytes.data(buf), w * h * 4)
    if rc != 0 {
        bytes.free(buf)
        return aemt_ae_last_error()
    }
    err = png.write_rgba8(path, bytes.data(buf), w, h)
    bytes.free(buf)
    return err
}

// Channels of the packed value pixel() returns: a long, so every colour is
// non-negative and -1 means only "no pixel there".
red(px: long) -> int { return ((px >> 24) & 255) as int }
green(px: long) -> int { return ((px >> 16) & 255) as int }
blue(px: long) -> int { return ((px >> 8) & 255) as int }
alpha(px: long) -> int { return (px & 255) as int }

// A buffer shaders read and write (CPU-visible, mapped, zeroed).
buffer_create(dev: ptr, bytes: int) -> ptr { return aemt_ae_buffer_create(dev, bytes) }
buffer_destroy(b: ptr) { aemt_ae_buffer_destroy(b) }
buffer_size(b: ptr) -> int { return aemt_ae_buffer_size(b) }
buffer_write(b: ptr, offset: int, data: ptr, len: int) -> int { return aemt_ae_buffer_write(b, offset, data, len) }
buffer_read(b: ptr, offset: int, dest: ptr, len: int) -> int { return aemt_ae_buffer_read(b, offset, dest, len) }
buffer_set_float(b: ptr, index: int, value: float) -> int { return aemt_ae_buffer_set_float(b, index, value) }
buffer_float(b: ptr, index: int) -> float { return aemt_ae_buffer_float(b, index) }
buffer_set_int(b: ptr, index: int, value: int) -> int { return aemt_ae_buffer_set_int(b, index, value) }
buffer_int(b: ptr, index: int) -> int { return aemt_ae_buffer_int(b, index) }

// A compute pipeline from MSL or a metallib: its one kernel function.
compute_create(dev: ptr, cs: string, len: int, bindings: ptr, push_bytes: int) -> ptr {
    return aemt_ae_compute_create(dev, cs, len, bindings, push_bytes)
}
compute_destroy(c: ptr) { aemt_ae_compute_destroy(c) }
// The threads in one group: what [numthreads] gives in HLSL and local_size
// in GLSL. MSL does not declare it, so a dispatch is refused until it is set.
compute_set_group_size(c: ptr, x: int, y: int, z: int) -> int {
    return aemt_ae_compute_set_group_size(c, x, y, z)
}
compute_set_buffer(c: ptr, binding: int, buf: ptr) -> int { return aemt_ae_compute_set_buffer(c, binding, buf) }
compute_set_texture(c: ptr, binding: int, tex: ptr) -> int { return aemt_ae_compute_set_texture(c, binding, tex) }
compute_set_push(c: ptr, data: ptr, len: int) -> int { return aemt_ae_compute_set_push(c, data, len) }
compute_push_float(c: ptr, slot: int, value: float) -> int { return aemt_ae_compute_push_float(c, slot, value) }
compute_push_int(c: ptr, slot: int, value: int) -> int { return aemt_ae_compute_push_int(c, slot, value) }
compute_set_timeout_ms(c: ptr, ms: int) -> int { return aemt_ae_compute_set_timeout_ms(c, ms) }
dispatch(c: ptr, gx: int, gy: int, gz: int) -> int { return aemt_ae_dispatch(c, gx, gy, gz) }
dispatch_async(c: ptr, gx: int, gy: int, gz: int) -> int { return aemt_ae_dispatch_async(c, gx, gy, gz) }
compute_wait(c: ptr) -> int { return aemt_ae_compute_wait(c) }

// A swapchain over an NSView (kind WINDOW_NSVIEW, given a CAMetalLayer; on
// the main thread) or a CAMetalLayer (WINDOW_METAL_LAYER) the caller owns;
// display is unused. A view's size is followed, and presenting while its
// window is miniaturised shows nothing and succeeds. A bare layer takes the
// size given here and to swapchain_resize.
swapchain_create(dev: ptr, kind: int, display: ptr, window: ptr, w: int, h: int) -> ptr {
    return aemt_ae_swapchain_create(dev, kind, display, window, w, h)
}
swapchain_destroy(sc: ptr) { aemt_ae_swapchain_destroy(sc) }
swapchain_resize(sc: ptr, w: int, h: int) -> int { return aemt_ae_swapchain_resize(sc, w, h) }
swapchain_set_vsync(sc: ptr, on: int) -> int { return aemt_ae_swapchain_set_vsync(sc, on) }
swapchain_width(sc: ptr) -> int { return aemt_ae_swapchain_width(sc) }
swapchain_height(sc: ptr) -> int { return aemt_ae_swapchain_height(sc) }
swapchain_format(sc: ptr) -> int { return aemt_ae_swapchain_format(sc) }
swapchain_presented(sc: ptr) -> int { return aemt_ae_swapchain_presented(sc) }
// Shows the target's newest frame, scaled to the drawable and encoded for
// display when the target is sRGB or float.
present(sc: ptr, t: ptr) -> int { return aemt_ae_present(sc, t) }
