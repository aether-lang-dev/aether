#version 460
#extension GL_EXT_ray_query : require

// Two rays through one acceleration structure, one invocation each: the
// first from below the origin straight up through the triangle at z = 0, the
// second five units to the side where there is nothing. Each writes whether
// it hit a triangle and the distance at which it did.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
struct Result { uint hit; float t; };
layout(std430, set = 0, binding = 1) buffer Out { Result r[2]; } results;

void main() {
    uint i = gl_GlobalInvocationID.x;
    vec3 origin = vec3(i == 0u ? 0.0 : 5.0, i == 0u ? 0.0 : 5.0, -1.0);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 0xFFu, origin, 0.0, vec3(0.0, 0.0, 1.0), 10.0);
    while (rayQueryProceedEXT(q)) {}
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        results.r[i].hit = 1u;
        results.r[i].t = rayQueryGetIntersectionTEXT(q, true);
    } else {
        results.r[i].hit = 0u;
        results.r[i].t = -1.0;
    }
}
