#version 450

// Writes a triangle's three corners, scaled by a push constant, for
// pulled.vert to draw: compute output consumed by the graphics pipeline with
// no copy in between.
layout(local_size_x = 1) in;

layout(std430, binding = 0) writeonly buffer Positions { vec2 p[]; } positions;

layout(push_constant) uniform Push { float scale; } push;

void main() {
    const vec2 corners[3] = vec2[3](vec2(0.0, -1.0), vec2(-1.0, 1.0), vec2(1.0, 1.0));
    uint i = gl_GlobalInvocationID.x;
    positions.p[i] = corners[i] * push.scale;
}
