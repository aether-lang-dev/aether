#version 450

// out[i] = in[i] * in[i] * scale + offset + bias, and n[i] = n[i] * 3 + 7 in
// place: a float transform whose CPU twin is checked value by value, and an
// integer one that must be exact. Push constants carry the per-dispatch
// parameters and a uniform the per-material one, so every binding kind a
// compute pass uses is exercised.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Src { float v[]; } src;
layout(std430, binding = 1) writeonly buffer Dst { float v[]; } dst;
layout(std430, binding = 2) buffer Ints { int v[]; } ints;
layout(std140, binding = 3) uniform Params { float bias; } params;

layout(push_constant) uniform Push {
    float scale;
    float offset;
    uint  count;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count) return;
    float x = src.v[i];
    dst.v[i] = x * x * push.scale + push.offset + params.bias;
    ints.v[i] = ints.v[i] * 3 + 7;
}
