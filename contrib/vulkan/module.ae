// contrib.vulkan: offscreen GPU rendering (#1495, phase 1).
// Import with: import contrib.vulkan
//
//   vulkan.available()                  -> int     1 when a driver is usable
//   vulkan.device_name()                -> string  "" when none
//   vulkan.last_error()                 -> string
//
//   vulkan.device_create()              -> ptr     0 on failure
//   vulkan.device_destroy(dev)
//
//   vulkan.target_create(dev, w, h)     -> ptr     offscreen RGBA image
//   vulkan.target_create_ex(dev, w, h, depth, samples) -> ptr
//   vulkan.target_has_depth(t)          -> int
//   vulkan.target_samples(t)            -> int
//   vulkan.target_destroy(t)
//   vulkan.target_width(t)              -> int
//   vulkan.target_height(t)             -> int
//   vulkan.rgba_size(t)                 -> int     w * h * 4
//
//   vulkan.pipeline_create(dev, t, vert_spv, vert_len, frag_spv, frag_len) -> ptr
//   vulkan.pipeline_destroy(p)
//
//   vulkan.verts_reserve(t, count)      -> int     status
//   vulkan.verts_set(t, i, x, y, r, g, b) -> int   status
//   vulkan.draw(t, pipe, r, g, b, a)    -> int     status
//
// Past the built-in position+colour layout (#1508, #1509):
//
//   vulkan.layout_create()              -> ptr     describe vertex input
//   vulkan.layout_binding(l, binding, stride, per_instance) -> int
//   vulkan.layout_attr(l, location, binding, format, offset) -> int
//   vulkan.layout_destroy(l)
//
//   vulkan.bindings_create()            -> ptr     declare shader resources
//   vulkan.bindings_uniform(b, binding) -> int
//   vulkan.bindings_texture(b, binding) -> int
//   vulkan.bindings_destroy(b)
//
//   vulkan.pipeline_create_ex(dev, t, vspv, vlen, fspv, flen,
//                             layout, push_bytes, bindings) -> ptr
//
//   vulkan.texture_create(dev, w, h)    -> ptr     RGBA sampled image
//   vulkan.texture_create_ex(dev, w, h, mipmapped, linear, repeat) -> ptr
//   vulkan.texture_mip_levels(tex)      -> int
//   vulkan.texture_upload(tex, data, len) -> int   upload before binding
//   vulkan.texture_destroy(tex)
//   vulkan.set_texture(p, binding, tex) -> int
//   vulkan.set_uniform(p, binding, data, len) -> int
//   vulkan.uniform_floats(p, binding, count)  -> int
//   vulkan.uniform_float(p, binding, i, v)    -> int
//   vulkan.set_push(t, data, len)       -> int     at most 128 bytes
//   vulkan.push_floats(t, count)        -> int
//   vulkan.push_float(t, i, v)          -> int
//
//   vulkan.verts_reserve_n(t, count, floats_per_vertex) -> int
//   vulkan.verts_set_float(t, float_index, value)       -> int
//   vulkan.indices_reserve(t, count)    -> int     0 draws non-indexed
//   vulkan.indices_reserve_ex(t, count, bits) -> int   bits is 16 or 32
//   vulkan.indices_set(t, i, vertex)    -> int
//
//   vulkan.material_create(p)           -> ptr     one binding set per draw
//   vulkan.material_destroy(m)
//   vulkan.material_set_texture(m, binding, tex) -> int
//   vulkan.material_set_uniform(m, binding, data, len) -> int
//   vulkan.material_floats(m, binding, count)    -> int
//   vulkan.material_float(m, binding, i, v)      -> int
//   vulkan.batch_reset(t)               -> int     back to one draw
//   vulkan.batch_add(t, m, first, count) -> int    a draw inside the frame
//   vulkan.batch_count(t)               -> int
//   vulkan.draw_material(t, p, m, r, g, b, a)    -> int
//   vulkan.submit_material(t, p, m, r, g, b, a)  -> int
//   vulkan.pixel(t, x, y)               -> int     0xRRGGBBAA, -1 outside
//   vulkan.copy_rgba(t, dest, dest_len) -> int     status
//   vulkan.save_ppm(t, path)            -> int     status
//
// Colour formats and image files (#1514):
//
//   vulkan.target_create_format(dev, w, h, format, depth, samples) -> ptr
//   vulkan.target_format(t)             -> int     a FORMAT_* value
//   vulkan.target_bytes_per_pixel(t)    -> int     4, 8 or 16
//   vulkan.pixel_value(t, x, y, channel) -> float  exact, HDR values included
//   vulkan.copy_rgba8(t, dest, dest_len) -> int    8-bit RGBA whatever the format
//   vulkan.save_png(t, path)            -> string  "" on success
//
// Buffers and compute (#1515):
//
//   vulkan.buffer_create(dev, bytes)    -> ptr     mapped, zeroed
//   vulkan.buffer_destroy(b)
//   vulkan.buffer_size(b)               -> int
//   vulkan.buffer_set_float(b, i, v)    -> int     4-byte slot i
//   vulkan.buffer_float(b, i)           -> float
//   vulkan.buffer_set_int(b, i, v)      -> int
//   vulkan.buffer_int(b, i)             -> int
//   vulkan.buffer_write(b, offset, data, len) -> int
//   vulkan.buffer_read(b, offset, dest, len)  -> int
//   vulkan.bindings_storage(b, binding) -> int     std430 buffer binding
//   vulkan.compute_create(dev, spv, len, bindings, push_bytes) -> ptr
//   vulkan.compute_destroy(c)
//   vulkan.compute_set_buffer(c, binding, buf) -> int
//   vulkan.compute_set_texture(c, binding, tex) -> int
//   vulkan.compute_push_float(c, slot, v) -> int
//   vulkan.compute_push_int(c, slot, v) -> int
//   vulkan.dispatch(c, gx, gy, gz)      -> int     runs and waits
//   vulkan.dispatch_async(c, gx, gy, gz) -> int    runs; compute_wait later
//   vulkan.compute_wait(c)              -> int
//   vulkan.set_buffer(p, binding, buf)  -> int     a draw reads a buffer
//   vulkan.material_set_buffer(m, binding, buf) -> int
//
// Presenting to a window (#1505):
//
//   vulkan.swapchain_create(dev, kind, display, window, w, h) -> ptr
//   vulkan.swapchain_destroy(sc)
//   vulkan.swapchain_resize(sc, w, h)   -> int     status
//   vulkan.swapchain_set_vsync(sc, on)  -> int     status
//   vulkan.swapchain_width(sc)          -> int     0 while the window has no area
//   vulkan.swapchain_height(sc)         -> int
//   vulkan.swapchain_format(sc)         -> int     VkFormat of the images
//   vulkan.swapchain_presented(sc)      -> int     frames handed to the display
//   vulkan.present(sc, t)               -> int     the target's newest frame
//   vulkan.target_resize(t, w, h)       -> int     keeps every pipeline valid
//   vulkan.target_set_readback(t, on)   -> int     off: no per-frame copy out
//   vulkan.target_readback(t)           -> int
//
// The window is never this module's: `kind`, `display` and `window` are what
// the toolkit that owns it hands out, numbered as aether-ui's
// native_view_kind() numbers them (WINDOW_WIN32 = 1 ... WINDOW_WAYLAND = 4),
// plus WINDOW_METAL_LAYER for a program with its own CAMetalLayer.
//
// Nothing links against libvulkan: the loader is opened at runtime, so a
// program using this module builds and starts on a machine with no driver and
// vulkan.available() reports 0. Check it before anything else.
//
// Coordinates are Vulkan NDC: x and y run -1..1, y points DOWN, and a
// front-facing triangle is counter-clockwise. Colours are 0..1.
//
// Build:
//   - add contrib/vulkan/aether_vulkan.c to your aether.toml [[bin]]
//     extra_sources (or pass --extra)
//   - the Vulkan HEADERS must be on the include path (they are header-only;
//     no library is linked). On Debian/Ubuntu: libvulkan-dev. On macOS:
//     brew install vulkan-headers.
//   - on Linux add `link_flags = "-ldl"` for dlopen.

import std.bytes
import std.string
import contrib.png

exports (
    OK, ERR_NO_LOADER, ERR_NO_DEVICE, ERR_ARG, ERR_OOM,
    ERR_UNSUPPORTED, ERR_SHADER, ERR_DEVICE_LOST,
    aevk_ae_available, aevk_ae_last_error, aevk_ae_device_name,
    aevk_ae_device_create, aevk_ae_device_destroy,
    aevk_ae_target_create, aevk_ae_target_create_ex, aevk_ae_target_destroy,
