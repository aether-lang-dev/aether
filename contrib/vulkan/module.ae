// Status codes, mirroring aether_vulkan.h. A positive value is a VkResult
// passed through from the driver.
const OK = 0
const ERR_NO_LOADER = -1
const ERR_NO_DEVICE = -2
const ERR_ARG = -3
const ERR_OOM = -4
const ERR_UNSUPPORTED = -5
const ERR_SHADER = -6
const ERR_DEVICE_LOST = -7

available() -> int { return aevk_ae_available() }
last_error() -> string { return aevk_ae_last_error() }
device_name() -> string { return aevk_ae_device_name() }

device_create() -> ptr { return aevk_ae_device_create() }
device_destroy(dev: ptr) { aevk_ae_device_destroy(dev) }

target_create(dev: ptr, w: int, h: int) -> ptr { return aevk_ae_target_create(dev, w, h) }

// A target with an optional depth attachment and multisampling. Depth makes
// overlapping geometry resolve by distance instead of submission order;
// samples is 1, 2, 4, 8 or 16 and is checked against the device rather than
// rounded down. The multisampled image resolves into the single-sample one,
// so readback and pixel() are unchanged.
target_create_ex(dev: ptr, w: int, h: int, want_depth: int, samples: int) -> ptr {
    return aevk_ae_target_create_ex(dev, w, h, want_depth, samples)
}
target_has_depth(t: ptr) -> int { return aevk_ae_target_has_depth(t) }
target_samples(t: ptr) -> int { return aevk_ae_target_samples(t) }

// Frames in flight (1..8). One is the default and the synchronous shape:
// draw() records, submits and waits. Above one, submit() returns without
// waiting so the CPU records the next frame while the GPU works, and each
// slot carries its own readback buffer so a later frame cannot overwrite
// pixels an earlier one has not had read yet.
target_set_frames(t: ptr, count: int) -> int { return aevk_ae_target_set_frames(t, count) }
target_frames(t: ptr) -> int { return aevk_ae_target_frames(t) }

// The fence wait in milliseconds; the default 5000 is a hang detector, not a
// frame budget.
target_set_timeout_ms(t: ptr, ms: int) -> int { return aevk_ae_target_set_timeout_ms(t, ms) }

// Records and submits without waiting; returns the slot used, or a negative
// status. Blocks only when every slot is still in flight. pixel(), copy_rgba()
// and save_ppm() wait for the most recent frame on their own.
submit(t: ptr, p: ptr, r: float, g: float, b: float, a: float) -> int {
    return aevk_ae_submit(t, p, r, g, b, a)
}
wait_all(t: ptr) -> int { return aevk_ae_wait_all(t) }
target_destroy(t: ptr) { aevk_ae_target_destroy(t) }
target_width(t: ptr) -> int { return aevk_ae_target_width(t) }
target_height(t: ptr) -> int { return aevk_ae_target_height(t) }
rgba_size(t: ptr) -> int { return aevk_ae_rgba_size(t) }

pipeline_create(dev: ptr, t: ptr, vert_spv: string, vert_len: int,
                frag_spv: string, frag_len: int) -> ptr {
    return aevk_ae_pipeline_create(dev, t, vert_spv, vert_len, frag_spv, frag_len)
}
pipeline_destroy(p: ptr) { aevk_ae_pipeline_destroy(p) }

verts_reserve(t: ptr, count: int) -> int { return aevk_ae_verts_reserve(t, count) }

verts_set(t: ptr, index: int, x: float, y: float,
          r: float, g: float, b: float) -> int {
    return aevk_ae_verts_set(t, index, x, y, r, g, b)
}

draw(t: ptr, p: ptr, r: float, g: float, b: float, a: float) -> int {
    return aevk_ae_draw(t, p, r, g, b, a)
}

copy_rgba(t: ptr, dest: ptr, dest_len: int) -> int {
    return aevk_ae_copy_rgba(t, dest, dest_len)
}

pixel(t: ptr, x: int, y: int) -> long { return aevk_ae_pixel(t, x, y) }
save_ppm(t: ptr, path: string) -> int { return aevk_ae_save_ppm(t, path) }

// VkFormat values, spelled out so a caller never needs the Vulkan headers:
// for layout_attr to describe its own vertices, and (the four RGBA ones) for
// target_create_format.
const FORMAT_R32_SFLOAT = 100
const FORMAT_R32G32_SFLOAT = 103
const FORMAT_R32G32B32_SFLOAT = 106
const FORMAT_R32G32B32A32_SFLOAT = 109
const FORMAT_R8G8B8A8_UNORM = 37
const FORMAT_R8G8B8A8_SRGB = 43
// Sampled texture formats (#2397): one and two 8-bit channels, and the BC
// block formats, 4x4 texels a block of 8 (BC1, BC4) or 16 bytes (BC3, BC5,
// BC7). Numbered as this module's API numbers them, like the rest.
const FORMAT_R8_UNORM = 9
const FORMAT_R8G8_UNORM = 16
const FORMAT_BC1_RGBA_UNORM = 133
const FORMAT_BC1_RGBA_SRGB = 134
const FORMAT_BC3_UNORM = 137
const FORMAT_BC3_SRGB = 138
const FORMAT_BC4_UNORM = 139
const FORMAT_BC5_UNORM = 141
const FORMAT_BC7_UNORM = 145
const FORMAT_BC7_SRGB = 146
// More sampled formats (#2402): signed normalised ones, which read -1..1, BC6H
// for HDR, and the ETC2 and ASTC 4x4 block formats (8 bytes a block for
// ETC2 RGB, 16 for the rest).
// ETC2 and ASTC are sampled where the GPU has them (Apple and mobile GPUs,
// lavapipe), as texture_format_supported reports.
const FORMAT_R8_SNORM = 10
const FORMAT_R8G8_SNORM = 17
const FORMAT_BC4_SNORM = 140
const FORMAT_BC5_SNORM = 142
const FORMAT_BC6H_UFLOAT = 143
const FORMAT_BC6H_SFLOAT = 144
const FORMAT_ETC2_R8G8B8_UNORM = 147
const FORMAT_ETC2_R8G8B8_SRGB = 148
const FORMAT_ETC2_R8G8B8A8_UNORM = 151
const FORMAT_ETC2_R8G8B8A8_SRGB = 152
const FORMAT_ASTC_4x4_UNORM = 157
const FORMAT_ASTC_4x4_SRGB = 158
const FORMAT_R16G16B16A16_SFLOAT = 97

// Input rate for layout_binding.
const PER_VERTEX = 0
const PER_INSTANCE = 1

// Compare ops for reading a depth through a comparison sampler (#2373): a
// texel passes when `reference op texel`.
const COMPARE_LESS = 1
const COMPARE_LESS_EQUAL = 2
const COMPARE_GREATER = 3
const COMPARE_GREATER_EQUAL = 4
// The rest of the compare ops (#2399), for the stencil test, the depth test
// and comparison samplers alike.
const COMPARE_EQUAL = 5
const COMPARE_NOT_EQUAL = 6
const COMPARE_ALWAYS = 7
const COMPARE_NEVER = 8

// A target's depth (#2399): the last-but-one argument of every target
// create, 0 for none, DEPTH, or DEPTH_STENCIL for a depth with an 8-bit
// stencil, cleared to 0 with the depth.
const DEPTH = 1
const DEPTH_STENCIL = 2

// What the stencil test does to the stored value (#2399): numbered as
// Vulkan's VkStencilOp in every module.
const STENCIL_KEEP = 0
const STENCIL_ZERO = 1
const STENCIL_REPLACE = 2              // the reference
const STENCIL_INCREMENT_CLAMP = 3
const STENCIL_DECREMENT_CLAMP = 4
const STENCIL_INVERT = 5
const STENCIL_INCREMENT_WRAP = 6
const STENCIL_DECREMENT_WRAP = 7

// The channels a pipeline writes (#2411), for state_color_mask: bits as
// Vulkan's VkColorComponentFlagBits number them, in every module.
const COLOR_RED = 1
const COLOR_GREEN = 2
const COLOR_BLUE = 4
const COLOR_ALPHA = 8
const COLOR_ALL = 15

// Pipeline state (#2385): how a fragment's colour meets the target's, and
// which faces are culled. A face is front-facing when its corners run
// counter-clockwise on screen, in every module.
const BLEND_NONE = 0           // replace
const BLEND_ALPHA = 1          // src * a + dst * (1 - a)
const BLEND_PREMULTIPLIED = 2  // src + dst * (1 - a)
const BLEND_ADDITIVE = 3       // src + dst
const CULL_NONE = 0
const CULL_BACK = 1
const CULL_FRONT = 2

// What a pipeline's vertices assemble into (#2398). A point's size comes
// from the vertex shader where the API reads one (gl_PointSize in Vulkan,
// [[point_size]] in Metal); Direct3D 12 draws points one pixel wide.
const TOPOLOGY_TRIANGLES = 0
const TOPOLOGY_TRIANGLE_STRIP = 1
const TOPOLOGY_LINES = 2
const TOPOLOGY_LINE_STRIP = 3
const TOPOLOGY_POINTS = 4

// A vertex layout: one or more interleaved streams, each with attributes at
// byte offsets. Without one a pipeline uses the built-in position+colour
// layout, so existing code needs no change. An empty one, with nothing
// described, is a pipeline with no vertex input: its vertex shader pulls
// what it needs from a buffer by gl_VertexIndex, and verts_reserve still
// sets how many vertices a draw runs.
layout_create() -> ptr { return aevk_ae_layout_create() }
layout_destroy(l: ptr) { aevk_ae_layout_destroy(l) }

layout_binding(l: ptr, binding: int, stride: int, per_instance: int) -> int {
    return aevk_ae_layout_binding(l, binding, stride, per_instance)
}

layout_attr(l: ptr, location: int, binding: int, format: int, offset: int) -> int {
    return aevk_ae_layout_attr(l, location, binding, format, offset)
}

// What the shader reads besides vertex attributes.
bindings_create() -> ptr { return aevk_ae_bindings_create() }
bindings_destroy(b: ptr) { aevk_ae_bindings_destroy(b) }
bindings_uniform(b: ptr, binding: int) -> int { return aevk_ae_bindings_uniform(b, binding) }
bindings_texture(b: ptr, binding: int) -> int { return aevk_ae_bindings_texture(b, binding) }

// Pipeline with a vertex layout, a push-constant block and shader resources.
// Pass 0 for a layout or bindings handle to leave that part at the default.
pipeline_create_ex(dev: ptr, t: ptr, vert_spv: string, vert_len: int,
                   frag_spv: string, frag_len: int, layout: ptr,
                   push_bytes: int, bindings: ptr) -> ptr {
    return aevk_ae_pipeline_create_ex(dev, t, vert_spv, vert_len, frag_spv,
                                      frag_len, layout, push_bytes, bindings)
}

// An RGBA texture. Upload before binding: an image with no pixels has no
// defined contents to sample, so binding one is refused rather than drawn.
texture_create(dev: ptr, w: int, h: int) -> ptr { return aevk_ae_texture_create(dev, w, h) }
// As above with a mip chain and sampler choices. A mipmapped texture stops
// aliasing when it is drawn smaller than it is; `linear` filters instead of
// picking the nearest texel, and `repeat` wraps instead of clamping at the
// edge. Mipmaps need the device to support linear blitting, and creation
// fails rather than returning a texture with an empty chain when it does not.
texture_create_ex(dev: ptr, w: int, h: int, mipmapped: int,
                  linear: int, repeat: int) -> ptr {
    return aevk_ae_texture_create_ex(dev, w, h, mipmapped, linear, repeat)
}

// Levels in the chain: 1 for a texture created without mipmaps.
texture_mip_levels(tex: ptr) -> int { return aevk_ae_texture_mip_levels(tex) }

// A 3D texture: `depth` slices of w x h RGBA, read through a sampler3D (the
// clouds' tileable noise, a colour grading cube). No mip chain. Upload
// w * h * depth * 4 bytes, slice after slice.
texture_create_3d(dev: ptr, w: int, h: int, depth: int, linear: int, repeat: int) -> ptr {
    return aevk_ae_texture_create_3d(dev, w, h, depth, linear, repeat)
}

// Slices: 1 for a 2D texture.
texture_depth(tex: ptr) -> int { return aevk_ae_texture_depth(tex) }

texture_destroy(tex: ptr) { aevk_ae_texture_destroy(tex) }
texture_upload(tex: ptr, rgba: ptr, len: int) -> int {
    return aevk_ae_texture_upload(tex, rgba, len)
}

set_uniform(p: ptr, binding: int, data: ptr, len: int) -> int {
    return aevk_ae_set_uniform(p, binding, data, len)
}
set_texture(p: ptr, binding: int, tex: ptr) -> int {
    return aevk_ae_set_texture(p, binding, tex)
}

// A target's newest frame where a texture goes: its colour, or its depth as
// a single-channel float (near 0, far 1). Draw the target first.
set_target(p: ptr, binding: int, t: ptr) -> int {
    return aevk_ae_set_target(p, binding, t, 0)
}
set_target_depth(p: ptr, binding: int, t: ptr) -> int {
    return aevk_ae_set_target(p, binding, t, 1)
}
set_push(t: ptr, data: ptr, len: int) -> int { return aevk_ae_set_push(t, data, len) }

// Float staging, so a caller writes a matrix or a colour as numbers instead
// of packing IEEE bytes by hand.
push_floats(t: ptr, count: int) -> int { return aevk_ae_push_floats(t, count) }
push_float(t: ptr, index: int, value: float) -> int {
    return aevk_ae_push_float(t, index, value)
}
uniform_floats(p: ptr, binding: int, count: int) -> int {
    return aevk_ae_uniform_floats(p, binding, count)
}
uniform_float(p: ptr, binding: int, index: int, value: float) -> int {
    return aevk_ae_uniform_float(p, binding, index, value)
}

// Vertices for a caller-described layout: reserve by floats-per-vertex, then
// write floats by flat index. verts_reserve / verts_set stay the shorthand
// for the built-in five-float layout.
verts_reserve_n(t: ptr, count: int, floats_per_vertex: int) -> int {
    return aevk_ae_verts_reserve_n(t, count, floats_per_vertex)
}
verts_set_float(t: ptr, float_index: int, value: float) -> int {
    return aevk_ae_verts_set_float(t, float_index, value)
}

// 32-bit indices. Reserving 0 goes back to non-indexed drawing.
indices_reserve(t: ptr, count: int) -> int { return aevk_ae_indices_reserve(t, count) }
indices_set(t: ptr, index: int, value: int) -> int { return aevk_ae_indices_set(t, index, value) }

// 16-bit indices halve the index buffer for meshes under 65536 vertices,
// which is most of them. `bits` is 16 or 32; a value that will not fit in the
// chosen width is refused at indices_set rather than wrapping silently.
indices_reserve_ex(t: ptr, count: int, bits: int) -> int {
    return aevk_ae_indices_reserve_ex(t, count, bits)
}

// A material is one set of bound resources: draw two quads with different
// textures in a single frame by making two materials from one pipeline,
// instead of rebinding between draws and having the second overwrite the
// first. The pipeline's own set_texture / uniform_float keep working; they
// address its default material.
material_create(p: ptr) -> ptr { return aevk_ae_material_create(p) }
material_destroy(m: ptr) { aevk_ae_material_destroy(m) }
material_set_texture(m: ptr, binding: int, tex: ptr) -> int {
    return aevk_ae_material_set_texture(m, binding, tex)
}
material_set_target(m: ptr, binding: int, t: ptr) -> int {
    return aevk_ae_material_set_target(m, binding, t, 0)
}
material_set_target_depth(m: ptr, binding: int, t: ptr) -> int {
    return aevk_ae_material_set_target(m, binding, t, 1)
}
material_set_uniform(m: ptr, binding: int, data: ptr, len: int) -> int {
    return aevk_ae_material_set_uniform(m, binding, data, len)
}
material_floats(m: ptr, binding: int, count: int) -> int {
    return aevk_ae_material_floats(m, binding, count)
}
material_float(m: ptr, binding: int, index: int, value: float) -> int {
    return aevk_ae_material_float(m, binding, index, value)
}

// A batch is several draws inside one frame, each with its own material:
// two quads with different textures without rebinding between them. Each
// entry slices the geometry already uploaded, by index when the target has
// an index buffer and by vertex otherwise. An empty batch, the default,
// draws everything once.
//
// A material a batch refers to has to outlive the draws that use it: destroy
// one without resetting the batch and the next frame reads freed memory.
batch_reset(t: ptr) -> int { return aevk_ae_batch_reset(t) }
batch_add(t: ptr, m: ptr, first: int, count: int) -> int {
    return aevk_ae_batch_add(t, m, first, count)
}
batch_count(t: ptr) -> int { return aevk_ae_batch_count(t) }

// Instancing (#2198). Every draw of a target makes `count` instances unless
// a batch entry says otherwise; a per-instance stream advances once each.
target_set_instances(t: ptr, count: int) -> int { return aevk_ae_target_set_instances(t, count) }

// A target's depth read through a comparison sampler: a shadow map (#2373).
// The shader samples it with a reference depth and gets the fraction of the
// footprint whose depth passes `reference op texel`, `op` one of the
// COMPARE_* constants. Where target_depth_linear(t) is 1 the fraction is
// filtered across neighbouring texels (percentage-closer filtering in the
// sampler), and it is 0 or 1 otherwise.
set_target_depth_compare(p: ptr, binding: int, t: ptr, op: int) -> int {
    return aevk_ae_set_target_depth_compare(p, binding, t, op)
}
material_set_target_depth_compare(m: ptr, binding: int, t: ptr, op: int) -> int {
    return aevk_ae_material_set_target_depth_compare(m, binding, t, op)
}
target_depth_linear(t: ptr) -> int { return aevk_ae_target_depth_linear(t) }

// Pipeline state (#2385), described the way layouts and bindings are and
// passed to pipeline_create_state. A fresh state is the one every pipeline
// has: no blending, no culling, and with depth a LESS test that writes.
// state_depth sets the test (a COMPARE_* op, `fragment op stored`) and
// whether a passing fragment writes; it needs a target with depth.
state_create() -> ptr { return aevk_ae_state_create() }
state_destroy(s: ptr) { aevk_ae_state_destroy(s) }
state_blend(s: ptr, mode: int) -> int { return aevk_ae_state_blend(s, mode) }
state_cull(s: ptr, mode: int) -> int { return aevk_ae_state_cull(s, mode) }
state_depth(s: ptr, op: int, write: int) -> int { return aevk_ae_state_depth(s, op, write) }
state_topology(s: ptr, topology: int) -> int { return aevk_ae_state_topology(s, topology) }

// The stencil test (#2399): `reference compare stored`, both ANDed with
// `read_mask`; then `pass_op` where the stencil and depth tests pass,
// `fail_op` where the stencil test fails and `depth_fail_op` where only the
// depth test does, writing the bits of `write_mask`. The same for front and
// back faces. Needs a target made with DEPTH_STENCIL.
state_stencil(s: ptr, compare: int, ref: int, pass_op: int, fail_op: int, depth_fail_op: int,
              read_mask: int, write_mask: int) -> int {
    return aevk_ae_state_stencil(s, compare, ref, pass_op, fail_op, depth_fail_op, read_mask, write_mask)
}

// A batch entry's own stencil reference (#2399), 0..255, in place of the
// state's; -1 goes back to the state's.
batch_set_stencil_ref(t: ptr, item: int, ref: int) -> int { return aevk_ae_batch_set_stencil_ref(t, item, ref) }

// The channels a pipeline writes (#2411): COLOR_* bits, all four unless
// set. 0 writes no colour, for a draw that only marks the stencil or depth.
state_color_mask(s: ptr, mask: int) -> int { return aevk_ae_state_color_mask(s, mask) }

// A batch entry's own pipeline (#2411), made for the same target: one frame
// can mark a stencil with one pipeline and draw through it with another.
// The entry's material, if any, is one of that pipeline's; null goes back
// to the frame's pipeline. The pipeline must outlive the entry.
batch_set_pipeline(t: ptr, item: int, p: ptr) -> int { return aevk_ae_batch_set_pipeline(t, item, p) }

// A batch entry's scissor and viewport (#2398), in pixels from the target's
// top left in every module. The scissor must lie inside the target when the
// frame is drawn; a width of 0 sets either back to the whole target.
batch_set_scissor(t: ptr, item: int, x: int, y: int, w: int, h: int) -> int {
    return aevk_ae_batch_set_scissor(t, item, x, y, w, h)
}
batch_set_viewport(t: ptr, item: int, x: float, y: float, w: float, h: float,
                   min_depth: float, max_depth: float) -> int {
    return aevk_ae_batch_set_viewport(t, item, x, y, w, h, min_depth, max_depth)
}
pipeline_create_state(dev: ptr, t: ptr, vs: string, vlen: int, fs: string, flen: int,
                      layout: ptr, push_bytes: int, bindings: ptr, st: ptr) -> ptr {
    return aevk_ae_pipeline_create_state(dev, t, vs, vlen, fs, flen, layout, push_bytes, bindings, st)
}

// Cube maps and 2D arrays (#2387). A cube is six square faces uploaded +X,
// -X, +Y, -Y, +Z, -Z (size * size * 4 bytes each), and a shader picks the
// face and texel from a direction the same way in every module. An array is
// `layers` images uploaded one after another, read with the layer as the
// third coordinate. Mip chains are built per face and per layer.
texture_create_cube(dev: ptr, size: int, mipmapped: int, linear: int) -> ptr {
    return aevk_ae_texture_create_cube(dev, size, mipmapped, linear)
}
texture_create_array(dev: ptr, w: int, h: int, layers: int, mipmapped: int, linear: int, repeat: int) -> ptr {
    return aevk_ae_texture_create_array(dev, w, h, layers, mipmapped, linear, repeat)
}
// 6 for a cube, the layers of an array, 1 for a 2D or 3D texture.
texture_layers(tex: ptr) -> int { return aevk_ae_texture_layers(tex) }

// A target of `layers` layers (#2399), or with `cube` 1 a cube's six square
// faces: target_set_layer picks the one the next draws render into, each
// draw clearing only its own, and set_target_array / set_target_cube sample
// them all, as an array or as a cube. `depth` is 0, DEPTH or DEPTH_STENCIL,
// layered too. A layered target is single-sampled with one attachment.
target_create_layered(dev: ptr, w: int, h: int, layers: int, format: int, depth: int, cube: int) -> ptr {
    return aevk_ae_target_create_layered(dev, w, h, layers, format, depth, cube)
}
target_set_layer(t: ptr, layer: int) -> int { return aevk_ae_target_set_layer(t, layer) }
target_layers(t: ptr) -> int { return aevk_ae_target_layers(t) }
set_target_array(p: ptr, binding: int, t: ptr) -> int { return aevk_ae_set_target_array(p, binding, t) }
set_target_cube(p: ptr, binding: int, t: ptr) -> int { return aevk_ae_set_target_cube(p, binding, t) }
material_set_target_array(m: ptr, binding: int, t: ptr) -> int {
    return aevk_ae_material_set_target_array(m, binding, t)
}
material_set_target_cube(m: ptr, binding: int, t: ptr) -> int {
    return aevk_ae_material_set_target_cube(m, binding, t)
}

// A layered target multisampled `samples` times (#2412): each frame renders
// into one multisampled image and resolves into the layer drawn. Its depth
// is not sampled.
target_create_layered_ex(dev: ptr, w: int, h: int, layers: int, format: int, depth: int, cube: int,
                         samples: int) -> ptr {
    return aevk_ae_target_create_layered_ex(dev, w, h, layers, format, depth, cube, samples)
}

// A layered target's depth (#2412), every layer as a 2D array or a cube
// target's faces as a cube: raw with `op` 0, or through a comparison sampler
// with a COMPARE_* op, as cascaded shadow maps and a point light's shadow
// are read. A layer never drawn reads the far plane, 1.
set_target_depth_array(p: ptr, binding: int, t: ptr, op: int) -> int {
    return aevk_ae_set_target_depth_array(p, binding, t, op)
}
set_target_depth_cube(p: ptr, binding: int, t: ptr, op: int) -> int {
    return aevk_ae_set_target_depth_cube(p, binding, t, op)
}
material_set_target_depth_array(m: ptr, binding: int, t: ptr, op: int) -> int {
    return aevk_ae_material_set_target_depth_array(m, binding, t, op)
}
material_set_target_depth_cube(m: ptr, binding: int, t: ptr, op: int) -> int {
    return aevk_ae_material_set_target_depth_cube(m, binding, t, op)
}

// A 2D texture in any sampled format (#2397): FORMAT_R8_UNORM,
// FORMAT_R8G8_UNORM, FORMAT_R8G8B8A8_UNORM and _SRGB (sampled in linear
// values), FORMAT_R16G16B16A16_SFLOAT, FORMAT_R32G32B32A32_SFLOAT, and the
// BC block formats. `anisotropy` above 1 filters anisotropically, up to the
// device's limit, which texture_anisotropy reports. texture_upload takes
// level 0 and builds the rest of a mipmapped chain; a block format's chain
// cannot be built, so each level is uploaded with texture_upload_level, and
// the texture binds once every level has pixels. A format the device cannot
// sample is refused; texture_format_supported asks first.
texture_create_format(dev: ptr, w: int, h: int, format: int, mipmapped: int, linear: int, repeat: int,
                      anisotropy: int) -> ptr {
    return aevk_ae_texture_create_format(dev, w, h, format, mipmapped, linear, repeat, anisotropy)
}
texture_format_supported(dev: ptr, format: int) -> int { return aevk_ae_texture_format_supported(dev, format) }
texture_anisotropy(tex: ptr) -> int { return aevk_ae_texture_anisotropy(tex) }

// A cube map or a 2D array in any sampled format (#2402): a BC6H sky, BC7
// terrain layers, an sRGB atlas. Layers upload one after another, a block
// format's level by level with texture_upload_level.
texture_create_cube_format(dev: ptr, size: int, format: int, mipmapped: int, linear: int) -> ptr {
    return aevk_ae_texture_create_cube_format(dev, size, format, mipmapped, linear)
}
texture_create_array_format(dev: ptr, w: int, h: int, layers: int, format: int, mipmapped: int, linear: int,
                            repeat: int) -> ptr {
    return aevk_ae_texture_create_array_format(dev, w, h, layers, format, mipmapped, linear, repeat)
}
texture_upload_level(tex: ptr, level: int, data: ptr, len: int) -> int {
    return aevk_ae_texture_upload_level(tex, level, data, len)
}

// A target with `count` colour attachments, 1..4 (#2386): a G-buffer in one
// draw. Attachment N is in format fN (a FORMAT_* value, unused past count)
// and fragment output N writes it; every one clears to the draw's colour and
// resolves when multisampled. Present, pixel, copy_rgba and save_png read
// attachment 0; pixel_value_at reads any.
target_create_mrt(dev: ptr, w: int, h: int, count: int, f0: int, f1: int, f2: int, f3: int,
                  depth: int, samples: int) -> ptr {
    return aevk_ae_target_create_mrt(dev, w, h, count, f0, f1, f2, f3, depth, samples)
}
target_attachments(t: ptr) -> int { return aevk_ae_target_attachments(t) }
// Colour attachment `n` of a target's newest frame, where a texture goes:
// set_target is attachment 0.
set_target_attachment(p: ptr, binding: int, t: ptr, n: int) -> int {
    return aevk_ae_set_target_attachment(p, binding, t, n)
}
material_set_target_attachment(m: ptr, binding: int, t: ptr, n: int) -> int {
    return aevk_ae_material_set_target_attachment(m, binding, t, n)
}
pixel_value_at(t: ptr, n: int, x: int, y: int, channel: int) -> float {
    return aevk_ae_pixel_value_at(t, n, x, y, channel)
}

// A texture compute passes write (#2388): 2D, or 3D when depth is above 1,
// in FORMAT_R8G8B8A8_UNORM, FORMAT_R16G16B16A16_SFLOAT or
// FORMAT_R32G32B32A32_SFLOAT. It starts zeroed; a pass writes it through a
// storage-texture binding, and draws sample it (by nearest texel) like any
// texture once the dispatch has run. texture_upload takes its own texel size.
texture_create_storage(dev: ptr, w: int, h: int, depth: int, format: int) -> ptr {
    return aevk_ae_texture_create_storage(dev, w, h, depth, format)
}
bindings_storage_texture(b: ptr, binding: int) -> int { return aevk_ae_bindings_storage_texture(b, binding) }
compute_set_storage_texture(c: ptr, binding: int, tex: ptr) -> int {
    return aevk_ae_compute_set_storage_texture(c, binding, tex)
}
target_instances(t: ptr) -> int { return aevk_ae_target_instances(t) }
// A buffer as vertex stream `binding`, 1..7: binding 0 is the target's own
// vertices. The pipeline's layout gives the stride and whether it advances
// per vertex or per instance; null unbinds it. A draw refuses a stream the
// pipeline reads that is unbound or shorter than what the draw reads. The
// buffer has to outlive the draws that use it.
vertex_stream(t: ptr, binding: int, buf: ptr) -> int { return aevk_ae_vertex_stream(t, binding, buf) }
// `instances` copies of indices (or vertices) first..first+count-1, the
// first of them instance `first_instance`.
batch_add_instanced(t: ptr, m: ptr, first: int, count: int, first_instance: int, instances: int) -> int {
    return aevk_ae_batch_add_instanced(t, m, first, count, first_instance, instances)
}
// `draws` commands read from `buf` at `offset` (a multiple of 4) when the
// frame runs. The commands are the GPU's to supply and are not checked
// against the geometry, as in the native APIs.
batch_add_indirect(t: ptr, m: ptr, buf: ptr, offset: int, draws: int) -> int {
    return aevk_ae_batch_add_indirect(t, m, buf, offset, draws)
}
// The offset batch entry `item` (0 is the first added) reads dynamic uniform
// `binding` at: a multiple of uniform_offset_alignment(dev).
batch_set_offset(t: ptr, item: int, binding: int, offset: int) -> int {
    return aevk_ae_batch_set_offset(t, item, binding, offset)
}
uniform_offset_alignment(dev: ptr) -> int { return aevk_ae_uniform_offset_alignment(dev) }
// A uniform read as a `bytes` window of the buffer set_buffer binds, at the
// offset each batch entry sets: one buffer holds every draw's block.
bindings_uniform_dynamic(b: ptr, binding: int, bytes: int) -> int {
    return aevk_ae_bindings_uniform_dynamic(b, binding, bytes)
}

// GPU time in milliseconds of the newest frame (or dispatch) the host waited
// for, start to end, readback copy included; -1 while timing is off or before
// a timed one has finished. ERR_UNSUPPORTED where the queue keeps no time.
target_set_timing(t: ptr, on: int) -> int { return aevk_ae_target_set_timing(t, on) }
target_gpu_ms(t: ptr) -> float { return aevk_ae_target_gpu_ms(t) }
compute_set_timing(c: ptr, on: int) -> int { return aevk_ae_compute_set_timing(c, on) }
compute_gpu_ms(c: ptr) -> float { return aevk_ae_compute_gpu_ms(c) }

// draw_material blocks like draw; submit_material pipelines like submit.
// Passing a null material uses the pipeline's default one.
draw_material(t: ptr, p: ptr, m: ptr, r: float, g: float, b: float, a: float) -> int {
    return aevk_ae_draw_material(t, p, m, r, g, b, a)
}
submit_material(t: ptr, p: ptr, m: ptr, r: float, g: float, b: float, a: float) -> int {
    return aevk_ae_submit_material(t, p, m, r, g, b, a)
}

// Channel accessors for the packed value pixel() returns. pixel() is a long
// so every colour (opaque white is 0xFFFFFFFF) is non-negative and -1 means
// only "no pixel there".
red(px: long) -> int { return ((px >> 24) & 255) as int }
green(px: long) -> int { return ((px >> 16) & 255) as int }
blue(px: long) -> int { return ((px >> 8) & 255) as int }
alpha(px: long) -> int { return (px & 255) as int }

// ---------------------------------------------------------------------------
// Presenting to a window (#1505)
// ---------------------------------------------------------------------------

// Window kinds, numbered as aether-ui's native_view_kind(). The display
// argument is the connection the handle belongs to where the window system
// has one (X11's Display*, Wayland's wl_display*) and null otherwise.
const WINDOW_WIN32 = 1         // window: HWND
const WINDOW_NSVIEW = 2        // window: NSView*, given a CAMetalLayer (main thread)
const WINDOW_X11 = 3           // display: Display*, window: Window
const WINDOW_WAYLAND = 4       // display: wl_display*, window: wl_surface*
const WINDOW_METAL_LAYER = 5   // window: CAMetalLayer* the program made itself

// A swapchain over a window the caller owns; the window must outlive it.
// w x h is used only where the window system leaves the size to the
// application (Wayland); elsewhere the window's own size is taken. Null with
// last_error() naming the missing extension when this loader or device
// cannot present to that kind of window.
swapchain_create(dev: ptr, kind: int, display: ptr, window: ptr, w: int, h: int) -> ptr {
    return aevk_ae_swapchain_create(dev, kind, display, window, w, h)
}
swapchain_destroy(sc: ptr) { aevk_ae_swapchain_destroy(sc) }

// The window changed size (a toolkit's resize hook gives it in pixels).
swapchain_resize(sc: ptr, w: int, h: int) -> int { return aevk_ae_swapchain_resize(sc, w, h) }

// On by default: one frame per vertical blank, never tearing. Off presents as
// soon as a frame is ready (MAILBOX where offered, else IMMEDIATE).
swapchain_set_vsync(sc: ptr, on: int) -> int { return aevk_ae_swapchain_set_vsync(sc, on) }

// 0 x 0 while the window has no area (minimised): present() then shows
// nothing and succeeds, and picks the window up again when it returns.
swapchain_width(sc: ptr) -> int { return aevk_ae_swapchain_width(sc) }
swapchain_height(sc: ptr) -> int { return aevk_ae_swapchain_height(sc) }
swapchain_format(sc: ptr) -> int { return aevk_ae_swapchain_format(sc) }
swapchain_presented(sc: ptr) -> int { return aevk_ae_swapchain_presented(sc) }

// Shows the target's newest frame: call it after draw() or submit(). It does
// not wait for the GPU. The frame is scaled when the target and the window
// differ in size; a swapchain the window outgrew is rebuilt here.
present(sc: ptr, t: ptr) -> int { return aevk_ae_present(sc, t) }

// New images at w x h with the same render pass, so pipelines made for the
// target keep working: the other half of following a window's size.
target_resize(t: ptr, w: int, h: int) -> int { return aevk_ae_target_resize(t, w, h) }

// Readback (on by default) copies every frame into host memory for pixel(),
// copy_rgba() and save_ppm(). A target that is only presented turns it off
// and saves a width*height*4 copy per frame.
target_set_readback(t: ptr, on: int) -> int { return aevk_ae_target_set_readback(t, on) }
target_readback(t: ptr) -> int { return aevk_ae_target_readback(t) }

// ---------------------------------------------------------------------------
// Colour formats and image files (#1514)
// ---------------------------------------------------------------------------

// A target in a chosen colour format: FORMAT_R8G8B8A8_UNORM (what
// target_create_ex makes), FORMAT_R8G8B8A8_SRGB (linear shader output encoded
// for display on store), FORMAT_R16G16B16A16_SFLOAT or
// FORMAT_R32G32B32A32_SFLOAT (HDR or compute-style values, not clamped to
// 0..1). Refused with last_error() when the device cannot render to it.
target_create_format(dev: ptr, w: int, h: int, format: int, want_depth: int, samples: int) -> ptr {
    return aevk_ae_target_create_format(dev, w, h, format, want_depth, samples)
}
target_format(t: ptr) -> int { return aevk_ae_target_format(t) }
target_bytes_per_pixel(t: ptr) -> int { return aevk_ae_target_bytes_per_pixel(t) }

// One channel (0 red .. 3 alpha) at full precision: a float target's value
// as stored, HDR above 1.0 included; an 8-bit target's byte over 255.
pixel_value(t: ptr, x: int, y: int, channel: int) -> float {
    return aevk_ae_pixel_value(t, x, y, channel)
}

// The newest frame as 8-bit RGBA whatever the format: w * h * 4 bytes, float
// channels clamped to 0..1. copy_rgba() gives the format's own bytes
// (rgba_size() of them).
copy_rgba8(t: ptr, dest: ptr, dest_len: int) -> int {
    return aevk_ae_copy_rgba8(t, dest, dest_len)
}

// Writes the newest frame as a PNG (8-bit RGBA). "" on success, the reason
// otherwise. save_ppm() stays for callers that want a file with no
// compressor in the path.
save_png(t: ptr, path: string) -> string {
    w = aevk_ae_target_width(t)
    h = aevk_ae_target_height(t)
    if t == null || w <= 0 || h <= 0 { return "target is null" }
    buf = bytes.new(w * h * 4)
    bytes.set_length(buf, w * h * 4)
    rc = aevk_ae_copy_rgba8(t, bytes.data(buf), w * h * 4)
    if rc != 0 {
        bytes.free(buf)
        return aevk_ae_last_error()
    }
    err = png.write_rgba8(path, bytes.data(buf), w, h)
    bytes.free(buf)
    return err
}

// ---------------------------------------------------------------------------
// Buffers and compute (#1515)
// ---------------------------------------------------------------------------

// A buffer shaders read and write, mapped for its lifetime and zeroed when
// made. The same buffer can be a storage or uniform binding of a compute pass
// and of a graphics pipeline, so compute output feeds a draw with no copy. It
// must outlive every dispatch and draw that uses it.
buffer_create(dev: ptr, bytes: int) -> ptr { return aevk_ae_buffer_create(dev, bytes) }
buffer_destroy(b: ptr) { aevk_ae_buffer_destroy(b) }
buffer_size(b: ptr) -> int { return aevk_ae_buffer_size(b) }

// Raw bytes in and out, bounds-checked.
buffer_write(b: ptr, offset: int, data: ptr, len: int) -> int {
    return aevk_ae_buffer_write(b, offset, data, len)
}
buffer_read(b: ptr, offset: int, dest: ptr, len: int) -> int {
    return aevk_ae_buffer_read(b, offset, dest, len)
}

// By 4-byte slot, as a shader's float[] or int[] indexes it.
buffer_set_float(b: ptr, index: int, value: float) -> int {
    return aevk_ae_buffer_set_float(b, index, value)
}
buffer_float(b: ptr, index: int) -> float { return aevk_ae_buffer_float(b, index) }
buffer_set_int(b: ptr, index: int, value: int) -> int {
    return aevk_ae_buffer_set_int(b, index, value)
}
buffer_int(b: ptr, index: int) -> int { return aevk_ae_buffer_int(b, index) }

// Declares `layout(std430, binding = N) buffer` for compute_create or
// pipeline_create_ex.
bindings_storage(b: ptr, binding: int) -> int { return aevk_ae_bindings_storage(b, binding) }

// A graphics pipeline reading a buffer: vertices pulled by gl_VertexIndex,
// or any storage or uniform block a compute pass produced.
set_buffer(p: ptr, binding: int, buf: ptr) -> int { return aevk_ae_set_buffer(p, binding, buf) }
material_set_buffer(m: ptr, binding: int, buf: ptr) -> int {
    return aevk_ae_material_set_buffer(m, binding, buf)
}

// A compute pipeline from SPIR-V (entry point main), the bindings it reads
// and writes (bindings_storage / bindings_uniform / bindings_texture) and a
// push-constant block of push_bytes (0..128, a multiple of 4).
compute_create(dev: ptr, spv: string, len: int, bindings: ptr, push_bytes: int) -> ptr {
    return aevk_ae_compute_create(dev, spv, len, bindings, push_bytes)
}
compute_destroy(c: ptr) { aevk_ae_compute_destroy(c) }
compute_set_buffer(c: ptr, binding: int, buf: ptr) -> int {
    return aevk_ae_compute_set_buffer(c, binding, buf)
}
compute_set_texture(c: ptr, binding: int, tex: ptr) -> int {
    return aevk_ae_compute_set_texture(c, binding, tex)
}
compute_set_push(c: ptr, data: ptr, len: int) -> int {
    return aevk_ae_compute_set_push(c, data, len)
}

// Push constants by 4-byte slot: a float member, or an int / uint one.
compute_push_float(c: ptr, slot: int, value: float) -> int {
    return aevk_ae_compute_push_float(c, slot, value)
}
compute_push_int(c: ptr, slot: int, value: int) -> int {
    return aevk_ae_compute_push_int(c, slot, value)
}
compute_set_timeout_ms(c: ptr, ms: int) -> int { return aevk_ae_compute_set_timeout_ms(c, ms) }

// Runs gx * gy * gz work groups and waits: the buffers hold the results when
// it returns. Every declared binding must be set first; a count past the
// device's limit is refused with the limit named.
dispatch(c: ptr, gx: int, gy: int, gz: int) -> int { return aevk_ae_dispatch(c, gx, gy, gz) }

// Without waiting, so the CPU works while the GPU computes; compute_wait()
// before reading results or dispatching again.
dispatch_async(c: ptr, gx: int, gy: int, gz: int) -> int {
    return aevk_ae_dispatch_async(c, gx, gy, gz)
}
compute_wait(c: ptr) -> int { return aevk_ae_compute_wait(c) }
