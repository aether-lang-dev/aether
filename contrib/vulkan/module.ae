// contrib.vulkan: offscreen GPU rendering (#1495, phase 1).
// Import with: import contrib.vulkan
//
//   vulkan.available()                  -> int     1 when a driver is usable
//   vulkan.device_name()                -> string  "" when none
//   vulkan.last_error()                 -> string
//
//   vulkan.device_create()              -> ptr     0 on failure
//   vulkan.device_destroy(dev)
//
//   vulkan.target_create(dev, w, h)     -> ptr     offscreen RGBA image
//   vulkan.target_create_ex(dev, w, h, depth, samples) -> ptr
//   vulkan.target_has_depth(t)          -> int
//   vulkan.target_samples(t)            -> int
//   vulkan.target_destroy(t)
//   vulkan.target_width(t)              -> int
//   vulkan.target_height(t)             -> int
//   vulkan.rgba_size(t)                 -> int     w * h * 4
//
//   vulkan.pipeline_create(dev, t, vert_spv, vert_len, frag_spv, frag_len) -> ptr
//   vulkan.pipeline_destroy(p)
//
//   vulkan.verts_reserve(t, count)      -> int     status
//   vulkan.verts_set(t, i, x, y, r, g, b) -> int   status
//   vulkan.draw(t, pipe, r, g, b, a)    -> int     status
//
// Past the built-in position+colour layout (#1508, #1509):
//
//   vulkan.layout_create()              -> ptr     describe vertex input
//   vulkan.layout_binding(l, binding, stride, per_instance) -> int
//   vulkan.layout_attr(l, location, binding, format, offset) -> int
//   vulkan.layout_destroy(l)
//
//   vulkan.bindings_create()            -> ptr     declare shader resources
//   vulkan.bindings_uniform(b, binding) -> int
//   vulkan.bindings_texture(b, binding) -> int
//   vulkan.bindings_destroy(b)
//
//   vulkan.pipeline_create_ex(dev, t, vspv, vlen, fspv, flen,
//                             layout, push_bytes, bindings) -> ptr
//
//   vulkan.texture_create(dev, w, h)    -> ptr     RGBA sampled image
//   vulkan.texture_create_ex(dev, w, h, mipmapped, linear, repeat) -> ptr
//   vulkan.texture_mip_levels(tex)      -> int
//   vulkan.texture_upload(tex, data, len) -> int   upload before binding
//   vulkan.texture_destroy(tex)
//   vulkan.set_texture(p, binding, tex) -> int
//   vulkan.set_uniform(p, binding, data, len) -> int
//   vulkan.uniform_floats(p, binding, count)  -> int
//   vulkan.uniform_float(p, binding, i, v)    -> int
//   vulkan.set_push(t, data, len)       -> int     at most 128 bytes
//   vulkan.push_floats(t, count)        -> int
//   vulkan.push_float(t, i, v)          -> int
//
//   vulkan.verts_reserve_n(t, count, floats_per_vertex) -> int
//   vulkan.verts_set_float(t, float_index, value)       -> int
//   vulkan.indices_reserve(t, count)    -> int     0 draws non-indexed
//   vulkan.indices_reserve_ex(t, count, bits) -> int   bits is 16 or 32
//   vulkan.indices_set(t, i, vertex)    -> int
//
//   vulkan.material_create(p)           -> ptr     one binding set per draw
//   vulkan.material_destroy(m)
//   vulkan.material_set_texture(m, binding, tex) -> int
//   vulkan.material_set_uniform(m, binding, data, len) -> int
//   vulkan.material_floats(m, binding, count)    -> int
//   vulkan.material_float(m, binding, i, v)      -> int
//   vulkan.batch_reset(t)               -> int     back to one draw
//   vulkan.batch_add(t, m, first, count) -> int    a draw inside the frame
//   vulkan.batch_count(t)               -> int
//   vulkan.draw_material(t, p, m, r, g, b, a)    -> int
//   vulkan.submit_material(t, p, m, r, g, b, a)  -> int
//   vulkan.pixel(t, x, y)               -> long    0xRRGGBBAA, -1 outside
//   vulkan.copy_rgba(t, dest, dest_len) -> int     status
//   vulkan.save_ppm(t, path)            -> int     status
//
// Colour formats and image files (#1514):
//
//   vulkan.target_create_format(dev, w, h, format, depth, samples) -> ptr
//   vulkan.target_format(t)             -> int     a FORMAT_* value
//   vulkan.target_bytes_per_pixel(t)    -> int     4, 8 or 16
//   vulkan.pixel_value(t, x, y, channel) -> float  exact, HDR values included
//   vulkan.copy_rgba8(t, dest, dest_len) -> int    8-bit RGBA whatever the format
//   vulkan.save_png(t, path)            -> string  "" on success
//
// Buffers and compute (#1515):
//
//   vulkan.buffer_create(dev, bytes)    -> ptr     mapped, zeroed
//   vulkan.buffer_destroy(b)
//   vulkan.buffer_size(b)               -> int
//   vulkan.buffer_set_float(b, i, v)    -> int     4-byte slot i
//   vulkan.buffer_float(b, i)           -> float
//   vulkan.buffer_set_int(b, i, v)      -> int
//   vulkan.buffer_int(b, i)             -> int
//   vulkan.buffer_write(b, offset, data, len) -> int
//   vulkan.buffer_read(b, offset, dest, len)  -> int
//   vulkan.bindings_storage(b, binding) -> int     std430 buffer binding
//   vulkan.compute_create(dev, spv, len, bindings, push_bytes) -> ptr
//   vulkan.compute_destroy(c)
//   vulkan.compute_set_buffer(c, binding, buf) -> int
//   vulkan.compute_set_texture(c, binding, tex) -> int
//   vulkan.compute_push_float(c, slot, v) -> int
//   vulkan.compute_push_int(c, slot, v) -> int
//   vulkan.dispatch(c, gx, gy, gz)      -> int     runs and waits
//   vulkan.dispatch_async(c, gx, gy, gz) -> int    runs; compute_wait later
//   vulkan.compute_wait(c)              -> int
//   vulkan.set_buffer(p, binding, buf)  -> int     a draw reads a buffer
//   vulkan.material_set_buffer(m, binding, buf) -> int
//
// Presenting to a window (#1505):
//
//   vulkan.swapchain_create(dev, kind, display, window, w, h) -> ptr
//   vulkan.swapchain_destroy(sc)
//   vulkan.swapchain_resize(sc, w, h)   -> int     status
//   vulkan.swapchain_set_vsync(sc, on)  -> int     status
//   vulkan.swapchain_width(sc)          -> int     0 while the window has no area
//   vulkan.swapchain_height(sc)         -> int
//   vulkan.swapchain_format(sc)         -> int     VkFormat of the images
//   vulkan.swapchain_presented(sc)      -> int     frames handed to the display
//   vulkan.present(sc, t)               -> int     the target's newest frame
//   vulkan.target_resize(t, w, h)       -> int     keeps every pipeline valid
//   vulkan.target_set_readback(t, on)   -> int     off: no per-frame copy out
//   vulkan.target_readback(t)           -> int
//
// Reading what was rendered, and volumes (#2198):
//
//   vulkan.set_target(p, binding, t)    -> int     a target's colour as a texture
//   vulkan.set_target_depth(p, binding, t) -> int  its depth, as a float texture
//   vulkan.material_set_target(m, binding, t)       -> int
//   vulkan.material_set_target_depth(m, binding, t) -> int
//   vulkan.texture_create_3d(dev, w, h, depth, linear, repeat) -> ptr
//   vulkan.texture_depth(tex)           -> int     slices: 1 for a 2D texture
//
// A target bound where a texture goes is read as its newest frame: whatever
// was most recently submitted to it when the draw runs. Draw the target first.
// Its depth reads near 0 to far 1. A target cannot sample itself, a target
// with no frame yet cannot be sampled, and a multisampled target's depth
// cannot either. A 3D texture is uploaded slice after slice
// (w * h * depth * 4 bytes) and read through a sampler3D.
//
// Instancing, indirect draws, dynamic uniform offsets and GPU timing (#2198):
//
//   vulkan.vertex_stream(t, binding, buf)        -> int  a buffer as stream 1..7
//   vulkan.target_set_instances(t, count)        -> int  instances a draw makes
//   vulkan.target_instances(t)                   -> int
//   vulkan.batch_add_instanced(t, m, first, count, first_instance, instances) -> int
//   vulkan.batch_add_indirect(t, m, buf, offset, draws) -> int  commands from a buffer
//   vulkan.bindings_uniform_dynamic(b, binding, bytes)  -> int
//   vulkan.batch_set_offset(t, item, binding, offset)   -> int
//   vulkan.uniform_offset_alignment(dev)         -> int
//   vulkan.target_set_timing(t, on)              -> int
//   vulkan.target_gpu_ms(t)                      -> float  -1 until a timed frame
//   vulkan.compute_set_timing(c, on)             -> int
//   vulkan.compute_gpu_ms(c)                     -> float
//
// Shadow maps and pipeline state (#2373, #2385):
//
//   vulkan.set_target_depth_compare(p, binding, t, op) -> int  a COMPARE_* sampler
//   vulkan.material_set_target_depth_compare(m, binding, t, op) -> int
//   vulkan.target_depth_linear(t)             -> int  1 when it filters
//   vulkan.state_create() / state_destroy(st)
//   vulkan.state_blend(st, mode)              -> int  BLEND_*
//   vulkan.state_cull(st, mode)               -> int  CULL_*; front is CCW on screen
//   vulkan.state_depth(st, op, write)         -> int
//   vulkan.state_topology(st, topology)       -> int  TOPOLOGY_*
//   vulkan.batch_set_scissor(t, item, x, y, w, h) -> int
//   vulkan.batch_set_viewport(t, item, x, y, w, h, min_depth, max_depth) -> int
//   vulkan.pipeline_create_state(dev, t, vs, vl, fs, fl, layout, push_bytes, bindings, st) -> ptr
//
// Cube maps, arrays and storage textures (#2387, #2388):
//
//   vulkan.texture_create_cube(dev, size, mipmapped, linear)         -> ptr
//   vulkan.texture_create_array(dev, w, h, layers, mipmapped, linear, repeat) -> ptr
//   vulkan.texture_layers(tex)                -> int  6, the layers, or 1
//   vulkan.texture_create_storage(dev, w, h, depth, format)          -> ptr
//   vulkan.bindings_storage_texture(b, binding) -> int  compute passes only
//   vulkan.compute_set_storage_texture(c, binding, tex) -> int
//
// Texture formats and anisotropic filtering (#2397):
//
//   vulkan.texture_create_format(dev, w, h, format, mipmapped, linear, repeat, anisotropy) -> ptr
//   vulkan.texture_format_supported(dev, format)  -> int  1 when the device samples it
//   vulkan.texture_upload_level(tex, level, data, len) -> int  a block format's chain, level by level
//   vulkan.texture_anisotropy(tex)                -> int  the anisotropy granted
//
// Stencil, and rendering into a layer (#2399):
//
//   vulkan.state_stencil(st, compare, ref, pass_op, fail_op, depth_fail_op, read_mask, write_mask) -> int
//   vulkan.batch_set_stencil_ref(t, item, ref)    -> int  -1 for the state's
//   vulkan.batch_set_pipeline(t, item, p)         -> int  a draw's own pipeline (#2411)
//   vulkan.state_color_mask(st, COLOR_* bits)     -> int  the channels a pipeline writes
//   vulkan.target_create_layered(dev, w, h, layers, format, depth, cube) -> ptr
//   vulkan.target_set_layer(t, n) / target_layers(t)
//   vulkan.set_target_array(p, binding, t) / set_target_cube(p, binding, t)  and material_ forms
//   vulkan.set_target_depth_array(p, binding, t, op) / set_target_depth_cube(p, binding, t, op)
//         a layered target's depth, raw (0) or compared (#2412), and material_ forms
//   vulkan.target_create_layered_ex(dev, w, h, layers, format, depth, cube, samples) -> ptr
//
// Several colour attachments (#2386):
//
//   vulkan.target_create_mrt(dev, w, h, count, f0, f1, f2, f3, depth, samples) -> ptr
//   vulkan.target_attachments(t)              -> int
//   vulkan.set_target_attachment(p, binding, t, n) / material_set_target_attachment -> int
//   vulkan.pixel_value_at(t, n, x, y, channel) -> float
//
// Binding 0 is the target's own vertices; a layout can declare streams 1..7
// as well, per vertex or per instance, each fed from a buffer. An indirect
// draw reads its commands from a buffer when the frame runs, so a compute pass
// can write them: five 32-bit words each with indices (index count, instance
// count, first index, vertex offset, first instance), four without (vertex
// count, instance count, first vertex, first instance). A dynamic uniform is
// a `bytes` window of the buffer set_buffer binds, read at the offset each
// batch entry sets.
//
// The window is never this module's: `kind`, `display` and `window` are what
// the toolkit that owns it hands out, numbered as aether-ui's
// native_view_kind() numbers them (WINDOW_WIN32 = 1 ... WINDOW_WAYLAND = 4),
// plus WINDOW_METAL_LAYER for a program with its own CAMetalLayer.
//
// Nothing links against libvulkan: the loader is opened at runtime, so a
// program using this module builds and starts on a machine with no driver and
// vulkan.available() reports 0. Check it before anything else.
//
// Coordinates are Vulkan NDC: x and y run -1..1, y points DOWN, and a
// front-facing triangle is counter-clockwise. Colours are 0..1.
//
// Build: importing the module is enough. Its C file is declared below with
// @source and compiled into the program; nothing is linked, since the
// loader is opened at runtime. What a build needs is the Vulkan HEADERS on
// the include path (header-only): libvulkan-dev on Debian/Ubuntu, the
// vulkan-headers package in MSYS2, `brew install vulkan-headers` on macOS
// (add `cflags = "-I/opt/homebrew/include"` to aether.toml there). A glibc
// older than 2.34 keeps dlopen in libdl: add `link_flags = "-ldl"`.

@source("aether_vulkan.c")

import std.bytes
import std.string
import contrib.png

exports (
    OK, ERR_NO_LOADER, ERR_NO_DEVICE, ERR_ARG, ERR_OOM,
    ERR_UNSUPPORTED, ERR_SHADER, ERR_DEVICE_LOST,
    aevk_ae_available, aevk_ae_last_error, aevk_ae_device_name,
    aevk_ae_device_create, aevk_ae_device_destroy,
    aevk_ae_target_create, aevk_ae_target_create_ex, aevk_ae_target_destroy,
    aevk_ae_target_has_depth, aevk_ae_target_samples,
    aevk_ae_target_set_frames, aevk_ae_target_frames,
    aevk_ae_target_set_timeout_ms, aevk_ae_submit, aevk_ae_wait_all,
    aevk_ae_target_width, aevk_ae_target_height, aevk_ae_rgba_size,
    aevk_ae_pipeline_create, aevk_ae_pipeline_destroy,
    aevk_ae_verts_reserve, aevk_ae_verts_set, aevk_ae_draw,
    aevk_ae_copy_rgba, aevk_ae_pixel, aevk_ae_save_ppm,
    available, last_error, device_name,
    device_create, device_destroy,
    target_create, target_create_ex, target_destroy, target_width, target_height,
    target_has_depth, target_samples, rgba_size,
    target_set_frames, target_frames, target_set_timeout_ms, submit, wait_all,
    pipeline_create, pipeline_destroy,
    verts_reserve, verts_set, draw, copy_rgba, pixel, save_ppm,
    red, green, blue, alpha,
    aevk_ae_pipeline_create_ex,
    aevk_ae_layout_create, aevk_ae_layout_destroy,
    aevk_ae_layout_binding, aevk_ae_layout_attr,
    aevk_ae_bindings_create, aevk_ae_bindings_destroy,
    aevk_ae_bindings_uniform, aevk_ae_bindings_texture,
    aevk_ae_texture_create, aevk_ae_texture_destroy, aevk_ae_texture_upload,
    aevk_ae_set_uniform, aevk_ae_set_texture, aevk_ae_set_push,
    aevk_ae_push_floats, aevk_ae_push_float,
    aevk_ae_uniform_floats, aevk_ae_uniform_float,
    aevk_ae_verts_reserve_n, aevk_ae_verts_set_float,
    aevk_ae_indices_reserve, aevk_ae_indices_reserve_ex, aevk_ae_indices_set,
    aevk_ae_texture_create_ex, aevk_ae_texture_mip_levels,
    aevk_ae_material_create, aevk_ae_material_destroy,
    aevk_ae_material_set_texture, aevk_ae_material_set_uniform,
    aevk_ae_material_floats, aevk_ae_material_float,
    aevk_ae_draw_material, aevk_ae_submit_material,
    aevk_ae_batch_reset, aevk_ae_batch_add, aevk_ae_batch_count,
    pipeline_create_ex,
    layout_create, layout_destroy, layout_binding, layout_attr,
    bindings_create, bindings_destroy, bindings_uniform, bindings_texture,
    texture_create, texture_destroy, texture_upload,
    set_uniform, set_texture, set_push,
    push_floats, push_float, uniform_floats, uniform_float,
    verts_reserve_n, verts_set_float, indices_reserve, indices_reserve_ex,
    indices_set,
    texture_create_ex, texture_mip_levels,
    material_create, material_destroy, material_set_texture,
    material_set_uniform, material_floats, material_float,
    draw_material, submit_material,
    batch_reset, batch_add, batch_count,
    FORMAT_R32_SFLOAT, FORMAT_R32G32_SFLOAT,
    FORMAT_R32G32B32_SFLOAT, FORMAT_R32G32B32A32_SFLOAT,
    FORMAT_R8G8B8A8_UNORM,
    PER_VERTEX, PER_INSTANCE,
    WINDOW_WIN32, WINDOW_NSVIEW, WINDOW_X11, WINDOW_WAYLAND, WINDOW_METAL_LAYER,
    FORMAT_R8G8B8A8_SRGB, FORMAT_R16G16B16A16_SFLOAT,
    aevk_ae_target_create_format, aevk_ae_target_format, aevk_ae_target_bytes_per_pixel,
    aevk_ae_copy_rgba8, aevk_ae_pixel_value,
    target_create_format, target_format, target_bytes_per_pixel,
    copy_rgba8, pixel_value, save_png,
    aevk_ae_buffer_create, aevk_ae_buffer_destroy, aevk_ae_buffer_size,
    aevk_ae_buffer_write, aevk_ae_buffer_read,
    aevk_ae_buffer_set_float, aevk_ae_buffer_float,
    aevk_ae_buffer_set_int, aevk_ae_buffer_int,
    aevk_ae_bindings_storage, aevk_ae_material_set_buffer, aevk_ae_set_buffer,
    aevk_ae_compute_create, aevk_ae_compute_destroy,
    aevk_ae_compute_set_buffer, aevk_ae_compute_set_texture, aevk_ae_compute_set_push,
    aevk_ae_compute_push_float, aevk_ae_compute_push_int, aevk_ae_compute_set_timeout_ms,
    aevk_ae_dispatch, aevk_ae_dispatch_async, aevk_ae_compute_wait,
    buffer_create, buffer_destroy, buffer_size, buffer_write, buffer_read,
    buffer_set_float, buffer_float, buffer_set_int, buffer_int,
    bindings_storage, material_set_buffer, set_buffer,
    compute_create, compute_destroy, compute_set_buffer, compute_set_texture,
    compute_set_push, compute_push_float, compute_push_int, compute_set_timeout_ms,
    dispatch, dispatch_async, compute_wait,
    aevk_ae_target_resize, aevk_ae_target_set_readback, aevk_ae_target_readback,
    aevk_ae_swapchain_create, aevk_ae_swapchain_destroy, aevk_ae_swapchain_resize,
    aevk_ae_swapchain_set_vsync, aevk_ae_swapchain_width, aevk_ae_swapchain_height,
    aevk_ae_swapchain_format, aevk_ae_swapchain_presented, aevk_ae_present,
    target_resize, target_set_readback, target_readback,
    swapchain_create, swapchain_destroy, swapchain_resize, swapchain_set_vsync,
    swapchain_width, swapchain_height, swapchain_format, swapchain_presented,
    present,
    aevk_ae_set_target, aevk_ae_material_set_target,
    aevk_ae_texture_create_3d, aevk_ae_texture_depth,
    set_target, set_target_depth, material_set_target, material_set_target_depth,
    texture_create_3d, texture_depth,
    aevk_ae_vertex_stream, aevk_ae_target_set_instances, aevk_ae_target_instances,
    aevk_ae_batch_add_instanced, aevk_ae_batch_add_indirect, aevk_ae_batch_set_offset,
    aevk_ae_uniform_offset_alignment, aevk_ae_bindings_uniform_dynamic,
    aevk_ae_target_set_timing, aevk_ae_target_gpu_ms,
    aevk_ae_compute_set_timing, aevk_ae_compute_gpu_ms,
    vertex_stream, target_set_instances, target_instances,
    batch_add_instanced, batch_add_indirect, batch_set_offset,
    uniform_offset_alignment, bindings_uniform_dynamic,
    target_set_timing, target_gpu_ms, compute_set_timing, compute_gpu_ms,
    aevk_ae_set_target_depth_compare, aevk_ae_material_set_target_depth_compare,
    aevk_ae_target_depth_linear,
    set_target_depth_compare, material_set_target_depth_compare, target_depth_linear,
    COMPARE_LESS, COMPARE_LESS_EQUAL, COMPARE_GREATER, COMPARE_GREATER_EQUAL,
    aevk_ae_state_create, aevk_ae_state_destroy, aevk_ae_state_blend, aevk_ae_state_cull,
    aevk_ae_state_depth, aevk_ae_pipeline_create_state,
    state_create, state_destroy, state_blend, state_cull, state_depth, pipeline_create_state,
    BLEND_NONE, BLEND_ALPHA, BLEND_PREMULTIPLIED, BLEND_ADDITIVE, CULL_NONE, CULL_BACK, CULL_FRONT,
    aevk_ae_texture_create_cube, aevk_ae_texture_create_array, aevk_ae_texture_create_storage,
    aevk_ae_texture_layers, aevk_ae_bindings_storage_texture, aevk_ae_compute_set_storage_texture,
    texture_create_cube, texture_create_array, texture_create_storage, texture_layers,
    bindings_storage_texture, compute_set_storage_texture,
    aevk_ae_target_create_mrt, aevk_ae_target_attachments, aevk_ae_set_target_attachment,
    aevk_ae_material_set_target_attachment, aevk_ae_pixel_value_at,
    target_create_mrt, target_attachments, set_target_attachment, material_set_target_attachment,
    pixel_value_at,
    aevk_ae_state_topology, aevk_ae_batch_set_scissor, aevk_ae_batch_set_viewport,
    state_topology, batch_set_scissor, batch_set_viewport,
    TOPOLOGY_TRIANGLES, TOPOLOGY_TRIANGLE_STRIP, TOPOLOGY_LINES, TOPOLOGY_LINE_STRIP, TOPOLOGY_POINTS,
    aevk_ae_texture_create_format, aevk_ae_texture_format_supported, aevk_ae_texture_anisotropy,
    aevk_ae_texture_upload_level,
    texture_create_format, texture_format_supported, texture_anisotropy, texture_upload_level,
    FORMAT_R8_UNORM, FORMAT_R8G8_UNORM, FORMAT_BC1_RGBA_UNORM, FORMAT_BC1_RGBA_SRGB, FORMAT_BC3_UNORM, FORMAT_BC3_SRGB, FORMAT_BC4_UNORM, FORMAT_BC5_UNORM, FORMAT_BC7_UNORM, FORMAT_BC7_SRGB,
    aevk_ae_state_stencil, aevk_ae_batch_set_stencil_ref, aevk_ae_target_create_layered, aevk_ae_target_set_layer, aevk_ae_target_layers, aevk_ae_set_target_array, aevk_ae_set_target_cube, aevk_ae_material_set_target_array, aevk_ae_material_set_target_cube,
    state_stencil, batch_set_stencil_ref, target_create_layered, target_set_layer, target_layers, set_target_array, set_target_cube, material_set_target_array, material_set_target_cube,
    DEPTH, DEPTH_STENCIL, COMPARE_EQUAL, COMPARE_NOT_EQUAL, COMPARE_ALWAYS, COMPARE_NEVER, STENCIL_KEEP, STENCIL_ZERO, STENCIL_REPLACE, STENCIL_INCREMENT_CLAMP, STENCIL_DECREMENT_CLAMP, STENCIL_INVERT, STENCIL_INCREMENT_WRAP, STENCIL_DECREMENT_WRAP,
    aevk_ae_state_color_mask, aevk_ae_batch_set_pipeline, state_color_mask, batch_set_pipeline,
    COLOR_RED, COLOR_GREEN, COLOR_BLUE, COLOR_ALPHA, COLOR_ALL,
    aevk_ae_texture_create_cube_format, aevk_ae_texture_create_array_format,
    texture_create_cube_format, texture_create_array_format,
    FORMAT_R8_SNORM, FORMAT_R8G8_SNORM, FORMAT_BC4_SNORM, FORMAT_BC5_SNORM, FORMAT_BC6H_UFLOAT, FORMAT_BC6H_SFLOAT, FORMAT_ETC2_R8G8B8_UNORM, FORMAT_ETC2_R8G8B8_SRGB, FORMAT_ETC2_R8G8B8A8_UNORM, FORMAT_ETC2_R8G8B8A8_SRGB, FORMAT_ASTC_4x4_UNORM, FORMAT_ASTC_4x4_SRGB,
    aevk_ae_target_create_layered_ex, aevk_ae_set_target_depth_array, aevk_ae_set_target_depth_cube, aevk_ae_material_set_target_depth_array, aevk_ae_material_set_target_depth_cube,
    target_create_layered_ex, set_target_depth_array, set_target_depth_cube, material_set_target_depth_array, material_set_target_depth_cube
)

