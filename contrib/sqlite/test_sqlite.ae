// Integration spec for contrib.sqlite — co-located with the module it
// exercises, written in Aether against std.spec.
//
// Replaces tests/integration/sqlite_roundtrip/ and sqlite_prepared/, whose
// shell wrappers existed almost entirely to probe for libsqlite3 and skip
// when absent. std.spec's it_when (#1610) expresses that directly, so the
// wrapper has nothing left to do and the assertions move next to the module
// they describe.
//
// The two former probes hand-rolled their checks with `exit(1)` on the first
// failure, which stops at the first problem and reports no others. As specs
// each check is independent, so one broken query no longer masks the rest.
//
// DEPENDENCY: contrib.sqlite links -lsqlite3: the pinned amalgamation that
// `make contrib` builds into build/contrib/libsqlite3.a (#1372), or the
// system library when the amalgamation could not be fetched. contrib_check.sh
// SKIPS the entry when neither is available, so this file only runs where
// SQLite exists -- the it_when guard below is belt-and-braces for a direct
// `ae run`. tests/integration/sqlite_vendored_cross also cross-builds and
// runs it for other targets.

import contrib.sqlite
import std.mem
import std.spec
import std.string

// One failing and one succeeding exec; both results die with this call.
fn exec_pair(db: ptr, bad: string, good: string) -> int {
    e = sqlite.exec(db, bad)
    o = sqlite.exec(db, good)
    return string.length(e) + string.length(o)
}

// The v3 authorizer: refuse what reaches past the connection's own file
// (ATTACH, DETACH, the load_extension() function), allow the rest, and
// count the calls so a spec can tell it was consulted at all.
var auth_calls = 0
var auth_denied = 0

authorize(ud: ptr, action: int, a1: string, a2: string, a3: string, a4: string) -> int {
    auth_calls = auth_calls + 1
    if action == sqlite.SQLITE_ATTACH || action == sqlite.SQLITE_DETACH {
        auth_denied = auth_denied + 1
        return sqlite.SQLITE_DENY
    }
    if action == sqlite.SQLITE_FUNCTION && string.length(a2) > 0 {
        if string.to_lower(a2) == "load_extension" {
            auth_denied = auth_denied + 1
            return sqlite.SQLITE_DENY
        }
    }
    return sqlite.SQLITE_OK
}

main() {
    fw = spec.init()

    // Probe: an in-memory database needs no filesystem and proves the
    // library is both linked and callable.
    db, operr = sqlite.open(":memory:")
    have_sqlite = 0
    if string.equals(operr, "") == 1 { have_sqlite = 1 }
    reason = "libsqlite3 not available"

    spec.describe(fw, "contrib.sqlite") {
        spec.it_when(have_sqlite, "opens an in-memory database", reason) callback {
            spec.assert_str_eq(operr, "", "open(:memory:) reports no error")
            spec.assert_not_null(db, "a handle comes back")
        }

        spec.it_when(have_sqlite, "creates a table and inserts rows", reason) callback {
            cerr = sqlite.exec(db, "CREATE TABLE t (id INTEGER, name TEXT)")
            spec.assert_str_eq(cerr, "", "CREATE TABLE succeeds")
            e1 = sqlite.exec(db, "INSERT INTO t VALUES (1, 'ada')")
            spec.assert_str_eq(e1, "", "first insert succeeds")
            e2 = sqlite.exec(db, "INSERT INTO t VALUES (2, 'grace')")
            spec.assert_str_eq(e2, "", "second insert succeeds")
        }

        // The round trip: what went in must come back, with the shape
        // (row/column counts) the caller relies on to iterate.
        spec.it_when(have_sqlite, "reads rows back with the right shape", reason) callback {
            rs, qerr = sqlite.query(db, "SELECT id, name FROM t ORDER BY id")
            spec.assert_str_eq(qerr, "", "SELECT succeeds")
            spec.assert_eq(sqlite.row_count(rs), 2, "two rows")
            spec.assert_eq(sqlite.col_count(rs), 2, "two columns")
            spec.assert_str_eq(sqlite.col_name(rs, 0), "id", "first column is id")
            spec.assert_str_eq(sqlite.col_name(rs, 1), "name", "second column is name")
            spec.assert_str_eq(sqlite.cell(rs, 0, 1), "ada", "row 0 name")
            spec.assert_str_eq(sqlite.cell(rs, 1, 1), "grace", "row 1 name")
            sqlite.free(rs)
        }

        // A WHERE clause proves the query text reaches sqlite rather than
        // the module returning a cached or whole-table result.
        spec.it_when(have_sqlite, "honours a WHERE clause", reason) callback {
            rs, qerr = sqlite.query(db, "SELECT name FROM t WHERE id = 2")
            spec.assert_str_eq(qerr, "", "filtered SELECT succeeds")
            spec.assert_eq(sqlite.row_count(rs), 1, "one row matches")
            spec.assert_str_eq(sqlite.cell(rs, 0, 0), "grace", "the right row")
            sqlite.free(rs)
        }

        // A malformed statement must report an error rather than returning
        // an empty result set: a caller that cannot distinguish "no rows"
        // from "your SQL was wrong" will silently do the wrong thing.
        spec.it_when(have_sqlite, "reports a SQL error rather than empty success", reason) callback {
            _rs, qerr = sqlite.query(db, "SELECT nosuchcol FROM t")
            spec.assert_not_eq(string.length(qerr), 0,
                "a bad column name yields a non-empty error")
        }

        spec.it_when(have_sqlite, "reports an error for a missing table", reason) callback {
            eerr = sqlite.exec(db, "INSERT INTO nosuchtable VALUES (1)")
            spec.assert_not_eq(string.length(eerr), 0,
                "writing to a missing table errors")
        }

        // exec's error text is a fresh string the caller owns. Its extern
        // was a plain `-> string`, so the compiler took it for borrowed and
        // every failing exec leaked its message. Where the allocator's count
        // is exact, one of two windows of five hundred failing and five
        // hundred succeeding execs leaves the heap where it was (a leak grows
        // both; a one-time allocation, such as SQLite warming its caches, at
        // most one).
        spec.it_when(have_sqlite, "reclaims the error text of exec", reason) callback {
            bad = "INSERT INTO nosuchtable VALUES (1)"
            good = "UPDATE t SET name = name WHERE id = 0"
            spec.assert_not_eq(exec_pair(db, bad, good), 0, "the failing exec reports")
            if mem.heap_in_use_exact() {
                before = mem.heap_in_use()
                for (i = 0; i < 500; i++) {
                    _n = exec_pair(db, bad, good)
                }
                mid = mem.heap_in_use()
                for (i = 0; i < 500; i++) {
                    _n = exec_pair(db, bad, good)
                }
                after = mem.heap_in_use()
                spec.assert_true(mid - before == 0 || after - mid == 0,
                    "500 exec pairs grew the heap by ${mid - before}, then ${after - mid} bytes")
            }
        }

        // ---- prepared statements ------------------------------------
        // The surface tests/integration/sqlite_prepared/ covered: prepare
        // once, bind, step, read columns, reset and re-use, finalize.
        // Kept here so retiring that directory loses nothing.

        spec.it_when(have_sqlite, "binds and reads back through a prepared statement", reason) callback {
            st, perr = sqlite.prepare(db, "SELECT name FROM t WHERE id = ?")
            spec.assert_str_eq(perr, "", "prepare succeeds")
            spec.assert_str_eq(sqlite.bind_int(st, 1, 2), "", "bind_int succeeds")
            spec.assert_eq(sqlite.next_row(st, db), 1, "a row is available")
            spec.assert_str_eq(sqlite.column_text(st, 0), "grace", "the bound id selected row 2")
            spec.assert_eq(sqlite.next_row(st, db), 0, "no second row")
            spec.assert_str_eq(sqlite.finalize(st), "", "finalize succeeds")
        }

        // reset() is what makes a prepared statement worth preparing: the
        // same handle re-bound and re-run must yield the OTHER row, not a
        // cached copy of the first result.
        spec.it_when(have_sqlite, "reset re-runs a statement with new bindings", reason) callback {
            st, perr = sqlite.prepare(db, "SELECT name FROM t WHERE id = ?")
            spec.assert_str_eq(perr, "", "prepare succeeds")

            _b1 = sqlite.bind_int(st, 1, 1)
            spec.assert_eq(sqlite.next_row(st, db), 1, "first run has a row")
            spec.assert_str_eq(sqlite.column_text(st, 0), "ada", "id 1 -> ada")

            spec.assert_str_eq(sqlite.reset(st), "", "reset succeeds")
            _b2 = sqlite.bind_int(st, 1, 2)
            spec.assert_eq(sqlite.next_row(st, db), 1, "second run has a row")
            spec.assert_str_eq(sqlite.column_text(st, 0), "grace",
                "id 2 -> grace, so the re-bind really took")

            _f = sqlite.finalize(st)
        }

        spec.it_when(have_sqlite, "bind_text and column_int round-trip", reason) callback {
            st, perr = sqlite.prepare(db, "SELECT id FROM t WHERE name = ?")
            spec.assert_str_eq(perr, "", "prepare succeeds")
            spec.assert_str_eq(sqlite.bind_text(st, 1, "ada"), "", "bind_text succeeds")
            spec.assert_eq(sqlite.next_row(st, db), 1, "a row matches")
            spec.assert_eq(sqlite.column_int(st, 0), 1, "column_int returns 1")
            _f = sqlite.finalize(st)
        }

        // changes() reports rows affected by the last write — the only way
        // a caller knows an UPDATE matched anything.
        spec.it_when(have_sqlite, "changes() reports rows affected", reason) callback {
            uerr = sqlite.exec(db, "UPDATE t SET name = 'ada2' WHERE id = 1")
            spec.assert_str_eq(uerr, "", "UPDATE succeeds")
            spec.assert_eq(sqlite.changes(db), 1, "one row changed")
            _r = sqlite.exec(db, "UPDATE t SET name = 'ada' WHERE id = 1")
        }

        // step() is the LOWER-LEVEL contract next_row() wraps: it returns
        // sqlite's raw code, and callers written as
        // `while step() == SQLITE_ROW { ... }` depend on those exact
        // values. next_row() collapses them to 1/0, so testing only the
        // wrapper would leave the documented codes unpinned.
        spec.it_when(have_sqlite, "step returns SQLITE_ROW then SQLITE_DONE", reason) callback {
            st, perr = sqlite.prepare(db, "SELECT id FROM t ORDER BY id")
            spec.assert_str_eq(perr, "", "prepare succeeds")

            rc1, e1 = sqlite.step(st, db)
            spec.assert_eq(rc1, sqlite.SQLITE_ROW, "first step yields SQLITE_ROW")
            spec.assert_str_eq(e1, "", "no error on a row")

            rc2, _e2 = sqlite.step(st, db)
            spec.assert_eq(rc2, sqlite.SQLITE_ROW, "second step yields SQLITE_ROW")

            rc3, e3 = sqlite.step(st, db)
            spec.assert_eq(rc3, sqlite.SQLITE_DONE, "third step yields SQLITE_DONE")
            spec.assert_str_eq(e3, "", "exhaustion is not an error")

            _f = sqlite.finalize(st)
        }

        // 64-bit values cross the boundary as a (hi, lo) pair because
        // Aether's int is 32-bit at this ABI. A value above 2^32 is the
        // only way to prove both halves survive — a small number would
        // pass even if `hi` were dropped.
        spec.it_when(have_sqlite, "bind_i64 / column_i64 round-trip a large value", reason) callback {
            cerr = sqlite.exec(db, "CREATE TABLE big (v INTEGER)")
            spec.assert_str_eq(cerr, "", "CREATE TABLE big succeeds")

            ist, iperr = sqlite.prepare(db, "INSERT INTO big VALUES (?)")
            spec.assert_str_eq(iperr, "", "prepare insert succeeds")
            // 0x0000000B_00000007 = 47244640263, well beyond 32 bits.
            spec.assert_str_eq(sqlite.bind_i64(ist, 1, 11, 7), "", "bind_i64 succeeds")
            _s = sqlite.next_row(ist, db)
            _f1 = sqlite.finalize(ist)

            sst, sperr = sqlite.prepare(db, "SELECT v FROM big")
            spec.assert_str_eq(sperr, "", "prepare select succeeds")
            spec.assert_eq(sqlite.next_row(sst, db), 1, "the row is there")
            hi, lo = sqlite.column_i64(sst, 0)
            spec.assert_eq(hi, 11, "high half survives")
            spec.assert_eq(lo, 7, "low half survives")
            _f2 = sqlite.finalize(sst)
        }

        // Blobs are the path where a NUL byte must NOT terminate the
        // value — the whole reason blob binding exists rather than
        // reusing bind_text.
        spec.it_when(have_sqlite, "bind_blob / column_blob preserve embedded NULs", reason) callback {
            cerr = sqlite.exec(db, "CREATE TABLE b (v BLOB)")
            spec.assert_str_eq(cerr, "", "CREATE TABLE b succeeds")

            payload = "ab\x00cd"
            ist, iperr = sqlite.prepare(db, "INSERT INTO b VALUES (?)")
            spec.assert_str_eq(iperr, "", "prepare insert succeeds")
            spec.assert_str_eq(sqlite.bind_blob(ist, 1, payload, 5), "",
                "bind_blob succeeds")
            _s = sqlite.next_row(ist, db)
            _f1 = sqlite.finalize(ist)

            sst, sperr = sqlite.prepare(db, "SELECT v FROM b")
            spec.assert_str_eq(sperr, "", "prepare select succeeds")
            spec.assert_eq(sqlite.next_row(sst, db), 1, "the row is there")
            _data, n, berr = sqlite.column_blob(sst, 0)
            spec.assert_str_eq(berr, "", "column_blob succeeds")
            spec.assert_eq(n, 5, "all 5 bytes come back — the NUL did not truncate")
            _f2 = sqlite.finalize(sst)
        }

        // v3 (sae asks/sqlite-authorizer.md). Each spec opens a connection
        // of its own, so a limit or an authorizer it installs cannot reach
        // the shared one above.
        spec.it_when(have_sqlite, "set_authorizer refuses what the callback denies, and only that", reason) callback {
            adb, aerr = sqlite.open(":memory:")
            spec.assert_str_eq(aerr, "", "open a second connection")
            spec.assert_str_eq(sqlite.exec(adb, "CREATE TABLE a (v INTEGER)"), "", "a table before the authorizer")
            spec.assert_str_eq(sqlite.set_authorizer(adb,
                    authorize as fn(ptr, int, string, string, string, string) -> int, null), "",
                "set_authorizer succeeds")
            before = auth_calls
            spec.assert_str_eq(sqlite.exec(adb, "INSERT INTO a VALUES (1)"), "",
                "an ordinary INSERT is allowed")
            spec.assert_true(auth_calls > before, "the authorizer was consulted")
            att = sqlite.exec(adb, "ATTACH DATABASE ':memory:' AS other")
            spec.assert_true(string.contains(att, "not authorized") == 1, "ATTACH is refused: ${att}")
            _st, lerr = sqlite.prepare(adb, "SELECT load_extension('nothing')")
            spec.assert_not_eq(string.length(lerr), 0, "load_extension() does not compile: ${lerr}")
            spec.assert_true(auth_denied >= 1, "the denials were the callback's")
            spec.assert_str_eq(sqlite.clear_authorizer(adb), "", "clear_authorizer succeeds")
            spec.assert_str_eq(sqlite.exec(adb, "ATTACH DATABASE ':memory:' AS other"), "",
                "with the authorizer gone, ATTACH works again")
            spec.assert_str_eq(sqlite.exec(adb, "DETACH DATABASE other"), "", "and DETACH")
            spec.assert_str_eq(sqlite.close(adb), "", "close")
        }

        spec.it_when(have_sqlite, "limit(SQLITE_LIMIT_ATTACHED, 0) leaves no ATTACH; limit reads back", reason) callback {
            ldb, lerr = sqlite.open(":memory:")
            spec.assert_str_eq(lerr, "", "open a connection")
            prev = sqlite.limit(ldb, sqlite.SQLITE_LIMIT_ATTACHED, 0)
            spec.assert_true(prev > 0, "the default allows some attached databases (${prev})")
            spec.assert_eq(sqlite.limit(ldb, sqlite.SQLITE_LIMIT_ATTACHED, -1), 0, "a negative value reads the new limit back")
            att = sqlite.exec(ldb, "ATTACH DATABASE ':memory:' AS other")
            spec.assert_not_eq(string.length(att), 0, "ATTACH fails with the limit at 0: ${att}")
            // 6 is FUNCTION_ARG, not ATTACHED: the constants keep them apart.
            spec.assert_eq(sqlite.SQLITE_LIMIT_ATTACHED, 7, "SQLITE_LIMIT_ATTACHED is 7")
            fa = sqlite.limit(ldb, sqlite.SQLITE_LIMIT_FUNCTION_ARG, -1)
            spec.assert_true(fa > 0, "FUNCTION_ARG is a limit of its own (${fa})")
            spec.assert_eq(sqlite.limit(null, sqlite.SQLITE_LIMIT_ATTACHED, 0), -1, "a null db reads -1")
            spec.assert_str_eq(sqlite.close(ldb), "", "close")
        }

        spec.it_when(have_sqlite, "enable_load_extension(db, 0) leaves load_extension() failing", reason) callback {
            edb, eerr = sqlite.open(":memory:")
            spec.assert_str_eq(eerr, "", "open a connection")
            spec.assert_str_eq(sqlite.enable_load_extension(edb, 0), "", "turning it off succeeds")
            rs, qerr = sqlite.query(edb, "SELECT load_extension('nothing')")
            spec.assert_null(rs, "no result set")
            spec.assert_not_eq(string.length(qerr), 0, "the call fails")
            spec.assert_not_eq(string.length(sqlite.enable_load_extension(null, 0)), 0, "a null db is refused")
            spec.assert_str_eq(sqlite.close(edb), "", "close")
        }

        spec.it_when(have_sqlite, "typed rows: column_count/name/type, doubles, 64-bit values, named parameters, last_insert_rowid", reason) callback {
            tdb, terr = sqlite.open(":memory:")
            spec.assert_str_eq(terr, "", "open a connection")
            spec.assert_str_eq(sqlite.exec(tdb,
                    "CREATE TABLE m (id INTEGER PRIMARY KEY, big INTEGER, ratio REAL, label TEXT, raw BLOB, gone TEXT)"),
                "", "CREATE TABLE m")
            ist, ierr = sqlite.prepare(tdb,
                "INSERT INTO m (big, ratio, label, raw, gone) VALUES ($big, :ratio, @label, ?4, NULL)")
            spec.assert_str_eq(ierr, "", "prepare with named parameters")
            spec.assert_eq(sqlite.bind_parameter_count(ist), 4, "four parameters")
            spec.assert_eq(sqlite.bind_parameter_index(ist, "$big"), 1, "$big is 1")
            spec.assert_eq(sqlite.bind_parameter_index(ist, ":ratio"), 2, ":ratio is 2")
            spec.assert_eq(sqlite.bind_parameter_index(ist, "@label"), 3, "@label is 3")
            spec.assert_eq(sqlite.bind_parameter_index(ist, "$nope"), 0, "an unknown name is 0")
            // Beyond 32 bits, and negative: both halves and the sign in one value.
            spec.assert_str_eq(sqlite.bind_int64(ist, 1, -47244640263), "", "bind_int64")
            spec.assert_str_eq(sqlite.bind_double(ist, 2, 0.15625), "", "bind_double")
            spec.assert_str_eq(sqlite.bind_text(ist, 3, "x"), "", "bind_text")
            spec.assert_str_eq(sqlite.bind_blob(ist, 4, "ab", 2), "", "bind_blob")
            spec.assert_eq(sqlite.next_row(ist, tdb), 0, "the insert runs")
            first = sqlite.last_insert_rowid(tdb)
            spec.assert_true(first == 1, "last_insert_rowid is the new row's id")
            _r = sqlite.reset(ist)
            spec.assert_str_eq(sqlite.bind_int64(ist, 1, 9007199254740993), "", "a second, larger value")
            spec.assert_eq(sqlite.next_row(ist, tdb), 0, "the second insert runs")
            spec.assert_true(sqlite.last_insert_rowid(tdb) == 2, "and its id")
            _f = sqlite.finalize(ist)

            sst, serr = sqlite.prepare(tdb, "SELECT id, big, ratio, label AS name, raw, gone FROM m ORDER BY id")
            spec.assert_str_eq(serr, "", "prepare select")
            spec.assert_eq(sqlite.column_count(sst), 6, "six columns")
            spec.assert_str_eq(sqlite.column_name(sst, 1), "big", "a column's name")
            spec.assert_str_eq(sqlite.column_name(sst, 3), "name", "an alias is the name")
            spec.assert_str_eq(sqlite.column_name(sst, 9), "", "out of range is empty")
            spec.assert_eq(sqlite.next_row(sst, tdb), 1, "the first row")
            spec.assert_eq(sqlite.column_type(sst, 1), sqlite.SQLITE_INTEGER, "INTEGER")
            spec.assert_eq(sqlite.column_type(sst, 2), sqlite.SQLITE_FLOAT, "FLOAT")
            spec.assert_eq(sqlite.column_type(sst, 3), sqlite.SQLITE_TEXT, "TEXT")
            spec.assert_eq(sqlite.column_type(sst, 4), sqlite.SQLITE_BLOB, "BLOB")
            spec.assert_eq(sqlite.column_type(sst, 5), sqlite.SQLITE_NULL, "NULL")
            spec.assert_true(sqlite.column_int64(sst, 1) == -47244640263, "column_int64 returns the negative 64-bit value")
            spec.assert_true(sqlite.column_double(sst, 2) == 0.15625, "column_double returns the double")
            spec.assert_eq(sqlite.next_row(sst, tdb), 1, "the second row")
            spec.assert_true(sqlite.column_int64(sst, 1) == 9007199254740993, "a value past 2^53 survives exactly")
            _f2 = sqlite.finalize(sst)
            spec.assert_str_eq(sqlite.close(tdb), "", "close")
        }

        spec.it_when(have_sqlite, "prepare rejects malformed SQL", reason) callback {
            _st, perr = sqlite.prepare(db, "SELECT FROM WHERE")
            spec.assert_not_eq(string.length(perr), 0,
                "unparseable SQL yields a non-empty error")
        }
    }

    _rc = spec.run_summary(fw)

    if have_sqlite == 1 { sqlite.close(db) }
    return _rc
}
