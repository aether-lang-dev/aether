// Uses trailing blocks and builder context injection for route registration.

import std.list
import std.map
import std.http
import std.string
import std.mem
import std.os

exports(
    ALL, GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS, CONNECT, TRACE,
    LINK, UNLINK, LOCK, UNLOCK, PROPFIND, PROPPATCH, MKCOL, COPY, MOVE,
    REPORT, SEARCH, PURGE, REBIND, UNBIND, ACL,
    CONTINUE, STOP,
    method_to_string,
    request_get_body, request_get_path, request_get_header,
    request_get_query_param, request_get_path_param, request_get_cookie,
    attributes_new, ctx_set_attribute, ctx_get_attribute,
    response_write, response_write_status, response_set_header, response_json,
    route_entry, filter_entry, ws_entry, static_entry,
    end_point, filter, filter_all, web_socket, serve_static, path,
    web_server, web_server_host, http_server,
    with_timeout, with_keep_alive,
    with_tls,
    on_stats,
    stats_record, stats_add_filter,
    stats_get_path, stats_get_endpoint, stats_get_status,
    stats_get_duration, stats_get_endpoint_duration, stats_get_filters,
    filter_stat_path, filter_stat_result, filter_stat_duration,
    sse_entry, sse_endpoint, sse_send, sse_send_event, sse_comment, sse_close,
    chunked_start, write_chunk, chunked_end,
    tw_start, tw_stop,
    compose, compose_at
)

// ---------------------------------------------------------------------------
// Constants — HTTP methods
// ---------------------------------------------------------------------------
const ALL = 0
const GET = 1
const POST = 2
const PUT = 3
const DELETE = 4
const PATCH = 5
const HEAD = 6
const OPTIONS = 7
const CONNECT = 8
const TRACE = 9
const LINK = 10
const UNLINK = 11
const LOCK = 12
const UNLOCK = 13
const PROPFIND = 14
const PROPPATCH = 15
const MKCOL = 16
const COPY = 17
const MOVE = 18
const REPORT = 19
const SEARCH = 20
const PURGE = 21
const REBIND = 22
const UNBIND = 23
const ACL = 24

// Filter actions
const CONTINUE = 1
const STOP = 0

// Convert a method constant to the HTTP method string for the C layer
method_to_string(method: int) {
    if method == GET { return "GET" }
    if method == POST { return "POST" }
    if method == PUT { return "PUT" }
    if method == DELETE { return "DELETE" }
    if method == PATCH { return "PATCH" }
    if method == HEAD { return "HEAD" }
    if method == OPTIONS { return "OPTIONS" }
    if method == CONNECT { return "CONNECT" }
    if method == TRACE { return "TRACE" }
    if method == LINK { return "LINK" }
    if method == UNLINK { return "UNLINK" }
    if method == LOCK { return "LOCK" }
    if method == UNLOCK { return "UNLOCK" }
    if method == PROPFIND { return "PROPFIND" }
    if method == PROPPATCH { return "PROPPATCH" }
    if method == MKCOL { return "MKCOL" }
    if method == COPY { return "COPY" }
    if method == MOVE { return "MOVE" }
    if method == REPORT { return "REPORT" }
    if method == SEARCH { return "SEARCH" }
    if method == PURGE { return "PURGE" }
    if method == REBIND { return "REBIND" }
    if method == UNBIND { return "UNBIND" }
    if method == ACL { return "ACL" }
    return "GET"
}

// ---------------------------------------------------------------------------
// Request / Response / RequestContext — value wrappers
// ---------------------------------------------------------------------------

// Wrap the raw C ptrs so the DSL callbacks get a clean triple

request_get_body(req: ptr) {
    return http.request_body(req)
}

request_get_path(req: ptr) {
    return http.request_path(req)
}

request_get_header(req: ptr, name: string) {
    return http.get_header(req, name)
}

request_get_query_param(req: ptr, name: string) {
    return http.get_query_param(req, name)
}

request_get_path_param(ctx: ptr, name: string) {
    return http.get_path_param(ctx, name)
}

// Cookie parsing — parses the Cookie header and returns
// the value for the given name, or "" if not found.
request_get_cookie(req: ptr, name: string) {
    cookie_header = http.get_header(req, "Cookie")
    if (cookie_header == "") { return "" }

    // Split on ";" to get individual cookies
    pairs = string.split(cookie_header, ";")
    n = string.array_size(pairs)
    result = ""
    for (i = 0; i < n; i++) {
        pair = string.trim(string.array_get(pairs, i))
        // Split on first "=" to get key and value
        eq_pos = string.index_of(pair, "=")
        if eq_pos > 0 {
            key = string.substring(pair, 0, eq_pos)
            if (key == name) {
                result = string.substring(pair, eq_pos + 1, string.length(pair))
            }
        }
    }
    string.array_free(pairs)
    return result
}

// ---------------------------------------------------------------------------
// Request Attributes — filter-to-endpoint data passing
//
// Lets a filter attach data (e.g. authenticated user) for the
// endpoint to read. Stored in a per-request map passed as the ctx parameter.
// ---------------------------------------------------------------------------

// Create a new attribute context (call once per request)
attributes_new() {
    return map_new()
}

// Set an attribute on the request context
ctx_set_attribute(ctx: ptr, key: string, value: string) {
    map_put(ctx, key, value)
}

// Get an attribute from the request context
ctx_get_attribute(ctx: ptr, key: string) {
    if map_has(ctx, key) == 1 {
        v, _ = map.get_string(ctx, key)
        return v
    }
    return ""
}

response_write(res: ptr, body: string) {
    http.response_set_status(res, 200)
    http.response_set_body(res, body)
}

response_write_status(res: ptr, body: string, status: int) {
    http.response_set_status(res, status)
    http.response_set_body(res, body)
}

response_set_header(res: ptr, name: string, value: string) {
    http.response_set_header(res, name, value)
}

response_json(res: ptr, json_body: string) {
    http.response_json(res, json_body)
}

// ---------------------------------------------------------------------------
// Route / Filter registration data structures
// ---------------------------------------------------------------------------

// A route entry: { method, path_pattern, handler_closure }
route_entry(method: int, path_pattern: string, handler: @keep fn) {
    entry = map_new()
    map_put(entry, "method", method)
    map_put(entry, "path", path_pattern)
    map_put(entry, "handler", box_closure(handler))
    return entry
}

// A filter entry: { method, path_pattern, filter_closure }
filter_entry(method: int, path_pattern: string, handler: @keep fn) {
    entry = map_new()
    map_put(entry, "method", method)
    map_put(entry, "path", path_pattern)
    map_put(entry, "handler", box_closure(handler))
    return entry
}

// A websocket entry: { path, handler_closure }
ws_entry(path_pattern: string, handler: @keep fn) {
    entry = map_new()
    map_put(entry, "path", path_pattern)
    map_put(entry, "handler", box_closure(handler))
    return entry
}

// A static files entry: { base_path, directory }
static_entry(base_path: string, directory: string) {
    entry = map_new()
    map_put(entry, "base_path", base_path)
    map_put(entry, "directory", directory)
    return entry
}

// ---------------------------------------------------------------------------
// Server structure
//
// A server is a map containing:
//   "port"       - int
//   "host"       - string
//   "routes"     - list of route entries
//   "filters"    - list of filter entries
//   "paths"      - list of { prefix, routes, filters } for nested paths
//   "raw_server" - the std.http server: made by http_server()/tw_start,
//                  freed (and set back to 0) by tw_stop
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// DSL functions — designed for use inside trailing blocks
// ---------------------------------------------------------------------------

// end_point(method, pattern) |req, res, ctx| { ... }
// When inside a path() block, _ctx is the path-group map
end_point(_ctx: ptr, method: int, pattern: string, handler: @keep fn) {
    routes, _ = map.get(_ctx, "routes")
    prefix, _ = map.get_string(_ctx, "prefix")
    full_path = "${prefix}${pattern}"
    list.add(routes, route_entry(method, full_path, handler))
}

// filter(method, pattern) |req, res, ctx| { ... }
filter(_ctx: ptr, method: int, pattern: string, handler: @keep fn) {
    filters, _ = map.get(_ctx, "filters")
    prefix, _ = map.get_string(_ctx, "prefix")
    full_path = "${prefix}${pattern}"
    list.add(filters, filter_entry(method, full_path, handler))
}

// filter(pattern) |req, res, ctx| { ... }  — applies to ALL methods
filter_all(_ctx: ptr, pattern: string, handler: @keep fn) {
    // Inlined: calling filter() directly would trip the DSL _ctx auto-injector
    // (it treats filter as a 3-arg builder, so filter(_ctx, ...) looks like 4 args).
    filters, _ = map.get(_ctx, "filters")
    prefix, _ = map.get_string(_ctx, "prefix")
    full_path = "${prefix}${pattern}"
    list.add(filters, filter_entry(ALL, full_path, handler))
}

// web_socket(path) |message, sender, ctx| { ... }
//
// Served on the server's own port by std.http (http.server_websocket), whose
// RFC 6455 codec takes messages of any size, binary ones, pings and fragments.
// `message` is the message received (binary ones whole, zero bytes and all),
// `sender` the connection's std.http WebSocket handle (reply with
// http.ws_send_text / http.ws_send_binary), `ctx` a map the connection's
// messages share.
web_socket(_ctx: ptr, ws_path: string, handler: @keep fn) {
    ws_handlers, _ = map.get(_ctx, "ws_handlers")
    prefix, _ = map.get_string(_ctx, "prefix")
    full_path = "${prefix}${ws_path}"
    list.add(ws_handlers, ws_entry(full_path, handler))
}

// serve_static("/static", "/path/to/files")
serve_static(_ctx: ptr, base_path: string, directory: string) {
    statics, _ = map.get(_ctx, "statics")
    prefix, _ = map.get_string(_ctx, "prefix")
    full_base = "${prefix}${base_path}"
    list.add(statics, static_entry(full_base, directory))
}

// path(base_path) { ... nested end_points / filters / web_sockets ... }
// Creates a sub-context with the prefix appended
path(_ctx: ptr, base_path: string) {
    prefix, _ = map.get_string(_ctx, "prefix")
    sub = map_new()
    map_put(sub, "prefix", "${prefix}${base_path}")
    p_routes, _ = map.get(_ctx, "routes")
    map_put(sub, "routes", p_routes)
    p_filters, _ = map.get(_ctx, "filters")
    map_put(sub, "filters", p_filters)
    p_ws, _ = map.get(_ctx, "ws_handlers")
    map_put(sub, "ws_handlers", p_ws)
    p_sse, _ = map.get(_ctx, "sse_handlers")
    map_put(sub, "sse_handlers", p_sse)
    p_stat, _ = map.get(_ctx, "statics")
    map_put(sub, "statics", p_stat)
    return sub
}

// ---------------------------------------------------------------------------
// Top-level server constructor — the entry point
// ---------------------------------------------------------------------------

// web_server(port) { path("/api") { ... } }
web_server(port: int) {
    srv = map_new()
    map_put(srv, "port", port)
    map_put(srv, "host", "127.0.0.1")
    map_put(srv, "routes", list.new())
    map_put(srv, "filters", list.new())
    map_put(srv, "ws_handlers", list.new())
    map_put(srv, "sse_handlers", list.new())
    map_put(srv, "statics", list.new())
    map_put(srv, "prefix", "")
    // Config extras, applied by tw_start
    map_put(srv, "socket_timeout_ms", 30000)
    map_put(srv, "keep_alive", 1)
    // TLS is off until with_tls supplies a cert/key pair.
    map_put(srv, "tls_cert", "")
    map_put(srv, "tls_key", "")
    // Statistics callback
    map_put(srv, "on_stats", 0)
    // The std.http server, made by http_server() or tw_start when first asked
    // for, and freed by tw_stop.
    map_put(srv, "raw_server", 0)
    return srv
}

// web_server_host(host, port) { ... }
// `host` is a name, an IPv4 address, an IPv6 address ("::1"), or "::" for
// every interface of both families.
web_server_host(host: string, port: int) {
    srv = web_server(port)
    map_put(srv, "host", host)
    return srv
}

// The std.http server behind a TinyWeb server, for what std.http offers on
// a server: its monitor above all (#3131), which reports when the server is
// listening and when it has stopped.
//
//     http.monitor(tinyweb.http_server(server)) {
//         listening() |host: string, port: int| { println("up on ${port}") }
//     }
//
// Attach the monitor before tw_start. tw_stop frees the std.http server; the
// next call here (or the next tw_start) makes a fresh one, with no monitor,
// so a program that starts the server again attaches its monitor again.
http_server(srv: ptr) -> ptr {
    raw, _ = map.get(srv, "raw_server")
    if raw == 0 {
        port_v, _ = map.get(srv, "port")
        raw = http.server_create(mem.ptr_to_long(port_v) as int)
        map_put(srv, "raw_server", raw)
    }
    return raw
}

// ---------------------------------------------------------------------------
// Config extras — server tuning parameters
// ---------------------------------------------------------------------------

// Serve over HTTPS with the given PEM cert and key.
//
//     server = tinyweb.web_server_host("0.0.0.0", 443) { ... }
//     _ = tinyweb.with_tls(server, "/etc/ssl/cert.pem", "/etc/ssl/key.pem")
//
// Paths are recorded here and applied by tw_start, which reports a bad pair as
// a start-up error rather than serving plaintext on a port a caller believes
// is encrypted. That failure mode is why this is not a silent no-op: a server
// that quietly downgrades to HTTP is worse than one that refuses to start.
with_tls(srv: @keep ptr, cert_path: string, key_path: string) {
    map_put(srv, "tls_cert", cert_path)
    map_put(srv, "tls_key", key_path)
    return srv
}

// How long, in milliseconds, a kept-alive connection may sit idle waiting for
// its next request (30000 by default): std.http's keep-alive idle timeout,
// set by tw_start. An upgraded WebSocket or an SSE stream is not held to it.
with_timeout(srv: ptr, ms: int) {
    map_put(srv, "socket_timeout_ms", ms)
}

// 1 = keep connections alive between requests (default), 0 = close each
// after its response. Applied by tw_start.
with_keep_alive(srv: ptr, enabled: int) {
    map_put(srv, "keep_alive", enabled)
}

// ---------------------------------------------------------------------------
// Statistics / monitoring
//
//   on_stats(server) |stats| { println("${stats_get_path(stats)}") }
// ---------------------------------------------------------------------------

// Register a statistics callback — handler receives a stats map
on_stats(srv: ptr, handler: @keep fn) {
    map_put(srv, "on_stats", box_closure(handler))
}

// Create a stats record for a request
// Fields: path, endpoint, status, duration, endpoint_duration, filters
stats_record(req_path: string, endpoint_pattern: string, status: int, duration_ms: int, endpoint_duration_ms: int) {
    s = map_new()
    map_put(s, "path", req_path)
    map_put(s, "endpoint", endpoint_pattern)
    map_put(s, "status", status)
    map_put(s, "duration", duration_ms)
    map_put(s, "endpoint_duration", endpoint_duration_ms)
    map_put(s, "filters", list.new())
    return s
}

// Add a filter stat entry to a stats record
// Add a filter stat entry (path, result, duration_ms)
stats_add_filter(stats: ptr, filter_path: string, result: string, duration_ms: int) {
    fs = map_new()
    map_put(fs, "path", filter_path)
    map_put(fs, "result", result)
    map_put(fs, "duration", duration_ms)
    filters, _ = map.get(stats, "filters")
    list.add(filters, fs)
}

fn int_field(m: ptr, key: string) -> int {
    v, _ = map.get(m, key)
    return mem.ptr_to_long(v) as int
}

// Accessors for stats records. Durations are in milliseconds; the record is
// valid while the on_stats callback runs.
stats_get_path(stats: ptr) -> string { v, _ = map.get_string(stats, "path"); return v }
stats_get_endpoint(stats: ptr) -> string { v, _ = map.get_string(stats, "endpoint"); return v }
stats_get_status(stats: ptr) -> int { return int_field(stats, "status") }
stats_get_duration(stats: ptr) -> int { return int_field(stats, "duration") }
stats_get_endpoint_duration(stats: ptr) -> int { return int_field(stats, "endpoint_duration") }
// The list of filter stat entries, in the order the filters ran.
stats_get_filters(stats: ptr) -> ptr { v, _ = map.get(stats, "filters"); return v }

// Accessors for filter stat entries. The result is "CONTINUE" or "STOP".
filter_stat_path(fs: ptr) -> string { v, _ = map.get_string(fs, "path"); return v }
filter_stat_result(fs: ptr) -> string { v, _ = map.get_string(fs, "result"); return v }
filter_stat_duration(fs: ptr) -> int { return int_field(fs, "duration") }

fn ms_since(started_ns: long) -> int {
    return ((os.now_monotonic_ns() - started_ns) / 1000000) as int
}

fn stats_free(stats: ptr) {
    filters, _ = map.get(stats, "filters")
    n = list.size(filters)
    for (i = 0; i < n; i++) {
        fs, _ = list.get(filters, i)
        map_free(fs)
    }
    list.free(filters)
    map_free(stats)
}

// ---------------------------------------------------------------------------
// WebSocket, SSE and chunked endpoints
//
// All served by std.http on the server's own port (#3109): its WebSocket codec
// is RFC 6455 conformance-tested (any length, binary, ping/pong, fragments,
// close codes), and its SSE and chunked streams write through the
// connection's own send path, TLS included.
// ---------------------------------------------------------------------------

// The trampoline std.http runs for a web_socket route (`ud` is its entry):
// each message the connection sends goes to the handler, until it closes.
@c_callback tw_ws_dispatch(req: ptr, ws: ptr, ud: ptr) {
    hboxed, _ = map.get(ud, "handler")
    ctx = attributes_new()
    while http.ws_recv(ws) != -1 {
        msg = http.ws_message_bytes(ws)
        text = ""
        if msg != null {
            text = string.new_with_length(msg, msg.len)
        }
        handler = unbox_closure(hboxed)
        call(handler, text, ws, ctx)
    }
    map_free(ctx)
}

// SSE endpoint entry: { path, handler_closure }
sse_entry(path_pattern: string, handler: @keep fn) {
    entry = map_new()
    map_put(entry, "path", path_pattern)
    map_put(entry, "handler", box_closure(handler))
    return entry
}

// DSL function: sse_endpoint("/events") |stream: ptr| { ... }
// The handler receives the stream (a std.http SSE stream) and pushes events
// with sse_send / sse_send_event; the connection closes when it returns.
sse_endpoint(_ctx: ptr, sse_path: string, handler: @keep fn) {
    sse_handlers, _ = map.get(_ctx, "sse_handlers")
    prefix, _ = map.get_string(_ctx, "prefix")
    full_path = "${prefix}${sse_path}"
    list.add(sse_handlers, sse_entry(full_path, handler))
}

// The trampoline std.http runs for an sse_endpoint route.
@c_callback tw_sse_dispatch(req: ptr, sse: ptr, ud: ptr) {
    hboxed, _ = map.get(ud, "handler")
    handler = unbox_closure(hboxed)
    call(handler, sse)
}

// Send an SSE data event. 0 when sent, -1 once the client has gone (the
// stream takes nothing more).
sse_send(stream: ptr, data: string) -> int {
    return http.sse_send(stream, "", data)
}

// Send a named SSE event. 0 or -1, as sse_send.
sse_send_event(stream: ptr, event_type: string, data: string) -> int {
    return http.sse_send(stream, event_type, data)
}

// Send an SSE comment (a keep-alive). 0 or -1, as sse_send.
sse_comment(stream: ptr, comment: string) -> int {
    return http.sse_comment(stream, comment)
}

// End the stream before the handler returns.
sse_close(stream: ptr) {
    http.sse_close(stream)
}

// --- Chunked transfer encoding ---
// A response whose body goes out in pieces, from an end_point handler:
//
//     stream, err = tinyweb.chunked_start(res, 200)
//     tinyweb.write_chunk(stream, "part one")
//     tinyweb.chunked_end(stream)
//
// The headers set on `res` before chunked_start go out with it.

// Send the head with `status` and Transfer-Encoding: chunked. Returns
// (stream, "") or (null, error) when the response already has a body.
chunked_start(res: ptr, status: int) -> {
    http.response_set_status(res, status)
    return http.response_begin_chunked(res)
}

// Send one chunk. 0 when sent, -1 once the client has gone.
write_chunk(stream: ptr, data: string) -> int {
    return http.chunked_write(stream, string.bytes(data))
}

// End the body. 0 when sent, -1 once the client has gone.
chunked_end(stream: ptr) -> int {
    return http.chunked_end(stream)
}

// ---------------------------------------------------------------------------
// DSL request dispatch
//
// The C server calls registered routes as plain @c_callback (req, res, ud)
// functions, but the DSL stores handlers/filters as boxed Aether closures. This
// trampoline is registered as the single C handler for every DSL route; `ud` is
// the route entry map (which also carries its pre-matched filter list). It runs
// the matching filter chain (honoring STOP), then unboxes and calls the
// endpoint handler. Without this, DSL routes registered via tw_start have no way
// to invoke their closures — this is what makes the builder DSL runnable.
//
// With an on_stats callback, each request's filters and endpoint are timed
// and the callback gets the record once the endpoint has returned.
// ---------------------------------------------------------------------------

@c_callback dsl_dispatch(req: ptr, res: ptr, ud: ptr) {
    entry = ud
    started = os.now_monotonic_ns()
    on_stats_boxed, _ = map.get(entry, "on_stats")
    stats = null
    if on_stats_boxed != 0 {
        patt, _ = map.get_string(entry, "path")
        stats = stats_record(http.request_path(req), patt, 0, 0, 0)
    }
    // Per-request context object shared by filters and the endpoint handler.
    ctx = attributes_new()

    // 1. Run this route's filter chain; a filter returning STOP short-circuits
    //    (it has already written the response).
    stopped = 0
    fl, _ = map.get(entry, "route_filters")
    fn_count = list.size(fl)
    for (fi = 0; fi < fn_count && stopped == 0; fi++) {
        fe, _ = list.get(fl, fi)
        fboxed, _ = map.get(fe, "handler")
        f_started = os.now_monotonic_ns()
        if call(unbox_closure(fboxed), req, res, ctx) == STOP { stopped = 1 }
        if stats != null {
            fpath, _ = map.get_string(fe, "path")
            result = "CONTINUE"
            if stopped == 1 { result = "STOP" }
            stats_add_filter(stats, fpath, result, ms_since(f_started))
        }
    }

    // 2. Run the endpoint handler.
    endpoint_ms = 0
    if stopped == 0 {
        h_started = os.now_monotonic_ns()
        hboxed, _ = map.get(entry, "handler")
        call(unbox_closure(hboxed), req, res, ctx)
        endpoint_ms = ms_since(h_started)
    }
    map_free(ctx)

    if stats != null {
        map_put(stats, "status", http.response_get_status(res))
        map_put(stats, "duration", ms_since(started))
        map_put(stats, "endpoint_duration", endpoint_ms)
        call(unbox_closure(on_stats_boxed), stats)
        stats_free(stats)
    }
}

// Does filter `fmethod`/`fpat` apply to a route with `rmethod`/`rpath`? Method
// matches if the filter is ALL or the same method; path matches if the route
// path begins with the filter's literal prefix (the common path()+filter(".*")
// case) — a pragmatic match that covers the mounted-resource use without a full
// regex engine in the registration path.
fn filter_applies(fmethod: int, fpat: string, rmethod: int, rpath: string) -> int {
    if fmethod != ALL && fmethod != rmethod {
        return 0
    }
    prefix = fpat
    if string.ends_with(fpat, "/.*") == 1 {
        prefix = string.substring(fpat, 0, string.length(fpat) - 3)
    } else if string.ends_with(fpat, ".*") == 1 {
        prefix = string.substring(fpat, 0, string.length(fpat) - 2)
    }
    if string.length(prefix) == 0 {
        return 1
    }
    if string.starts_with(rpath, prefix) == 1 {
        return 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Server lifecycle
// ---------------------------------------------------------------------------

tw_start(srv: ptr) -> string {
    port_v, _ = map.get(srv, "port")
    port = mem.ptr_to_long(port_v) as int
    host, _ = map.get_string(srv, "host")
    raw = http_server(srv)
    // server_bind returns "" on success, the reason otherwise
    // ("cannot bind 127.0.0.1:8080: Address already in use").
    bind_err = http.server_bind(raw, host, port)
    if bind_err != "" {
        return bind_err
    }

    // TLS, when with_tls supplied a pair. Applied before the routes so a bad
    // cert fails start-up rather than after the server looks ready -- and
    // deliberately NOT silently skipped, because a server that downgrades to
    // plaintext on a port the caller believes is HTTPS is the worse outcome.
    tls_cert, _ = map.get_string(srv, "tls_cert")
    tls_key, _ = map.get_string(srv, "tls_key")
    if string.length(tls_cert) > 0 || string.length(tls_key) > 0 {
        if string.length(tls_cert) == 0 || string.length(tls_key) == 0 {
            return "with_tls needs BOTH a cert and a key"
        }
        tls_err = http.server_set_tls(raw, tls_cert, tls_key)
        if tls_err != "" {
            return "TLS setup failed: ${tls_err}"
        }
    }

    // Register all routes with the C server
    // Uses http.server_add_route for all methods (GET, POST, PUT, DELETE,
    // PATCH, HEAD, OPTIONS, and the extended WebDAV/REST methods)
    // Keep-alive and the idle timeout: std.http's, for every connection.
    ka_v, _ = map.get(srv, "keep_alive")
    timeout_v, _ = map.get(srv, "socket_timeout_ms")
    ka_err = http.server_set_keepalive(raw, mem.ptr_to_long(ka_v) as int, 0,
        1ms * mem.ptr_to_long(timeout_v))
    if ka_err != "" {
        return "keep-alive setup failed: ${ka_err}"
    }

    on_stats_boxed, _ = map.get(srv, "on_stats")
    routes, _ = map.get(srv, "routes")
    all_filters, _ = map.get(srv, "filters")
    n = list.size(routes)
    for (i = 0; i < n; i++) {
        entry, _ = list.get(routes, i)
        method, _ = map.get(entry, "method")
        patt, _ = map.get_string(entry, "path")

        // Pre-match this route's filter chain (method + path prefix) so the
        // dispatch trampoline can run them without per-request pattern work.
        route_filters = list.new()
        fcount = list.size(all_filters)
        for (fi = 0; fi < fcount; fi++) {
            fe, _ = list.get(all_filters, fi)
            fm, _ = map.get(fe, "method")
            fp, _ = map.get_string(fe, "path")
            if filter_applies(fm, fp, method, patt) == 1 {
                list.add(route_filters, fe)
            }
        }
        map_put(entry, "route_filters", route_filters)
        map_put(entry, "on_stats", on_stats_boxed)

        // Register the trampoline as the C handler; the route entry is the
        // user_data it receives back as `ud`.
        method_str = method_to_string(method)
        http.server_add_route(raw, method_str, patt, dsl_dispatch, entry)
    }

    // Register static file serving routes
    // Register a wildcard GET that delegates to the C static file handler
    // We use the C http.serve_static which handles MIME types, traversal protection, etc.
    statics, _ = map.get(srv, "statics")
    n_static = list.size(statics)
    for (i = 0; i < n_static; i++) {
        entry, _ = list.get(statics, i)
        base, _ = map.get_string(entry, "base_path")
        dir, _ = map.get(entry, "directory")
        // Register a wildcard GET that delegates to the C static file handler
        // The C function handles: MIME detection, directory traversal protection,
        // index.html fallback, and 404 for missing files
        http.server_get(raw, "${base}/(.*)", http.serve_static, dir)
    }

    // WebSocket and SSE routes, on this same port.
    ws_handlers, _ = map.get(srv, "ws_handlers")
    n_ws = list.size(ws_handlers)
    for (i = 0; i < n_ws; i++) {
        entry, _ = list.get(ws_handlers, i)
        wpath, _ = map.get_string(entry, "path")
        http.server_websocket(raw, wpath, tw_ws_dispatch, entry)
    }
    sse_handlers, _ = map.get(srv, "sse_handlers")
    n_sse = list.size(sse_handlers)
    for (i = 0; i < n_sse; i++) {
        entry, _ = list.get(sse_handlers, i)
        spath, _ = map.get_string(entry, "path")
        http.server_sse(raw, spath, tw_sse_dispatch, entry)
    }

    // Start accepting connections (blocking).
    return http.server_start(raw)
}

tw_stop(srv: ptr) {
    raw, _ = map.get(srv, "raw_server")
    if raw != 0 {
        http.server_stop(raw)
        http.server_free(raw)
        map_put(srv, "raw_server", 0)
    }
}

// ---------------------------------------------------------------------------
// Composition — add routes to an existing server
// ---------------------------------------------------------------------------

// compose(server) { path("/module") { ... } }
compose(_srv: @keep ptr) {
    // Returns the server map itself so trailing block DSL functions work
    return _srv
}

// compose_at(server, root_path) { path(root_path) { ... } }
compose_at(_srv: @keep ptr, root_path: string) {
    // Just syntactic sugar — the caller still uses path() inside
    return _srv
}
