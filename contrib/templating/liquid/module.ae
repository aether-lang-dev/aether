// contrib.templating.liquid — Shopify Liquid templating engine for Aether.
//
// A faithful pure-Aether port of the Liquid template language
// (https://shopify.github.io/liquid/). Sandbox-friendly: no reflection,
// no eval, filter set is explicit.
//
// What it supports -- output, variable paths, filters, the control-flow and
// iteration tags, includes and layouts -- is listed in README.md beside
// this file.
//
// Surface:
//
//   import contrib.templating.liquid
//
//   t, err = liquid.parse_string("Hello {{ user.name }}! {{ tags | join: \", \" }}")
//
//   ctx = liquid.context_new()
//   liquid.context_put_json_text(ctx, "user", "{\"name\": \"alice\"}")
//   liquid.context_put_json_text(ctx, "tags", "[\"a\", \"b\"]")
//
//   out, _ = liquid.render(t, ctx)
//   // → "Hello alice! a, b"

import std.string
import std.strbuilder
import std.map
import std.collections
import std.cryptography
import std.encoding
import std.fs
import std.path
import std.bignum
import std.json
import std.time.calendar

exports(
    parse_string, parse_file,
    context_new, context_put_string,
    context_put_int, context_put_float, context_put_bool, context_put_nil,
    // Arrays and objects (#2177), and the time `date` reads as now (#2181)
    context_put_json, context_put_json_text, context_set_now, context_value_nodes,
    context_free,
    context_set_include_root,
    value_nil, value_bool, value_int, value_float, value_str,
    value_kind, value_payload, value_to_string,
    value_get_int, value_get_float,
    render, render_to_strbuilder,
    // Parsed templates and the partial cache (#2184)
    template_free, partial_cache_new, partial_cache_free,
    context_set_partial_cache, partial_loads
)

// ---------------------------------------------------------------------------
// Lexer — split source into TEXT / OUTPUT / TAG segments
// ---------------------------------------------------------------------------
//
// We store the token stream as parallel string_lists wrapped in a list:
//   index 0: token-kind strings ("TEXT" / "OUTPUT" / "TAG")
//   index 1: token-content strings
//
// `{% comment %}...{% endcomment %}` and `{% raw %}...{% endraw %}` are
// recognised at lex time and collapsed:
//   - comment-body bytes are dropped (no token emitted for the body)
//   - raw-body bytes are emitted as a single TEXT token verbatim, even
//     if they contain `{{` or `{%`
//
// Any other `{% ... %}` body becomes a TAG token. The renderer treats
// unknown tags as a render-time error, so the lexer can hand them
// through without parsing — future tag support is purely renderer-side
// growth.

const TOK_TEXT = "TEXT"
const TOK_OUTPUT = "OUTPUT"
const TOK_TAG = "TAG"

// Find the next `{{` OR `{%` starting at `p`. Returns (offset, kind)
// where kind is "{{" or "{%". Returns (-1, "") if none found.
find_next_delim(src: string, n: int, p: int) -> (int, string) {
    i = p
    while i < n - 1 {
        if string.char_at_n(src, n, i) == 123 { // '{'
            nxt = string.char_at_n(src, n, i + 1)
            if nxt == 123 { return i, "{{" }
            if nxt == 37 { return i, "{%" }
        }
        i = i + 1
    }
    return -1, ""
}

// Find `}}` starting at `p`. Returns -1 if not found.
find_output_close(src: string, n: int, p: int) -> int {
    i = p
    while i < n - 1 {
        if string.char_at_n(src, n, i) == 125 { // '}'
            if string.char_at_n(src, n, i + 1) == 125 { // '}'
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// Find `%}` starting at `p`. Returns -1 if not found.
find_tag_close(src: string, n: int, p: int) -> int {
    i = p
    while i < n - 1 {
        if string.char_at_n(src, n, i) == 37 { // '%'
            if string.char_at_n(src, n, i + 1) == 125 { // '}'
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// Return 1 if the trimmed tag body is literally the keyword `kw`
// (allowing for one or more trailing whitespace + extra chars to be
// rejected — `comment` MUST match exactly so that `commented` doesn't
// trip it). We currently use this only for the bare opener/closer
// keywords (`comment`, `endcomment`, `raw`, `endraw`).
tag_body_is(body: string, kw: string) -> int {
    return string.equals(body, kw)
}

// Return 1 if the trimmed tag body's first whitespace-separated word
// equals `kw`. Used for tags whose body carries arguments after the
// keyword (e.g. `{% liquid <body> %}` where the body is multi-line
// content, not a fixed keyword).
tag_body_is_head(body: string, kw: string) -> int {
    n = string_length(body)
    kn = string_length(kw)
    if n < kn { return 0 }
    if string.index_of_from_n(body, n, kw, 0) != 0 { return 0 }
    if n == kn { return 1 }
    // Boundary: next byte must be whitespace.
    c = string.char_at_n(body, n, kn)
    if c == 32 || c == 9 || c == 10 || c == 13 { return 1 }
    return 0
}

// Strip the leading `liquid` keyword off a `{% liquid ... %}` body,
// returning just the inner multi-tag text.
liquid_block_body(body: string) -> string {
    n = string_length(body)
    // Drop the leading "liquid".
    return trim(string.substring_n(body, n, 6, n))
}

// Emit synthetic tokens for each non-empty, non-comment line of a
// `{% liquid ... %}` body. Each line becomes a TAG token (or an OUTPUT
// token when the line starts with `echo `). Returns "" on success or
// an error string.
emit_liquid_lines(kinds: ptr, contents: ptr, body: string) -> string {
    n = string_length(body)
    p = 0
    while p < n {
        // Find end of this line.
        eol = p
        while eol < n {
            c = string.char_at_n(body, n, eol)
            if c == 10 { break }
            eol = eol + 1
        }
        line = trim(string.substring_n(body, n, p, eol))
        p = eol + 1
        if string_length(line) == 0 { continue }
        // `#` starts a comment line (Shopify spec).
        if string.char_at_n(line, string_length(line), 0) == 35 { continue }
        // `echo EXPR` → OUTPUT token with EXPR.
        if tag_body_is_head(line, "echo") == 1 {
            ln = string_length(line)
            expr = trim(string.substring_n(line, ln, 4, ln))
            string_list_add(kinds, TOK_OUTPUT)
            string_list_add(contents, expr)
        } else {
            string_list_add(kinds, TOK_TAG)
            string_list_add(contents, line)
        }
    }
    return ""
}

// Trim ASCII whitespace from both ends of `s`.
trim(s: string) -> string {
    n = string_length(s)
    a = 0
    while a < n {
        c = string.char_at_n(s, n, a)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            a = a + 1
        } else {
            break
        }
    }
    b = n
    while b > a {
        c = string.char_at_n(s, n, b - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            b = b - 1
        } else {
            break
        }
    }
    return string.substring_n(s, n, a, b)
}

// Strip a leading `-` from `s` if present. Returns (s_without_leading_dash, 1)
// when stripped, else (s, 0). Called on the RAW body, before any trimming:
// the whitespace-control marker is only the `-` directly against the braces
// (`{{-`), so `{{ -5 }}` is the number -5, not a marker and a 5.
peel_left_dash(s: string) -> (string, int) {
    n = string_length(s)
    if n == 0 { return s, 0 }
    if string.char_at_n(s, n, 0) == 45 { // '-'
        return string.substring_n(s, n, 1, n), 1
    }
    return s, 0
}

// Strip a trailing `-` from `s` if present. Returns (s_without_trailing_dash, 1)
// when stripped, else (s, 0).
peel_right_dash(s: string) -> (string, int) {
    n = string_length(s)
    if n == 0 { return s, 0 }
    if string.char_at_n(s, n, n - 1) == 45 { // '-'
        return string.substring_n(s, n, 0, n - 1), 1
    }
    return s, 0
}

// Same trim as `trim` but record-keeping ASCII whitespace only.
// `rtrim` strips trailing whitespace from `s`.
rtrim(s: string) -> string {
    n = string_length(s)
    b = n
    while b > 0 {
        c = string.char_at_n(s, n, b - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            b = b - 1
        } else {
            break
        }
    }
    return string.substring_n(s, n, 0, b)
}

// `ltrim` strips leading whitespace from `s`.
ltrim(s: string) -> string {
    n = string_length(s)
    a = 0
    while a < n {
        c = string.char_at_n(s, n, a)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            a = a + 1
        } else {
            break
        }
    }
    return string.substring_n(s, n, a, n)
}

// Extract a block-closer's left/right dash flags. `close_open` is the
// byte index of the closer's `{%`; `close_after` is the byte AFTER its
// `%}`. The body lives at `[close_open + 2, close_after - 2)`.
closer_dashes(src: string, n: int, close_open: int, close_after: int) -> (int, int) {
    body_start = close_open + 2
    body_end = close_after - 2
    if body_end <= body_start { return 0, 0 }
    raw = string.substring_n(src, n, body_start, body_end)
    _, ls = peel_left_dash(raw)
    _, rs = peel_right_dash(raw)
    return ls, rs
}

// If the last emitted token is a TEXT, rtrim it in place. Used when an
// opener carries leading `-` (`{{-` / `{%-`).
strip_trailing_ws_of_last_text(kinds: ptr, contents: ptr) {
    sz = string_list_size(kinds)
    if sz == 0 { return }
    last_kind = string_list_get(kinds, sz - 1)
    if string.equals(last_kind, TOK_TEXT) == 0 { return }
    last_text = string_list_get(contents, sz - 1)
    string_list_set(contents, sz - 1, rtrim(last_text))
}

// Lex `src` into the parallel-list token stream described above. Returns
// (tokens, "") on success or (tokens, error_message) on a syntax problem.
//
// Whitespace control:
//   `{{- x }}`  / `{%- if %}`  — strip trailing whitespace of the
//                                immediately preceding TEXT token
//   `{{ x -}}`  / `{% if -%}`  — strip leading whitespace of the next
//                                TEXT token (carried via `strip_next`)
//   For `comment` / `raw` blocks, the dashes on the OPENER affect the
//   preceding TEXT, and the dashes on the CLOSER affect the next TEXT
//   (the body of a `comment` is dropped; a `raw` body is preserved
//   verbatim and is itself eligible to have its trailing whitespace
//   trimmed if the closer has a leading dash).
// Count `\n` bytes in `src[0..end)`. The line number reported in lex
// errors is `count + 1` so the first line is 1, not 0.
count_lines_to(src: string, n: int, end: int) -> int {
    lim = end
    if lim > n { lim = n }
    c = 0
    i = 0
    while i < lim {
        if string.char_at_n(src, n, i) == 10 { c = c + 1 }
        i = i + 1
    }
    return c
}

// `loc_suffix` builds " at line N" — appended to lex error messages so
// users can find the unterminated delimiter in long templates.
// Does a tag or output body contain a control character other than tab,
// CR or LF? No Liquid syntax uses one, and refusing them at the lexer keeps
// every name a template can bind or read printable -- which is what makes
// the context's internal keys (partial_cache_key) unreachable from a
// template, for writes (assign, capture, for, ...) as well as reads.
has_control_char(s: string) -> int {
    n = string_length(s)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c < 32 && c != 9 && c != 10 && c != 13 { return 1 }
        i = i + 1
    }
    return 0
}

loc_suffix(src: string, n: int, off: int) -> string {
    return string.concat(" at line ", string.from_int(count_lines_to(src, n, off) + 1))
}

lex(src: string) -> (ptr, string) {
    kinds = string_list_new()
    contents = string_list_new()
    n = string_length(src)
    pos = 0
    strip_next = 0
    while pos < n {
        open_at, opener = find_next_delim(src, n, pos)
        if open_at < 0 {
            // Trailing text only.
            tail = string.substring_n(src, n, pos, n)
            if strip_next == 1 {
                tail = ltrim(tail)
                strip_next = 0
            }
            string_list_add(kinds, TOK_TEXT)
            string_list_add(contents, tail)
            pos = n
        } else {
            if open_at > pos {
                text = string.substring_n(src, n, pos, open_at)
                if strip_next == 1 {
                    text = ltrim(text)
                    strip_next = 0
                }
                string_list_add(kinds, TOK_TEXT)
                string_list_add(contents, text)
            } else {
                // Nothing emitted between previous tag and this one;
                // `strip_next` from the previous closer is consumed
                // implicitly (there's no text to trim, but it must NOT
                // carry over to a later TEXT past this tag).
                strip_next = 0
            }
            if string.equals(opener, "{{") == 1 {
                // Output tag.
                close_at = find_output_close(src, n, open_at + 2)
                if close_at < 0 {
                    tail = string.substring_n(src, n, open_at, n)
                    string_list_add(kinds, TOK_TEXT)
                    string_list_add(contents, tail)
                    toks = list_new()
                    list_add_raw(toks, kinds)
                    list_add_raw(toks, contents)
                    return toks, string.concat("unterminated `{{`", loc_suffix(src, n, open_at))
                }
                raw_body = string.substring_n(src, n, open_at + 2, close_at)
                if has_control_char(raw_body) == 1 {
                    toks = list_new()
                    list_add_raw(toks, kinds)
                    list_add_raw(toks, contents)
                    return toks, string.concat("control character inside a tag", loc_suffix(src, n, open_at))
                }
                body, ls = peel_left_dash(raw_body)
                body, rs = peel_right_dash(body)
                body = trim(body)
                if ls == 1 { strip_trailing_ws_of_last_text(kinds, contents) }
                if rs == 1 { strip_next = 1 }
                string_list_add(kinds, TOK_OUTPUT)
                string_list_add(contents, body)
                pos = close_at + 2
            } else {
                // Tag — `{% ... %}`.
                close_at = find_tag_close(src, n, open_at + 2)
                if close_at < 0 {
                    tail = string.substring_n(src, n, open_at, n)
                    string_list_add(kinds, TOK_TEXT)
                    string_list_add(contents, tail)
                    toks = list_new()
                    list_add_raw(toks, kinds)
                    list_add_raw(toks, contents)
                    return toks, string.concat("unterminated `{%`", loc_suffix(src, n, open_at))
                }
                raw_body = string.substring_n(src, n, open_at + 2, close_at)
                if has_control_char(raw_body) == 1 {
                    toks = list_new()
                    list_add_raw(toks, kinds)
                    list_add_raw(toks, contents)
                    return toks, string.concat("control character inside a tag", loc_suffix(src, n, open_at))
                }
                body, ls = peel_left_dash(raw_body)
                body, rs = peel_right_dash(body)
                body = trim(body)
                if ls == 1 { strip_trailing_ws_of_last_text(kinds, contents) }
                pos_after = close_at + 2

                // `comment` and `raw` are recognised at lex time: scan
                // forward to the matching `endcomment`/`endraw` and
                // either drop or preserve the body in one TEXT token.
                //
                // `{%# ... %}` is Shopify's inline (single-tag) comment
                // form. The body's first non-space byte is `#`; we just
                // drop the tag entirely. Outer dash strips already
                // applied to the preceding text (via `ls`); the closer's
                // right-strip carries to the next TEXT.
                if string_length(body) > 0 &&
                string.char_at_n(body, string_length(body), 0) == 35 { // '#'
                    if rs == 1 { strip_next = 1 }
                    pos = pos_after
                    continue
                }
                if tag_body_is(body, "comment") == 1 {
                    end_at, end_close = find_block_end(src, n, pos_after, "endcomment")
                    if end_at < 0 {
                        toks = list_new()
                        list_add_raw(toks, kinds)
                        list_add_raw(toks, contents)
                        return toks, string.concat("unterminated `{% comment %}`", loc_suffix(src, n, open_at))
                    }
                    // The opener's right-strip would consume the very
                    // first TEXT of the comment body — which we drop
                    // anyway, so just clear it. The closer's left-strip
                    // is moot for the same reason. The closer's
                    // right-strip carries past `endcomment` to the
                    // next TEXT.
                    strip_next = 0
                    _, cend_rs = closer_dashes(src, n, end_at, end_close)
                    if cend_rs == 1 { strip_next = 1 }
                    pos = end_close
                } else if tag_body_is(body, "raw") == 1 {
                    end_at, end_close = find_block_end(src, n, pos_after, "endraw")
                    if end_at < 0 {
                        toks = list_new()
                        list_add_raw(toks, kinds)
                        list_add_raw(toks, contents)
                        return toks, string.concat("unterminated `{% raw %}`", loc_suffix(src, n, open_at))
                    }
                    raw_text = string.substring_n(src, n, pos_after, end_at)
                    // The OPENER's right-strip eats leading whitespace
                    // of the raw body. The CLOSER's left-strip eats
                    // its trailing whitespace. The CLOSER's right-strip
                    // carries past `endraw` to the next TEXT.
                    if rs == 1 { raw_text = ltrim(raw_text) }
                    cend_ls, cend_rs = closer_dashes(src, n, end_at, end_close)
                    if cend_ls == 1 { raw_text = rtrim(raw_text) }
                    strip_next = 0
                    if cend_rs == 1 { strip_next = 1 }
                    string_list_add(kinds, TOK_TEXT)
                    string_list_add(contents, raw_text)
                    pos = end_close
                } else if tag_body_is_head(body, "liquid") == 1 {
                    // `{% liquid %}` block — the body is a sequence of
                    // bare tags, one per line. Each non-empty, non-`#`-
                    // comment line is emitted as a synthetic TAG (or
                    // OUTPUT for `echo EXPR`). The right-dash on the
                    // outer `liquid` tag applies to the next TEXT after
                    // the WHOLE block.
                    inner_body = liquid_block_body(body)
                    lerr2 = emit_liquid_lines(kinds, contents, inner_body)
                    if lerr2 != "" {
                        toks = list_new()
                        list_add_raw(toks, kinds)
                        list_add_raw(toks, contents)
                        return toks, lerr2
                    }
                    if rs == 1 { strip_next = 1 }
                    pos = pos_after
                } else {
                    // Future tag — pass through; renderer will error
                    // or execute (e.g. `assign`).
                    if rs == 1 { strip_next = 1 }
                    string_list_add(kinds, TOK_TAG)
                    string_list_add(contents, body)
                    pos = pos_after
                }
            }
        }
    }
    toks = list_new()
    list_add_raw(toks, kinds)
    list_add_raw(toks, contents)
    return toks, ""
}

// Find a `{% endXX %}` block-end starting at `p`. Returns
//   (body_end_offset, after_close_offset)
// where `body_end_offset` is the byte just BEFORE the `{%` (i.e. the
// last byte of the block body), and `after_close_offset` is the byte
// AFTER the closing `%}`. On failure returns (-1, -1).
find_block_end(src: string, n: int, p: int, endkw: string) -> (int, int) {
    i = p
    while i < n - 1 {
        if string.char_at_n(src, n, i) == 123 &&
        string.char_at_n(src, n, i + 1) == 37 {
            // Found `{%`. Read its body and check for the matching endXX.
            body_start = i + 2
            close_at = find_tag_close(src, n, body_start)
            if close_at < 0 {
                return -1, -1
            }
            raw_body = string.substring_n(src, n, body_start, close_at)
            body, _ = peel_left_dash(raw_body)
            body, _ = peel_right_dash(body)
            body = trim(body)
            if string.equals(body, endkw) == 1 {
                return i, close_at + 2
            }
            // Not the matching close; skip past this inner tag and continue.
            i = close_at + 2
        } else {
            i = i + 1
        }
    }
    return -1, -1
}

// ---------------------------------------------------------------------------
// Filters — pipeline applied at OUTPUT render time
// ---------------------------------------------------------------------------
//
// The OUTPUT body is `expr (| filter[:arg[,arg]*])*`. We split on top-level
// `|` first (respecting quoted strings so a literal `|` inside `"a|b"`
// stays intact), then each filter stage on top-level `:` between name and
// args, then args on top-level `,`. An argument is a literal or a variable
// path, like any value.
//
// Two kinds of filter (apply_filter_in): the text filters (apply_filter_args)
// work on their input's text and give text or a number; the value filters
// (value_filter) -- the array filters, `size`, `first`, `last`, `reverse`,
// `default` and `date` -- take and give values of any kind, so an array
// flows from `split` through `sort` to `join`. README.md lists them all.

// Find the next byte in `s` (length `n`) at or after `p` that matches
// `target` AND is not inside a single- or double-quoted string. Returns
// -1 if not found. The Liquid filter syntax doesn't allow escapes inside
// quoted strings (Shopify docs are clear on this — a `"` inside a
// double-quoted literal must use the other quote style), so a simple
// in-quote flag is enough.
find_outside_quotes(s: string, n: int, p: int, target: int) -> int {
    i = p
    in_s = 0
    in_d = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if in_s == 1 {
            if c == 39 { in_s = 0 } // '\''
        } else if in_d == 1 {
            if c == 34 { in_d = 0 } // '"'
        } else {
            if c == 39 { in_s = 1 }
            else if c == 34 { in_d = 1 }
            else if c == target { return i }
        }
        i = i + 1
    }
    return -1
}

// Split `body` on top-level pipes, respecting quotes. Returns a
// string_list of trimmed segments. `"x | upcase | append:'!'"` →
// ["x", "upcase", "append:'!'"].
split_pipes(body: string) -> ptr {
    out = string_list_new()
    n = string_length(body)
    p = 0
    while p <= n {
        cut = find_outside_quotes(body, n, p, 124) // '|'
        if cut < 0 {
            string_list_add(out, trim(string.substring_n(body, n, p, n)))
            return out
        }
        string_list_add(out, trim(string.substring_n(body, n, p, cut)))
        p = cut + 1
    }
    return out
}

// Split a filter stage `name:arg1,arg2` into (name, args_string). Returns
// ("name", "") for an arg-less filter.
split_name_args(stage: string) -> (string, string) {
    n = string_length(stage)
    cut = find_outside_quotes(stage, n, 0, 58) // ':'
    if cut < 0 {
        return trim(stage), ""
    }
    name = trim(string.substring_n(stage, n, 0, cut))
    rest = trim(string.substring_n(stage, n, cut + 1, n))
    return name, rest
}

// Split an args string `'a',"b",'c'` on top-level commas. Returns a
// string_list of trimmed segments.
split_commas(args: string) -> ptr {
    out = string_list_new()
    n = string_length(args)
    if n == 0 { return out }
    p = 0
    while p <= n {
        cut = find_outside_quotes(args, n, p, 44) // ','
        if cut < 0 {
            string_list_add(out, trim(string.substring_n(args, n, p, n)))
            return out
        }
        string_list_add(out, trim(string.substring_n(args, n, p, cut)))
        p = cut + 1
    }
    return out
}

// Is `a` a number literal, `-?digits` or `-?digits.digits`?
is_number_literal(a: string) -> int {
    n = string_length(a)
    i = 0
    if n > 0 && string.char_at_n(a, n, 0) == 45 { i = 1 }
    if i >= n { return 0 }
    digits = 0
    dot = -1
    while i < n {
        c = string.char_at_n(a, n, i)
        if c == 46 {
            if dot >= 0 || digits == 0 { return 0 }
            dot = i
        } else if c < 48 || c > 57 {
            return 0
        } else {
            digits = digits + 1
        }
        i = i + 1
    }
    if dot == n - 1 { return 0 }
    return 1
}

// A filter argument's value: a quoted string without its quotes, or a
// number literal as written (`round: 2`, `plus: -3`), which is how Liquid
// writes numeric arguments. Returns (value, "") or ("", error). An argument
// naming a variable arrives here already resolved (apply_filter_in).
unquote_arg(a: string) -> (string, string) {
    n = string_length(a)
    if is_number_literal(a) == 1 { return a, "" }
    if n < 2 {
        return "", string.concat("filter arg must be a quoted string or a number: ", a)
    }
    first = string.char_at_n(a, n, 0)
    last = string.char_at_n(a, n, n - 1)
    if (first == 34 && last == 34) || (first == 39 && last == 39) {
        return string.substring_n(a, n, 1, n - 1), ""
    }
    return "", string.concat("filter arg must be a quoted string or a number: ", a)
}

// Capitalize: first byte to upper, rest to lower (Liquid spec).
filter_capitalize(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    head = string.to_upper(string.substring_n(s, n, 0, 1))
    if n == 1 { return head }
    tail = string.to_lower(string.substring_n(s, n, 1, n))
    return string.concat(head, tail)
}

// Reverse the bytes of `s`. ASCII-correct; multi-byte UTF-8 is left as
// a future fix (matches the rest of the byte-level string surface).
filter_reverse(s: string) -> string {
    n = string_length(s)
    if n <= 1 { return s }
    sb = strbuilder.new(n)
    i = n - 1
    while i >= 0 {
        c = string.char_at_n(s, n, i)
        strbuilder.append(sb, string.from_char(c))
        i = i - 1
    }
    return strbuilder.finish(sb)
}

// Strip leading whitespace only.
filter_lstrip(s: string) -> string {
    n = string_length(s)
    a = 0
    while a < n {
        c = string.char_at_n(s, n, a)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            a = a + 1
        } else {
            break
        }
    }
    return string.substring_n(s, n, a, n)
}

// Strip trailing whitespace only.
filter_rstrip(s: string) -> string {
    n = string_length(s)
    b = n
    while b > 0 {
        c = string.char_at_n(s, n, b - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            b = b - 1
        } else {
            break
        }
    }
    return string.substring_n(s, n, 0, b)
}

// Replace every occurrence of `needle` in `hay` with `repl`. `needle ==
// ""` is treated as a no-op (Liquid behaviour — Shopify's
// implementation does not infinitely insert).
filter_replace(hay: string, needle: string, repl: string) -> string {
    nn = string_length(needle)
    if nn == 0 { return hay }
    hn = string_length(hay)
    if hn == 0 { return hay }
    sb = strbuilder.new(hn)
    p = 0
    while p < hn {
        hit = string.index_of_from_n(hay, hn, needle, p)
        if hit < 0 {
            strbuilder.append(sb, string.substring_n(hay, hn, p, hn))
            return strbuilder.finish(sb)
        }
        strbuilder.append(sb, string.substring_n(hay, hn, p, hit))
        strbuilder.append(sb, repl)
        p = hit + nn
    }
    return strbuilder.finish(sb)
}

// Replace only the FIRST occurrence of `needle` in `hay` with `repl`.
filter_replace_first(hay: string, needle: string, repl: string) -> string {
    nn = string_length(needle)
    if nn == 0 { return hay }
    hn = string_length(hay)
    if hn == 0 { return hay }
    hit = string.index_of_from_n(hay, hn, needle, 0)
    if hit < 0 { return hay }
    sb = strbuilder.new(hn)
    strbuilder.append(sb, string.substring_n(hay, hn, 0, hit))
    strbuilder.append(sb, repl)
    strbuilder.append(sb, string.substring_n(hay, hn, hit + nn, hn))
    return strbuilder.finish(sb)
}

// HTML-escape `&`, `<`, `>`, `"`, `'`. Liquid's `escape` is byte-level —
// applied repeatedly it double-escapes; `escape_once` is the
// idempotent version (skip already-escaped entities).
filter_escape(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 38 { strbuilder.append(sb, "&amp;") } // &
        else if c == 60 { strbuilder.append(sb, "&lt;") } // <
        else if c == 62 { strbuilder.append(sb, "&gt;") } // >
        else if c == 34 { strbuilder.append(sb, "&quot;") } // "
        else if c == 39 { strbuilder.append(sb, "&#39;") } // '
        else { strbuilder.append(sb, string.from_char(c)) }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// Return 1 if the substring of `s` starting at `i` (length `n`) is an
// HTML entity reference: `&NAME;` or `&#NUM;` or `&#xHEX;`. Used by
// `escape_once` to detect already-encoded text.
is_html_entity_at(s: string, n: int, i: int) -> int {
    if i >= n { return 0 }
    if string.char_at_n(s, n, i) != 38 { return 0 } // '&'
    // Scan for the terminating `;` within a reasonable distance.
    // HTML5 caps named entities around 32 chars; numeric refs are short.
    j = i + 1
    limit = i + 33
    if limit > n { limit = n }
    if j >= limit { return 0 }
    first = string.char_at_n(s, n, j)
    // Accept either `#` (numeric) or an ASCII letter (named).
    is_num = 0
    if first == 35 {
        is_num = 1
        j = j + 1
    } else if (first >= 65 && first <= 90) || (first >= 97 && first <= 122) {
        // ASCII letter — fine
    } else {
        return 0
    }
    while j < limit {
        c = string.char_at_n(s, n, j)
        if c == 59 { return 1 } // ';'
        if is_num == 1 {
            // numeric: digits OR `x`/`X` allowed immediately after `#`
            if (c >= 48 && c <= 57) { j = j + 1; continue }
            if (c == 120 || c == 88) && j == i + 2 { j = j + 1; continue }
            if (c >= 65 && c <= 70) || (c >= 97 && c <= 102) { j = j + 1; continue }
            return 0
        } else {
            // named: ASCII alnum
            if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
                j = j + 1
                continue
            }
            return 0
        }
    }
    return 0
}

// `escape_once`: HTML-escape `&` only when it is NOT already starting
// an entity. `<`, `>`, `"`, `'` always escape.
filter_escape_once(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 38 {
            if is_html_entity_at(s, n, i) == 1 {
                strbuilder.append(sb, "&")
            } else {
                strbuilder.append(sb, "&amp;")
            }
        }
        else if c == 60 { strbuilder.append(sb, "&lt;") }
        else if c == 62 { strbuilder.append(sb, "&gt;") }
        else if c == 34 { strbuilder.append(sb, "&quot;") }
        else if c == 39 { strbuilder.append(sb, "&#39;") }
        else { strbuilder.append(sb, string.from_char(c)) }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// One hex digit (0..15) → ASCII byte ('0'..'9', 'A'..'F').
hex_digit(v: int) -> int {
    if v < 10 { return 48 + v }
    return 55 + v
}

// `url_encode`: RFC 3986 unreserved kept; space → `+`; everything else
// `%HH`. This matches Shopify Liquid (form-encoded space → `+`, not
// percent-encoded).
filter_url_encode(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        // Unreserved per RFC 3986: A-Z a-z 0-9 - _ . ~
        if (c >= 48 && c <= 57) ||
        (c >= 65 && c <= 90) ||
        (c >= 97 && c <= 122) ||
        c == 45 || c == 95 || c == 46 || c == 126 {
            strbuilder.append(sb, string.from_char(c))
        } else if c == 32 {
            strbuilder.append(sb, "+")
        } else {
            // Keep byte unsigned for the high half.
            b = c & 255
            strbuilder.append(sb, "%")
            strbuilder.append(sb, string.from_char(hex_digit(b >> 4)))
            strbuilder.append(sb, string.from_char(hex_digit(b & 15)))
        }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// Parse a single hex digit byte; returns -1 if not a hex digit.
parse_hex(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return -1
}

// `url_decode`: inverse of `url_encode`. `+` → space; `%HH` → byte;
// malformed `%` is emitted verbatim (Shopify behaviour is forgiving
// here — does not error).
filter_url_decode(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 43 {
            strbuilder.append(sb, " ")
            i = i + 1
        } else if c == 37 && i + 2 < n {
            hi = parse_hex(string.char_at_n(s, n, i + 1))
            lo = parse_hex(string.char_at_n(s, n, i + 2))
            if hi >= 0 && lo >= 0 {
                strbuilder.append(sb, string.from_char((hi << 4) | lo))
                i = i + 3
            } else {
                strbuilder.append(sb, "%")
                i = i + 1
            }
        } else {
            strbuilder.append(sb, string.from_char(c))
            i = i + 1
        }
    }
    return strbuilder.finish(sb)
}

// `truncatewords`: keep the first `cap` whitespace-delimited words.
// If truncation happens, append "...". Multiple spaces between words
// collapse to a single space in the output (Shopify behaviour).
filter_truncatewords(s: string, cap: int) -> string {
    n = string_length(s)
    if cap <= 0 { return "" }
    sb = strbuilder.new(n)
    i = 0
    words = 0
    while i < n && words < cap {
        // Skip leading whitespace.
        while i < n {
            c = string.char_at_n(s, n, i)
            if c == 32 || c == 9 || c == 10 || c == 13 {
                i = i + 1
            } else {
                break
            }
        }
        if i >= n { break }
        if words > 0 { strbuilder.append(sb, " ") }
        // Copy one word.
        while i < n {
            c = string.char_at_n(s, n, i)
            if c == 32 || c == 9 || c == 10 || c == 13 { break }
            strbuilder.append(sb, string.from_char(c))
            i = i + 1
        }
        words = words + 1
    }
    // Anything remaining (after stripping leading whitespace) → ellipsis.
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    if i < n {
        strbuilder.append(sb, "...")
    }
    return strbuilder.finish(sb)
}

// `newline_to_br`: insert `<br />` before each `\n`, preserving the
// `\n` (Shopify behaviour). `\r\n` and `\r` are treated as plain `\n`.
filter_newline_to_br(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 10 {
            strbuilder.append(sb, "<br />\n")
        } else if c == 13 {
            // \r or \r\n → emit one <br />\n, skip an optional \n
            strbuilder.append(sb, "<br />\n")
            if i + 1 < n && string.char_at_n(s, n, i + 1) == 10 {
                i = i + 1
            }
        } else {
            strbuilder.append(sb, string.from_char(c))
        }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// `escape_xml`: XML-safe escape. Same as `escape` except `'` becomes
// `&apos;` (the XML 1.0 reference) rather than `&#39;` (HTML numeric
// charref). `&` `<` `>` `"` are handled identically to `escape`.
filter_escape_xml(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 38 { strbuilder.append(sb, "&amp;") }
        else if c == 60 { strbuilder.append(sb, "&lt;") }
        else if c == 62 { strbuilder.append(sb, "&gt;") }
        else if c == 34 { strbuilder.append(sb, "&quot;") }
        else if c == 39 { strbuilder.append(sb, "&apos;") }
        else { strbuilder.append(sb, string.from_char(c)) }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// `json_escape`: escape a string for embedding inside a JSON string
// literal. Quotes are NOT added — caller wraps in `"..."`. Backslash
// and double-quote are backslash-escaped; control bytes (< 0x20) emit
// `\uXXXX`; 0x7F passes through verbatim (Shopify's `json_escape` is
// minimal — it does not touch high-bit bytes either, so a UTF-8 byte
// sequence stays as-is).
filter_json_escape(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 92 { strbuilder.append(sb, "\\\\") }
        else if c == 34 { strbuilder.append(sb, "\\\"") }
        else if c == 8 { strbuilder.append(sb, "\\b") }
        else if c == 9 { strbuilder.append(sb, "\\t") }
        else if c == 10 { strbuilder.append(sb, "\\n") }
        else if c == 12 { strbuilder.append(sb, "\\f") }
        else if c == 13 { strbuilder.append(sb, "\\r") }
        else if c < 32 {
            // Emit `\u00XX`.
            strbuilder.append(sb, "\\u00")
            strbuilder.append(sb, string.from_char(hex_digit(c >> 4)))
            strbuilder.append(sb, string.from_char(hex_digit(c & 15)))
        }
        else { strbuilder.append(sb, string.from_char(c)) }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// `strip_html`: drop everything between `<` and `>` (inclusive).
// Unterminated `<` swallows to end of string. Matches Shopify
// (regex-free byte scan, no entity decoding).
filter_strip_html(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    in_tag = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if in_tag == 1 {
            if c == 62 { in_tag = 0 } // '>'
        } else {
            if c == 60 { in_tag = 1 } // '<'
            else { strbuilder.append(sb, string.from_char(c)) }
        }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// `strip_newlines`: drop every `\r` and `\n` byte (Shopify behaviour).
filter_strip_newlines(s: string) -> string {
    n = string_length(s)
    if n == 0 { return s }
    sb = strbuilder.new(n)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c != 10 && c != 13 {
            strbuilder.append(sb, string.from_char(c))
        }
        i = i + 1
    }
    return strbuilder.finish(sb)
}

// `slice` on a string: 1-arg form returns one byte starting at `start`;
// 2-arg form returns `len` bytes starting at `start`. Negative `start`
// indexes from the end (Shopify); negative `len` is invalid and
// returns empty.
filter_slice(s: string, start: int, len: int) -> string {
    n = string_length(s)
    a = start
    if a < 0 { a = n + a }
    if a < 0 { a = 0 }
    if a > n { a = n }
    b = a + len
    if b < a { return "" }
    if b > n { b = n }
    return string.substring_n(s, n, a, b)
}

// Parse a string-encoded integer argument. Returns (val, "") or (0, error).
// Filter arguments arrive as text (`round: 2` passes "2"), so the integer
// math filters and round's place count read them through this.
parse_int_arg(s: string, name: string) -> (int, string) {
    v, err = string.to_int(s)
    if err != "" {
        return 0, string.concat(string.concat(name, " arg not an integer: "), s)
    }
    return v, ""
}

// Truncate `s` to `cap` bytes, appending `ell` if the string was cut.
// Matches Liquid's default: total length (including the ellipsis) is
// `cap`. If `cap <= length(ell)` the ellipsis itself is truncated.
filter_truncate(s: string, cap: int, ell: string) -> string {
    n = string_length(s)
    if cap < 0 { return "" }
    if n <= cap { return s }
    eln = string_length(ell)
    if cap <= eln {
        return string.substring_n(s, n, 0, cap)
    }
    body = string.substring_n(s, n, 0, cap - eln)
    return string.concat(body, ell)
}

// ---- Numbers, as Liquid reads them ---------------------------------------
//
// Liquid's Utils.to_number: a string that is exactly `-?digits.digits` is a
// decimal (a BigDecimal in the reference implementation), anything else is
// read the way Ruby's String#to_i reads it -- leading whitespace, an
// optional sign, then as many digits as there are ("12px" is 12, "abc" is
// 0). The decimal side is kept as TEXT and rounded digit by digit, which is
// what makes `1.005 | round: 2` come out 1.01 as it does in Liquid, where
// binary floating point would give 1.0.

// (is_decimal, negative, integer_digits, fraction_digits). Integer digits
// carry no leading zeros ("0" for zero); fraction digits are as written.
number_parts(v: string) -> (int, int, string, string) {
    n = string_length(v)
    i = 0
    while i < n {
        c = string.char_at_n(v, n, i)
        if c != 32 && c != 9 && c != 10 && c != 13 { break }
        i = i + 1
    }
    neg = 0
    plus_sign = 0
    if i < n {
        c0 = string.char_at_n(v, n, i)
        if c0 == 45 { neg = 1; i = i + 1 }
        else if c0 == 43 { plus_sign = 1; i = i + 1 }
    }
    int_start = i
    while i < n {
        c = string.char_at_n(v, n, i)
        if c < 48 || c > 57 { break }
        i = i + 1
    }
    int_end = i
    if int_end == int_start { return 0, 0, "0", "" }
    // Strip leading zeros, keeping one digit.
    lead = int_start
    while lead < int_end - 1 && string.char_at_n(v, n, lead) == 48 { lead = lead + 1 }
    idigits = string.substring_n(v, n, lead, int_end)

    // A decimal only when the WHOLE (trimmed) text is `-?digits.digits`; a
    // `+` sign is to_i's, not the decimal pattern's ("+1.5" is 1).
    stop = n
    while stop > int_end {
        c = string.char_at_n(v, n, stop - 1)
        if c != 32 && c != 9 && c != 10 && c != 13 { break }
        stop = stop - 1
    }
    if plus_sign == 0 && int_end < stop && string.char_at_n(v, n, int_end) == 46 {
        f = int_end + 1
        while f < stop {
            c = string.char_at_n(v, n, f)
            if c < 48 || c > 57 { break }
            f = f + 1
        }
        if f == stop && f > int_end + 1 {
            return 1, neg, idigits, string.substring_n(v, n, int_end + 1, stop)
        }
    }
    if string.equals(idigits, "0") == 1 { neg = 0 }
    return 0, neg, idigits, ""
}

// A decimal digit string plus one ("129" -> "130", "99" -> "100").
digits_inc(d: string) -> string {
    n = string_length(d)
    carry = 1
    i = n - 1
    // Build the digits reversed, then flip them.
    rev = strbuilder.new(n + 1)
    while i >= 0 {
        c = string.char_at_n(d, n, i) - 48 + carry
        carry = 0
        if c == 10 { c = 0; carry = 1 }
        strbuilder.append(rev, string.from_char(c + 48))
        i = i - 1
    }
    if carry == 1 { strbuilder.append(rev, "1") }
    r = strbuilder.finish(rev)
    rn = string_length(r)
    sb = strbuilder.new(rn)
    j = rn - 1
    while j >= 0 {
        strbuilder.append(sb, string.from_char(string.char_at_n(r, rn, j)))
        j = j - 1
    }
    return strbuilder.finish(sb)
}

// Round `idigits.fdigits` to `places` fraction digits, half away from zero
// (BigDecimal's ROUND_HALF_UP). Returns the new (integer, fraction) digits.
round_digits(idigits: string, fdigits: string, places: int) -> (string, string) {
    fn_ = string_length(fdigits)
    if fn_ <= places { return idigits, fdigits }
    keep = string.substring_n(fdigits, fn_, 0, places)
    up = string.char_at_n(fdigits, fn_, places) >= 53 // '5'
    if up == false { return idigits, keep }
    if places == 0 { return digits_inc(idigits), "" }
    joined = digits_inc(string.concat(idigits, keep))
    jn = string_length(joined)
    return string.substring_n(joined, jn, 0, jn - places), string.substring_n(joined, jn, jn - places, jn)
}

// An integer result: "-" only when it is not zero.
int_text(neg: int, idigits: string) -> string {
    if neg == 1 && string.equals(idigits, "0") == 0 { return string.concat("-", idigits) }
    return idigits
}

// A decimal result as Ruby prints a Float: trailing zeros dropped, at least
// one fraction digit kept ("3.10" -> "3.1", "4." -> "4.0"), the sign kept
// even on zero ("-0.0"), as Ruby does.
float_text(neg: int, idigits: string, fdigits: string) -> string {
    return ddecimal_out(neg, dstrip(string.concat(idigits, fdigits)), string_length(fdigits))
}

// Is any fraction digit non-zero?
digits_nonzero(d: string) -> int {
    n = string_length(d)
    i = 0
    while i < n {
        if string.char_at_n(d, n, i) != 48 { return 1 }
        i = i + 1
    }
    return 0
}

// `abs`: the magnitude, in the input's own shape (Liquid returns an
// Integer for an integer and a Float for a decimal).
filter_abs(val: string) -> string {
    is_dec, _neg, idigits, fdigits = number_parts(val)
    if is_dec == 1 { return float_text(0, idigits, fdigits) }
    return idigits
}

// `ceil` / `floor`: the nearest integer above / below.
filter_ceil_floor(val: string, want_ceil: int) -> string {
    is_dec, neg, idigits, fdigits = number_parts(val)
    if is_dec == 0 || digits_nonzero(fdigits) == 0 { return int_text(neg, idigits) }
    // A fraction is present: ceil rounds a positive number up, floor a
    // negative one (away from zero); the other direction truncates.
    if (want_ceil == 1 && neg == 0) || (want_ceil == 0 && neg == 1) {
        return int_text(neg, digits_inc(idigits))
    }
    return int_text(neg, idigits)
}

// `round` / `round: N`. No argument (or 0) gives an integer; N > 0 rounds a
// decimal to N places and prints it as Ruby prints a Float. An integer input
// is already exact at any N and stays an integer, as in Liquid.
filter_round(val: string, places: int) -> string {
    is_dec, neg, idigits, fdigits = number_parts(val)
    if is_dec == 0 { return int_text(neg, idigits) }
    ri, rf = round_digits(idigits, fdigits, places)
    if places == 0 { return int_text(neg, ri) }
    return float_text(neg, ri, rf)
}

// ---- Exact decimal arithmetic (#2185) --------------------------------------
//
// Liquid's arithmetic runs on Ruby numbers: Integers are unbounded, a
// decimal operand makes a BigDecimal, and a BigDecimal result is printed
// through Float (`to_f`). So the math filters work here on exact decimals
// -- a sign, an unsigned mantissa (decimal digits, arithmetic by std.bignum)
// and a scale (digits after the point) -- and print a decimal result the
// way Ruby prints the Float nearest to it (ruby_float_text).

// Strip leading zeros from a digit string, keeping one ("007" -> "7").
dstrip(d: string) -> string {
    n = string_length(d)
    i = 0
    while i < n - 1 && string.char_at_n(d, n, i) == 48 { i = i + 1 }
    if i == 0 { return d }
    return string.substring_n(d, n, i, n)
}

// Compare two stripped digit strings as magnitudes: -1, 0 or 1.
dcmp(a: string, b: string) -> int {
    x, _xe = bignum.from_decimal(a)
    y, _ye = bignum.from_decimal(b)
    c = bignum.compare(x, y)
    bignum.free(x)
    bignum.free(y)
    if c < 0 { return -1 }
    if c > 0 { return 1 }
    return 0
}

// a + b for digit strings.
dadd(a: string, b: string) -> string {
    x, _xe = bignum.from_decimal(a)
    y, _ye = bignum.from_decimal(b)
    r = bignum.add(x, y)
    out = bignum.to_decimal(r)
    bignum.free(x)
    bignum.free(y)
    bignum.free(r)
    return out
}

// a - b for digit strings, a >= b.
dsub(a: string, b: string) -> string {
    x, _xe = bignum.from_decimal(a)
    y, _ye = bignum.from_decimal(b)
    r = bignum.subtract(x, y)
    out = bignum.to_decimal(r)
    bignum.free(x)
    bignum.free(y)
    bignum.free(r)
    return out
}

// `d` followed by `k` zeros (d * 10^k).
dshift(d: string, k: int) -> string {
    if k <= 0 || string.equals(d, "0") == 1 { return d }
    sb = strbuilder.new(string_length(d) + k + 1)
    strbuilder.append(sb, d)
    i = 0
    while i < k { strbuilder.append(sb, "0"); i = i + 1 }
    return strbuilder.finish(sb)
}

// a * b for digit strings.
dmul(a: string, b: string) -> string {
    x, _xe = bignum.from_decimal(a)
    y, _ye = bignum.from_decimal(b)
    r = bignum.multiply(x, y)
    out = bignum.to_decimal(r)
    bignum.free(x)
    bignum.free(y)
    bignum.free(r)
    return out
}

// (a / b, a mod b) for digit strings, b != "0".
ddivmod(a: string, b: string) -> (string, string) {
    // Both operands are magnitudes, so bignum's truncating division is the
    // floor the callers need.
    x, _xe = bignum.from_decimal(a)
    y, _ye = bignum.from_decimal(b)
    q = bignum.divide(x, y)
    r = bignum.remainder(x, y)
    qs = bignum.to_decimal(q)
    rs = bignum.to_decimal(r)
    bignum.free(x)
    bignum.free(y)
    bignum.free(q)
    bignum.free(r)
    return qs, rs
}

// Signed a + b where both have the same scale: (negative, mantissa).
dsigned_add(an: int, am: string, bn: int, bm: string) -> (int, string) {
    if an == bn { return an, dadd(am, bm) }
    c = dcmp(am, bm)
    if c == 0 { return 0, "0" }
    if c > 0 { return an, dsub(am, bm) }
    return bn, dsub(bm, am)
}

// The exponent of a Float's scientific spelling, `-?d.d+e[+-]d+` (what
// ruby_float_text writes past the fixed range, and so what a float binding
// holds): (1, exponent) when `v` is exactly that shape, else (0, 0).
float_exponent(v: string) -> (int, int) {
    t = trim(v)
    n = string_length(t)
    e = string.index_of_from_n(t, n, "e", 0)
    if e < 0 { return 0, 0 }
    mant = string.substring_n(t, n, 0, e)
    is_dec, _neg, _i, _f = number_parts(mant)
    if is_dec == 0 { return 0, 0 }
    etext = string.substring_n(t, n, e + 1, n)
    en = string_length(etext)
    if en < 2 { return 0, 0 }
    c0 = string.char_at_n(etext, en, 0)
    if c0 != 43 && c0 != 45 { return 0, 0 }
    k = 1
    while k < en {
        c = string.char_at_n(etext, en, k)
        if c < 48 || c > 57 { return 0, 0 }
        k = k + 1
    }
    ev, eerr = string.to_int(string.substring_n(etext, en, 1, en))
    if eerr != "" { return 0, 0 }
    if c0 == 45 { ev = 0 - ev }
    return 1, ev
}

// A number as (is_decimal, negative, mantissa, scale), read as Liquid reads
// it (number_parts), plus a Float's exponent spelling (float_exponent): a
// float binding holds `1.0e+20`, and that is the number 1e20, not 1.
dparse(v: string) -> (int, int, string, int) {
    has_exp, ev = float_exponent(v)
    text = v
    if has_exp == 1 {
        tt = trim(v)
        text = string.substring_n(tt, string_length(tt), 0, string.index_of_from_n(tt, string_length(tt), "e", 0))
    }
    is_dec, neg, idigits, fdigits = number_parts(text)
    m = dstrip(string.concat(idigits, fdigits))
    scale = string_length(fdigits) - ev
    if scale < 0 {
        m = dshift(m, 0 - scale)
        scale = 0
    }
    if string.equals(m, "0") == 1 { neg = 0 }
    return is_dec, neg, m, scale
}

// Decimal text for (negative, mantissa, scale): "-12.340".
dtext(neg: int, m: string, scale: int) -> string {
    mm = m
    while string_length(mm) <= scale { mm = string.concat("0", mm) }
    n = string_length(mm)
    body = string.substring_n(mm, n, 0, n - scale)
    if scale > 0 {
        body = string.concat(string.concat(body, "."), string.substring_n(mm, n, n - scale, n))
    }
    if neg == 1 { return string.concat("-", body) }
    return body
}

// The shortest decimal digits that read back as exactly `mag` (> 0, finite):
// (digits, decpt), meaning 0.<digits> x 10^decpt. string_from_double gives
// 17 significant digits, always enough to round-trip; the first shorter
// rounding of them that reads back the same double is the shortest.
shortest_digits(mag: float) -> (string, int) {
    t = string.string_from_double(mag)
    tn = string_length(t)
    epos = string.index_of_from_n(t, tn, "e", 0)
    mant = t
    exp10 = 0
    if epos >= 0 {
        mant = string.substring_n(t, tn, 0, epos)
        ev, _eerr = string.to_int(string.substring_n(t, tn, epos + 1, tn))
        exp10 = ev
    }
    mn = string_length(mant)
    dot = string.index_of_from_n(mant, mn, ".", 0)
    ipart = mant
    fpart = ""
    if dot >= 0 {
        ipart = string.substring_n(mant, mn, 0, dot)
        fpart = string.substring_n(mant, mn, dot + 1, mn)
    }
    digits = string.concat(ipart, fpart)
    decpt = string_length(ipart) + exp10
    // Leading zeros move the point.
    dn = string_length(digits)
    lz = 0
    while lz < dn - 1 && string.char_at_n(digits, dn, lz) == 48 { lz = lz + 1 }
    if lz > 0 {
        digits = string.substring_n(digits, dn, lz, dn)
        decpt = decpt - lz
    }
    dn = string_length(digits)
    k = 1
    while k <= dn {
        head = string.substring_n(digits, dn, 0, k)
        hd = decpt
        if k < dn && string.char_at_n(digits, dn, k) >= 53 {
            inc = digits_inc(head)
            if string_length(inc) > k {
                head = string.substring_n(inc, string_length(inc), 0, k)
                hd = decpt + 1
            } else {
                head = inc
            }
        }
        cand = string.concat(string.concat(string.concat("0.", head), "e"), string.from_int(hd))
        back, _berr = string.to_double(cand)
        if back == mag {
            // Drop trailing zeros; they carry no digits.
            hn = string_length(head)
            while hn > 1 && string.char_at_n(head, hn, hn - 1) == 48 { hn = hn - 1 }
            return string.substring_n(head, string_length(head), 0, hn), hd
        }
        k = k + 1
    }
    return digits, decpt
}

// `v` printed as Ruby prints a Float: the shortest digits that read back as
// `v`, in fixed notation with at least one fraction digit ("2.5", "3.0",
// "0.0001") while the decimal exponent is in (-4, 16], else scientific
// ("1.0e+16", "1.5e-05"); zero keeps its sign ("-0.0").
ruby_float_text(v: float) -> string {
    if v != v { return "NaN" }
    // Past NaN, v - v is non-zero only for an infinity.
    if v - v != 0.0 {
        if v > 0.0 { return "Infinity" }
        return "-Infinity"
    }
    sign = ""
    mag = v
    if v < 0.0 { sign = "-"; mag = 0.0 - v }
    if mag == 0.0 {
        z = string.string_from_double(v)
        if string.char_at_n(z, string_length(z), 0) == 45 { return "-0.0" }
        return "0.0"
    }
    digits, decpt = shortest_digits(mag)
    dn = string_length(digits)
    body = ""
    if decpt > 0 && decpt <= 16 {
        if decpt >= dn {
            body = string.concat(dshift(digits, decpt - dn), ".0")
        } else {
            body = string.concat(string.concat(string.substring_n(digits, dn, 0, decpt), "."),
                string.substring_n(digits, dn, decpt, dn))
        }
    } else if decpt <= 0 && decpt > -4 {
        zeros = ""
        zi = 0
        while zi < 0 - decpt { zeros = string.concat(zeros, "0"); zi = zi + 1 }
        body = string.concat(string.concat("0.", zeros), digits)
    } else {
        frac = "0"
        if dn > 1 { frac = string.substring_n(digits, dn, 1, dn) }
        e = decpt - 1
        esign = "+"
        if e < 0 { esign = "-"; e = 0 - e }
        etext = string.from_int(e)
        if e < 10 { etext = string.concat("0", etext) }
        body = string.concat(string.concat(string.concat(string.concat(
                        string.substring_n(digits, dn, 0, 1), "."), frac), string.concat("e", esign)), etext)
    }
    return string.concat(sign, body)
}

// A decimal result, printed through Float as Liquid prints it.
ddecimal_out(neg: int, m: string, scale: int) -> string {
    d, derr = string.to_double(dtext(neg, m, scale))
    if derr != "" {
        // Beyond a double's range: Ruby's to_f gives Infinity for a value
        // too large and zero for one too small, each with its sign.
        if string_length(m) - scale > 0 {
            if neg == 1 { return "-Infinity" }
            return "Infinity"
        }
        if neg == 1 { return "-0.0" }
        return "0.0"
    }
    return ruby_float_text(d)
}

// One arithmetic filter over two numbers read as Liquid reads them. Returns
// (text, error). Integer operands stay integers, unbounded; a decimal on
// either side makes the result a decimal. Division and modulo floor, as
// Ruby's do (-7 / 2 is -4, -7 % 3 is 2).
filter_arith(name: string, lhs_text: string, rhs_text: string) -> (string, string) {
    a_dec, a_neg, a_m, a_scale = dparse(lhs_text)
    b_dec, b_neg, b_m, b_scale = dparse(rhs_text)
    dec = 0
    if a_dec == 1 || b_dec == 1 { dec = 1 }
    // Common scale, so the mantissas are directly comparable.
    scale = a_scale
    if b_scale > scale { scale = b_scale }
    am = dshift(a_m, scale - a_scale)
    bm = dshift(b_m, scale - b_scale)

    if string.equals(name, "plus") == 1 || string.equals(name, "minus") == 1 {
        bn2 = b_neg
        if string.equals(name, "minus") == 1 && string.equals(bm, "0") == 0 { bn2 = 1 - b_neg }
        rn, rm = dsigned_add(a_neg, am, bn2, bm)
        if dec == 1 { return ddecimal_out(rn, rm, scale), "" }
        return int_text(rn, rm), ""
    }
    if string.equals(name, "times") == 1 {
        rm = dmul(a_m, b_m)
        rn = 0
        if a_neg != b_neg && string.equals(rm, "0") == 0 { rn = 1 }
        if dec == 1 { return ddecimal_out(rn, rm, a_scale + b_scale), "" }
        return int_text(rn, rm), ""
    }
    if string.equals(name, "at_least") == 1 || string.equals(name, "at_most") == 1 {
        // Signed comparison of lhs and rhs: -1, 0, 1.
        c = 0
        if a_neg != b_neg {
            c = 1
            if a_neg == 1 { c = -1 }
        } else {
            c = dcmp(am, bm)
            if a_neg == 1 { c = 0 - c }
        }
        take_rhs = 0
        if string.equals(name, "at_least") == 1 && c < 0 { take_rhs = 1 }
        if string.equals(name, "at_most") == 1 && c > 0 { take_rhs = 1 }
        // The result is the chosen operand, in its own shape.
        if take_rhs == 1 {
            if b_dec == 1 { return ddecimal_out(b_neg, b_m, b_scale), "" }
            return int_text(b_neg, b_m), ""
        }
        if a_dec == 1 { return ddecimal_out(a_neg, a_m, a_scale), "" }
        return int_text(a_neg, a_m), ""
    }
    if string.equals(bm, "0") == 1 {
        return "", string.concat(name, ": division by zero")
    }
    if string.equals(name, "divided_by") == 1 {
        if dec == 0 {
            q, r = ddivmod(am, bm)
            qn = 0
            if a_neg != b_neg {
                if string.equals(r, "0") == 0 { q = dadd(q, "1") }
                if string.equals(q, "0") == 0 { qn = 1 }
            }
            return int_text(qn, q), ""
        }
        // A decimal quotient to 25 significant digits past the divisor's
        // length, then printed through Float: exact well past double
        // precision, so the nearest Float is the one Liquid's BigDecimal
        // quotient converts to.
        extra = 25 + string_length(bm)
        q, _r = ddivmod(dshift(am, extra), bm)
        qn = 0
        if a_neg != b_neg && string.equals(q, "0") == 0 { qn = 1 }
        return ddecimal_out(qn, q, extra), ""
    }
    // modulo: the result takes the divisor's sign (floored).
    _q, r = ddivmod(am, bm)
    rn = 0
    if string.equals(r, "0") == 0 {
        if a_neg != b_neg { r = dsub(bm, r) }
        rn = b_neg
    }
    if dec == 1 { return ddecimal_out(rn, r, scale), "" }
    return int_text(rn, r), ""
}

// Apply one text filter (filter_kind) to the text `val`, its arguments
// already split and any variable among them resolved to its text. Returns
// (new_text, "") or ("", error). `size`, `reverse`, `default` and the other
// filters that act on values are value_filter's.
apply_filter_args(val: string, name: string, arg_list: ptr) -> (string, string) {
    argc = string_list_size(arg_list)

    if string.equals(name, "upcase") == 1 {
        if argc != 0 { return "", "upcase takes no args" }
        return string.to_upper(val), ""
    }
    if string.equals(name, "downcase") == 1 {
        if argc != 0 { return "", "downcase takes no args" }
        return string.to_lower(val), ""
    }
    if string.equals(name, "capitalize") == 1 {
        if argc != 0 { return "", "capitalize takes no args" }
        return filter_capitalize(val), ""
    }
    if string.equals(name, "strip") == 1 {
        if argc != 0 { return "", "strip takes no args" }
        return string.trim(val), ""
    }
    if string.equals(name, "lstrip") == 1 {
        if argc != 0 { return "", "lstrip takes no args" }
        return filter_lstrip(val), ""
    }
    if string.equals(name, "rstrip") == 1 {
        if argc != 0 { return "", "rstrip takes no args" }
        return filter_rstrip(val), ""
    }
    if string.equals(name, "append") == 1 {
        if argc != 1 { return "", "append needs exactly 1 arg" }
        s, err = unquote_arg(string_list_get(arg_list, 0))
        if err != "" { return "", err }
        return string.concat(val, s), ""
    }
    if string.equals(name, "prepend") == 1 {
        if argc != 1 { return "", "prepend needs exactly 1 arg" }
        s, err = unquote_arg(string_list_get(arg_list, 0))
        if err != "" { return "", err }
        return string.concat(s, val), ""
    }
    if string.equals(name, "truncate") == 1 {
        // Shopify Liquid signature: truncate: N [, ellipsis]
        // Both 1-arg (default "...") and 2-arg (custom ellipsis) forms.
        if argc != 1 && argc != 2 { return "", "truncate needs 1 or 2 args" }
        s, err = unquote_arg(string_list_get(arg_list, 0))
        if err != "" { return "", err }
        cap, ierr = string.to_int(s)
        if ierr != "" { return "", string.concat("truncate arg not an integer: ", s) }
        ell = "..."
        if argc == 2 {
            e2, eerr = unquote_arg(string_list_get(arg_list, 1))
            if eerr != "" { return "", eerr }
            ell = e2
        }
        return filter_truncate(val, cap, ell), ""
    }
    if string.equals(name, "replace") == 1 {
        if argc != 2 { return "", "replace needs exactly 2 args" }
        needle, e1 = unquote_arg(string_list_get(arg_list, 0))
        if e1 != "" { return "", e1 }
        repl, e2 = unquote_arg(string_list_get(arg_list, 1))
        if e2 != "" { return "", e2 }
        return filter_replace(val, needle, repl), ""
    }
    if string.equals(name, "replace_first") == 1 {
        if argc != 2 { return "", "replace_first needs exactly 2 args" }
        needle, e1 = unquote_arg(string_list_get(arg_list, 0))
        if e1 != "" { return "", e1 }
        repl, e2 = unquote_arg(string_list_get(arg_list, 1))
        if e2 != "" { return "", e2 }
        return filter_replace_first(val, needle, repl), ""
    }
    if string.equals(name, "remove") == 1 {
        if argc != 1 { return "", "remove needs exactly 1 arg" }
        needle, e1 = unquote_arg(string_list_get(arg_list, 0))
        if e1 != "" { return "", e1 }
        return filter_replace(val, needle, ""), ""
    }
    if string.equals(name, "remove_first") == 1 {
        if argc != 1 { return "", "remove_first needs exactly 1 arg" }
        needle, e1 = unquote_arg(string_list_get(arg_list, 0))
        if e1 != "" { return "", e1 }
        return filter_replace_first(val, needle, ""), ""
    }
    if string.equals(name, "escape") == 1 {
        if argc != 0 { return "", "escape takes no args" }
        return filter_escape(val), ""
    }
    if string.equals(name, "escape_once") == 1 {
        if argc != 0 { return "", "escape_once takes no args" }
        return filter_escape_once(val), ""
    }
    if string.equals(name, "url_encode") == 1 {
        if argc != 0 { return "", "url_encode takes no args" }
        return filter_url_encode(val), ""
    }
    if string.equals(name, "url_decode") == 1 {
        if argc != 0 { return "", "url_decode takes no args" }
        return filter_url_decode(val), ""
    }
    if string.equals(name, "truncatewords") == 1 {
        if argc != 1 { return "", "truncatewords needs exactly 1 arg" }
        s, err = unquote_arg(string_list_get(arg_list, 0))
        if err != "" { return "", err }
        cap, ierr = string.to_int(s)
        if ierr != "" { return "", string.concat("truncatewords arg not an integer: ", s) }
        return filter_truncatewords(val, cap), ""
    }
    if string.equals(name, "newline_to_br") == 1 {
        if argc != 0 { return "", "newline_to_br takes no args" }
        return filter_newline_to_br(val), ""
    }
    if string.equals(name, "strip_html") == 1 {
        if argc != 0 { return "", "strip_html takes no args" }
        return filter_strip_html(val), ""
    }
    if string.equals(name, "strip_newlines") == 1 {
        if argc != 0 { return "", "strip_newlines takes no args" }
        return filter_strip_newlines(val), ""
    }
    if string.equals(name, "slice") == 1 {
        if argc != 1 && argc != 2 {
            return "", "slice needs 1 or 2 args"
        }
        s, e1 = unquote_arg(string_list_get(arg_list, 0))
        if e1 != "" { return "", e1 }
        st, ierr = parse_int_arg(s, "slice")
        if ierr != "" { return "", ierr }
        ln = 1
        if argc == 2 {
            s2, e2 = unquote_arg(string_list_get(arg_list, 1))
            if e2 != "" { return "", e2 }
            ln2, jerr = parse_int_arg(s2, "slice")
            if jerr != "" { return "", jerr }
            ln = ln2
        }
        return filter_slice(val, st, ln), ""
    }
    // Integer math on string-encoded ints (returns a string of the
    // computed int). When val is empty/non-numeric, Liquid coerces to
    // 0 — we follow.
    if string.equals(name, "plus") == 1 ||
    string.equals(name, "minus") == 1 ||
    string.equals(name, "times") == 1 ||
    string.equals(name, "divided_by") == 1 ||
    string.equals(name, "modulo") == 1 ||
    string.equals(name, "at_least") == 1 ||
    string.equals(name, "at_most") == 1 {
        if argc != 1 { return "", string.concat(name, " needs exactly 1 arg") }
        s, e1 = unquote_arg(string_list_get(arg_list, 0))
        if e1 != "" { return "", e1 }
        // Both sides read as Liquid reads numbers ("12px" is 12, "abc" is
        // 0), exactly: integers unbounded, decimals as decimals (#2185).
        return filter_arith(name, val, s)
    }
    if string.equals(name, "escape_xml") == 1 {
        if argc != 0 { return "", "escape_xml takes no args" }
        return filter_escape_xml(val), ""
    }
    if string.equals(name, "json_escape") == 1 {
        if argc != 0 { return "", "json_escape takes no args" }
        return filter_json_escape(val), ""
    }
    if string.equals(name, "base64_encode") == 1 {
        if argc != 0 { return "", "base64_encode takes no args" }
        // Use the PADDED form to match Shopify's `base64_encode` filter
        // (RFC 4648 standard alphabet with `=` padding to a multiple of 4).
        return encoding.base64_encode_padded(val, string_length(val)), ""
    }
    if string.equals(name, "base64_decode") == 1 {
        if argc != 0 { return "", "base64_decode takes no args" }
        out, derr = encoding.base64_decode(val)
        if derr != "" { return "", derr }
        return out, ""
    }
    if string.equals(name, "md5") == 1 {
        if argc != 0 { return "", "md5 takes no args" }
        out, herr = cryptography.md5_hex(val, string_length(val))
        if herr != "" { return "", herr }
        return out, ""
    }
    if string.equals(name, "sha1") == 1 {
        if argc != 0 { return "", "sha1 takes no args" }
        out, herr = cryptography.sha1_hex(val, string_length(val))
        if herr != "" { return "", herr }
        return out, ""
    }
    if string.equals(name, "sha256") == 1 {
        if argc != 0 { return "", "sha256 takes no args" }
        out, herr = cryptography.sha256_hex(val, string_length(val))
        if herr != "" { return "", herr }
        return out, ""
    }
    if string.equals(name, "abs") == 1 {
        if argc != 0 { return "", "abs takes no args" }
        return filter_abs(val), ""
    }
    if string.equals(name, "ceil") == 1 {
        if argc != 0 { return "", "ceil takes no args" }
        return filter_ceil_floor(val, 1), ""
    }
    if string.equals(name, "floor") == 1 {
        if argc != 0 { return "", "floor takes no args" }
        return filter_ceil_floor(val, 0), ""
    }
    if string.equals(name, "round") == 1 {
        if argc > 1 { return "", "round takes at most 1 arg" }
        places = 0
        if argc == 1 {
            ps, pe = unquote_arg(string_list_get(arg_list, 0))
            if pe != "" { return "", pe }
            p, perr = parse_int_arg(ps, name)
            if perr != "" { return "", perr }
            if p < 0 { return "", "round: the number of places must not be negative" }
            places = p
        }
        return filter_round(val, places), ""
    }
    // Unknown filter: pass the input through unchanged (Shopify Liquid
    // behaviour — `{{ x | nope }}` renders `x`, doesn't error). This
    // keeps templates robust against typos and forward-compatibility
    // gaps in our filter coverage.
    return val, ""
}

// A filter argument written `name: value` -- a keyword argument, as
// default's `allow_false: true`: (name, value text). ("", "") for a
// positional argument.
keyword_arg(a: string) -> (string, string) {
    n = string_length(a)
    colon = find_outside_quotes(a, n, 0, 58)
    if colon <= 0 { return "", "" }
    name = trim(string.substring_n(a, n, 0, colon))
    nn = string_length(name)
    if nn == 0 || is_name_byte(string.char_at_n(name, nn, 0), 1) == 0 { return "", "" }
    i = 1
    while i < nn {
        if is_name_byte(string.char_at_n(name, nn, i), 0) == 0 { return "", "" }
        i = i + 1
    }
    return name, trim(string.substring_n(a, n, colon + 1, n))
}

// What kind of filter `name` is: FILTER_VALUE for the filters that take and
// give values of any kind (value_filter: the array filters (#2180),
// `default`, `date` (#2181), and `size`, `first`, `last`, `reverse`, which
// act on an array when handed one); FILTER_NUMBER for a text filter whose
// result is a number; FILTER_TEXT for the other text filters
// (apply_filter_args); FILTER_NONE for a name Liquid does not have, which
// passes its input through unchanged, as Shopify's Liquid does. Switched on
// the first byte, so a name costs a compare or two however many filters
// there are.
const FILTER_NONE = 0
const FILTER_VALUE = 1
const FILTER_NUMBER = 2
const FILTER_TEXT = 3

filter_kind(name: string) -> int {
    n = string_length(name)
    if n == 0 { return FILTER_NONE }
    c = string.char_at_n(name, n, 0)
    if c == 97 { // a
        if string.equals(name, "append") == 1 { return FILTER_TEXT }
        if string.equals(name, "abs") == 1 || string.equals(name, "at_least") == 1 ||
        string.equals(name, "at_most") == 1 { return FILTER_NUMBER }
    } else if c == 98 { // b
        if string.equals(name, "base64_encode") == 1 || string.equals(name, "base64_decode") == 1 {
            return FILTER_TEXT
        }
    } else if c == 99 { // c
        if string.equals(name, "capitalize") == 1 { return FILTER_TEXT }
        if string.equals(name, "ceil") == 1 { return FILTER_NUMBER }
        if string.equals(name, "compact") == 1 || string.equals(name, "concat") == 1 { return FILTER_VALUE }
    } else if c == 100 { // d
        if string.equals(name, "downcase") == 1 { return FILTER_TEXT }
        if string.equals(name, "divided_by") == 1 { return FILTER_NUMBER }
        if string.equals(name, "default") == 1 || string.equals(name, "date") == 1 { return FILTER_VALUE }
    } else if c == 101 { // e
        if string.equals(name, "escape") == 1 || string.equals(name, "escape_once") == 1 ||
        string.equals(name, "escape_xml") == 1 { return FILTER_TEXT }
    } else if c == 102 { // f
        if string.equals(name, "first") == 1 { return FILTER_VALUE }
        if string.equals(name, "floor") == 1 { return FILTER_NUMBER }
    } else if c == 106 { // j
        if string.equals(name, "join") == 1 { return FILTER_VALUE }
        if string.equals(name, "json_escape") == 1 { return FILTER_TEXT }
    } else if c == 108 { // l
        if string.equals(name, "lstrip") == 1 { return FILTER_TEXT }
        if string.equals(name, "last") == 1 { return FILTER_VALUE }
    } else if c == 109 { // m
        if string.equals(name, "minus") == 1 || string.equals(name, "modulo") == 1 { return FILTER_NUMBER }
        if string.equals(name, "map") == 1 { return FILTER_VALUE }
        if string.equals(name, "md5") == 1 { return FILTER_TEXT }
    } else if c == 110 { // n
        if string.equals(name, "newline_to_br") == 1 { return FILTER_TEXT }
    } else if c == 112 { // p
        if string.equals(name, "prepend") == 1 { return FILTER_TEXT }
        if string.equals(name, "plus") == 1 { return FILTER_NUMBER }
    } else if c == 114 { // r
        if string.equals(name, "reverse") == 1 { return FILTER_VALUE }
        if string.equals(name, "round") == 1 { return FILTER_NUMBER }
        if string.equals(name, "rstrip") == 1 || string.equals(name, "replace") == 1 ||
        string.equals(name, "replace_first") == 1 || string.equals(name, "remove") == 1 ||
        string.equals(name, "remove_first") == 1 { return FILTER_TEXT }
    } else if c == 115 { // s
        if string.equals(name, "size") == 1 || string.equals(name, "split") == 1 ||
        string.equals(name, "sort") == 1 || string.equals(name, "sort_natural") == 1 {
            return FILTER_VALUE
        }
        if string.equals(name, "strip") == 1 || string.equals(name, "slice") == 1 ||
        string.equals(name, "strip_html") == 1 || string.equals(name, "strip_newlines") == 1 ||
        string.equals(name, "sha1") == 1 || string.equals(name, "sha256") == 1 { return FILTER_TEXT }
    } else if c == 116 { // t
        if string.equals(name, "times") == 1 { return FILTER_NUMBER }
        if string.equals(name, "truncate") == 1 || string.equals(name, "truncatewords") == 1 {
            return FILTER_TEXT
        }
    } else if c == 117 { // u
        if string.equals(name, "uniq") == 1 { return FILTER_VALUE }
        if string.equals(name, "upcase") == 1 || string.equals(name, "url_encode") == 1 ||
        string.equals(name, "url_decode") == 1 { return FILTER_TEXT }
    } else if c == 119 { // w
        if string.equals(name, "where") == 1 { return FILTER_VALUE }
    }
    return FILTER_NONE
}

// Apply one filter stage in the render context. A text filter gets its
// input's text and each argument that is a variable path or a keyword
// literal resolved to its text (#2182); a value filter gets the values
// themselves. An unknown filter passes the value through unchanged.
apply_filter_in(ctx: ptr, val: string, name: string, args: string) -> (string, string) {
    kind = filter_kind(name)
    if kind == FILTER_NONE { return val, "" }
    raw = split_commas(args)
    if kind == FILTER_VALUE {
        out, verr = apply_value_filter(ctx, val, name, raw)
        string_list_free(raw)
        return out, verr
    }
    // Each argument that names a value is replaced, in the list, by that
    // value's text, quoted: unquote_arg strips just the outer pair, so a
    // quote inside the value is kept.
    n = string_list_size(raw)
    i = 0
    while i < n {
        a = string_list_get(raw, i)
        if is_path_text(a) == 1 || string.equals(a, "true") == 1 || string.equals(a, "false") == 1 ||
        string.equals(a, "nil") == 1 || string.equals(a, "null") == 1 ||
        string.equals(a, "empty") == 1 || string.equals(a, "blank") == 1 {
            v, rerr = eval_value(ctx, a)
            if rerr != "" {
                string_list_free(raw)
                return value_nil(), rerr
            }
            string_list_set(raw, i, string.concat(string.concat("\"", value_text(ctx, v)), "\""))
        }
        i = i + 1
    }
    input = value_text(ctx, val)
    text, err = apply_filter_args(input, name, raw)
    string_list_free(raw)
    if err != "" { return value_nil(), err }
    if kind == FILTER_NUMBER { return value_number(text), "" }
    return value_str(text), ""
}

// ---- Array filters (#2180) -------------------------------------------------
//
// As Liquid's InputIterator reads a filter's input: an array is its
// elements with any nested array flattened into them, nil is no elements,
// and any other value -- an object included -- is the one element.

// Append `v`'s elements to `out` (a string_list of values).
iter_into(ctx: ptr, out: ptr, v: string, depth: int) {
    k = value_kind(v)
    if k == LV_ARR {
        nd = node_of(ctx, v)
        if nd == null { return }
        n = arr_len(nd)
        i = 0
        while i < n {
            e = arr_at(nd, i)
            if value_kind(e) == LV_ARR && depth < MAX_VALUE_DEPTH {
                iter_into(ctx, out, e, depth + 1)
            } else {
                string_list_add(out, e)
            }
            i = i + 1
        }
        return
    }
    if k == LV_NIL && depth == 0 { return }
    string_list_add(out, v)
}

// `v`'s elements, as iter_into reads them, in a new string_list.
iter_items(ctx: ptr, v: string) -> ptr {
    out = string_list_new()
    iter_into(ctx, out, v, 0)
    return out
}

// A new array holding the values in `items` (a string_list).
array_of(ctx: ptr, items: ptr) -> string {
    av, an = node_new(ctx, LV_ARR)
    n = string_list_size(items)
    i = 0
    while i < n {
        arr_push(an, string_list_get(items, i))
        i = i + 1
    }
    return av
}

// `item[property]`: an object's value for the key, nil for anything else.
item_property(ctx: ptr, item: string, property: string) -> string {
    if value_kind(item) != LV_OBJ { return value_nil() }
    nd = node_of(ctx, item)
    if nd == null { return value_nil() }
    v, _found = obj_get(nd, property)
    return v
}

// Is `c` whitespace as Ruby's `split(" ")` reads it?
is_split_space(c: int) -> int {
    if c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13 { return 1 }
    return 0
}

// `split: pattern`, as Ruby's String#split: a single space splits on runs of
// whitespace and ignores it at either end; the empty pattern splits into
// characters; any other pattern splits on each occurrence, and the empty
// strings at the end are dropped ("a,b,,".split(",") is ["a", "b"]).
filter_split(ctx: ptr, s: string, pattern: string) -> string {
    av, an = node_new(ctx, LV_ARR)
    n = string_length(s)
    if n == 0 { return av }
    pn = string_length(pattern)
    if string.equals(pattern, " ") == 1 {
        i = 0
        while i < n {
            while i < n && is_split_space(string.char_at_n(s, n, i)) == 1 { i = i + 1 }
            if i >= n { break }
            j = i
            while j < n && is_split_space(string.char_at_n(s, n, j)) == 0 { j = j + 1 }
            arr_push(an, value_str(string.substring_n(s, n, i, j)))
            i = j
        }
        return av
    }
    if pn == 0 {
        i = 0
        while i < n {
            k = utf8_len(string.char_at_n(s, n, i))
            if i + k > n { k = n - i }
            arr_push(an, value_str(string.substring_n(s, n, i, i + k)))
            i = i + k
        }
        return av
    }
    parts = string_list_new()
    p = 0
    while p <= n {
        cut = string.index_of_from_n(s, n, pattern, p)
        if cut < 0 {
            string_list_add(parts, string.substring_n(s, n, p, n))
            break
        }
        string_list_add(parts, string.substring_n(s, n, p, cut))
        p = cut + pn
    }
    keep = string_list_size(parts)
    while keep > 0 && string_length(string_list_get(parts, keep - 1)) == 0 { keep = keep - 1 }
    i = 0
    while i < keep {
        arr_push(an, value_str(string_list_get(parts, i)))
        i = i + 1
    }
    string_list_free(parts)
    return av
}

// The value `sort` orders an element by: the element, or its `property`.
sort_key(ctx: ptr, item: string, property: string, has_property: int) -> string {
    if has_property == 1 { return item_property(ctx, item, property) }
    return item
}

// How `sort` orders two elements (`natural` 1 for sort_natural): nil after
// everything else; sort_natural by text, ignoring case; sort numbers as
// numbers and strings byte by byte.
sort_cmp(ctx: ptr, a: string, b: string, property: string, has_property: int, natural: int) -> int {
    ka = sort_key(ctx, a, property, has_property)
    kb = sort_key(ctx, b, property, has_property)
    na = value_kind(ka) == LV_NIL
    nb = value_kind(kb) == LV_NIL
    if na && nb { return 0 }
    if na { return 1 }
    if nb { return -1 }
    if natural == 1 {
        return string.compare(string.to_lower(value_text(ctx, ka)), string.to_lower(value_text(ctx, kb)))
    }
    if is_number_value(ka) == 1 && is_number_value(kb) == 1 {
        return number_cmp(value_payload(ka), value_payload(kb))
    }
    return string.compare(value_text(ctx, ka), value_text(ctx, kb))
}

// `sort` / `sort_natural`, with an optional property to sort objects by.
// Numbers with strings, and booleans, arrays or objects, do not order
// against each other, and `sort` says so as Liquid does; nil goes last.
filter_sort(ctx: ptr, val: string, property: string, has_property: int, natural: int) -> (string, string) {
    items = iter_items(ctx, val)
    n = string_list_size(items)
    if natural == 0 {
        numbers = 0
        strings = 0
        others = 0
        i = 0
        while i < n {
            k = value_kind(sort_key(ctx, string_list_get(items, i), property, has_property))
            if k == LV_INT || k == LV_FLOAT { numbers = numbers + 1 }
            else if k == LV_STR { strings = strings + 1 }
            else if k != LV_NIL { others = others + 1 }
            i = i + 1
        }
        if (numbers > 0 && strings > 0) || (others > 0 && numbers + strings + others > 1) {
            string_list_free(items)
            return value_nil(), "sort: cannot sort values of incompatible types"
        }
    }
    string_list_sort(items, | a: string, b: string | {
            return sort_cmp(ctx, a, b, property, has_property, natural)
        })
    out = array_of(ctx, items)
    string_list_free(items)
    return out, ""
}

// The filters that take and give values of any kind (filter_kind's
// FILTER_VALUE).
apply_value_filter(ctx: ptr, val: string, name: string, raw: ptr) -> (string, string) {
    // The positional arguments' values, and default's allow_false.
    args = string_list_new()
    allow_false = 0
    rn = string_list_size(raw)
    i = 0
    while i < rn {
        a = string_list_get(raw, i)
        kw, kv_text = keyword_arg(a)
        if string_length(kw) > 0 {
            kv, kerr = eval_value(ctx, kv_text)
            if kerr != "" { string_list_free(args); return value_nil(), kerr }
            if string.equals(kw, "allow_false") == 1 && string.equals(value_to_string(kv), "true") == 1 {
                allow_false = 1
            }
        } else {
            v, verr = eval_value(ctx, a)
            if verr != "" { string_list_free(args); return value_nil(), verr }
            string_list_add(args, v)
        }
        i = i + 1
    }
    out, err = value_filter(ctx, val, name, args, allow_false)
    string_list_free(args)
    return out, err
}

value_filter(ctx: ptr, val: string, name: string, args: ptr, allow_false: int) -> (string, string) {
    argc = string_list_size(args)
    k = value_kind(val)
    if string.equals(name, "split") == 1 {
        if argc != 1 { return value_nil(), "split needs exactly 1 arg" }
        return filter_split(ctx, value_text(ctx, val), value_text(ctx, string_list_get(args, 0))), ""
    }
    if string.equals(name, "join") == 1 {
        if argc > 1 { return value_nil(), "join takes at most 1 arg" }
        glue = " "
        if argc == 1 { glue = value_text(ctx, string_list_get(args, 0)) }
        items = iter_items(ctx, val)
        n = string_list_size(items)
        sb = strbuilder.new(32)
        j = 0
        while j < n {
            if j > 0 { strbuilder.append(sb, glue) }
            strbuilder.append(sb, value_text(ctx, string_list_get(items, j)))
            j = j + 1
        }
        string_list_free(items)
        return value_str(strbuilder.finish(sb)), ""
    }
    if string.equals(name, "first") == 1 || string.equals(name, "last") == 1 {
        if argc != 0 { return value_nil(), string.concat(name, " takes no args") }
        want_first = string.equals(name, "first")
        if k == LV_ARR {
            nd = node_of(ctx, val)
            if nd == null || arr_len(nd) == 0 { return value_nil(), "" }
            if want_first == 1 { return arr_at(nd, 0), "" }
            return arr_at(nd, arr_len(nd) - 1), ""
        }
        if k == LV_STR {
            if want_first == 1 { return value_str(first_char(value_payload(val))), "" }
            return value_str(last_char(value_payload(val))), ""
        }
        if k == LV_OBJ && want_first == 1 {
            nd = node_of(ctx, val)
            if nd != null && obj_len(nd) > 0 { return obj_pair(ctx, nd, 0), "" }
        }
        return value_nil(), ""
    }
    if string.equals(name, "size") == 1 {
        if argc != 0 { return value_nil(), "size takes no args" }
        if k == LV_ARR || k == LV_OBJ {
            nd = node_of(ctx, val)
            if nd == null { return value_int(0), "" }
            return value_int(string_list_size((nd as *LiquidNode).items)), ""
        }
        return value_int(string_length(value_to_string(val))), ""
    }
    if string.equals(name, "reverse") == 1 {
        if argc != 0 { return value_nil(), "reverse takes no args" }
        if k != LV_ARR { return value_str(filter_reverse(value_text(ctx, val))), "" }
        items = iter_items(ctx, val)
        rv, rn = node_new(ctx, LV_ARR)
        j = string_list_size(items) - 1
        while j >= 0 {
            arr_push(rn, string_list_get(items, j))
            j = j - 1
        }
        string_list_free(items)
        return rv, ""
    }
    if string.equals(name, "sort") == 1 || string.equals(name, "sort_natural") == 1 {
        if argc > 1 { return value_nil(), string.concat(name, " takes at most 1 arg") }
        property = ""
        if argc == 1 { property = value_text(ctx, string_list_get(args, 0)) }
        return filter_sort(ctx, val, property, argc, string.equals(name, "sort_natural"))
    }
    if string.equals(name, "map") == 1 {
        if argc != 1 { return value_nil(), "map needs exactly 1 arg" }
        property = value_text(ctx, string_list_get(args, 0))
        items = iter_items(ctx, val)
        mv, mn = node_new(ctx, LV_ARR)
        n = string_list_size(items)
        j = 0
        while j < n {
            arr_push(mn, item_property(ctx, string_list_get(items, j), property))
            j = j + 1
        }
        string_list_free(items)
        return mv, ""
    }
    if string.equals(name, "where") == 1 {
        if argc != 1 && argc != 2 { return value_nil(), "where needs 1 or 2 args" }
        property = value_text(ctx, string_list_get(args, 0))
        items = iter_items(ctx, val)
        wv, wn = node_new(ctx, LV_ARR)
        n = string_list_size(items)
        j = 0
        while j < n {
            item = string_list_get(items, j)
            pv = item_property(ctx, item, property)
            keep = 0
            if argc == 1 { keep = value_truthy(pv) } else { keep = values_equal(ctx, pv, string_list_get(args, 1)) }
            if keep == 1 { arr_push(wn, item) }
            j = j + 1
        }
        string_list_free(items)
        return wv, ""
    }
    if string.equals(name, "uniq") == 1 || string.equals(name, "compact") == 1 {
        if argc > 1 { return value_nil(), string.concat(name, " takes at most 1 arg") }
        property = ""
        if argc == 1 { property = value_text(ctx, string_list_get(args, 0)) }
        items = iter_items(ctx, val)
        ov, on = node_new(ctx, LV_ARR)
        seen = map_new()
        n = string_list_size(items)
        j = 0
        while j < n {
            item = string_list_get(items, j)
            key = sort_key(ctx, item, property, argc)
            if string.equals(name, "compact") == 1 {
                if value_kind(key) != LV_NIL { arr_push(on, item) }
            } else {
                id = value_identity(ctx, key)
                if map_has(seen, id) == 0 {
                    map_put(seen, id, "1")
                    arr_push(on, item)
                }
            }
            j = j + 1
        }
        map_free(seen)
        string_list_free(items)
        return ov, ""
    }
    if string.equals(name, "concat") == 1 {
        if argc != 1 { return value_nil(), "concat needs exactly 1 arg" }
        other = string_list_get(args, 0)
        on = node_of(ctx, other)
        if value_kind(other) != LV_ARR || on == null {
            return value_nil(), "concat filter requires an array argument"
        }
        items = iter_items(ctx, val)
        cv, cn = node_new(ctx, LV_ARR)
        n = string_list_size(items)
        j = 0
        while j < n {
            arr_push(cn, string_list_get(items, j))
            j = j + 1
        }
        string_list_free(items)
        m = arr_len(on)
        j = 0
        while j < m {
            arr_push(cn, arr_at(on, j))
            j = j + 1
        }
        return cv, ""
    }
    if string.equals(name, "default") == 1 {
        if argc != 1 && argc != 2 { return value_nil(), "default needs 1 or 2 args" }
        // The second argument, positional, is allow_false written bare.
        af = allow_false
        if argc == 2 && string.equals(value_to_string(string_list_get(args, 1)), "true") == 1 { af = 1 }
        fire = 0
        if k == LV_NIL { fire = 1 }
        else if k == LV_BOOL {
            // false fires it, as in Liquid, unless allow_false keeps it.
            if value_truthy(val) == 0 && af == 0 { fire = 1 }
        }
        else if k == LV_ARR || k == LV_OBJ { fire = value_is_empty(ctx, val) }
        else if k == LV_STR {
            // A string fires the default when it is empty and, with
            // allow_false, when it is one of the string-context spellings of
            // a missing value: "false", "nil", "null".
            s = value_payload(val)
            if string_length(s) == 0 { fire = 1 }
            if af == 1 && (string.equals(s, "false") == 1 || string.equals(s, "nil") == 1 ||
                string.equals(s, "null") == 1) { fire = 1 }
        }
        // The fallback is copied out: `args` is freed once this returns.
        if fire == 1 { return string.copy(string_list_get(args, 0)), "" }
        return val, ""
    }
    if string.equals(name, "date") == 1 {
        if argc != 1 { return value_nil(), "date needs exactly 1 arg" }
        return filter_date(ctx, val, value_text(ctx, string_list_get(args, 0)))
    }
    return val, ""
}

// ---- The date filter (#2181) -----------------------------------------------
//
// `date: format` reads its input as a time -- an ISO-8601 date or date-time
// (`2024-01-02`, `2024-01-02T10:20:30Z`, `2024-01-02 10:20:30 +0530`), a
// Unix timestamp (an integer, or a string of digits), or `now` / `today`,
// the time the host gave with context_set_now -- and writes it through the
// strftime pattern `format` (std.time.calendar's strftime). A time written
// with an offset prints at that offset; any other prints at UTC. Input it
// cannot read as a time, and an empty format, give the input back
// unchanged, as Liquid does.

// Is `s` a non-empty run of ASCII digits?
all_digits(s: string) -> int {
    n = string_length(s)
    if n == 0 { return 0 }
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c < 48 || c > 57 { return 0 }
        i = i + 1
    }
    return 1
}

filter_date(ctx: ptr, val: string, format: string) -> (string, string) {
    if string_length(format) == 0 { return val, "" }
    k = value_kind(val)
    epoch = 0 as long
    offset = 0
    if k == LV_INT {
        e, eerr = string.to_long(value_payload(val))
        if eerr != "" { return val, "" }
        epoch = e
    } else if k == LV_STR {
        s = trim(value_payload(val))
        low = string.to_lower(s)
        if string.equals(low, "now") == 1 || string.equals(low, "today") == 1 {
            if map_has(ctx, KEY_NOW) == 0 {
                return value_nil(), "date: \"now\" needs the time: call context_set_now first"
            }
            e, _nerr = string.to_long(map_get_raw(ctx, KEY_NOW))
            epoch = e
        } else if all_digits(s) == 1 {
            e, eerr = string.to_long(s)
            if eerr != "" { return val, "" }
            epoch = e
        } else {
            dt, off, perr = calendar.parse_iso8601_offset(s)
            if perr != "" { return val, "" }
            epoch = calendar.to_unix(dt)
            offset = off
        }
    } else {
        return val, ""
    }
    return value_str(calendar.strftime_at(calendar.from_unix(epoch), offset, format)), ""
}

// Evaluate an OUTPUT body -- the trimmed contents of `{{ ... }}`, or an
// assign's right-hand side: a value (eval_value), then each `| filter`
// stage in turn. Returns (value, "") or (nil, error).
render_output(ctx: ptr, body: string) -> (string, string) {
    stages = split_pipes(body)
    sn = string_list_size(stages)
    if sn == 0 {
        string_list_free(stages)
        return value_nil(), ""
    }
    val, verr = eval_value(ctx, string_list_get(stages, 0))
    if verr != "" {
        string_list_free(stages)
        return value_nil(), verr
    }
    i = 1
    while i < sn {
        name, args = split_name_args(string_list_get(stages, i))
        v2, err = apply_filter_in(ctx, val, name, args)
        if err != "" {
            string_list_free(stages)
            return value_nil(), err
        }
        val = v2
        i = i + 1
    }
    string_list_free(stages)
    return val, ""
}

// ---------------------------------------------------------------------------
// Tag execution — currently only `assign`
// ---------------------------------------------------------------------------

// Match the first whitespace-separated word at the start of `body`.
// Returns ("", "") if `body` is empty.
tag_head(body: string) -> (string, string) {
    n = string_length(body)
    i = 0
    while i < n {
        c = string.char_at_n(body, n, i)
        if c == 32 || c == 9 || c == 10 || c == 13 { break }
        i = i + 1
    }
    head = string.substring_n(body, n, 0, i)
    // Skip whitespace between head and rest.
    while i < n {
        c = string.char_at_n(body, n, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    rest = string.substring_n(body, n, i, n)
    return head, rest
}

// `{% assign NAME = EXPR %}` — bind NAME in ctx to EXPR's value: a
// literal or a variable path, then any filter stages (render_output). An
// array stays an array (`{% assign parts = s | split: "," %}`).
exec_assign(ctx: ptr, rest: string) -> string {
    n = string_length(rest)
    eq = find_outside_quotes(rest, n, 0, 61) // '='
    if eq < 0 { return "assign: missing `=`" }
    name = trim(string.substring_n(rest, n, 0, eq))
    expr = trim(string.substring_n(rest, n, eq + 1, n))
    if string_length(name) == 0 {
        return "assign: missing name before `=`"
    }
    v, err = render_output(ctx, expr)
    if err != "" { return err }
    bind_value(ctx, name, v)
    return ""
}

// Dispatch a TAG body. Returns "" on success, or an error message.
exec_tag(ctx: ptr, body: string) -> string {
    head, rest = tag_head(body)
    if string.equals(head, "assign") == 1 {
        return exec_assign(ctx, rest)
    }
    return string.concat("unsupported tag: ", body)
}

// ---------------------------------------------------------------------------
// Public surface
// ---------------------------------------------------------------------------
//
// A parsed template is the token list itself, walked directly at render
// time; there is no AST between the lexer and the renderer.
//
// A context is a `std.map` from names to bare strings (context_put_string),
// with a map of packed typed values (see "Typed value model" below) and a
// store for its arrays and objects.

// Parse a Liquid source string. Returns (template_handle, "") on success
// or (null, error) on a syntax problem.
parse_string(src: string) -> (ptr, string) {
    toks, err = lex(src)
    if err != "" {
        return 0, err
    }
    return toks, ""
}

// Convenience: read the source from `path` and parse it. The error
// string distinguishes read failures from parse failures so callers
// can decide whether to surface a file-not-found vs a Liquid syntax
// error differently. Returns (template, "") on success or (0, error).
// Independent of `context_set_include_root` — this is purely a
// `fs.read + parse_string` shortcut for the outermost template.
parse_file(path: string) -> (ptr, string) {
    src, rerr = fs.read(path)
    if rerr != "" {
        msg = string.concat("parse_file: cannot read ", path)
        msg = string.concat(msg, ": ")
        msg = string.concat(msg, rerr)
        return 0, msg
    }
    t, perr = parse_string(src)
    if perr != "" {
        msg = string.concat("parse_file: parse error in ", path)
        msg = string.concat(msg, ": ")
        msg = string.concat(msg, perr)
        return 0, msg
    }
    return t, ""
}

// Release a template `parse_string` or `parse_file` returned. A template
// handed to a partial cache belongs to the cache.
template_free(t: ptr) {
    if t == null { return }
    string_list_free(list_get_raw(t, 0))
    string_list_free(list_get_raw(t, 1))
    list_free(t)
}

// ---- Partial cache (#2184) ------------------------------------------------
//
// Every `{% include %}`, `{% render %}` and layout parent used to be read
// from disk and parsed again at every use -- 100 includes of one header,
// 100 reads and parses -- and the parsed copy was never freed. A cache
// attached to the context keeps each partial parsed once, keyed by its
// resolved path; the path is still resolved and checked against the
// include root at every use, cached or not.

struct PartialCache {
    by_path: ptr // resolved path -> parsed template
    owned: ptr // every template the cache holds, for freeing
}

// Partials read and parsed since the program started, cached or not: what
// a cache saves is the difference.
var g_partial_loads: int = 0

// Reads + parses of a partial or layout so far (see above).
partial_loads() -> int {
    return g_partial_loads
}

// A new, empty cache. Attach it with context_set_partial_cache; free it
// with partial_cache_free once no context uses it.
partial_cache_new() -> ptr {
    c = heap.new(PartialCache)
    c.by_path = map_new()
    c.owned = list_new()
    return c as ptr
}

// Free the cache and every template in it.
partial_cache_free(cache: ptr) {
    if cache == null { return }
    c = cache as *PartialCache
    n = list_size(c.owned)
    i = 0
    while i < n {
        template_free(list_get_raw(c.owned, i))
        i = i + 1
    }
    list_free(c.owned)
    map_free(c.by_path)
    heap.free(c)
}

// The context key the cache lives under. It starts with a control
// character, which no Liquid name can contain, so a template can never
// read it (lookup refuses such names).
partial_cache_key() -> string {
    return string.concat(string.from_char(1), "partial_cache")
}

// Render with `cache`: every include, render and layout parent the context
// reaches is parsed once and reused, including through `{% render %}`'s
// fresh contexts.
context_set_partial_cache(ctx: ptr, cache: ptr) {
    map_put(ctx, partial_cache_key(), cache)
}

// The parsed partial or layout at `resolved` (already checked against the
// include root). Returns (template, read_error, parse_error, owned): owned
// is 1 when the caller must template_free it after use (no cache), 0 when
// the context's cache keeps it.
load_partial(ctx: ptr, resolved: string) -> (ptr, string, string, int) {
    key = partial_cache_key()
    cache = null
    if map_has(ctx, key) == 1 { cache = map_get_raw(ctx, key) }
    if cache != null {
        c = cache as *PartialCache
        if map_has(c.by_path, resolved) == 1 {
            return map_get_raw(c.by_path, resolved), "", "", 0
        }
    }
    src, ferr = fs.read(resolved)
    if ferr != "" { return null, ferr, "", 0 }
    g_partial_loads = g_partial_loads + 1
    t, terr = parse_string(src)
    if terr != "" { return null, "", terr, 0 }
    if cache != null {
        c2 = cache as *PartialCache
        map_put(c2.by_path, resolved, t)
        list_add_raw(c2.owned, t)
        return t, "", "", 0
    }
    return t, "", "", 1
}

// A new, empty context. Bind values into it with the context_put_*
// functions; free it, and every value in it, with context_free.
context_new() -> ptr {
    ctx = map_new()
    map_put(ctx, KEY_TYPED, map_new())
    map_put(ctx, KEY_VALUES, store_new())
    return ctx
}

// Configure where `{% include %}` / `{% render %}` look for partials.
// `root` MUST be set before `render(t, ctx)` if the template uses
// either of those tags — without it the tag errors at render time
// (deliberate: avoids accidentally reading from `.` or `$PWD`). Path
// traversal escapes (e.g. `'../../passwd'`) are rejected via
// `fs.is_within_base`.
context_set_include_root(ctx: ptr, root: string) {
    map_put(ctx, KEY_INCLUDE_ROOT, root)
}

// Bind `key` to the string `value`. A typed binding of the same name
// (context_put_int, context_put_json, ...) wins over it. The string is
// kept packed (value_str), so reading it is a lookup and no copy.
context_put_string(ctx: ptr, key: string, value: string) {
    map_put(ctx, key, value_str(value))
}

// The time the `date` filter reads `"now"` and `"today"` as, in seconds
// since the epoch. A render reads no clock of its own, so the same template,
// context and time render the same text; a template that asks for the time
// before the host has given one gets a render error that says so.
context_set_now(ctx: ptr, unix_seconds: long) {
    map_put(ctx, KEY_NOW, string.from_long(unix_seconds))
}

// Free the context: its bindings, and every array and object it holds.
context_free(ctx: ptr) {
    if map_has(ctx, KEY_VALUES) == 1 { store_free(map_get_raw(ctx, KEY_VALUES)) }
    bindings_free(ctx)
}

// Free a context's own maps -- its bare and its typed bindings -- but not a
// value store it may share (a `{% render %}` context's is its caller's).
bindings_free(ctx: ptr) {
    if map_has(ctx, KEY_TYPED) == 1 { map_free(map_get_raw(ctx, KEY_TYPED)) }
    map_free(ctx)
}

// The map of `ctx`'s typed bindings (name -> packed value), made on first use.
typed_of(ctx: ptr) -> ptr {
    have = map_get_raw(ctx, KEY_TYPED)
    if have != null { return have }
    typed = map_new()
    map_put(ctx, KEY_TYPED, typed)
    return typed
}

// Bind `name` to the packed value `v`, over whatever it was bound to.
bind_value(ctx: ptr, name: string, v: string) {
    map_put_string_owned(typed_of(ctx), name, v)
}

// Drop the typed binding of `name`, so a bare string binding it shadowed
// shows again.
unbind_value(ctx: ptr, name: string) {
    map_remove(typed_of(ctx), name)
}

// The value `name` is bound to: its typed binding, else its bare string
// binding as a string, else nil -- which renders as nothing, Liquid's
// behaviour for `{{ undefined }}`. A name that starts with a control
// character is one of the context's internal keys, never a Liquid name.
lookup_value(ctx: ptr, name: string) -> string {
    nn = string_length(name)
    if nn == 0 || string.char_at_n(name, nn, 0) < 32 { return value_nil() }
    // A stored value is never null, so a null from map_get_raw is "not
    // bound" -- one hash lookup a step rather than map_has and then a get.
    typed = map_get_raw(ctx, KEY_TYPED)
    if typed != null {
        v = map_get_raw(typed, name)
        if v != null { return v }
    }
    bare = map_get_raw(ctx, name)
    if bare != null { return bare }
    return value_nil()
}

// `{% increment %}` and `{% decrement %}` share a namespace SEPARATE
// from `{% assign %}` (Shopify semantics). We prefix the counter key
// internally so it cannot collide with a user `assign`. `direction` is
// +1 for increment, -1 for decrement. Returns (emitted_text, error).
//
// Shopify behaviour:
//   - First `increment x` emits "0" and binds x = 1
//   - First `decrement x` emits "-1" and binds x = -1
//   - Subsequent ops increment / decrement from the stored count
bump_counter(ctx: ptr, name: string, direction: int) -> (string, string) {
    key = string.concat("\x01inc:", name)
    if map_has(ctx, key) == 0 {
        if direction > 0 {
            map_put(ctx, key, "1")
            return "0", ""
        }
        map_put(ctx, key, "-1")
        return "-1", ""
    }
    cur_s = map_get_raw(ctx, key)
    cur, err = string.to_int(cur_s)
    if err != "" {
        return "", string.concat("counter not an integer: ", cur_s)
    }
    if direction > 0 {
        // emit cur, then store cur + 1
        emit = string.from_int(cur)
        map_put(ctx, key, string.from_int(cur + 1))
        return emit, ""
    }
    // decrement: store cur - 1, then emit
    next = cur - 1
    map_put(ctx, key, string.from_int(next))
    return string.from_int(next), ""
}

// `{% cycle 'a','b','c' %}` — round-robin through the args, keyed by
// the args string. Optional named group: `{% cycle 'mygroup': 'a','b' %}`
// (different groups maintain independent positions even with the same
// arg list). For this slice we accept the args-only form; the
// `group: args` form falls out by keying on the FULL `body` after the
// `cycle` head, which is what we receive in `rest`.
//
// State key: an internal `\x01cyc:` prefix + the cycle's identifier (the
// `rest` body). That keeps two `{% cycle 'a','b' %}` invocations in
// lock-step (Shopify behaviour for identical arg lists) and lets
// `{% cycle 'g1': ... %}` vs `{% cycle 'g2': ... %}` advance independently.
cycle_emit(ctx: ptr, rest: string, full_body: string) -> (string, string) {
    args_body = trim(rest)
    if string_length(args_body) == 0 {
        return "", "cycle: missing args"
    }
    // Optional `name: a,b,c` form — split on the first top-level `:`.
    items_str = args_body
    abn = string_length(args_body)
    colon = find_outside_quotes(args_body, abn, 0, 58) // ':'
    if colon >= 0 {
        items_str = trim(string.substring_n(args_body, abn, colon + 1, abn))
    }
    items = split_commas(items_str)
    ic = string_list_size(items)
    if ic == 0 {
        return "", "cycle: empty arg list"
    }
    key = string.concat("\x01cyc:", full_body)
    pos = 0
    if map_has(ctx, key) == 1 {
        cur, err = string.to_int(map_get_raw(ctx, key))
        if err == "" { pos = cur }
    }
    if pos >= ic { pos = pos % ic }
    raw = string_list_get(items, pos)
    val, uerr = unquote_arg(raw)
    if uerr != "" { return "", uerr }
    next = pos + 1
    if next >= ic { next = 0 }
    map_put(ctx, key, string.from_int(next))
    return val, ""
}

// ---------------------------------------------------------------------------
// Expressions: literals and variable paths (#2178)
// ---------------------------------------------------------------------------
//
// A value in a template is a literal -- a quoted string, a number, `true`,
// `false`, `nil` / `null`, `empty`, `blank` -- or a variable path: a name,
// then any number of `.name` and `[expr]` segments (`user.name`, `items[0]`,
// `items[-1]`, `user["first name"]`, `items[i]`, `a.b[c.d].e`). On an
// object a segment is a key. On an array it is an integer index, negative
// from the end. `size`, `first` and `last` work on arrays, on strings (the
// first and last character), and on an object that has no such key (`size`
// is its key count, `first` its first [key, value] pair). Anything missing
// along the way is nil, which renders as nothing.

// Can byte `c` be part of a name? Liquid names hold letters, digits, `_`,
// `-` and a trailing `?`; a byte of a UTF-8 sequence counts as a letter.
// `first` is 1 for the name's first byte, which must not be a digit, `-` or
// `?`.
is_name_byte(c: int, first: int) -> int {
    b = c & 255
    if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95 || b >= 128 { return 1 }
    if first == 1 { return 0 }
    if (b >= 48 && b <= 57) || b == 45 || b == 63 { return 1 }
    return 0
}

// The offset just past the `]` that closes the `[` at `p`, nested brackets
// and quoted strings inside it skipped; -1 when it is not closed.
bracket_end(s: string, n: int, p: int) -> int {
    depth = 0
    quote = 0
    i = p
    while i < n {
        c = string.char_at_n(s, n, i)
        if quote != 0 {
            if c == quote { quote = 0 }
        } else if c == 34 || c == 39 {
            quote = c
        } else if c == 91 {
            depth = depth + 1
        } else if c == 93 {
            depth = depth - 1
            if depth == 0 { return i + 1 }
        }
        i = i + 1
    }
    return -1
}

// The end of the variable path that starts at `p` in `s` (length `n`): past
// its name, or a bracketed head (`["key"]`), and every `.name` and `[...]`
// after it. Returns `p` when no path starts there.
path_end(s: string, n: int, p: int) -> int {
    i = p
    if i >= n { return p }
    if string.char_at_n(s, n, i) == 91 {
        i = bracket_end(s, n, i)
        if i < 0 { return p }
    } else {
        if is_name_byte(string.char_at_n(s, n, i), 1) == 0 { return p }
        while i < n && is_name_byte(string.char_at_n(s, n, i), 0) == 1 { i = i + 1 }
    }
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 46 {
            // `.name`, where a name may also be all digits (`pair.0`).
            j = i + 1
            while j < n && is_name_byte(string.char_at_n(s, n, j), 0) == 1 { j = j + 1 }
            if j == i + 1 { return i }
            i = j
        } else if c == 91 {
            j = bracket_end(s, n, i)
            if j < 0 { return i }
            i = j
        } else {
            return i
        }
    }
    return i
}

// Is all of `a` a variable path (and not a keyword literal)?
is_path_text(a: string) -> int {
    n = string_length(a)
    if n == 0 || path_end(a, n, 0) != n { return 0 }
    if string.equals(a, "true") == 1 || string.equals(a, "false") == 1 ||
    string.equals(a, "nil") == 1 || string.equals(a, "null") == 1 ||
    string.equals(a, "empty") == 1 || string.equals(a, "blank") == 1 { return 0 }
    return 1
}

// Evaluate a literal or a variable path. Returns (value, error); text that
// is neither is nil, as an unbound name is.
eval_value(ctx: ptr, text: string) -> (string, string) {
    a = trim(text)
    n = string_length(a)
    if n == 0 { return value_nil(), "" }
    if string.equals(a, "true") == 1 { return value_bool(1), "" }
    if string.equals(a, "false") == 1 { return value_bool(0), "" }
    if string.equals(a, "nil") == 1 || string.equals(a, "null") == 1 { return value_nil(), "" }
    // As values, `empty` and `blank` are the empty string; compared against,
    // they test the other side (compare_values).
    if string.equals(a, "empty") == 1 || string.equals(a, "blank") == 1 { return value_str(""), "" }
    // `block.super` inside a layout child block is the parent's content for
    // that block; outside an override it is nil, not an error.
    if string.equals(a, "block.super") == 1 {
        if map_has(ctx, KEY_BLOCK_SUPER) == 1 { return value_str(map_get_raw(ctx, KEY_BLOCK_SUPER)), "" }
        return value_nil(), ""
    }
    // A number literal keeps the text it was written with.
    if is_number_literal(a) == 1 { return value_number(a), "" }
    first = string.char_at_n(a, n, 0)
    if first == 34 || first == 39 {
        lit, err = unquote_arg(a)
        if err != "" { return value_nil(), err }
        return value_str(lit), ""
    }
    if path_end(a, n, 0) == n { return eval_path(ctx, a, n) }
    return value_nil(), ""
}

// Walk the variable path `a` (length `n`, a whole path by path_end).
eval_path(ctx: ptr, a: string, n: int) -> (string, string) {
    cur = value_nil()
    i = 0
    if string.char_at_n(a, n, 0) == 91 {
        j = bracket_end(a, n, 0)
        kv, kerr = eval_value(ctx, string.substring_n(a, n, 1, j - 1))
        if kerr != "" { return value_nil(), kerr }
        cur = lookup_value(ctx, value_text(ctx, kv))
        i = j
    } else {
        while i < n && is_name_byte(string.char_at_n(a, n, i), 0) == 1 { i = i + 1 }
        if i == n { return lookup_value(ctx, a), "" }
        cur = lookup_value(ctx, string.substring_n(a, n, 0, i))
        // A name bound whole, dots and all -- context_put_string(ctx,
        // "user.name", ...) -- is still found under that name when the
        // path's head is not bound.
        if i < n && value_kind(cur) == LV_NIL {
            flat = lookup_value(ctx, a)
            if value_kind(flat) != LV_NIL { return flat, "" }
        }
    }
    while i < n && value_kind(cur) != LV_NIL {
        if string.char_at_n(a, n, i) == 46 {
            j = i + 1
            while j < n && is_name_byte(string.char_at_n(a, n, j), 0) == 1 { j = j + 1 }
            cur = path_step(ctx, cur, value_str(string.substring_n(a, n, i + 1, j)))
            i = j
        } else {
            j = bracket_end(a, n, i)
            kv, kerr = eval_value(ctx, string.substring_n(a, n, i + 1, j - 1))
            if kerr != "" { return value_nil(), kerr }
            cur = path_step(ctx, cur, kv)
            i = j
        }
    }
    return cur, ""
}

// The byte length of the UTF-8 sequence that `lead` starts (1 for a byte
// that starts none, so a malformed string still advances).
utf8_len(lead: int) -> int {
    b = lead & 255
    if b >= 240 && b < 248 { return 4 }
    if b >= 224 && b < 240 { return 3 }
    if b >= 192 && b < 224 { return 2 }
    return 1
}

// The first and the last character of a string, as whole UTF-8 sequences.
first_char(s: string) -> string {
    n = string_length(s)
    if n == 0 { return "" }
    k = utf8_len(string.char_at_n(s, n, 0))
    if k > n { k = n }
    return string.substring_n(s, n, 0, k)
}

last_char(s: string) -> string {
    n = string_length(s)
    if n == 0 { return "" }
    // Step back over continuation bytes (10xxxxxx) to the sequence's lead.
    i = n - 1
    while i > 0 && n - i < 4 && (string.char_at_n(s, n, i) & 192) == 128 { i = i - 1 }
    return string.substring_n(s, n, i, n)
}

// The [key, value] pair for an object's entry `i`, as `for` over an object
// and `first` hand one out.
obj_pair(ctx: ptr, nd: ptr, i: int) -> string {
    key = obj_key_at(nd, i)
    v, _found = obj_get(nd, key)
    pv, pn = node_new(ctx, LV_ARR)
    arr_push(pn, value_str(key))
    arr_push(pn, v)
    return pv
}

// One step along a path: the segment `key` (a value) applied to `cur`.
path_step(ctx: ptr, cur: string, key: string) -> string {
    k = value_kind(cur)
    kk = value_kind(key)
    if k == LV_OBJ {
        nd = node_of(ctx, cur)
        if nd == null { return value_nil() }
        name = value_text(ctx, key)
        v, found = obj_get(nd, name)
        if found == 1 { return v }
        if string.equals(name, "size") == 1 { return value_int(obj_len(nd)) }
        if string.equals(name, "first") == 1 && obj_len(nd) > 0 { return obj_pair(ctx, nd, 0) }
        return value_nil()
    }
    if k == LV_ARR {
        nd = node_of(ctx, cur)
        if nd == null { return value_nil() }
        len = arr_len(nd)
        if kk == LV_INT {
            at = value_get_int(key)
            if at < 0 { at = at + len }
            if at < 0 || at >= len { return value_nil() }
            return arr_at(nd, at)
        }
        if kk == LV_STR {
            name = value_payload(key)
            if string.equals(name, "size") == 1 { return value_int(len) }
            if string.equals(name, "first") == 1 && len > 0 { return arr_at(nd, 0) }
            if string.equals(name, "last") == 1 && len > 0 { return arr_at(nd, len - 1) }
        }
        return value_nil()
    }
    if k == LV_STR && kk == LV_STR {
        s = value_payload(cur)
        name = value_payload(key)
        if string.equals(name, "size") == 1 { return value_int(string_length(s)) }
        if string.equals(name, "first") == 1 { return value_str(first_char(s)) }
        if string.equals(name, "last") == 1 { return value_str(last_char(s)) }
    }
    return value_nil()
}

// ---------------------------------------------------------------------------
// Condition evaluation — `{% if %}`, `{% unless %}`, `{% case %}/{% when %}`
// ---------------------------------------------------------------------------
//
// Liquid's grammar for conditions is FLAT — no parentheses, no
// precedence. `a and b or c` parses as `((a and b) or c)`.
// Implementation: split on top-level `or` (quote-aware), then each
// disjunct on top-level `and`, then each conjunct is `LHS OP RHS` or
// just an atom (truthy test).
//
// Operators (longest match first): `==` `!=` `<=` `>=` `<` `>` `contains`;
// what each compares is compare_values'.
//
// Truthiness is Liquid's (#2177): nil and false are falsy -- an unbound
// name is nil -- and every other value is truthy, the empty string, zero
// and an empty array included. `x == empty` and `x == blank` test x.

// Find the next occurrence of keyword `kw` in `s` (length `n`) at or
// after `p`, only when the match is a whole word (delimited by
// whitespace or end-of-string) AND not inside a quoted string. Returns
// -1 if not found.
find_word_outside_quotes(s: string, n: int, p: int, kw: string) -> int {
    kwn = string_length(kw)
    if kwn == 0 { return -1 }
    i = p
    in_s = 0
    in_d = 0
    while i <= n - kwn {
        c = string.char_at_n(s, n, i)
        if in_s == 1 {
            if c == 39 { in_s = 0 }
            i = i + 1
            continue
        }
        if in_d == 1 {
            if c == 34 { in_d = 0 }
            i = i + 1
            continue
        }
        if c == 39 { in_s = 1; i = i + 1; continue }
        if c == 34 { in_d = 1; i = i + 1; continue }
        // Boundary on the left.
        ok = 0
        if i == 0 { ok = 1 }
        else {
            cp = string.char_at_n(s, n, i - 1)
            if cp == 32 || cp == 9 || cp == 10 || cp == 13 { ok = 1 }
        }
        if ok == 1 && string.index_of_from_n(s, n, kw, i) == i {
            // Boundary on the right.
            tail = i + kwn
            if tail >= n {
                return i
            }
            cn = string.char_at_n(s, n, tail)
            if cn == 32 || cn == 9 || cn == 10 || cn == 13 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// Parse the operator at `[lhs ... rhs]` boundary. Returns (op_token,
// op_off, op_len) where op_off is the byte offset of the operator inside
// `s`. op_token is one of: `==` `!=` `<=` `>=` `<` `>` `contains` ``.
// Empty op_token means no operator found (the whole expression is a
// truthiness test on the atom).
find_operator(s: string, n: int) -> (string, int, int) {
    // Try `contains` first as it is a word, then 2-char ops, then 1-char.
    p = find_word_outside_quotes(s, n, 0, "contains")
    co = -1
    if p >= 0 { co = p }
    // Find earliest two-char op.
    candidates_two = string_list_new()
    string_list_add(candidates_two, "==")
    string_list_add(candidates_two, "!=")
    string_list_add(candidates_two, "<=")
    string_list_add(candidates_two, ">=")
    best_off = -1
    best_tok = ""
    best_len = 0
    k = 0
    while k < 4 {
        tk = string_list_get(candidates_two, k)
        off = find_outside_quotes_str(s, n, 0, tk)
        if off >= 0 && (best_off < 0 || off < best_off) {
            best_off = off
            best_tok = tk
            best_len = 2
        }
        k = k + 1
    }
    // Single-char `<` / `>` — only counted if not part of `<=` / `>=`.
    off_lt = find_outside_quotes(s, n, 0, 60) // '<'
    if off_lt >= 0 {
        // Skip if it's actually `<=`.
        if off_lt + 1 < n && string.char_at_n(s, n, off_lt + 1) == 61 {
            // It's <= — already considered above.
        } else if best_off < 0 || off_lt < best_off {
            best_off = off_lt
            best_tok = "<"
            best_len = 1
        }
    }
    off_gt = find_outside_quotes(s, n, 0, 62) // '>'
    if off_gt >= 0 {
        if off_gt + 1 < n && string.char_at_n(s, n, off_gt + 1) == 61 {
            // It's >= — handled above.
        } else if best_off < 0 || off_gt < best_off {
            best_off = off_gt
            best_tok = ">"
            best_len = 1
        }
    }
    // `contains` wins if it appears before any other op.
    if co >= 0 && (best_off < 0 || co < best_off) {
        return "contains", co, 8
    }
    if best_off < 0 { return "", -1, 0 }
    return best_tok, best_off, best_len
}

// `find_outside_quotes` variant that searches for a multi-byte string,
// not a single byte. Only used by the operator finder above.
find_outside_quotes_str(s: string, n: int, p: int, target: string) -> int {
    tn = string_length(target)
    if tn == 0 { return -1 }
    i = p
    in_s = 0
    in_d = 0
    while i <= n - tn {
        c = string.char_at_n(s, n, i)
        if in_s == 1 {
            if c == 39 { in_s = 0 }
            i = i + 1
            continue
        }
        if in_d == 1 {
            if c == 34 { in_d = 0 }
            i = i + 1
            continue
        }
        if c == 39 { in_s = 1; i = i + 1; continue }
        if c == 34 { in_d = 1; i = i + 1; continue }
        if string.index_of_from_n(s, n, target, i) == i { return i }
        i = i + 1
    }
    return -1
}

// Compare two values under operator `op`. Returns (truthy_int, error).
//
//   `==` / `!=`  values_equal: arrays and objects element by element,
//                numbers as numbers, nil only to nil, other scalars by text
//   `contains`   a string holds the text as a substring; an array holds an
//                element equal to it; an object has it as a key
//   `<` `>` `<=` `>=`  numbers, each side read as Liquid reads a number
//                ("10" > "9"; text that is no number reads as 0); an array
//                or object on either side is an error
compare_values(ctx: ptr, lhs: string, rhs: string, op: string) -> (int, string) {
    if string.equals(op, "==") == 1 { return values_equal(ctx, lhs, rhs), "" }
    if string.equals(op, "!=") == 1 { return 1 - values_equal(ctx, lhs, rhs), "" }
    lk = value_kind(lhs)
    if string.equals(op, "contains") == 1 {
        if lk == LV_ARR {
            nd = node_of(ctx, lhs)
            if nd == null { return 0, "" }
            n = arr_len(nd)
            i = 0
            while i < n {
                if values_equal(ctx, arr_at(nd, i), rhs) == 1 { return 1, "" }
                i = i + 1
            }
            return 0, ""
        }
        if lk == LV_OBJ {
            nd = node_of(ctx, lhs)
            if nd == null { return 0, "" }
            _v, found = obj_get(nd, value_text(ctx, rhs))
            return found, ""
        }
        needle = value_text(ctx, rhs)
        if string_length(needle) == 0 { return 1, "" }
        return string.contains(value_text(ctx, lhs), needle), ""
    }
    if string.equals(op, "<") == 0 && string.equals(op, ">") == 0 &&
    string.equals(op, "<=") == 0 && string.equals(op, ">=") == 0 {
        return 0, string.concat("unknown comparison op: ", op)
    }
    if is_node_value(lhs) == 1 || is_node_value(rhs) == 1 {
        return 0, string.concat(string.concat("cannot order ", value_text(ctx, lhs)),
            string.concat(" and ", value_text(ctx, rhs)))
    }
    c = number_cmp(value_to_string(lhs), value_to_string(rhs))
    if string.equals(op, "<") == 1 && c < 0 { return 1, "" }
    if string.equals(op, ">") == 1 && c > 0 { return 1, "" }
    if string.equals(op, "<=") == 1 && c <= 0 { return 1, "" }
    if string.equals(op, ">=") == 1 && c >= 0 { return 1, "" }
    return 0, ""
}

// `x == empty` / `x == blank` (either side, `!=` too): Liquid's emptiness
// and blankness tests of the other side. Returns (handled, truthy).
compare_keyword(ctx: ptr, lhs_str: string, rhs_str: string, lhs: string, rhs: string, op: string) -> (int, int) {
    if string.equals(op, "==") == 0 && string.equals(op, "!=") == 0 { return 0, 0 }
    other = ""
    word = ""
    if string.equals(rhs_str, "empty") == 1 || string.equals(rhs_str, "blank") == 1 {
        word = rhs_str
        other = lhs
    } else if string.equals(lhs_str, "empty") == 1 || string.equals(lhs_str, "blank") == 1 {
        word = lhs_str
        other = rhs
    } else {
        return 0, 0
    }
    hit = 0
    if string.equals(word, "empty") == 1 { hit = value_is_empty(ctx, other) } else { hit = value_is_blank(ctx, other) }
    if string.equals(op, "!=") == 1 { hit = 1 - hit }
    return 1, hit
}

// Evaluate a single conjunct: either `LHS OP RHS` or a bare atom
// truthy-test. Returns (truthy_int, error).
eval_term(ctx: ptr, term: string) -> (int, string) {
    t = trim(term)
    n = string_length(t)
    if n == 0 { return 0, "" }
    op, off, oplen = find_operator(t, n)
    if string_length(op) == 0 {
        v, err = eval_value(ctx, t)
        if err != "" { return 0, err }
        return value_truthy(v), ""
    }
    lhs_str = trim(string.substring_n(t, n, 0, off))
    rhs_str = trim(string.substring_n(t, n, off + oplen, n))
    lhs, e1 = eval_value(ctx, lhs_str)
    if e1 != "" { return 0, e1 }
    rhs, e2 = eval_value(ctx, rhs_str)
    if e2 != "" { return 0, e2 }
    handled, hit = compare_keyword(ctx, lhs_str, rhs_str, lhs, rhs, op)
    if handled == 1 { return hit, "" }
    return compare_values(ctx, lhs, rhs, op)
}

// Evaluate a full condition expression with Liquid's flat-left
// `or`-of-`and`-of-terms grammar. Returns (truthy_int, error).
eval_condition(ctx: ptr, expr: string) -> (int, string) {
    e = trim(expr)
    n = string_length(e)
    if n == 0 { return 0, "" }
    // Split on top-level `or`, recurse-style by scanning manually.
    or_segs = string_list_new()
    p = 0
    while p <= n {
        cut = find_word_outside_quotes(e, n, p, "or")
        if cut < 0 {
            string_list_add(or_segs, trim(string.substring_n(e, n, p, n)))
            break
        }
        string_list_add(or_segs, trim(string.substring_n(e, n, p, cut)))
        p = cut + 2
    }
    on = string_list_size(or_segs)
    oi = 0
    while oi < on {
        clause = string_list_get(or_segs, oi)
        cn = string_length(clause)
        // Split this clause on top-level `and`.
        all_true = 1
        q = 0
        while q <= cn {
            cut = find_word_outside_quotes(clause, cn, q, "and")
            term = ""
            if cut < 0 {
                term = trim(string.substring_n(clause, cn, q, cn))
                q = cn + 1
            } else {
                term = trim(string.substring_n(clause, cn, q, cut))
                q = cut + 3
            }
            tv, err = eval_term(ctx, term)
            if err != "" { return 0, err }
            if tv == 0 {
                all_true = 0
                break
            }
        }
        if all_true == 1 { return 1, "" }
        oi = oi + 1
    }
    return 0, ""
}

// Scan tokens [start, end) for the matching `end_kw` of a block tag,
// stepping over every block nested inside it (block_nesting). Also stops
// at top-level `branch_kws` (e.g. `else`, `elsif`, `when`) — returns the
// token index of whichever match comes first. The result tuple is
// (token_index, head, ""). Token index is -1 on unterminated, or on a
// closer of another block where this one's belongs.
//
// `branch_kws` is passed as a pipe-separated string (e.g. "else|elsif"
// or "when|else") because we don't have a string-list literal in
// Aether. Pass "" to disable branching.
find_block_branch(kinds: ptr, contents: ptr, start: int, end: int,
    open_kw: string, end_kw: string, branch_kws: string)
-> (int, string, string) {
    depth = 1
    i = start
    // Pre-split branch_kws on '|'.
    branches = string_list_new()
    bn = string_length(branch_kws)
    if bn > 0 {
        bp = 0
        while bp <= bn {
            bcut = string.index_of_from_n(branch_kws, bn, "|", bp)
            if bcut < 0 {
                string_list_add(branches, string.substring_n(branch_kws, bn, bp, bn))
                break
            }
            string_list_add(branches, string.substring_n(branch_kws, bn, bp, bcut))
            bp = bcut + 1
        }
    }
    bcount = string_list_size(branches)
    // Every block inside this one is stepped over whole -- not only another
    // `open_kw` -- so an `else` of an `if` or a `for` nested in the body is
    // that block's, not this one's.
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TAG) == 1 {
            head, _ = tag_head(string_list_get(contents, i))
            nest = block_nesting(head)
            if nest > 0 {
                depth = depth + 1
            } else if nest < 0 {
                depth = depth - 1
                if depth == 0 {
                    string_list_free(branches)
                    if string.equals(head, end_kw) == 1 { return i, end_kw, "" }
                    return -1, "", string.concat(string.concat("unexpected `{% ", head),
                        string.concat(" %}` inside `{% ", string.concat(open_kw, " %}`")))
                }
            } else if depth == 1 {
                k = 0
                while k < bcount {
                    if string.equals(head, string_list_get(branches, k)) == 1 {
                        string_list_free(branches)
                        return i, head, ""
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    string_list_free(branches)
    return -1, "", string.concat("unterminated `{% ", string.concat(open_kw, " %}`"))
}

// Walk tokens [start, end) into a string. Returns (output, "") or
// (partial, error). Recursive for tags like `{% capture %}` whose body
// is itself a template slice that renders into a sub-buffer.
//
// `comment` and `raw` were handled at lex time (their body is either
// dropped or emitted as TEXT), so this walker never sees a TAG token
// for them. `capture NAME` is paired with `endcapture` here at render
// time: we scan forward for the matching endcapture (with nesting),
// recurse into the inner slice to build the captured string, then
// bind it. Any other unknown tag goes to exec_tag, which currently
// dispatches `assign` and errors on everything else.
render_range(kinds: ptr, contents: ptr, start: int, end: int, ctx: ptr) -> (string, string) {
    sb = strbuilder.new(64)
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        body = string_list_get(contents, i)
        if string.equals(kind, TOK_TEXT) == 1 {
            strbuilder.append(sb, body)
        } else if string.equals(kind, TOK_OUTPUT) == 1 {
            v, err = render_output(ctx, body)
            if err != "" {
                return strbuilder.finish(sb), err
            }
            write_output(ctx, sb, v, 0)
        } else {
            // TAG. Special-case `capture NAME` here (block tag) since
            // it needs the token-stream view that exec_tag does not have.
            head, rest = tag_head(body)
            if string.equals(head, "capture") == 1 {
                name = trim(rest)
                if string_length(name) == 0 {
                    return strbuilder.finish(sb), "capture: missing name"
                }
                end_at, err = find_capture_end(kinds, contents, i + 1, end)
                if err != "" {
                    return strbuilder.finish(sb), err
                }
                inner, ierr = render_range(kinds, contents, i + 1, end_at, ctx)
                if ierr != "" {
                    return strbuilder.finish(sb), ierr
                }
                bind_value(ctx, name, value_str(inner))
                i = end_at
            } else if string.equals(head, "endcapture") == 1 {
                // A stray endcapture at this level is a structural error
                // — the matching capture should have skipped past it.
                return strbuilder.finish(sb), "endcapture without matching capture"
            } else if string.equals(head, "increment") == 1 {
                name = trim(rest)
                if string_length(name) == 0 {
                    return strbuilder.finish(sb), "increment: missing name"
                }
                emit, err = bump_counter(ctx, name, 1)
                if err != "" { return strbuilder.finish(sb), err }
                strbuilder.append(sb, emit)
            } else if string.equals(head, "decrement") == 1 {
                name = trim(rest)
                if string_length(name) == 0 {
                    return strbuilder.finish(sb), "decrement: missing name"
                }
                emit, err = bump_counter(ctx, name, 0 - 1)
                if err != "" { return strbuilder.finish(sb), err }
                strbuilder.append(sb, emit)
            } else if string.equals(head, "cycle") == 1 {
                emit, err = cycle_emit(ctx, rest, body)
                if err != "" { return strbuilder.finish(sb), err }
                strbuilder.append(sb, emit)
            } else if string.equals(head, "if") == 1 {
                ifend, iferr = render_if_block(kinds, contents, i, end, ctx, sb, rest, 0)
                if iferr != "" { return strbuilder.finish(sb), iferr }
                i = ifend
            } else if string.equals(head, "unless") == 1 {
                // `unless` is `if` with inverted condition: emit body when
                // condition is FALSY. We reuse render_if_block by passing
                // invert=1 — it negates the initial test only (Liquid does
                // not support `elsif` on `unless`).
                unend, unerr = render_if_block(kinds, contents, i, end, ctx, sb, rest, 1)
                if unerr != "" { return strbuilder.finish(sb), unerr }
                i = unend
            } else if string.equals(head, "case") == 1 {
                csend, cserr = render_case_block(kinds, contents, i, end, ctx, sb, rest)
                if cserr != "" { return strbuilder.finish(sb), cserr }
                i = csend
            } else if string.equals(head, "for") == 1 {
                forend, ferr2 = render_for_block(kinds, contents, i, end, ctx, sb, rest)
                if ferr2 != "" { return strbuilder.finish(sb), ferr2 }
                i = forend
            } else if string.equals(head, "tablerow") == 1 {
                tbend, tberr = render_tablerow_block(kinds, contents, i, end, ctx, sb, rest)
                if tberr != "" { return strbuilder.finish(sb), tberr }
                i = tbend
            } else if string.equals(head, "include") == 1 {
                inc_out, inc_err = render_include_tag(ctx, rest, 0)
                if inc_err != "" { return strbuilder.finish(sb), inc_err }
                strbuilder.append(sb, inc_out)
            } else if string.equals(head, "render") == 1 {
                ren_out, ren_err = render_include_tag(ctx, rest, 1)
                if ren_err != "" { return strbuilder.finish(sb), ren_err }
                strbuilder.append(sb, ren_out)
            } else if string.equals(head, "break") == 1 {
                // Sentinel error string — the enclosing `for` loop
                // catches it and exits. Anything else propagates the
                // sentinel up as a real error via the public surface.
                return strbuilder.finish(sb), "__break__"
            } else if string.equals(head, "continue") == 1 {
                return strbuilder.finish(sb), "__continue__"
            } else if string.equals(head, "elsif") == 1 ||
            string.equals(head, "else") == 1 ||
            string.equals(head, "endif") == 1 ||
            string.equals(head, "endunless") == 1 ||
            string.equals(head, "endcase") == 1 ||
            string.equals(head, "endfor") == 1 ||
            string.equals(head, "endtablerow") == 1 ||
            string.equals(head, "endblock") == 1 ||
            string.equals(head, "block") == 1 ||
            string.equals(head, "layout") == 1 ||
            string.equals(head, "extends") == 1 ||
            string.equals(head, "when") == 1 {
                return strbuilder.finish(sb),
                string.concat("stray `{% ", string.concat(head, " %}` outside its block"))
            } else {
                terr = exec_tag(ctx, body)
                if terr != "" {
                    return strbuilder.finish(sb), terr
                }
            }
        }
        i = i + 1
    }
    return strbuilder.finish(sb), ""
}

// Scan tokens [start, end) for the matching `endcapture` of an outer
// `capture`. Tracks nesting via inner `capture`/`endcapture` pairs.
// Returns (endcapture_token_index, "") on success or (-1, error).
find_capture_end(kinds: ptr, contents: ptr, start: int, end: int) -> (int, string) {
    depth = 1
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TAG) == 1 {
            head, _ = tag_head(string_list_get(contents, i))
            if string.equals(head, "capture") == 1 {
                depth = depth + 1
            } else if string.equals(head, "endcapture") == 1 {
                depth = depth - 1
                if depth == 0 { return i, "" }
            }
        }
        i = i + 1
    }
    return -1, "unterminated `{% capture %}`"
}

// Render an `{% if cond %}...{% elsif cond %}...{% else %}...{% endif %}`
// block starting at token `start` (which is the `{% if %}` tag). When
// `invert=1` the initial test is negated (this is how `{% unless %}` is
// implemented; Liquid does not allow `elsif` on `unless`, so when
// inverting we treat any branch token as an error).
// Appends the chosen branch's output to `sb`. Returns
// (after_endif_index, "") on success or (start, error).
render_if_block(kinds: ptr, contents: ptr, start: int, end: int,
    ctx: ptr, sb: ptr, first_cond: string, invert: int)
-> (int, string) {
    open_kw = "if"
    end_kw = "endif"
    branch_kws = "elsif|else"
    if invert == 1 {
        open_kw = "unless"
        end_kw = "endunless"
        branch_kws = "else" // unless supports `else` but not `elsif`
    }
    // First branch: evaluate `first_cond` (negated when invert).
    cur_cond = trim(first_cond)
    cur_invert = invert
    branch_start = start + 1
    matched = 0
    // Loop over branches: at each step, find the next branch/endkw token,
    // decide whether this branch is the active one.
    while 1 == 1 {
        nxt, head, ferr = find_block_branch(kinds, contents, branch_start, end,
            open_kw, end_kw, branch_kws)
        if ferr != "" { return start, ferr }
        // Test the current branch's condition (skip the test if a prior
        // branch already matched — we just need to skip to endif).
        if matched == 0 {
            take = 0
            if string.equals(head, end_kw) == 1 || string.equals(head, "else") == 1 ||
            string.equals(head, "elsif") == 1 {
                tv = 0
                if string_length(cur_cond) > 0 {
                    v, cerr = eval_condition(ctx, cur_cond)
                    if cerr != "" { return start, cerr }
                    tv = v
                }
                if cur_invert == 1 {
                    if tv == 0 { take = 1 } else { take = 0 }
                } else {
                    if tv == 1 { take = 1 } else { take = 0 }
                }
            }
            if take == 1 {
                inner, ierr = render_range(kinds, contents, branch_start, nxt, ctx)
                if ierr != "" { return start, ierr }
                strbuilder.append(sb, inner)
                matched = 1
            }
        }
        if string.equals(head, end_kw) == 1 {
            // Return index of the end tag itself; caller's loop will bump.
            return nxt, ""
        }
        // Prepare next branch's condition.
        if string.equals(head, "else") == 1 {
            cur_cond = "true"
            cur_invert = 0
        } else if string.equals(head, "elsif") == 1 {
            _, rest = tag_head(string_list_get(contents, nxt))
            cur_cond = trim(rest)
            cur_invert = 0
        } else {
            return start, string.concat("unexpected branch token: ", head)
        }
        branch_start = nxt + 1
    }
    return start, "unreachable"
}

// Render a `{% case x %}{% when v %}...{% when w %}...{% else %}...{% endcase %}`
// block. `subject_expr` is the body after `case` (a single atom — the
// thing each `when` value is compared against). Each `when` accepts
// comma-separated alternatives: `{% when 1, 2, 3 %}` matches if subject
// equals any of them. `else` is the default branch.
render_case_block(kinds: ptr, contents: ptr, start: int, end: int,
    ctx: ptr, sb: ptr, subject_expr: string)
-> (int, string) {
    subject_str = trim(subject_expr)
    if string_length(subject_str) == 0 {
        return start, "case: missing subject"
    }
    subject_val, serr = eval_value(ctx, subject_str)
    if serr != "" { return start, serr }
    branch_start = start + 1
    matched = 0
    cur_alts = "" // "" means "skip until first branch"; "*else*" means else
    is_else = 0
    // The first scan finds the first `when` or `else`. We accept TEXT
    // tokens between `case` and the first `when` as whitespace-only
    // padding (Shopify is forgiving here).
    while 1 == 1 {
        nxt, head, ferr = find_block_branch(kinds, contents, branch_start, end,
            "case", "endcase", "when|else")
        if ferr != "" { return start, ferr }
        // If we're currently INSIDE a branch (cur_alts set), render its
        // body when this branch matched.
        if matched == 0 && (string_length(cur_alts) > 0 || is_else == 1) {
            take = 0
            if is_else == 1 {
                take = 1
            } else {
                // Compare subject against each alternative.
                alts = split_commas(cur_alts)
                ac = string_list_size(alts)
                k = 0
                while k < ac {
                    av, aerr = eval_value(ctx, string_list_get(alts, k))
                    if aerr != "" { return start, aerr }
                    if values_equal(ctx, subject_val, av) == 1 {
                        take = 1
                        break
                    }
                    k = k + 1
                }
            }
            if take == 1 {
                inner, ierr = render_range(kinds, contents, branch_start, nxt, ctx)
                if ierr != "" { return start, ierr }
                strbuilder.append(sb, inner)
                matched = 1
            }
        }
        if string.equals(head, "endcase") == 1 {
            return nxt, ""
        }
        if string.equals(head, "when") == 1 {
            _, rest = tag_head(string_list_get(contents, nxt))
            cur_alts = trim(rest)
            is_else = 0
        } else if string.equals(head, "else") == 1 {
            cur_alts = ""
            is_else = 1
        } else {
            return start, string.concat("unexpected case branch token: ", head)
        }
        branch_start = nxt + 1
    }
    return start, "unreachable"
}

// Parse an integer modifier `limit:N` / `offset:N` / `cols:N` from a tag's
// trailing argument string. `head` is the bare keyword to look for
// (without the trailing colon). N is a number, a quoted number, or a
// variable path holding one (`limit: n`). Returns (value, found, error).
parse_int_modifier(ctx: ptr, rest: string, head: string) -> (int, int, string) {
    rn = string_length(rest)
    needle = string.concat(head, ":")
    nn = string_length(needle)
    p = string.index_of_from_n(rest, rn, needle, 0)
    if p < 0 { return 0, 0, "" }
    // The boundary on the left must be start-of-string or whitespace.
    if p > 0 {
        cb = string.char_at_n(rest, rn, p - 1)
        if cb != 32 && cb != 9 && cb != 10 && cb != 13 {
            return 0, 0, ""
        }
    }
    q = p + nn
    // Skip optional whitespace.
    while q < rn {
        c = string.char_at_n(rest, rn, q)
        if c == 32 || c == 9 { q = q + 1 } else { break }
    }
    if q >= rn { return 0, 0, string.concat(head, ": missing value") }
    // Accept a quoted-string form too.
    first = string.char_at_n(rest, rn, q)
    if first == 34 || first == 39 {
        end_q = q + 1
        while end_q < rn && string.char_at_n(rest, rn, end_q) != first {
            end_q = end_q + 1
        }
        if end_q >= rn { return 0, 0, string.concat(head, ": unterminated quoted arg") }
        s = string.substring_n(rest, rn, q + 1, end_q)
        v, ierr = string.to_int(s)
        if ierr != "" { return 0, 0, string.concat(head, " value not an integer: ${s}") }
        return v, 1, ""
    }
    // A variable path: its value, which must be an integer.
    pe = path_end(rest, rn, q)
    if pe > q {
        pv, perr = eval_value(ctx, string.substring_n(rest, rn, q, pe))
        if perr != "" { return 0, 0, perr }
        v, verr = string.to_int(value_to_string(pv))
        if verr != "" { return 0, 0, string.concat(head, " value not an integer: ${value_to_string(pv)}") }
        return v, 1, ""
    }
    // Bare digits (with optional leading `-`).
    r = q
    if r < rn && string.char_at_n(rest, rn, r) == 45 { r = r + 1 }
    while r < rn {
        c = string.char_at_n(rest, rn, r)
        if c >= 48 && c <= 57 { r = r + 1 } else { break }
    }
    if r == q { return 0, 0, string.concat(head, ": value not an integer") }
    s = string.substring_n(rest, rn, q, r)
    v, ierr = string.to_int(s)
    if ierr != "" { return 0, 0, string.concat(head, " value not an integer: ${s}") }
    return v, 1, ""
}

// Whether `rest` contains a bare-word `reversed` modifier (outside quotes).
has_reversed(rest: string) -> int {
    rn = string_length(rest)
    p = find_word_outside_quotes(rest, rn, 0, "reversed")
    if p >= 0 { return 1 }
    return 0
}

// The typed binding of `name` (a copy: the binding is about to be
// overwritten) and whether there was one, so a loop can put it back after.
save_value(ctx: ptr, name: string) -> (string, int) {
    typed = typed_of(ctx)
    if map_has(typed, name) == 0 { return "", 0 }
    return string.copy(map_get_raw(typed, name)), 1
}

// Inverse of save_value.
restore_value(ctx: ptr, name: string, prior: string, was_bound: int) {
    if was_bound == 1 {
        bind_value(ctx, name, prior)
    } else {
        unbind_value(ctx, name)
    }
}

// +1 for a tag that opens a block, -1 for one that closes one, 0 for any
// other: how a scan for one block's branches steps over the blocks inside it.
block_nesting(head: string) -> int {
    if string.equals(head, "if") == 1 || string.equals(head, "unless") == 1 ||
    string.equals(head, "case") == 1 || string.equals(head, "for") == 1 ||
    string.equals(head, "tablerow") == 1 || string.equals(head, "capture") == 1 ||
    string.equals(head, "block") == 1 {
        return 1
    }
    if string.equals(head, "endif") == 1 || string.equals(head, "endunless") == 1 ||
    string.equals(head, "endcase") == 1 || string.equals(head, "endfor") == 1 ||
    string.equals(head, "endtablerow") == 1 || string.equals(head, "endcapture") == 1 ||
    string.equals(head, "endblock") == 1 {
        return -1
    }
    return 0
}

// The `{% else %}` of the loop whose body is [start, end), nested blocks
// stepped over; -1 when it has none.
find_loop_else(kinds: ptr, contents: ptr, start: int, end: int) -> int {
    depth = 0
    i = start
    while i < end {
        if string.equals(string_list_get(kinds, i), TOK_TAG) == 1 {
            head, _ = tag_head(string_list_get(contents, i))
            nest = block_nesting(head)
            if nest > 0 {
                depth = depth + 1
            } else if nest < 0 {
                depth = depth - 1
            } else if depth == 0 && string.equals(head, "else") == 1 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// Iteration: `{% for %}` and `{% tablerow %}` (#2179)
// ---------------------------------------------------------------------------
//
// `{% for x in SOURCE [limit: N] [offset: N] [reversed] %}` iterates a range
// `(lo..hi)` (inclusive; the bounds may be variables), an array, an object
// (as [key, value] pairs, in key order), or a non-empty string once, as
// itself. nil, an empty string and an empty collection iterate zero times,
// and then the loop's `{% else %}`, if it has one, renders instead. `offset`
// drops elements from the front, `limit` keeps at most that many of the
// rest, and `reversed` runs what is left from the end. Inside the body `x`
// and `forloop` are bound -- forloop's `index`, `index0`, `rindex`,
// `rindex0`, `first`, `last`, `length`, `name`, and `parentloop` in a
// nested loop -- and both are put back afterwards. `tablerow` takes the
// same sources and modifiers, and `cols: N`.

struct LiquidLoop {
    kind: int // LOOP_RANGE, LOOP_ARRAY, LOOP_OBJECT or LOOP_ONE
    source: string // the collection or the single value (an owned copy)
    lo: int // a range's first number
    start: int // the first element taken, after offset
    count: int // the elements taken, after offset and limit
    reversed: int
}

const LOOP_RANGE = 0
const LOOP_ARRAY = 1
const LOOP_OBJECT = 2
const LOOP_ONE = 3

// Split a loop tag's `VAR in SOURCE ...` into (VAR, what follows `in`, error).
loop_head(rest: string, tag: string) -> (string, string, string) {
    rn = string_length(rest)
    in_off = find_word_outside_quotes(rest, rn, 0, "in")
    if in_off < 0 { return "", "", string.concat(tag, ": missing `in` keyword") }
    var_name = trim(string.substring_n(rest, rn, 0, in_off))
    if string_length(var_name) == 0 { return "", "", string.concat(tag, ": missing loop variable") }
    after_in = trim(string.substring_n(rest, rn, in_off + 2, rn))
    if string_length(after_in) == 0 { return "", "", string.concat(tag, ": missing iterable") }
    return var_name, after_in, ""
}

// A range bound's value as an integer (a number, or text that is one).
range_bound(ctx: ptr, text: string, tag: string, which: string) -> (int, string) {
    v, err = eval_value(ctx, text)
    if err != "" { return 0, err }
    n, nerr = string.to_int(value_to_string(v))
    if nerr != "" {
        return 0, string.concat(string.concat(tag, string.concat(": ", which)), string.concat(" not an integer: ", text))
    }
    return n, ""
}

// Read a loop's SOURCE and modifiers (`after_in`: what follows `in`) into a
// LiquidLoop. Returns (loop, modifiers, error); the caller frees the loop
// with heap.free.
loop_open(ctx: ptr, after_in: string, tag: string) -> (ptr, string, string) {
    an = string_length(after_in)
    lp = heap.new(LiquidLoop)
    total = 0
    src_end = 0
    if string.char_at_n(after_in, an, 0) == 40 { // '('
        close_paren = string.index_of_from_n(after_in, an, ")", 0)
        if close_paren < 0 { return lp as ptr, "", string.concat(tag, ": missing `)` in range") }
        range_body = string.substring_n(after_in, an, 1, close_paren)
        rbn = string_length(range_body)
        dotdot = string.index_of_from_n(range_body, rbn, "..", 0)
        if dotdot < 0 { return lp as ptr, "", string.concat(tag, ": range needs `LO..HI`") }
        lo, lerr = range_bound(ctx, trim(string.substring_n(range_body, rbn, 0, dotdot)), tag, "LO")
        if lerr != "" { return lp as ptr, "", lerr }
        hi, herr = range_bound(ctx, trim(string.substring_n(range_body, rbn, dotdot + 2, rbn)), tag, "HI")
        if herr != "" { return lp as ptr, "", herr }
        lp.kind = LOOP_RANGE
        lp.lo = lo
        if hi >= lo { total = hi - lo + 1 }
        src_end = close_paren + 1
    } else {
        first = string.char_at_n(after_in, an, 0)
        if first == 34 || first == 39 {
            src_end = 1
            while src_end < an && string.char_at_n(after_in, an, src_end) != first { src_end = src_end + 1 }
            src_end = src_end + 1
            if src_end > an { return lp as ptr, "", string.concat(tag, ": unterminated string") }
        } else {
            src_end = path_end(after_in, an, 0)
            if src_end == 0 { return lp as ptr, "", string.concat(tag, ": cannot iterate `${after_in}`") }
        }
        v, verr = eval_value(ctx, string.substring_n(after_in, an, 0, src_end))
        if verr != "" { return lp as ptr, "", verr }
        k = value_kind(v)
        nd = node_of(ctx, v)
        if k == LV_ARR && nd != null {
            lp.kind = LOOP_ARRAY
            total = arr_len(nd)
        } else if k == LV_OBJ && nd != null {
            lp.kind = LOOP_OBJECT
            total = obj_len(nd)
        } else if k == LV_STR && string_length(value_payload(v)) > 0 {
            lp.kind = LOOP_ONE
            total = 1
        } else {
            lp.kind = LOOP_ONE
            total = 0
        }
        lp.source = string.copy(v)
    }
    mods = trim(string.substring_n(after_in, an, src_end, an))
    limit_n, has_limit, e_lim = parse_int_modifier(ctx, mods, "limit")
    if e_lim != "" { return lp as ptr, mods, e_lim }
    offset_n, has_offset, e_off = parse_int_modifier(ctx, mods, "offset")
    if e_off != "" { return lp as ptr, mods, e_off }
    off_v = 0
    if has_offset == 1 {
        off_v = offset_n
        if off_v < 0 { off_v = 0 }
        if off_v > total { off_v = total }
    }
    count = total - off_v
    if has_limit == 1 {
        if limit_n < 0 { limit_n = 0 }
        if limit_n < count { count = limit_n }
    }
    if count < 0 { count = 0 }
    lp.start = off_v
    lp.count = count
    lp.reversed = has_reversed(mods)
    return lp as ptr, mods, ""
}

// The loop's `k`-th value (0-based, in the order the loop runs).
loop_item(ctx: ptr, lp: ptr, k: int) -> string {
    l = lp as *LiquidLoop
    at = l.start + k
    if l.reversed == 1 { at = l.start + (l.count - 1 - k) }
    if l.kind == LOOP_RANGE { return value_int(l.lo + at) }
    if l.kind == LOOP_ONE { return l.source }
    nd = node_of(ctx, l.source)
    if nd == null { return value_nil() }
    if l.kind == LOOP_ARRAY { return arr_at(nd, at) }
    return obj_pair(ctx, nd, at)
}

// A `forloop` object for a loop of `length` iterations called `name`, with
// the enclosing loop's forloop (or nil) as `parentloop`.
forloop_new(ctx: ptr, name: string, length: int, parent: string) -> (string, ptr) {
    fv, fnode = node_new(ctx, LV_OBJ)
    obj_set(fnode, "name", value_str(name))
    obj_set(fnode, "length", value_int(length))
    obj_set(fnode, "parentloop", parent)
    obj_set(fnode, "index", value_nil())
    obj_set(fnode, "index0", value_nil())
    obj_set(fnode, "rindex", value_nil())
    obj_set(fnode, "rindex0", value_nil())
    obj_set(fnode, "first", value_nil())
    obj_set(fnode, "last", value_nil())
    return fv, fnode
}

// Point `forloop` at iteration `k` of `length`.
forloop_at(fnode: ptr, k: int, length: int) {
    obj_replace(fnode, "index", value_int(k + 1))
    obj_replace(fnode, "index0", value_int(k))
    obj_replace(fnode, "rindex", value_int(length - k))
    obj_replace(fnode, "rindex0", value_int(length - 1 - k))
    is_first = 0
    if k == 0 { is_first = 1 }
    is_last = 0
    if k == length - 1 { is_last = 1 }
    obj_replace(fnode, "first", value_bool(is_first))
    obj_replace(fnode, "last", value_bool(is_last))
}

// Render a `{% for VAR in SOURCE [modifiers] %}...[{% else %}...]{% endfor %}`
// block. `break` / `continue` arrive from the body as the sentinel errors
// `__break__` and `__continue__`, which this catches. Returns
// (index_of_endfor_token, "") on success or (start, error).
render_for_block(kinds: ptr, contents: ptr, start: int, end: int,
    ctx: ptr, sb: ptr, rest: string)
-> (int, string) {
    body_start = start + 1
    end_at, ferr = find_for_end(kinds, contents, body_start, end)
    if ferr != "" { return start, ferr }
    var_name, after_in, herr = loop_head(rest, "for")
    if herr != "" { return start, herr }
    lp, _mods, lerr = loop_open(ctx, after_in, "for")
    l = lp as *LiquidLoop
    if lerr != "" {
        heap.free(l)
        return start, lerr
    }
    count = l.count
    else_at = find_loop_else(kinds, contents, body_start, end_at)
    body_end = end_at
    if else_at >= 0 { body_end = else_at }

    if count == 0 {
        heap.free(l)
        if else_at >= 0 {
            inner, ierr = render_range(kinds, contents, else_at + 1, end_at, ctx)
            if ierr != "" { return start, ierr }
            strbuilder.append(sb, inner)
        }
        return end_at, ""
    }

    prior_var, had_var = save_value(ctx, var_name)
    prior_loop, had_loop = save_value(ctx, "forloop")
    parent = value_nil()
    if had_loop == 1 { parent = prior_loop }
    loop_name = string.concat(string.concat(var_name, "-"), after_in)
    fv, fnode = forloop_new(ctx, loop_name, count, parent)
    bind_value(ctx, "forloop", fv)
    err = ""
    typed = typed_of(ctx)
    k = 0
    while k < count {
        map_put_string_owned(typed, var_name, loop_item(ctx, lp, k))
        forloop_at(fnode, k, count)
        inner, ierr = render_range(kinds, contents, body_start, body_end, ctx)
        if string.equals(ierr, "__break__") == 1 {
            strbuilder.append(sb, inner)
            break
        }
        if ierr != "" && string.equals(ierr, "__continue__") == 0 {
            err = ierr
            break
        }
        strbuilder.append(sb, inner)
        k = k + 1
    }
    restore_value(ctx, var_name, prior_var, had_var)
    restore_value(ctx, "forloop", prior_loop, had_loop)
    heap.free(l)
    if err != "" { return start, err }
    return end_at, ""
}

// Render a `{% tablerow VAR in SOURCE [cols:N] [limit:N] [offset:N]
// [reversed] %}...{% endtablerow %}` block.
//
// Shopify wraps the iteration in HTML rows and cells: each iteration
// emits `<td class="colN">...body...</td>`, and after every `cols`
// items a new `<tr class="rowM">` opens (the first opens immediately).
// With no `cols`, all items go in one row. Inside the body the same
// variable and `forloop` that `for` binds are bound.
render_tablerow_block(kinds: ptr, contents: ptr, start: int, end: int,
    ctx: ptr, sb: ptr, rest: string)
-> (int, string) {
    body_start = start + 1
    end_at, ferr = find_tablerow_end(kinds, contents, body_start, end)
    if ferr != "" { return start, ferr }
    var_name, after_in, herr = loop_head(rest, "tablerow")
    if herr != "" { return start, herr }
    lp, mods, lerr = loop_open(ctx, after_in, "tablerow")
    l = lp as *LiquidLoop
    if lerr != "" {
        heap.free(l)
        return start, lerr
    }
    cols_n, has_cols, e_cols = parse_int_modifier(ctx, mods, "cols")
    if e_cols != "" {
        heap.free(l)
        return start, e_cols
    }
    count = l.count
    if count == 0 {
        heap.free(l)
        // Shopify still emits an empty <tr> row.
        strbuilder.append(sb, "<tr class=\"row1\">\n</tr>\n")
        return end_at, ""
    }
    cols = count
    if has_cols == 1 {
        if cols_n <= 0 {
            heap.free(l)
            return start, "tablerow: cols must be > 0"
        }
        cols = cols_n
    }

    prior_var, had_var = save_value(ctx, var_name)
    prior_loop, had_loop = save_value(ctx, "forloop")
    parent = value_nil()
    if had_loop == 1 { parent = prior_loop }
    loop_name = string.concat(string.concat(var_name, "-"), after_in)
    fv, fnode = forloop_new(ctx, loop_name, count, parent)
    bind_value(ctx, "forloop", fv)
    err = ""
    row = 1
    col = 1
    strbuilder.append(sb, "<tr class=\"row1\">\n")
    typed = typed_of(ctx)
    k = 0
    while k < count {
        map_put_string_owned(typed, var_name, loop_item(ctx, lp, k))
        forloop_at(fnode, k, count)
        strbuilder.append(sb, "<td class=\"col")
        strbuilder.append(sb, string.from_int(col))
        strbuilder.append(sb, "\">")
        inner, ierr = render_range(kinds, contents, body_start, end_at, ctx)
        if ierr != "" {
            err = ierr
            break
        }
        strbuilder.append(sb, inner)
        strbuilder.append(sb, "</td>")
        col = col + 1
        // Open a new row if we've filled `cols` and there are more items.
        if col > cols && k < count - 1 {
            row = row + 1
            col = 1
            strbuilder.append(sb, "</tr>\n<tr class=\"row")
            strbuilder.append(sb, string.from_int(row))
            strbuilder.append(sb, "\">\n")
        }
        k = k + 1
    }
    restore_value(ctx, var_name, prior_var, had_var)
    restore_value(ctx, "forloop", prior_loop, had_loop)
    heap.free(l)
    if err != "" { return start, err }
    strbuilder.append(sb, "</tr>\n")
    return end_at, ""
}

// Scan [start, end) for the matching `endtablerow`, tracking nesting.
find_tablerow_end(kinds: ptr, contents: ptr, start: int, end: int) -> (int, string) {
    depth = 1
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TAG) == 1 {
            head, _ = tag_head(string_list_get(contents, i))
            if string.equals(head, "tablerow") == 1 {
                depth = depth + 1
            } else if string.equals(head, "endtablerow") == 1 {
                depth = depth - 1
                if depth == 0 { return i, "" }
            }
        }
        i = i + 1
    }
    return -1, "unterminated `{% tablerow %}`"
}

// Scan [start, end) for the matching `endfor`, tracking nested `for`s.
find_for_end(kinds: ptr, contents: ptr, start: int, end: int) -> (int, string) {
    depth = 1
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TAG) == 1 {
            head, _ = tag_head(string_list_get(contents, i))
            if string.equals(head, "for") == 1 {
                depth = depth + 1
            } else if string.equals(head, "endfor") == 1 {
                depth = depth - 1
                if depth == 0 { return i, "" }
            }
        }
        i = i + 1
    }
    return -1, "unterminated `{% for %}`"
}

// ---------------------------------------------------------------------------
// Include / render — fs-gated partial inclusion
// ---------------------------------------------------------------------------
//
// `{% include 'partial' %}` reads `<include_root>/partial.liquid`
// (or the literal path if it already ends in `.liquid`), parses it,
// and renders it against the CURRENT context (inclusions see and can
// mutate outer scope — Shopify's `include` semantics).
//
// `{% render 'partial', x: v, y: w %}` is the strict sibling: the
// partial gets a FRESH context with only the explicitly-passed
// arguments visible. The outer scope is invisible from inside; the
// partial cannot reach out and the partial's assignments do not
// escape. Shopify's modern recommendation.
//
// Both forms require the include-root to be set on the context via
// `context_set_include_root(ctx, root)` BEFORE calling `render`. If
// the root is missing, the tag errors clearly — never silently
// fall back to reading from `.` or `$PWD`. Path traversal is rejected:
// the resolved path must be inside the include-root after `fs.clean`.
//
// Recursion depth is capped (default 100, matches Shopify). The depth
// counter lives in the context under the internal key KEY_INCLUDE_DEPTH.

const MAX_INCLUDE_DEPTH = 100

// Internal context keys. Each starts with a control character, which the
// lexer refuses inside a tag, so no template can name one to read or
// write it (lookup_value refuses such names as well).
const KEY_INCLUDE_ROOT = "\x01inc_root"
const KEY_INCLUDE_DEPTH = "\x01inc_depth"
const KEY_BLOCK_SUPER = "\x01block_super"
// The time `date` reads as "now" (context_set_now); like the value store's
// key, it starts with a control character, so no template can name it.
const KEY_NOW = "\x01now"

// Read the include-root from ctx. Returns ("", 0) when unset.
get_include_root(ctx: ptr) -> (string, int) {
    if map_has(ctx, KEY_INCLUDE_ROOT) == 0 { return "", 0 }
    return map_get_raw(ctx, KEY_INCLUDE_ROOT), 1
}

// Read the current include-depth. 0 if unset.
get_include_depth(ctx: ptr) -> int {
    if map_has(ctx, KEY_INCLUDE_DEPTH) == 0 { return 0 }
    v = map_get_raw(ctx, KEY_INCLUDE_DEPTH)
    n, _ = string.to_int(v)
    return n
}

// Resolve a partial name to its absolute path under the include-root.
// Returns (resolved_path, "") on success or ("", error).
//
// Path rules:
//   - If `name` already ends with `.liquid`, use it verbatim
//   - Otherwise append `.liquid`
//   - `fs.clean` collapses `..` segments
//   - The final path must be `fs.is_within_base(root, ...)` — rejects
//     traversal escapes
resolve_partial_path(root: string, name: string) -> (string, string) {
    n = string_length(name)
    if n == 0 { return "", "include: empty partial name" }
    full = name
    if string.ends_with(name, ".liquid") == 0 {
        full = string.concat(name, ".liquid")
    }
    joined = path_join(root, full)
    cleaned = fs.clean(joined)
    if fs.is_within_base(root, cleaned) == 0 {
        return "", string.concat("include: path escapes include-root: ", name)
    }
    return cleaned, ""
}

// Parse a `render`-style key:value argument list.
//   `, k1: v1, k2: v2`
//   `, k: 'lit'`
//   `, k: outer.path`
// Returns a fresh context holding just those names, or (null, err). Each
// value is evaluated against the OUTER ctx, so a caller passes a
// variable's current value -- an array or object included, which the
// fresh context reads from the store it shares with the outer one:
// `{% render 'p', items: product.variants %}`. The fresh context owns no
// store; free it with bindings_free once the partial has rendered.
parse_render_args(outer_ctx: ptr, body: string, start_after_name: int) -> (ptr, string) {
    fresh = map_new()
    map_put(fresh, KEY_TYPED, map_new())
    map_put(fresh, KEY_VALUES, store_of(outer_ctx))
    n = string_length(body)
    if start_after_name >= n { return fresh, "" }
    // Walk pairs of `key: value`, separated by top-level commas
    // (respecting quotes).
    p = start_after_name
    while p < n {
        // Skip leading whitespace and comma.
        while p < n {
            c = string.char_at_n(body, n, p)
            if c == 32 || c == 9 || c == 44 { p = p + 1 } else { break }
        }
        if p >= n { break }
        // Read until `:` (outside quotes).
        colon = find_outside_quotes(body, n, p, 58)
        if colon < 0 {
            bindings_free(fresh)
            return null, "render: missing `:` in args"
        }
        key = trim(string.substring_n(body, n, p, colon))
        if string_length(key) == 0 {
            bindings_free(fresh)
            return null, "render: missing arg name"
        }
        // Read until next top-level comma (or end).
        comma = find_outside_quotes(body, n, colon + 1, 44)
        end_off = n
        if comma >= 0 { end_off = comma }
        raw_val = trim(string.substring_n(body, n, colon + 1, end_off))
        val, verr = eval_value(outer_ctx, raw_val)
        if verr != "" {
            bindings_free(fresh)
            return null, verr
        }
        bind_value(fresh, key, val)
        if comma < 0 { break }
        p = comma + 1
    }
    return fresh, ""
}

// Dispatch `{% include %}` / `{% render %}` body. `strict` is 1 for
// the `render` form (fresh ctx) or 0 for `include` (inherit ctx).
render_include_tag(outer_ctx: ptr, rest: string, strict: int) -> (string, string) {
    tag_name = "include"
    if strict == 1 { tag_name = "render" }
    rn = string_length(rest)
    if rn == 0 {
        return "", string.concat(tag_name, ": missing partial name")
    }
    // First arg is the quoted partial name.
    first = string.char_at_n(rest, rn, 0)
    if first != 34 && first != 39 {
        return "", string.concat(tag_name, ": partial name must be a quoted string")
    }
    // Find the matching close quote.
    close_q = -1
    j = 1
    while j < rn {
        if string.char_at_n(rest, rn, j) == first { close_q = j; break }
        j = j + 1
    }
    if close_q < 0 {
        return "", string.concat(tag_name, ": unterminated partial name")
    }
    name = string.substring_n(rest, rn, 1, close_q)

    root, has_root = get_include_root(outer_ctx)
    if has_root == 0 {
        return "", string.concat(tag_name, ": no include-root set — call context_set_include_root() first")
    }
    depth = get_include_depth(outer_ctx)
    if depth >= MAX_INCLUDE_DEPTH {
        return "", string.concat(tag_name, ": recursion depth limit (100) exceeded")
    }

    resolved, perr = resolve_partial_path(root, name)
    if perr != "" { return "", perr }
    t, ferr, terr, owned = load_partial(outer_ctx, resolved)
    if ferr != "" {
        return "", string.concat(string.concat(tag_name, ": cannot read partial: "), name)
    }
    if terr != "" {
        return "", string.concat(string.concat(tag_name, " parse error in "), string.concat(name, string.concat(": ", terr)))
    }

    // Build the child ctx.
    child = outer_ctx
    if strict == 1 {
        // Fresh ctx with just the named args (resolved against OUTER).
        // Walk past the closing quote of the name, then expect optional
        // `, k: v, ...` pairs.
        args_ctx, aerr = parse_render_args(outer_ctx, rest, close_q + 1)
        if aerr != "" {
            if owned == 1 { template_free(t) }
            return "", aerr
        }
        child = args_ctx
        // Carry the include-root through so `render` inside `render`
        // works without forcing the caller to set it twice -- and the
        // partial cache, so the fresh context shares it, and the time the
        // host gave, so `date` reads the same "now".
        map_put(child, KEY_INCLUDE_ROOT, root)
        pkey = partial_cache_key()
        if map_has(outer_ctx, pkey) == 1 { map_put(child, pkey, map_get_raw(outer_ctx, pkey)) }
        if map_has(outer_ctx, KEY_NOW) == 1 { map_put(child, KEY_NOW, string.copy(map_get_raw(outer_ctx, KEY_NOW))) }
    }
    // Bump depth on the child ctx for both forms.
    map_put(child, KEY_INCLUDE_DEPTH, string.from_int(depth + 1))

    out, rerr = render(t, child)
    if owned == 1 { template_free(t) }
    if strict == 1 { bindings_free(child) }

    // Restore outer_ctx's depth (only needed for `include`, since
    // child==outer_ctx there). For `render` the child ctx is dropped.
    if strict == 0 {
        if depth == 0 {
            map_put(outer_ctx, KEY_INCLUDE_DEPTH, "0")
        } else {
            map_put(outer_ctx, KEY_INCLUDE_DEPTH, string.from_int(depth))
        }
    }

    if rerr != "" {
        return out, string.concat(string.concat(tag_name, " of "), string.concat(name, string.concat(" failed: ", rerr)))
    }
    return out, ""
}

// Find the first non-whitespace-TEXT token at or after `start`.
// Returns the index, or `end` if none exist (the body is all
// whitespace). TAG tokens and OUTPUT tokens are immediately
// non-whitespace; TEXT tokens are skipped only if their content is
// pure ASCII whitespace.
first_meaningful_token(kinds: ptr, contents: ptr, start: int, end: int) -> int {
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TEXT) == 1 {
            body = string_list_get(contents, i)
            n = string_length(body)
            j = 0
            all_ws = 1
            while j < n {
                c = string.char_at_n(body, n, j)
                if c != 32 && c != 9 && c != 10 && c != 13 {
                    all_ws = 0
                    break
                }
                j = j + 1
            }
            if all_ws == 1 { i = i + 1; continue }
            return i
        }
        return i
    }
    return end
}

// Scan [start, end) for the matching `endblock`, tracking nesting via
// inner `block` openers. Returns (endblock_token_index, "") on success
// or (-1, error).
find_block_end_tag(kinds: ptr, contents: ptr, start: int, end: int) -> (int, string) {
    depth = 1
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TAG) == 1 {
            head, _ = tag_head(string_list_get(contents, i))
            if string.equals(head, "block") == 1 {
                depth = depth + 1
            } else if string.equals(head, "endblock") == 1 {
                depth = depth - 1
                if depth == 0 { return i, "" }
            }
        }
        i = i + 1
    }
    return -1, "unterminated `{% block %}`"
}

// Walk the child template and collect `{% block NAME %}...{% endblock %}`
// ranges into a map of NAME → packed "start:end" string. (We need int
// pairs but our map is string-keyed; pack as "start_idx,end_idx".)
// Other top-level content in the child is silently dropped (Shopify
// spec for layout-using templates).
collect_child_blocks(kinds: ptr, contents: ptr, start: int, end: int) -> (ptr, string) {
    blocks = map_new()
    i = start
    while i < end {
        kind = string_list_get(kinds, i)
        if string.equals(kind, TOK_TAG) == 1 {
            head, rest = tag_head(string_list_get(contents, i))
            if string.equals(head, "block") == 1 {
                name = trim(rest)
                if string_length(name) == 0 {
                    return blocks, "block: missing name"
                }
                body_start = i + 1
                eb, err = find_block_end_tag(kinds, contents, body_start, end)
                if err != "" { return blocks, err }
                // Pack as "start,end" (token indices into the CHILD stream).
                packed = string.concat(string.from_int(body_start), ",")
                packed = string.concat(packed, string.from_int(eb))
                map_put(blocks, name, packed)
                i = eb + 1
                continue
            }
            // Disallow `endblock` outside a block (will be caught later
            // — we just skip here).
        }
        i = i + 1
    }
    return blocks, ""
}

// If the first meaningful token of a template is `{% layout 'name' %}` (or
// `{% extends %}`), return (its index, the quote-stripped name, ""); if it
// is not, (-1, "", ""). A malformed name is an error.
layout_target(kinds: ptr, contents: ptr, n: int) -> (int, string, string) {
    fm = first_meaningful_token(kinds, contents, 0, n)
    if fm >= n { return -1, "", "" }
    if string.equals(string_list_get(kinds, fm), TOK_TAG) == 0 { return -1, "", "" }
    head, rest = tag_head(string_list_get(contents, fm))
    if string.equals(head, "layout") == 0 && string.equals(head, "extends") == 0 {
        return -1, "", ""
    }
    rn = string_length(rest)
    if rn == 0 { return -1, "", "layout: missing parent name" }
    first = string.char_at_n(rest, rn, 0)
    if first != 34 && first != 39 {
        return -1, "", "layout: parent name must be a quoted string"
    }
    close_q = -1
    j = 1
    while j < rn {
        if string.char_at_n(rest, rn, j) == first { close_q = j; break }
        j = j + 1
    }
    if close_q < 0 { return -1, "", "layout: unterminated parent name" }
    return fm, string.substring_n(rest, rn, 1, close_q), ""
}

// Render block `name` as the template at level `from` of a layout chain
// sees it (#2183). Level 0 is the template being rendered, each next level
// its layout, and the base -- the template that has no layout -- renders
// the page. The most derived level from `from` on that defines the block
// supplies its body; inside it `{{ block.super }}` is the same block as the
// next level up defines it, and so on down to the base's own default
// (`base_lo..base_hi` in the base's token stream).
render_block_from(chain_kinds: ptr, chain_contents: ptr, chain_blocks: ptr, levels: int,
    from: int, name: string,
    base_kinds: ptr, base_contents: ptr, base_lo: int, base_hi: int,
    ctx: ptr) -> (string, string) {
    lv = from
    while lv < levels {
        if map_has(list_get_raw(chain_blocks, lv), name) == 1 { break }
        lv = lv + 1
    }
    if lv >= levels {
        return render_range(base_kinds, base_contents, base_lo, base_hi, ctx)
    }
    super_text, serr = render_block_from(chain_kinds, chain_contents, chain_blocks, levels,
        lv + 1, name, base_kinds, base_contents,
        base_lo, base_hi, ctx)
    if serr != "" { return "", serr }
    packed = map_get_raw(list_get_raw(chain_blocks, lv), name)
    pn = string_length(packed)
    comma = string.index_of_from_n(packed, pn, ",", 0)
    lo, _ = string.to_int(string.substring_n(packed, pn, 0, comma))
    hi, _ = string.to_int(string.substring_n(packed, pn, comma + 1, pn))
    had_prior = map_has(ctx, KEY_BLOCK_SUPER)
    prior = ""
    if had_prior == 1 { prior = map_get_raw(ctx, KEY_BLOCK_SUPER) }
    map_put(ctx, KEY_BLOCK_SUPER, super_text)
    inner, rerr = render_range(list_get_raw(chain_kinds, lv), list_get_raw(chain_contents, lv),
        lo, hi, ctx)
    if had_prior == 1 {
        map_put(ctx, KEY_BLOCK_SUPER, prior)
    } else {
        map_remove(ctx, KEY_BLOCK_SUPER)
    }
    return inner, rerr
}

// Render the base template of a layout chain, each `{% block %}` in it
// resolved through the chain (render_block_from). The chain's levels are
// the templates below the base, most derived first.
render_base_with_chain(base_kinds: ptr, base_contents: ptr, base_n: int,
    chain_kinds: ptr, chain_contents: ptr, chain_blocks: ptr,
    levels: int, ctx: ptr) -> (string, string) {
    sb = strbuilder.new(64)
    i = 0
    while i < base_n {
        kind = string_list_get(base_kinds, i)
        body = string_list_get(base_contents, i)
        if string.equals(kind, TOK_TEXT) == 1 {
            strbuilder.append(sb, body)
            i = i + 1
            continue
        }
        if string.equals(kind, TOK_OUTPUT) == 1 {
            v, err = render_output(ctx, body)
            if err != "" { return strbuilder.finish(sb), err }
            write_output(ctx, sb, v, 0)
            i = i + 1
            continue
        }
        head, rest = tag_head(body)
        if string.equals(head, "block") == 1 {
            name = trim(rest)
            if string_length(name) == 0 {
                return strbuilder.finish(sb), "block: missing name"
            }
            body_start = i + 1
            eb, err = find_block_end_tag(base_kinds, base_contents, body_start, base_n)
            if err != "" { return strbuilder.finish(sb), err }
            inner, rerr = render_block_from(chain_kinds, chain_contents, chain_blocks, levels, 0,
                name, base_kinds, base_contents, body_start, eb, ctx)
            if rerr != "" { return strbuilder.finish(sb), rerr }
            strbuilder.append(sb, inner)
            i = eb + 1
            continue
        }
        if string.equals(head, "endblock") == 1 {
            return strbuilder.finish(sb), "endblock without matching block"
        }
        if string.equals(head, "layout") == 1 || string.equals(head, "extends") == 1 {
            return strbuilder.finish(sb), "layout: `{% layout %}` must be the first tag of a template"
        }
        single, serr = render_range(base_kinds, base_contents, i, i + 1, ctx)
        if serr != "" { return strbuilder.finish(sb), serr }
        strbuilder.append(sb, single)
        i = i + 1
    }
    return strbuilder.finish(sb), ""
}

// Free what a layout chain holds: its lists, each level's block map, and
// the parents it parsed without a partial cache (a cached parent belongs to
// the cache, and level 0 is the caller's template).
free_layout_chain(chain_kinds: ptr, chain_contents: ptr, chain_blocks: ptr,
    seen: ptr, owned: ptr) {
    nb = list_size(chain_blocks)
    i = 0
    while i < nb {
        map_free(list_get_raw(chain_blocks, i))
        i = i + 1
    }
    list_free(chain_blocks)
    list_free(chain_kinds)
    list_free(chain_contents)
    string_list_free(seen)
    n = list_size(owned)
    i = 0
    while i < n {
        template_free(list_get_raw(owned, i))
        i = i + 1
    }
    list_free(owned)
}

// Render a template whose first tag is `{% layout 'parent' %}`
// (`lay_idx`, `parent_name`), through every level of its layout chain
// (#2183): the parent may itself declare a layout, and so on, up to a
// base that does not. Each level's `{% block %}` bodies override the ones
// above it; the base renders the page.
//
// Same security and sandbox story as include: requires
// `context_set_include_root`; rejects path traversal; a parent reached
// twice is a cycle; the whole chain counts against the depth-100 budget.
render_layout_template(child_kinds: ptr, child_contents: ptr, child_n: int,
    lay_idx: int, parent_name: string, ctx: ptr) -> (string, string) {
    root, has_root = get_include_root(ctx)
    if has_root == 0 {
        return "", "layout: no include-root set — call context_set_include_root() first"
    }
    depth = get_include_depth(ctx)

    chain_kinds = list_new()
    chain_contents = list_new()
    chain_blocks = list_new()
    seen = string_list_new()
    // Parents this render parsed itself (no partial cache): freed after.
    owned_parents = list_new()
    cur_kinds = child_kinds
    cur_contents = child_contents
    cur_n = child_n
    cur_lay = lay_idx
    cur_parent = parent_name
    levels = 0
    while cur_lay >= 0 {
        if depth + levels >= MAX_INCLUDE_DEPTH {
            free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
            return "", "layout: recursion depth limit (100) exceeded"
        }
        // This level's blocks, from after its layout tag.
        blocks, cerr = collect_child_blocks(cur_kinds, cur_contents, cur_lay + 1, cur_n)
        if cerr != "" {
            map_free(blocks)
            free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
            return "", cerr
        }
        list_add_raw(chain_kinds, cur_kinds)
        list_add_raw(chain_contents, cur_contents)
        list_add_raw(chain_blocks, blocks)
        levels = levels + 1

        resolved, perr = resolve_partial_path(root, cur_parent)
        if perr != "" {
            free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
            return "", perr
        }
        k = 0
        ns = string_list_size(seen)
        while k < ns {
            if string.equals(string_list_get(seen, k), resolved) == 1 {
                free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
                return "", string.concat("layout: cycle through ", cur_parent)
            }
            k = k + 1
        }
        string_list_add(seen, resolved)
        parent_t, ferr, terr, owned = load_partial(ctx, resolved)
        if ferr != "" {
            free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
            return "", string.concat("layout: cannot read parent: ", cur_parent)
        }
        if owned == 1 { list_add_raw(owned_parents, parent_t) }
        if terr != "" {
            msg = string.concat("layout parse error in ", cur_parent)
            msg = string.concat(msg, ": ")
            msg = string.concat(msg, terr)
            free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
            return "", msg
        }
        cur_kinds = list_get_raw(parent_t, 0)
        cur_contents = list_get_raw(parent_t, 1)
        cur_n = string_list_size(cur_kinds)
        next_lay, next_name, lerr = layout_target(cur_kinds, cur_contents, cur_n)
        if lerr != "" {
            free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
            return "", string.concat(string.concat(string.concat("layout ", cur_parent), ": "), lerr)
        }
        cur_lay = next_lay
        last_parent = cur_parent
        cur_parent = next_name
        if cur_lay < 0 { cur_parent = last_parent }
    }

    // Everything the chain renders counts against the shared depth budget,
    // so an include inside any level sees the depth below it.
    map_put(ctx, KEY_INCLUDE_DEPTH, string.from_int(depth + levels))
    out, rerr = render_base_with_chain(cur_kinds, cur_contents, cur_n,
        chain_kinds, chain_contents, chain_blocks, levels, ctx)
    map_put(ctx, KEY_INCLUDE_DEPTH, string.from_int(depth))
    free_layout_chain(chain_kinds, chain_contents, chain_blocks, seen, owned_parents)
    if rerr != "" {
        msg = string.concat("layout render of ", cur_parent)
        msg = string.concat(msg, " failed: ")
        msg = string.concat(msg, rerr)
        return out, msg
    }
    return out, ""
}

// Render `t` against `ctx`. Returns (output, "") on success or
// (partial_output, error) on a render-time problem. Stray `break` /
// `continue` outside any `for` loop surface as a clear error.
//
// If the first meaningful token is `{% layout 'parent' %}`, this
// dispatches to the layout/block engine; otherwise it walks the
// stream linearly via `render_range`. When the outermost render over the
// context's value store returns -- not an include or a `{% render %}`
// inside it -- the arrays and objects it made that no binding reaches are
// reclaimed (store_collect), once enough have been made to be worth it.
render(t: ptr, ctx: ptr) -> (string, string) {
    sp = store_of(ctx)
    st = sp as *LiquidStore
    st.depth = st.depth + 1
    out, err = render_template(t, ctx)
    st.depth = st.depth - 1
    if st.depth == 0 && st.made >= 64 && st.made >= st.live - st.made {
        store_collect(ctx, sp)
    }
    return out, err
}

render_template(t: ptr, ctx: ptr) -> (string, string) {
    kinds = list_get_raw(t, 0)
    contents = list_get_raw(t, 1)
    n = string_list_size(kinds)

    // A template whose first tag is `{% layout 'parent' %}` renders through
    // its layout chain.
    lay, parent_name, lerr = layout_target(kinds, contents, n)
    if lerr != "" { return "", lerr }
    if lay >= 0 {
        return render_layout_template(kinds, contents, n, lay, parent_name, ctx)
    }

    out, err = render_range(kinds, contents, 0, n, ctx)
    if string.equals(err, "__break__") == 1 {
        return out, "`{% break %}` outside `{% for %}` loop"
    }
    if string.equals(err, "__continue__") == 1 {
        return out, "`{% continue %}` outside `{% for %}` loop"
    }
    return out, err
}

// Append-into variant of `render`: writes directly to a caller-supplied
// `strbuilder` and returns just an error string. Useful when stitching
// together many templates (e.g. a static-site build that walks every
// page) — avoids the per-call allocate-finish round trip. Returns ""
// on success or an error string. Partial output written before an
// error is left in the strbuilder (matches `render`'s "partial output
// plus error" shape).
render_to_strbuilder(t: ptr, ctx: ptr, sb: ptr) -> string {
    out, err = render(t, ctx)
    strbuilder.append(sb, out)
    return err
}

// ---------------------------------------------------------------------------
// Typed value model
// ---------------------------------------------------------------------------
//
// Every value the renderer works with is a packed string: a kind letter and
// a colon in front of its payload.
//
//   "n:"          LV_NIL    nil
//   "b:1"/"b:0"   LV_BOOL   boolean
//   "i:42"        LV_INT    integer, as decimal text (unbounded)
//   "f:3.14"      LV_FLOAT  float, as Ruby writes it
//   "s:hello"     LV_STR    string
//   "a:<id>"      LV_ARR    array: node <id> of the context's value store
//   "o:<id>"      LV_OBJ    object: node <id> of the context's value store
//
// Typed bindings live in a map of their own (KEY_TYPED), beside the bare
// strings context_put_string binds in the context map; a typed binding wins
// whichever was bound last. The renderer packs a bare string as a string the
// moment it reads one, and packs everything it makes, so no text a host or a
// template supplies can pass for an array or an object.

const LV_NIL = 0
const LV_BOOL = 1
const LV_INT = 2
const LV_FLOAT = 3
const LV_STR = 4
const LV_ARR = 5
const LV_OBJ = 6

// Scalar narrowing/widening — Aether has no C-style cast (`(int)f`),
// so wrap the implicit narrow/widen as a one-arg call where the
// declared return type drives the conversion.
float_to_int(f: float) -> int { return f }
int_to_float(i: int) -> float { return i }

// Constructors. Each returns a prefix-tagged packed string.
value_nil() -> string { return "n:" }

value_bool(b: int) -> string {
    if b != 0 { return "b:1" }
    return "b:0"
}

value_int(i: int) -> string {
    return string.concat("i:", string.from_int(i))
}

// A float is kept as Ruby writes it (ruby_float_text): every digit that
// round-trips, `3.0` rather than `3`, `1.0e+20` past the fixed range --
// which is also what `{{ x }}` prints, as in Liquid. (It was `%g`: six
// significant digits, and a whole float printed as an integer.)
value_float(f: float) -> string {
    return string.concat("f:", ruby_float_text(f))
}

value_str(s: string) -> string {
    return string.concat("s:", s)
}

// A number's text -- an arithmetic filter's result, a literal -- as the kind
// it reads as: an integer when it has no point, exponent or infinity in it,
// a float otherwise.
value_number(text: string) -> string {
    n = string_length(text)
    i = 0
    while i < n {
        c = string.char_at_n(text, n, i)
        if c == 46 || c == 101 || c == 73 || c == 78 { return string.concat("f:", text) }
        i = i + 1
    }
    return string.concat("i:", text)
}

// Classify a packed value. Returns LV_STR for bare strings (legacy
// bindings that lack a prefix) so a context_put_string value still
// passes through value_to_string as itself.
value_kind(v: string) -> int {
    n = string_length(v)
    if n < 2 { return LV_STR }
    if string.char_at_n(v, n, 1) != 58 { return LV_STR }
    c = string.char_at_n(v, n, 0)
    if c == 110 { return LV_NIL }
    if c == 98 { return LV_BOOL }
    if c == 105 { return LV_INT }
    if c == 102 { return LV_FLOAT }
    if c == 115 { return LV_STR }
    if c == 97 { return LV_ARR }
    if c == 111 { return LV_OBJ }
    return LV_STR
}

// Strip the `X:` prefix. Bare-string LV_STR (no prefix) returns the
// input unchanged — that's the legacy compatibility hatch.
value_payload(v: string) -> string {
    n = string_length(v)
    if n < 2 { return v }
    if string.char_at_n(v, n, 1) != 58 { return v }
    return string.substring_n(v, n, 2, n)
}

value_get_int(v: string) -> int {
    k = value_kind(v)
    if k == LV_INT {
        i, _ = string.to_int(value_payload(v))
        return i
    }
    if k == LV_FLOAT {
        f, _ = string.to_float(value_payload(v))
        return float_to_int(f)
    }
    if k == LV_BOOL {
        if string.equals(value_payload(v), "1") == 1 { return 1 }
        return 0
    }
    if k == LV_STR {
        i, _ = string.to_int(value_payload(v))
        return i
    }
    return 0
}

value_get_float(v: string) -> float {
    k = value_kind(v)
    if k == LV_FLOAT {
        f, _ = string.to_float(value_payload(v))
        return f
    }
    if k == LV_INT {
        i, _ = string.to_int(value_payload(v))
        return int_to_float(i)
    }
    if k == LV_BOOL {
        return int_to_float(value_get_int(v))
    }
    if k == LV_STR {
        f, _ = string.to_float(value_payload(v))
        return f
    }
    return 0.0
}

// A scalar's text: nil is "", a boolean "true" or "false", a number or a
// string its payload. An array or an object belongs to a context, so its
// text comes from rendering it (value_text); here it is "".
value_to_string(v: string) -> string {
    k = value_kind(v)
    if k == LV_NIL || k == LV_ARR || k == LV_OBJ { return "" }
    if k == LV_BOOL {
        if string.equals(value_payload(v), "1") == 1 { return "true" }
        return "false"
    }
    return value_payload(v)
}

// ---- The value store (#2177) ---------------------------------------------
//
// Arrays and objects are nodes in a store the context owns. context_put_json
// copies a JSON tree into it; the array filters, `split`, and `for` over an
// object make new nodes as a template renders. A packed "a:<id>" / "o:<id>"
// names a node by number, and every use looks the number up in the store
// and checks the node's kind, so no value can reach memory the store does
// not hold.
//
// Ownership: the context owns what is bound into it and what its renders
// make, and context_free releases all of it; a caller's own JSON tree stays
// the caller's. Nodes a render made that no binding reaches any more are
// reclaimed as an outermost render returns: the collector marks from the
// context's typed bindings and frees the rest. It runs once the nodes made
// since it last ran are at least as many as the ones held before them, so
// its work stays in proportion to what the renders made.

const KEY_VALUES = "\x01values"

// The context key of its typed bindings: a map from name to packed value.
const KEY_TYPED = "\x01typed"

struct LiquidNode {
    kind: int // LV_ARR or LV_OBJ
    items: ptr // string_list: an array's elements, or an object's keys in insertion order
    fields: ptr // map: an object's key -> packed value; null for an array
    marked: int // reached by the collection in progress
}

struct LiquidStore {
    nodes: ptr // list: id -> *LiquidNode, null for an id that is free
    free_ids: ptr // intarr used as a stack of the free ids
    free_len: int
    free_cap: int
    live: int // nodes held
    made: int // nodes made since the last collection
    depth: int // renders in progress over the contexts sharing this store
}

store_new() -> ptr {
    st = heap.new(LiquidStore)
    st.nodes = list_new()
    st.free_cap = 16
    st.free_ids = intarr_new_raw(16)
    return st as ptr
}

// The store `ctx` keeps its arrays and objects in, made on first use.
store_of(ctx: ptr) -> ptr {
    have = map_get_raw(ctx, KEY_VALUES)
    if have != null { return have }
    st = store_new()
    map_put(ctx, KEY_VALUES, st)
    return st
}

node_free(p: ptr) {
    nd = p as *LiquidNode
    string_list_free(nd.items)
    if nd.fields != null { map_free(nd.fields) }
    heap.free(nd)
}

store_free(p: ptr) {
    st = p as *LiquidStore
    n = list_size(st.nodes)
    i = 0
    while i < n {
        nd = list_get_raw(st.nodes, i)
        if nd != null { node_free(nd) }
        i = i + 1
    }
    list_free(st.nodes)
    intarr_free(st.free_ids)
    heap.free(st)
}

// A new, empty array (LV_ARR) or object (LV_OBJ) in `ctx`'s store. Returns
// its packed value and the node.
node_new(ctx: ptr, kind: int) -> (string, ptr) {
    st = store_of(ctx) as *LiquidStore
    nd = heap.new(LiquidNode)
    nd.kind = kind
    nd.items = string_list_new()
    if kind == LV_OBJ { nd.fields = map_new() }
    id = 0
    if st.free_len > 0 {
        st.free_len = st.free_len - 1
        id = intarr_get_raw(st.free_ids, st.free_len)
        list_set(st.nodes, id, nd as ptr)
    } else {
        id = list_size(st.nodes)
        list_add_raw(st.nodes, nd as ptr)
    }
    st.live = st.live + 1
    st.made = st.made + 1
    if kind == LV_OBJ { return string.concat("o:", string.from_int(id)), nd as ptr }
    return string.concat("a:", string.from_int(id)), nd as ptr
}

// The node an array or object value names in store `sp`, or null for any
// other value and for an id the store does not hold with that kind.
store_node(sp: ptr, v: string) -> ptr {
    k = value_kind(v)
    if k != LV_ARR && k != LV_OBJ { return null }
    if sp == null { return null }
    st = sp as *LiquidStore
    id, err = string.to_int(value_payload(v))
    if err != "" || id < 0 || id >= list_size(st.nodes) { return null }
    p = list_get_raw(st.nodes, id)
    if p == null { return null }
    nd = p as *LiquidNode
    if nd.kind != k { return null }
    return p
}

// The node `v` names in `ctx`'s store (store_node).
node_of(ctx: ptr, v: string) -> ptr {
    return store_node(map_get_raw(ctx, KEY_VALUES), v)
}

arr_len(nd: ptr) -> int { return string_list_size((nd as *LiquidNode).items) }
arr_at(nd: ptr, i: int) -> string { return string_list_get((nd as *LiquidNode).items, i) }
arr_push(nd: ptr, v: string) { string_list_add((nd as *LiquidNode).items, v) }

obj_len(nd: ptr) -> int { return string_list_size((nd as *LiquidNode).items) }
obj_key_at(nd: ptr, i: int) -> string { return string_list_get((nd as *LiquidNode).items, i) }

// Set `key` to `v`: a new key goes after the others, an existing one keeps
// its place. (obj_replace, for a key the object already has.)
obj_set(nd: ptr, key: string, v: string) {
    o = nd as *LiquidNode
    if map_has(o.fields, key) == 0 { string_list_add(o.items, key) }
    map_put_string_owned(o.fields, key, v)
}

// Set `key`, which the object already has, to `v`.
obj_replace(nd: ptr, key: string, v: string) {
    map_put_string_owned((nd as *LiquidNode).fields, key, v)
}

// (value, 1) for a key the object has, (nil, 0) otherwise.
obj_get(nd: ptr, key: string) -> (string, int) {
    o = nd as *LiquidNode
    v = map_get_raw(o.fields, key)
    if v == null { return value_nil(), 0 }
    return v, 1
}

// Keep `id` for the next node.
store_push_free(st: *LiquidStore, id: int) {
    if st.free_len == st.free_cap {
        grown = intarr_new_raw(st.free_cap * 2)
        i = 0
        while i < st.free_len {
            intarr_set_raw(grown, i, intarr_get_raw(st.free_ids, i))
            i = i + 1
        }
        intarr_free(st.free_ids)
        st.free_ids = grown
        st.free_cap = st.free_cap * 2
    }
    intarr_set_raw(st.free_ids, st.free_len, id)
    st.free_len = st.free_len + 1
}

// Is `v` an array or an object, a value the collector traces?
is_node_value(v: string) -> int {
    k = value_kind(v)
    if k == LV_ARR || k == LV_OBJ { return 1 }
    return 0
}

// Free every node of `ctx`'s store that no typed binding of `ctx` reaches.
store_collect(ctx: ptr, sp: ptr) {
    st = sp as *LiquidStore
    pending = string_list_new()
    typed = typed_of(ctx)
    keys = map_keys_raw(typed)
    nk = map_keys_size_raw(keys)
    i = 0
    while i < nk {
        v = map_get_raw(typed, map_keys_get_raw(keys, i))
        if is_node_value(v) == 1 { string_list_add(pending, v) }
        i = i + 1
    }
    map_keys_free(keys)
    while string_list_size(pending) > 0 {
        last = string_list_size(pending) - 1
        p = store_node(sp, string_list_get(pending, last))
        string_list_remove(pending, last)
        if p != null {
            nd = p as *LiquidNode
            if nd.marked == 0 {
                nd.marked = 1
                n = string_list_size(nd.items)
                j = 0
                while j < n {
                    if nd.kind == LV_OBJ {
                        fv, _found = obj_get(p, string_list_get(nd.items, j))
                        if is_node_value(fv) == 1 { string_list_add(pending, fv) }
                    } else {
                        ev = string_list_get(nd.items, j)
                        if is_node_value(ev) == 1 { string_list_add(pending, ev) }
                    }
                    j = j + 1
                }
            }
        }
    }
    string_list_free(pending)
    live = 0
    total = list_size(st.nodes)
    id = 0
    while id < total {
        q = list_get_raw(st.nodes, id)
        if q != null {
            held = q as *LiquidNode
            if held.marked == 1 {
                held.marked = 0
                live = live + 1
            } else {
                node_free(q)
                list_set(st.nodes, id, null)
                store_push_free(st, id)
            }
        }
        id = id + 1
    }
    st.live = live
    st.made = 0
}

// Arrays and objects `ctx` holds right now: what it was given, what its
// renders made that a binding still reaches, and what they made since the
// last collection. For measuring; a template never needs it.
context_value_nodes(ctx: ptr) -> int {
    if map_has(ctx, KEY_VALUES) == 0 { return 0 }
    return (map_get_raw(ctx, KEY_VALUES) as *LiquidStore).live
}

// ---- Reading values: text, output, truthiness, equality, order -------------

// Nesting a value may have and still be printed; past it an array prints as
// `[...]` and an object as `{...}`. A value has no cycles, so this bounds
// only the depth of what the host bound.
const MAX_VALUE_DEPTH = 256

// A value's text where Liquid calls to_s on it -- a string filter's input,
// a comparison's operand, a filter argument: an array or an object as
// Liquid inspects it (`["a", 1]`, `{"k"=>"v"}`), anything else as
// value_to_string writes it.
value_text(ctx: ptr, v: string) -> string {
    if is_node_value(v) == 1 {
        sb = strbuilder.new(32)
        write_inspect(ctx, sb, v, 0)
        return strbuilder.finish(sb)
    }
    return value_to_string(v)
}

// Append what `{{ v }}` prints: nil nothing, an array each element in turn
// (a nested array flattened into it), an object as Liquid inspects it, any
// other value its text.
write_output(ctx: ptr, sb: ptr, v: string, depth: int) {
    k = value_kind(v)
    if k == LV_ARR {
        nd = node_of(ctx, v)
        if nd == null { return }
        if depth >= MAX_VALUE_DEPTH { strbuilder.append(sb, "[...]"); return }
        n = arr_len(nd)
        i = 0
        while i < n {
            write_output(ctx, sb, arr_at(nd, i), depth + 1)
            i = i + 1
        }
        return
    }
    if k == LV_OBJ {
        write_inspect(ctx, sb, v, depth)
        return
    }
    strbuilder.append(sb, value_to_string(v))
}

// Append `s` as a Ruby string literal: double quotes, and a backslash escape
// for a quote, a backslash, `#{` and the control characters.
write_quoted(sb: ptr, s: string) {
    n = string_length(s)
    strbuilder.append_byte(sb, 34)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i) & 255
        if c == 34 { strbuilder.append(sb, "\\\"") }
        else if c == 92 { strbuilder.append(sb, "\\\\") }
        else if c == 10 { strbuilder.append(sb, "\\n") }
        else if c == 9 { strbuilder.append(sb, "\\t") }
        else if c == 13 { strbuilder.append(sb, "\\r") }
        else if c == 12 { strbuilder.append(sb, "\\f") }
        else if c == 11 { strbuilder.append(sb, "\\v") }
        else if c == 8 { strbuilder.append(sb, "\\b") }
        else if c == 7 { strbuilder.append(sb, "\\a") }
        else if c == 27 { strbuilder.append(sb, "\\e") }
        else if c == 35 && i + 1 < n && (string.char_at_n(s, n, i + 1) == 123 ||
            string.char_at_n(s, n, i + 1) == 36 ||
            string.char_at_n(s, n, i + 1) == 64) {
            strbuilder.append(sb, "\\#")
        } else if c < 32 || c == 127 {
            strbuilder.append(sb, "\\u00")
            strbuilder.append_byte(sb, hex_digit(c / 16))
            strbuilder.append_byte(sb, hex_digit(c % 16))
        } else {
            strbuilder.append_byte(sb, c)
        }
        i = i + 1
    }
    strbuilder.append_byte(sb, 34)
}

// Append Liquid's inspect of `v`: a string quoted, nil as `nil`, an array
// as `[a, b]`, an object as `{"k"=>v}`.
write_inspect(ctx: ptr, sb: ptr, v: string, depth: int) {
    k = value_kind(v)
    if k == LV_NIL { strbuilder.append(sb, "nil"); return }
    if k == LV_STR { write_quoted(sb, value_payload(v)); return }
    if k == LV_ARR {
        nd = node_of(ctx, v)
        if nd == null { strbuilder.append(sb, "[]"); return }
        if depth >= MAX_VALUE_DEPTH { strbuilder.append(sb, "[...]"); return }
        strbuilder.append_byte(sb, 91)
        n = arr_len(nd)
        i = 0
        while i < n {
            if i > 0 { strbuilder.append(sb, ", ") }
            write_inspect(ctx, sb, arr_at(nd, i), depth + 1)
            i = i + 1
        }
        strbuilder.append_byte(sb, 93)
        return
    }
    if k == LV_OBJ {
        nd = node_of(ctx, v)
        if nd == null { strbuilder.append(sb, "{}"); return }
        if depth >= MAX_VALUE_DEPTH { strbuilder.append(sb, "{...}"); return }
        strbuilder.append_byte(sb, 123)
        n = obj_len(nd)
        i = 0
        while i < n {
            if i > 0 { strbuilder.append(sb, ", ") }
            key = obj_key_at(nd, i)
            write_quoted(sb, key)
            strbuilder.append(sb, "=>")
            fv, _found = obj_get(nd, key)
            write_inspect(ctx, sb, fv, depth + 1)
            i = i + 1
        }
        strbuilder.append_byte(sb, 125)
        return
    }
    strbuilder.append(sb, value_to_string(v))
}

// Liquid's truthiness: nil and false are false, and every other value --
// the empty string, zero, an empty array -- is true.
value_truthy(v: string) -> int {
    k = value_kind(v)
    if k == LV_NIL { return 0 }
    if k == LV_BOOL {
        if string.equals(value_payload(v), "1") == 1 { return 1 }
        return 0
    }
    return 1
}

// Liquid's `empty`: an empty string, array or object.
value_is_empty(ctx: ptr, v: string) -> int {
    k = value_kind(v)
    if k == LV_STR {
        if string_length(value_payload(v)) == 0 { return 1 }
        return 0
    }
    if k == LV_ARR || k == LV_OBJ {
        nd = node_of(ctx, v)
        if nd == null || string_list_size((nd as *LiquidNode).items) == 0 { return 1 }
    }
    return 0
}

// Liquid's `blank`: nil, false, a string of nothing but whitespace, or an
// empty array or object.
value_is_blank(ctx: ptr, v: string) -> int {
    k = value_kind(v)
    if k == LV_NIL { return 1 }
    if k == LV_BOOL { return 1 - value_truthy(v) }
    if k == LV_STR {
        if string_length(trim(value_payload(v))) == 0 { return 1 }
        return 0
    }
    return value_is_empty(ctx, v)
}

// Is `v` a number (an integer or a float)?
is_number_value(v: string) -> int {
    k = value_kind(v)
    if k == LV_INT || k == LV_FLOAT { return 1 }
    return 0
}

// The value of `t` when it is a plain integer that fits a long (`-?digits`,
// at most 18 digits): (value, 1). (0, 0) for any other text.
small_int(t: string) -> (long, int) {
    n = string_length(t)
    i = 0
    neg = 0
    if n > 0 && string.char_at_n(t, n, 0) == 45 {
        neg = 1
        i = 1
    }
    if i >= n || n - i > 18 { return 0 as long, 0 }
    v = 0 as long
    while i < n {
        c = string.char_at_n(t, n, i)
        if c < 48 || c > 57 { return 0 as long, 0 }
        v = v * 10 + ((c - 48) as long)
        i = i + 1
    }
    if neg == 1 { v = 0 - v }
    return v, 1
}

// Compare two numbers' texts as Liquid reads numbers (dparse: "12px" is 12,
// "abc" is 0, a decimal exactly): -1, 0 or 1. Two plain integers, the
// common case, compare as longs.
number_cmp(a: string, b: string) -> int {
    av, aok = small_int(a)
    bv, bok = small_int(b)
    if aok == 1 && bok == 1 {
        if av < bv { return -1 }
        if av > bv { return 1 }
        return 0
    }
    _ad, an, am, ascale = dparse(a)
    _bd, bn, bm, bscale = dparse(b)
    if an != bn {
        if an == 1 { return -1 }
        return 1
    }
    scale = ascale
    if bscale > scale { scale = bscale }
    c = dcmp(dshift(am, scale - ascale), dshift(bm, scale - bscale))
    if an == 1 { return 0 - c }
    return c
}

// `==` between two values. Arrays and objects are equal when their elements
// (their keys and values) are; two numbers when they are the same number
// (`1 == 1.0`); nil only to nil. Other scalars compare by their text, as
// the string-typed context always has (`3 == "3"`).
values_equal(ctx: ptr, a: string, b: string) -> int {
    ka = value_kind(a)
    kb = value_kind(b)
    if ka == LV_ARR || ka == LV_OBJ || kb == LV_ARR || kb == LV_OBJ {
        if ka != kb { return 0 }
        na = node_of(ctx, a)
        nb = node_of(ctx, b)
        if na == null || nb == null { return 0 }
        if na == nb { return 1 }
        n = string_list_size((na as *LiquidNode).items)
        if n != string_list_size((nb as *LiquidNode).items) { return 0 }
        i = 0
        while i < n {
            if ka == LV_ARR {
                if values_equal(ctx, arr_at(na, i), arr_at(nb, i)) == 0 { return 0 }
            } else {
                key = obj_key_at(na, i)
                bv, found = obj_get(nb, key)
                if found == 0 { return 0 }
                av, _f = obj_get(na, key)
                if values_equal(ctx, av, bv) == 0 { return 0 }
            }
            i = i + 1
        }
        return 1
    }
    if ka == LV_NIL || kb == LV_NIL {
        if ka == kb { return 1 }
        return 0
    }
    if is_number_value(a) == 1 && is_number_value(b) == 1 {
        if number_cmp(value_payload(a), value_payload(b)) == 0 { return 1 }
        return 0
    }
    return string.equals(value_to_string(a), value_to_string(b))
}

// A key under which equal values meet and unequal ones do not, as `uniq`
// tells elements apart: the kind with the text, so `1` and `"1"` stay two.
value_identity(ctx: ptr, v: string) -> string {
    k = value_kind(v)
    if k == LV_ARR || k == LV_OBJ {
        sb = strbuilder.new(32)
        strbuilder.append_byte(sb, string.char_at_n(v, string_length(v), 0))
        write_inspect(ctx, sb, v, 0)
        return strbuilder.finish(sb)
    }
    if k == LV_FLOAT {
        _d, neg, m, scale = dparse(value_payload(v))
        return string.concat("f:", dtext(neg, m, scale))
    }
    if k == LV_STR { return string.concat("s:", value_payload(v)) }
    return v
}

// ---- Values from JSON (#2177) --------------------------------------------

// A std.json value as a Liquid value, an array or object copied into
// `ctx`'s store. A number written with no fraction or exponent is an
// integer, any other a float. Returns (value, error): nesting deeper than
// std.json's own limit of 256 levels is an error.
json_to_value(ctx: ptr, jv: ptr, depth: int) -> (string, string) {
    if depth > 256 { return value_nil(), "nested deeper than 256 levels" }
    t = json.json_type(jv)
    if t == 1 { return value_bool(json.json_get_bool(jv)), "" }
    if t == 2 {
        if json.json_is_integer(jv) == 1 {
            return string.concat("i:", string.from_long(json.json_get_long(jv))), ""
        }
        return value_float(json.json_get_number(jv)), ""
    }
    if t == 3 { return string.concat("s:", json.json_get_string_raw(jv)), "" }
    if t == 4 {
        av, an = node_new(ctx, LV_ARR)
        n = json.json_array_size(jv)
        i = 0
        while i < n {
            ev, eerr = json_to_value(ctx, json.json_array_get_raw(jv, i), depth + 1)
            if eerr != "" { return value_nil(), eerr }
            arr_push(an, ev)
            i = i + 1
        }
        return av, ""
    }
    if t == 5 {
        ov, on = node_new(ctx, LV_OBJ)
        n = json.json_object_size_raw(jv)
        i = 0
        while i < n {
            fv, ferr = json_to_value(ctx, json.json_object_value_at(jv, i), depth + 1)
            if ferr != "" { return value_nil(), ferr }
            obj_set(on, json.json_object_key_at(jv, i), fv)
            i = i + 1
        }
        return ov, ""
    }
    return value_nil(), ""
}

// ---------------------------------------------------------------------------
// Typed context setters
// ---------------------------------------------------------------------------

context_put_int(ctx: ptr, key: string, value: int) {
    map_put(typed_of(ctx), key, value_int(value))
}

context_put_float(ctx: ptr, key: string, value: float) {
    map_put(typed_of(ctx), key, value_float(value))
}

context_put_bool(ctx: ptr, key: string, value: int) {
    map_put(typed_of(ctx), key, value_bool(value))
}

context_put_nil(ctx: ptr, key: string) {
    map_put(typed_of(ctx), key, value_nil())
}

// Bind `key` to a copy of the std.json tree `value` -- an array, object,
// string, number, boolean or null. The context keeps its own copy, so the
// caller frees `value` whenever it likes, and context_free releases the
// copy. Returns "" or why the tree could not be bound.
context_put_json(ctx: ptr, key: string, value: ptr) -> string {
    v, err = json_to_value(ctx, value, 0)
    if err != "" { return string.concat("context_put_json: ", err) }
    bind_value(ctx, key, v)
    return ""
}

// Parse `text` as JSON and bind the result as context_put_json does. Returns
// "" or the parse error.
context_put_json_text(ctx: ptr, key: string, text: string) -> string {
    root, kind, msg = json.parse_strict(text)
    if kind != json.KIND_OK { return string.concat("context_put_json_text: ", msg) }
    err = context_put_json(ctx, key, root)
    json.json_free(root)
    return err
}
