// Value-model spec for contrib.templating.liquid — co-located with the
// module it exercises, written in Aether against std.spec.
//
// Replaces tests/integration/liquid_{value_basics,assign,capture}/. See
// test_syntax.ae for why the shell wrappers were retired.
//
// This file is the "what a variable holds and how it gets bound" half:
// the typed value constructors, arrays and objects in the context (#2177),
// variable paths into them (#2178), the `{% assign %}` tag, and
// `{% capture %}`.

import contrib.templating.liquid
import std.spec
import std.string
import std.json

render_one(src: string, ctx: ptr) -> string {
    t, _ = liquid.parse_string(src)
    out, _ = liquid.render(t, ctx)
    return out
}

render_bare(src: string) -> string {
    t, _ = liquid.parse_string(src)
    out, _ = liquid.render(t, liquid.context_new())
    return out
}

// Render `src` and return only the error, for the cases that assert a
// template is rejected.
render_err(src: string) -> string {
    t, _ = liquid.parse_string(src)
    _, e = liquid.render(t, liquid.context_new())
    return e
}

// A context with `key` bound to the JSON `text` (context_put_json_text).
json_ctx(key: string, text: string) -> ptr {
    ctx = liquid.context_new()
    err = liquid.context_put_json_text(ctx, key, text)
    if err != "" { println("fixture ${key} is not JSON: ${err}") }
    return ctx
}

// Render `src` against `ctx`: the output, or "ERR <message>".
render_in(src: string, ctx: ptr) -> string {
    t, perr = liquid.parse_string(src)
    if perr != "" { return string.concat("PARSE ", perr) }
    out, err = liquid.render(t, ctx)
    liquid.template_free(t)
    if err != "" { return string.concat("ERR ", err) }
    return out
}

// Render `src` against a context with `key` bound to the JSON `text`.
render_json(src: string, key: string, text: string) -> string {
    ctx = json_ctx(key, text)
    out = render_in(src, ctx)
    liquid.context_free(ctx)
    return out
}

// The object the path specs read.
const USER = "{\"name\": \"Ada\", \"first name\": \"A\", \"tags\": [\"x\", \"y\", \"z\"], \"n\": 42, \"f\": 2.5, \"ok\": true, \"no\": false, \"none\": null, \"size\": 7, \"addr\": {\"city\": \"Paris\", \"zip\": [7, 5, 0, 0, 1]}}"

render_user(src: string) -> string {
    return render_json(src, "user", USER)
}

main() {
    fw = spec.init()

    spec.describe(fw, "liquid: typed context values") {
        spec.it(fw, "renders an int") callback {
            ctx1 = liquid.context_new()
            liquid.context_put_int(ctx1, "n", 42)
            spec.assert_str_eq(render_one("{{ n }}", ctx1), "42", "1 int")
        }

        // Asserted by substring rather than equality: how many decimal
        // places a float renders with is not what this case is pinning.
        spec.it(fw, "renders a float") callback {
            ctx2 = liquid.context_new()
            liquid.context_put_float(ctx2, "pi", 3.14)
            out2 = render_one("{{ pi }}", ctx2)
            spec.assert_contains(out2, "3.14", "2 float")
        }

        spec.it(fw, "renders bool true as `true`") callback {
            ctx3 = liquid.context_new()
            liquid.context_put_bool(ctx3, "b", 1)
            spec.assert_str_eq(render_one("{{ b }}", ctx3), "true", "3 bool true")
        }

        spec.it(fw, "renders bool false as `false`") callback {
            ctx4 = liquid.context_new()
            liquid.context_put_bool(ctx4, "b", 0)
            spec.assert_str_eq(render_one("{{ b }}", ctx4), "false", "4 bool false")
        }

        spec.it(fw, "renders nil as the empty string") callback {
            ctx5 = liquid.context_new()
            liquid.context_put_nil(ctx5, "x")
            spec.assert_str_eq(render_one("[{{ x }}]", ctx5), "[]", "5 nil empty")
        }

        // The typed binding must win over the older untyped string one no
        // matter which was bound last — otherwise the result depends on
        // caller ordering.
        spec.it(fw, "lets a typed value shadow a legacy string binding") callback {
            ctx6 = liquid.context_new()
            liquid.context_put_string(ctx6, "x", "legacy")
            liquid.context_put_int(ctx6, "x", 99)
            spec.assert_str_eq(render_one("{{ x }}", ctx6), "99",
                "6 typed shadows legacy")
        }

        spec.it(fw, "keeps the typed value even when legacy is bound after") callback {
            ctx9 = liquid.context_new()
            liquid.context_put_int(ctx9, "y", 7)
            liquid.context_put_string(ctx9, "y", "legacy_after")
            spec.assert_str_eq(render_one("{{ y }}", ctx9), "7",
                "9 typed wins after legacy")
        }

        spec.it(fw, "renders a negative int") callback {
            ctx7 = liquid.context_new()
            liquid.context_put_int(ctx7, "n", -17)
            spec.assert_str_eq(render_one("{{ n }}", ctx7), "-17", "7 neg int")
        }

        spec.it(fw, "renders zero") callback {
            ctx8 = liquid.context_new()
            liquid.context_put_int(ctx8, "n", 0)
            spec.assert_str_eq(render_one("{{ n }}", ctx8), "0", "8 zero int")
        }

        spec.it(fw, "stringifies values built directly") callback {
            spec.assert_str_eq(liquid.value_to_string(liquid.value_str("hello")),
                "hello", "10 value_str round-trip")
            spec.assert_str_eq(liquid.value_to_string(liquid.value_nil()),
                "", "11 nil stringifies empty")
            spec.assert_str_eq(liquid.value_to_string(liquid.value_bool(1)),
                "true", "12a bool true str")
            spec.assert_str_eq(liquid.value_to_string(liquid.value_bool(0)),
                "false", "12b bool false str")
        }
    }

    spec.describe(fw, "liquid: assign") {
        spec.it(fw, "binds a double-quoted literal") callback {
            spec.assert_str_eq(render_bare("{% assign x = \"hello\" %}{{ x }}"),
                "hello", "1 assign double-quoted literal")
        }

        spec.it(fw, "binds a single-quoted literal") callback {
            spec.assert_str_eq(render_bare("{% assign x = 'world' %}{{ x }}"),
                "world", "2 assign single-quoted literal")
        }

        spec.it(fw, "copies one binding to another") callback {
            ctx3 = liquid.context_new()
            liquid.context_put_string(ctx3, "name", "alice")
            spec.assert_str_eq(
                render_one("{% assign greeting = name %}Hi, {{ greeting }}!", ctx3),
                "Hi, alice!", "3 assign from variable")
        }

        spec.it(fw, "re-binds, so the second assign wins") callback {
            spec.assert_str_eq(
                render_bare("{% assign x = \"first\" %}{% assign x = \"second\" %}{{ x }}"),
                "second", "4 assign rebinds")
        }

        spec.it(fw, "applies a filter chain to a literal") callback {
            spec.assert_str_eq(
                render_bare("{% assign x = \"hi\" | upcase | append:\"!\" %}{{ x }}"),
                "HI!", "5 assign literal + filters")
        }

        // The filtered copy must not write back through to the source
        // binding — `name` still reads as it was bound.
        spec.it(fw, "filters a variable without mutating the original") callback {
            ctx6 = liquid.context_new()
            liquid.context_put_string(ctx6, "name", "alice")
            spec.assert_str_eq(
                render_one("{% assign loud = name | upcase %}{{ loud }} / {{ name }}", ctx6),
                "ALICE / alice", "6 assign var + filter, original kept")
        }

        // assign takes effect at its position in the template, not for the
        // whole render — a reference above it still sees the old value.
        spec.it(fw, "takes effect from its position onward") callback {
            ctx7 = liquid.context_new()
            liquid.context_put_string(ctx7, "x", "old")
            spec.assert_str_eq(
                render_one("{{ x }}{% assign x = \"new\" %}-{{ x }}", ctx7),
                "old-new", "7 assign mid-template")
        }

        spec.it(fw, "rejects a missing `=`") callback {
            spec.assert_not_eq(string.length(render_err("{% assign x \"hi\" %}")), 0,
                "8 missing `=`: expected error")
        }

        spec.it(fw, "rejects a missing name") callback {
            spec.assert_not_eq(string.length(render_err("{% assign  = \"hi\" %}")), 0,
                "9 missing name: expected error")
        }

        spec.it(fw, "still errors on an unsupported tag") callback {
            spec.assert_not_eq(
                string.length(render_err("{% nosuchtag x %}b")), 0,
                "10 unsupported tag: expected error")
        }
    }

    spec.describe(fw, "liquid: capture") {
        spec.it(fw, "captures literal text into a binding") callback {
            spec.assert_str_eq(
                render_bare("{% capture msg %}hello{% endcapture %}>{{ msg }}<"),
                ">hello<", "1 bare capture")
        }

        spec.it(fw, "interpolates the surrounding context into the body") callback {
            ctx2 = liquid.context_new()
            liquid.context_put_string(ctx2, "name", "alice")
            spec.assert_str_eq(
                render_one("{% capture greet %}Hi {{ name }}{% endcapture %}>>{{ greet }}<<", ctx2),
                ">>Hi alice<<", "2 capture interpolates var")
        }

        spec.it(fw, "runs a filter chain inside the body") callback {
            ctx3 = liquid.context_new()
            liquid.context_put_string(ctx3, "name", "alice")
            spec.assert_str_eq(
                render_one("{% capture loud %}{{ name | upcase | append:\"!\" }}{% endcapture %}{{ loud }}", ctx3),
                "ALICE!", "3 capture body uses filters")
        }

        // Shopify semantics: variables are global, so an assign inside a
        // capture body is visible after the block. Deliberate, not a leak.
        spec.it(fw, "lets an assign inside the body escape to the parent") callback {
            spec.assert_str_eq(
                render_bare("{% capture _ %}{% assign x = \"set\" %}{% endcapture %}{{ x }}"),
                "set", "4 capture-internal assign leaks")
        }

        spec.it(fw, "lets a later capture reference an earlier one") callback {
            spec.assert_str_eq(
                render_bare("{% capture a %}AA{% endcapture %}{% capture b %}{{ a }}-BB{% endcapture %}{{ b }}"),
                "AA-BB", "5 second capture uses first")
        }

        spec.it(fw, "shadows an outer binding from its position onward") callback {
            ctx6 = liquid.context_new()
            liquid.context_put_string(ctx6, "x", "OLD")
            spec.assert_str_eq(
                render_one("[{{ x }}]{% capture x %}NEW{% endcapture %}[{{ x }}]", ctx6),
                "[OLD][NEW]", "6 capture shadows ctx")
        }

        spec.it(fw, "nests, with the inner name also visible outside") callback {
            spec.assert_str_eq(
                render_bare("{% capture outer %}({% capture inner %}IN{% endcapture %}{{ inner }}){% endcapture %}[{{ outer }}][{{ inner }}]"),
                "[(IN)][IN]", "7 nested captures")
        }

        // A capture under a comment must not bind: the comment wins, so
        // `m` stays unbound and renders empty.
        spec.it(fw, "does not bind when the capture sits inside a comment") callback {
            spec.assert_str_eq(
                render_bare("a{% comment %}{% capture m %}never{% endcapture %}{% endcomment %}b<{{ m }}>"),
                "ab<>", "8 capture under comment dropped")
        }

        spec.it(fw, "binds the empty string for an empty body") callback {
            spec.assert_str_eq(render_bare("{% capture m %}{% endcapture %}[{{ m }}]"),
                "[]", "9 empty capture body")
        }

        spec.it(fw, "rejects a missing name") callback {
            spec.assert_not_eq(
                string.length(render_err("{% capture %}body{% endcapture %}")), 0,
                "10 missing name: expected error")
        }

        spec.it(fw, "rejects an unclosed capture") callback {
            spec.assert_not_eq(
                string.length(render_err("before {% capture m %}body never closed")), 0,
                "11 unmatched capture: expected error")
        }

        spec.it(fw, "rejects a stray endcapture") callback {
            spec.assert_not_eq(
                string.length(render_err("hi {% endcapture %} bye")), 0,
                "12 stray endcapture: expected error")
        }

        spec.it(fw, "honours whitespace control on the capture tags") callback {
            spec.assert_str_eq(
                render_bare("a   {%- capture m -%}   body   {%- endcapture -%}   b{{ m }}"),
                "abbody", "13 whitespace control around capture")
        }
    }

    spec.describe(fw, "liquid: arrays and objects (#2177)") {
        spec.it(fw, "prints an array's elements one after another") callback {
            spec.assert_str_eq(render_json("{{ xs }}", "xs", "[1, \"a\", null, true, 2.5]"),
                "1atrue2.5", "1 array output")
        }

        spec.it(fw, "flattens a nested array when printing it") callback {
            spec.assert_str_eq(render_json("{{ xs }}", "xs", "[[1, 2], [3, [4]]]"),
                "1234", "2 nested array output")
        }

        spec.it(fw, "prints an object as Liquid inspects a hash") callback {
            spec.assert_str_eq(
                render_json("{{ o }}", "o", "{\"a\": 1, \"b\": \"x\", \"c\": null, \"d\": [1, \"y\"], \"e\": {}}"),
                "{\"a\"=>1, \"b\"=>\"x\", \"c\"=>nil, \"d\"=>[1, \"y\"], \"e\"=>{}}", "3 object output")
        }

        spec.it(fw, "escapes a string inside an inspected value as Ruby does") callback {
            spec.assert_str_eq(render_json("{{ o }}", "o", "{\"q\": \"a\\\"b\\\\c\\nd#{e\"}"),
                "{\"q\"=>\"a\\\"b\\\\c\\nd\\#{e\"}", "4 inspect escapes")
        }

        spec.it(fw, "keeps integers and floats as JSON wrote them") callback {
            spec.assert_str_eq(render_json("{% for v in xs %}{{ v }};{% endfor %}", "xs", "[42, 42.0, 2.5, 1e2, -7]"),
                "42;42.0;2.5;100.0;-7;", "5 JSON numbers")
        }

        spec.it(fw, "copies a JSON tree, so the caller may free it first") callback {
            tree = json.arr()
            json.push(tree, json.str("kept"))
            json.push(tree, json.from_int(3))
            ctx = liquid.context_new()
            spec.assert_str_eq(liquid.context_put_json(ctx, "t", tree), "", "6a bound")
            json.json_free(tree)
            spec.assert_str_eq(render_in("{{ t[0] }}{{ t[1] }}", ctx), "kept3", "6b read after the tree is freed")
            liquid.context_free(ctx)
        }

        spec.it(fw, "reports JSON it cannot parse") callback {
            ctx = liquid.context_new()
            spec.assert_not_eq(string.length(liquid.context_put_json_text(ctx, "x", "[1, ")), 0,
                "7 parse error reported")
            liquid.context_free(ctx)
        }

        spec.it(fw, "refuses a tree nested deeper than 256 levels") callback {
            // Built from the inside out: a pushed array goes in as it is then.
            root = json.arr()
            k = 0
            while k < 300 {
                outer = json.arr()
                json.push(outer, root)
                root = outer
                k = k + 1
            }
            ctx = liquid.context_new()
            spec.assert_not_eq(string.length(liquid.context_put_json(ctx, "deep", root)), 0,
                "8 too deep reported")
            json.json_free(root)
            liquid.context_free(ctx)
        }

        spec.it(fw, "lets a JSON binding shadow a bare string one") callback {
            ctx = liquid.context_new()
            liquid.context_put_string(ctx, "x", "bare")
            liquid.context_put_json_text(ctx, "x", "[1, 2]")
            spec.assert_str_eq(render_in("{{ x }}", ctx), "12", "9 typed wins")
            liquid.context_free(ctx)
        }

        spec.it(fw, "treats only nil and false as false") callback {
            spec.assert_str_eq(
                render_json("{% if v.e %}E{% endif %}{% if v.s %}S{% endif %}{% if v.z %}Z{% endif %}{% if v.f %}F{% endif %}{% if v.o %}O{% endif %}{% if v.zero %}0{% endif %}",
                    "v", "{\"e\": [], \"s\": \"\", \"z\": null, \"f\": false, \"o\": {}, \"zero\": 0}"),
                "ESO0", "10 truthiness")
        }

        spec.it(fw, "treats an empty bare string as true, as Liquid does") callback {
            ctx = liquid.context_new()
            liquid.context_put_string(ctx, "b", "")
            spec.assert_str_eq(render_in("{% if b %}B{% else %}-{% endif %}", ctx), "B", "11 empty string is true")
            liquid.context_free(ctx)
        }

        spec.it(fw, "tests emptiness with == empty") callback {
            spec.assert_str_eq(
                render_json("{% if v.e == empty %}1{% endif %}{% if v.a == empty %}2{% endif %}{% if v.o == empty %}3{% endif %}{% if v.s == empty %}4{% endif %}{% if v.a != empty %}5{% endif %}{% if empty == v.e %}6{% endif %}",
                    "v", "{\"e\": [], \"a\": [1], \"o\": {}, \"s\": \"\"}"),
                "13456", "12 empty")
        }

        spec.it(fw, "tests blankness with == blank") callback {
            spec.assert_str_eq(
                render_json("{% if v.z == blank %}1{% endif %}{% if v.w == blank %}2{% endif %}{% if v.f == blank %}3{% endif %}{% if v.e == blank %}4{% endif %}{% if v.t == blank %}5{% endif %}{% if missing == blank %}6{% endif %}",
                    "v", "{\"z\": null, \"w\": \"  \", \"f\": false, \"e\": [], \"t\": \"x\"}"),
                "12346", "13 blank")
        }

        spec.it(fw, "finds an element with contains, and an object's key") callback {
            spec.assert_str_eq(
                render_json("{% if v.a contains \"x\" %}1{% endif %}{% if v.a contains 2 %}2{% endif %}{% if v.a contains \"z\" %}3{% endif %}{% if v.o contains \"k\" %}4{% endif %}{% if v.o contains \"q\" %}5{% endif %}",
                    "v", "{\"a\": [\"x\", 2], \"o\": {\"k\": 1}}"),
                "124", "14 contains")
        }

        spec.it(fw, "compares arrays and objects element by element") callback {
            spec.assert_str_eq(
                render_json("{% if v.a == v.b %}1{% endif %}{% if v.a == v.c %}2{% endif %}{% if v.o == v.p %}3{% endif %}{% if v.a != v.c %}4{% endif %}{% if v.o == v.q %}5{% endif %}",
                    "v", "{\"a\": [1, [2]], \"b\": [1, [2]], \"c\": [1, 2], \"o\": {\"x\": 1}, \"p\": {\"x\": 1}, \"q\": {\"x\": 2}}"),
                "134", "15 deep equality")
        }

        spec.it(fw, "compares numbers as numbers") callback {
            spec.assert_str_eq(
                render_json("{% if v.i == v.f %}1{% endif %}{% if v.i == 42 %}2{% endif %}{% if v.f < 42.5 %}3{% endif %}{% if v.i == nil %}4{% endif %}",
                    "v", "{\"i\": 42, \"f\": 42.0}"),
                "123", "16 numeric equality")
        }

        spec.it(fw, "refuses to order an array against a number") callback {
            spec.assert_true(string.starts_with(render_json("{% if a > 1 %}x{% endif %}", "a", "[1]"), "ERR") == 1,
                "17 ordering an array is an error")
        }

        spec.it(fw, "reclaims what renders make and keeps what a binding holds") callback {
            ctx = liquid.context_new()
            spec.assert_str_eq(render_in("{% assign keep = \"p,q\" | split: \",\" %}", ctx), "", "18a assign")
            i = 0
            while i < 500 {
                render_in("{{ \"a,b,c\" | split: \",\" | reverse | join }}", ctx)
                i = i + 1
            }
            // 500 renders made 1,000 arrays; a binding holds one.
            spec.assert_true(liquid.context_value_nodes(ctx) < 200, "18b made arrays reclaimed")
            spec.assert_str_eq(render_in("{{ keep[1] }}{{ keep.size }}", ctx), "q2", "18c bound array kept")
            liquid.context_free(ctx)
        }
    }

    spec.describe(fw, "liquid: variable paths (#2178)") {
        spec.it(fw, "reads an object's key with a dot") callback {
            spec.assert_str_eq(render_user("{{ user.name }}"), "Ada", "1 dot")
        }

        spec.it(fw, "reads nested keys") callback {
            spec.assert_str_eq(render_user("{{ user.addr.city }}"), "Paris", "2 nested")
        }

        spec.it(fw, "indexes an array from the front and from the end") callback {
            spec.assert_str_eq(render_user("{{ user.tags[0] }}{{ user.tags[2] }}{{ user.tags[-1] }}{{ user.tags[-3] }}"),
                "xzzx", "3 index")
        }

        spec.it(fw, "reads a key with a space through brackets") callback {
            spec.assert_str_eq(render_user("{{ user['first name'] }}{{ user[\"first name\"] }}"), "AA",
                "4 quoted key")
        }

        spec.it(fw, "takes an index or a key from a variable") callback {
            ctx = json_ctx("user", USER)
            liquid.context_put_int(ctx, "i", 1)
            liquid.context_put_string(ctx, "k", "name")
            spec.assert_str_eq(render_in("{{ user.tags[i] }} {{ user[k] }} {{ user.tags[user.addr.zip[3]] }}", ctx),
                "y Ada x", "5 variable segment")
            liquid.context_free(ctx)
        }

        spec.it(fw, "chains brackets and dots") callback {
            spec.assert_str_eq(render_user("{{ user.addr.zip[0] }}{{ user.addr['zip'][-1] }}"), "71", "6 chain")
        }

        spec.it(fw, "gives an array's size, first and last") callback {
            spec.assert_str_eq(render_user("{{ user.tags.size }} {{ user.tags.first }} {{ user.tags.last }}"),
                "3 x z", "7 array commands")
        }

        spec.it(fw, "gives a string's size and its first and last character") callback {
            ctx = json_ctx("user", USER)
            liquid.context_put_string(ctx, "w", "élan été")
            spec.assert_str_eq(render_in("{{ user.name.size }} {{ user.name.first }}{{ user.name.last }} {{ w.first }}{{ w.last }}", ctx),
                "3 Aa éé", "8 string commands")
            liquid.context_free(ctx)
        }

        spec.it(fw, "counts an object's keys, unless it has a size key") callback {
            spec.assert_str_eq(render_user("{{ user.addr.size }} {{ user.size }}"), "2 7", "9 object size")
        }

        spec.it(fw, "renders a missing key, index or segment as nothing") callback {
            spec.assert_str_eq(render_user("[{{ user.nope }}][{{ user.tags[9] }}][{{ user.none.deeper }}][{{ nobody.x.y }}][{{ user.n.size }}]"),
                "[][][][][]", "10 missing")
        }

        spec.it(fw, "resolves a path in a condition") callback {
            spec.assert_str_eq(render_user("{% if user.ok and user.tags.size == 3 %}Y{% endif %}{% if user.no %}N{% endif %}{% unless user.none %}U{% endunless %}"),
                "YU", "11 condition")
        }

        spec.it(fw, "resolves a path on the right of assign") callback {
            spec.assert_str_eq(render_user("{% assign c = user.addr.city | upcase %}{{ c }}"), "PARIS", "12 assign")
        }

        spec.it(fw, "resolves a path as a filter argument") callback {
            spec.assert_str_eq(render_user("{{ \"hi \" | append: user.name }} {{ user.n | plus: user.addr.zip[0] }}"),
                "hi Ada 49", "13 filter argument")
        }

        spec.it(fw, "resolves a path as a case subject and in a when") callback {
            spec.assert_str_eq(render_user("{% case user.tags.first %}{% when user.tags[0] %}same{% else %}diff{% endcase %}"),
                "same", "14 case")
        }

        spec.it(fw, "still finds a name bound whole with its dots") callback {
            ctx = liquid.context_new()
            liquid.context_put_string(ctx, "site.title", "Blog")
            spec.assert_str_eq(render_in("{{ site.title }}", ctx), "Blog", "15 dotted name")
            liquid.context_free(ctx)
        }

        spec.it(fw, "keeps an array an array through assign") callback {
            spec.assert_str_eq(render_bare("{% assign parts = \"q,r,s\" | split: \",\" %}{{ parts[1] }}{{ parts.size }}"),
                "r3", "16 assigned array")
        }
    }

    return spec.run_summary(fw)
}
