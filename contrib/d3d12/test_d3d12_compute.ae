// contrib.d3d12 compute pipelines: the same checks as contrib.vulkan's
// test_vulkan_compute.ae, with the shaders in HLSL.
//
// A compute shader transforms a buffer and every element is checked against
// the same computation done here on the CPU: a float transform to float
// precision, and an integer one that must be exact. Then compute output is
// drawn: a pass writes a triangle's corners into a buffer that a vertex
// shader pulls from, and the pixels show the triangle appear and disappear
// with what the pass wrote.

import std.fs
import std.string
import contrib.d3d12
import std.spec

load(path: string) -> (string, int) {
    data, length, err = fs.read_binary(path)
    ok = err == ""
    string.free(err)
    if ok == 0 { return ("", 0) }
    return (data, length)
}

// The shader's float math is single precision; the CPU twin here is double.
// Agreement to 1e-5 relative (plus a floor near zero) is what float32 gives.
close_enough(got: float, want: float) -> int {
    d = got - want
    if d < 0.0 { d = 0.0 - d }
    mag = want
    if mag < 0.0 { mag = 0.0 - mag }
    if d <= mag * 0.00001 + 0.0001 { return 1 }
    return 0
}

main() {
    fw = spec.init()
    ready = 0
    reason = "no Direct3D 12"
    dev = null
    cs = ""
    cs_len = 0
    if d3d12.available() == 1 {
        dev = d3d12.device_create()
        cs, cs_len = load("contrib/d3d12/shaders/transform_cs.hlsl")
        if dev == null {
            reason = "device_create failed (${d3d12.last_error()})"
        } else if cs_len == 0 {
            reason = "HLSL shaders missing"
        } else {
            ready = 1
        }
    } else {
        reason = "no Direct3D 12 (${d3d12.last_error()})"
    }

    // 1000 elements: not a multiple of the 64-wide work group, so the
    // shader's bounds guard is what keeps the last group in range.
    n = 1000
    groups = (n + 63) / 64
    binds = null
    comp = null
    src = null
    dst = null
    ints = null
    params = null
    if ready == 1 {
        binds = d3d12.bindings_create()
        d3d12.bindings_storage(binds, 0)
        d3d12.bindings_storage(binds, 1)
        d3d12.bindings_storage(binds, 2)
        d3d12.bindings_uniform(binds, 3)
        comp = d3d12.compute_create(dev, cs, cs_len, binds, 12)
        src = d3d12.buffer_create(dev, n * 4)
        dst = d3d12.buffer_create(dev, n * 4)
        ints = d3d12.buffer_create(dev, n * 4)
        params = d3d12.buffer_create(dev, 16)
        if comp == null { ready = 0; reason = "compute_create failed (${d3d12.last_error()})" }
    }

    spec.describe(fw, "d3d12: a compute pass over buffers") {
        spec.it_when(ready, "refuses to dispatch before every binding is set", reason) callback {
            rc = d3d12.dispatch(comp, groups, 1, 1)
            spec.assert_eq(rc, d3d12.ERR_ARG, "refused")
            spec.assert_true(string.index_of(d3d12.last_error(), "never set") >= 0, "names the binding")
        }

        spec.it_when(ready, "matches the CPU element by element", reason) callback {
            i = 0
            while i < n {
                d3d12.buffer_set_float(src, i, (i as float) * 0.37 - 50.0)
                d3d12.buffer_set_int(ints, i, i - 500)
                i = i + 1
            }
            d3d12.buffer_set_float(params, 0, 0.25)
            spec.assert_eq(d3d12.compute_set_buffer(comp, 0, src), 0, "bind src")
            spec.assert_eq(d3d12.compute_set_buffer(comp, 1, dst), 0, "bind dst")
            spec.assert_eq(d3d12.compute_set_buffer(comp, 2, ints), 0, "bind ints")
            spec.assert_eq(d3d12.compute_set_buffer(comp, 3, params), 0, "bind the uniform")
            d3d12.compute_push_float(comp, 0, 0.5)
            d3d12.compute_push_float(comp, 1, -2.0)
            d3d12.compute_push_int(comp, 2, n)
            spec.assert_eq(d3d12.dispatch(comp, groups, 1, 1), 0, "dispatch")

            bad_f = 0
            bad_i = 0
            i = 0
            while i < n {
                x = (i as float) * 0.37 - 50.0
                want = x * x * 0.5 - 2.0 + 0.25
                if close_enough(d3d12.buffer_float(dst, i), want) == 0 { bad_f = bad_f + 1 }
                if d3d12.buffer_int(ints, i) != (i - 500) * 3 + 7 { bad_i = bad_i + 1 }
                i = i + 1
            }
            spec.assert_eq(bad_f, 0, "every float matches the CPU")
            spec.assert_eq(bad_i, 0, "every int is exact")
        }

        spec.it_when(ready, "takes new push constants on the next dispatch", reason) callback {
            d3d12.compute_push_float(comp, 1, 10.0)
            spec.assert_eq(d3d12.dispatch(comp, groups, 1, 1), 0, "dispatch again")
            x = 3.0 * 0.37 - 50.0
            spec.assert_eq(close_enough(d3d12.buffer_float(dst, 3), x * x * 0.5 + 10.0 + 0.25), 1, "new offset")
            // Applied twice in place: ((v * 3 + 7) * 3 + 7).
            spec.assert_eq(d3d12.buffer_int(ints, 3), ((3 - 500) * 3 + 7) * 3 + 7, "ints transformed again")
        }

        spec.it_when(ready, "runs asynchronously and waits on request", reason) callback {
            spec.assert_eq(d3d12.dispatch_async(comp, groups, 1, 1), 0, "dispatch_async")
            spec.assert_eq(d3d12.compute_set_buffer(comp, 0, src), d3d12.ERR_ARG, "no rebinding in flight")
            spec.assert_eq(d3d12.compute_wait(comp), 0, "compute_wait")
            spec.assert_eq(d3d12.buffer_int(ints, 0), (((0 - 500) * 3 + 7) * 3 + 7) * 3 + 7, "third pass landed")
        }
    }

    spec.describe(fw, "d3d12: compute refusals") {
        spec.it_when(ready, "refuses empty and oversized dispatches", reason) callback {
            spec.assert_eq(d3d12.dispatch(comp, 0, 1, 1), d3d12.ERR_ARG, "zero groups")
            spec.assert_eq(d3d12.dispatch(comp, 1, 1, 1000000), d3d12.ERR_UNSUPPORTED, "past the Z limit")
            spec.assert_true(string.index_of(d3d12.last_error(), "device limit") >= 0, "names the limit")
        }
        spec.it_when(ready, "refuses a binding of the wrong kind", reason) callback {
            spec.assert_eq(d3d12.compute_set_buffer(comp, 7, src), d3d12.ERR_ARG, "undeclared binding")
        }
        spec.it_when(ready, "bounds-checks buffer access", reason) callback {
            spec.assert_eq(d3d12.buffer_size(params), 16, "size")
            spec.assert_eq(d3d12.buffer_set_float(params, 4, 1.0), d3d12.ERR_ARG, "slot 4 of 16 bytes")
            v = d3d12.buffer_float(params, 4)
            spec.assert_true(v != v, "reading past the end is NaN")
        }
        spec.it_when(ready, "reports the HLSL compiler's error", reason) callback {
            broken = "[numthreads(1,1,1)] void main() { undefined_call(); }"
            bad = d3d12.compute_create(dev, broken, string.length(broken), null, 0)
            spec.assert_true(bad == null, "refused")
            spec.assert_true(string.index_of(d3d12.last_error(), "undefined_call") >= 0, "names the problem")
        }
    }

    // Compute output drawn directly: vertices.comp writes three corners,
    // pulled.vert reads them by gl_VertexIndex from the same buffer.
    draw_ready = 0
    draw_reason = reason
    vcs = ""
    vcs_len = 0
    pvert = ""
    pvlen = 0
    frag = ""
    flen = 0
    if ready == 1 {
        vcs, vcs_len = load("contrib/d3d12/shaders/vertices_cs.hlsl")
        pvert, pvlen = load("contrib/d3d12/shaders/pulled_vs.hlsl")
        frag, flen = load("contrib/d3d12/shaders/triangle_ps.hlsl")
        if vcs_len > 0 && pvlen > 0 && flen > 0 { draw_ready = 1 }
        if draw_ready == 0 { draw_reason = "HLSL shaders missing" }
    }

    spec.describe(fw, "d3d12: drawing what a compute pass wrote") {
        spec.it_when(draw_ready, "draws a triangle a compute pass placed", draw_reason) callback {
            positions = d3d12.buffer_create(dev, 3 * 8)
            cb = d3d12.bindings_create()
            d3d12.bindings_storage(cb, 0)
            gen = d3d12.compute_create(dev, vcs, vcs_len, cb, 4)
            spec.assert_true(gen != null, "vertex generator (${d3d12.last_error()})")
            d3d12.compute_set_buffer(gen, 0, positions)

            t = d3d12.target_create(dev, 64, 64)
            empty = d3d12.layout_create()
            gb = d3d12.bindings_create()
            d3d12.bindings_storage(gb, 0)
            pipe = d3d12.pipeline_create_ex(dev, t, pvert, pvlen, frag, flen, empty, 0, gb)
            spec.assert_true(pipe != null, "pulling pipeline (${d3d12.last_error()})")
            spec.assert_eq(d3d12.set_buffer(pipe, 0, positions), 0, "the draw reads the buffer")
            d3d12.verts_reserve(t, 3)

            d3d12.compute_push_float(gen, 0, 0.9)
            spec.assert_eq(d3d12.dispatch(gen, 3, 1, 1), 0, "place the corners")
            spec.assert_eq(d3d12.draw(t, pipe, 0.0, 0.0, 0.0, 1.0), 0, "draw")
            px = d3d12.pixel(t, 32, 40)
            spec.assert_eq(d3d12.red(px), 255, "orange red")
            spec.assert_true(d3d12.green(px) >= 127 && d3d12.green(px) <= 128, "orange green")

            // A zero scale collapses the triangle: the next draw shows nothing,
            // so the draw is reading the pass's output, not a copy made once.
            d3d12.compute_push_float(gen, 0, 0.0)
            spec.assert_eq(d3d12.dispatch(gen, 3, 1, 1), 0, "collapse the corners")
            spec.assert_eq(d3d12.draw(t, pipe, 0.0, 0.0, 0.0, 1.0), 0, "draw again")
            spec.assert_eq(d3d12.red(d3d12.pixel(t, 32, 40)), 0, "nothing drawn")

            d3d12.pipeline_destroy(pipe)
            d3d12.target_destroy(t)
            d3d12.layout_destroy(empty)
            d3d12.bindings_destroy(gb)
            d3d12.compute_destroy(gen)
            d3d12.bindings_destroy(cb)
            d3d12.buffer_destroy(positions)
        }
    }

    _rc = spec.run_summary(fw)
    if comp != null { d3d12.compute_destroy(comp) }
    if binds != null { d3d12.bindings_destroy(binds) }
    if src != null { d3d12.buffer_destroy(src) }
    if dst != null { d3d12.buffer_destroy(dst) }
    if ints != null { d3d12.buffer_destroy(ints) }
    if params != null { d3d12.buffer_destroy(params) }
    string.free(cs)
    string.free(vcs)
    string.free(pvert)
    string.free(frag)
    if dev != null { d3d12.device_destroy(dev) }
    return _rc
}
