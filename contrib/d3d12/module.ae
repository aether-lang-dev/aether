// contrib.d3d12: GPU rendering, compute and presentation with Direct3D 12.
// Import with: import contrib.d3d12
//
// The same shape as contrib.vulkan: a program written against one reads the
// same against the other, and what differs is the shading language (HLSL
// here, SPIR-V there) and the coordinates (Direct3D's y points UP).
//
//   d3d12.available()                   -> int     1 when Direct3D 12 is usable
//   d3d12.device_name()                 -> string  the adapter, "" when none
//   d3d12.last_error()                  -> string
//
//   d3d12.device_create()               -> ptr     hardware adapter, or WARP
//   d3d12.device_destroy(dev)
//   d3d12.device_is_warp(dev)           -> int
//   d3d12.debug_message_count(dev)      -> int     with AETHER_D3D12_DEBUG=1
//
//   d3d12.target_create(dev, w, h)      -> ptr     offscreen RGBA8 image
//   d3d12.target_create_ex(dev, w, h, depth, samples) -> ptr
//   d3d12.target_create_format(dev, w, h, format, depth, samples) -> ptr
//   d3d12.target_destroy(t)   target_width(t)   target_height(t)
//   d3d12.target_format(t)    target_bytes_per_pixel(t)   rgba_size(t)
//   d3d12.target_has_depth(t) target_samples(t)
//   d3d12.target_resize(t, w, h)        -> int     keeps every pipeline valid
//   d3d12.target_set_readback(t, on)    -> int     off: no per-frame copy out
//   d3d12.target_set_frames(t, n)       -> int     frames in flight, 1..8
//   d3d12.target_set_timeout_ms(t, ms)  -> int
//
//   d3d12.pipeline_create(dev, t, vs, vs_len, ps, ps_len)           -> ptr
//   d3d12.pipeline_create_ex(dev, t, vs, vs_len, ps, ps_len, layout, push_bytes, bindings) -> ptr
//   d3d12.pipeline_destroy(p)
//   d3d12.layout_create() / layout_binding / layout_attr / layout_destroy
//   d3d12.bindings_create() / bindings_uniform / bindings_texture /
//         bindings_storage / bindings_destroy
//
//   d3d12.texture_create(dev, w, h)     -> ptr
//   d3d12.texture_create_ex(dev, w, h, mipmapped, linear, repeat) -> ptr
//   d3d12.texture_upload(tex, rgba, len) -> int
//   d3d12.texture_mip_levels(tex)       -> int
//   d3d12.texture_destroy(tex)
//
//   d3d12.set_texture / set_uniform / set_buffer / uniform_floats /
//         uniform_float                 the pipeline's own resources
//   d3d12.material_create(p) / material_set_texture / material_set_uniform /
//         material_set_buffer / material_floats / material_float /
//         material_destroy               one set of resources per draw
//
//   d3d12.verts_reserve(t, n) / verts_set(t, i, x, y, r, g, b)
//   d3d12.verts_reserve_n(t, n, floats) / verts_set_float(t, i, v)
//   d3d12.indices_reserve(t, n) / indices_reserve_ex(t, n, bits) / indices_set
//   d3d12.push_floats(t, n) / push_float(t, i, v) / set_push(t, data, len)
//   d3d12.batch_reset(t) / batch_add(t, m, first, count) / batch_count(t)
//   d3d12.draw(t, p, r, g, b, a) / draw_material(t, p, m, r, g, b, a)
//   d3d12.submit(t, p, r, g, b, a) / submit_material(...) / wait_all(t)
//   d3d12.pixel(t, x, y)                -> long    0xRRGGBBAA, -1 outside
//   d3d12.pixel_value(t, x, y, channel) -> float   full precision
//   d3d12.copy_rgba(t, dest, len) / copy_rgba8(t, dest, len)
//   d3d12.save_ppm(t, path) -> int      save_png(t, path) -> string
//
//   d3d12.buffer_create(dev, bytes) / buffer_destroy / buffer_size /
//         buffer_write / buffer_read / buffer_set_float / buffer_float /
//         buffer_set_int / buffer_int
//   d3d12.compute_create(dev, cs, len, bindings, push_bytes) -> ptr
//   d3d12.compute_set_buffer / compute_set_texture / compute_push_float /
//         compute_push_int / compute_set_timeout_ms / compute_destroy
//   d3d12.dispatch(c, gx, gy, gz) / dispatch_async / compute_wait
//
//   d3d12.swapchain_create(dev, kind, display, window, w, h) -> ptr
//   d3d12.swapchain_destroy / swapchain_resize / swapchain_set_vsync /
//         swapchain_width / swapchain_height / swapchain_format /
//         swapchain_presented
//   d3d12.present(sc, t)                -> int
//
// Shaders are HLSL with entry point main: source compiled at runtime
// (vs_5_1 / ps_5_1 / cs_5_1) or DXBC bytecode compiled ahead of time.
// Resources map to registers by binding number: a uniform at binding N is
// cbuffer bN, a texture tN with sampler sN, a storage buffer uN (space0), and
// the push constants cbuffer b0 in space1. Vertex attribute location N is the
// semantic TEXCOORDN.
//
// Nothing links against Direct3D: d3d12.dll, dxgi.dll and the HLSL compiler
// are opened at runtime. The module builds on every platform, and away from
// Windows 10 or later available() is 0 and every call says why. The window a
// swapchain presents into is never this module's: it is the HWND a toolkit
// hands out (aether-ui's native_view kind 1).

@source("aether_d3d12.c")

import std.bytes
import std.string
import contrib.png

exports (
    OK, ERR_NO_LOADER, ERR_NO_DEVICE, ERR_ARG, ERR_OOM, ERR_UNSUPPORTED, ERR_SHADER, ERR_DEVICE_LOST,
    WINDOW_WIN32, PER_VERTEX, PER_INSTANCE,
