// A flip-model swapchain over a Win32 window the caller owns (kind
// WINDOW_WIN32, window an HWND); display is unused. The size follows the
// window, and presenting while it is minimised shows nothing and succeeds.
swapchain_create(dev: ptr, kind: int, display: ptr, window: ptr, w: int, h: int) -> ptr {
    return aedx_ae_swapchain_create(dev, kind, display, window, w, h)
}
swapchain_destroy(sc: ptr) { aedx_ae_swapchain_destroy(sc) }
