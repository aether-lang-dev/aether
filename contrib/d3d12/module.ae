// Status codes, mirroring aether_d3d12.h (and contrib.vulkan's).
const OK = 0
const ERR_NO_LOADER = -1
const ERR_NO_DEVICE = -2
const ERR_ARG = -3
const ERR_OOM = -4
const ERR_UNSUPPORTED = -5
const ERR_SHADER = -6
const ERR_DEVICE_LOST = -7

// The window kind a swapchain presents into, numbered as aether-ui's
// native_view_kind(): a Win32 HWND.
const WINDOW_WIN32 = 1

// Input rate for layout_binding.
const PER_VERTEX = 0
const PER_INSTANCE = 1

// DXGI_FORMAT values under the names contrib.vulkan uses for the same
// formats: for layout_attr, and (the four RGBA ones) for target_create_format.
const FORMAT_R32_SFLOAT = 41
const FORMAT_R32G32_SFLOAT = 16
const FORMAT_R32G32B32_SFLOAT = 6
const FORMAT_R32G32B32A32_SFLOAT = 2
const FORMAT_R8G8B8A8_UNORM = 28
const FORMAT_R8G8B8A8_SRGB = 29
const FORMAT_R16G16B16A16_SFLOAT = 10

available() -> int { return aedx_ae_available() }
last_error() -> string { return aedx_ae_last_error() }
device_name() -> string { return aedx_ae_device_name() }

// The first hardware adapter with feature level 11_0, or WARP (the software
// rasteriser Windows ships) where there is none.
device_create() -> ptr { return aedx_ae_device_create() }
device_destroy(dev: ptr) { aedx_ae_device_destroy(dev) }
device_is_warp(dev: ptr) -> int { return aedx_ae_device_is_warp(dev) }

// Warnings, errors and corruption the Direct3D 12 debug layer reported, with
// AETHER_D3D12_DEBUG=1 (or 2, adding GPU-based validation) set before
// device_create; 0 otherwise. Every message is printed to stderr as well.
debug_message_count(dev: ptr) -> int { return aedx_ae_debug_message_count(dev) }

target_create(dev: ptr, w: int, h: int) -> ptr { return aedx_ae_target_create(dev, w, h) }
// Depth makes geometry resolve by distance; samples is 1, 2, 4, 8 or 16,
// checked against the device rather than rounded down.
target_create_ex(dev: ptr, w: int, h: int, want_depth: int, samples: int) -> ptr {
    return aedx_ae_target_create_ex(dev, w, h, want_depth, samples)
}
// FORMAT_R8G8B8A8_UNORM, _SRGB, FORMAT_R16G16B16A16_SFLOAT or
// FORMAT_R32G32B32A32_SFLOAT.
target_create_format(dev: ptr, w: int, h: int, format: int, want_depth: int, samples: int) -> ptr {
    return aedx_ae_target_create_format(dev, w, h, format, want_depth, samples)
}
target_destroy(t: ptr) { aedx_ae_target_destroy(t) }
target_width(t: ptr) -> int { return aedx_ae_target_width(t) }
target_height(t: ptr) -> int { return aedx_ae_target_height(t) }
target_format(t: ptr) -> int { return aedx_ae_target_format(t) }
target_bytes_per_pixel(t: ptr) -> int { return aedx_ae_target_bytes_per_pixel(t) }
target_has_depth(t: ptr) -> int { return aedx_ae_target_has_depth(t) }
target_samples(t: ptr) -> int { return aedx_ae_target_samples(t) }
target_resize(t: ptr, w: int, h: int) -> int { return aedx_ae_target_resize(t, w, h) }
target_set_readback(t: ptr, on: int) -> int { return aedx_ae_target_set_readback(t, on) }
target_readback(t: ptr) -> int { return aedx_ae_target_readback(t) }
target_set_frames(t: ptr, count: int) -> int { return aedx_ae_target_set_frames(t, count) }
target_frames(t: ptr) -> int { return aedx_ae_target_frames(t) }
target_set_timeout_ms(t: ptr, ms: int) -> int { return aedx_ae_target_set_timeout_ms(t, ms) }
rgba_size(t: ptr) -> int { return aedx_ae_rgba_size(t) }

// HLSL source or DXBC bytecode, entry point main.
pipeline_create(dev: ptr, t: ptr, vs: string, vs_len: int, ps: string, ps_len: int) -> ptr {
    return aedx_ae_pipeline_create(dev, t, vs, vs_len, ps, ps_len)
}
pipeline_create_ex(dev: ptr, t: ptr, vs: string, vs_len: int, ps: string, ps_len: int,
                   layout: ptr, push_bytes: int, bindings: ptr) -> ptr {
    return aedx_ae_pipeline_create_ex(dev, t, vs, vs_len, ps, ps_len, layout, push_bytes, bindings)
}
pipeline_destroy(p: ptr) { aedx_ae_pipeline_destroy(p) }

// Attribute `location` is the HLSL semantic TEXCOORD<location>. An empty
// layout is a pipeline with no vertex input.
layout_create() -> ptr { return aedx_ae_layout_create() }
layout_destroy(l: ptr) { aedx_ae_layout_destroy(l) }
