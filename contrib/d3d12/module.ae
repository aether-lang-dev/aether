swapchain_format(sc: ptr) -> int { return aedx_ae_swapchain_format(sc) }
swapchain_presented(sc: ptr) -> int { return aedx_ae_swapchain_presented(sc) }
// Shows the target's newest frame, scaled to the window and encoded for
// display when the target is sRGB or float.
present(sc: ptr, t: ptr) -> int { return aedx_ae_present(sc, t) }
